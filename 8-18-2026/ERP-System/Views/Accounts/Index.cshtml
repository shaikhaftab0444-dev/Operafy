@model ERP_System.Models.AccountsViewModel
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Accounts & Financial Management";
    var inCulture = new System.Globalization.CultureInfo("en-IN");
}

<style>
    .panel-accounts {
        background: #ffffff;
        border: 1px solid var(--border-warm);
        border-radius: 12px;
        box-shadow: 0 1px 3px rgba(45,37,30,0.03);
    }
    
    .table-accounts th {
        background-color: #fcfbfa !important;
        font-size: 0.75rem;
        text-transform: uppercase;
        font-weight: 700;
        color: #64748b;
        border-bottom: 1px solid var(--border-warm);
        padding: 0.9rem 1.25rem;
    }
    
    .table-accounts td {
        font-size: 0.875rem;
        color: var(--text-color);
        border-bottom: 1px solid var(--border-warm);
        padding: 0.9rem 1.25rem;
        vertical-align: middle;
    }

    .kpi-card-acc {
        background: #ffffff;
        border: 1px solid var(--border-warm);
        border-radius: 12px;
        padding: 1.25rem;
        box-shadow: 0 1px 3px rgba(13,20,36,0.03);
        display: flex;
        align-items: center;
        gap: 1.1rem;
        transition: transform 0.2s, box-shadow 0.2s;
    }
    .kpi-card-acc:hover {
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(15, 23, 42, 0.06);
    }

    .kpi-icon-acc {
        width: 48px;
        height: 48px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.3rem;
        flex-shrink: 0;
    }

    .bank-card {
        background: #ffffff;
        border: 1px solid var(--border-warm);
        border-radius: 12px;
        padding: 1.25rem;
        position: relative;
        overflow: hidden;
        transition: all 0.2s ease;
    }
    .bank-card:hover {
        border-color: #3b82f6;
        box-shadow: 0 4px 14px rgba(59, 130, 246, 0.08);
    }

    .badge-type-asset { background-color: #eff6ff; color: #1d4ed8; border: 1px solid #bfdbfe; font-weight: 600; }
    .badge-type-liability { background-color: #fff7ed; color: #c2410c; border: 1px solid #fed7aa; font-weight: 600; }
    .badge-type-equity { background-color: #faf5ff; color: #7e22ce; border: 1px solid #e9d5ff; font-weight: 600; }
    .badge-type-revenue { background-color: #f0fdf4; color: #15803d; border: 1px solid #bbf7d0; font-weight: 600; }
    .badge-type-expense { background-color: #fef2f2; color: #b91c1c; border: 1px solid #fecaca; font-weight: 600; }

    .badge-status-paid { background-color: rgba(16, 185, 129, 0.1); color: #10b981; border: 1px solid rgba(16, 185, 129, 0.2); font-weight: 600; }
    .badge-status-pending { background-color: rgba(245, 158, 11, 0.1); color: #d97706; border: 1px solid rgba(245, 158, 11, 0.2); font-weight: 600; }
    .badge-status-cancelled { background-color: rgba(239, 68, 68, 0.1); color: #ef4444; border: 1px solid rgba(239, 68, 68, 0.2); font-weight: 600; }

    .nav-tabs-accounts {
        border-bottom: 2px solid var(--border-warm);
        gap: 0.5rem;
    }
    .nav-tabs-accounts .nav-link {
        border: none;
        color: #64748b;
        font-weight: 600;
        font-size: 0.9rem;
        padding: 0.75rem 1.25rem;
        border-radius: 8px 8px 0 0;
        transition: all 0.2s;
        display: flex;
        align-items: center;
        gap: 8px;
    }
    .nav-tabs-accounts .nav-link:hover {
        color: #0f172a;
        background-color: rgba(241, 245, 249, 0.6);
    }
    .nav-tabs-accounts .nav-link.active {
        color: #2563eb;
        background-color: #ffffff;
        border-bottom: 3px solid #2563eb;
    }

    .btn-primary-warm {
        background-color: #2563eb;
        color: #ffffff;
        font-weight: 600;
        border: none;
        border-radius: 8px;
        transition: all 0.2s;
    }
    .btn-primary-warm:hover {
        background-color: #1d4ed8;
        color: #ffffff;
    }

    .btn-outline-warm {
        border: 1px solid #cbd5e1;
        background-color: #ffffff;
        color: #334155;
        font-weight: 600;
        border-radius: 8px;
    }
    .btn-outline-warm:hover {
        background-color: #f8fafc;
        border-color: #94a3b8;
        color: #0f172a;
    }
</style>

<!-- Top Header & Breadcrumbs -->
<div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-3 mb-4 text-start">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-1 small">
                <li class="breadcrumb-item"><a href="/Dashboard" class="text-decoration-none text-muted">Dashboard</a></li>
                <li class="breadcrumb-item active fw-semibold text-primary" aria-current="page">Accounting & Financials</li>
            </ol>
        </nav>
        <h4 class="fw-bold m-0 text-dark">Accounts & Financial Management</h4>
        <p class="text-muted small m-0">Manage Chart of Accounts, General Ledger vouchers, cash balances, and financial health.</p>
    </div>
    <div class="d-flex gap-2">
        <button type="button" class="btn btn-outline-warm btn-sm px-3 py-2" data-bs-toggle="modal" data-bs-target="#createVoucherModal">
            <i class="fa-solid fa-receipt me-1 text-primary"></i> + Record Voucher
        </button>
        <button type="button" class="btn btn-primary-warm btn-sm px-3 py-2" data-bs-toggle="modal" data-bs-target="#addAccountHeadModal">
            <i class="fa-solid fa-plus me-1"></i> + Add Account Head
        </button>
    </div>
</div>

<!-- TempData Success / Error Toast Alerts -->
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm mb-4" role="alert">
        <i class="fa-solid fa-circle-check me-2"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm mb-4" role="alert">
        <i class="fa-solid fa-triangle-exclamation me-2"></i> @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- KPI Cards Overview Row -->
<div class="row g-3 mb-4">
    <div class="col-12 col-sm-6 col-xl-2-4">
        <div class="kpi-card-acc">
            <div class="kpi-icon-acc bg-primary-subtle text-primary">
                <i class="fa-solid fa-vault"></i>
            </div>
            <div>
                <span class="text-muted small d-block fw-semibold">Total Assets</span>
                <h5 class="fw-bold mb-0 text-dark">₹@Model.TotalAssets.ToString("N0", inCulture)</h5>
                <span class="badge bg-success-subtle text-success mt-1" style="font-size: 0.7rem;">
                    <i class="fa-solid fa-arrow-trend-up me-1"></i>Healthy Position
                </span>
            </div>
        </div>
    </div>
    <div class="col-12 col-sm-6 col-xl-2-4">
        <div class="kpi-card-acc">
            <div class="kpi-icon-acc bg-success-subtle text-success">
                <i class="fa-solid fa-arrow-down-left"></i>
            </div>
            <div>
                <span class="text-muted small d-block fw-semibold">Total Revenue</span>
                <h5 class="fw-bold mb-0 text-dark">₹@Model.TotalRevenue.ToString("N0", inCulture)</h5>
                <span class="text-muted small" style="font-size: 0.72rem;">@Model.RevenueHeadsCount Revenue Heads</span>
            </div>
        </div>
    </div>
    <div class="col-12 col-sm-6 col-xl-2-4">
        <div class="kpi-card-acc">
            <div class="kpi-icon-acc bg-danger-subtle text-danger">
                <i class="fa-solid fa-arrow-up-right"></i>
            </div>
            <div>
                <span class="text-muted small d-block fw-semibold">Total Expenses</span>
                <h5 class="fw-bold mb-0 text-dark">₹@Model.TotalExpenses.ToString("N0", inCulture)</h5>
                <span class="text-muted small" style="font-size: 0.72rem;">@Model.ExpenseHeadsCount Expense Heads</span>
            </div>
        </div>
    </div>
    <div class="col-12 col-sm-6 col-xl-2-4">
        <div class="kpi-card-acc">
            <div class="kpi-icon-acc bg-info-subtle text-info">
                <i class="fa-solid fa-scale-balanced"></i>
            </div>
            <div>
                <span class="text-muted small d-block fw-semibold">Net Cash Flow</span>
                <h5 class="fw-bold mb-0 @(Model.NetCashFlow >= 0 ? "text-success" : "text-danger")">
                    ₹@Model.NetCashFlow.ToString("N0", inCulture)
                </h5>
                <span class="text-muted small" style="font-size: 0.72rem;">Operating Balance</span>
            </div>
        </div>
    </div>
    <div class="col-12 col-sm-6 col-xl-2-4">
        <div class="kpi-card-acc">
            <div class="kpi-icon-acc bg-warning-subtle text-warning">
                <i class="fa-solid fa-list-check"></i>
            </div>
            <div>
                <span class="text-muted small d-block fw-semibold">Account Heads</span>
                <h5 class="fw-bold mb-0 text-dark">@Model.ActiveAccountHeadsCount / @Model.TotalAccountHeads</h5>
                <span class="text-muted small" style="font-size: 0.72rem;">Active Ledger Heads</span>
            </div>
        </div>
    </div>
</div>

<!-- Main Tabs Section -->
<div class="panel-accounts p-3 mb-4">
    <ul class="nav nav-tabs nav-tabs-accounts mb-4" id="accountsTab" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link @(Model.ActiveTab == "overview" ? "active" : "")" id="overview-tab" data-bs-toggle="tab" data-bs-target="#overview-pane" type="button" role="tab">
                <i class="fa-solid fa-chart-pie"></i> Overview & Cash/Bank
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link @(Model.ActiveTab == "chart-of-accounts" ? "active" : "")" id="chart-tab" data-bs-toggle="tab" data-bs-target="#chart-pane" type="button" role="tab">
                <i class="fa-solid fa-sitemap"></i> Chart of Accounts (@Model.TotalAccountHeads)
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link @(Model.ActiveTab == "journal" ? "active" : "")" id="journal-tab" data-bs-toggle="tab" data-bs-target="#journal-pane" type="button" role="tab">
                <i class="fa-solid fa-file-invoice-dollar"></i> General Ledger Vouchers (@Model.Transactions.Count)
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link @(Model.ActiveTab == "fiscal-years" ? "active" : "")" id="fiscal-tab" data-bs-toggle="tab" data-bs-target="#fiscal-pane" type="button" role="tab">
                <i class="fa-solid fa-calendar-days"></i> Financial Years
            </button>
        </li>
    </ul>

    <div class="tab-content" id="accountsTabContent">
        <!-- TAB 1: OVERVIEW & CASH/BANK -->
        <div class="tab-pane fade @(Model.ActiveTab == "overview" ? "show active" : "")" id="overview-pane" role="tabpanel">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h6 class="fw-bold text-dark m-0"><i class="fa-solid fa-building-columns text-primary me-2"></i>Cash & Commercial Bank Accounts</h6>
                <span class="text-muted small">Real-time Account Liquidity</span>
            </div>
            
            <div class="row g-3 mb-4">
                @foreach (var bank in Model.BankAccounts)
                {
                    <div class="col-12 col-md-6 col-xl-3">
                        <div class="bank-card">
                            <div class="d-flex justify-content-between align-items-start mb-3">
                                <div class="kpi-icon-acc @bank.BadgeClass">
                                    <i class="fa-solid @bank.IconClass"></i>
                                </div>
                                <span class="badge @bank.BadgeClass rounded-pill px-2.5 py-1" style="font-size: 0.7rem;">@bank.Status</span>
                            </div>
                            <span class="text-muted small d-block mb-1">@bank.BankName</span>
                            <h6 class="fw-bold text-dark text-truncate mb-1">@bank.AccountName</h6>
                            <p class="text-muted font-monospace small mb-3">Acc: @bank.AccountNumber</p>
                            <div class="pt-2 border-top d-flex justify-content-between align-items-center">
                                <span class="text-muted small">Available Balance</span>
                                <span class="fw-bold text-dark">₹@bank.Balance.ToString("N0", inCulture)</span>
                            </div>
                        </div>
                    </div>
                }
            </div>

            <!-- Ledger Breakdown Grid -->
            <div class="row g-3">
                <div class="col-12 col-lg-7">
                    <div class="border rounded-3 p-3 bg-light-subtle">
                        <h6 class="fw-bold text-dark mb-3"><i class="fa-solid fa-chart-simple me-2 text-info"></i>Chart of Accounts Type Distribution</h6>
                        <div class="row g-2 text-center">
                            <div class="col">
                                <div class="p-2 border bg-white rounded">
                                    <span class="badge badge-type-asset mb-1">Asset</span>
                                    <h5 class="fw-bold text-dark mb-0">@Model.AssetHeadsCount</h5>
                                    <span class="text-muted small" style="font-size: 0.7rem;">Heads</span>
                                </div>
                            </div>
                            <div class="col">
                                <div class="p-2 border bg-white rounded">
                                    <span class="badge badge-type-liability mb-1">Liability</span>
                                    <h5 class="fw-bold text-dark mb-0">@Model.LiabilityHeadsCount</h5>
                                    <span class="text-muted small" style="font-size: 0.7rem;">Heads</span>
                                </div>
                            </div>
                            <div class="col">
                                <div class="p-2 border bg-white rounded">
                                    <span class="badge badge-type-equity mb-1">Equity</span>
                                    <h5 class="fw-bold text-dark mb-0">@Model.EquityHeadsCount</h5>
                                    <span class="text-muted small" style="font-size: 0.7rem;">Heads</span>
                                </div>
                            </div>
                            <div class="col">
                                <div class="p-2 border bg-white rounded">
                                    <span class="badge badge-type-revenue mb-1">Revenue</span>
                                    <h5 class="fw-bold text-dark mb-0">@Model.RevenueHeadsCount</h5>
                                    <span class="text-muted small" style="font-size: 0.7rem;">Heads</span>
                                </div>
                            </div>
                            <div class="col">
                                <div class="p-2 border bg-white rounded">
                                    <span class="badge badge-type-expense mb-1">Expense</span>
                                    <h5 class="fw-bold text-dark mb-0">@Model.ExpenseHeadsCount</h5>
                                    <span class="text-muted small" style="font-size: 0.7rem;">Heads</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-12 col-lg-5">
                    <div class="border rounded-3 p-3 bg-light-subtle h-100 d-flex flex-column justify-content-between">
                        <div>
                            <h6 class="fw-bold text-dark mb-2"><i class="fa-solid fa-clock-history me-2 text-warning"></i>Pending Action Items</h6>
                            <p class="text-muted small mb-3">Unsettled or pending vouchers requiring accountant review.</p>
                            <div class="d-flex align-items-center justify-content-between p-2.5 bg-white border rounded mb-2">
                                <div>
                                    <span class="fw-semibold text-dark d-block">Pending Vouchers</span>
                                    <span class="text-muted small">@Model.PendingVouchersCount Vouchers Awaiting Approval</span>
                                </div>
                                <span class="badge bg-warning-subtle text-warning fw-bold fs-6">₹@Model.PendingVouchersAmount.ToString("N0", inCulture)</span>
                            </div>
                        </div>
                        <button type="button" class="btn btn-outline-warm btn-sm w-100 mt-2" onclick="document.getElementById('journal-tab').click();">
                            View All Journal Entries <i class="fa-solid fa-arrow-right ms-1"></i>
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- TAB 2: CHART OF ACCOUNTS -->
        <div class="tab-pane fade @(Model.ActiveTab == "chart-of-accounts" ? "show active" : "")" id="chart-pane" role="tabpanel">
            <!-- Filter Bar -->
            <form method="get" asp-action="Index" class="row g-2 mb-3 align-items-center">
                <input type="hidden" name="tab" value="chart-of-accounts" />
                <div class="col-12 col-md-5">
                    <div class="input-group input-group-sm">
                        <span class="input-group-text bg-white text-muted border-end-0"><i class="fa-solid fa-magnifying-glass"></i></span>
                        <input type="text" name="search" value="@Model.SearchTerm" class="form-control border-start-0" placeholder="Search Head Code, Name, or Description..." />
                    </div>
                </div>
                <div class="col-12 col-md-4">
                    <select name="accountType" class="form-select form-select-sm">
                        <option value="">-- Filter by Account Type --</option>
                        <option value="Asset" selected="@(Model.SelectedAccountType == "Asset")">Asset</option>
                        <option value="Liability" selected="@(Model.SelectedAccountType == "Liability")">Liability</option>
                        <option value="Equity" selected="@(Model.SelectedAccountType == "Equity")">Equity</option>
                        <option value="Revenue" selected="@(Model.SelectedAccountType == "Revenue")">Revenue</option>
                        <option value="Expense" selected="@(Model.SelectedAccountType == "Expense")">Expense</option>
                    </select>
                </div>
                <div class="col-12 col-md-3 d-flex gap-2">
                    <button type="submit" class="btn btn-primary-warm btn-sm px-3 flex-grow-1">Filter</button>
                    <a href="/Accounts?tab=chart-of-accounts" class="btn btn-outline-warm btn-sm px-3">Reset</a>
                </div>
            </form>

            <div class="table-responsive">
                <table class="table table-accounts align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Head Code</th>
                            <th>Account Head Name</th>
                            <th>Account Type</th>
                            <th>Description</th>
                            <th>Created Date</th>
                            <th>Status</th>
                            <th class="text-end">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.AccountHeads.Any())
                        {
                            @foreach (var head in Model.AccountHeads)
                            {
                                string badgeStyle = head.AccountType switch
                                {
                                    "Asset" => "badge-type-asset",
                                    "Liability" => "badge-type-liability",
                                    "Equity" => "badge-type-equity",
                                    "Revenue" => "badge-type-revenue",
                                    "Expense" => "badge-type-expense",
                                    _ => "bg-secondary-subtle text-secondary"
                                };

                                <tr>
                                    <td><span class="font-monospace fw-bold text-dark">@head.HeadCode</span></td>
                                    <td><span class="fw-semibold text-dark">@head.HeadName</span></td>
                                    <td><span class="badge @badgeStyle rounded-pill px-2.5 py-1">@head.AccountType</span></td>
                                    <td class="text-muted small" style="max-width: 250px;">@(string.IsNullOrEmpty(head.Description) ? "-" : head.Description)</td>
                                    <td class="text-muted small">@head.CreatedAt.ToString("MMM dd, yyyy")</td>
                                    <td>
                                        @if (head.IsActive)
                                        {
                                            <span class="badge bg-success-subtle text-success rounded-pill px-2 py-1"><i class="fa-solid fa-circle me-1 small" style="font-size:0.5rem;"></i>Active</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary-subtle text-secondary rounded-pill px-2 py-1"><i class="fa-solid fa-circle me-1 small" style="font-size:0.5rem;"></i>Inactive</span>
                                        }
                                    </td>
                                    <td class="text-end">
                                        <form method="post" asp-action="ToggleHeadStatus" asp-route-id="@head.AccountHeadId" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm @(head.IsActive ? "btn-outline-danger" : "btn-outline-success") py-0 px-2" style="font-size: 0.75rem;">
                                                @(head.IsActive ? "Deactivate" : "Activate")
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="text-center py-4 text-muted">
                                    <i class="fa-solid fa-folder-open d-block fs-3 mb-2 text-secondary"></i>
                                    No Account Heads found matching the criteria.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- TAB 3: GENERAL LEDGER VOUCHERS -->
        <div class="tab-pane fade @(Model.ActiveTab == "journal" ? "show active" : "")" id="journal-pane" role="tabpanel">
            <!-- Filter Bar -->
            <form method="get" asp-action="Index" class="row g-2 mb-3 align-items-center">
                <input type="hidden" name="tab" value="journal" />
                <div class="col-12 col-md-5">
                    <div class="input-group input-group-sm">
                        <span class="input-group-text bg-white text-muted border-end-0"><i class="fa-solid fa-magnifying-glass"></i></span>
                        <input type="text" name="search" value="@Model.SearchTerm" class="form-control border-start-0" placeholder="Search Voucher No, Party Name..." />
                    </div>
                </div>
                <div class="col-12 col-md-4">
                    <select name="voucherType" class="form-select form-select-sm">
                        <option value="">-- Filter by Voucher Type --</option>
                        <option value="Sales Invoice" selected="@(Model.SelectedVoucherType == "Sales Invoice")">Sales Invoice</option>
                        <option value="Purchase Order" selected="@(Model.SelectedVoucherType == "Purchase Order")">Purchase Order</option>
                        <option value="Expense Entry" selected="@(Model.SelectedVoucherType == "Expense Entry")">Expense Entry</option>
                        <option value="Payment Voucher" selected="@(Model.SelectedVoucherType == "Payment Voucher")">Payment Voucher</option>
                        <option value="Receipt Voucher" selected="@(Model.SelectedVoucherType == "Receipt Voucher")">Receipt Voucher</option>
                    </select>
                </div>
                <div class="col-12 col-md-3 d-flex gap-2">
                    <button type="submit" class="btn btn-primary-warm btn-sm px-3 flex-grow-1">Filter</button>
                    <a href="/Accounts?tab=journal" class="btn btn-outline-warm btn-sm px-3">Reset</a>
                </div>
            </form>

            <div class="table-responsive">
                <table class="table table-accounts align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Voucher No</th>
                            <th>Date</th>
                            <th>Type</th>
                            <th>Party / Description</th>
                            <th>Amount</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Transactions.Any())
                        {
                            @foreach (var tx in Model.Transactions)
                            {
                                string statusBadge = tx.Status switch
                                {
                                    "Paid" => "badge-status-paid",
                                    "Pending" => "badge-status-pending",
                                    _ => "badge-status-cancelled"
                                };

                                <tr>
                                    <td><span class="font-monospace fw-bold text-dark">@tx.TransactionNo</span></td>
                                    <td class="text-muted small">@tx.Date.ToString("MMM dd, yyyy")</td>
                                    <td><span class="badge bg-secondary-subtle text-dark border px-2 py-1">@tx.Type</span></td>
                                    <td><span class="fw-semibold text-dark">@tx.PartyName</span></td>
                                    <td><span class="fw-bold text-dark">₹@tx.Amount.ToString("N2", inCulture)</span></td>
                                    <td><span class="badge @statusBadge rounded-pill px-2.5 py-1">@tx.Status</span></td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center py-4 text-muted">
                                    <i class="fa-solid fa-receipt d-block fs-3 mb-2 text-secondary"></i>
                                    No financial vouchers found.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- TAB 4: FINANCIAL YEARS -->
        <div class="tab-pane fade @(Model.ActiveTab == "fiscal-years" ? "show active" : "")" id="fiscal-pane" role="tabpanel">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h6 class="fw-bold text-dark m-0"><i class="fa-solid fa-calendar-days text-primary me-2"></i>Fiscal Financial Periods</h6>
                <span class="text-muted small">ERP Accounting Cycles</span>
            </div>

            <div class="row g-3">
                @foreach (var year in Model.FinancialYears)
                {
                    <div class="col-12 col-md-4">
                        <div class="border rounded-3 p-3 bg-white shadow-sm @(year.IsCurrent ? "border-primary" : "")">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <h6 class="fw-bold text-dark m-0">@year.YearName</h6>
                                @if (year.IsCurrent)
                                {
                                    <span class="badge bg-primary rounded-pill px-2.5 py-1">Active Fiscal Year</span>
                                }
                                else if (year.IsActive)
                                {
                                    <span class="badge bg-secondary-subtle text-dark rounded-pill px-2 py-1">Open</span>
                                }
                                else
                                {
                                    <span class="badge bg-light text-muted border rounded-pill px-2 py-1">Closed / Archived</span>
                                }
                            </div>
                            <div class="small text-muted mb-2">
                                <div><i class="fa-solid fa-calendar-day me-2"></i>Start: <strong>@year.StartDate.ToString("MMM dd, yyyy")</strong></div>
                                <div><i class="fa-solid fa-calendar-check me-2"></i>End: <strong>@year.EndDate.ToString("MMM dd, yyyy")</strong></div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- MODAL 1: ADD ACCOUNT HEAD -->
<div class="modal fade" id="addAccountHeadModal" tabindex="-1" aria-labelledby="addAccountHeadModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <form method="post" asp-action="CreateAccountHead">
                @Html.AntiForgeryToken()
                <div class="modal-header border-bottom">
                    <h5 class="modal-title fw-bold text-dark" id="addAccountHeadModalLabel">
                        <i class="fa-solid fa-plus-circle text-primary me-2"></i>Add New Account Head
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-dark">Head Code <span class="text-danger">*</span></label>
                        <input type="text" name="headCode" class="form-control" placeholder="e.g. AC-1006" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-dark">Head Name <span class="text-danger">*</span></label>
                        <input type="text" name="headName" class="form-control" placeholder="e.g. Petty Cash Reserve" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-dark">Account Type <span class="text-danger">*</span></label>
                        <select name="accountType" class="form-select" required>
                            <option value="">-- Select Type --</option>
                            <option value="Asset">Asset</option>
                            <option value="Liability">Liability</option>
                            <option value="Equity">Equity</option>
                            <option value="Revenue">Revenue</option>
                            <option value="Expense">Expense</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-dark">Description</label>
                        <textarea name="description" class="form-control" rows="2" placeholder="Brief details about this account head..."></textarea>
                    </div>
                </div>
                <div class="modal-footer border-top">
                    <button type="button" class="btn btn-outline-warm btn-sm px-3" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary-warm btn-sm px-4">Create Account Head</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- MODAL 2: RECORD FINANCIAL VOUCHER -->
<div class="modal fade" id="createVoucherModal" tabindex="-1" aria-labelledby="createVoucherModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <form method="post" asp-action="CreateVoucher">
                @Html.AntiForgeryToken()
                <div class="modal-header border-bottom">
                    <h5 class="modal-title fw-bold text-dark" id="createVoucherModalLabel">
                        <i class="fa-solid fa-receipt text-primary me-2"></i>Record Financial Voucher
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-dark">Voucher Type <span class="text-danger">*</span></label>
                        <select name="voucherType" class="form-select" required>
                            <option value="Payment Voucher">Payment Voucher</option>
                            <option value="Receipt Voucher">Receipt Voucher</option>
                            <option value="Expense Entry">Expense Entry</option>
                            <option value="Sales Invoice">Sales Invoice</option>
                            <option value="Purchase Order">Purchase Order</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-dark">Party / Account Name <span class="text-danger">*</span></label>
                        <input type="text" name="partyName" class="form-control" placeholder="e.g. ABC Suppliers Ltd / Office Supplies" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-dark">Amount (INR) <span class="text-danger">*</span></label>
                        <input type="number" step="0.01" name="amount" class="form-control" placeholder="0.00" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-dark">Status <span class="text-danger">*</span></label>
                        <select name="status" class="form-select" required>
                            <option value="Paid">Paid</option>
                            <option value="Pending">Pending</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer border-top">
                    <button type="button" class="btn btn-outline-warm btn-sm px-3" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary-warm btn-sm px-4">Record Voucher</button>
                </div>
            </form>
        </div>
    </div>
</div>

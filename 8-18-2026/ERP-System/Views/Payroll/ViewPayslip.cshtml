@model ERP_System.Models.Payslip
@{
    Layout = null; // No dashboard layout for print-only views
    var company = (ERP_System.Models.Company)ViewBag.Company;
    var inCulture = new System.Globalization.CultureInfo("en-IN");
    
    decimal grossEarnings = Model.BasicSalary + Model.HRA + Model.TransportAllowance + Model.MedicalAllowance;
    decimal totalDeductions = Model.ProvidentFund + Model.ProfessionalTax;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Salary Slip - @Model.PayPeriod - @Model.User?.FullName</title>
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <!-- FontAwesome Icons -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <style>
        :root {
            --primary: #4f46e5;
            --text-dark: #1e293b;
            --text-muted: #64748b;
            --border: #e2e8f0;
            --bg-light: #f8fafc;
        }

        body {
            font-family: 'Inter', sans-serif;
            color: var(--text-dark);
            background-color: #f1f5f9;
            margin: 0;
            padding: 2rem;
            display: flex;
            flex-direction: column;
            align-items: center;
        }

        .payslip-container {
            background-color: #ffffff;
            border: 1px solid var(--border);
            border-radius: 12px;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
            max-width: 800px;
            width: 100%;
            padding: 3rem;
            box-sizing: border-box;
        }

        .header-section {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            margin-bottom: 2.5rem;
            border-bottom: 2px solid var(--primary);
            padding-bottom: 1.5rem;
        }

        .company-logo-section {
            text-align: left;
        }
        .company-name {
            font-size: 1.5rem;
            font-weight: 800;
            color: var(--primary);
            margin: 0 0 5px 0;
            text-transform: uppercase;
        }
        .company-details {
            font-size: 0.8rem;
            color: var(--text-muted);
            margin: 0;
            line-height: 1.4;
        }

        .slip-title-section {
            text-align: right;
        }
        .slip-title {
            font-size: 1.4rem;
            font-weight: 800;
            margin: 0 0 5px 0;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }
        .slip-period {
            font-weight: 600;
            color: var(--text-muted);
            font-size: 0.9rem;
            margin: 0;
        }

        .meta-section {
            display: flex;
            justify-content: space-between;
            margin-bottom: 2rem;
            background-color: var(--bg-light);
            border-radius: 8px;
            padding: 1.25rem;
            font-size: 0.85rem;
            gap: 20px;
        }

        .meta-col {
            flex: 1;
            text-align: left;
            display: flex;
            flex-direction: column;
            gap: 8px;
        }

        .meta-row {
            display: flex;
            justify-content: space-between;
        }

        .meta-label {
            font-weight: 600;
            color: var(--text-muted);
        }

        .meta-val {
            font-weight: 700;
            color: var(--text-dark);
        }

        .ledger-section {
            display: flex;
            gap: 30px;
            margin-bottom: 2rem;
        }

        .ledger-col {
            flex: 1;
        }

        .ledger-table {
            width: 100%;
            border-collapse: collapse;
            font-size: 0.85rem;
        }

        .ledger-table th {
            text-align: left;
            padding: 0.75rem 0.5rem;
            border-bottom: 2px solid var(--border);
            text-transform: uppercase;
            font-weight: 700;
            color: var(--text-muted);
            font-size: 0.75rem;
            letter-spacing: 0.5px;
        }

        .ledger-table td {
            padding: 0.75rem 0.5rem;
            border-bottom: 1px solid var(--border);
            color: var(--text-dark);
        }

        .ledger-table tr.total-row td {
            font-weight: 700;
            border-bottom: 2px solid var(--border);
            border-top: 1px solid var(--text-dark);
            padding-top: 0.75rem;
        }

        .net-pay-section {
            background-color: var(--bg-light);
            border: 1px solid var(--border);
            border-radius: 8px;
            padding: 1.5rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 2.5rem;
        }

        .net-pay-title {
            font-weight: 800;
            font-size: 1.1rem;
            text-transform: uppercase;
            margin: 0;
            color: var(--text-dark);
        }

        .net-pay-amount {
            font-size: 1.6rem;
            font-weight: 800;
            color: var(--primary);
            margin: 0;
        }

        .footer-section {
            display: flex;
            justify-content: space-between;
            margin-top: 4rem;
            font-size: 0.8rem;
            color: var(--text-muted);
        }

        .signature-box {
            border-top: 1px dashed var(--text-muted);
            padding-top: 0.5rem;
            width: 150px;
            text-align: center;
        }

        .btn-print-box {
            margin-bottom: 1.5rem;
        }

        .btn-print {
            background-color: var(--primary);
            color: #ffffff;
            border: none;
            padding: 0.75rem 2rem;
            font-weight: 600;
            border-radius: 6px;
            cursor: pointer;
            box-shadow: 0 4px 10px rgba(79, 70, 229, 0.15);
            font-size: 0.9rem;
            transition: all 0.2s;
        }
        .btn-print:hover {
            transform: translateY(-1px);
            box-shadow: 0 6px 14px rgba(79, 70, 229, 0.25);
        }

        /* Print Media Styles */
        @@media print {
            body {
                background-color: #ffffff;
                padding: 0;
            }
            .payslip-container {
                box-shadow: none;
                border: none;
                padding: 0;
            }
            .btn-print-box {
                display: none;
            }
        }
    </style>
</head>
<body>

    <!-- Print Action Trigger -->
    <div class="btn-print-box">
        <button class="btn-print" onclick="window.print()"><i class="fa-solid fa-print me-2"></i> Print Payslip</button>
    </div>

    <!-- Payslip sheet -->
    <div class="payslip-container">
        
        <!-- Header -->
        <div class="header-section">
            <div class="company-logo-section">
                <h3 class="company-name">@company.CompanyName</h3>
                <p class="company-details">
                    @company.AddressLine1 @(string.IsNullOrEmpty(company.AddressLine2) ? "" : ", " + company.AddressLine2)<br />
                    @company.City, @company.State - @company.Country
                </p>
            </div>
            <div class="slip-title-section">
                <h4 class="slip-title">Salary Slip</h4>
                <p class="slip-period">@Model.PayPeriod</p>
            </div>
        </div>

        <!-- Meta Grid -->
        <div class="meta-section">
            <div class="meta-col">
                <div class="meta-row">
                    <span class="meta-label">Employee Name:</span>
                    <span class="meta-val">@Model.User?.FullName</span>
                </div>
                <div class="meta-row">
                    <span class="meta-label">Employee Code:</span>
                    <span class="meta-val">@Model.User?.UserCode</span>
                </div>
                <div class="meta-row">
                    <span class="meta-label">Designation:</span>
                    <span class="meta-val">@(Model.User?.Role?.RoleName ?? "Employee")</span>
                </div>
            </div>
            <div class="meta-col">
                <div class="meta-row">
                    <span class="meta-label">Payment Date:</span>
                    <span class="meta-val">@Model.PaymentDate.ToString("dd MMM yyyy")</span>
                </div>
                <div class="meta-row">
                    <span class="meta-label">Paid Days:</span>
                    <span class="meta-val">@Model.PaidDays Days</span>
                </div>
                <div class="meta-row">
                    <span class="meta-label">Status:</span>
                    <span class="meta-val text-success">@Model.Status</span>
                </div>
            </div>
        </div>

        <!-- Ledger Table Grid -->
        <div class="ledger-section">
            <!-- Earnings -->
            <div class="ledger-col">
                <table class="ledger-table">
                    <thead>
                        <tr>
                            <th>Earnings Description</th>
                            <th style="text-align: right;">Amount</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>Basic Salary</td>
                            <td style="text-align: right;">@Model.BasicSalary.ToString("C0", inCulture)</td>
                        </tr>
                        <tr>
                            <td>HRA (House Rent)</td>
                            <td style="text-align: right;">@Model.HRA.ToString("C0", inCulture)</td>
                        </tr>
                        <tr>
                            <td>Transport Allowance</td>
                            <td style="text-align: right;">@Model.TransportAllowance.ToString("C0", inCulture)</td>
                        </tr>
                        <tr>
                            <td>Medical Allowance</td>
                            <td style="text-align: right;">@Model.MedicalAllowance.ToString("C0", inCulture)</td>
                        </tr>
                        <tr class="total-row">
                            <td>Gross Earnings</td>
                            <td style="text-align: right;">@grossEarnings.ToString("C0", inCulture)</td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <!-- Deductions -->
            <div class="ledger-col">
                <table class="ledger-table">
                    <thead>
                        <tr>
                            <th>Deductions Description</th>
                            <th style="text-align: right;">Amount</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>Provident Fund (PF)</td>
                            <td style="text-align: right;">@Model.ProvidentFund.ToString("C0", inCulture)</td>
                        </tr>
                        <tr>
                            <td>Professional Tax (PT)</td>
                            <td style="text-align: right;">@Model.ProfessionalTax.ToString("C0", inCulture)</td>
                        </tr>
                        <tr>
                            <td>&nbsp;</td>
                            <td style="text-align: right;">&nbsp;</td>
                        </tr>
                        <tr>
                            <td>&nbsp;</td>
                            <td style="text-align: right;">&nbsp;</td>
                        </tr>
                        <tr class="total-row">
                            <td>Total Deductions</td>
                            <td style="text-align: right;">@totalDeductions.ToString("C0", inCulture)</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Net Payout -->
        <div class="net-pay-section">
            <h5 class="net-pay-title">Net Take-Home Payout</h5>
            <h3 class="net-pay-amount">@Model.NetSalary.ToString("C0", inCulture)</h3>
        </div>

        <!-- Signatures -->
        <div class="footer-section">
            <div class="signature-box">
                Employee Signature
            </div>
            <div class="signature-box">
                Authorized Signatory
            </div>
        </div>

    </div>

</body>
</html>

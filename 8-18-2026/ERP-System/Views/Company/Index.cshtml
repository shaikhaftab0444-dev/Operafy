@model ERP_System.Models.Company
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Company Profile";
}

<style>
    /* ---------- Entrance choreography ---------- */
    @@keyframes fadeSlideUp {
        from {
            opacity: 0;
            transform: translateY(14px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@keyframes fadeIn {
        from {
            opacity: 0;
        }

        to {
            opacity: 1;
        }
    }

    @@keyframes modalPop {
        from {
            opacity: 0;
            transform: translateY(24px) scale(0.98);
        }

        to {
            opacity: 1;
            transform: translateY(0) scale(1);
        }
    }

    @@keyframes spin {
        to {
            transform: rotate(360deg);
        }
    }

    @@media (prefers-reduced-motion: reduce) {
        *, *::before, *::after {
            animation-duration: 0.001ms !important;
            animation-iteration-count: 1 !important;
            transition-duration: 0.001ms !important;
        }
    }

    /* ---------- Page header ---------- */
    .company-header {
        animation: fadeSlideUp 0.5s ease both;
    }

        .company-header h4 {
            letter-spacing: -0.01em;
        }

    .breadcrumb-item a {
        color: var(--sidebar-color);
        transition: color 0.15s ease;
    }

        .breadcrumb-item a:hover {
            color: var(--primary-warm);
        }

    /* ---------- Card shell ---------- */
    .panel-company {
        background: #ffffff;
        border: 1px solid var(--border-warm);
        border-radius: 14px;
        box-shadow: 0 1px 2px rgba(45,37,30,0.04), 0 12px 32px -18px rgba(45,37,30,0.12);
        padding: 2.5rem;
        animation: fadeSlideUp 0.55s cubic-bezier(0.22, 1, 0.36, 1) 0.08s both;
        transition: box-shadow 0.25s ease;
    }

        .panel-company:hover {
            box-shadow: 0 1px 2px rgba(45,37,30,0.05), 0 16px 40px -18px rgba(45,37,30,0.16);
        }

    /* ---------- Identity block ---------- */
    .company-avatar {
        width: 60px;
        height: 60px;
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.6rem;
        color: #ffffff;
        background: linear-gradient(135deg, var(--primary-warm) 0%, #6366f1 100%);
        box-shadow: 0 6px 16px -4px rgba(79,70,229,0.35);
        flex-shrink: 0;
        transition: transform 0.25s ease, box-shadow 0.25s ease;
    }

    .panel-company:hover .company-avatar {
        transform: translateY(-2px);
        box-shadow: 0 10px 20px -4px rgba(79,70,229,0.4);
    }

    .company-code-pill {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        font-size: 0.78rem;
        color: var(--sidebar-color);
        background: #faf8f5;
        border: 1px solid var(--border-warm);
        padding: 0.15rem 0.6rem;
        border-radius: 999px;
        margin-top: 0.25rem;
    }

        .company-code-pill strong {
            color: var(--text-color);
            font-weight: 700;
            letter-spacing: 0.02em;
        }

    /* ---------- Detail rows ---------- */
    .detail-row {
        padding: 1rem 0;
        border-bottom: 1px dashed var(--border-warm);
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1.5rem;
        opacity: 0;
        animation: fadeSlideUp 0.45s ease forwards;
        transition: background-color 0.15s ease;
        border-radius: 6px;
    }

        .detail-row:last-child {
            border-bottom: none;
        }

        .detail-row:hover {
            background-color: #faf8f5;
        }

        /* Staggered reveal, one row after another */
        .detail-row:nth-child(1) {
            animation-delay: 0.16s;
        }

        .detail-row:nth-child(2) {
            animation-delay: 0.20s;
        }

        .detail-row:nth-child(3) {
            animation-delay: 0.24s;
        }

        .detail-row:nth-child(4) {
            animation-delay: 0.28s;
        }

        .detail-row:nth-child(5) {
            animation-delay: 0.32s;
        }

        .detail-row:nth-child(6) {
            animation-delay: 0.36s;
        }

        .detail-row:nth-child(7) {
            animation-delay: 0.40s;
        }

        .detail-row:nth-child(8) {
            animation-delay: 0.44s;
        }

    .detail-label {
        font-weight: 700;
        text-transform: uppercase;
        font-size: 0.78rem;
        color: var(--sidebar-color);
        letter-spacing: 0.06em;
        white-space: nowrap;
    }

    .detail-value {
        font-size: 0.95rem;
        color: var(--text-color);
        font-weight: 600;
        text-align: right;
    }

        .detail-value a {
            position: relative;
            transition: color 0.15s ease;
        }

            .detail-value a::after {
                content: "";
                position: absolute;
                left: 0;
                bottom: -2px;
                width: 100%;
                height: 1px;
                background: currentColor;
                transform: scaleX(0);
                transform-origin: right;
                transition: transform 0.2s ease;
            }

            .detail-value a:hover::after {
                transform: scaleX(1);
                transform-origin: left;
            }

        .detail-value.text-muted-value {
            color: #b0a89a;
            font-weight: 500;
            font-style: italic;
        }

    /* ---------- Primary button ---------- */
    .btn-primary-warm {
        background: linear-gradient(135deg, var(--primary-warm) 0%, #6366f1 100%);
        color: #ffffff;
        border: none;
        font-weight: 600;
        font-size: 0.875rem;
        box-shadow: 0 4px 10px rgba(79, 70, 229, 0.2);
        transition: transform 0.18s ease, box-shadow 0.18s ease, filter 0.18s ease;
    }

        .btn-primary-warm:hover {
            transform: translateY(-1px);
            box-shadow: 0 6px 16px rgba(79, 70, 229, 0.32);
            color: #ffffff;
            filter: brightness(1.03);
        }

        .btn-primary-warm:active {
            transform: translateY(0);
            box-shadow: 0 3px 8px rgba(79, 70, 229, 0.25);
        }

        .btn-primary-warm:disabled {
            opacity: 0.75;
            cursor: progress;
            transform: none;
        }

        .btn-primary-warm .spinner {
            display: inline-block;
            width: 0.85rem;
            height: 0.85rem;
            border: 2px solid rgba(255,255,255,0.4);
            border-top-color: #ffffff;
            border-radius: 50%;
            margin-right: 0.5rem;
            animation: spin 0.6s linear infinite;
            vertical-align: -1px;
        }

    /* ---------- Alert ---------- */
    .alert-success-warm {
        background-color: #f0fdf4;
        color: #15803d;
        border-left: 4px solid #16a34a;
        animation: fadeSlideUp 0.4s ease both;
    }

    /* ---------- Form controls ---------- */
    .form-control-warm {
        border: 1px solid #d4cbbd !important;
        background-color: #fcfbfa !important;
        color: var(--text-color) !important;
        font-size: 0.9rem !important;
        border-radius: 8px !important;
        padding: 0.6rem 0.85rem !important;
        transition: border-color 0.15s ease, box-shadow 0.15s ease, background-color 0.15s ease !important;
    }

        .form-control-warm:hover {
            border-color: #c2b7a5 !important;
        }

        .form-control-warm:focus {
            border-color: var(--primary-warm) !important;
            box-shadow: 0 0 0 3px rgba(79,70,229,0.1) !important;
            background-color: #ffffff !important;
        }

    .form-label {
        color: var(--text-color);
        margin-bottom: 0.35rem;
    }

    /* ---------- Modal ---------- */
    #editCompanyModal .modal-content {
        border-radius: 14px;
        animation: modalPop 0.3s cubic-bezier(0.22, 1, 0.36, 1) both;
        overflow: hidden;
    }

    #editCompanyModal .modal-header {
        background: linear-gradient(180deg, #faf8f5 0%, #ffffff 100%);
    }

    #editCompanyModal .btn-close {
        transition: transform 0.15s ease, opacity 0.15s ease;
    }

        #editCompanyModal .btn-close:hover {
            transform: rotate(90deg);
        }

    .btn-secondary {
        transition: background-color 0.15s ease, transform 0.15s ease;
    }

        .btn-secondary:hover {
            transform: translateY(-1px);
        }
</style>

<!-- Breadcrumbs & Header -->
<div class="company-header d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-3 mb-4">
    <div>
        <h4 class="fw-bold mb-1" style="color: var(--text-color);">Company Settings</h4>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0 small">
                <li class="breadcrumb-item"><a href="/Dashboard" class="text-decoration-none">Dashboard</a></li>
                <li class="breadcrumb-item active" aria-current="page">Company</li>
            </ol>
        </nav>
    </div>

    <button class="btn btn-primary-warm px-4 py-2" data-bs-toggle="modal" data-bs-target="#editCompanyModal">
        <i class="fa-solid fa-pen-to-square me-2"></i> Edit Company Profile
    </button>
</div>

<!-- Alerts -->
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success-warm border-0 shadow-sm alert-dismissible fade show mb-4 small text-start" role="alert">
        <i class="fa-solid fa-circle-check me-2"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="row g-4 justify-content-center">
    <!-- Company Card -->
    <div class="col-lg-8">
        <div class="panel-company text-start">
            <div class="d-flex align-items-center gap-3 mb-4">
                <div class="company-avatar">
                    <i class="fa-solid fa-building"></i>
                </div>
                <div>
                    <h4 class="fw-bold text-dark mb-0">@Model.CompanyName</h4>
                    <span class="company-code-pill"><i class="fa-solid fa-hashtag"></i> Company Code: <strong>@Model.CompanyCode</strong></span>
                </div>
            </div>

            <hr style="border-color: var(--border-warm); margin-bottom: 1rem;" />

            <div class="d-flex flex-column">
                <div class="detail-row">
                    <span class="detail-label">Office Location</span>
                    <span class="detail-value">@Model.AddressLine1 @(string.IsNullOrEmpty(Model.AddressLine2) ? "" : ", " + Model.AddressLine2)</span>
                </div>
                <div class="detail-row">
                    <span class="detail-label">City / State</span>
                    <span class="detail-value">@Model.City, @Model.State</span>
                </div>
                <div class="detail-row">
                    <span class="detail-label">Country</span>
                    <span class="detail-value">@Model.Country</span>
                </div>
                <div class="detail-row">
                    <span class="detail-label">Postal Zip Code</span>
                    <span class="detail-value @(string.IsNullOrEmpty(Model.PostalCode) ? "text-muted-value" : "")">@(string.IsNullOrEmpty(Model.PostalCode) ? "N/A" : Model.PostalCode)</span>
                </div>
                <div class="detail-row">
                    <span class="detail-label">Phone Support</span>
                    <span class="detail-value @(string.IsNullOrEmpty(Model.Phone) ? "text-muted-value" : "")">@(string.IsNullOrEmpty(Model.Phone) ? "N/A" : Model.Phone)</span>
                </div>
                <div class="detail-row">
                    <span class="detail-label">Company Email</span>
                    <span class="detail-value @(string.IsNullOrEmpty(Model.Email) ? "text-muted-value" : "")">@(string.IsNullOrEmpty(Model.Email) ? "N/A" : Model.Email)</span>
                </div>
                <div class="detail-row">
                    <span class="detail-label">Corporate Website</span>
                    <span class="detail-value">
                        @if (!string.IsNullOrEmpty(Model.Website))
                        {
                            <a href="https://@Model.Website" target="_blank" class="text-primary text-decoration-none fw-bold">@Model.Website</a>
                        }
                        else
                        {
                            <span class="text-muted-value">N/A</span>
                        }
                    </span>
                </div>
                <div class="detail-row">
                    <span class="detail-label">System TimeZone</span>
                    <span class="detail-value">@(string.IsNullOrEmpty(Model.TimeZone) ? "UTC" : Model.TimeZone)</span>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Edit Company Modal -->
<div class="modal fade" id="editCompanyModal" tabindex="-1" aria-labelledby="editCompanyModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow">
            <div class="modal-header border-bottom p-4" style="border-color: var(--border-warm) !important;">
                <h5 class="modal-title fw-bold text-dark" id="editCompanyModalLabel"><i class="fa-solid fa-pen-to-square me-2 text-primary"></i>Edit Company Profile</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="Update" method="post" id="editCompanyForm">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="CompanyId" />

                <div class="modal-body p-4 text-start">
                    <div class="row g-3">
                        <!-- Company Name -->
                        <div class="col-md-8">
                            <label asp-for="CompanyName" class="form-label small fw-bold text-dark">Company Name</label>
                            <input asp-for="CompanyName" class="form-control form-control-warm" required />
                            <span asp-validation-for="CompanyName" class="text-danger small"></span>
                        </div>

                        <!-- Company Code -->
                        <div class="col-md-4">
                            <label asp-for="CompanyCode" class="form-label small fw-bold text-dark">Company Code</label>
                            <input asp-for="CompanyCode" class="form-control form-control-warm" required />
                            <span asp-validation-for="CompanyCode" class="text-danger small"></span>
                        </div>

                        <!-- Email -->
                        <div class="col-md-6">
                            <label asp-for="Email" class="form-label small fw-bold text-dark">Email Address</label>
                            <input asp-for="Email" class="form-control form-control-warm" type="email" />
                        </div>

                        <!-- Phone -->
                        <div class="col-md-6">
                            <label asp-for="Phone" class="form-label small fw-bold text-dark">Phone Number</label>
                            <input asp-for="Phone" class="form-control form-control-warm" />
                        </div>

                        <!-- Website -->
                        <div class="col-md-12">
                            <label asp-for="Website" class="form-label small fw-bold text-dark">Website URL</label>
                            <input asp-for="Website" class="form-control form-control-warm" placeholder="www.example.com" />
                        </div>

                        <!-- Address Line 1 -->
                        <div class="col-md-12">
                            <label asp-for="AddressLine1" class="form-label small fw-bold text-dark">Address Line 1</label>
                            <input asp-for="AddressLine1" class="form-control form-control-warm" required />
                            <span asp-validation-for="AddressLine1" class="text-danger small"></span>
                        </div>

                        <!-- Address Line 2 -->
                        <div class="col-md-12">
                            <label asp-for="AddressLine2" class="form-label small fw-bold text-dark">Address Line 2 (Optional)</label>
                            <input asp-for="AddressLine2" class="form-control form-control-warm" />
                        </div>

                        <!-- City -->
                        <div class="col-md-4">
                            <label asp-for="City" class="form-label small fw-bold text-dark">City</label>
                            <input asp-for="City" class="form-control form-control-warm" required />
                        </div>

                        <!-- State -->
                        <div class="col-md-4">
                            <label asp-for="State" class="form-label small fw-bold text-dark">State</label>
                            <input asp-for="State" class="form-control form-control-warm" required />
                        </div>

                        <!-- Postal Code -->
                        <div class="col-md-4">
                            <label asp-for="PostalCode" class="form-label small fw-bold text-dark">Postal Code</label>
                            <input asp-for="PostalCode" class="form-control form-control-warm" />
                        </div>

                        <!-- Country -->
                        <div class="col-md-6">
                            <label asp-for="Country" class="form-label small fw-bold text-dark">Country</label>
                            <input asp-for="Country" class="form-control form-control-warm" required />
                        </div>

                        <!-- Currency -->
                        <div class="col-md-6">
                            <label asp-for="Currency" class="form-label small fw-bold text-dark">Local Currency</label>
                            <input asp-for="Currency" class="form-control form-control-warm" placeholder="INR, USD" />
                        </div>
                    </div>
                </div>

                <div class="modal-footer border-top p-4" style="border-color: var(--border-warm) !important;">
                    <button type="button" class="btn btn-secondary px-4 py-2" data-bs-dismiss="modal">Close</button>
                    <button type="submit" class="btn btn-primary-warm px-4 py-2" id="saveCompanyBtn">Save Changes</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    // Subtle loading state on submit so the save action feels responsive, not abrupt.
    document.getElementById('editCompanyForm')?.addEventListener('submit', function () {
        var btn = document.getElementById('saveCompanyBtn');
        if (btn) {
            btn.disabled = true;
            btn.innerHTML = '<span class="spinner"></span>Saving...';
        }
    });
</script>

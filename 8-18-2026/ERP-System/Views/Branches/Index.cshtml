@model IEnumerable<ERP_System.Models.Branch>
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Branch Settings";
    var activeCompany = (ERP_System.Models.Company)ViewBag.ActiveCompany;
}

<style>
    .card-branch {
        background: #ffffff;
        border: 1px solid var(--border-warm);
        border-radius: 12px;
        padding: 1.25rem;
        box-shadow: 0 1px 3px rgba(45,37,30,0.03);
        display: flex;
        align-items: center;
        gap: 15px;
        height: 100%;
        text-align: left;
    }
    
    .branch-icon-wrap {
        width: 48px;
        height: 48px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.25rem;
        background-color: rgba(79, 70, 229, 0.08); 
        color: var(--primary-warm);
    }

    .branch-info {
        flex-grow: 1;
    }
    .branch-label {
        font-size: 0.75rem;
        color: var(--sidebar-color);
        font-weight: 700;
        margin-bottom: 2px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }
    .branch-val {
        font-size: 1.4rem;
        font-weight: 700;
        color: var(--text-color);
    }

    .panel-branch {
        background: #ffffff;
        border: 1px solid var(--border-warm);
        border-radius: 12px;
        padding: 1.5rem;
        box-shadow: 0 1px 3px rgba(45,37,30,0.03);
    }

    .table-branch th {
        background-color: #fcfbfa !important;
        font-size: 0.75rem;
        text-transform: uppercase;
        font-weight: 700;
        color: #7c7267;
        border-bottom: 1px solid var(--border-warm);
        padding: 0.85rem 1rem;
    }
    .table-branch td {
        font-size: 0.85rem;
        color: var(--text-color);
        border-bottom: 1px solid var(--border-warm);
        padding: 0.85rem 1rem;
        vertical-align: middle;
    }

    .badge-active {
        background-color: rgba(16, 185, 129, 0.08);
        color: #10b981;
        font-weight: 600;
        border: 1px solid rgba(16, 185, 129, 0.2);
    }
    .badge-inactive {
        background-color: rgba(239, 68, 68, 0.08);
        color: #ef4444;
        font-weight: 600;
        border: 1px solid rgba(239, 68, 68, 0.2);
    }
</style>

<!-- Top Breadcrumbs & Page Header -->
<div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-3 mb-4 text-start">
    <div>
        <h4 class="fw-bold mb-1" style="color: var(--text-color);">Branch Management</h4>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0 small">
                <li class="breadcrumb-item"><a href="/Dashboard" class="text-decoration-none">Dashboard</a></li>
                <li class="breadcrumb-item"><a href="/Company" class="text-decoration-none">Company Settings</a></li>
                <li class="breadcrumb-item active" aria-current="page">Branches</li>
            </ol>
        </nav>
    </div>
    
    @if (User.IsInRole("Super Admin") || User.IsInRole("Admin"))
    {
        <a href="/Branches/Create" class="btn btn-primary-warm px-4 py-2">
            <i class="fa-solid fa-plus me-2"></i> Add New Branch
        </a>
    }
</div>

<!-- Alerts -->
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success border-0 shadow-sm alert-dismissible fade show mb-4 small text-start" role="alert" style="background-color: #f0fdf4; color: #15803d; border-left: 4px solid #16a34a !important;">
        <i class="fa-solid fa-circle-check me-2"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- KPI Cards -->
<div class="row g-4 mb-4 text-start">
    <div class="col-md-6">
        <div class="card-branch">
            <div class="branch-icon-wrap"><i class="fa-solid fa-city"></i></div>
            <div class="branch-info">
                <div class="branch-label">Active Company</div>
                <div class="branch-val">@activeCompany.CompanyName</div>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card-branch">
            <div class="branch-icon-wrap" style="background-color: rgba(217, 119, 6, 0.08); color: var(--accent-warm);"><i class="fa-solid fa-code-fork"></i></div>
            <div class="branch-info">
                <div class="branch-label">Total Branches</div>
                <div class="branch-val">@Model.Count() Branches</div>
            </div>
        </div>
    </div>
</div>

<!-- Branch Directory Table -->
<div class="panel-branch p-0 overflow-hidden">
    <div class="table-responsive">
        <table class="table table-hover table-branch mb-0 border-0 text-start">
            <thead>
                <tr>
                    <th class="ps-3 border-0">Code</th>
                    <th class="border-0">Branch Name</th>
                    <th class="border-0">Contact details</th>
                    <th class="border-0">Address Info</th>
                    <th class="border-0 text-center">Status</th>
                    @if (User.IsInRole("Super Admin") || User.IsInRole("Admin"))
                    {
                        <th class="border-0 text-center">Actions</th>
                    }
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var branch in Model)
                    {
                        <tr>
                            <td class="ps-3 fw-bold text-secondary">@branch.BranchCode</td>
                            <td class="fw-bold text-dark">@branch.BranchName</td>
                            <td>
                                <div style="font-size: 0.85rem;"><i class="fa-regular fa-envelope me-1.5 text-muted"></i>@branch.Email</div>
                                <div class="text-secondary" style="font-size: 0.8rem;"><i class="fa-solid fa-phone me-1.5 text-muted"></i>@branch.Phone</div>
                            </td>
                            <td>
                                <div style="font-size: 0.85rem;">@branch.AddressLine1</div>
                                <div class="text-secondary" style="font-size: 0.8rem;">@branch.City, @branch.State - @branch.Country</div>
                            </td>
                            <td class="text-center">
                                @if (branch.IsActive)
                                {
                                    <span class="badge rounded-pill px-2.5 py-1.5 badge-active" style="font-size: 0.75rem;">Active</span>
                                }
                                else
                                {
                                    <span class="badge rounded-pill px-2.5 py-1.5 badge-inactive" style="font-size: 0.75rem;">Inactive</span>
                                }
                            </td>
                            @if (User.IsInRole("Super Admin") || User.IsInRole("Admin"))
                            {
                                <td class="text-center">
                                    <div class="d-flex justify-content-center gap-2">
                                        <a href="/Branches/Edit/@branch.BranchId" class="btn btn-sm btn-outline-secondary btn-sm-custom px-3 py-1">
                                            <i class="fa-regular fa-pen-to-square me-1"></i> Edit
                                        </a>
                                        
                                        <form asp-action="ToggleStatus" asp-route-id="@branch.BranchId" method="post" style="display:inline;">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-sm-custom px-3 py-1 @(branch.IsActive ? "btn-outline-danger" : "btn-outline-success")">
                                                <i class="fa-solid @(branch.IsActive ? "fa-ban" : "fa-circle-check") me-1"></i>
                                                @(branch.IsActive ? "Deactivate" : "Activate")
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            }
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="text-center text-muted py-5">No branches have been registered under this company yet.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

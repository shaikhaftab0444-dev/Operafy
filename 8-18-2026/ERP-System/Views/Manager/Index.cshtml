@model ERP_System.Models.ManagerDashboardViewModel
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Manager Dashboard";
    var inCulture = new System.Globalization.CultureInfo("en-IN");
    var stockAlertPct = Model.TotalProducts > 0
        ? Math.Round((double)Model.LowStockCount / Model.TotalProducts * 100, 1)
        : 0;
}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet">

<style>
    .ops-dash {
        --ops-bg: #f6f7f9;
        --ops-panel: #ffffff;
        --ops-panel-raised: #f2f4f7;
        --ops-border: #e4e7ec;
        --ops-text: #1a1d23;
        --ops-muted: #66707e;
        --ops-faint: #98a2b3;
        --ops-cyan: #0891b2;
        --ops-amber: #d97706;
        --ops-red: #dc2626;
        --ops-green: #059669;
        --ops-violet: #7c3aed;
        --ops-font-display: 'Space Grotesk', sans-serif;
        --ops-font-body: 'Inter', sans-serif;
        --ops-font-mono: 'IBM Plex Mono', monospace;
        background: var(--ops-bg);
        border-radius: 18px;
        padding: 1.75rem;
        color: var(--ops-text);
        font-family: var(--ops-font-body);
        position: relative;
        overflow: hidden;
        border: 1px solid var(--ops-border);
    }

        .ops-dash * {
            box-sizing: border-box;
        }

    /* ---------- header ---------- */
    .ops-header {
        position: relative;
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        flex-wrap: wrap;
        gap: 1rem;
        padding-bottom: 1.5rem;
        margin-bottom: 1.5rem;
        border-bottom: 1px solid var(--ops-border);
        overflow: hidden;
    }

        .ops-header::before {
            content: "";
            position: absolute;
            top: 0;
            left: -30%;
            width: 30%;
            height: 1px;
            background: linear-gradient(90deg, transparent, var(--ops-cyan), transparent);
            animation: ops-scan 5s linear infinite;
            opacity: 0.45;
        }

    @@keyframes ops-scan {
        0% {
            left: -30%;
        }

        100% {
            left: 100%;
        }
    }

    .ops-eyebrow {
        font-family: var(--ops-font-mono);
        font-size: 0.7rem;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--ops-cyan);
        display: flex;
        align-items: center;
        gap: 0.5rem;
        margin-bottom: 0.4rem;
    }

    .ops-live-dot {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: var(--ops-green);
        box-shadow: 0 0 0 0 rgba(5,150,105,0.5);
        animation: ops-pulse 1.8s ease-out infinite;
    }

    @@keyframes ops-pulse {
        0% {
            box-shadow: 0 0 0 0 rgba(5,150,105,0.45);
        }

        70% {
            box-shadow: 0 0 0 7px rgba(5,150,105,0);
        }

        100% {
            box-shadow: 0 0 0 0 rgba(5,150,105,0);
        }
    }

    .ops-title {
        font-family: var(--ops-font-display);
        font-weight: 700;
        font-size: 1.6rem;
        letter-spacing: -0.01em;
        color: var(--ops-text);
        margin: 0;
    }

    .ops-crumb {
        font-family: var(--ops-font-mono);
        font-size: 0.75rem;
        color: var(--ops-faint);
        margin-top: 0.3rem;
    }

        .ops-crumb a {
            color: var(--ops-muted);
            text-decoration: none;
        }

            .ops-crumb a:hover {
                color: var(--ops-cyan);
            }

    .ops-clockwrap {
        text-align: right;
        font-family: var(--ops-font-mono);
    }

    .ops-clock {
        font-size: 1.5rem;
        font-weight: 600;
        color: var(--ops-cyan);
        letter-spacing: 0.03em;
        font-variant-numeric: tabular-nums;
    }

    .ops-clock-label {
        font-size: 0.68rem;
        color: var(--ops-faint);
        text-transform: uppercase;
        letter-spacing: 0.1em;
    }

    /* ---------- alert ---------- */
    .ops-alert {
        background: rgba(5,150,105,0.07);
        border: 1px solid rgba(5,150,105,0.22);
        border-left: 3px solid var(--ops-green);
        color: #057a52;
        border-radius: 8px;
        padding: 0.85rem 1.1rem;
        font-size: 0.85rem;
        margin-bottom: 1.5rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        animation: ops-rise 0.4s ease both;
    }

    .ops-alert-close {
        background: none;
        border: none;
        color: #057a52;
        opacity: 0.6;
        cursor: pointer;
        font-size: 1rem;
        line-height: 1;
    }

        .ops-alert-close:hover {
            opacity: 1;
        }

    /* ---------- reveal animation ---------- */
    @@keyframes ops-rise {
        from {
            opacity: 0;
            transform: translateY(10px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .ops-reveal {
        opacity: 0;
        animation: ops-rise 0.5s cubic-bezier(.16,.84,.44,1) forwards;
        animation-delay: calc(var(--d, 0) * 70ms);
    }

    /* ---------- KPI grid ---------- */
    .ops-kpi-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 1rem;
        margin-bottom: 1.5rem;
    }

    .ops-kpi {
        background: var(--ops-panel);
        border: 1px solid var(--ops-border);
        border-radius: 12px;
        padding: 1.15rem 1.25rem;
        position: relative;
        overflow: hidden;
        box-shadow: 0 1px 2px rgba(16,24,40,0.03);
        transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
    }

        .ops-kpi:hover {
            transform: translateY(-3px);
            border-color: var(--ops-accent, var(--ops-cyan));
            box-shadow: 0 10px 20px rgba(16,24,40,0.06);
        }

        .ops-kpi::after {
            content: "";
            position: absolute;
            left: 0;
            top: 0;
            bottom: 0;
            width: 3px;
            background: var(--ops-accent, var(--ops-cyan));
            opacity: 0.85;
        }

    .ops-kpi-team {
        --ops-accent: var(--ops-cyan);
    }

    .ops-kpi-catalog {
        --ops-accent: var(--ops-violet);
    }

    .ops-kpi-alert {
        --ops-accent: var(--ops-red);
    }

    .ops-kpi-approval {
        --ops-accent: var(--ops-amber);
    }

    .ops-kpi-top {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 0.6rem;
    }

    .ops-kpi-label {
        font-family: var(--ops-font-mono);
        font-size: 0.68rem;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: var(--ops-muted);
    }

    .ops-kpi-icon {
        width: 28px;
        height: 28px;
        border-radius: 7px;
        background: color-mix(in srgb, var(--ops-accent) 15%, transparent);
        color: var(--ops-accent);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.85rem;
        flex-shrink: 0;
    }

    .ops-kpi-val {
        font-family: var(--ops-font-display);
        font-size: 2rem;
        font-weight: 700;
        color: var(--ops-text);
        line-height: 1;
        font-variant-numeric: tabular-nums;
    }

    .ops-kpi-unit {
        font-family: var(--ops-font-body);
        font-size: 0.75rem;
        font-weight: 500;
        color: var(--ops-muted);
        margin-left: 0.35rem;
    }

    .ops-kpi-sub {
        margin-top: 0.55rem;
        font-family: var(--ops-font-mono);
        font-size: 0.7rem;
        color: var(--ops-faint);
    }

        .ops-kpi-sub strong {
            color: var(--ops-accent);
            font-weight: 600;
        }

    .ops-kpi-bar {
        margin-top: 0.6rem;
        height: 3px;
        background: rgba(255,255,255,0.06);
        border-radius: 2px;
        overflow: hidden;
    }

    .ops-kpi-bar-fill {
        height: 100%;
        background: var(--ops-accent);
        width: 0%;
        border-radius: 2px;
        transition: width 1.1s cubic-bezier(.16,.84,.44,1);
    }

    /* ---------- panels ---------- */
    .ops-mid-grid {
        display: grid;
        grid-template-columns: 1.7fr 1fr;
        gap: 1rem;
        margin-bottom: 1.5rem;
    }

    .ops-bottom-grid {
        display: grid;
        grid-template-columns: 1.4fr 1fr;
        gap: 1rem;
    }

    .ops-panel {
        background: var(--ops-panel);
        border: 1px solid var(--ops-border);
        border-radius: 12px;
        padding: 1.35rem;
        height: 100%;
        box-shadow: 0 1px 2px rgba(16,24,40,0.03);
    }

    .ops-panel-flush {
        padding: 0;
        overflow: hidden;
    }

    .ops-panel-head {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1.1rem;
    }

    .ops-panel-flush .ops-panel-head {
        padding: 1.35rem 1.35rem 0;
        margin-bottom: 0.9rem;
    }

    .ops-panel-title {
        font-family: var(--ops-font-display);
        font-weight: 600;
        font-size: 0.95rem;
        color: var(--ops-text);
        margin: 0;
    }

    .ops-panel-tag {
        font-family: var(--ops-font-mono);
        font-size: 0.68rem;
        color: var(--ops-faint);
        text-transform: uppercase;
        letter-spacing: 0.06em;
    }

    /* ---------- activity feed ---------- */
    .ops-feed {
        display: flex;
        flex-direction: column;
    }

    .ops-feed-item {
        display: flex;
        gap: 0.85rem;
        position: relative;
        padding-bottom: 1.15rem;
    }

        .ops-feed-item:not(:last-child)::before {
            content: "";
            position: absolute;
            left: 15px;
            top: 32px;
            bottom: 0;
            width: 1px;
            background: var(--ops-border);
        }

    .ops-feed-dot {
        width: 32px;
        height: 32px;
        border-radius: 8px;
        background: rgba(8,145,178,0.08);
        border: 1px solid var(--ops-border);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.8rem;
        color: var(--ops-cyan);
        flex-shrink: 0;
    }

    .ops-feed-title {
        font-size: 0.82rem;
        font-weight: 600;
        color: var(--ops-text);
    }

    .ops-feed-desc {
        font-size: 0.76rem;
        color: var(--ops-muted);
        margin-top: 1px;
    }

    .ops-feed-time {
        font-family: var(--ops-font-mono);
        font-size: 0.68rem;
        color: var(--ops-faint);
        white-space: nowrap;
        margin-left: auto;
        padding-left: 0.5rem;
    }

    .ops-empty {
        text-align: center;
        color: var(--ops-faint);
        font-size: 0.82rem;
        padding: 2.75rem 1rem;
        font-family: var(--ops-font-mono);
    }

    /* ---------- tables ---------- */
    .ops-table-wrap {
        overflow-x: auto;
    }

    .ops-table {
        width: 100%;
        border-collapse: collapse;
    }

        .ops-table th {
            font-family: var(--ops-font-mono);
            font-size: 0.65rem;
            text-transform: uppercase;
            letter-spacing: 0.07em;
            color: var(--ops-faint);
            text-align: left;
            padding: 0.7rem 1.35rem;
            border-bottom: 1px solid var(--ops-border);
            white-space: nowrap;
        }

        .ops-table td {
            padding: 0.85rem 1.35rem;
            font-size: 0.82rem;
            color: var(--ops-text);
            border-bottom: 1px solid var(--ops-border);
            vertical-align: middle;
        }

        .ops-table tbody tr {
            transition: background 0.15s ease;
        }

            .ops-table tbody tr:hover {
                background: rgba(255,255,255,0.02);
            }

            .ops-table tbody tr:last-child td {
                border-bottom: none;
            }

    .ops-mono {
        font-family: var(--ops-font-mono);
    }

    .ops-strong {
        font-weight: 600;
        color: var(--ops-text);
    }

    .ops-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        font-family: var(--ops-font-mono);
        font-size: 0.68rem;
        font-weight: 500;
        padding: 0.3rem 0.65rem;
        border-radius: 20px;
        text-transform: uppercase;
        letter-spacing: 0.04em;
    }

    .ops-badge-dot {
        width: 5px;
        height: 5px;
        border-radius: 50%;
        flex-shrink: 0;
    }

    .ops-badge-pending {
        background: rgba(245,166,35,0.1);
        color: var(--ops-amber);
        border: 1px solid rgba(245,166,35,0.28);
    }

        .ops-badge-pending .ops-badge-dot {
            background: var(--ops-amber);
            animation: ops-blink 1.6s ease-in-out infinite;
        }

    .ops-badge-danger {
        background: rgba(240,85,77,0.1);
        color: var(--ops-red);
        border: 1px solid rgba(240,85,77,0.28);
    }

        .ops-badge-danger .ops-badge-dot {
            background: var(--ops-red);
            animation: ops-blink 1.6s ease-in-out infinite;
        }

    .ops-badge-warn {
        background: rgba(245,166,35,0.1);
        color: var(--ops-amber);
        border: 1px solid rgba(245,166,35,0.28);
    }

        .ops-badge-warn .ops-badge-dot {
            background: var(--ops-amber);
        }

    @@keyframes ops-blink {
        0%, 100% {
            opacity: 1;
        }

        50% {
            opacity: 0.25;
        }
    }

    .ops-btn-approve {
        background: linear-gradient(135deg, #10b981 0%, #059669 100%);
        color: #ffffff;
        border: none;
        font-family: var(--ops-font-body);
        font-weight: 700;
        font-size: 0.76rem;
        padding: 0.45rem 0.9rem;
        border-radius: 6px;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        box-shadow: 0 1px 3px rgba(5,150,105,0.25);
        transition: box-shadow 0.2s ease, transform 0.2s ease;
    }

        .ops-btn-approve:hover {
            box-shadow: 0 6px 16px rgba(5,150,105,0.35);
            transform: translateY(-1px);
            color: #ffffff;
        }

    /* ---------- responsive ---------- */
    @@media (max-width: 1100px) {
        .ops-kpi-grid {
            grid-template-columns: repeat(2, 1fr);
        }

        .ops-mid-grid, .ops-bottom-grid {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 560px) {
        .ops-kpi-grid {
            grid-template-columns: 1fr;
        }

        .ops-header {
            flex-direction: column;
            align-items: flex-start;
        }

        .ops-clockwrap {
            text-align: left;
        }
    }

    @@media (prefers-reduced-motion: reduce) {
        .ops-header::before, .ops-live-dot, .ops-badge-dot {
            animation: none !important;
        }

        .ops-reveal {
            animation: none !important;
            opacity: 1 !important;
            transform: none !important;
        }

        .ops-kpi:hover {
            transform: none;
        }
    }
</style>

<div class="ops-dash">
    <!-- Header -->
    <div class="ops-header">
        <div>
            <div class="ops-eyebrow"><span class="ops-live-dot"></span> Live &middot; Operations Control</div>
            <h4 class="ops-title">Manager Dashboard</h4>
            <div class="ops-crumb"><a href="/Dashboard">Home</a> &nbsp;/&nbsp; Manager Portal</div>
        </div>
        <div class="ops-clockwrap">
            <div class="ops-clock" id="opsClock">--:--:--</div>
            <div class="ops-clock-label" id="opsDate">Loading date</div>
        </div>
    </div>

    <!-- Alert -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="ops-alert" role="alert">
            <span><i class="fa-solid fa-circle-check me-2"></i>@TempData["SuccessMessage"]</span>
            <button type="button" class="ops-alert-close" onclick="this.closest('.ops-alert').style.display='none'">&times;</button>
        </div>
    }

    <!-- KPI strip -->
    <div class="ops-kpi-grid">
        <div class="ops-kpi ops-kpi-team ops-reveal" style="--d:1">
            <div class="ops-kpi-top">
                <span class="ops-kpi-label">Direct Team</span>
                <span class="ops-kpi-icon"><i class="fa-solid fa-users"></i></span>
            </div>
            <div><span class="ops-kpi-val ops-count" data-target="@Model.TotalTeamMembers">0</span><span class="ops-kpi-unit">staff</span></div>
            <div class="ops-kpi-sub">Reporting into this desk</div>
        </div>

        <div class="ops-kpi ops-kpi-catalog ops-reveal" style="--d:2">
            <div class="ops-kpi-top">
                <span class="ops-kpi-label">Catalog Items</span>
                <span class="ops-kpi-icon"><i class="fa-solid fa-cubes"></i></span>
            </div>
            <div><span class="ops-kpi-val ops-count" data-target="@Model.TotalProducts">0</span><span class="ops-kpi-unit">products</span></div>
            <div class="ops-kpi-sub">Active SKUs in system</div>
        </div>

        <div class="ops-kpi ops-kpi-alert ops-reveal" style="--d:3">
            <div class="ops-kpi-top">
                <span class="ops-kpi-label">Critical Stock</span>
                <span class="ops-kpi-icon"><i class="fa-solid fa-triangle-exclamation"></i></span>
            </div>
            <div><span class="ops-kpi-val ops-count" data-target="@Model.LowStockCount">0</span><span class="ops-kpi-unit">items</span></div>
            <div class="ops-kpi-sub"><strong>@stockAlertPct%</strong> of catalog at risk</div>
            <div class="ops-kpi-bar"><div class="ops-kpi-bar-fill" data-fill="@stockAlertPct"></div></div>
        </div>

        <div class="ops-kpi ops-kpi-approval ops-reveal" style="--d:4">
            <div class="ops-kpi-top">
                <span class="ops-kpi-label">Pending Approvals</span>
                <span class="ops-kpi-icon"><i class="fa-solid fa-file-signature"></i></span>
            </div>
            <div><span class="ops-kpi-val ops-count" data-target="@Model.PendingApprovalsCount">0</span><span class="ops-kpi-unit">orders</span></div>
            <div class="ops-kpi-sub">Awaiting your sign-off</div>
        </div>
    </div>

    <!-- Chart + Activity -->
    <div class="ops-mid-grid">
        <div class="ops-panel ops-reveal" style="--d:5">
            <div class="ops-panel-head">
                <h5 class="ops-panel-title">Critical Stock Levels</h5>
                <span class="ops-panel-tag">Units in warehouse</span>
            </div>
            <div style="position: relative; height: 250px; width: 100%;">
                <canvas id="stockAlertsChart"></canvas>
            </div>
        </div>

        <div class="ops-panel ops-reveal" style="--d:6">
            <div class="ops-panel-head">
                <h5 class="ops-panel-title">Activity Log</h5>
                <i class="fa-solid fa-signal" style="color: var(--ops-faint);"></i>
            </div>
            <div class="ops-feed">
                @if (Model.RecentOperationsLog != null && Model.RecentOperationsLog.Any())
                {
                    foreach (var activity in Model.RecentOperationsLog)
                    {
                        var timeDiff = DateTime.UtcNow - activity.CreatedAt.ToUniversalTime();
                        var timeStr = timeDiff.TotalMinutes < 60 ? $"{(int)timeDiff.TotalMinutes}m ago" :
                        timeDiff.TotalHours < 24 ? $"{(int)timeDiff.TotalHours}h ago" :
                        $"{(int)timeDiff.TotalDays}d ago";

                        <div class="ops-feed-item">
                            <div class="ops-feed-dot"><i class="fa-solid @activity.IconClass"></i></div>
                            <div class="flex-grow-1">
                                <div class="ops-feed-title">@activity.Title</div>
                                <div class="ops-feed-desc">@activity.Description</div>
                            </div>
                            <div class="ops-feed-time">@timeStr</div>
                        </div>
                    }
                }
                else
                {
                    <div class="ops-empty">No activity yet today &mdash; the log fills in as your team works.</div>
                }
            </div>
        </div>
    </div>

    <!-- Approvals + Stock alerts -->
    <div class="ops-bottom-grid">
        <div class="ops-panel ops-panel-flush ops-reveal" style="--d:7">
            <div class="ops-panel-head">
                <h5 class="ops-panel-title">Pending Order Approvals</h5>
                <i class="fa-solid fa-file-invoice" style="color: var(--ops-faint);"></i>
            </div>
            <div class="ops-table-wrap">
                <table class="ops-table">
                    <thead>
                        <tr>
                            <th>Order No.</th>
                            <th>Type</th>
                            <th>Party</th>
                            <th>Amount</th>
                            <th>Status</th>
                            <th style="text-align:center;">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.PendingTransactions != null && Model.PendingTransactions.Any())
                        {
                            foreach (var tx in Model.PendingTransactions)
                            {
                                <tr>
                                    <td class="ops-mono ops-strong">@tx.TransactionNo</td>
                                    <td>@tx.Type</td>
                                    <td>@tx.PartyName</td>
                                    <td class="ops-mono ops-strong">@tx.Amount.ToString("C0", inCulture)</td>
                                    <td><span class="ops-badge ops-badge-pending"><span class="ops-badge-dot"></span>@tx.Status</span></td>
                                    <td style="text-align:center;">
                                        <form asp-action="ApproveTransaction" asp-route-id="@tx.TransactionId" method="post" style="display:inline;">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="ops-btn-approve">
                                                <i class="fa-solid fa-check"></i> Approve
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr><td colspan="6" class="ops-empty">Queue is clear &mdash; no orders waiting on approval.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="ops-panel ops-panel-flush ops-reveal" style="--d:8">
            <div class="ops-panel-head">
                <h5 class="ops-panel-title">Inventory Re-order Alerts</h5>
                <i class="fa-solid fa-boxes-stacked" style="color: var(--ops-faint);"></i>
            </div>
            <div class="ops-table-wrap">
                <table class="ops-table">
                    <thead>
                        <tr>
                            <th>Product</th>
                            <th style="text-align:center;">Stock</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.StockAlerts != null && Model.StockAlerts.Any())
                        {
                            foreach (var item in Model.StockAlerts)
                            {
                                var isOut = item.Status == "Out of Stock";
                                var badgeClass = isOut ? "ops-badge-danger" : "ops-badge-warn";
                                <tr>
                                    <td class="ops-strong">@item.ProductName</td>
                                    <td class="ops-mono" style="text-align:center;">@item.StockQty</td>
                                    <td><span class="ops-badge @badgeClass"><span class="ops-badge-dot"></span>@item.Status</span></td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr><td colspan="3" class="ops-empty">All products are healthy &mdash; nothing to reorder.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/lib/chart.js/chart.umd.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", () => {
            const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

            // Live clock (IST)
            const clockEl = document.getElementById('opsClock');
            const dateEl = document.getElementById('opsDate');
            function tickClock() {
                const now = new Date();
                clockEl.textContent = now.toLocaleTimeString('en-IN', { timeZone: 'Asia/Kolkata', hour12: false });
                dateEl.textContent = now.toLocaleDateString('en-IN', { timeZone: 'Asia/Kolkata', weekday: 'long', day: 'numeric', month: 'long' });
            }
            tickClock();
            setInterval(tickClock, 1000);

            // Count-up KPI numbers
            document.querySelectorAll('.ops-count').forEach(el => {
                const target = parseInt(el.getAttribute('data-target'), 10) || 0;
                if (prefersReducedMotion || target === 0) { el.textContent = target; return; }
                const duration = 900;
                const start = performance.now();
                function step(now) {
                    const progress = Math.min((now - start) / duration, 1);
                    const eased = 1 - Math.pow(1 - progress, 3);
                    el.textContent = Math.round(eased * target);
                    if (progress < 1) requestAnimationFrame(step);
                }
                requestAnimationFrame(step);
            });

            // Animate KPI proportion bar
            document.querySelectorAll('.ops-kpi-bar-fill').forEach(el => {
                const pct = parseFloat(el.getAttribute('data-fill')) || 0;
                requestAnimationFrame(() => { el.style.width = Math.min(pct, 100) + '%'; });
            });

            // Stock chart
            const chartCtx = document.getElementById('stockAlertsChart').getContext('2d');
            const productNames = @Html.Raw(Json.Serialize(Model.StockAlerts.Select(p => p.ProductName)));
            const stockQtys = @Html.Raw(Json.Serialize(Model.StockAlerts.Select(p => p.StockQty)));

            const barGradient = chartCtx.createLinearGradient(0, 0, 0, 250);
            barGradient.addColorStop(0, '#0891b2');
            barGradient.addColorStop(1, '#0e4f5c');

            new Chart(chartCtx, {
                type: 'bar',
                data: {
                    labels: productNames,
                    datasets: [{
                        label: 'In Stock Quantity',
                        data: stockQtys,
                        backgroundColor: barGradient,
                        borderColor: '#0891b2',
                        borderWidth: 1,
                        borderRadius: 5,
                        maxBarThickness: 42
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    animation: { duration: prefersReducedMotion ? 0 : 900, easing: 'easeOutCubic' },
                    scales: {
                        y: {
                            grid: { color: 'rgba(16,24,40,0.06)' },
                            ticks: { font: { family: "'IBM Plex Mono', monospace", size: 10 }, color: '#66707e' }
                        },
                        x: {
                            grid: { display: false },
                            ticks: { font: { family: "'IBM Plex Mono', monospace", size: 10 }, color: '#66707e' }
                        }
                    },
                    plugins: { legend: { display: false } }
                }
            });
        });
    </script>
}

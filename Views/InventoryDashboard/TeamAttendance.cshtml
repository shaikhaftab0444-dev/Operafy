@model List<ERP_System.Models.TeamAttendanceRadarItemViewModel>

@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Warehouse & Inventory Team Radar";

    var selectedDate = (DateTime)(ViewBag.SelectedDate ?? DateTime.Today);
    var selectedWarehouse = (string)(ViewBag.SelectedWarehouse ?? "All");

    var presentCount = (int)(ViewBag.PresentCount ?? 0);
    var absentCount = (int)(ViewBag.AbsentCount ?? 0);
    var onLeaveCount = (int)(ViewBag.OnLeaveCount ?? 0);

    var totalTeam = Model?.Count ?? 0;
    var activePercentage = totalTeam > 0
        ? Math.Round((double)presentCount / totalTeam * 100)
        : 0;
}

<style>
    /* =========================================================
           WAREHOUSE TEAM ATTENDANCE RADAR
           Premium ERP UI - Fully Scoped
           ========================================================= */

    .warehouse-radar-page {
        --wr-primary: #2563eb;
        --wr-primary-dark: #1d4ed8;
        --wr-primary-soft: #eff6ff;
        --wr-success: #16a34a;
        --wr-success-soft: #f0fdf4;
        --wr-danger: #dc2626;
        --wr-danger-soft: #fef2f2;
        --wr-warning: #d97706;
        --wr-warning-soft: #fffbeb;
        --wr-info: #0891b2;
        --wr-info-soft: #ecfeff;
        --wr-purple: #7c3aed;
        --wr-purple-soft: #f5f3ff;
        --wr-dark: #0f172a;
        --wr-text: #1e293b;
        --wr-muted: #64748b;
        --wr-border: #e2e8f0;
        --wr-surface: #ffffff;
        --wr-bg: #f6f8fc;
        min-height: calc(100vh - 70px);
        padding: 24px;
        background: radial-gradient(circle at 0% 0%, rgba(37, 99, 235, 0.055), transparent 28%), radial-gradient(circle at 100% 10%, rgba(124, 58, 237, 0.045), transparent 24%), var(--wr-bg);
        color: var(--wr-text);
        animation: wrPageIn .55s ease both;
    }

        .warehouse-radar-page *,
        .warehouse-radar-page *::before,
        .warehouse-radar-page *::after {
            box-sizing: border-box;
        }

    /* =========================================================
           HERO HEADER
           ========================================================= */

    .wr-hero {
        position: relative;
        overflow: hidden;
        border-radius: 24px;
        padding: 26px 28px;
        margin-bottom: 22px;
        background: linear-gradient(135deg, #0f172a 0%, #172554 48%, #1e40af 100%);
        box-shadow: 0 18px 45px rgba(15, 23, 42, 0.16);
        color: #fff;
    }

        .wr-hero::before {
            content: "";
            position: absolute;
            width: 280px;
            height: 280px;
            right: -100px;
            top: -150px;
            border-radius: 50%;
            background: rgba(255, 255, 255, 0.08);
            pointer-events: none;
        }

        .wr-hero::after {
            content: "";
            position: absolute;
            width: 180px;
            height: 180px;
            right: 180px;
            bottom: -125px;
            border-radius: 50%;
            border: 1px solid rgba(255, 255, 255, 0.08);
            pointer-events: none;
        }

    .wr-hero-content {
        position: relative;
        z-index: 2;
    }

    .wr-breadcrumb {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 7px;
        margin-bottom: 14px;
        font-size: 0.78rem;
        color: rgba(255, 255, 255, 0.58);
    }

        .wr-breadcrumb a {
            color: rgba(255, 255, 255, 0.68);
            text-decoration: none;
            transition: color .2s ease;
        }

            .wr-breadcrumb a:hover {
                color: #fff;
            }

        .wr-breadcrumb i {
            font-size: 0.62rem;
            opacity: .55;
        }

    .wr-title-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 22px;
    }

    .wr-title-area {
        display: flex;
        align-items: center;
        gap: 16px;
        min-width: 0;
    }

    .wr-title-icon {
        width: 58px;
        height: 58px;
        flex: 0 0 58px;
        border-radius: 17px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: rgba(255, 255, 255, 0.11);
        border: 1px solid rgba(255, 255, 255, 0.15);
        box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.1);
        font-size: 1.35rem;
        animation: wrIconFloat 4s ease-in-out infinite;
    }

    .wr-title-area h1 {
        margin: 0;
        font-size: clamp(1.35rem, 2.1vw, 1.85rem);
        font-weight: 750;
        letter-spacing: -0.025em;
        color: #fff;
    }

    .wr-title-area p {
        margin: 5px 0 0;
        color: rgba(255, 255, 255, 0.68);
        font-size: 0.86rem;
        line-height: 1.55;
    }

    .wr-hero-actions {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 9px;
    }

    .wr-hero-btn {
        min-height: 40px;
        border-radius: 11px;
        padding: 9px 14px;
        font-size: 0.82rem;
        font-weight: 650;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 7px;
        transition: transform .2s ease, background .2s ease, border-color .2s ease;
    }

        .wr-hero-btn:hover {
            transform: translateY(-2px);
        }

        .wr-hero-btn.primary {
            color: #fff;
            background: rgba(255, 255, 255, 0.13);
            border: 1px solid rgba(255, 255, 255, 0.18);
        }

            .wr-hero-btn.primary:hover {
                background: rgba(255, 255, 255, 0.2);
                color: #fff;
            }

        .wr-hero-btn.secondary {
            color: rgba(255, 255, 255, 0.82);
            background: rgba(15, 23, 42, 0.22);
            border: 1px solid rgba(255, 255, 255, 0.12);
        }

            .wr-hero-btn.secondary:hover {
                color: #fff;
                background: rgba(15, 23, 42, 0.35);
            }

    .wr-live-strip {
        position: relative;
        z-index: 2;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        margin-top: 21px;
        padding: 7px 11px;
        border-radius: 999px;
        background: rgba(255, 255, 255, 0.08);
        border: 1px solid rgba(255, 255, 255, 0.11);
        color: rgba(255, 255, 255, 0.75);
        font-size: 0.72rem;
        font-weight: 600;
    }

    .wr-live-dot {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: #4ade80;
        box-shadow: 0 0 0 5px rgba(74, 222, 128, 0.11);
        animation: wrPulse 2s infinite;
    }

    /* =========================================================
           KPI CARDS
           ========================================================= */

    .wr-kpi-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 15px;
        margin-bottom: 22px;
    }

    .wr-kpi-card {
        position: relative;
        overflow: hidden;
        min-height: 132px;
        padding: 19px;
        background: var(--wr-surface);
        border: 1px solid var(--wr-border);
        border-radius: 18px;
        box-shadow: 0 7px 24px rgba(15, 23, 42, 0.045);
        transition: transform .25s ease, box-shadow .25s ease, border-color .25s ease;
        animation: wrCardIn .55s ease both;
    }

        .wr-kpi-card:nth-child(2) {
            animation-delay: .06s;
        }

        .wr-kpi-card:nth-child(3) {
            animation-delay: .12s;
        }

        .wr-kpi-card:nth-child(4) {
            animation-delay: .18s;
        }

        .wr-kpi-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 15px 35px rgba(15, 23, 42, 0.085);
            border-color: rgba(37, 99, 235, 0.2);
        }

        .wr-kpi-card::after {
            content: "";
            position: absolute;
            width: 85px;
            height: 85px;
            border-radius: 50%;
            right: -32px;
            bottom: -38px;
            background: rgba(37, 99, 235, 0.035);
            pointer-events: none;
        }

    .wr-kpi-top {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 10px;
    }

    .wr-kpi-icon {
        width: 42px;
        height: 42px;
        border-radius: 13px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1rem;
    }

        .wr-kpi-icon.blue {
            color: var(--wr-primary);
            background: var(--wr-primary-soft);
        }

        .wr-kpi-icon.green {
            color: var(--wr-success);
            background: var(--wr-success-soft);
        }

        .wr-kpi-icon.red {
            color: var(--wr-danger);
            background: var(--wr-danger-soft);
        }

        .wr-kpi-icon.cyan {
            color: var(--wr-info);
            background: var(--wr-info-soft);
        }

    .wr-kpi-label {
        margin-top: 14px;
        color: var(--wr-muted);
        font-size: 0.74rem;
        font-weight: 650;
        text-transform: uppercase;
        letter-spacing: .055em;
    }

    .wr-kpi-value {
        margin-top: 3px;
        color: var(--wr-dark);
        font-size: 1.55rem;
        line-height: 1.1;
        font-weight: 780;
        letter-spacing: -.03em;
    }

    .wr-kpi-meta {
        position: absolute;
        right: 17px;
        top: 20px;
        font-size: .68rem;
        color: #94a3b8;
        font-weight: 600;
    }

    /* =========================================================
           FILTER PANEL
           ========================================================= */

    .wr-filter-card {
        background: var(--wr-surface);
        border: 1px solid var(--wr-border);
        border-radius: 18px;
        padding: 17px;
        margin-bottom: 22px;
        box-shadow: 0 7px 24px rgba(15, 23, 42, 0.04);
        animation: wrCardIn .55s .18s ease both;
    }

    .wr-filter-form {
        display: flex;
        align-items: flex-end;
        gap: 14px;
        flex-wrap: wrap;
    }

    .wr-filter-group {
        min-width: 190px;
        flex: 0 1 250px;
    }

        .wr-filter-group.warehouse {
            flex-basis: 280px;
        }

    .wr-filter-label {
        display: flex;
        align-items: center;
        gap: 6px;
        margin-bottom: 7px;
        color: #475569;
        font-size: .73rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .04em;
    }

        .wr-filter-label i {
            color: var(--wr-primary);
            font-size: .75rem;
        }

    .wr-control {
        width: 100%;
        min-height: 43px;
        border: 1px solid #dbe3ee;
        border-radius: 11px;
        padding: 8px 12px;
        color: #1e293b;
        background: #fbfdff;
        font-size: .82rem;
        font-weight: 550;
        outline: none;
        transition: border-color .2s ease, box-shadow .2s ease, background .2s ease;
    }

        .wr-control:hover {
            background: #fff;
            border-color: #cbd5e1;
        }

        .wr-control:focus {
            background: #fff;
            border-color: rgba(37, 99, 235, .55);
            box-shadow: 0 0 0 4px rgba(37, 99, 235, .09);
        }

    .wr-filter-summary {
        margin-left: auto;
        display: flex;
        align-items: center;
        justify-content: flex-end;
        flex-wrap: wrap;
        gap: 7px;
    }

    .wr-stat-pill {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        min-height: 32px;
        padding: 6px 10px;
        border-radius: 9px;
        font-size: .72rem;
        font-weight: 700;
        white-space: nowrap;
        border: 1px solid transparent;
    }

        .wr-stat-pill.blue {
            color: #1d4ed8;
            background: #eff6ff;
            border-color: #dbeafe;
        }

        .wr-stat-pill.green {
            color: #15803d;
            background: #f0fdf4;
            border-color: #dcfce7;
        }

        .wr-stat-pill.red {
            color: #b91c1c;
            background: #fef2f2;
            border-color: #fee2e2;
        }

        .wr-stat-pill.cyan {
            color: #0e7490;
            background: #ecfeff;
            border-color: #cffafe;
        }

    /* =========================================================
           MAIN RADAR PANEL
           ========================================================= */

    .wr-radar-card {
        overflow: hidden;
        background: var(--wr-surface);
        border: 1px solid var(--wr-border);
        border-radius: 20px;
        box-shadow: 0 9px 30px rgba(15, 23, 42, 0.055);
        animation: wrCardIn .55s .24s ease both;
    }

    .wr-radar-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        padding: 17px 20px;
        border-bottom: 1px solid var(--wr-border);
        background: linear-gradient(180deg, #ffffff 0%, #fbfcfe 100%);
    }

    .wr-radar-heading {
        display: flex;
        align-items: center;
        gap: 12px;
        min-width: 0;
    }

    .wr-section-icon {
        width: 40px;
        height: 40px;
        flex: 0 0 40px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 12px;
        color: var(--wr-primary);
        background: var(--wr-primary-soft);
        border: 1px solid #dbeafe;
        font-size: .95rem;
    }

    .wr-radar-heading h2 {
        margin: 0;
        color: var(--wr-dark);
        font-size: .94rem;
        font-weight: 750;
    }

    .wr-radar-heading p {
        margin: 3px 0 0;
        color: var(--wr-muted);
        font-size: .72rem;
    }

    .wr-date-badge {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 7px 10px;
        border-radius: 9px;
        background: #f8fafc;
        border: 1px solid var(--wr-border);
        color: #475569;
        font-size: .72rem;
        font-weight: 700;
        white-space: nowrap;
    }

        .wr-date-badge i {
            color: var(--wr-primary);
        }

    .wr-table-wrap {
        overflow-x: auto;
        scrollbar-width: thin;
    }

    .wr-table {
        width: 100%;
        min-width: 1040px;
        border-collapse: separate;
        border-spacing: 0;
        margin: 0;
    }

        .wr-table thead th {
            padding: 13px 14px;
            background: #f8fafc;
            border-bottom: 1px solid var(--wr-border);
            color: #64748b;
            font-size: .66rem;
            font-weight: 750;
            text-transform: uppercase;
            letter-spacing: .065em;
            white-space: nowrap;
        }

            .wr-table thead th:first-child {
                padding-left: 20px;
            }

            .wr-table thead th:last-child {
                padding-right: 20px;
                text-align: right;
            }

        .wr-table tbody tr {
            animation: wrRowIn .45s ease both;
            transition: background .2s ease;
        }

            .wr-table tbody tr:nth-child(2) {
                animation-delay: .04s;
            }

            .wr-table tbody tr:nth-child(3) {
                animation-delay: .08s;
            }

            .wr-table tbody tr:nth-child(4) {
                animation-delay: .12s;
            }

            .wr-table tbody tr:nth-child(5) {
                animation-delay: .16s;
            }

            .wr-table tbody tr:hover {
                background: #f8fbff;
            }

        .wr-table tbody td {
            padding: 14px;
            border-bottom: 1px solid #edf1f5;
            vertical-align: middle;
            color: #334155;
            font-size: .78rem;
        }

        .wr-table tbody tr:last-child td {
            border-bottom: 0;
        }

        .wr-table tbody td:first-child {
            padding-left: 20px;
        }

        .wr-table tbody td:last-child {
            padding-right: 20px;
        }

    /* =========================================================
           EMPLOYEE CELL
           ========================================================= */

    .wr-employee {
        display: flex;
        align-items: center;
        gap: 11px;
        min-width: 205px;
    }

    .wr-avatar {
        width: 40px;
        height: 40px;
        flex: 0 0 40px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 12px;
        color: #1d4ed8;
        background: linear-gradient(135deg, #eff6ff, #dbeafe);
        border: 1px solid #dbeafe;
        font-size: .72rem;
        font-weight: 800;
        box-shadow: 0 4px 10px rgba(37, 99, 235, .07);
    }

    .wr-employee-name {
        color: #172033;
        font-size: .8rem;
        font-weight: 750;
        line-height: 1.25;
    }

    .wr-employee-meta {
        margin-top: 3px;
        color: #94a3b8;
        font-size: .66rem;
        line-height: 1.35;
    }

        .wr-employee-meta i {
            color: #94a3b8;
        }

    /* =========================================================
           SHIFT / WAREHOUSE / TIME CELLS
           ========================================================= */

    .wr-shift {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        max-width: 190px;
        padding: 7px 9px;
        border-radius: 9px;
        color: #475569;
        background: #f8fafc;
        border: 1px solid #e5eaf0;
        font-size: .69rem;
        font-weight: 650;
        line-height: 1.3;
    }

        .wr-shift i {
            color: var(--wr-primary);
            font-size: .72rem;
        }

    .wr-location {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        color: #475569;
        font-size: .72rem;
        font-weight: 650;
        white-space: nowrap;
    }

        .wr-location i {
            color: #64748b;
        }

    .wr-time {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 5px 8px;
        border-radius: 8px;
        font-family: "SFMono-Regular", Consolas, "Liberation Mono", monospace;
        font-size: .7rem;
        font-weight: 700;
        white-space: nowrap;
    }

        .wr-time.in {
            color: #15803d;
            background: #f0fdf4;
        }

        .wr-time.out {
            color: #b91c1c;
            background: #fef2f2;
        }

        .wr-time.muted {
            color: #94a3b8;
            background: #f8fafc;
        }

    .wr-duration {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        color: #475569;
        font-family: "SFMono-Regular", Consolas, "Liberation Mono", monospace;
        font-size: .71rem;
        font-weight: 700;
        white-space: nowrap;
    }

        .wr-duration i {
            color: #64748b;
        }

    .wr-source {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 6px 8px;
        border-radius: 8px;
        color: #475569;
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        font-size: .68rem;
        font-weight: 650;
        white-space: nowrap;
    }

        .wr-source i {
            color: #64748b;
        }

    /* =========================================================
           STATUS
           ========================================================= */

    .wr-status {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        min-width: 82px;
        padding: 7px 10px;
        border-radius: 999px;
        font-size: .68rem;
        font-weight: 750;
        white-space: nowrap;
        border: 1px solid transparent;
    }

        .wr-status.present {
            color: #15803d;
            background: #f0fdf4;
            border-color: #dcfce7;
        }

        .wr-status.late {
            color: #b45309;
            background: #fffbeb;
            border-color: #fef3c7;
        }

        .wr-status.leave {
            color: #0e7490;
            background: #ecfeff;
            border-color: #cffafe;
        }

        .wr-status.absent {
            color: #b91c1c;
            background: #fef2f2;
            border-color: #fee2e2;
        }

        .wr-status i {
            font-size: .48rem;
        }

    /* =========================================================
           EMPTY STATE
           ========================================================= */

    .wr-empty {
        padding: 62px 20px;
        text-align: center;
    }

    .wr-empty-icon {
        width: 70px;
        height: 70px;
        margin: 0 auto 17px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 20px;
        color: #2563eb;
        background: #eff6ff;
        border: 1px solid #dbeafe;
        font-size: 1.55rem;
        animation: wrIconFloat 4s ease-in-out infinite;
    }

    .wr-empty h3 {
        margin: 0 0 6px;
        color: var(--wr-dark);
        font-size: 1rem;
        font-weight: 750;
    }

    .wr-empty p {
        max-width: 480px;
        margin: 0 auto;
        color: #94a3b8;
        font-size: .76rem;
        line-height: 1.6;
    }

    /* =========================================================
           FOOTER INFO
           ========================================================= */

    .wr-footer-info {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 15px;
        flex-wrap: wrap;
        padding: 13px 20px;
        background: #fbfcfe;
        border-top: 1px solid var(--wr-border);
        color: #94a3b8;
        font-size: .68rem;
    }

        .wr-footer-info span {
            display: inline-flex;
            align-items: center;
            gap: 6px;
        }

        .wr-footer-info i {
            color: #64748b;
        }

    /* =========================================================
           ANIMATIONS
           ========================================================= */

    @@keyframes wrPageIn {
        from {
            opacity: 0;
            transform: translateY(8px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@keyframes wrCardIn {
        from {
            opacity: 0;
            transform: translateY(12px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@keyframes wrRowIn {
        from {
            opacity: 0;
            transform: translateX(-7px);
        }

        to {
            opacity: 1;
            transform: translateX(0);
        }
    }

    @@keyframes wrIconFloat {
        0%, 100% {
            transform: translateY(0);
        }

        50% {
            transform: translateY(-3px);
        }
    }

    @@keyframes wrPulse {
        0% {
            box-shadow: 0 0 0 0 rgba(74, 222, 128, .35);
        }

        70% {
            box-shadow: 0 0 0 7px rgba(74, 222, 128, 0);
        }

        100% {
            box-shadow: 0 0 0 0 rgba(74, 222, 128, 0);
        }
    }

    /* =========================================================
           RESPONSIVE
           ========================================================= */

    @@media (max-width: 1200px) {
        .warehouse-radar-page {
            padding: 20px;
        }

        .wr-kpi-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .wr-title-row {
            align-items: flex-start;
            flex-direction: column;
        }

        .wr-hero-actions {
            width: 100%;
        }

        .wr-filter-summary {
            width: 100%;
            margin-left: 0;
            justify-content: flex-start;
        }
    }

    @@media (max-width: 768px) {
        .warehouse-radar-page {
            padding: 15px;
        }

        .wr-hero {
            padding: 21px;
            border-radius: 19px;
        }

        .wr-title-area {
            align-items: flex-start;
        }

        .wr-title-icon {
            width: 48px;
            height: 48px;
            flex-basis: 48px;
            border-radius: 14px;
        }

        .wr-title-area h1 {
            font-size: 1.28rem;
        }

        .wr-title-area p {
            font-size: .78rem;
        }

        .wr-hero-actions {
            display: grid;
            grid-template-columns: 1fr 1fr;
            width: 100%;
        }

        .wr-hero-btn {
            justify-content: center;
        }

        .wr-kpi-grid {
            gap: 11px;
        }

        .wr-kpi-card {
            min-height: 120px;
            padding: 16px;
        }

        .wr-kpi-value {
            font-size: 1.35rem;
        }

        .wr-filter-card {
            padding: 14px;
        }

        .wr-filter-form {
            display: block;
        }

        .wr-filter-group,
        .wr-filter-group.warehouse {
            width: 100%;
            min-width: 0;
            margin-bottom: 13px;
        }

            .wr-filter-group:last-of-type {
                margin-bottom: 0;
            }

        .wr-filter-summary {
            margin-top: 14px;
        }

        .wr-radar-header {
            align-items: flex-start;
            flex-direction: column;
            padding: 15px;
        }

        .wr-date-badge {
            width: 100%;
            justify-content: center;
        }

        .wr-table thead th:first-child,
        .wr-table tbody td:first-child {
            padding-left: 15px;
        }

        .wr-table thead th:last-child,
        .wr-table tbody td:last-child {
            padding-right: 15px;
        }
    }

    @@media (max-width: 520px) {
        .warehouse-radar-page {
            padding: 11px;
        }

        .wr-hero {
            padding: 18px;
            border-radius: 17px;
        }

        .wr-title-area {
            gap: 11px;
        }

        .wr-title-icon {
            width: 43px;
            height: 43px;
            flex-basis: 43px;
            font-size: 1rem;
        }

        .wr-title-area h1 {
            font-size: 1.08rem;
        }

        .wr-title-area p {
            font-size: .72rem;
        }

        .wr-hero-actions {
            grid-template-columns: 1fr;
        }

        .wr-live-strip {
            width: 100%;
            justify-content: center;
        }

        .wr-kpi-grid {
            grid-template-columns: 1fr 1fr;
        }

        .wr-kpi-card {
            min-height: 112px;
            padding: 13px;
            border-radius: 14px;
        }

        .wr-kpi-icon {
            width: 35px;
            height: 35px;
            border-radius: 10px;
            font-size: .82rem;
        }

        .wr-kpi-label {
            margin-top: 11px;
            font-size: .62rem;
        }

        .wr-kpi-value {
            font-size: 1.15rem;
        }

        .wr-kpi-meta {
            display: none;
        }

        .wr-stat-pill {
            flex: 1 1 calc(50% - 7px);
            justify-content: center;
        }

        .wr-radar-card {
            border-radius: 16px;
        }

        .wr-radar-heading h2 {
            font-size: .85rem;
        }

        .wr-footer-info {
            padding: 12px 15px;
        }
    }

    @@media (prefers-reduced-motion: reduce) {
        .warehouse-radar-page *,
        .warehouse-radar-page *::before,
        .warehouse-radar-page *::after {
            animation-duration: .01ms !important;
            animation-iteration-count: 1 !important;
            transition-duration: .01ms !important;
            scroll-behavior: auto !important;
        }
    }

    @@media print {
        .warehouse-radar-page {
            padding: 0;
            background: #fff;
        }

        .wr-hero {
            color: #000;
            background: #fff;
            box-shadow: none;
            border: 1px solid #ddd;
        }

        .wr-title-area h1 {
            color: #000;
        }

        .wr-title-area p,
        .wr-breadcrumb,
        .wr-breadcrumb a,
        .wr-live-strip {
            color: #555 !important;
        }

        .wr-hero-actions {
            display: none;
        }

        .wr-kpi-card,
        .wr-filter-card,
        .wr-radar-card {
            box-shadow: none;
        }
    }
</style>

<div class="warehouse-radar-page">

    <!-- =====================================================
         PREMIUM HERO
         ===================================================== -->

    <section class="wr-hero">
        <div class="wr-hero-content">

            <div class="wr-breadcrumb">
                <a href="@Url.Action("Index", "InventoryDashboard")">
                    <i class="fa-solid fa-layer-group"></i>
                    Inventory Portal
                </a>
                <i class="fa-solid fa-chevron-right"></i>
                <span>Team Operations</span>
            </div>

            <div class="wr-title-row">

                <div class="wr-title-area">
                    <div class="wr-title-icon">
                        <i class="fa-solid fa-users-gear"></i>
                    </div>

                    <div>
                        <h1>Inventory & Warehouse Team Attendance Radar</h1>
                        <p>
                            Real-time shift adherence and biometric punch activity
                            for direct warehouse subordinates.
                        </p>
                    </div>
                </div>

                <div class="wr-hero-actions">

                    <a href="@Url.Action("Tasks", "InventoryDashboard")"
                       class="wr-hero-btn primary">
                        <i class="fa-solid fa-list-check"></i>
                        Task Delegation
                    </a>

                    <a href="@Url.Action("Approvals", "Manager")"
                       class="wr-hero-btn secondary">
                        <i class="fa-solid fa-clipboard-check"></i>
                        Subordinate Approvals
                    </a>

                </div>

            </div>

            <div class="wr-live-strip">
                <span class="wr-live-dot"></span>
                <i class="fa-solid fa-satellite-dish"></i>
                Team attendance monitoring active
            </div>

        </div>
    </section>


    <!-- =====================================================
         KPI OVERVIEW
         ===================================================== -->

    <section class="wr-kpi-grid">

        <div class="wr-kpi-card">
            <div class="wr-kpi-top">
                <div class="wr-kpi-icon blue">
                    <i class="fa-solid fa-users"></i>
                </div>

                <span class="wr-kpi-meta">Roster</span>
            </div>

            <div class="wr-kpi-label">Team Roster</div>
            <div class="wr-kpi-value">@totalTeam</div>
        </div>


        <div class="wr-kpi-card">
            <div class="wr-kpi-top">
                <div class="wr-kpi-icon green">
                    <i class="fa-solid fa-user-check"></i>
                </div>

                <span class="wr-kpi-meta">@activePercentage% active</span>
            </div>

            <div class="wr-kpi-label">Present Today</div>
            <div class="wr-kpi-value">@presentCount</div>
        </div>


        <div class="wr-kpi-card">
            <div class="wr-kpi-top">
                <div class="wr-kpi-icon red">
                    <i class="fa-solid fa-user-xmark"></i>
                </div>

                <span class="wr-kpi-meta">Attention</span>
            </div>

            <div class="wr-kpi-label">Absent</div>
            <div class="wr-kpi-value">@absentCount</div>
        </div>


        <div class="wr-kpi-card">
            <div class="wr-kpi-top">
                <div class="wr-kpi-icon cyan">
                    <i class="fa-solid fa-calendar-days"></i>
                </div>

                <span class="wr-kpi-meta">Scheduled</span>
            </div>

            <div class="wr-kpi-label">On Leave</div>
            <div class="wr-kpi-value">@onLeaveCount</div>
        </div>

    </section>


    <!-- =====================================================
         FILTER PANEL
         ===================================================== -->

    <section class="wr-filter-card">

        <form method="get"
              action="@Url.Action("TeamAttendance", "InventoryDashboard")"
              class="wr-filter-form">

            <div class="wr-filter-group">

                <label class="wr-filter-label">
                    <i class="fa-regular fa-calendar"></i>
                    Attendance Date
                </label>

                <input type="date"
                       name="selectedDate"
                       class="wr-control"
                       value="@selectedDate.ToString("yyyy-MM-dd")"
                       onchange="this.form.submit()" />

            </div>


            <div class="wr-filter-group warehouse">

                <label class="wr-filter-label">
                    <i class="fa-solid fa-warehouse"></i>
                    Warehouse Hub
                </label>

                <select name="warehouse"
                        class="wr-control"
                        onchange="this.form.submit()">

                    <option value="All" selected="@(selectedWarehouse == "All")">
                        All Warehouse Locations
                    </option>

                    <option value="Main" selected="@(selectedWarehouse == "Main")">
                        Main Central Hub
                    </option>

                    <option value="North" selected="@(selectedWarehouse == "North")">
                        North Warehouse WH-02
                    </option>

                    <option value="East" selected="@(selectedWarehouse == "East")">
                        East Transit Hub
                    </option>

                </select>

            </div>


            <div class="wr-filter-summary">

                <div class="wr-stat-pill blue">
                    <i class="fa-solid fa-users"></i>
                    Team @totalTeam
                </div>

                <div class="wr-stat-pill green">
                    <i class="fa-solid fa-circle-check"></i>
                    Present @presentCount
                </div>

                <div class="wr-stat-pill red">
                    <i class="fa-solid fa-circle-xmark"></i>
                    Absent @absentCount
                </div>

                @if (onLeaveCount > 0)
                {
                    <div class="wr-stat-pill cyan">
                        <i class="fa-solid fa-calendar-minus"></i>
                        Leave @onLeaveCount
                    </div>
                }

            </div>

        </form>

    </section>


    <!-- =====================================================
         TEAM ATTENDANCE RADAR
         ===================================================== -->

    <section class="wr-radar-card">

        <div class="wr-radar-header">

            <div class="wr-radar-heading">

                <div class="wr-section-icon">
                    <i class="fa-solid fa-radar"></i>
                </div>

                <div>
                    <h2>Warehouse Team Attendance Radar</h2>
                    <p>
                        Direct subordinate attendance, shift and biometric activity
                    </p>
                </div>

            </div>

            <div class="wr-date-badge">
                <i class="fa-regular fa-calendar-check"></i>
                @selectedDate.ToString("dd MMMM yyyy")
            </div>

        </div>


        <div class="wr-table-wrap">

            <table class="wr-table">

                <thead>
                    <tr>
                        <th>Subordinate Staff Member</th>
                        <th>Assigned Shift & Hours</th>
                        <th>Warehouse Station</th>
                        <th>Punch In</th>
                        <th>Punch Out</th>
                        <th>Active Duration</th>
                        <th>Punch Source</th>
                        <th>Status</th>
                    </tr>
                </thead>

                <tbody>

                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="8">

                                <div class="wr-empty">

                                    <div class="wr-empty-icon">
                                        <i class="fa-solid fa-user-shield"></i>
                                    </div>

                                    <h3>No Subordinates Found</h3>

                                    <p>
                                        No warehouse personnel report directly to this
                                        station or match the selected attendance filter.
                                    </p>

                                </div>

                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model)
                        {
                            var isPresent =
                            item.Status.Contains("Present") ||
                            item.Status.Contains("Late");

                            var statusType = "absent";
                            var statusIcon = "fa-circle-xmark";

                            if (item.Status.Contains("Present"))
                            {
                                statusType = "present";
                                statusIcon = "fa-circle-check";
                            }
                            else if (item.Status.Contains("Late"))
                            {
                                statusType = "late";
                                statusIcon = "fa-clock";
                            }
                            else if (item.Status.Contains("Leave"))
                            {
                                statusType = "leave";
                                statusIcon = "fa-calendar-minus";
                            }

                            var initials = string.Concat(
                            item.FullName
                            .Split(' ', StringSplitOptions.RemoveEmptyEntries)
                            .Select(s => s[0])
                            ).ToUpper();

                            <tr>

                                <!-- STAFF -->
                                <td>

                                    <div class="wr-employee">

                                        <div class="wr-avatar">
                                            @initials
                                        </div>

                                        <div>

                                            <div class="wr-employee-name">
                                                @item.FullName
                                            </div>

                                            <div class="wr-employee-meta">
                                                <i class="fa-regular fa-id-badge me-1"></i>
                                                @item.RoleName
                                                <span class="mx-1">•</span>
                                                @item.Department
                                            </div>

                                        </div>

                                    </div>

                                </td>


                                <!-- SHIFT -->
                                <td>

                                    <div class="wr-shift">
                                        <i class="fa-regular fa-clock"></i>

                                        <span>
                                            @item.ShiftName
                                            <span class="mx-1">•</span>
                                            @item.ShiftTiming
                                        </span>
                                    </div>

                                </td>


                                <!-- WAREHOUSE -->
                                <td>

                                    <div class="wr-location">
                                        <i class="fa-solid fa-warehouse"></i>
                                        @item.WarehouseLocation
                                    </div>

                                </td>


                                <!-- PUNCH IN -->
                                <td>

                                    @if (!string.IsNullOrEmpty(item.ClockInTime))
                                    {
                                        <span class="wr-time in">
                                            <i class="fa-solid fa-arrow-right-to-bracket"></i>
                                            @item.ClockInTime
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="wr-time muted">
                                            <i class="fa-solid fa-minus"></i>
                                            --:--
                                        </span>
                                    }

                                </td>


                                <!-- PUNCH OUT -->
                                <td>

                                    @if (!string.IsNullOrEmpty(item.ClockOutTime))
                                    {
                                        <span class="wr-time out">
                                            <i class="fa-solid fa-arrow-right-from-bracket"></i>
                                            @item.ClockOutTime
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="wr-time muted">
                                            <i class="fa-solid fa-minus"></i>
                                            --:--
                                        </span>
                                    }

                                </td>


                                <!-- WORK HOURS -->
                                <td>

                                    <div class="wr-duration">
                                        <i class="fa-regular fa-hourglass-half"></i>
                                        @item.WorkHours
                                    </div>

                                </td>


                                <!-- SOURCE -->
                                <td>

                                    <div class="wr-source">
                                        <i class="fa-solid fa-fingerprint"></i>
                                        @item.PunchSource
                                    </div>

                                </td>


                                <!-- STATUS -->
                                <td class="text-end">

                                    <span class="wr-status @statusType">

                                        <i class="fa-solid @statusIcon"></i>

                                        @item.Status

                                    </span>

                                </td>

                            </tr>
                        }
                    }

                </tbody>

            </table>

        </div>


        <div class="wr-footer-info">

            <span>
                <i class="fa-solid fa-shield-halved"></i>
                Strict subordinate isolation active
            </span>

            <span>
                <i class="fa-solid fa-users-viewfinder"></i>
                Showing @totalTeam direct warehouse reportee(s)
            </span>

        </div>

    </section>

</div>
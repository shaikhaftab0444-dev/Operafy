@model List<ERP_System.Models.HRAttendanceLog>
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Warehouse & Inventory Team Radar";
    var executives = ViewBag.Executives as List<ERP_System.Models.User> ?? new List<ERP_System.Models.User>();
    var selectedDate = (DateTime)(ViewBag.SelectedDate ?? DateTime.Today);
}

<style>
    .inv-table-card {
        background: #ffffff;
        border-radius: 14px;
        border: 1px solid var(--border-warm, #e2e8f0);
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.04);
    }
</style>

<div class="container-fluid py-3 px-3 px-md-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <div class="text-muted small mb-1">
                <a href="@Url.Action("Index", "InventoryDashboard")" class="text-decoration-none text-muted">Inventory Portal</a> / <span>Team Operations</span>
            </div>
            <h4 class="fw-bold mb-0 text-dark">
                <i class="fa-solid fa-users-gear text-primary me-2"></i>Inventory & Warehouse Attendance Radar
            </h4>
        </div>
        <div class="d-flex gap-2">
            <a href="@Url.Action("Approvals", "Manager")" class="btn btn-outline-secondary px-3 shadow-sm">
                <i class="fa-solid fa-clipboard-check me-1.5"></i> Review Team Approvals
            </a>
        </div>
    </div>

    <div class="inv-table-card">
        <div class="p-3 border-bottom d-flex flex-wrap justify-content-between align-items-center gap-3 bg-light-subtle">
            <div class="d-flex align-items-center gap-2">
                <span class="fw-bold small text-secondary">Reporting Date:</span>
                <span class="badge bg-primary rounded-pill">@selectedDate.ToString("dd MMMM yyyy")</span>
            </div>
            <div class="d-flex gap-2">
                <span class="badge bg-success-subtle text-success px-2.5 py-1.5 rounded-pill small fw-semibold">
                    <i class="fa-solid fa-circle-check me-1"></i> Present: @Model.Count(m => m.Status == "Present" || m.Status.Contains("Late"))
                </span>
                <span class="badge bg-danger-subtle text-danger px-2.5 py-1.5 rounded-pill small fw-semibold">
                    <i class="fa-solid fa-circle-xmark me-1"></i> Absent: @Math.Max(0, executives.Count - Model.Count(m => m.Status == "Present" || m.Status.Contains("Late")))
                </span>
            </div>
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr class="small text-uppercase text-muted">
                        <th>Staff Member</th>
                        <th>Clock In</th>
                        <th>Clock Out</th>
                        <th>Work Hours</th>
                        <th>Punch Source</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!executives.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5 text-muted">
                                <i class="fa-regular fa-user-clock fs-2 d-block mb-2"></i>
                                No inventory staff members assigned to this reporting station.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var exec in executives)
                        {
                            var punch = Model.FirstOrDefault(p => p.UserId == exec.UserId);
                            var isPresent = punch != null && (punch.Status == "Present" || punch.Status.Contains("Late"));
                            var statusBadge = isPresent ? "bg-success-subtle text-success" : "bg-danger-subtle text-danger";
                            var statusText = punch?.Status ?? "Absent / Not Clocked In";

                            <tr>
                                <td>
                                    <div class="fw-bold text-dark">@exec.FullName</div>
                                    <div class="text-muted extra-small">
                                        <i class="fa-regular fa-id-badge me-1"></i>@(exec.Role?.RoleName ?? "Warehouse Associate") &bull; @(exec.Department?.DepartmentName ?? "Inventory & Logistics")
                                    </div>
                                </td>
                                <td>
                                    <span class="font-monospace small @(punch?.CheckInTime.HasValue == true ? "text-dark fw-bold" : "text-muted")">
                                        @(punch?.CheckInTime.HasValue == true ? punch.CheckInTime.Value.ToString("hh:mm tt") : "--:--")
                                    </span>
                                </td>
                                <td>
                                    <span class="font-monospace small @(punch?.CheckOutTime.HasValue == true ? "text-dark fw-bold" : "text-muted")">
                                        @(punch?.CheckOutTime.HasValue == true ? punch.CheckOutTime.Value.ToString("hh:mm tt") : "--:--")
                                    </span>
                                </td>
                                <td>
                                    <span class="small font-monospace text-secondary">
                                        @(punch != null && !string.IsNullOrEmpty(punch.WorkHours) ? punch.WorkHours : "-")
                                    </span>
                                </td>
                                <td>
                                    <span class="badge bg-light text-dark border extra-small">
                                        <i class="fa-solid fa-fingerprint me-1"></i>@(punch?.PunchSource ?? "Web Portal")
                                    </span>
                                </td>
                                <td>
                                    <span class="badge @statusBadge px-2.5 py-1 rounded-pill small fw-semibold">
                                        @statusText
                                    </span>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

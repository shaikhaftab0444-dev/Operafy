@model ERP_System.Models.InventoryDashboardViewModel
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Inventory Dashboard";
    var inCulture = new System.Globalization.CultureInfo("en-IN");
}

@Html.AntiForgeryToken()

<style>
    /* =========================================================
       SOFT NEUMORPHIC INVENTORY DASHBOARD
       ========================================================= */

    :root {
        --neu-bg: #eef3f9;
        --neu-surface: #f8fbff;
        --neu-white: #ffffff;
        --neu-text: #26364d;
        --neu-muted: #718096;
        --neu-border: rgba(255, 255, 255, 0.85);
        --neu-shadow-dark: rgba(163, 177, 198, 0.32);
        --neu-shadow-light: rgba(255, 255, 255, 0.95);
        --neu-blue: #4f8df7;
        --neu-blue-dark: #3b78e7;
        --neu-purple: #9b7bea;
        --neu-green: #45c9a0;
        --neu-orange: #f5b84b;
        --neu-red: #ef6b7a;
    }

    /* Main dashboard background */
    .inventory-dashboard-page {
        background: var(--neu-bg);
        color: var(--neu-text);
        min-height: 100%;
        padding-bottom: 2rem;
    }

    .inventory-dashboard-page h4,
    .inventory-dashboard-page h5,
    .inventory-dashboard-page h6 {
        color: var(--neu-text);
    }

    .inventory-dashboard-page .text-muted {
        color: var(--neu-muted) !important;
    }

    /* Breadcrumb */
    .inventory-dashboard-page .breadcrumb {
        color: var(--neu-muted);
    }

    .inventory-dashboard-page .breadcrumb-item a {
        color: var(--neu-blue);
    }

    /* Filter Bar */
    .neu-filter-bar {
        background: var(--neu-surface);
        border: 1px solid var(--neu-border);
        border-radius: 18px;
        box-shadow: 6px 6px 14px var(--neu-shadow-dark), -6px -6px 14px var(--neu-shadow-light);
        padding: 0.9rem 1.25rem;
        margin-bottom: 1.5rem;
    }

    .neu-filter-select {
        background: #edf2f8;
        border: 1px solid #dbe4ef;
        border-radius: 10px;
        color: var(--neu-text);
        font-size: 0.85rem;
        font-weight: 600;
        padding: 0.45rem 0.85rem;
    }

    .neu-filter-select:focus {
        background: #f8fbff;
        border-color: #a9c8ff;
        box-shadow: 0 0 0 0.2rem rgba(79, 141, 247, 0.12);
    }

    /* Action Buttons */
    .btn-quick-action {
        border-radius: 12px;
        font-size: 0.84rem;
        font-weight: 700;
        padding: 0.55rem 1rem;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        transition: all 0.2s ease;
    }

    .btn-quick-adjust {
        background: #fdf3e2;
        color: #c97d08;
        border: 1px solid #f9d9a3;
    }

    .btn-quick-adjust:hover {
        background: #fbe6c4;
        color: #a36200;
        transform: translateY(-1px);
    }

    .btn-quick-product {
        background: #eaf2ff;
        color: #2563eb;
        border: 1px solid #bfdbfe;
    }

    .btn-quick-product:hover {
        background: #2563eb;
        color: #ffffff;
        transform: translateY(-1px);
    }

    /* Context Cards */
    .neu-context-card {
        background: var(--neu-surface);
        border: 1px solid var(--neu-border);
        border-radius: 16px;
        box-shadow: 6px 6px 14px var(--neu-shadow-dark), -6px -6px 14px var(--neu-shadow-light);
        padding: 0.7rem 1rem;
        min-width: 180px;
        transition: all 0.2s ease;
    }

    .neu-context-label {
        color: var(--neu-muted);
        font-size: 0.68rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        margin-bottom: 0.2rem;
    }

    .neu-context-value {
        color: var(--neu-text);
        font-size: 0.88rem;
        font-weight: 700;
        white-space: nowrap;
    }

    /* KPI CARDS */
    .kpi-row {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 1.5rem;
        margin-bottom: 2rem;
    }

    .kpi-row > a {
        min-width: 0;
    }

    @@media (max-width: 1200px) {
        .kpi-row {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @@media (max-width: 600px) {
        .kpi-row {
            grid-template-columns: 1fr;
            gap: 1rem;
        }
    }

    .screenshot-card {
        border-radius: 20px;
        color: var(--neu-text) !important;
        display: flex;
        align-items: stretch;
        min-height: 118px;
        overflow: hidden;
        text-align: left;
        background: var(--neu-surface);
        border: 1px solid var(--neu-border);
        box-shadow: 8px 8px 18px var(--neu-shadow-dark), -8px -8px 18px var(--neu-shadow-light);
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

    .kpi-row a:hover .screenshot-card {
        transform: translateY(-3px);
        box-shadow: 10px 10px 22px var(--neu-shadow-dark), -10px -10px 22px var(--neu-shadow-light);
    }

    .card-left-block {
        width: 34%;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        padding: 0.75rem;
        text-align: center;
    }

    .card-left-icon {
        width: 58px;
        height: 58px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 18px;
        font-size: 1.55rem;
        box-shadow: inset 3px 3px 7px rgba(163, 177, 198, 0.12), inset -3px -3px 7px rgba(255, 255, 255, 0.75);
    }

    .card-right-block {
        width: 66%;
        padding: 0.75rem 0.9rem;
        display: flex;
        flex-direction: column;
        justify-content: center;
        min-width: 0;
    }

    .card-val {
        font-size: clamp(1.05rem, 1.6vw, 1.4rem);
        font-weight: 800;
        margin: 0;
        line-height: 1.25;
        color: var(--neu-text) !important;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .card-label {
        font-size: 0.73rem;
        font-weight: 600;
        color: var(--neu-muted);
        margin-top: 5px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .bg-kpi-blue .card-left-icon { color: #4f8df7; background: #e2edff; }
    .bg-kpi-indigo .card-left-icon { color: #7b72e8; background: #e9e5ff; }
    .bg-kpi-green .card-left-icon { color: #28b98c; background: #dff7ee; }
    .bg-kpi-purple .card-left-icon { color: #a06de7; background: #f0e4ff; }

    /* Summary Module */
    .summary-module {
        background: var(--neu-surface);
        border: 1px solid var(--neu-border);
        border-radius: 20px;
        margin-bottom: 2rem;
        text-align: left;
        overflow: hidden;
        box-shadow: 8px 8px 18px var(--neu-shadow-dark), -8px -8px 18px var(--neu-shadow-light);
    }

    .summary-header {
        background: transparent;
        border-bottom: 1px solid rgba(163, 177, 198, 0.18);
        padding: 1rem 1.5rem;
        font-size: 1.05rem;
        font-weight: 700;
        color: var(--neu-text);
    }

    .summary-header i { color: var(--neu-blue); }

    .summary-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
    }

    @@media (max-width: 900px) {
        .summary-grid { grid-template-columns: repeat(2, 1fr); }
    }

    @@media (max-width: 500px) {
        .summary-grid { grid-template-columns: 1fr; }
    }

    .summary-box {
        text-align: center;
        padding: 1.35rem 0.5rem;
        border-right: 1px solid rgba(163, 177, 198, 0.18);
        display: flex;
        flex-direction: column;
        justify-content: center;
        transition: background-color 0.2s ease;
    }

    .summary-box:last-child { border-right: none; }
    .summary-box:hover { background: rgba(255, 255, 255, 0.45); }

    .summary-title {
        font-size: 0.76rem;
        font-weight: 700;
        color: var(--neu-blue);
        margin-bottom: 0.5rem;
    }

    .summary-title.pending { color: var(--neu-red); }
    .summary-title.success { color: #24b889; }

    .summary-val {
        font-size: 1.25rem;
        font-weight: 800;
        color: var(--neu-text);
    }

    /* Detail Cards */
    .detail-card {
        background: var(--neu-surface);
        border: 1px solid var(--neu-border);
        border-radius: 20px;
        box-shadow: 8px 8px 18px var(--neu-shadow-dark), -8px -8px 18px var(--neu-shadow-light);
        padding: 1.5rem;
        height: 100%;
        text-align: left;
    }

    .detail-card h5 {
        font-size: 1.05rem;
        font-weight: 800 !important;
        color: var(--neu-text) !important;
    }

    .detail-card .table-responsive {
        border-radius: 14px;
        overflow-x: auto;
    }

    .inventory-dashboard-page .table {
        color: var(--neu-text);
        border-color: rgba(163, 177, 198, 0.18);
    }

    .inventory-dashboard-page .table thead {
        background: #eaf0f7 !important;
    }

    .inventory-dashboard-page .table thead th {
        color: #52647b;
        font-size: 0.75rem;
        font-weight: 800;
        border-bottom: 1px solid rgba(163, 177, 198, 0.25);
        padding: 0.8rem;
        white-space: nowrap;
    }

    .inventory-dashboard-page .table tbody td {
        color: var(--neu-text);
        padding: 0.75rem 0.8rem;
        border-color: rgba(163, 177, 198, 0.18);
        vertical-align: middle;
    }

    .inventory-dashboard-page .table-hover tbody tr:hover {
        background-color: rgba(226, 237, 255, 0.55);
    }

    .sku-pill {
        display: inline-block;
        font-size: 0.72rem;
        font-weight: 700;
        padding: 2px 7px;
        border-radius: 6px;
        background: #e8effc;
        color: #2b6cb0;
        margin-top: 3px;
    }

    .badge-reorder {
        font-size: 0.7rem;
        font-weight: 700;
        background: #fee2e2;
        color: #991b1b;
        border-radius: 6px;
        padding: 2px 6px;
    }

    .btn-xs {
        padding: 0.35rem 0.7rem;
        font-size: 0.75rem;
        border-radius: 9px;
        line-height: 1.2;
    }

    /* Modal styling */
    .inventory-dashboard-page .modal-content {
        background: var(--neu-surface);
        border: 1px solid var(--neu-border);
        border-radius: 20px;
        box-shadow: 12px 12px 30px rgba(163, 177, 198, 0.35), -12px -12px 30px rgba(255, 255, 255, 0.95);
    }

    .inventory-dashboard-page .modal-header {
        border-bottom: 1px solid rgba(163, 177, 198, 0.18);
        padding: 1.25rem 1.5rem;
    }

    .inventory-dashboard-page .modal-footer {
        border-top: 1px solid rgba(163, 177, 198, 0.18);
        padding: 1rem 1.5rem;
    }

    .inventory-dashboard-page .form-control,
    .inventory-dashboard-page .form-select {
        background: #edf2f8;
        border: 1px solid #dbe4ef;
        border-radius: 12px;
        color: var(--neu-text);
        padding: 0.65rem 0.85rem;
        font-size: 0.88rem;
    }

    .inventory-dashboard-page .form-control:focus,
    .inventory-dashboard-page .form-select:focus {
        background: #f8fbff;
        border-color: #a9c8ff;
        box-shadow: 0 0 0 0.2rem rgba(79, 141, 247, 0.12);
    }

    .inventory-dashboard-page .form-label {
        color: var(--neu-text);
        font-weight: 700;
        font-size: 0.82rem;
        margin-bottom: 0.35rem;
    }
</style>

<div class="inventory-dashboard-page">

    <!-- Header & Context Area -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-4 text-start">
        <div>
            <h4 class="fw-bold mb-1">Inventory Dashboard</h4>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0 small">
                    <li class="breadcrumb-item">
                        <a href="@Url.Action("Index", "InventoryDashboard")" class="text-decoration-none">
                            Dashboard
                        </a>
                    </li>
                    <li class="breadcrumb-item active" aria-current="page">
                        Product &amp; Catalog Command Center
                    </li>
                </ol>
            </nav>
        </div>

        <div class="d-flex flex-wrap align-items-center gap-2">
            <!-- Header Quick Action Buttons -->
            <button type="button" class="btn btn-quick-action btn-quick-adjust" onclick="openQuickAdjustModal()">
                <i class="fa-solid fa-sliders"></i>
                Quick Stock Adjustment
            </button>

            <a href="/InvCatalog/Items" class="btn btn-quick-action btn-quick-product text-decoration-none">
                <i class="fa-solid fa-plus-circle"></i>
                New Product / SKU
            </a>

            <!-- Active Context -->
            <div class="neu-context-card text-start d-none d-lg-block">
                <div class="neu-context-label">Active Role</div>
                <div class="neu-context-value">
                    <i class="fa-solid fa-boxes-stacked me-1 text-primary"></i>
                    @Model.CurrentUserRole
                </div>
            </div>

            <div class="neu-context-card text-start d-none d-lg-block">
                <div class="neu-context-label">Branch Scope</div>
                <div class="neu-context-value">
                    <i class="fa-solid fa-building me-1 text-info"></i>
                    @Model.CurrentCompany
                </div>
            </div>
        </div>
    </div>

    <!-- Top Filter Bar -->
    <div class="neu-filter-bar">
        <form id="dashboardFilterForm" method="get" action="@Url.Action("Index", "InventoryDashboard")" class="row g-3 align-items-center">
            <div class="col-12 col-sm-auto d-flex align-items-center gap-2">
                <i class="fa-solid fa-filter text-primary"></i>
                <span class="fw-bold text-secondary small text-uppercase">Filters:</span>
            </div>

            <!-- Branch/Warehouse Filter -->
            <div class="col-12 col-sm-auto">
                <div class="d-flex align-items-center gap-2">
                    <label class="form-label mb-0 small text-muted text-nowrap">Warehouse / Branch:</label>
                    <select name="branch" class="form-select neu-filter-select" onchange="document.getElementById('dashboardFilterForm').submit()">
                        @foreach (var b in Model.Branches)
                        {
                            if (Model.SelectedBranch == b)
                            {
                                <option value="@b" selected>@b</option>
                            }
                            else
                            {
                                <option value="@b">@b</option>
                            }
                        }
                    </select>
                </div>
            </div>

            <!-- Date Filter for Sales Velocity -->
            <div class="col-12 col-sm-auto">
                <div class="d-flex align-items-center gap-2">
                    <label class="form-label mb-0 small text-muted text-nowrap">Sales Velocity Window:</label>
                    <select name="dateRange" class="form-select neu-filter-select" onchange="document.getElementById('dashboardFilterForm').submit()">
                        @{
                            var dateOptions = new[] { "All Time", "Today", "This Week", "This Month", "This Quarter" };
                        }
                        @foreach (var opt in dateOptions)
                        {
                            if (Model.SelectedDateRange == opt)
                            {
                                <option value="@opt" selected>@opt</option>
                            }
                            else
                            {
                                <option value="@opt">@opt</option>
                            }
                        }
                    </select>
                </div>
            </div>

            <div class="col-12 col-sm-auto ms-sm-auto d-flex align-items-center gap-2">
                <span class="small text-muted">
                    <i class="fa-solid fa-warehouse text-secondary me-1"></i>
                    Scope: <strong>@Model.SelectedBranch</strong>
                </span>
                <a href="@Url.Action("Index", "InventoryDashboard")" class="btn btn-sm btn-link text-decoration-none py-0 text-muted small">
                    <i class="fa-solid fa-rotate-right me-1"></i>Reset
                </a>
            </div>
        </form>
    </div>

    <!-- 4 KPI Cards Grid -->
    <div class="kpi-row">
        <!-- Products Catalog -->
        <a href="/InvCatalog/Items" class="text-decoration-none">
            <div class="screenshot-card bg-kpi-blue">
                <div class="card-left-block">
                    <i class="fa-solid fa-box-open card-left-icon"></i>
                </div>
                <div class="card-right-block">
                    <h4 class="card-val">@Model.TotalProductsCount</h4>
                    <span class="card-label">Catalog Products &amp; SKUs</span>
                </div>
            </div>
        </a>

        <!-- Stock Quantity -->
        <a href="@Url.Action("StockDirectory", "InventoryDashboard")" class="text-decoration-none">
            <div class="screenshot-card bg-kpi-indigo">
                <div class="card-left-block">
                    <i class="fa-solid fa-cubes card-left-icon"></i>
                </div>
                <div class="card-right-block">
                    <h4 class="card-val">@Model.TotalStockQuantity.ToString("N0", inCulture)</h4>
                    <span class="card-label">Physical Units In Stock</span>
                </div>
            </div>
        </a>

        <!-- Stock Valuation -->
        <a href="@Url.Action("Valuation", "InvReports")" class="text-decoration-none">
            <div class="screenshot-card bg-kpi-green">
                <div class="card-left-block">
                    <i class="fa-solid fa-indian-rupee-sign card-left-icon"></i>
                </div>
                <div class="card-right-block">
                    <h4 class="card-val">₹@Model.TotalStockValue.ToString("N0", inCulture)</h4>
                    <span class="card-label">Stock Valuation (Cost)</span>
                </div>
            </div>
        </a>

        <!-- Purchase Orders -->
        <a href="/ESSPurchase" class="text-decoration-none">
            <div class="screenshot-card bg-kpi-purple">
                <div class="card-left-block">
                    <i class="fa-solid fa-truck card-left-icon"></i>
                </div>
                <div class="card-right-block">
                    <h4 class="card-val">₹@Model.PendingPurchaseOrdersAmount.ToString("N0", inCulture)</h4>
                    <span class="card-label">Pending PR &amp; Purchases</span>
                </div>
            </div>
        </a>
    </div>

    <!-- Stock Quantities Summary Module -->
    <div class="summary-module">
        <div class="summary-header d-flex justify-content-between align-items-center">
            <div>
                <i class="fa-solid fa-boxes-stacked me-2"></i>
                Warehouse Stock Quality Levels &amp; Health
            </div>
            <span class="small text-muted fw-normal">Branch: @Model.SelectedBranch</span>
        </div>

        <div class="summary-grid">
            <a href="@Url.Action("LowStockReport", "InventoryDashboard")" class="summary-box text-decoration-none">
                <span class="summary-title pending">Low Stock Items</span>
                <span class="summary-val text-warning">@Model.LowStockItemsCount</span>
            </a>

            <a href="@Url.Action("LowStockReport", "InventoryDashboard")" class="summary-box text-decoration-none">
                <span class="summary-title pending">Out of Stock Items</span>
                <span class="summary-val text-danger">@Model.OutOfStockItemsCount</span>
            </a>

            <a href="@Url.Action("StockDirectory", "InventoryDashboard")" class="summary-box text-decoration-none">
                <span class="summary-title success">Healthy Stock Items</span>
                <span class="summary-val text-success">
                    @Math.Max(0, Model.TotalProductsCount - Model.LowStockItemsCount - Model.OutOfStockItemsCount)
                </span>
            </a>

            <a href="/InvCatalog/Items" class="summary-box text-decoration-none">
                <span class="summary-title">Total Active SKUs</span>
                <span class="summary-val">@Model.TotalProductsCount</span>
            </a>
        </div>
    </div>

    <!-- Details Grid -->
    <div class="row g-4 mb-4">

        <!-- Left Column: Top Velocity Products -->
        <div class="col-lg-6">
            <div class="detail-card">
                <div class="d-flex justify-content-between align-items-center mb-4 gap-2">
                    <h5 class="fw-bold mb-0">
                        <i class="fa-solid fa-fire me-2 text-danger"></i>
                        Top Selling Catalog Products
                    </h5>

                    <a href="/InvCatalog/Items" class="btn btn-sm btn-outline-primary rounded-pill px-3">
                        View Catalog
                        <i class="fa fa-arrow-right ms-1"></i>
                    </a>
                </div>

                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0" style="font-size: 0.85rem;">
                        <thead>
                            <tr>
                                <th>Product / Item</th>
                                <th>Sold Qty</th>
                                <th>Available</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.AllCatalogItems != null && Model.AllCatalogItems.Any())
                            {
                                @foreach (var item in Model.AllCatalogItems.OrderByDescending(i => i.UnitsSold).Take(5))
                                {
                                    <tr>
                                        <td>
                                            <div class="fw-bold">@item.ItemName</div>
                                            <span class="sku-pill">@item.SKU</span>
                                        </td>
                                        <td><strong>@item.UnitsSold</strong> @(item.Uom?.Code ?? "Units")</td>
                                        <td>@item.CurrentStock @(item.Uom?.Code ?? "")</td>
                                        <td>
                                            @if (item.StockStatus == "In Stock")
                                            {
                                                <span class="badge bg-success-subtle text-success px-2 py-1">In Stock</span>
                                            }
                                            else if (item.StockStatus == "Low Stock")
                                            {
                                                <span class="badge bg-warning-subtle text-warning px-2 py-1">Low Stock</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-danger-subtle text-danger px-2 py-1">Out of Stock</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            }
                            else if (Model.TopProducts != null && Model.TopProducts.Any())
                            {
                                @foreach (var prod in Model.TopProducts)
                                {
                                    <tr>
                                        <td class="fw-bold">@prod.ProductName</td>
                                        <td>@prod.SoldQty</td>
                                        <td>@prod.StockQty</td>
                                        <td>
                                            <span class="badge @(prod.Status == "In Stock" ? "bg-success-subtle text-success" : prod.Status == "Low Stock" ? "bg-warning-subtle text-warning" : "bg-danger-subtle text-danger") px-2 py-1">
                                                @prod.Status
                                            </span>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="4" class="text-center py-4 text-muted">No catalog records found.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Right Column: Interactive Low Stock Alerts -->
        <div class="col-lg-6">
            <div class="detail-card">
                <div class="d-flex justify-content-between align-items-center mb-4 gap-2">
                    <div>
                        <h5 class="fw-bold mb-0">
                            <i class="fa-solid fa-triangle-exclamation me-2 text-warning"></i>
                            Low Stock Alerts
                        </h5>
                        <span class="small text-muted">Items falling below minimum reorder threshold</span>
                    </div>

                    <a href="/InvCatalog/Items?status=Low+Stock" class="btn btn-sm btn-outline-warning rounded-pill px-3">
                        Items Ledger
                        <i class="fa fa-external-link-alt ms-1"></i>
                    </a>
                </div>

                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0" style="font-size: 0.85rem;">
                        <thead>
                            <tr>
                                <th>Item &amp; SKU</th>
                                <th>Current</th>
                                <th>Reorder Min</th>
                                <th>Status</th>
                                <th class="text-end">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.LowStockCatalogItems != null && Model.LowStockCatalogItems.Any())
                            {
                                @foreach (var item in Model.LowStockCatalogItems.Take(6))
                                {
                                    int suggested = Math.Max(10, (item.MinimumReorderLevel * 2) - item.CurrentStock);
                                    <tr>
                                        <td>
                                            <div class="fw-bold text-dark">@item.ItemName</div>
                                            <span class="sku-pill">@item.SKU</span>
                                        </td>
                                        <td class="fw-bold @(item.CurrentStock <= 0 ? "text-danger" : "text-warning")">
                                            @item.CurrentStock @(item.Uom?.Code ?? "Units")
                                        </td>
                                        <td>
                                            <span class="badge-reorder">Min: @item.MinimumReorderLevel</span>
                                        </td>
                                        <td>
                                            @if (item.CurrentStock <= 0)
                                            {
                                                <span class="badge bg-danger-subtle text-danger px-2 py-0.5">Out of Stock</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-warning-subtle text-warning px-2 py-0.5">Low Stock</span>
                                            }
                                        </td>
                                        <td class="text-end">
                                            <button type="button"
                                                    class="btn btn-xs btn-primary px-2 py-1 shadow-sm"
                                                    onclick="openRestockModal('@item.ItemName', '@item.SKU', @item.CurrentStock, @item.MinimumReorderLevel, @item.PurchasePrice, @suggested, @item.Id)">
                                                <i class="fa fa-plus me-1"></i>Restock
                                            </button>
                                        </td>
                                    </tr>
                                }
                            }
                            else if (Model.LowStockProducts != null && Model.LowStockProducts.Any())
                            {
                                @foreach (var prod in Model.LowStockProducts)
                                {
                                    <tr>
                                        <td class="fw-bold">@prod.ProductName</td>
                                        <td class="fw-bold text-danger">@prod.StockQty</td>
                                        <td><span class="badge-reorder">Min: 20</span></td>
                                        <td>
                                            <span class="badge bg-danger-subtle text-danger px-2 py-0.5">@prod.Status</span>
                                        </td>
                                        <td class="text-end">
                                            <button type="button"
                                                    class="btn btn-xs btn-primary px-2 py-1"
                                                    onclick="openRestockModal('@prod.ProductName', 'SKU-GEN', @prod.StockQty, 20, 1200, 25, 0)">
                                                <i class="fa fa-plus me-1"></i>Restock
                                            </button>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="5" class="text-center py-4 text-muted">
                                        <i class="fa-solid fa-circle-check text-success me-1"></i> All catalog stocks are healthy!
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

    </div>

</div>

<!-- =========================================================================
     MODAL 1: INTERACTIVE RESTOCK TRIGGER (Creates PurchaseRequisition)
     ========================================================================= -->
<div class="modal fade" id="restockTriggerModal" tabindex="-1" aria-labelledby="restockTriggerModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title fw-bold" id="restockTriggerModalLabel">
                    <i class="fa-solid fa-cart-arrow-down text-primary me-2"></i>
                    Initiate Purchase Restock Requisition
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <form id="restockTriggerForm" onsubmit="submitRestockRequisition(event)">
                <div class="modal-body">
                    <input type="hidden" id="rstCatalogItemId" />

                    <div class="p-3 bg-light rounded-3 mb-3 border">
                        <div class="row g-2">
                            <div class="col-8">
                                <label class="form-label text-muted small mb-0">Item Name</label>
                                <div class="fw-bold fs-6 text-dark" id="rstDisplayItemName">—</div>
                            </div>
                            <div class="col-4 text-end">
                                <label class="form-label text-muted small mb-0">SKU Code</label>
                                <div><span class="sku-pill" id="rstDisplaySKU">—</span></div>
                            </div>
                            <div class="col-6 mt-2">
                                <span class="small text-muted">Current Physical Stock:</span>
                                <span class="fw-bold text-danger ms-1" id="rstDisplayCurrentStock">0</span>
                            </div>
                            <div class="col-6 mt-2 text-end">
                                <span class="small text-muted">Reorder Threshold:</span>
                                <span class="fw-bold text-dark ms-1" id="rstDisplayReorderLevel">0</span>
                            </div>
                        </div>
                    </div>

                    <div class="row g-3">
                        <div class="col-sm-6">
                            <label class="form-label">Suggested Order Qty <span class="text-danger">*</span></label>
                            <input type="number" id="rstQuantity" class="form-control" min="1" required />
                            <small class="text-muted">Auto-computed to restore safety buffer</small>
                        </div>

                        <div class="col-sm-6">
                            <label class="form-label">Est. Unit Price (₹)</label>
                            <input type="number" step="0.01" id="rstUnitPrice" class="form-control" />
                        </div>

                        <div class="col-sm-6">
                            <label class="form-label">Urgency Priority</label>
                            <select id="rstUrgencyLevel" class="form-select">
                                <option value="High Priority" selected>High Priority (Stock Buffer Depleted)</option>
                                <option value="Critical / Immediate">Critical / Immediate (Out of Stock)</option>
                                <option value="Medium Priority">Medium Priority (Standard Restock)</option>
                            </select>
                        </div>

                        <div class="col-sm-6">
                            <label class="form-label">Est. Total Commitment</label>
                            <div class="form-control bg-light fw-bold text-primary" id="rstEstimatedTotal">₹0.00</div>
                        </div>

                        <div class="col-12">
                            <label class="form-label">Business Justification / Procurement Notes</label>
                            <textarea id="rstJustification" class="form-control" rows="2" placeholder="e.g. Automated replenishment triggered from low stock dashboard monitor."></textarea>
                        </div>
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary px-3" id="btnSubmitRestock">
                        <i class="fa-solid fa-paper-plane me-1"></i>
                        Submit Requisition to Purchase
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- =========================================================================
     MODAL 2: QUICK STOCK ADJUSTMENT (+ / - Audit / Scrap / Found)
     ========================================================================= -->
<div class="modal fade" id="quickAdjustModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title fw-bold">
                    <i class="fa-solid fa-sliders text-warning me-2"></i>
                    Quick Stock Adjustment
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <form id="quickAdjustForm" onsubmit="submitQuickAdjustment(event)">
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Select Catalog Product / SKU <span class="text-danger">*</span></label>
                        <select id="adjItemId" class="form-select" required>
                            <option value="">-- Choose Item --</option>
                            @if (Model.AllCatalogItems != null)
                            {
                                @foreach (var itm in Model.AllCatalogItems)
                                {
                                    <option value="@itm.Id">@itm.ItemName (@itm.SKU) - Current Stock: @itm.CurrentStock</option>
                                }
                            }
                            @if (Model.TopProducts != null)
                            {
                                @foreach (var p in Model.TopProducts)
                                {
                                    <option value="@p.ProductId">@p.ProductName (Legacy) - Current Stock: @p.StockQty</option>
                                }
                            }
                        </select>
                    </div>

                    <div class="row g-3">
                        <div class="col-sm-6">
                            <label class="form-label">Adjustment Type <span class="text-danger">*</span></label>
                            <select id="adjType" class="form-select" required>
                                <option value="Add">+ Add to Stock (Found / Delivery)</option>
                                <option value="Deduct">- Deduct from Stock (Damaged / Loss / Scrap)</option>
                            </select>
                        </div>

                        <div class="col-sm-6">
                            <label class="form-label">Quantity <span class="text-danger">*</span></label>
                            <input type="number" id="adjQty" class="form-control" min="1" value="1" required />
                        </div>

                        <div class="col-12">
                            <label class="form-label">Reason <span class="text-danger">*</span></label>
                            <select id="adjReason" class="form-select" required>
                                <option value="Physical Audit Reconciliation">Physical Audit Reconciliation</option>
                                <option value="Damaged in Warehouse">Damaged in Warehouse</option>
                                <option value="Shrinkage / Missing Loss">Shrinkage / Missing Loss</option>
                                <option value="Customer Return Stock Found">Customer Return Stock Found</option>
                                <option value="Internal Use / Demonstration">Internal Use / Demonstration</option>
                            </select>
                        </div>

                        <div class="col-12">
                            <label class="form-label">Remarks / Location Details</label>
                            <input type="text" id="adjRemarks" class="form-control" placeholder="e.g. Discovered 2 units in Rack B staging bin." />
                        </div>
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-warning px-3" id="btnSubmitAdjustment">
                        <i class="fa-solid fa-check me-1"></i>Apply Adjustment
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    // Global CSRF Token getter
    function getAntiForgeryToken() {
        const tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
        return tokenInput ? tokenInput.value : '';
    }

    // Modal instances
    let restockModalInstance = null;
    let adjustModalInstance = null;

    document.addEventListener('DOMContentLoaded', () => {
        const rstModalEl = document.getElementById('restockTriggerModal');
        if (rstModalEl) restockModalInstance = new bootstrap.Modal(rstModalEl);

        const adjModalEl = document.getElementById('quickAdjustModal');
        if (adjModalEl) adjustModalInstance = new bootstrap.Modal(adjModalEl);

        // Recalculate total on qty / price change
        document.getElementById('rstQuantity').addEventListener('input', updateEstimatedTotal);
        document.getElementById('rstUnitPrice').addEventListener('input', updateEstimatedTotal);
    });

    function updateEstimatedTotal() {
        const qty = parseFloat(document.getElementById('rstQuantity').value) || 0;
        const price = parseFloat(document.getElementById('rstUnitPrice').value) || 0;
        const total = qty * price;
        document.getElementById('rstEstimatedTotal').innerText = '₹' + total.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    }

    function openRestockModal(itemName, sku, currentStock, reorderLevel, unitPrice, suggestedQty, catalogItemId) {
        document.getElementById('rstCatalogItemId').value = catalogItemId;
        document.getElementById('rstDisplayItemName').innerText = itemName;
        document.getElementById('rstDisplaySKU').innerText = sku;
        document.getElementById('rstDisplayCurrentStock').innerText = currentStock;
        document.getElementById('rstDisplayReorderLevel').innerText = reorderLevel;

        document.getElementById('rstQuantity').value = suggestedQty > 0 ? suggestedQty : 10;
        document.getElementById('rstUnitPrice').value = unitPrice > 0 ? unitPrice : 1200;
        document.getElementById('rstJustification').value = `Automated restock trigger for SKU: ${sku}. Current physical inventory is ${currentStock}, which is below safety reorder threshold of ${reorderLevel}.`;

        updateEstimatedTotal();
        if (restockModalInstance) restockModalInstance.show();
    }

    async function submitRestockRequisition(e) {
        e.preventDefault();
        const btn = document.getElementById('btnSubmitRestock');
        btn.disabled = true;
        btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Creating Requisition...';

        const payload = {
            CatalogItemId: parseInt(document.getElementById('rstCatalogItemId').value) || null,
            ItemName: document.getElementById('rstDisplayItemName').innerText,
            SKU: document.getElementById('rstDisplaySKU').innerText,
            CurrentStock: parseInt(document.getElementById('rstDisplayCurrentStock').innerText) || 0,
            ReorderLevel: parseInt(document.getElementById('rstDisplayReorderLevel').innerText) || 0,
            SuggestedQuantity: parseInt(document.getElementById('rstQuantity').value) || 1,
            UnitPrice: parseFloat(document.getElementById('rstUnitPrice').value) || 0,
            UrgencyLevel: document.getElementById('rstUrgencyLevel').value,
            Justification: document.getElementById('rstJustification').value
        };

        try {
            const response = await fetch('/InventoryDashboard/TriggerRestock', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': getAntiForgeryToken()
                },
                body: JSON.stringify(payload)
            });

            const res = await response.json();
            if (res.success) {
                alert(res.message || "Purchase Requisition created successfully!");
                if (restockModalInstance) restockModalInstance.hide();
                location.reload();
            } else {
                alert(res.message || "Failed to create Purchase Requisition.");
                btn.disabled = false;
                btn.innerHTML = '<i class="fa-solid fa-paper-plane me-1"></i> Submit Requisition to Purchase';
            }
        } catch (err) {
            console.error(err);
            alert("An error occurred while connecting to the server.");
            btn.disabled = false;
            btn.innerHTML = '<i class="fa-solid fa-paper-plane me-1"></i> Submit Requisition to Purchase';
        }
    }

    function openQuickAdjustModal() {
        if (adjustModalInstance) adjustModalInstance.show();
    }

    async function submitQuickAdjustment(e) {
        e.preventDefault();
        const btn = document.getElementById('btnSubmitAdjustment');
        btn.disabled = true;
        btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Applying...';

        const payload = {
            ItemId: parseInt(document.getElementById('adjItemId').value) || 0,
            AdjustmentType: document.getElementById('adjType').value,
            AdjustmentQty: parseInt(document.getElementById('adjQty').value) || 1,
            Reason: document.getElementById('adjReason').value,
            Remarks: document.getElementById('adjRemarks').value
        };

        if (!payload.ItemId) {
            alert("Please select a product or item.");
            btn.disabled = false;
            btn.innerHTML = '<i class="fa-solid fa-check me-1"></i>Apply Adjustment';
            return;
        }

        try {
            const response = await fetch('/InventoryDashboard/AdjustStock', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': getAntiForgeryToken()
                },
                body: JSON.stringify(payload)
            });

            const res = await response.json();
            if (res.success) {
                alert(res.message || "Stock adjusted successfully!");
                if (adjustModalInstance) adjustModalInstance.hide();
                location.reload();
            } else {
                alert(res.message || "Failed to adjust stock.");
                btn.disabled = false;
                btn.innerHTML = '<i class="fa-solid fa-check me-1"></i>Apply Adjustment';
            }
        } catch (err) {
            console.error(err);
            alert("Server communication error.");
            btn.disabled = false;
            btn.innerHTML = '<i class="fa-solid fa-check me-1"></i>Apply Adjustment';
        }
    }
</script>
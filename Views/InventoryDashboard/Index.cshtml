@model ERP_System.Models.InventoryDashboardViewModel
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Inventory Dashboard";
    var inCulture = new System.Globalization.CultureInfo("en-IN");
}

<style>
    /* =========================================================
           SOFT NEUMORPHIC INVENTORY DASHBOARD
           ========================================================= */

    :root {
        --neu-bg: #eef3f9;
        --neu-surface: #f8fbff;
        --neu-white: #ffffff;
        --neu-text: #26364d;
        --neu-muted: #718096;
        --neu-border: rgba(255, 255, 255, 0.85);
        --neu-shadow-dark: rgba(163, 177, 198, 0.32);
        --neu-shadow-light: rgba(255, 255, 255, 0.95);
        --neu-blue: #4f8df7;
        --neu-blue-dark: #3b78e7;
        --neu-purple: #9b7bea;
        --neu-green: #45c9a0;
        --neu-orange: #f5b84b;
        --neu-red: #ef6b7a;
    }

    /* Main dashboard background */
    .inventory-dashboard-page {
        background: var(--neu-bg);
        color: var(--neu-text);
        min-height: 100%;
    }

    /* Dashboard heading */
    .dashboard-title-bar {
        text-align: left;
        margin-bottom: 1.5rem;
    }

    .dashboard-title {
        font-size: 1.8rem;
        font-weight: 700;
        color: var(--neu-text);
        margin: 0;
    }

    .inventory-dashboard-page h4,
    .inventory-dashboard-page h5,
    .inventory-dashboard-page h6 {
        color: var(--neu-text);
    }

    .inventory-dashboard-page .text-dark {
        color: var(--neu-text) !important;
    }

    .inventory-dashboard-page .text-muted {
        color: var(--neu-muted) !important;
    }

    /* Breadcrumb */
    .inventory-dashboard-page .breadcrumb {
        color: var(--neu-muted);
    }

    .inventory-dashboard-page .breadcrumb-item a {
        color: var(--neu-blue);
    }

    .inventory-dashboard-page .breadcrumb-item.active {
        color: var(--neu-muted);
    }

    /* =========================================================
           ROLE / COMPANY CONTEXT CARDS
           ========================================================= */

    .neu-context-card {
        background: var(--neu-surface);
        border: 1px solid var(--neu-border);
        border-radius: 16px;
        box-shadow: 6px 6px 14px var(--neu-shadow-dark), -6px -6px 14px var(--neu-shadow-light);
        padding: 0.7rem 1rem;
        min-width: 190px;
        transition: all 0.2s ease;
    }

        .neu-context-card:hover {
            transform: translateY(-2px);
            box-shadow: 8px 8px 18px var(--neu-shadow-dark), -8px -8px 18px var(--neu-shadow-light);
        }

    .neu-context-label {
        color: var(--neu-muted);
        font-size: 0.68rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        margin-bottom: 0.2rem;
    }

    .neu-context-value {
        color: var(--neu-text);
        font-size: 0.88rem;
        font-weight: 700;
        white-space: nowrap;
    }

    /* =========================================================
           KPI CARDS
           ========================================================= */

    .kpi-row {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 1.5rem;
        margin-bottom: 2rem;
    }

        .kpi-row > a {
            min-width: 0;
        }

    @@media (max-width: 1200px) {
        .kpi-row {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @@media (max-width: 600px) {
        .kpi-row {
            grid-template-columns: 1fr;
            gap: 1rem;
        }
    }

    .screenshot-card {
        border-radius: 20px;
        color: var(--neu-text) !important;
        display: flex;
        align-items: stretch;
        min-height: 118px;
        overflow: hidden;
        text-align: left;
        background: var(--neu-surface);
        border: 1px solid var(--neu-border);
        box-shadow: 8px 8px 18px var(--neu-shadow-dark), -8px -8px 18px var(--neu-shadow-light);
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

    .kpi-row a:hover .screenshot-card {
        transform: translateY(-3px);
        box-shadow: 10px 10px 22px var(--neu-shadow-dark), -10px -10px 22px var(--neu-shadow-light);
    }

    .card-left-block {
        width: 34%;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        padding: 0.75rem;
        text-align: center;
        background: transparent;
        border-right: none;
    }

    .card-left-icon {
        width: 58px;
        height: 58px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 18px;
        font-size: 1.55rem;
        box-shadow: inset 3px 3px 7px rgba(163, 177, 198, 0.12), inset -3px -3px 7px rgba(255, 255, 255, 0.75);
    }

    .card-right-block {
        width: 66%;
        padding: 0.75rem 0.9rem;
        display: flex;
        flex-direction: column;
        justify-content: center;
        min-width: 0;
    }

    .card-val {
        font-size: clamp(1.05rem, 1.6vw, 1.4rem);
        font-weight: 800;
        margin: 0;
        line-height: 1.25;
        color: var(--neu-text) !important;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .card-label {
        font-size: 0.73rem;
        font-weight: 600;
        color: var(--neu-muted);
        margin-top: 5px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    /* Pastel icon backgrounds */
    .bg-kpi-blue .card-left-icon {
        color: #4f8df7;
        background: #e2edff;
    }

    .bg-kpi-indigo .card-left-icon {
        color: #7b72e8;
        background: #e9e5ff;
    }

    .bg-kpi-green .card-left-icon {
        color: #28b98c;
        background: #dff7ee;
    }

    .bg-kpi-purple .card-left-icon {
        color: #a06de7;
        background: #f0e4ff;
    }

    /* Remove old solid backgrounds */
    .bg-kpi-blue,
    .bg-kpi-indigo,
    .bg-kpi-purple,
    .bg-kpi-green,
    .bg-kpi-teal-dark,
    .bg-kpi-slate,
    .bg-kpi-violet,
    .bg-kpi-teal-light {
        background: var(--neu-surface);
    }

    /* =========================================================
           STOCK SUMMARY MODULE
           ========================================================= */

    .summary-module {
        background: var(--neu-surface);
        border: 1px solid var(--neu-border);
        border-radius: 20px;
        margin-bottom: 2rem;
        text-align: left;
        overflow: hidden;
        box-shadow: 8px 8px 18px var(--neu-shadow-dark), -8px -8px 18px var(--neu-shadow-light);
    }

    .summary-header {
        background: transparent;
        border-bottom: 1px solid rgba(163, 177, 198, 0.18);
        padding: 1rem 1.5rem;
        font-size: 1.05rem;
        font-weight: 700;
        color: var(--neu-text);
    }

        .summary-header i {
            color: var(--neu-blue);
        }

    .summary-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
    }

    @@media (max-width: 900px) {
        .summary-grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @@media (max-width: 500px) {
        .summary-grid {
            grid-template-columns: 1fr;
        }
    }

    .summary-box {
        text-align: center;
        padding: 1.35rem 0.5rem;
        border-right: 1px solid rgba(163, 177, 198, 0.18);
        display: flex;
        flex-direction: column;
        justify-content: center;
        transition: background-color 0.2s ease;
    }

        .summary-box:last-child {
            border-right: none;
        }

        .summary-box:hover {
            background: rgba(255, 255, 255, 0.45);
        }

    .summary-title {
        font-size: 0.76rem;
        font-weight: 700;
        color: var(--neu-blue);
        margin-bottom: 0.5rem;
    }

        .summary-title.pending {
            color: var(--neu-red);
        }

        .summary-title.success {
            color: #24b889;
        }

    .summary-val {
        font-size: 1.25rem;
        font-weight: 800;
        color: var(--neu-text);
    }

    /* =========================================================
           DETAIL CARDS
           ========================================================= */

    .detail-card {
        background: var(--neu-surface);
        border: 1px solid var(--neu-border);
        border-radius: 20px;
        box-shadow: 8px 8px 18px var(--neu-shadow-dark), -8px -8px 18px var(--neu-shadow-light);
        padding: 1.5rem;
        height: 100%;
        text-align: left;
    }

        .detail-card h5 {
            font-size: 1.05rem;
            font-weight: 800 !important;
            color: var(--neu-text) !important;
        }

        .detail-card .table-responsive {
            border-radius: 14px;
            overflow-x: auto;
        }

    /* =========================================================
           TABLES
           ========================================================= */

    .inventory-dashboard-page .table {
        color: var(--neu-text);
        border-color: rgba(163, 177, 198, 0.18);
    }

        .inventory-dashboard-page .table thead {
            background: #eaf0f7 !important;
        }

            .inventory-dashboard-page .table thead th {
                color: #52647b;
                font-size: 0.75rem;
                font-weight: 800;
                border-bottom: 1px solid rgba(163, 177, 198, 0.25);
                padding: 0.8rem;
                white-space: nowrap;
            }

        .inventory-dashboard-page .table tbody td {
            color: var(--neu-text);
            padding: 0.75rem 0.8rem;
            border-color: rgba(163, 177, 198, 0.18);
            vertical-align: middle;
        }

        .inventory-dashboard-page .table tbody tr {
            transition: background-color 0.2s ease;
        }

    .inventory-dashboard-page .table-hover tbody tr:hover {
        background-color: rgba(226, 237, 255, 0.55);
    }

    /* Status badges */
    .inventory-dashboard-page .badge {
        border-radius: 8px;
        font-weight: 700;
        padding: 0.35rem 0.55rem !important;
    }

    .inventory-dashboard-page .bg-success-subtle {
        background: #dff7ee !important;
    }

    .inventory-dashboard-page .bg-warning-subtle {
        background: #fff1d5 !important;
    }

    .inventory-dashboard-page .bg-danger-subtle {
        background: #ffe2e7 !important;
    }

    /* =========================================================
           BUTTONS
           ========================================================= */

    .inventory-dashboard-page .btn {
        font-weight: 700;
        transition: all 0.2s ease;
    }

    .inventory-dashboard-page .btn-outline-primary {
        color: var(--neu-blue);
        border-color: #a9c8ff;
        background: #f4f8ff;
    }

        .inventory-dashboard-page .btn-outline-primary:hover {
            color: #ffffff;
            background: var(--neu-blue);
            border-color: var(--neu-blue);
        }

    .inventory-dashboard-page .btn-outline-warning {
        color: #d89518;
        border-color: #f3d28c;
        background: #fffaf0;
    }

        .inventory-dashboard-page .btn-outline-warning:hover {
            color: #ffffff;
            background: var(--neu-orange);
            border-color: var(--neu-orange);
        }

    .inventory-dashboard-page .btn-primary {
        background: var(--neu-blue);
        border-color: var(--neu-blue);
    }

        .inventory-dashboard-page .btn-primary:hover {
            background: var(--neu-blue-dark);
            border-color: var(--neu-blue-dark);
            transform: translateY(-1px);
        }

    .inventory-dashboard-page .btn-success {
        background: var(--neu-green);
        border-color: var(--neu-green);
    }

    .inventory-dashboard-page .btn-light {
        background: #edf2f8;
        border-color: #dbe4ef;
        color: var(--neu-text);
    }

    .btn-xs {
        padding: 0.35rem 0.7rem;
        font-size: 0.75rem;
        border-radius: 9px;
        line-height: 1.2;
    }

    /* =========================================================
           MODAL
           ========================================================= */

    .inventory-dashboard-page .modal-content {
        background: var(--neu-surface);
        border: 1px solid var(--neu-border);
        border-radius: 20px;
        box-shadow: 12px 12px 30px rgba(163, 177, 198, 0.35), -12px -12px 30px rgba(255, 255, 255, 0.95);
    }

    .inventory-dashboard-page .modal-header {
        border-bottom: 1px solid rgba(163, 177, 198, 0.18);
        padding: 1.25rem 1.5rem;
    }

    .inventory-dashboard-page .modal-title {
        color: var(--neu-text);
        font-weight: 800;
    }

    .inventory-dashboard-page .modal-body {
        padding: 1.5rem;
    }

    .inventory-dashboard-page .modal-footer {
        border-top: 1px solid rgba(163, 177, 198, 0.18);
        padding: 1rem 1.5rem;
    }

    .inventory-dashboard-page .form-control {
        background: #edf2f8;
        border: 1px solid #dbe4ef;
        border-radius: 12px;
        color: var(--neu-text);
        padding: 0.7rem 0.9rem;
    }

        .inventory-dashboard-page .form-control:focus {
            background: #f8fbff;
            border-color: #a9c8ff;
            box-shadow: 0 0 0 0.2rem rgba(79, 141, 247, 0.12);
        }

    .inventory-dashboard-page .form-label {
        color: var(--neu-text);
        font-weight: 700;
    }

    /* =========================================================
           RESPONSIVE DETAILS
           ========================================================= */

    @@media (max-width: 576px) {
        .neu-context-card {
            width: 100%;
            min-width: 0;
        }

        .neu-context-value {
            white-space: normal;
        }

        .detail-card {
            padding: 1rem;
        }

        .summary-header {
            padding: 0.9rem 1rem;
        }

        .card-left-icon {
            width: 50px;
            height: 50px;
            font-size: 1.35rem;
        }

        .card-right-block {
            padding: 0.75rem;
        }
    }
</style>

<!-- Soft Neumorphic Dashboard Wrapper -->
<div class="inventory-dashboard-page">

    <!-- Header & Context Area -->
    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-3 mb-4 text-start">
        <div>
            <h4 class="fw-bold mb-1">Dashboard</h4>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0 small">
                    <li class="breadcrumb-item">
                        <a href="@Url.Action("Index", "InventoryDashboard")" class="text-decoration-none">
                            Dashboard
                        </a>
                    </li>
                    <li class="breadcrumb-item active" aria-current="page">
                        Inventory & Procurement
                    </li>
                </ol>
            </nav>
        </div>

        <div class="d-flex flex-column flex-sm-row gap-3 w-100 w-sm-auto">

            <!-- Active Role -->
            <div class="neu-context-card text-start">
                <div class="neu-context-label">Active Role</div>
                <div class="neu-context-value">
                    <i class="fa-solid fa-boxes-stacked me-1 text-primary"></i>
                    @Model.CurrentUserRole
                </div>
            </div>

            <!-- Scope Context -->
            <div class="neu-context-card text-start">
                <div class="neu-context-label">Scope Context</div>
                <div class="neu-context-value">
                    <i class="fa-solid fa-building me-1 text-info"></i>
                    @Model.CurrentCompany
                </div>
            </div>

        </div>
    </div>

    <!-- 4 KPI Cards Grid -->
    <div class="kpi-row">

        <!-- Products Catalog -->
        <a href="@Url.Action("Index", "ItemMaster")" class="text-decoration-none">
            <div class="screenshot-card bg-kpi-blue">
                <div class="card-left-block">
                    <i class="fa-solid fa-box-open card-left-icon"></i>
                </div>
                <div class="card-right-block">
                    <h4 class="card-val">@Model.TotalProductsCount</h4>
                    <span class="card-label">Catalog Products</span>
                </div>
            </div>
        </a>

        <!-- Stock Quantity -->
        <a href="@Url.Action("StockDirectory", "InventoryDashboard")" class="text-decoration-none">
            <div class="screenshot-card bg-kpi-indigo">
                <div class="card-left-block">
                    <i class="fa-solid fa-cubes card-left-icon"></i>
                </div>
                <div class="card-right-block">
                    <h4 class="card-val">@Model.TotalStockQuantity.ToString("N0", inCulture)</h4>
                    <span class="card-label">Physical Units In Stock</span>
                </div>
            </div>
        </a>

        <!-- Stock Valuation -->
        <a href="@Url.Action("Valuation", "InvReports")" class="text-decoration-none">
            <div class="screenshot-card bg-kpi-green">
                <div class="card-left-block">
                    <i class="fa-solid fa-indian-rupee-sign card-left-icon"></i>
                </div>
                <div class="card-right-block">
                    <h4 class="card-val">₹@Model.TotalStockValue.ToString("N0", inCulture)</h4>
                    <span class="card-label">Estimated Stock Value</span>
                </div>
            </div>
        </a>

        <!-- Purchase Orders -->
        <a href="@Url.Action("Orders", "Purchase")" class="text-decoration-none">
            <div class="screenshot-card bg-kpi-purple">
                <div class="card-left-block">
                    <i class="fa-solid fa-truck card-left-icon"></i>
                </div>
                <div class="card-right-block">
                    <h4 class="card-val">₹@Model.PendingPurchaseOrdersAmount.ToString("N0", inCulture)</h4>
                    <span class="card-label">Pending Purchase Orders</span>
                </div>
            </div>
        </a>

    </div>

    <!-- Stock Quantities Summary Module -->
    <div class="summary-module">

        <div class="summary-header">
            <i class="fa-solid fa-boxes-stacked me-2"></i>
            Warehouse Stock Quality Levels
        </div>

        <div class="summary-grid">

            <a href="@Url.Action("LowStockReport", "InventoryDashboard")" class="summary-box text-decoration-none">
                <span class="summary-title pending">Low Stock Items</span>
                <span class="summary-val text-warning">@Model.LowStockItemsCount</span>
            </a>

            <a href="@Url.Action("LowStockReport", "InventoryDashboard")" class="summary-box text-decoration-none">
                <span class="summary-title pending">Out of Stock Items</span>
                <span class="summary-val text-danger">@Model.OutOfStockItemsCount</span>
            </a>

            <a href="@Url.Action("StockDirectory", "InventoryDashboard")" class="summary-box text-decoration-none">
                <span class="summary-title success">Healthy Stock Items</span>
                <span class="summary-val text-success">
                    @((Model.TotalProductsCount - Model.LowStockItemsCount - Model.OutOfStockItemsCount))
                </span>
            </a>

            <a href="@Url.Action("Index", "ItemMaster")" class="summary-box text-decoration-none">
                <span class="summary-title">Total Active SKUs</span>
                <span class="summary-val">@Model.TotalProductsCount</span>
            </a>

        </div>
    </div>

    <!-- Details Grid -->
    <div class="row g-4 mb-5">

        <!-- Left Column: Top Selling Products -->
        <div class="col-lg-7">

            <div class="detail-card">

                <div class="d-flex justify-content-between align-items-center mb-4 gap-2">
                    <h5 class="fw-bold mb-0">
                        <i class="fa-solid fa-fire me-2 text-danger"></i>
                        Top Selling Catalog Products
                    </h5>

                    <a href="@Url.Action("Index", "ItemMaster")"
                       class="btn btn-sm btn-outline-primary rounded-pill px-3">
                        View All Products
                        <i class="fa fa-arrow-right ms-1"></i>
                    </a>
                </div>

                <div class="table-responsive">

                    <table class="table table-hover align-middle mb-0" style="font-size: 0.85rem;">

                        <thead class="table-light">
                            <tr>
                                <th>Product Name</th>
                                <th>Units Sold</th>
                                <th>Units Left</th>
                                <th>Status</th>
                            </tr>
                        </thead>

                        <tbody>

                            @if (Model.TopProducts != null && Model.TopProducts.Any())
                            {
                                @foreach (var prod in Model.TopProducts)
                                {
                                    <tr>
                                        <td class="fw-bold">@prod.ProductName</td>
                                        <td>@prod.SoldQty</td>
                                        <td>@prod.StockQty</td>
                                        <td>
                                            <span class="badge @(prod.Status == "In Stock" ? "bg-success-subtle text-success" : prod.Status == "Low Stock" ? "bg-warning-subtle text-warning" : "bg-danger-subtle text-danger") px-2 py-1 small">
                                                @prod.Status
                                            </span>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="4" class="text-center py-4 text-muted">
                                        No products catalog found.
                                    </td>
                                </tr>
                            }

                        </tbody>
                    </table>

                </div>
            </div>
        </div>

        <!-- Right Column: Low Stock Alerts -->
        <div class="col-lg-5">

            <div class="detail-card">

                <div class="d-flex justify-content-between align-items-center mb-4 gap-2">
                    <h5 class="fw-bold mb-0">
                        <i class="fa-solid fa-triangle-exclamation me-2 text-warning"></i>
                        Low Stock Alerts
                    </h5>

                    <a href="@Url.Action("LowStockReport", "InventoryDashboard")"
                       class="btn btn-sm btn-outline-warning rounded-pill px-3">
                        Low Stock Ledger
                        <i class="fa fa-external-link-alt ms-1"></i>
                    </a>
                </div>

                <div class="table-responsive">

                    <table class="table table-hover align-middle mb-0" style="font-size: 0.85rem;">

                        <thead class="table-light">
                            <tr>
                                <th>Product</th>
                                <th>Stock Qty</th>
                                <th>Alert</th>
                                <th class="text-end">Action</th>
                            </tr>
                        </thead>

                        <tbody>

                            @if (Model.LowStockProducts != null && Model.LowStockProducts.Any())
                            {
                                @foreach (var prod in Model.LowStockProducts)
                                {
                                    <tr>
                                        <td class="fw-bold">@prod.ProductName</td>
                                        <td class="fw-bold text-danger">@prod.StockQty</td>
                                        <td>
                                            <span class="badge bg-danger-subtle text-danger px-2 py-0.5 small">
                                                @prod.Status
                                            </span>
                                        </td>
                                        <td class="text-end">
                                            <button type="button"
                                                    class="btn btn-xs btn-primary px-2 py-1"
                                                    onclick="openRestockModal('@prod.ProductName', '@prod.StockQty')">
                                                <i class="fa fa-plus me-1"></i>
                                                Restock
                                            </button>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="4" class="text-center py-4 text-muted">
                                        No low stock alerts recorded!
                                    </td>
                                </tr>
                            }

                        </tbody>
                    </table>

                </div>
            </div>
        </div>

    </div>

</div>

<!-- Restock Modal -->
<div class="modal fade" id="restockModal" tabindex="-1" aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">Initiate Stock Restock</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">

                <input type="hidden" id="restockProductName" />

                <div class="mb-3">
                    <label class="form-label text-muted">Item Name</label>
                    <input type="text"
                           id="displayProductName"
                           class="form-control"
                           readonly />
                </div>

                <div class="mb-3">
                    <label class="form-label">Quantity to Add</label>
                    <input type="number"
                           id="restockQty"
                           class="form-control"
                           min="1"
                           value="10"
                           required />
                </div>

                <div class="mb-3">
                    <label class="form-label">Reason / Reference PO</label>
                    <input type="text"
                           id="restockReason"
                           class="form-control"
                           placeholder="e.g. Received from Supplier / PO-2026-01"
                           required />
                </div>

            </div>

            <div class="modal-footer">
                <button type="button"
                        class="btn btn-light"
                        data-bs-dismiss="modal">
                    Cancel
                </button>

                <button type="button"
                        class="btn btn-success"
                        id="btnConfirmRestock"
                        onclick="submitRestock()">
                    Confirm & Update Stock
                </button>
            </div>

        </div>
    </div>
</div>

<script>
    function openRestockModal(productName, currentQty) {
        document.getElementById('restockProductName').value = productName;
        document.getElementById('displayProductName').value =
            productName + ' (Current: ' + currentQty + ')';

        const modal = new bootstrap.Modal(
            document.getElementById('restockModal')
        );

        modal.show();
    }

    async function submitRestock() {
        const btn = document.getElementById('btnConfirmRestock');
        const productName = document.getElementById('restockProductName').value;
        const qty = parseInt(document.getElementById('restockQty').value);
        const reason = document.getElementById('restockReason').value;

        if (!qty || qty <= 0) {
            alert("Please enter a valid quantity.");
            return;
        }

        btn.disabled = true;
        btn.innerHTML =
            '<span class="spinner-border spinner-border-sm"></span> Processing...';

        try {
            const response = await fetch('/InventoryDashboard/QuickRestock', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({
                    productName: productName,
                    quantity: qty,
                    reason: reason
                })
            });

            const result = await response.json();

            if (result.success) {
                alert(result.message || "Stock restocked successfully!");
                location.reload();
            } else {
                alert(result.message || "Failed to update stock.");
                btn.disabled = false;
                btn.innerHTML = 'Confirm & Update Stock';
            }

        } catch (err) {
            console.error(err);
            alert("Server error occurred while updating stock.");
            btn.disabled = false;
            btn.innerHTML = 'Confirm & Update Stock';
        }
    }
</script>
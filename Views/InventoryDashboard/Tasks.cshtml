@model List<ERP_System.Models.HierarchicalTask>
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Warehouse Tasks & Operations";
    var teamMembers = ViewBag.TeamMembers as List<ERP_System.Models.User> ?? new List<ERP_System.Models.User>();
}

<style>
    .inv-table-card {
        background: #ffffff;
        border-radius: 14px;
        border: 1px solid var(--border-warm, #e2e8f0);
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.04);
    }
</style>

<div class="container-fluid py-3 px-3 px-md-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <div class="text-muted small mb-1">
                <a href="@Url.Action("Index", "InventoryDashboard")" class="text-decoration-none text-muted">Inventory Portal</a> / <span>Team Operations</span>
            </div>
            <h4 class="fw-bold mb-0 text-dark">
                <i class="fa-solid fa-tasks text-primary me-2"></i>Warehouse & Inventory Task Delegation
            </h4>
        </div>
        <button type="button" class="btn btn-primary px-3 shadow-sm" data-bs-toggle="modal" data-bs-target="#assignTaskModal">
            <i class="fa-solid fa-plus me-1.5"></i> Assign Warehouse Task
        </button>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm border-0 mb-3" role="alert">
            <i class="fa-solid fa-circle-check me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm border-0 mb-3" role="alert">
            <i class="fa-solid fa-circle-exclamation me-2"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="inv-table-card">
        <div class="p-3 border-bottom d-flex flex-wrap justify-content-between align-items-center gap-3 bg-light-subtle">
            <div class="d-flex align-items-center gap-2">
                <span class="fw-bold small text-secondary">Active Assigned Tasks:</span>
                <span class="badge bg-primary rounded-pill">@Model.Count</span>
            </div>
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr class="small text-uppercase text-muted">
                        <th>Task Title</th>
                        <th>Assigned Staff Member</th>
                        <th>Priority</th>
                        <th>Due Date</th>
                        <th>Created</th>
                        <th class="text-end">Status</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5 text-muted">
                                <i class="fa-solid fa-list-check fs-2 d-block mb-2"></i>
                                No warehouse tasks assigned yet.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var task in Model)
                        {
                            var exec = teamMembers.FirstOrDefault(t => t.UserId.ToString() == task.AssignedToUserId);
                            var execName = exec?.FullName ?? (!string.IsNullOrEmpty(task.AssignedToUserId) ? task.AssignedToUserId : "All Inventory Staff");
                            var priorityClass = task.Priority == "High" ? "bg-danger-subtle text-danger" : (task.Priority == "Medium" ? "bg-warning-subtle text-warning" : "bg-info-subtle text-info");
                            var statusClass = task.Status == "Completed" ? "bg-success-subtle text-success" : "bg-primary-subtle text-primary";

                            <tr>
                                <td>
                                    <div class="fw-bold text-dark">@task.Title</div>
                                    <div class="text-muted extra-small">@task.Description</div>
                                </td>
                                <td>
                                    <span class="small fw-semibold text-dark">
                                        <i class="fa-regular fa-user me-1 text-primary"></i>@execName
                                    </span>
                                </td>
                                <td>
                                    <span class="badge @priorityClass px-2 py-1 rounded-pill small">@task.Priority</span>
                                </td>
                                <td>
                                    <span class="small font-monospace text-dark">
                                        <i class="fa-regular fa-calendar me-1 text-muted"></i>@(task.DueDate?.ToString("dd MMM yyyy") ?? "N/A")
                                    </span>
                                </td>
                                <td>
                                    <span class="text-muted small">@(task.CreatedAt?.ToString("dd MMM yyyy") ?? "N/A")</span>
                                </td>
                                <td class="text-end">
                                    <span class="badge @statusClass px-2.5 py-1 rounded-pill small fw-bold">@task.Status</span>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- MODAL: ASSIGN TASK -->
<div class="modal fade" id="assignTaskModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 16px;">
            <div class="modal-header bg-dark text-white px-4 py-3">
                <h6 class="modal-title fw-bold">Assign Warehouse / Inventory Task</h6>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form action="@Url.Action("AssignTask", "InventoryDashboard")" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body p-4">
                    <div class="row g-3">
                        <div class="col-md-12">
                            <label class="form-label small fw-bold">Task Title <span class="text-danger">*</span></label>
                            <input type="text" name="Title" class="form-control" required placeholder="e.g. Conduct Physical Stock Audit for Bin A-12" />
                        </div>
                        <div class="col-md-12">
                            <label class="form-label small fw-bold">Description / Instructions</label>
                            <textarea name="Description" class="form-control" rows="2" placeholder="Verify batch barcodes and update scrap count..."></textarea>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">Assign To Staff Member</label>
                            <select name="AssignedToUserId" class="form-select">
                                <option value="">-- All Warehouse Staff --</option>
                                @foreach (var m in teamMembers)
                                {
                                    <option value="@m.UserId">@m.FullName</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">Priority</label>
                            <select name="Priority" class="form-select">
                                <option value="Low">Low</option>
                                <option value="Medium" selected>Medium</option>
                                <option value="High">High</option>
                            </select>
                        </div>
                        <div class="col-md-12">
                            <label class="form-label small fw-bold">Due Date</label>
                            <input type="date" name="DueDate" class="form-control" value="@DateTime.Today.AddDays(7).ToString("yyyy-MM-dd")" />
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light px-4 py-2.5">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary btn-sm fw-bold">Delegate Task</button>
                </div>
            </form>
        </div>
    </div>
</div>

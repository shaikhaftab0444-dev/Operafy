@model List<ERP_System.Models.HierarchicalTask>

@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Warehouse Tasks & Operations";
    var teamMembers = ViewBag.TeamMembers as List<ERP_System.Models.User> ?? new List<ERP_System.Models.User>();
}

<style>
    /* =========================================================
           WAREHOUSE TASKS & OPERATIONS
           Premium ERP UI - Frontend Only
           ========================================================= */

    .warehouse-page {
        --wh-primary: #2563eb;
        --wh-primary-dark: #1d4ed8;
        --wh-primary-soft: #eff6ff;
        --wh-success: #16a34a;
        --wh-success-soft: #f0fdf4;
        --wh-warning: #d97706;
        --wh-warning-soft: #fffbeb;
        --wh-danger: #dc2626;
        --wh-danger-soft: #fef2f2;
        --wh-info: #0891b2;
        --wh-info-soft: #ecfeff;
        --wh-purple: #7c3aed;
        --wh-purple-soft: #f5f3ff;
        --wh-dark: #0f172a;
        --wh-text: #1e293b;
        --wh-muted: #64748b;
        --wh-border: #e2e8f0;
        --wh-bg: #f8fafc;
        --wh-card: #ffffff;
        --wh-radius: 18px;
        --wh-shadow: 0 10px 30px rgba(15, 23, 42, 0.06);
        --wh-shadow-hover: 0 18px 45px rgba(15, 23, 42, 0.10);
        min-height: calc(100vh - 70px);
        padding: 24px 0 40px;
        background: radial-gradient(circle at 5% 0%, rgba(37, 99, 235, 0.055), transparent 25%), radial-gradient(circle at 95% 10%, rgba(124, 58, 237, 0.045), transparent 25%), var(--wh-bg);
    }

    .bg-purple {
        background-color: #7c3aed !important;
    }

    .warehouse-shell {
        max-width: 1600px;
        margin: 0 auto;
        padding: 0 24px;
    }

    /* =========================
           HERO HEADER
           ========================= */

    .warehouse-hero {
        position: relative;
        overflow: hidden;
        border-radius: 24px;
        padding: 28px 30px;
        margin-bottom: 22px;
        color: #fff;
        background: linear-gradient(135deg, #0f172a 0%, #172554 55%, #1e40af 100%);
        box-shadow: 0 18px 45px rgba(15, 23, 42, 0.16);
        isolation: isolate;
        animation: whHeroEnter .65s ease both;
    }

        .warehouse-hero::before {
            content: "";
            position: absolute;
            width: 300px;
            height: 300px;
            right: -100px;
            top: -150px;
            border-radius: 50%;
            background: rgba(96, 165, 250, 0.13);
            z-index: -1;
            animation: whFloat 8s ease-in-out infinite;
        }

        .warehouse-hero::after {
            content: "";
            position: absolute;
            width: 220px;
            height: 220px;
            left: 42%;
            bottom: -180px;
            border-radius: 50%;
            background: rgba(255, 255, 255, 0.045);
            z-index: -1;
        }

    .warehouse-breadcrumb {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 7px;
        margin-bottom: 13px;
        font-size: .76rem;
        color: rgba(255,255,255,.64);
        font-weight: 500;
    }

        .warehouse-breadcrumb a {
            color: rgba(255,255,255,.72);
            text-decoration: none;
            transition: color .2s ease;
        }

            .warehouse-breadcrumb a:hover {
                color: #fff;
            }

        .warehouse-breadcrumb i {
            font-size: .6rem;
            opacity: .55;
        }

    .warehouse-title-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 22px;
    }

    .warehouse-title-area {
        display: flex;
        align-items: center;
        gap: 16px;
        min-width: 0;
    }

    .warehouse-title-icon {
        width: 56px;
        height: 56px;
        flex: 0 0 56px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 17px;
        background: rgba(255,255,255,.12);
        border: 1px solid rgba(255,255,255,.13);
        box-shadow: inset 0 1px 0 rgba(255,255,255,.08);
        backdrop-filter: blur(10px);
        font-size: 1.35rem;
        animation: whIconPulse 3.2s ease-in-out infinite;
    }

    .warehouse-title-area h1 {
        margin: 0;
        font-size: clamp(1.25rem, 2vw, 1.65rem);
        line-height: 1.25;
        font-weight: 750;
        letter-spacing: -.02em;
    }

    .warehouse-title-area p {
        margin: 5px 0 0;
        color: rgba(255,255,255,.66);
        font-size: .83rem;
    }

    .warehouse-live-box {
        display: inline-flex;
        align-items: center;
        gap: 9px;
        padding: 10px 14px;
        border-radius: 12px;
        background: rgba(255,255,255,.08);
        border: 1px solid rgba(255,255,255,.11);
        white-space: nowrap;
        font-size: .75rem;
        font-weight: 650;
        color: rgba(255,255,255,.88);
    }

    .warehouse-live-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: #4ade80;
        box-shadow: 0 0 0 5px rgba(74, 222, 128, .10);
        animation: whLive 2s ease-in-out infinite;
    }

    .warehouse-assign-btn {
        border: 0;
        border-radius: 12px;
        padding: 11px 17px;
        font-size: .8rem;
        font-weight: 700;
        color: #fff;
        background: linear-gradient(135deg, #3b82f6, #2563eb);
        box-shadow: 0 8px 20px rgba(37,99,235,.28);
        transition: transform .22s ease, box-shadow .22s ease, filter .22s ease;
        white-space: nowrap;
    }

        .warehouse-assign-btn:hover {
            color: #fff;
            transform: translateY(-2px);
            box-shadow: 0 12px 26px rgba(37,99,235,.35);
            filter: brightness(1.04);
        }

        .warehouse-assign-btn:active {
            transform: translateY(0);
        }

    /* =========================
           ALERTS
           ========================= */

    .warehouse-alert {
        border-radius: 14px;
        border: 1px solid transparent;
        padding: 13px 16px;
        font-size: .82rem;
        margin-bottom: 18px;
        animation: whSlideDown .45s ease both;
    }

        .warehouse-alert.alert-success {
            background: var(--wh-success-soft);
            border-color: #bbf7d0;
            color: #166534;
        }

        .warehouse-alert.alert-danger {
            background: var(--wh-danger-soft);
            border-color: #fecaca;
            color: #991b1b;
        }

        .warehouse-alert .btn-close {
            font-size: .65rem;
        }

    /* =========================
           QUICK METRICS
           ========================= */

    .warehouse-metrics {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 15px;
        margin-bottom: 20px;
    }

    .warehouse-metric {
        position: relative;
        overflow: hidden;
        min-height: 112px;
        padding: 18px;
        border: 1px solid var(--wh-border);
        border-radius: 16px;
        background: var(--wh-card);
        box-shadow: var(--wh-shadow);
        transition: transform .25s ease, box-shadow .25s ease, border-color .25s ease;
        animation: whCardEnter .55s ease both;
    }

        .warehouse-metric:nth-child(2) {
            animation-delay: .07s;
        }

        .warehouse-metric:nth-child(3) {
            animation-delay: .14s;
        }

        .warehouse-metric:nth-child(4) {
            animation-delay: .21s;
        }

        .warehouse-metric:hover {
            transform: translateY(-4px);
            box-shadow: var(--wh-shadow-hover);
            border-color: #cbd5e1;
        }

        .warehouse-metric::after {
            content: "";
            position: absolute;
            width: 90px;
            height: 90px;
            right: -38px;
            bottom: -45px;
            border-radius: 50%;
            background: var(--wh-primary-soft);
            opacity: .7;
        }

    .warehouse-metric-icon {
        width: 39px;
        height: 39px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 11px;
        margin-bottom: 12px;
        font-size: .92rem;
    }

        .warehouse-metric-icon.blue {
            color: var(--wh-primary);
            background: var(--wh-primary-soft);
        }

        .warehouse-metric-icon.green {
            color: var(--wh-success);
            background: var(--wh-success-soft);
        }

        .warehouse-metric-icon.orange {
            color: var(--wh-warning);
            background: var(--wh-warning-soft);
        }

        .warehouse-metric-icon.purple {
            color: var(--wh-purple);
            background: var(--wh-purple-soft);
        }

    .warehouse-metric-label {
        color: var(--wh-muted);
        font-size: .73rem;
        font-weight: 650;
        margin-bottom: 4px;
    }

    .warehouse-metric-value {
        color: var(--wh-dark);
        font-size: 1.4rem;
        line-height: 1;
        font-weight: 780;
        letter-spacing: -.03em;
    }

    /* =========================
           MAIN TASK CARD
           ========================= */

    .warehouse-task-card {
        overflow: hidden;
        border: 1px solid var(--wh-border);
        border-radius: var(--wh-radius);
        background: var(--wh-card);
        box-shadow: var(--wh-shadow);
        animation: whCardEnter .65s ease .18s both;
    }

    .warehouse-card-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 18px;
        padding: 18px 20px;
        border-bottom: 1px solid var(--wh-border);
        background: linear-gradient(180deg, #ffffff 0%, #fbfdff 100%);
    }

    .warehouse-card-heading {
        display: flex;
        align-items: center;
        gap: 12px;
        min-width: 0;
    }

    .warehouse-section-icon {
        width: 40px;
        height: 40px;
        flex: 0 0 40px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 11px;
        color: var(--wh-primary);
        background: var(--wh-primary-soft);
        border: 1px solid #dbeafe;
    }

    .warehouse-card-title {
        margin: 0;
        color: var(--wh-dark);
        font-size: .94rem;
        font-weight: 760;
    }

    .warehouse-card-subtitle {
        margin: 3px 0 0;
        color: var(--wh-muted);
        font-size: .73rem;
    }

    .warehouse-count {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 7px 10px;
        border-radius: 999px;
        background: var(--wh-primary-soft);
        border: 1px solid #dbeafe;
        color: var(--wh-primary-dark);
        font-size: .72rem;
        font-weight: 750;
        white-space: nowrap;
    }

        .warehouse-count i {
            font-size: .63rem;
        }

    /* =========================
           TABLE
           ========================= */

    .warehouse-table-wrap {
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
    }

    .warehouse-table {
        min-width: 920px;
        margin: 0;
        border-collapse: separate;
        border-spacing: 0;
    }

        .warehouse-table thead th {
            padding: 12px 18px;
            border-bottom: 1px solid var(--wh-border);
            background: #f8fafc;
            color: #64748b;
            font-size: .67rem;
            line-height: 1;
            font-weight: 760;
            letter-spacing: .055em;
            text-transform: uppercase;
            white-space: nowrap;
        }

        .warehouse-table tbody td {
            padding: 15px 18px;
            border-bottom: 1px solid #edf2f7;
            background: #fff;
            vertical-align: middle;
        }

        .warehouse-table tbody tr {
            transition: background .2s ease, transform .2s ease;
            animation: whRowEnter .45s ease both;
        }

            .warehouse-table tbody tr:nth-child(2) {
                animation-delay: .04s;
            }

            .warehouse-table tbody tr:nth-child(3) {
                animation-delay: .08s;
            }

            .warehouse-table tbody tr:nth-child(4) {
                animation-delay: .12s;
            }

            .warehouse-table tbody tr:nth-child(5) {
                animation-delay: .16s;
            }

            .warehouse-table tbody tr:hover td {
                background: #f8fbff;
            }

            .warehouse-table tbody tr:last-child td {
                border-bottom: 0;
            }

    /* Task title */

    .warehouse-task-title {
        display: flex;
        align-items: flex-start;
        gap: 11px;
        min-width: 220px;
    }

    .warehouse-task-symbol {
        width: 34px;
        height: 34px;
        flex: 0 0 34px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-top: 1px;
        border-radius: 9px;
        color: var(--wh-primary);
        background: var(--wh-primary-soft);
        border: 1px solid #dbeafe;
        font-size: .78rem;
        transition: transform .22s ease, background .22s ease;
    }

    .warehouse-table tr:hover .warehouse-task-symbol {
        transform: rotate(-4deg) scale(1.05);
        background: #dbeafe;
    }

    .warehouse-task-name {
        color: var(--wh-dark);
        font-size: .82rem;
        font-weight: 730;
        line-height: 1.4;
    }

    .warehouse-task-description {
        max-width: 340px;
        margin-top: 3px;
        color: var(--wh-muted);
        font-size: .7rem;
        line-height: 1.45;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    /* Staff */

    .warehouse-staff {
        display: inline-flex;
        align-items: center;
        gap: 9px;
        min-width: 170px;
    }

    .warehouse-staff-avatar {
        width: 32px;
        height: 32px;
        flex: 0 0 32px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 10px;
        color: #1d4ed8;
        background: linear-gradient(135deg, #dbeafe, #eff6ff);
        border: 1px solid #bfdbfe;
        font-size: .73rem;
        font-weight: 800;
    }

    .warehouse-staff-name {
        color: var(--wh-text);
        font-size: .76rem;
        font-weight: 650;
        line-height: 1.3;
    }

    .warehouse-staff-label {
        display: block;
        color: #94a3b8;
        font-size: .62rem;
        margin-top: 2px;
    }

    /* Badges */

    .warehouse-badge {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 6px 9px;
        border-radius: 999px;
        font-size: .66rem;
        font-weight: 760;
        border: 1px solid transparent;
        white-space: nowrap;
    }

        .warehouse-badge.priority-high {
            color: #b91c1c;
            background: var(--wh-danger-soft);
            border-color: #fecaca;
        }

        .warehouse-badge.priority-medium {
            color: #a16207;
            background: var(--wh-warning-soft);
            border-color: #fde68a;
        }

        .warehouse-badge.priority-low {
            color: #0e7490;
            background: var(--wh-info-soft);
            border-color: #a5f3fc;
        }

        .warehouse-badge.status-completed {
            color: #15803d;
            background: var(--wh-success-soft);
            border-color: #bbf7d0;
        }

        .warehouse-badge.status-active {
            color: #1d4ed8;
            background: var(--wh-primary-soft);
            border-color: #bfdbfe;
        }

    /* Date */

    .warehouse-date {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        color: var(--wh-text);
        font-size: .73rem;
        font-weight: 620;
        white-space: nowrap;
    }

        .warehouse-date i {
            color: #94a3b8;
            font-size: .72rem;
        }

    .warehouse-created {
        color: #64748b;
        font-size: .71rem;
        font-weight: 550;
        white-space: nowrap;
    }

    /* Empty */

    .warehouse-empty {
        padding: 65px 20px !important;
        text-align: center;
    }

    .warehouse-empty-icon {
        width: 64px;
        height: 64px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 14px;
        border-radius: 18px;
        color: #64748b;
        background: #f8fafc;
        border: 1px solid var(--wh-border);
        font-size: 1.35rem;
    }

    .warehouse-empty-title {
        margin-bottom: 4px;
        color: var(--wh-dark);
        font-size: .9rem;
        font-weight: 740;
    }

    .warehouse-empty-text {
        color: var(--wh-muted);
        font-size: .74rem;
    }

    /* =========================
           MODAL
           ========================= */

    .warehouse-modal .modal-dialog {
        max-width: 650px;
    }

    .warehouse-modal .modal-content {
        overflow: hidden;
        border: 1px solid rgba(226,232,240,.9);
        border-radius: 22px !important;
        box-shadow: 0 30px 80px rgba(15,23,42,.20);
        animation: whModalEnter .28s ease both;
    }

    .warehouse-modal-header {
        position: relative;
        overflow: hidden;
        padding: 21px 24px;
        color: #fff;
        background: linear-gradient(135deg, #0f172a, #172554 60%, #1d4ed8);
    }

        .warehouse-modal-header::after {
            content: "";
            position: absolute;
            width: 170px;
            height: 170px;
            right: -70px;
            top: -90px;
            border-radius: 50%;
            background: rgba(255,255,255,.06);
        }

    .warehouse-modal-title {
        position: relative;
        z-index: 1;
        display: flex;
        align-items: center;
        gap: 11px;
        margin: 0;
        font-size: .95rem;
        font-weight: 750;
    }

    .warehouse-modal-title-icon {
        width: 35px;
        height: 35px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 10px;
        background: rgba(255,255,255,.11);
        border: 1px solid rgba(255,255,255,.12);
        font-size: .8rem;
    }

    .warehouse-modal-header .btn-close {
        position: relative;
        z-index: 2;
        opacity: .9;
    }

    .warehouse-modal-body {
        padding: 25px;
        background: #fff;
    }

    .warehouse-form-group {
        position: relative;
    }

    .warehouse-form-label {
        display: flex;
        align-items: center;
        gap: 5px;
        margin-bottom: 7px;
        color: #334155;
        font-size: .72rem;
        font-weight: 750;
    }

    .warehouse-form-control,
    .warehouse-form-select {
        min-height: 43px;
        border: 1px solid #dbe3ed;
        border-radius: 11px;
        color: #1e293b;
        background-color: #fff;
        font-size: .78rem;
        transition: border-color .2s ease, box-shadow .2s ease, transform .2s ease;
    }

        .warehouse-form-control::placeholder {
            color: #a0aec0;
        }

        .warehouse-form-control:hover,
        .warehouse-form-select:hover {
            border-color: #bfdbfe;
        }

        .warehouse-form-control:focus,
        .warehouse-form-select:focus {
            border-color: var(--wh-primary);
            box-shadow: 0 0 0 4px rgba(37,99,235,.09);
            transform: translateY(-1px);
        }

    textarea.warehouse-form-control {
        min-height: 92px;
        resize: vertical;
    }

    .warehouse-input-wrap {
        position: relative;
    }

    .warehouse-input-icon {
        position: absolute;
        top: 50%;
        left: 13px;
        transform: translateY(-50%);
        color: #94a3b8;
        font-size: .73rem;
        pointer-events: none;
        z-index: 2;
    }

    .warehouse-input-with-icon {
        padding-left: 36px;
    }

    .warehouse-modal-footer {
        display: flex;
        justify-content: flex-end;
        gap: 9px;
        padding: 15px 24px;
        background: #f8fafc;
        border-top: 1px solid var(--wh-border);
    }

    .warehouse-cancel-btn {
        border: 1px solid #dbe3ed;
        border-radius: 10px;
        background: #fff;
        color: #475569;
        font-size: .74rem;
        font-weight: 680;
        padding: 9px 15px;
        transition: all .2s ease;
    }

        .warehouse-cancel-btn:hover {
            color: #1e293b;
            background: #f8fafc;
            border-color: #cbd5e1;
        }

    .warehouse-submit-btn {
        border: 0;
        border-radius: 10px;
        color: #fff;
        background: linear-gradient(135deg, #2563eb, #1d4ed8);
        font-size: .74rem;
        font-weight: 750;
        padding: 9px 17px;
        box-shadow: 0 6px 15px rgba(37,99,235,.22);
        transition: all .2s ease;
    }

        .warehouse-submit-btn:hover {
            color: #fff;
            transform: translateY(-1px);
            box-shadow: 0 9px 20px rgba(37,99,235,.28);
        }

    /* =========================
           RESPONSIVE
           ========================= */

    @@media (max-width: 1200px) {
        .warehouse-metrics {
            grid-template-columns: repeat(2, 1fr);
        }

        .warehouse-title-row {
            align-items: flex-start;
        }
    }

    @@media (max-width: 900px) {
        .warehouse-hero {
            padding: 24px;
        }

        .warehouse-title-row {
            flex-direction: column;
        }

        .warehouse-title-area {
            width: 100%;
        }

        .warehouse-live-box {
            align-self: flex-start;
        }

        .warehouse-card-head {
            align-items: flex-start;
        }
    }

    @@media (max-width: 767.98px) {
        .warehouse-page {
            padding-top: 15px;
        }

        .warehouse-shell {
            padding: 0 12px;
        }

        .warehouse-hero {
            padding: 21px 18px;
            border-radius: 18px;
        }

        .warehouse-title-area {
            align-items: flex-start;
            gap: 11px;
        }

        .warehouse-title-icon {
            width: 46px;
            height: 46px;
            flex-basis: 46px;
            border-radius: 13px;
            font-size: 1.05rem;
        }

        .warehouse-title-area h1 {
            font-size: 1.15rem;
        }

        .warehouse-title-area p {
            font-size: .74rem;
            line-height: 1.45;
        }

        .warehouse-assign-btn {
            width: 100%;
            padding: 11px 14px;
        }

        .warehouse-live-box {
            width: 100%;
            justify-content: center;
        }

        .warehouse-metrics {
            grid-template-columns: 1fr 1fr;
            gap: 10px;
        }

        .warehouse-metric {
            min-height: 100px;
            padding: 14px;
            border-radius: 14px;
        }

        .warehouse-metric-icon {
            width: 34px;
            height: 34px;
            margin-bottom: 9px;
        }

        .warehouse-metric-value {
            font-size: 1.2rem;
        }

        .warehouse-card-head {
            padding: 15px;
        }

        .warehouse-card-heading {
            gap: 9px;
        }

        .warehouse-section-icon {
            width: 36px;
            height: 36px;
            flex-basis: 36px;
        }

        .warehouse-card-title {
            font-size: .84rem;
        }

        .warehouse-card-subtitle {
            font-size: .68rem;
        }

        .warehouse-count {
            padding: 6px 8px;
            font-size: .65rem;
        }

        .warehouse-table {
            min-width: 850px;
        }

            .warehouse-table thead th,
            .warehouse-table tbody td {
                padding-left: 13px;
                padding-right: 13px;
            }

        .warehouse-modal-body {
            padding: 19px;
        }

        .warehouse-modal-footer {
            padding: 13px 19px;
        }
    }

    @@media (max-width: 480px) {
        .warehouse-metrics {
            grid-template-columns: 1fr;
        }

        .warehouse-metric {
            min-height: 92px;
        }

        .warehouse-title-area h1 {
            font-size: 1.05rem;
        }

        .warehouse-breadcrumb {
            font-size: .68rem;
        }

        .warehouse-modal .modal-dialog {
            margin: 10px;
        }

        .warehouse-modal .modal-content {
            border-radius: 17px !important;
        }

        .warehouse-modal-header {
            padding: 17px 18px;
        }

        .warehouse-modal-body {
            padding: 17px;
        }

        .warehouse-modal-footer {
            padding: 12px 17px;
        }
    }

    /* =========================
           ANIMATIONS
           ========================= */

    @@keyframes whHeroEnter {
        from {
            opacity: 0;
            transform: translateY(-12px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@keyframes whCardEnter {
        from {
            opacity: 0;
            transform: translateY(12px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@keyframes whRowEnter {
        from {
            opacity: 0;
            transform: translateX(-8px);
        }

        to {
            opacity: 1;
            transform: translateX(0);
        }
    }

    @@keyframes whSlideDown {
        from {
            opacity: 0;
            transform: translateY(-8px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@keyframes whModalEnter {
        from {
            opacity: 0;
            transform: scale(.97) translateY(8px);
        }

        to {
            opacity: 1;
            transform: scale(1) translateY(0);
        }
    }

    @@keyframes whFloat {
        0%, 100% {
            transform: translate(0, 0);
        }

        50% {
            transform: translate(-15px, 15px);
        }
    }

    @@keyframes whIconPulse {
        0%, 100% {
            transform: translateY(0);
        }

        50% {
            transform: translateY(-2px);
        }
    }

    @@keyframes whLive {
        0%, 100% {
            box-shadow: 0 0 0 4px rgba(74,222,128,.08);
        }

        50% {
            box-shadow: 0 0 0 7px rgba(74,222,128,.02);
        }
    }

    /* =========================
           ACCESSIBILITY
           ========================= */

    @@media (prefers-reduced-motion: reduce) {
        .warehouse-page *,
        .warehouse-page *::before,
        .warehouse-page *::after {
            animation-duration: .01ms !important;
            animation-iteration-count: 1 !important;
            transition-duration: .01ms !important;
        }
    }

    /* =========================
           PRINT
           ========================= */

    @@media print {
        .warehouse-page {
            background: #fff;
            padding: 0;
        }

        .warehouse-hero {
            color: #000;
            background: #fff;
            box-shadow: none;
            border: 1px solid #ddd;
        }

        .warehouse-live-box,
        .warehouse-assign-btn {
            display: none !important;
        }

        .warehouse-task-card,
        .warehouse-metric {
            box-shadow: none;
        }
    }
</style>

<div class="warehouse-page">
    <div class="warehouse-shell">

        <!-- =====================================================
             PREMIUM HERO
             ===================================================== -->
        <div class="warehouse-hero">

            <div class="warehouse-breadcrumb">
                <a href="@Url.Action("Index", "InventoryDashboard")">
                    Inventory Portal
                </a>
                <i class="fa-solid fa-chevron-right"></i>
                <span>Team Operations</span>
                <i class="fa-solid fa-chevron-right"></i>
                <span>Warehouse Tasks</span>
            </div>

            <div class="warehouse-title-row">

                <div class="warehouse-title-area">
                    <div class="warehouse-title-icon">
                        <i class="fa-solid fa-warehouse"></i>
                    </div>

                    <div>
                        <h1>Warehouse & Inventory Task Delegation</h1>
                        <p>
                            Coordinate warehouse operations, staff assignments and inventory activities from one place.
                        </p>
                    </div>
                </div>

                <div class="d-flex flex-wrap align-items-center gap-2">

                    <div class="warehouse-live-box">
                        <span class="warehouse-live-dot"></span>
                        Operations Active
                    </div>

                    <button type="button"
                            class="warehouse-assign-btn"
                            data-bs-toggle="modal"
                            data-bs-target="#assignTaskModal">
                        <i class="fa-solid fa-plus me-1"></i>
                        Assign Warehouse Task
                    </button>

                </div>
            </div>
        </div>

        <!-- =====================================================
             ALERTS
             ===================================================== -->
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show warehouse-alert" role="alert">
                <i class="fa-solid fa-circle-check me-2"></i>
                @TempData["SuccessMessage"]

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="alert"
                        aria-label="Close"></button>
            </div>
        }

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show warehouse-alert" role="alert">
                <i class="fa-solid fa-circle-exclamation me-2"></i>
                @TempData["ErrorMessage"]

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="alert"
                        aria-label="Close"></button>
            </div>
        }

        <!-- =====================================================
             QUICK METRICS
             ===================================================== -->
        <div class="warehouse-metrics">

            <div class="warehouse-metric">
                <div class="warehouse-metric-icon blue">
                    <i class="fa-solid fa-list-check"></i>
                </div>

                <div class="warehouse-metric-label">
                    Active Assigned Tasks
                </div>

                <div class="warehouse-metric-value">
                    @Model.Count
                </div>
            </div>

            <div class="warehouse-metric">
                <div class="warehouse-metric-icon orange">
                    <i class="fa-solid fa-triangle-exclamation"></i>
                </div>

                <div class="warehouse-metric-label">
                    High Priority
                </div>

                <div class="warehouse-metric-value">
                    @Model.Count(x => x.Priority == "High")
                </div>
            </div>

            <div class="warehouse-metric">
                <div class="warehouse-metric-icon green">
                    <i class="fa-solid fa-circle-check"></i>
                </div>

                <div class="warehouse-metric-label">
                    Completed
                </div>

                <div class="warehouse-metric-value">
                    @Model.Count(x => x.Status == "Completed")
                </div>
            </div>

            <div class="warehouse-metric">
                <div class="warehouse-metric-icon purple">
                    <i class="fa-solid fa-users"></i>
                </div>

                <div class="warehouse-metric-label">
                    Available Team Members
                </div>

                <div class="warehouse-metric-value">
                    @teamMembers.Count
                </div>
            </div>

        </div>

        <!-- =====================================================
             MAIN TASK TABLE
             ===================================================== -->
        <div class="warehouse-task-card">

            <div class="warehouse-card-head">

                <div class="warehouse-card-heading">

                    <div class="warehouse-section-icon">
                        <i class="fa-solid fa-clipboard-list"></i>
                    </div>

                    <div>
                        <h2 class="warehouse-card-title">
                            Warehouse Task Queue
                        </h2>

                        <p class="warehouse-card-subtitle">
                            Monitor assignments, priorities, deadlines and operational status.
                        </p>
                    </div>

                </div>

                <div class="warehouse-count">
                    <i class="fa-solid fa-layer-group"></i>
                    @Model.Count Active Tasks
                </div>

            </div>

            <div class="warehouse-table-wrap">

                <table class="table warehouse-table align-middle mb-0">

                    <thead>
                        <tr>
                            <th>Task Title</th>
                            <th>Assigned Staff Member</th>
                            <th>Priority</th>
                            <th>Due Date</th>
                            <th>Created</th>
                            <th class="text-end">Status</th>
                        </tr>
                    </thead>

                    <tbody>

                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="6" class="warehouse-empty">

                                    <div class="warehouse-empty-icon">
                                        <i class="fa-solid fa-box-open"></i>
                                    </div>

                                    <div class="warehouse-empty-title">
                                        No warehouse tasks assigned yet
                                    </div>

                                    <div class="warehouse-empty-text">
                                        Use the Assign Warehouse Task button to create the first operational task.
                                    </div>

                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var task in Model)
                            {
                                var exec = teamMembers.FirstOrDefault(t => t.UserId.ToString() == task.AssignedToUserId);

                                var execName = exec?.FullName
                                ?? (!string.IsNullOrEmpty(task.AssignedToUserId)
                                ? task.AssignedToUserId
                                : "All Inventory Staff");

                                var priorityClass =
                                task.Priority == "High"
                                ? "priority-high"
                                : task.Priority == "Medium"
                                ? "priority-medium"
                                : "priority-low";

                                var statusClass =
                                task.Status == "Completed"
                                ? "status-completed"
                                : "status-active";

                                var priorityIcon =
                                task.Priority == "High"
                                ? "fa-arrow-up"
                                : task.Priority == "Medium"
                                ? "fa-minus"
                                : "fa-arrow-down";

                                var statusIcon =
                                task.Status == "Completed"
                                ? "fa-circle-check"
                                : "fa-clock";

                                var staffInitial =
                                !string.IsNullOrWhiteSpace(execName)
                                ? execName.Substring(0, 1).ToUpper()
                                : "A";

                                <tr>

                                    <!-- TASK -->
                                    <td>

                                        <div class="warehouse-task-title">

                                            <div class="warehouse-task-symbol">
                                                <i class="fa-solid fa-boxes-stacked"></i>
                                            </div>

                                            <div>

                                                <div class="warehouse-task-name">
                                                    @task.Title
                                                </div>

                                                <div class="warehouse-task-description">
                                                    @task.Description
                                                </div>

                                            </div>

                                        </div>

                                    </td>

                                    <!-- STAFF -->
                                    <td>
                                        @if (task.IsGeneralTask)
                                        {
                                            <span class="badge bg-purple text-white px-2 py-1"><i class="fa fa-bullhorn me-1"></i> General Team Task</span>
                                        }
                                        else
                                        {
                                            <div class="warehouse-staff">
                                                <div class="warehouse-staff-avatar">
                                                    @staffInitial
                                                </div>
                                                <div>
                                                    <span class="badge bg-light text-dark border"><i class="fa fa-user me-1"></i> Assigned to: @(task.AssignedToUser?.FullName ?? execName)</span>
                                                    <span class="warehouse-staff-label">
                                                        Assigned operator
                                                    </span>
                                                </div>
                                            </div>
                                        }
                                    </td>

                                    <!-- PRIORITY -->
                                    <td>

                                        <span class="warehouse-badge @priorityClass">
                                            <i class="fa-solid @priorityIcon"></i>
                                            @task.Priority
                                        </span>

                                    </td>

                                    <!-- DUE DATE -->
                                    <td>

                                        <span class="warehouse-date">
                                            <i class="fa-regular fa-calendar-days"></i>
                                            @(task.DueDate?.ToString("dd MMM yyyy") ?? "N/A")
                                        </span>

                                    </td>

                                    <!-- CREATED -->
                                    <td>

                                        <span class="warehouse-created">
                                            @(task.CreatedAt?.ToString("dd MMM yyyy") ?? "N/A")
                                        </span>

                                    </td>

                                    <!-- STATUS -->
                                    <td class="text-end">

                                        <span class="warehouse-badge @statusClass">
                                            <i class="fa-solid @statusIcon"></i>
                                            @task.Status
                                        </span>

                                    </td>

                                </tr>
                            }
                        }

                    </tbody>

                </table>

            </div>
        </div>

    </div>
</div>

<!-- =============================================================
     ASSIGN TASK MODAL
     ============================================================= -->
<div class="modal fade warehouse-modal"
     id="assignTaskModal"
     tabindex="-1"
     aria-labelledby="assignTaskModalLabel"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content">

            <!-- MODAL HEADER -->
            <div class="warehouse-modal-header">

                <div class="d-flex justify-content-between align-items-center gap-3">

                    <h5 class="warehouse-modal-title" id="assignTaskModalLabel">

                        <span class="warehouse-modal-title-icon">
                            <i class="fa-solid fa-clipboard-check"></i>
                        </span>

                        Assign Warehouse / Inventory Task

                    </h5>

                    <button type="button"
                            class="btn-close btn-close-white"
                            data-bs-dismiss="modal"
                            aria-label="Close"></button>

                </div>

            </div>

            <!-- FORM -->
            <form action="@Url.Action("AssignWarehouseTask", "InventoryDashboard")" method="post">

                @Html.AntiForgeryToken()

                <div class="warehouse-modal-body">

                    <div class="row g-3">

                        <!-- OPERATIONAL TEMPLATE -->
                        <div class="col-md-6">

                            <div class="warehouse-form-group">

                                <label class="warehouse-form-label">
                                    <i class="fa-solid fa-layer-group text-primary"></i>
                                    Operational Template
                                </label>

                                <select name="operationalTemplate" id="opTemplateSelect" class="form-select warehouse-form-select">
                                    <option value="Custom Task" selected>Custom Warehouse Task</option>
                                    <option value="Stock Audit / Cycle Count">Stock Audit / Cycle Count</option>
                                    <option value="Bin Replenishment">Bin Replenishment & Put-Away</option>
                                    <option value="Inward Unloading (GRN)">Inward Unloading (GRN)</option>
                                    <option value="Order Packing">Order Picking & Packing</option>
                                    <option value="Quarantine Inspection">Quarantine / QA Inspection</option>
                                </select>

                            </div>

                        </div>

                        <!-- TARGET RACK / BIN LOCATION -->
                        <div class="col-md-6">

                            <div class="warehouse-form-group">

                                <label class="warehouse-form-label">
                                    <i class="fa-solid fa-boxes-stacked text-primary"></i>
                                    Target Location / Bin
                                </label>

                                <div class="warehouse-input-wrap">

                                    <i class="fa-solid fa-location-dot warehouse-input-icon"></i>

                                    <input type="text"
                                           name="targetLocation"
                                           id="rackLocationInput"
                                           class="form-control warehouse-form-control warehouse-input-with-icon"
                                           placeholder="e.g. WH-01 / Rack B-04 / Bin 12" />

                                </div>

                            </div>

                        </div>

                        <!-- TASK TITLE -->
                        <div class="col-12">

                            <div class="warehouse-form-group">

                                <label class="warehouse-form-label">
                                    <i class="fa-solid fa-heading text-primary"></i>
                                    Task Title
                                    <span class="text-danger">*</span>
                                </label>

                                <div class="warehouse-input-wrap">

                                    <i class="fa-solid fa-pen warehouse-input-icon"></i>

                                    <input type="text"
                                           name="taskTitle"
                                           id="taskTitleInput"
                                           class="form-control warehouse-form-control warehouse-input-with-icon"
                                           required
                                           placeholder="e.g. Conduct Physical Stock Audit for Bin A-12" />

                                </div>

                            </div>

                        </div>

                        <!-- DESCRIPTION -->
                        <div class="col-12">

                            <div class="warehouse-form-group">

                                <label class="warehouse-form-label">
                                    <i class="fa-solid fa-align-left text-primary"></i>
                                    Description / Instructions
                                </label>

                                <textarea name="description"
                                          id="taskDescInput"
                                          class="form-control warehouse-form-control"
                                          rows="3"
                                          placeholder="Verify batch barcodes, check SKU quantities, and record notes..."></textarea>

                            </div>

                        </div>

                        <!-- Assignment Scope Toggle -->
                        <div class="col-12">
                            <div class="p-2 bg-light rounded border">
                                <label class="form-label fw-bold d-block mb-2 text-dark" style="font-size: 0.85rem;">
                                    <i class="fa-solid fa-users-gear me-1 text-primary"></i> Assignment Mode
                                </label>
                                <div class="btn-group w-100" role="group">
                                    <input type="radio" class="btn-check" name="assignmentScope" id="scopeIndividual" value="Individual" checked onchange="toggleAssignmentScope()">
                                    <label class="btn btn-outline-primary btn-sm py-2" for="scopeIndividual">
                                        <i class="fa-solid fa-user me-1"></i> Specific Employee
                                    </label>

                                    <input type="radio" class="btn-check" name="assignmentScope" id="scopeGeneral" value="General" onchange="toggleAssignmentScope()">
                                    <label class="btn btn-outline-primary btn-sm py-2" for="scopeGeneral">
                                        <i class="fa-solid fa-bullhorn me-1"></i> General Team Task (All Staff)
                                    </label>
                                </div>
                            </div>
                        </div>

                        <!-- Subordinate Select (Shows/Hides based on scope) -->
                        <div class="col-md-6" id="subordinateSelectContainer">
                            <div class="warehouse-form-group">
                                <label class="warehouse-form-label">
                                    <i class="fa-solid fa-user-check text-primary"></i>
                                    Assign To Subordinate
                                    <span class="text-danger">*</span>
                                </label>
                                <select name="assignedToUserId" id="assignedToUserId" class="form-select warehouse-form-select" required>
                                    <option value="">-- Select Warehouse Staff --</option>
                                    @foreach (var staff in (ViewBag.AvailableSubordinates as List<ERP_System.Models.User> ?? teamMembers))
                                    {
                                        <option value="@staff.Id">@staff.FullName (@staff.RoleName)</option>
                                    }
                                </select>
                            </div>
                        </div>

                        <!-- General Task Info Banner (Hidden by default) -->
                        <div class="col-md-6 d-none" id="generalTaskBanner">
                            <div class="warehouse-form-group">
                                <label class="warehouse-form-label">
                                    <i class="fa-solid fa-bullhorn text-primary"></i>
                                    Audience
                                </label>
                                <div class="alert alert-info py-2 px-3 mb-0 small border-0 d-flex align-items-center" style="min-height: 43px; border-radius: 11px;">
                                    <span><i class="fa-solid fa-circle-info me-1"></i> Visible to all @((ViewBag.AvailableSubordinates as List<ERP_System.Models.User> ?? teamMembers).Count) warehouse team members.</span>
                                </div>
                            </div>
                        </div>

                        <!-- PRIORITY -->
                        <div class="col-md-6">
                            <div class="warehouse-form-group">
                                <label class="warehouse-form-label">
                                    <i class="fa-solid fa-flag text-primary"></i>
                                    Priority
                                </label>
                                <select name="priority" class="form-select warehouse-form-select">
                                    <option value="Low">Low</option>
                                    <option value="Medium" selected>Medium</option>
                                    <option value="High">High</option>
                                    <option value="Critical">Critical</option>
                                </select>
                            </div>
                        </div>

                        <!-- DUE DATE -->
                        <div class="col-12">

                            <div class="warehouse-form-group">

                                <label class="warehouse-form-label">
                                    <i class="fa-regular fa-calendar-days text-primary"></i>
                                    Due Date
                                </label>

                                <div class="warehouse-input-wrap">

                                    <i class="fa-regular fa-calendar warehouse-input-icon"></i>

                                    <input type="date"
                                           name="dueDate"
                                           class="form-control warehouse-form-control warehouse-input-with-icon"
                                           value="@DateTime.Today.AddDays(7).ToString("yyyy-MM-dd")" />

                                </div>

                            </div>

                        </div>

                    </div>

                </div>

                <!-- MODAL FOOTER -->
                <div class="warehouse-modal-footer">

                    <button type="button"
                            class="warehouse-cancel-btn"
                            data-bs-dismiss="modal">
                        Cancel
                    </button>

                    <button type="submit"
                            class="warehouse-submit-btn">
                        <i class="fa-solid fa-paper-plane me-1"></i>
                        Delegate Task
                    </button>

                </div>

            </form>

        </div>

    </div>
</div>

<script>
    function toggleAssignmentScope() {
        const isGeneral = document.getElementById('scopeGeneral')?.checked;
        const subContainer = document.getElementById('subordinateSelectContainer');
        const genBanner = document.getElementById('generalTaskBanner');
        const userSelect = document.getElementById('assignedToUserId');

        if (isGeneral) {
            subContainer?.classList.add('d-none');
            genBanner?.classList.remove('d-none');
            userSelect?.removeAttribute('required');
            if (userSelect) userSelect.value = '';
        } else {
            subContainer?.classList.remove('d-none');
            genBanner?.classList.add('d-none');
            userSelect?.setAttribute('required', 'required');
        }
    }

    document.addEventListener('DOMContentLoaded', function () {
        const opTemplate = document.getElementById('opTemplateSelect');
        const titleInput = document.getElementById('taskTitleInput');
        const descInput = document.getElementById('taskDescInput');
        const locInput = document.getElementById('rackLocationInput');

        if (opTemplate && titleInput && descInput) {
            opTemplate.addEventListener('change', function () {
                const val = this.value;
                if (val === 'Stock Audit / Cycle Count') {
                    titleInput.value = 'Stock Audit & Cycle Count Verification';
                    descInput.value = 'Perform barcode scan and physical count across target rack bins. Flag any variance immediately.';
                    if (locInput && !locInput.value) locInput.value = 'WH-01 / Rack A-01 / Bin 01-10';
                } else if (val === 'Bin Replenishment') {
                    titleInput.value = 'Forward Picking Bin Replenishment';
                    descInput.value = 'Transfer reserve pallet stock to forward picking bins to replenish stock levels for order fulfillment.';
                    if (locInput && !locInput.value) locInput.value = 'WH-01 / Rack B-03 / Bin 04';
                } else if (val === 'Inward Unloading (GRN)') {
                    titleInput.value = 'Inward Shipment Unloading & GRN Inspection';
                    descInput.value = 'Unload supplier consignment, inspect cartons for transit seal integrity, and affix GRN labels.';
                    if (locInput && !locInput.value) locInput.value = 'Dock Receiving Bay 2';
                } else if (val === 'Order Packing') {
                    titleInput.value = 'Dispatch Order Picking & Packing';
                    descInput.value = 'Pick outbound items per picking manifest, verify packing slips, and stage in dispatch holding zone.';
                    if (locInput && !locInput.value) locInput.value = 'Packing Station 3';
                } else if (val === 'Quarantine Inspection') {
                    titleInput.value = 'Quarantine & Damaged Goods Inspection';
                    descInput.value = 'Inspect quarantined return pallets, document defects, and record salvageable units in the inventory ledger.';
                    if (locInput && !locInput.value) locInput.value = 'WH-01 / QA Holding Zone';
                }
            });
        }
    });
</script>
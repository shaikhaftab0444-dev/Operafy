@model ERP_System.Models.BinRackMaster

@{
    Layout = null;
    ViewData["Title"] = $"Barcode Label - {Model.RackCode} / {Model.BinLevel}";
    var barcodeText = $"{Model.Warehouse?.WarehouseCode ?? "WH"}-{Model.RackCode}-{Model.BinLevel}".Replace(" ", "-").ToUpper();
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <style>
        body {
            background-color: #f1f5f9;
            color: #0f172a;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
            margin: 0;
            padding: 30px;
        }

        .label-container {
            width: 480px;
            margin: 0 auto;
            background: #ffffff;
            border: 2px solid #0f172a;
            border-radius: 12px;
            padding: 24px;
            box-shadow: 0 10px 25px rgba(0,0,0,0.08);
            position: relative;
        }

        .rack-large {
            font-size: 32px;
            font-weight: 900;
            letter-spacing: -0.5px;
            line-height: 1;
        }

        .bin-large {
            font-size: 24px;
            font-weight: 700;
            color: #2563eb;
        }

        /* High contrast SVG barcode simulator */
        .barcode-stripes {
            display: flex;
            align-items: stretch;
            justify-content: center;
            height: 60px;
            background: #ffffff;
            margin: 14px 0 6px;
            gap: 2px;
        }

        .b-bar {
            background: #000000;
            height: 100%;
        }

        .w1 { width: 2px; }
        .w2 { width: 4px; }
        .w3 { width: 6px; }
        .s1 { width: 2px; background: transparent; }
        .s2 { width: 4px; background: transparent; }

        @@media print {
            body {
                background: #ffffff;
                padding: 0;
            }
            .label-container {
                box-shadow: none;
                border: 2px solid #000;
                margin: 0;
                page-break-inside: avoid;
                width: 100%;
                max-width: 4.5in;
                height: 2.8in;
            }
            .no-print {
                display: none !important;
            }
        }
    </style>
</head>
<body>

    <div class="text-center mb-4 no-print">
        <button class="btn btn-primary px-4 me-2" onclick="window.print()">
            <i class="fa-solid fa-print me-2"></i> Print Label (Thermal / A4)
        </button>
        <button class="btn btn-outline-secondary px-3" onclick="window.close()">
            Close
        </button>
    </div>

    <div class="label-container">
        <!-- Facility Tag -->
        <div class="d-flex justify-content-between align-items-center border-bottom pb-2 mb-3">
            <div>
                <span class="text-uppercase fw-bold text-muted" style="font-size: 10px; letter-spacing: 0.5px;">STORAGE FACILITY</span>
                <div class="fw-bold text-dark" style="font-size: 13px;">@(Model.Warehouse?.WarehouseName ?? "Central Warehouse")</div>
            </div>
            <div class="text-end">
                <span class="badge bg-dark px-2 py-1 font-monospace" style="font-size: 11px;">@(Model.Warehouse?.WarehouseCode ?? "WH-001")</span>
            </div>
        </div>

        <!-- Coordinates -->
        <div class="row align-items-center mb-2">
            <div class="col-7 border-end">
                <span class="text-muted text-uppercase fw-bold" style="font-size: 10px;">RACK BAY</span>
                <div class="rack-large font-monospace">@Model.RackCode</div>
            </div>
            <div class="col-5 ps-3">
                <span class="text-muted text-uppercase fw-bold" style="font-size: 10px;">LEVEL / SHELF</span>
                <div class="bin-large font-monospace">@Model.BinLevel</div>
            </div>
        </div>

        <!-- Simulated Code-128 Barcode -->
        <div class="barcode-stripes">
            <div class="b-bar w3"></div><div class="s1"></div><div class="b-bar w1"></div><div class="s2"></div>
            <div class="b-bar w2"></div><div class="s1"></div><div class="b-bar w3"></div><div class="s1"></div>
            <div class="b-bar w1"></div><div class="s2"></div><div class="b-bar w2"></div><div class="s1"></div>
            <div class="b-bar w3"></div><div class="s2"></div><div class="b-bar w1"></div><div class="s1"></div>
            <div class="b-bar w2"></div><div class="s1"></div><div class="b-bar w1"></div><div class="s2"></div>
            <div class="b-bar w3"></div><div class="s1"></div><div class="b-bar w2"></div><div class="s2"></div>
            <div class="b-bar w1"></div><div class="s1"></div><div class="b-bar w3"></div><div class="s1"></div>
            <div class="b-bar w2"></div><div class="s2"></div><div class="b-bar w1"></div><div class="s1"></div>
            <div class="b-bar w3"></div><div class="s1"></div><div class="b-bar w2"></div><div class="s2"></div>
            <div class="b-bar w1"></div><div class="s1"></div><div class="b-bar w2"></div><div class="s1"></div>
            <div class="b-bar w3"></div><div class="s2"></div><div class="b-bar w2"></div><div class="s1"></div>
            <div class="b-bar w1"></div><div class="s1"></div><div class="b-bar w3"></div><div class="s2"></div>
            <div class="b-bar w2"></div><div class="s1"></div><div class="b-bar w1"></div><div class="s1"></div>
            <div class="b-bar w3"></div>
        </div>
        <div class="text-center font-monospace fw-bold" style="font-size: 13px; letter-spacing: 2px;">
            *@barcodeText*
        </div>

        <!-- Assigned Item / Capacity Footnote -->
        <div class="border-top pt-2 mt-3 d-flex justify-content-between align-items-center" style="font-size: 11px;">
            <div>
                @if (Model.AssignedItem != null)
                {
                    <span class="fw-bold text-dark">@Model.AssignedItem.ItemName</span>
                    <span class="text-muted font-monospace">(@Model.AssignedItem.SKU)</span>
                }
                else
                {
                    <span class="text-muted fst-italic">Open / Dynamic Allocation</span>
                }
            </div>
            <div class="text-end font-monospace">
                Max: <strong>@Model.MaxCapacityVolume</strong> Units
            </div>
        </div>
    </div>

</body>
</html>

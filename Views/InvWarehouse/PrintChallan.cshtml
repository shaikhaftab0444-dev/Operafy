@model ERP_System.Models.MaterialDispatch

@{
    Layout = null;
    ViewData["Title"] = $"Delivery Challan - {Model.DispatchSlipNo}";
    var totalUnits = Model.LineItems?.Sum(l => l.Quantity) ?? 0;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <style>
        body {
            background-color: #f8fafc;
            color: #1e293b;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
            margin: 0;
            padding: 24px;
        }

        .print-container {
            max-width: 850px;
            margin: 0 auto;
            background: #ffffff;
            padding: 40px;
            border-radius: 12px;
            box-shadow: 0 4px 20px rgba(0,0,0,0.06);
            border: 1px solid #e2e8f0;
        }

        .barcode-box {
            letter-spacing: 4px;
            font-family: "Courier New", Courier, monospace;
            font-weight: 700;
            background: #f1f5f9;
            padding: 6px 14px;
            border-radius: 6px;
            display: inline-block;
            font-size: 13px;
        }

        .table thead th {
            background: #f8fafc;
            color: #475569;
            font-size: 12px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            border-bottom: 2px solid #cbd5e1;
        }

        .table tbody td {
            font-size: 13px;
            border-bottom: 1px solid #e2e8f0;
            vertical-align: middle;
        }

        .signature-box {
            border-top: 1px dashed #94a3b8;
            padding-top: 8px;
            text-align: center;
            font-size: 12px;
            color: #64748b;
            margin-top: 60px;
        }

        @@media print {
            body {
                background: #ffffff;
                padding: 0;
            }
            .print-container {
                box-shadow: none;
                border: none;
                padding: 20px;
                max-width: 100%;
            }
            .no-print {
                display: none !important;
            }
        }
    </style>
</head>
<body>

    <div class="text-center mb-3 no-print">
        <button class="btn btn-primary px-4 me-2" onclick="window.print()">
            <i class="fa-solid fa-print me-2"></i> Print Delivery Challan / Gate Pass
        </button>
        <button class="btn btn-outline-secondary px-3" onclick="window.close()">
            Close
        </button>
    </div>

    <div class="print-container">
        <!-- Header -->
        <div class="d-flex justify-content-between align-items-start border-bottom pb-4 mb-4">
            <div>
                <h2 class="fw-bold text-dark mb-1">OPERAFY ERP</h2>
                <div class="text-muted small">Warehouse Logistics &amp; Outward Distribution</div>
                <div class="text-muted small">Plot 24, Industrial Area, Sector 5, Logistics Hub</div>
            </div>
            <div class="text-end">
                <span class="badge bg-dark fs-6 px-3 py-2 mb-2">MATERIAL OUTWARD CHALLAN</span>
                <div>
                    <span class="barcode-box">|||| | || |||||| | ||||| |||</span>
                </div>
                <div class="fw-bold text-dark mt-1 font-monospace">@Model.DispatchSlipNo</div>
            </div>
        </div>

        <!-- Meta Details -->
        <div class="row g-3 mb-4">
            <div class="col-6">
                <div class="card p-3 border-light-subtle bg-light h-100">
                    <span class="text-muted text-uppercase fw-bold" style="font-size: 11px;">Consignee / Destination Party</span>
                    <h5 class="fw-bold text-dark mt-1 mb-1">@Model.DestinationParty</h5>
                    <div class="small text-muted">Sales Order #: <strong>@(Model.SalesOrderNumber ?? "Direct Order")</strong></div>
                    <div class="small text-muted">Dispatch Date: <strong>@Model.DispatchDate.ToString("dd MMM yyyy, HH:mm")</strong></div>
                    <div class="small text-muted">Status: <span class="badge bg-primary-subtle text-primary">@Model.Status</span></div>
                </div>
            </div>

            <div class="col-6">
                <div class="card p-3 border-light-subtle bg-light h-100">
                    <span class="text-muted text-uppercase fw-bold" style="font-size: 11px;">Carrier &amp; Dispatch Logistics</span>
                    <h5 class="fw-bold text-dark mt-1 mb-1">@Model.CarrierName</h5>
                    <div class="small text-muted">Docket / Tracking #: <strong>@Model.TrackingNumber</strong></div>
                    <div class="small text-muted">E-Way Bill #: <strong>@(Model.EWayBillNumber ?? "Not Applicable")</strong></div>
                    <div class="small text-muted">Dispatch Facility: <strong>@(Model.SourceWarehouse?.WarehouseName ?? "Central WH") (@(Model.SourceWarehouse?.WarehouseCode ?? "WH-001"))</strong></div>
                </div>
            </div>
        </div>

        <!-- Line Items Table -->
        <div class="table-responsive mb-4">
            <table class="table table-bordered align-middle">
                <thead>
                    <tr>
                        <th style="width: 5%;">#</th>
                        <th style="width: 50%;">Item Description &amp; SKU</th>
                        <th style="width: 25%;">Picked Storage Bin</th>
                        <th style="width: 20%;" class="text-center">Dispatch Qty</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        int itemIdx = 1;
                    }
                    @if (Model.LineItems != null && Model.LineItems.Any())
                    {
                        foreach (var item in Model.LineItems)
                        {
                            <tr>
                                <td class="text-center text-muted">@itemIdx.ToString("D2")</td>
                                <td>
                                    <div class="fw-bold text-dark">@(item.CatalogItem?.ItemName ?? "Item #" + item.CatalogItemId)</div>
                                    <small class="text-muted font-monospace">SKU: @(item.CatalogItem?.SKU ?? "N/A")</small>
                                </td>
                                <td>
                                    @if (item.PickedFromBin != null)
                                    {
                                        <span class="font-monospace">@item.PickedFromBin.RackCode / @item.PickedFromBin.BinLevel</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">Dock Buffer</span>
                                    }
                                </td>
                                <td class="text-center fw-bold text-dark fs-6">@item.Quantity</td>
                            </tr>
                            itemIdx++;
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4" class="text-center text-muted py-3">No line items recorded.</td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr class="table-light">
                        <th colspan="3" class="text-end fw-bold">Total Units Outward:</th>
                        <th class="text-center fw-bold text-dark fs-6">@totalUnits</th>
                    </tr>
                </tfoot>
            </table>
        </div>

        <!-- Terms & Security Gate Pass -->
        <div class="p-3 bg-light rounded-3 mb-4" style="font-size: 12px; color: #475569;">
            <strong>Gate Pass Authorization:</strong> The goods listed above have undergone warehouse picking, packing verification, and inventory ledger deduction. Security personnel are authorized to allow carrier exit with the consignments.
        </div>

        <!-- Signatures -->
        <div class="row pt-4">
            <div class="col-3">
                <div class="signature-box">
                    Warehouse Dispatcher
                </div>
            </div>
            <div class="col-3">
                <div class="signature-box">
                    Security Gate Pass Officer
                </div>
            </div>
            <div class="col-3">
                <div class="signature-box">
                    Carrier / Driver Receipt
                </div>
            </div>
            <div class="col-3">
                <div class="signature-box">
                    Receiver / Customer Sign
                </div>
            </div>
        </div>

        <!-- Footer -->
        <div class="text-center text-muted mt-5 border-top pt-3" style="font-size: 11px;">
            Operafy ERP Warehouse Management System &bull; Computer Generated Delivery Challan
        </div>
    </div>

</body>
</html>

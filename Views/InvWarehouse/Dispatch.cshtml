@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Material Dispatch (Outward)";
}

<div class="container-fluid py-4 text-start">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-bold mb-1"><i class="fa-solid fa-truck-ramp-box text-primary me-2"></i>Material Dispatch (Outward)</h4>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0 small">
                    <li class="breadcrumb-item"><a href="/InventoryDashboard" class="text-decoration-none">Inventory Dashboard</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Material Dispatch</li>
                </ol>
            </nav>
        </div>
    </div>

    <!-- Dispatch Listing -->
    <div class="bg-white border rounded-3 p-4 shadow-sm">
        <h5 class="fw-bold mb-3">Outward Dispatch Transactions</h5>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" style="font-size: 0.85rem;">
                <thead class="table-light">
                    <tr>
                        <th>Dispatch Slip No</th>
                        <th>Destination Party</th>
                        <th>Carrier Name</th>
                        <th>Tracking Number</th>
                        <th>Dispatch Date</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td class="fw-bold text-dark">DSP-2026-9041</td>
                        <td>Rahul Enterprises</td>
                        <td>BlueDart Logistics</td>
                        <td><code>BD-6042189</code></td>
                        <td class="text-muted">18 Aug 2026</td>
                        <td><span class="badge bg-success-subtle text-success">Dispatched</span></td>
                    </tr>
                    <tr>
                        <td class="fw-bold text-dark">DSP-2026-9042</td>
                        <td>Mehta Logistics</td>
                        <td>DHL Express</td>
                        <td><code>DHL-8041920</code></td>
                        <td class="text-muted">20 Aug 2026</td>
                        <td><span class="badge bg-info-subtle text-info">Packing</span></td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

@model IEnumerable<ERP_System.Models.WarehouseLocation>

@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Warehouses & Locations";

    var warehouses = Model?.ToList() ?? new List<ERP_System.Models.WarehouseLocation>();
    var totalWarehouses = warehouses.Count;
    var activeWarehouses = warehouses.Count(w => w.IsActive);
    var inactiveWarehouses = warehouses.Count(w => !w.IsActive);
    var totalCapacity = warehouses.Sum(w => w.MaxCapacityUnits);
    var supervisors = ViewBag.Supervisors as List<ERP_System.Models.User> ?? new List<ERP_System.Models.User>();
}

<div class="container-fluid py-4 px-3 px-md-4 warehouse-page">

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-4 shadow-sm mb-4" role="alert">
            <i class="fa-solid fa-circle-check me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-4 shadow-sm mb-4" role="alert">
            <i class="fa-solid fa-triangle-exclamation me-2"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Page Header -->
    <div class="warehouse-header-card mb-4">
        <div class="d-flex flex-column flex-lg-row justify-content-between align-items-start align-items-lg-center gap-4">

            <div class="d-flex align-items-start gap-3">
                <div class="warehouse-page-icon">
                    <i class="fa-solid fa-warehouse"></i>
                </div>

                <div>
                    <nav aria-label="breadcrumb" class="mb-2">
                        <ol class="breadcrumb warehouse-breadcrumb mb-0">
                            <li class="breadcrumb-item">
                                <a href="/InventoryDashboard">
                                    <i class="fa-solid fa-arrow-left me-1"></i>
                                    Inventory Dashboard
                                </a>
                            </li>
                            <li class="breadcrumb-item active" aria-current="page">
                                Warehouses &amp; Locations
                            </li>
                        </ol>
                    </nav>

                    <h2 class="warehouse-page-title mb-2">
                        Warehouses &amp; Locations Master
                    </h2>

                    <p class="warehouse-page-subtitle mb-0">
                        Manage multi-facility warehouse sites, supervisors, layout boundaries, and capacity limits.
                    </p>
                </div>
            </div>

            <div class="d-flex flex-wrap gap-2">
                <a href="/InvWarehouse/Bins" class="btn warehouse-dashboard-btn">
                    <i class="fa-solid fa-boxes-stacked me-2"></i>
                    Rack &amp; Bin Master
                </a>

                <button type="button"
                        class="btn warehouse-primary-btn"
                        data-bs-toggle="modal"
                        data-bs-target="#warehouseModal"
                        onclick="resetWarehouseModal()">
                    <i class="fa-solid fa-plus me-2"></i>
                    Add Warehouse
                </button>
            </div>

        </div>
    </div>

    <!-- Summary Cards -->
    <div class="row g-3 mb-4">

        <div class="col-12 col-md-3">
            <div class="warehouse-summary-card">
                <div>
                    <span class="warehouse-summary-label">TOTAL WAREHOUSES</span>
                    <h3 class="warehouse-summary-value">@totalWarehouses</h3>
                    <span class="warehouse-summary-description">
                        Registered facilities
                    </span>
                </div>

                <div class="warehouse-summary-icon warehouse-icon-blue">
                    <i class="fa-solid fa-warehouse"></i>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-3">
            <div class="warehouse-summary-card">
                <div>
                    <span class="warehouse-summary-label">ACTIVE FACILITIES</span>
                    <h3 class="warehouse-summary-value text-success">@activeWarehouses</h3>
                    <span class="warehouse-summary-description">
                        Operational storage sites
                    </span>
                </div>

                <div class="warehouse-summary-icon warehouse-icon-green">
                    <i class="fa-solid fa-circle-check"></i>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-3">
            <div class="warehouse-summary-card">
                <div>
                    <span class="warehouse-summary-label">INACTIVE LOCATIONS</span>
                    <h3 class="warehouse-summary-value text-danger">@inactiveWarehouses</h3>
                    <span class="warehouse-summary-description">
                        Maintenance or decommissioned
                    </span>
                </div>

                <div class="warehouse-summary-icon warehouse-icon-red">
                    <i class="fa-solid fa-triangle-exclamation"></i>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-3">
            <div class="warehouse-summary-card">
                <div>
                    <span class="warehouse-summary-label">TOTAL CAPACITY</span>
                    <h3 class="warehouse-summary-value text-primary">@totalCapacity.ToString("N0")</h3>
                    <span class="warehouse-summary-description">
                        Total allocated units
                    </span>
                </div>

                <div class="warehouse-summary-icon warehouse-icon-blue">
                    <i class="fa-solid fa-cubes"></i>
                </div>
            </div>
        </div>

    </div>

    <!-- Warehouse Master -->
    <div class="warehouse-content-card">

        <div class="warehouse-content-header">
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3">

                <div class="d-flex align-items-center gap-3">
                    <div class="warehouse-section-icon">
                        <i class="fa-solid fa-list"></i>
                    </div>

                    <div>
                        <h5 class="warehouse-section-title mb-1">
                            Warehouse Directory
                        </h5>

                        <p class="warehouse-section-subtitle mb-0">
                            Comprehensive list of company warehouses, supervisors, and storage configurations.
                        </p>
                    </div>
                </div>

                <div class="warehouse-record-count">
                    <i class="fa-solid fa-database me-1"></i>
                    @totalWarehouses Facilities Registered
                </div>

            </div>
        </div>

        <div class="warehouse-content-body">

            @if (warehouses.Any())
            {
                <div class="table-responsive">
                    <table class="table warehouse-table align-middle mb-0">

                        <thead>
                            <tr>
                                <th class="warehouse-number-column">#</th>
                                <th>Warehouse Code &amp; Type</th>
                                <th>Facility Name</th>
                                <th>Location Address</th>
                                <th>Supervisor</th>
                                <th>Capacity &amp; Bins</th>
                                <th>Status</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>

                        <tbody>
                            @{
                                var warehouseIndex = 1;
                            }

                            @foreach (var w in warehouses)
                            {
                                var binCount = w.StoragePositions?.Count ?? 0;
                                <tr>
                                    <td>
                                        <span class="warehouse-number">
                                            @warehouseIndex.ToString("D2")
                                        </span>
                                    </td>

                                    <td>
                                        <div class="warehouse-code-wrapper">
                                            <div class="warehouse-code-icon">
                                                <i class="fa-solid fa-building"></i>
                                            </div>

                                            <div>
                                                <div class="warehouse-code">
                                                    @w.WarehouseCode
                                                </div>

                                                <span class="badge bg-light text-primary border px-2 py-1 mt-1" style="font-size: 11px;">
                                                    @w.WarehouseType
                                                </span>
                                            </div>
                                        </div>
                                    </td>

                                    <td>
                                        <div class="warehouse-name">
                                            @w.WarehouseName
                                        </div>
                                        <div class="warehouse-name-subtitle">
                                            Storage Facility
                                        </div>
                                    </td>

                                    <td>
                                        <div class="warehouse-location">
                                            <i class="fa-solid fa-location-dot me-2 text-secondary"></i>
                                            <span>@w.LocationAddress</span>
                                        </div>
                                    </td>

                                    <td>
                                        <div class="d-flex align-items-center gap-2">
                                            <div class="bg-primary-subtle text-primary rounded-circle d-flex align-items-center justify-content-center" style="width: 32px; height: 32px; font-weight: 700; font-size: 12px;">
                                                @(string.IsNullOrEmpty(w.Supervisor?.UserName) ? "U" : w.Supervisor.UserName.Substring(0, 1).ToUpper())
                                            </div>
                                            <div>
                                                <div class="fw-semibold text-dark" style="font-size: 13px;">
                                                    @(w.Supervisor?.FullName ?? w.Supervisor?.UserName ?? w.SupervisorUserId ?? "Unassigned")
                                                </div>
                                                <small class="text-muted" style="font-size: 11px;">Supervisor</small>
                                            </div>
                                        </div>
                                    </td>

                                    <td>
                                        <div>
                                            <span class="fw-bold text-dark">@w.MaxCapacityUnits.ToString("N0")</span>
                                            <span class="text-muted" style="font-size: 12px;">Units</span>
                                        </div>
                                        <div class="text-muted small mt-1">
                                            <i class="fa-solid fa-boxes-stacked me-1 text-primary"></i>
                                            @binCount configured bins
                                        </div>
                                    </td>

                                    <td>
                                        @if (w.IsActive)
                                        {
                                            <span class="warehouse-status-badge warehouse-status-active">
                                                <span class="warehouse-status-dot"></span>
                                                Active
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="warehouse-status-badge warehouse-status-inactive">
                                                <span class="warehouse-status-dot"></span>
                                                Inactive
                                            </span>
                                        }
                                    </td>

                                    <td class="text-end">
                                        <div class="d-flex justify-content-end gap-1">
                                            <a href="/InvWarehouse/Bins?warehouseId=@w.Id" class="btn btn-sm btn-light text-primary border" title="View Bins">
                                                <i class="fa-solid fa-boxes-stacked"></i>
                                            </a>
                                            <button type="button"
                                                    class="btn btn-sm btn-light text-secondary border"
                                                    title="Edit Facility"
                                                    onclick="editWarehouse(@w.Id, '@w.WarehouseCode', '@Html.Raw(Html.Encode(w.WarehouseName))', '@w.WarehouseType', '@Html.Raw(Html.Encode(w.LocationAddress))', '@(w.SupervisorId?.ToString() ?? "")', @w.MaxCapacityUnits, @(w.IsActive ? "true" : "false"))">
                                                <i class="fa-solid fa-pen-to-square"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>

                                warehouseIndex++;
                            }
                        </tbody>

                    </table>
                </div>
            }
            else
            {
                <div class="warehouse-empty-state">
                    <div class="warehouse-empty-icon">
                        <i class="fa-solid fa-warehouse"></i>
                    </div>

                    <h5 class="warehouse-empty-title">
                        No Warehouses Found
                    </h5>

                    <p class="warehouse-empty-description mb-3">
                        No warehouse locations were found in the database.
                    </p>

                    <button type="button"
                            class="btn warehouse-primary-btn"
                            data-bs-toggle="modal"
                            data-bs-target="#warehouseModal"
                            onclick="resetWarehouseModal()">
                        <i class="fa-solid fa-plus me-2"></i>
                        Add First Warehouse
                    </button>
                </div>
            }

        </div>

        <div class="warehouse-content-footer">
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-2">
                <span>
                    <i class="fa-solid fa-circle-info me-1"></i>
                    Storage position availability automatically recalculates as bin items update.
                </span>

                <span>
                    Total: <strong>@totalWarehouses</strong> facilities
                </span>
            </div>
        </div>

    </div>

</div>

<!-- Warehouse Modal -->
<div class="modal fade warehouse-modal-wrapper"
     id="warehouseModal"
     tabindex="-1"
     aria-labelledby="warehouseModalLabel"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content warehouse-modal-content">

            <form action="/InvWarehouse/SaveWarehouse" method="post" id="warehouseForm">
                @Html.AntiForgeryToken()
                <input type="hidden" id="whId" name="Id" value="0" />

                <div class="warehouse-modal-header">
                    <div class="d-flex align-items-center gap-3">
                        <div class="warehouse-modal-icon">
                            <i class="fa-solid fa-warehouse"></i>
                        </div>

                        <div>
                            <h5 class="warehouse-modal-title mb-1" id="warehouseModalLabel">
                                Add Warehouse Location
                            </h5>

                            <p class="warehouse-modal-subtitle mb-0">
                                Register a new inventory storage location or distribution facility.
                            </p>
                        </div>
                    </div>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal"
                            aria-label="Close"></button>
                </div>

                <div class="warehouse-modal-body">

                    <div class="row g-3">
                        <div class="col-md-6">
                            <div class="warehouse-form-group">
                                <label class="warehouse-form-label" for="whCode">
                                    Warehouse Code <span class="text-danger">*</span>
                                </label>
                                <div class="warehouse-input-wrapper">
                                    <i class="fa-solid fa-barcode"></i>
                                    <input type="text"
                                           id="whCode"
                                           name="WarehouseCode"
                                           class="form-control warehouse-form-control"
                                           placeholder="e.g. WH-001"
                                           required />
                                </div>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="warehouse-form-group">
                                <label class="warehouse-form-label" for="whType">
                                    Facility Type <span class="text-danger">*</span>
                                </label>
                                <select id="whType" name="WarehouseType" class="form-select warehouse-form-control" style="padding-left: 14px;" required>
                                    <option value="Finished Goods">Finished Goods</option>
                                    <option value="Raw Materials">Raw Materials</option>
                                    <option value="Transit Hub">Transit Hub</option>
                                    <option value="Cold Storage">Cold Storage</option>
                                    <option value="Quarantine / Return">Quarantine / Return</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <div class="warehouse-form-group">
                        <label class="warehouse-form-label" for="whName">
                            Warehouse Name <span class="text-danger">*</span>
                        </label>
                        <div class="warehouse-input-wrapper">
                            <i class="fa-solid fa-building"></i>
                            <input type="text"
                                   id="whName"
                                   name="WarehouseName"
                                   class="form-control warehouse-form-control"
                                   placeholder="e.g. Main Central Warehouse"
                                   required />
                        </div>
                    </div>

                    <div class="warehouse-form-group">
                        <label class="warehouse-form-label" for="whAddress">
                            Physical Address <span class="text-danger">*</span>
                        </label>
                        <div class="warehouse-input-wrapper warehouse-textarea-wrapper">
                            <i class="fa-solid fa-location-dot"></i>
                            <textarea id="whAddress"
                                      name="LocationAddress"
                                      class="form-control warehouse-form-control warehouse-textarea"
                                      rows="3"
                                      placeholder="e.g. Plot 24, Industrial Area, Sector 5, Mumbai"
                                      required></textarea>
                        </div>
                    </div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <div class="warehouse-form-group">
                                <label class="warehouse-form-label" for="whSupervisor">
                                    Assigned Supervisor
                                </label>
                                <select id="whSupervisor" name="SupervisorId" class="form-select warehouse-form-control" style="padding-left: 14px;">
                                    <option value="">-- Select Supervisor --</option>
                                    @foreach (var s in supervisors)
                                    {
                                        <option value="@s.UserId">@(s.FullName ?? s.UserName) (@(s.Role?.RoleName ?? "Staff"))</option>
                                    }
                                </select>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="warehouse-form-group">
                                <label class="warehouse-form-label" for="whCapacity">
                                    Max Capacity (Units)
                                </label>
                                <div class="warehouse-input-wrapper">
                                    <i class="fa-solid fa-cubes"></i>
                                    <input type="number"
                                           id="whCapacity"
                                           name="MaxCapacityUnits"
                                           class="form-control warehouse-form-control"
                                           placeholder="5000"
                                           value="5000"
                                           min="10" />
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="form-check form-switch mt-2">
                        <input class="form-check-input" type="checkbox" role="switch" id="whIsActive" name="IsActive" value="true" checked>
                        <label class="form-check-label fw-semibold text-dark" for="whIsActive" style="font-size: 13px;">Facility is Active &amp; Operational</label>
                    </div>

                </div>

                <div class="warehouse-modal-footer">
                    <button type="button"
                            class="btn warehouse-cancel-btn"
                            data-bs-dismiss="modal">
                        Cancel
                    </button>

                    <button type="submit"
                            class="btn warehouse-save-btn">
                        <i class="fa-solid fa-floppy-disk me-2"></i>
                        Save Warehouse
                    </button>
                </div>

            </form>

        </div>
    </div>
</div>

<script>
    function resetWarehouseModal() {
        document.getElementById('warehouseModalLabel').innerText = 'Add Warehouse Location';
        document.getElementById('whId').value = '0';
        document.getElementById('whCode').value = '';
        document.getElementById('whCode').removeAttribute('readonly');
        document.getElementById('whName').value = '';
        document.getElementById('whType').value = 'Finished Goods';
        document.getElementById('whAddress').value = '';
        document.getElementById('whSupervisor').value = '';
        document.getElementById('whCapacity').value = '5000';
        document.getElementById('whIsActive').checked = true;
    }

    function editWarehouse(id, code, name, type, address, supervisorId, capacity, isActive) {
        document.getElementById('warehouseModalLabel').innerText = 'Edit Warehouse Facility';
        document.getElementById('whId').value = id;
        document.getElementById('whCode').value = code;
        document.getElementById('whCode').setAttribute('readonly', 'readonly');
        document.getElementById('whName').value = name;
        document.getElementById('whType').value = type || 'Finished Goods';
        document.getElementById('whAddress').value = address;
        document.getElementById('whSupervisor').value = supervisorId || '';
        document.getElementById('whCapacity').value = capacity || 5000;
        document.getElementById('whIsActive').checked = isActive;

        var myModal = new bootstrap.Modal(document.getElementById('warehouseModal'));
        myModal.show();
    }
</script>

<style>
    .warehouse-page {
        color: #2e384d;
        background-color: #f7f9fc;
    }

    .warehouse-header-card {
        padding: 28px 30px;
        background: #ffffff;
        border: 1px solid #e3e8ef;
        border-radius: 20px;
        box-shadow: 0 8px 25px rgba(31, 45, 61, 0.035);
    }

    .warehouse-page-icon {
        width: 54px;
        height: 54px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #2563eb;
        background: #edf4ff;
        border-radius: 16px;
        font-size: 22px;
        flex-shrink: 0;
    }

    .warehouse-breadcrumb {
        font-size: 13px;
    }

        .warehouse-breadcrumb .breadcrumb-item a {
            color: #6c7a91;
            text-decoration: none;
            font-weight: 500;
        }

            .warehouse-breadcrumb .breadcrumb-item a:hover {
                color: #2563eb;
            }

        .warehouse-breadcrumb .breadcrumb-item.active {
            color: #243046;
            font-weight: 600;
        }

    .warehouse-page-title {
        color: #172338;
        font-size: 28px;
        font-weight: 750;
        letter-spacing: -0.6px;
        line-height: 1.15;
    }

    .warehouse-page-subtitle {
        color: #728197;
        font-size: 14px;
        line-height: 1.6;
    }

    .warehouse-dashboard-btn,
    .warehouse-primary-btn {
        min-height: 44px;
        padding: 10px 18px;
        border-radius: 12px;
        font-size: 13px;
        font-weight: 650;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        transition: all 0.2s ease;
    }

    .warehouse-dashboard-btn {
        color: #4b5b76;
        background: #ffffff;
        border: 1px solid #dce3ec;
    }

        .warehouse-dashboard-btn:hover {
            color: #202b3c;
            background: #f8fafc;
            border-color: #cbd5e1;
        }

    .warehouse-primary-btn {
        color: #ffffff;
        background: linear-gradient(135deg, #2563eb, #315ee8);
        border: none;
        box-shadow: 0 8px 18px rgba(37, 99, 235, 0.18);
    }

        .warehouse-primary-btn:hover {
            color: #ffffff;
            background: linear-gradient(135deg, #1d4ed8, #4338ca);
            transform: translateY(-1px);
            box-shadow: 0 10px 22px rgba(37, 99, 235, 0.24);
        }

    .warehouse-summary-card {
        position: relative;
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        min-height: 145px;
        padding: 25px 20px;
        overflow: hidden;
        background: #ffffff;
        border: 1px solid #e4e9f0;
        border-radius: 18px;
        box-shadow: 0 7px 20px rgba(31, 45, 61, 0.035);
    }

        .warehouse-summary-card::after {
            content: "";
            position: absolute;
            top: -35px;
            right: -35px;
            width: 105px;
            height: 105px;
            background: #f7f9fc;
            border-radius: 50%;
        }

        .warehouse-summary-card > div {
            position: relative;
            z-index: 1;
        }

    .warehouse-summary-label {
        display: block;
        margin-bottom: 12px;
        color: #6b7d97;
        font-size: 11px;
        font-weight: 750;
        letter-spacing: 0.7px;
    }

    .warehouse-summary-value {
        margin-bottom: 6px;
        color: #1d2940;
        font-size: 26px;
        font-weight: 750;
        letter-spacing: -0.8px;
    }

    .warehouse-summary-description {
        color: #9aa9bd;
        font-size: 12px;
    }

    .warehouse-summary-icon {
        width: 43px;
        height: 43px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 13px;
        font-size: 17px;
    }

    .warehouse-icon-blue {
        color: #2563eb;
        background: #edf4ff;
    }

    .warehouse-icon-green {
        color: #16a05d;
        background: #eafaf1;
    }

    .warehouse-icon-red {
        color: #dc2626;
        background: #fff0f0;
    }

    .warehouse-content-card {
        overflow: hidden;
        background: #ffffff;
        border: 1px solid #e3e8ef;
        border-radius: 20px;
        box-shadow: 0 8px 25px rgba(31, 45, 61, 0.035);
    }

    .warehouse-content-header {
        padding: 23px 25px;
        border-bottom: 1px solid #edf0f5;
    }

    .warehouse-section-icon {
        width: 40px;
        height: 40px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #3b5998;
        background: #f1f4fa;
        border-radius: 12px;
        font-size: 15px;
    }

    .warehouse-section-title {
        color: #1a273e;
        font-size: 16px;
        font-weight: 750;
    }

    .warehouse-section-subtitle {
        color: #8c9cb2;
        font-size: 13px;
    }

    .warehouse-record-count {
        padding: 7px 13px;
        color: #485974;
        background: #f6f8fb;
        border: 1px solid #e6ebf2;
        border-radius: 10px;
        font-size: 12px;
        font-weight: 650;
    }

    .warehouse-content-body {
        padding: 0;
    }

    .warehouse-table {
        margin-bottom: 0;
    }

        .warehouse-table thead th {
            padding: 16px 20px;

@model IEnumerable<ERP_System.Models.InvWarehouse>
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Warehouses & Locations";
}

<div class="container-fluid py-4 text-start">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-bold mb-1"><i class="fa-solid fa-warehouse text-primary me-2"></i>Warehouses & Locations</h4>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0 small">
                    <li class="breadcrumb-item"><a href="/InventoryDashboard" class="text-decoration-none">Inventory Dashboard</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Warehouses</li>
                </ol>
            </nav>
        </div>
        <button class="btn btn-primary rounded-pill px-3 btn-sm shadow-sm" data-bs-toggle="modal" data-bs-target="#warehouseModal">
            <i class="fa-solid fa-plus me-1.5"></i>Add Warehouse
        </button>
    </div>

    <!-- Warehouses Grid -->
    <div class="bg-white border rounded-3 p-4 shadow-sm">
        <h5 class="fw-bold mb-3">Warehouse Master</h5>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" style="font-size: 0.85rem;">
                <thead class="table-light">
                    <tr>
                        <th>Warehouse Code</th>
                        <th>Warehouse Name</th>
                        <th>Location Address</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var w in Model)
                        {
                            <tr>
                                <td class="fw-bold text-dark">@w.Code</td>
                                <td>@w.Name</td>
                                <td class="text-muted">@w.Location</td>
                                <td>
                                    @if (w.IsActive)
                                    {
                                        <span class="badge bg-success-subtle text-success rounded-pill px-2.5 py-1">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger-subtle text-danger rounded-pill px-2.5 py-1">Inactive</span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4" class="text-center py-4 text-muted">No warehouses found in database.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Warehouse Modal -->
<div class="modal fade text-start" id="warehouseModal" tabindex="-1" aria-labelledby="warehouseModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form action="/InvWarehouse/CreateLocation" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title fw-bold" id="warehouseModalLabel">Add Warehouse Location</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Warehouse Code</label>
                        <input type="text" name="Code" class="form-control" placeholder="e.g. WH-003" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Warehouse Name</label>
                        <input type="text" name="Name" class="form-control" placeholder="e.g. South Logistics Depot" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Location / Address</label>
                        <textarea name="Location" class="form-control" rows="3" placeholder="e.g. Plot 18, Phase 2, Industrial Area" required></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary rounded-pill px-3 btn-sm" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary rounded-pill px-3 btn-sm">Save Warehouse</button>
                </div>
            </form>
        </div>
    </div>
</div>

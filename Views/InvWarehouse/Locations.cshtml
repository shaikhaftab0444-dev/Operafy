@model IEnumerable<ERP_System.Models.InvWarehouse>

@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Warehouses & Locations";

    var warehouses = Model?.ToList() ?? new List<ERP_System.Models.InvWarehouse>();
    var totalWarehouses = warehouses.Count;
    var activeWarehouses = warehouses.Count(w => w.IsActive);
    var inactiveWarehouses = warehouses.Count(w => !w.IsActive);
}

<div class="container-fluid py-4 px-3 px-md-4 warehouse-page">

    <!-- Page Header -->
    <div class="warehouse-header-card mb-4">
        <div class="d-flex flex-column flex-lg-row justify-content-between align-items-start align-items-lg-center gap-4">

            <div class="d-flex align-items-start gap-3">
                <div class="warehouse-page-icon">
                    <i class="fa-solid fa-warehouse"></i>
                </div>

                <div>
                    <nav aria-label="breadcrumb" class="mb-2">
                        <ol class="breadcrumb warehouse-breadcrumb mb-0">
                            <li class="breadcrumb-item">
                                <a href="/InventoryDashboard">
                                    <i class="fa-solid fa-arrow-left me-1"></i>
                                    Inventory Dashboard
                                </a>
                            </li>
                            <li class="breadcrumb-item active" aria-current="page">
                                Warehouses
                            </li>
                        </ol>
                    </nav>

                    <h2 class="warehouse-page-title mb-2">
                        Warehouses &amp; Locations
                    </h2>

                    <p class="warehouse-page-subtitle mb-0">
                        Manage warehouse locations, storage facilities, and inventory distribution points.
                    </p>
                </div>
            </div>

            <div class="d-flex flex-wrap gap-2">
                <a href="/InventoryDashboard" class="btn warehouse-dashboard-btn">
                    <i class="fa-solid fa-chart-pie me-2"></i>
                    Dashboard
                </a>

                <button type="button"
                        class="btn warehouse-primary-btn"
                        data-bs-toggle="modal"
                        data-bs-target="#warehouseModal">
                    <i class="fa-solid fa-plus me-2"></i>
                    Add Warehouse
                </button>
            </div>

        </div>
    </div>

    <!-- Summary Cards -->
    <div class="row g-3 mb-4">

        <div class="col-12 col-md-4">
            <div class="warehouse-summary-card">
                <div>
                    <span class="warehouse-summary-label">TOTAL WAREHOUSES</span>
                    <h3 class="warehouse-summary-value">@totalWarehouses</h3>
                    <span class="warehouse-summary-description">
                        Registered storage locations
                    </span>
                </div>

                <div class="warehouse-summary-icon warehouse-icon-blue">
                    <i class="fa-solid fa-warehouse"></i>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-4">
            <div class="warehouse-summary-card">
                <div>
                    <span class="warehouse-summary-label">ACTIVE LOCATIONS</span>
                    <h3 class="warehouse-summary-value text-success">@activeWarehouses</h3>
                    <span class="warehouse-summary-description">
                        Warehouses currently operational
                    </span>
                </div>

                <div class="warehouse-summary-icon warehouse-icon-green">
                    <i class="fa-solid fa-circle-check"></i>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-4">
            <div class="warehouse-summary-card">
                <div>
                    <span class="warehouse-summary-label">INACTIVE LOCATIONS</span>
                    <h3 class="warehouse-summary-value text-danger">@inactiveWarehouses</h3>
                    <span class="warehouse-summary-description">
                        Locations requiring review
                    </span>
                </div>

                <div class="warehouse-summary-icon warehouse-icon-red">
                    <i class="fa-solid fa-location-dot"></i>
                </div>
            </div>
        </div>

    </div>

    <!-- Warehouse Master -->
    <div class="warehouse-content-card">

        <div class="warehouse-content-header">
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3">

                <div class="d-flex align-items-center gap-3">
                    <div class="warehouse-section-icon">
                        <i class="fa-solid fa-list"></i>
                    </div>

                    <div>
                        <h5 class="warehouse-section-title mb-1">
                            Warehouse Master
                        </h5>

                        <p class="warehouse-section-subtitle mb-0">
                            View and manage all registered warehouse locations.
                        </p>
                    </div>
                </div>

                <div class="warehouse-record-count">
                    <i class="fa-solid fa-database me-1"></i>
                    @totalWarehouses Locations
                </div>

            </div>
        </div>

        <div class="warehouse-content-body">

            @if (warehouses.Any())
            {
                <div class="table-responsive">
                    <table class="table warehouse-table align-middle mb-0">

                        <thead>
                            <tr>
                                <th class="warehouse-number-column">#</th>
                                <th>Warehouse Code</th>
                                <th>Warehouse Name</th>
                                <th>Location Address</th>
                                <th>Status</th>
                            </tr>
                        </thead>

                        <tbody>
                            @{
                                var warehouseIndex = 1;
                            }

                            @foreach (var w in warehouses)
                            {
                                <tr>
                                    <td>
                                        <span class="warehouse-number">
                                            @warehouseIndex.ToString("D2")
                                        </span>
                                    </td>

                                    <td>
                                        <div class="warehouse-code-wrapper">
                                            <div class="warehouse-code-icon">
                                                <i class="fa-solid fa-building"></i>
                                            </div>

                                            <div>
                                                <div class="warehouse-code">
                                                    @w.Code
                                                </div>

                                                <div class="warehouse-code-subtitle">
                                                    Warehouse code
                                                </div>
                                            </div>
                                        </div>
                                    </td>

                                    <td>
                                        <div class="warehouse-name">
                                            @w.Name
                                        </div>

                                        <div class="warehouse-name-subtitle">
                                            Storage facility
                                        </div>
                                    </td>

                                    <td>
                                        <div class="warehouse-location">
                                            <i class="fa-solid fa-location-dot me-2"></i>
                                            <span>@w.Location</span>
                                        </div>
                                    </td>

                                    <td>
                                        @if (w.IsActive)
                                        {
                                            <span class="warehouse-status-badge warehouse-status-active">
                                                <span class="warehouse-status-dot"></span>
                                                Active
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="warehouse-status-badge warehouse-status-inactive">
                                                <span class="warehouse-status-dot"></span>
                                                Inactive
                                            </span>
                                        }
                                    </td>
                                </tr>

                                warehouseIndex++;
                            }
                        </tbody>

                    </table>
                </div>
            }
            else
            {
                <div class="warehouse-empty-state">
                    <div class="warehouse-empty-icon">
                        <i class="fa-solid fa-warehouse"></i>
                    </div>

                    <h5 class="warehouse-empty-title">
                        No Warehouses Found
                    </h5>

                    <p class="warehouse-empty-description mb-3">
                        No warehouse locations were found in the database.
                    </p>

                    <button type="button"
                            class="btn warehouse-primary-btn"
                            data-bs-toggle="modal"
                            data-bs-target="#warehouseModal">
                        <i class="fa-solid fa-plus me-2"></i>
                        Add First Warehouse
                    </button>
                </div>
            }

        </div>

        <div class="warehouse-content-footer">
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-2">
                <span>
                    <i class="fa-solid fa-circle-info me-1"></i>
                    Warehouse information is based on registered locations.
                </span>

                <span>
                    Total: <strong>@totalWarehouses</strong>
                </span>
            </div>
        </div>

    </div>

</div>

<!-- Warehouse Modal -->
<div class="modal fade warehouse-modal-wrapper"
     id="warehouseModal"
     tabindex="-1"
     aria-labelledby="warehouseModalLabel"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content warehouse-modal-content">

            <form action="/InvWarehouse/CreateLocation" method="post">
                @Html.AntiForgeryToken()

                <div class="warehouse-modal-header">
                    <div class="d-flex align-items-center gap-3">
                        <div class="warehouse-modal-icon">
                            <i class="fa-solid fa-warehouse"></i>
                        </div>

                        <div>
                            <h5 class="warehouse-modal-title mb-1" id="warehouseModalLabel">
                                Add Warehouse Location
                            </h5>

                            <p class="warehouse-modal-subtitle mb-0">
                                Register a new inventory storage location.
                            </p>
                        </div>
                    </div>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal"
                            aria-label="Close"></button>
                </div>

                <div class="warehouse-modal-body">

                    <div class="warehouse-form-group">
                        <label class="warehouse-form-label" for="warehouseCode">
                            Warehouse Code
                            <span class="text-danger">*</span>
                        </label>

                        <div class="warehouse-input-wrapper">
                            <i class="fa-solid fa-barcode"></i>
                            <input type="text"
                                   id="warehouseCode"
                                   name="Code"
                                   class="form-control warehouse-form-control"
                                   placeholder="e.g. WH-003"
                                   required />
                        </div>
                    </div>

                    <div class="warehouse-form-group">
                        <label class="warehouse-form-label" for="warehouseName">
                            Warehouse Name
                            <span class="text-danger">*</span>
                        </label>

                        <div class="warehouse-input-wrapper">
                            <i class="fa-solid fa-building"></i>
                            <input type="text"
                                   id="warehouseName"
                                   name="Name"
                                   class="form-control warehouse-form-control"
                                   placeholder="e.g. South Logistics Depot"
                                   required />
                        </div>
                    </div>

                    <div class="warehouse-form-group mb-0">
                        <label class="warehouse-form-label" for="warehouseLocation">
                            Location / Address
                            <span class="text-danger">*</span>
                        </label>

                        <div class="warehouse-input-wrapper warehouse-textarea-wrapper">
                            <i class="fa-solid fa-location-dot"></i>
                            <textarea id="warehouseLocation"
                                      name="Location"
                                      class="form-control warehouse-form-control warehouse-textarea"
                                      rows="3"
                                      placeholder="e.g. Plot 18, Phase 2, Industrial Area"
                                      required></textarea>
                        </div>
                    </div>

                </div>

                <div class="warehouse-modal-footer">
                    <button type="button"
                            class="btn warehouse-cancel-btn"
                            data-bs-dismiss="modal">
                        Cancel
                    </button>

                    <button type="submit" class="btn warehouse-save-btn">
                        <i class="fa-solid fa-check me-2"></i>
                        Save Warehouse
                    </button>
                </div>

            </form>

        </div>
    </div>
</div>

<style>
    .warehouse-page {
        background: #f4f7fb;
        min-height: calc(100vh - 80px);
    }

    .warehouse-header-card {
        position: relative;
        overflow: hidden;
        padding: 30px;
        background: #ffffff;
        border: 1px solid #e3e8ef;
        border-radius: 22px;
        box-shadow: 0 8px 25px rgba(31, 45, 61, 0.04);
    }

        .warehouse-header-card::before {
            content: "";
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 4px;
            background: linear-gradient(90deg, #1677ff, #635bff);
        }

    .warehouse-page-icon {
        width: 58px;
        height: 58px;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #ffffff;
        background: linear-gradient(135deg, #2878f0, #4f46e5);
        border-radius: 16px;
        font-size: 23px;
        box-shadow: 0 10px 22px rgba(37, 99, 235, 0.2);
    }

    .warehouse-breadcrumb {
        font-size: 13px;
        color: #8a9ab3;
    }

        .warehouse-breadcrumb a {
            color: #71819a;
            text-decoration: none;
            transition: color 0.2s ease;
        }

            .warehouse-breadcrumb a:hover {
                color: #2563eb;
            }

        .warehouse-breadcrumb .breadcrumb-item + .breadcrumb-item::before {
            color: #b5c0cf;
            content: "/";
        }

        .warehouse-breadcrumb .active {
            color: #2563eb;
            font-weight: 600;
        }

    .warehouse-page-title {
        color: #17233c;
        font-size: clamp(24px, 3vw, 34px);
        font-weight: 750;
        letter-spacing: -1.2px;
    }

    .warehouse-page-subtitle {
        color: #8291a8;
        font-size: 14px;
        line-height: 1.6;
    }

    .warehouse-dashboard-btn,
    .warehouse-primary-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 42px;
        padding: 10px 18px;
        border-radius: 11px;
        font-size: 13px;
        font-weight: 650;
        transition: all 0.2s ease;
    }

    .warehouse-dashboard-btn {
        color: #526177;
        background: #ffffff;
        border: 1px solid #dce4ee;
    }

        .warehouse-dashboard-btn:hover {
            color: #2563eb;
            background: #f5f8ff;
            border-color: #b9cdf5;
            transform: translateY(-1px);
        }

    .warehouse-primary-btn {
        color: #ffffff;
        background: linear-gradient(135deg, #2563eb, #315ee8);
        border: none;
        box-shadow: 0 8px 18px rgba(37, 99, 235, 0.18);
    }

        .warehouse-primary-btn:hover {
            color: #ffffff;
            background: linear-gradient(135deg, #1d4ed8, #4338ca);
            transform: translateY(-1px);
            box-shadow: 0 10px 22px rgba(37, 99, 235, 0.24);
        }

    .warehouse-summary-card {
        position: relative;
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        min-height: 145px;
        padding: 25px 20px;
        overflow: hidden;
        background: #ffffff;
        border: 1px solid #e4e9f0;
        border-radius: 18px;
        box-shadow: 0 7px 20px rgba(31, 45, 61, 0.035);
    }

        .warehouse-summary-card::after {
            content: "";
            position: absolute;
            top: -35px;
            right: -35px;
            width: 105px;
            height: 105px;
            background: #f7f9fc;
            border-radius: 50%;
        }

        .warehouse-summary-card > div {
            position: relative;
            z-index: 1;
        }

    .warehouse-summary-label {
        display: block;
        margin-bottom: 12px;
        color: #6b7d97;
        font-size: 11px;
        font-weight: 750;
        letter-spacing: 0.7px;
    }

    .warehouse-summary-value {
        margin-bottom: 6px;
        color: #1d2940;
        font-size: 26px;
        font-weight: 750;
        letter-spacing: -0.8px;
    }

    .warehouse-summary-description {
        color: #9aa9bd;
        font-size: 12px;
    }

    .warehouse-summary-icon {
        width: 43px;
        height: 43px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 13px;
        font-size: 17px;
    }

    .warehouse-icon-blue {
        color: #2563eb;
        background: #edf4ff;
    }

    .warehouse-icon-green {
        color: #16a05d;
        background: #eafaf1;
    }

    .warehouse-icon-red {
        color: #dc2626;
        background: #fff0f0;
    }

    .warehouse-content-card {
        overflow: hidden;
        background: #ffffff;
        border: 1px solid #e3e8ef;
        border-radius: 20px;
        box-shadow: 0 8px 25px rgba(31, 45, 61, 0.035);
    }

    .warehouse-content-header {
        padding: 23px 25px;
        border-bottom: 1px solid #edf0f5;
    }

    .warehouse-section-icon {
        width: 42px;
        height: 42px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #1685d9;
        background: #eaf7ff;
        border-radius: 12px;
        font-size: 17px;
    }

    .warehouse-section-title {
        color: #1c2940;
        font-size: 17px;
        font-weight: 750;
        letter-spacing: -0.3px;
    }

    .warehouse-section-subtitle {
        color: #9aa9bd;
        font-size: 12px;
    }

    .warehouse-record-count {
        color: #8291a8;
        font-size: 12px;
        font-weight: 600;
    }

    .warehouse-content-body {
        padding: 0;
    }

    .warehouse-table {
        min-width: 900px;
        color: #344258;
        font-size: 13px;
    }

        .warehouse-table thead th {
            padding: 17px 25px;
            color: #687b96;
            background: #f8fafc;
            border-bottom: 1px solid #e5eaf1;
            font-size: 11px;
            font-weight: 750;
            letter-spacing: 0.55px;
            text-transform: uppercase;
            white-space: nowrap;
        }

        .warehouse-table tbody td {
            padding: 18px 25px;
            border-bottom: 1px solid #edf1f5;
            vertical-align: middle;
        }

        .warehouse-table tbody tr:last-child td {
            border-bottom: none;
        }

        .warehouse-table tbody tr {
            transition: background 0.2s ease;
        }

            .warehouse-table tbody tr:hover {
                background: #f8fbff;
            }

    .warehouse-number-column {
        width: 70px;
    }

    .warehouse-number {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 30px;
        height: 30px;
        color: #6d7f98;
        background: #f1f5f9;
        border-radius: 8px;
        font-size: 11px;
        font-weight: 700;
    }

    .warehouse-code-wrapper {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .warehouse-code-icon {
        width: 40px;
        height: 40px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        color: #2563eb;
        background: #edf4ff;
        border-radius: 11px;
        font-size: 16px;
    }

    .warehouse-code {
        color: #202d43;
        font-size: 14px;
        font-weight: 750;
        letter-spacing: 0.3px;
    }

    .warehouse-code-subtitle,
    .warehouse-name-subtitle {
        margin-top: 3px;
        color: #9aa9bd;
        font-size: 11px;
    }

    .warehouse-name {
        color: #344258;
        font-size: 13px;
        font-weight: 650;
    }

    .warehouse-location {
        display: flex;
        align-items: center;
        color: #71819a;
        line-height: 1.5;
    }

        .warehouse-location i {
            color: #9aa9bd;
            flex-shrink: 0;
        }

    .warehouse-status-badge {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 7px 12px;
        border-radius: 999px;
        font-size: 12px;
        font-weight: 650;
        white-space: nowrap;
    }

    .warehouse-status-active {
        color: #16864e;
        background: #edfbf3;
        border: 1px solid #c8f1d9;
    }

    .warehouse-status-inactive {
        color: #dc2626;
        background: #fff0f0;
        border: 1px solid #ffd0d0;
    }

    .warehouse-status-dot {
        width: 6px;
        height: 6px;
        border-radius: 50%;
    }

    .warehouse-status-active .warehouse-status-dot {
        background: #18a957;
    }

    .warehouse-status-inactive .warehouse-status-dot {
        background: #ef4444;
    }

    .warehouse-content-footer {
        padding: 15px 25px;
        color: #99a8bb;
        background: #fbfcfe;
        border-top: 1px solid #edf1f5;
        font-size: 11px;
    }

        .warehouse-content-footer strong {
            color: #65758d;
        }

    .warehouse-empty-state {
        padding: 65px 20px;
        text-align: center;
    }

    .warehouse-empty-icon {
        width: 72px;
        height: 72px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 18px;
        color: #91a1b6;
        background: #f2f5f9;
        border-radius: 20px;
        font-size: 28px;
    }

    .warehouse-empty-title {
        color: #26344b;
        font-size: 17px;
        font-weight: 750;
    }

    .warehouse-empty-description {
        color: #98a7ba;
        font-size: 13px;
    }

    /* Modal */
    .warehouse-modal-content {
        overflow: hidden;
        border: 1px solid #e3e8ef;
        border-radius: 20px;
        box-shadow: 0 20px 60px rgba(31, 45, 61, 0.15);
    }

    .warehouse-modal-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        padding: 24px 25px;
        background: #ffffff;
        border-bottom: 1px solid #edf1f5;
    }

    .warehouse-modal-icon {
        width: 44px;
        height: 44px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #2563eb;
        background: #edf4ff;
        border-radius: 12px;
        font-size: 18px;
    }

    .warehouse-modal-title {
        color: #1c2940;
        font-size: 17px;
        font-weight: 750;
    }

    .warehouse-modal-subtitle {
        color: #9aa9bd;
        font-size: 12px;
    }

    .warehouse-modal-body {
        padding: 25px;
        background: #ffffff;
    }

    .warehouse-form-group {
        margin-bottom: 20px;
    }

    .warehouse-form-label {
        display: block;
        margin-bottom: 8px;
        color: #526177;
        font-size: 12px;
        font-weight: 700;
    }

    .warehouse-input-wrapper {
        position: relative;
    }

        .warehouse-input-wrapper > i {
            position: absolute;
            top: 50%;
            left: 14px;
            z-index: 2;
            color: #9aa9bd;
            font-size: 14px;
            transform: translateY(-50%);
            pointer-events: none;
        }

    .warehouse-textarea-wrapper > i {
        top: 17px;
        transform: none;
    }

    .warehouse-form-control {
        min-height: 44px;
        padding: 10px 14px 10px 40px;
        color: #344258;
        background: #fbfcfe;
        border: 1px solid #dfe6ef;
        border-radius: 10px;
        font-size: 13px;
        box-shadow: none;
        transition: all 0.2s ease;
    }

        .warehouse-form-control::placeholder {
            color: #a6b2c2;
        }

        .warehouse-form-control:focus {
            color: #344258;
            background: #ffffff;
            border-color: #8eb5f5;
            box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.08);
        }

    .warehouse-textarea {
        resize: vertical;
        min-height: 90px;
    }

    .warehouse-modal-footer {
        display: flex;
        justify-content: flex-end;
        gap: 10px;
        padding: 18px 25px;
        background: #fbfcfe;
        border-top: 1px solid #edf1f5;
    }

    .warehouse-cancel-btn,
    .warehouse-save-btn {
        min-height: 40px;
        padding: 9px 17px;
        border-radius: 10px;
        font-size: 13px;
        font-weight: 650;
        transition: all 0.2s ease;

@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Stock Transfer Orders (STO)";
}

<div class="container-fluid py-4 text-start">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-bold mb-1"><i class="fa-solid fa-list-check text-primary me-2"></i>Stock Transfer Orders (STO)</h4>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0 small">
                    <li class="breadcrumb-item"><a href="/InventoryDashboard" class="text-decoration-none">Inventory Dashboard</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Stock Transfer Orders</li>
                </ol>
            </nav>
        </div>
    </div>

    <!-- STO Table -->
    <div class="bg-white border rounded-3 p-4 shadow-sm">
        <h5 class="fw-bold mb-3">Active STO Orders</h5>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" style="font-size: 0.85rem;">
                <thead class="table-light">
                    <tr>
                        <th>STO Order No</th>
                        <th>Ordering Branch/Dept</th>
                        <th>Required Date</th>
                        <th>Total Value</th>
                        <th>Authorization Status</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td class="fw-bold text-dark">STO-2026-0091</td>
                        <td>Bangalore Branch Logistics</td>
                        <td>30 Aug 2026</td>
                        <td>₹1,80,000</td>
                        <td><span class="badge bg-success-subtle text-success">Approved</span></td>
                    </tr>
                    <tr>
                        <td class="fw-bold text-dark">STO-2026-0092</td>
                        <td>Hyderabad Branch Logistics</td>
                        <td>15 Sep 2026</td>
                        <td>₹4,25,000</td>
                        <td><span class="badge bg-warning-subtle text-warning">Pending Review</span></td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

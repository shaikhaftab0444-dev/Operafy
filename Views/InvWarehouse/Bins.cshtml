@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Bin & Rack Master";
}

<div class="container-fluid py-4 px-3 px-md-4 bin-rack-page">

    <!-- Page Header -->
    <div class="bin-rack-header-card mb-4">
        <div class="d-flex flex-column flex-lg-row justify-content-between align-items-start align-items-lg-center gap-4">

            <div class="d-flex align-items-start gap-3">
                <div class="bin-rack-page-icon">
                    <i class="fa-solid fa-boxes-stacked"></i>
                </div>

                <div>
                    <nav aria-label="breadcrumb" class="mb-2">
                        <ol class="breadcrumb bin-rack-breadcrumb mb-0">
                            <li class="breadcrumb-item">
                                <a href="/InventoryDashboard">
                                    <i class="fa-solid fa-arrow-left me-1"></i>
                                    Inventory Dashboard
                                </a>
                            </li>
                            <li class="breadcrumb-item active" aria-current="page">
                                Bin &amp; Racks
                            </li>
                        </ol>
                    </nav>

                    <h2 class="bin-rack-page-title mb-2">
                        Bin &amp; Rack Master
                    </h2>

                    <p class="bin-rack-page-subtitle mb-0">
                        Organize warehouse storage areas, rack positions, bin levels, and available capacity.
                    </p>
                </div>
            </div>

            <div class="d-flex flex-wrap gap-2">
                <a href="/InventoryDashboard" class="btn bin-rack-dashboard-btn">
                    <i class="fa-solid fa-chart-pie me-2"></i>
                    Dashboard
                </a>

                <button type="button" class="btn bin-rack-primary-btn">
                    <i class="fa-solid fa-plus me-2"></i>
                    Add Rack / Bin
                </button>
            </div>

        </div>
    </div>

    <!-- Summary Cards -->
    <div class="row g-3 mb-4">

        <div class="col-12 col-md-4">
            <div class="bin-rack-summary-card">
                <div>
                    <span class="bin-rack-summary-label">TOTAL STORAGE POSITIONS</span>
                    <h3 class="bin-rack-summary-value">2</h3>
                    <span class="bin-rack-summary-description">
                        Registered rack and bin positions
                    </span>
                </div>

                <div class="bin-rack-summary-icon bin-rack-icon-blue">
                    <i class="fa-solid fa-layer-group"></i>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-4">
            <div class="bin-rack-summary-card">
                <div>
                    <span class="bin-rack-summary-label">AVAILABLE POSITIONS</span>
                    <h3 class="bin-rack-summary-value text-success">1</h3>
                    <span class="bin-rack-summary-description">
                        Storage positions ready for use
                    </span>
                </div>

                <div class="bin-rack-summary-icon bin-rack-icon-green">
                    <i class="fa-solid fa-circle-check"></i>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-4">
            <div class="bin-rack-summary-card">
                <div>
                    <span class="bin-rack-summary-label">FULL POSITIONS</span>
                    <h3 class="bin-rack-summary-value text-warning">1</h3>
                    <span class="bin-rack-summary-description">
                        Positions currently at capacity
                    </span>
                </div>

                <div class="bin-rack-summary-icon bin-rack-icon-orange">
                    <i class="fa-solid fa-box"></i>
                </div>
            </div>
        </div>

    </div>

    <!-- Rack and Bin Master -->
    <div class="bin-rack-content-card">

        <div class="bin-rack-content-header">
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3">

                <div class="d-flex align-items-center gap-3">
                    <div class="bin-rack-section-icon">
                        <i class="fa-solid fa-table-list"></i>
                    </div>

                    <div>
                        <h5 class="bin-rack-section-title mb-1">
                            Racks &amp; Bins Layout
                        </h5>

                        <p class="bin-rack-section-subtitle mb-0">
                            View warehouse storage positions and capacity information.
                        </p>
                    </div>
                </div>

                <div class="bin-rack-record-count">
                    <i class="fa-solid fa-database me-1"></i>
                    2 Storage Positions
                </div>

            </div>
        </div>

        <div class="bin-rack-content-body">

            <div class="table-responsive">
                <table class="table bin-rack-table align-middle mb-0">

                    <thead>
                        <tr>
                            <th class="bin-rack-number-column">#</th>
                            <th>Warehouse</th>
                            <th>Rack Code</th>
                            <th>Bin Level / Row</th>
                            <th>Capacity Volume</th>
                            <th>Status</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>

                    <tbody>

                        <tr>
                            <td>
                                <span class="bin-rack-number">01</span>
                            </td>

                            <td>
                                <div class="bin-rack-warehouse-wrapper">
                                    <div class="bin-rack-warehouse-icon">
                                        <i class="fa-solid fa-warehouse"></i>
                                    </div>

                                    <div>
                                        <div class="bin-rack-warehouse-name">
                                            Main Central Warehouse
                                        </div>

                                        <div class="bin-rack-warehouse-subtitle">
                                            Primary storage facility
                                        </div>
                                    </div>
                                </div>
                            </td>

                            <td>
                                <span class="bin-rack-code-badge">
                                    <i class="fa-solid fa-layer-group me-2"></i>
                                    RACK-A1
                                </span>
                            </td>

                            <td>
                                <div class="bin-rack-bin-code">
                                    BIN-ROW-3
                                </div>

                                <div class="bin-rack-cell-subtitle">
                                    Level 3
                                </div>
                            </td>

                            <td>
                                <div class="bin-rack-capacity">
                                    <strong>500</strong> Litres
                                </div>

                                <div class="bin-rack-capacity-bar">
                                    <div class="bin-rack-capacity-progress bin-rack-progress-green"></div>
                                </div>
                            </td>

                            <td>
                                <span class="bin-rack-status-badge bin-rack-status-available">
                                    <span class="bin-rack-status-dot"></span>
                                    Available
                                </span>
                            </td>

                            <td class="text-end">
                                <button type="button"
                                        class="btn bin-rack-action-btn"
                                        title="View storage position">
                                    <i class="fa-solid fa-eye"></i>
                                </button>
                            </td>
                        </tr>

                        <tr>
                            <td>
                                <span class="bin-rack-number">02</span>
                            </td>

                            <td>
                                <div class="bin-rack-warehouse-wrapper">
                                    <div class="bin-rack-warehouse-icon">
                                        <i class="fa-solid fa-warehouse"></i>
                                    </div>

                                    <div>
                                        <div class="bin-rack-warehouse-name">
                                            Main Central Warehouse
                                        </div>

                                        <div class="bin-rack-warehouse-subtitle">
                                            Primary storage facility
                                        </div>
                                    </div>
                                </div>
                            </td>

                            <td>
                                <span class="bin-rack-code-badge">
                                    <i class="fa-solid fa-layer-group me-2"></i>
                                    RACK-A2
                                </span>
                            </td>

                            <td>
                                <div class="bin-rack-bin-code">
                                    BIN-ROW-2
                                </div>

                                <div class="bin-rack-cell-subtitle">
                                    Level 2
                                </div>
                            </td>

                            <td>
                                <div class="bin-rack-capacity">
                                    <strong>300</strong> Litres
                                </div>

                                <div class="bin-rack-capacity-bar">
                                    <div class="bin-rack-capacity-progress bin-rack-progress-orange"></div>
                                </div>
                            </td>

                            <td>
                                <span class="bin-rack-status-badge bin-rack-status-full">
                                    <span class="bin-rack-status-dot"></span>
                                    Full
                                </span>
                            </td>

                            <td class="text-end">
                                <button type="button"
                                        class="btn bin-rack-action-btn"
                                        title="View storage position">
                                    <i class="fa-solid fa-eye"></i>
                                </button>
                            </td>
                        </tr>

                    </tbody>

                </table>
            </div>

        </div>

        <div class="bin-rack-content-footer">
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-2">
                <span>
                    <i class="fa-solid fa-circle-info me-1"></i>
                    Storage positions are organized by warehouse, rack, and bin level.
                </span>

                <span>
                    Total: <strong>2 Positions</strong>
                </span>
            </div>
        </div>

    </div>

</div>

<style>
    .bin-rack-page {
        background: #f4f7fb;
        min-height: calc(100vh - 80px);
    }

    .bin-rack-header-card {
        position: relative;
        overflow: hidden;
        padding: 30px;
        background: #ffffff;
        border: 1px solid #e3e8ef;
        border-radius: 22px;
        box-shadow: 0 8px 25px rgba(31, 45, 61, 0.04);
    }

        .bin-rack-header-card::before {
            content: "";
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 4px;
            background: linear-gradient(90deg, #1677ff, #635bff);
        }

    .bin-rack-page-icon {
        width: 58px;
        height: 58px;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #ffffff;
        background: linear-gradient(135deg, #2878f0, #4f46e5);
        border-radius: 16px;
        font-size: 23px;
        box-shadow: 0 10px 22px rgba(37, 99, 235, 0.2);
    }

    .bin-rack-breadcrumb {
        font-size: 13px;
        color: #8a9ab3;
    }

        .bin-rack-breadcrumb a {
            color: #71819a;
            text-decoration: none;
            transition: color 0.2s ease;
        }

            .bin-rack-breadcrumb a:hover {
                color: #2563eb;
            }

        .bin-rack-breadcrumb .breadcrumb-item + .breadcrumb-item::before {
            color: #b5c0cf;
            content: "/";
        }

        .bin-rack-breadcrumb .active {
            color: #2563eb;
            font-weight: 600;
        }

    .bin-rack-page-title {
        color: #17233c;
        font-size: clamp(24px, 3vw, 34px);
        font-weight: 750;
        letter-spacing: -1.2px;
    }

    .bin-rack-page-subtitle {
        color: #8291a8;
        font-size: 14px;
        line-height: 1.6;
    }

    .bin-rack-dashboard-btn,
    .bin-rack-primary-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 42px;
        padding: 10px 18px;
        border-radius: 11px;
        font-size: 13px;
        font-weight: 650;
        transition: all 0.2s ease;
    }

    .bin-rack-dashboard-btn {
        color: #526177;
        background: #ffffff;
        border: 1px solid #dce4ee;
    }

        .bin-rack-dashboard-btn:hover {
            color: #2563eb;
            background: #f5f8ff;
            border-color: #b9cdf5;
            transform: translateY(-1px);
        }

    .bin-rack-primary-btn {
        color: #ffffff;
        background: linear-gradient(135deg, #2563eb, #315ee8);
        border: none;
        box-shadow: 0 8px 18px rgba(37, 99, 235, 0.18);
    }

        .bin-rack-primary-btn:hover {
            color: #ffffff;
            background: linear-gradient(135deg, #1d4ed8, #4338ca);
            transform: translateY(-1px);
            box-shadow: 0 10px 22px rgba(37, 99, 235, 0.24);
        }

    .bin-rack-summary-card {
        position: relative;
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        min-height: 145px;
        padding: 25px 20px;
        overflow: hidden;
        background: #ffffff;
        border: 1px solid #e4e9f0;
        border-radius: 18px;
        box-shadow: 0 7px 20px rgba(31, 45, 61, 0.035);
    }

        .bin-rack-summary-card::after {
            content: "";
            position: absolute;
            top: -35px;
            right: -35px;
            width: 105px;
            height: 105px;
            background: #f7f9fc;
            border-radius: 50%;
        }

        .bin-rack-summary-card > div {
            position: relative;
            z-index: 1;
        }

    .bin-rack-summary-label {
        display: block;
        margin-bottom: 12px;
        color: #6b7d97;
        font-size: 11px;
        font-weight: 750;
        letter-spacing: 0.7px;
    }

    .bin-rack-summary-value {
        margin-bottom: 6px;
        color: #1d2940;
        font-size: 26px;
        font-weight: 750;
        letter-spacing: -0.8px;
    }

    .bin-rack-summary-description {
        color: #9aa9bd;
        font-size: 12px;
    }

    .bin-rack-summary-icon {
        width: 43px;
        height: 43px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 13px;
        font-size: 17px;
    }

    .bin-rack-icon-blue {
        color: #2563eb;
        background: #edf4ff;
    }

    .bin-rack-icon-green {
        color: #16a05d;
        background: #eafaf1;
    }

    .bin-rack-icon-orange {
        color: #d97706;
        background: #fff7e8;
    }

    .bin-rack-content-card {
        overflow: hidden;
        background: #ffffff;
        border: 1px solid #e3e8ef;
        border-radius: 20px;
        box-shadow: 0 8px 25px rgba(31, 45, 61, 0.035);
    }

    .bin-rack-content-header {
        padding: 23px 25px;
        border-bottom: 1px solid #edf0f5;
    }

    .bin-rack-section-icon {
        width: 42px;
        height: 42px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #1685d9;
        background: #eaf7ff;
        border-radius: 12px;
        font-size: 17px;
    }

    .bin-rack-section-title {
        color: #1c2940;
        font-size: 17px;
        font-weight: 750;
        letter-spacing: -0.3px;
    }

    .bin-rack-section-subtitle {
        color: #9aa9bd;
        font-size: 12px;
    }

    .bin-rack-record-count {
        color: #8291a8;
        font-size: 12px;
        font-weight: 600;
    }

    .bin-rack-content-body {
        padding: 0;
    }

    .bin-rack-table {
        min-width: 1050px;
        color: #344258;
        font-size: 13px;
    }

        .bin-rack-table thead th {
            padding: 17px 25px;
            color: #687b96;
            background: #f8fafc;
            border-bottom: 1px solid #e5eaf1;
            font-size: 11px;
            font-weight: 750;
            letter-spacing: 0.55px;
            text-transform: uppercase;
            white-space: nowrap;
        }

        .bin-rack-table tbody td {
            padding: 18px 25px;
            border-bottom: 1px solid #edf1f5;
            vertical-align: middle;
        }

        .bin-rack-table tbody tr:last-child td {
            border-bottom: none;
        }

        .bin-rack-table tbody tr {
            transition: background 0.2s ease;
        }

            .bin-rack-table tbody tr:hover {
                background: #f8fbff;
            }

    .bin-rack-number-column {
        width: 65px;
    }

    .bin-rack-number {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 30px;
        height: 30px;
        color: #6d7f98;
        background: #f1f5f9;
        border-radius: 8px;
        font-size: 11px;
        font-weight: 700;
    }

    .bin-rack-warehouse-wrapper {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .bin-rack-warehouse-icon {
        width: 40px;
        height: 40px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        color: #2563eb;
        background: #edf4ff;
        border-radius: 11px;
        font-size: 16px;
    }

    .bin-rack-warehouse-name {
        color: #202d43;
        font-size: 13px;
        font-weight: 750;
        white-space: nowrap;
    }

    .bin-rack-warehouse-subtitle,
    .bin-rack-cell-subtitle {
        margin-top: 4px;
        color: #9aa9bd;
        font-size: 11px;
    }

    .bin-rack-code-badge {
        display: inline-flex;
        align-items: center;
        padding: 8px 11px;
        color: #2563eb;
        background: #edf4ff;
        border: 1px solid #d8e7ff;
        border-radius: 9px;
        font-size: 12px;
        font-weight: 700;
        white-space: nowrap;
    }

    .bin-rack-bin-code {
        color: #344258;
        font-size: 13px;
        font-weight: 700;
        white-space: nowrap;
    }

    .bin-rack-capacity {
        color: #71819a;
        white-space: nowrap;
    }

        .bin-rack-capacity strong {
            color: #26344b;
            font-weight: 750;
        }

    .bin-rack-capacity-bar {
        width: 105px;
        height: 5px;
        margin-top: 8px;
        overflow: hidden;
        background: #edf1f5;
        border-radius: 99px;
    }

    .bin-rack-capacity-progress {
        height: 100%;
        border-radius: 99px;
    }

    .bin-rack-progress-green {
        width: 45%;
        background: #20b263;
    }

    .bin-rack-progress-orange {
        width: 100%;
        background: #f59e0b;
    }

    .bin-rack-status-badge {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 7px 12px;
        border-radius: 999px;
        font-size: 12px;
        font-weight: 650;
        white-space: nowrap;
    }

    .bin-rack-status-available {
        color: #16864e;
        background: #edfbf3;
        border: 1px solid #c8f1d9;
    }

    .bin-rack-status-full {
        color: #b45309;
        background: #fff8e8;
        border: 1px solid #f8df9e;
    }

    .bin-rack-status-dot {
        width: 6px;
        height: 6px;
        border-radius: 50%;
    }

    .bin-rack-status-available .bin-rack-status-dot {
        background: #18a957;
    }

    .bin-rack-status-full .bin-rack-status-dot {
        background: #f59e0b;
    }

    .bin-rack-action-btn {
        width: 34px;
        height: 34px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        color: #62738b;
        background: #ffffff;
        border: 1px solid #dce4ee;
        border-radius: 9px;
        font-size: 13px;
        transition: all 0.2s ease;
    }

        .bin-rack-action-btn:hover {
            color: #2563eb;
            background: #f3f7ff;
            border-color: #b9cdf5;
        }

    .bin-rack-content-footer {
        padding: 15px 25px;
        color: #99a8bb;
        background: #fbfcfe;
        border-top: 1px solid #edf1f5;
        font-size: 11px;
    }

        .bin-rack-content-footer strong {
            color: #65758d;
        }

    @@media (max-width: 767.98px) {
        .bin-rack-page

    {
        padding-top: 20px !important;
    }

    .bin-rack-header-card {
        padding: 22px 18px;
        border-radius: 17px;
    }

    .bin-rack-page-icon {
        width: 48px;
        height: 48px;
        border-radius: 13px;
        font-size: 19px;
    }

    .bin-rack-page-title {
        font-size: 25px;
    }

    .bin-rack-page-subtitle {
        font-size: 13px;
    }

    .bin-rack-dashboard-btn,
    .bin-rack-primary-btn {
        flex: 1;
        min-width: 140px;
    }

    .bin-rack-summary-card {
        min-height: 125px;
        padding: 20px;
    }

    .bin-rack-summary-value {
        font-size: 24px;
    }

    .bin-rack-content-header {
        padding: 20px 18px;
    }

    .bin-rack-table thead th,
    .bin-rack-table tbody td {
        padding-left: 18px;
        padding-right: 18px;
    }

    .bin-rack-content-footer {
        padding: 14px 18px;
    }

    }
</style>
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Bin & Rack Master";
}

<div class="container-fluid py-4 text-start">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-bold mb-1"><i class="fa-solid fa-boxes-stacked text-primary me-2"></i>Bin & Rack Master</h4>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0 small">
                    <li class="breadcrumb-item"><a href="/InventoryDashboard" class="text-decoration-none">Inventory Dashboard</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Bin & Racks</li>
                </ol>
            </nav>
        </div>
    </div>

    <!-- Bins Table -->
    <div class="bg-white border rounded-3 p-4 shadow-sm" style="max-width: 700px;">
        <h5 class="fw-bold mb-3">Racks & Bins Layout</h5>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" style="font-size: 0.85rem;">
                <thead class="table-light">
                    <tr>
                        <th>Warehouse</th>
                        <th>Rack Code</th>
                        <th>Bin Level / Row</th>
                        <th>Capacity Vol</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td class="fw-bold text-dark">Main Central Warehouse</td>
                        <td>RACK-A1</td>
                        <td>BIN-ROW-3</td>
                        <td>500 Litres</td>
                        <td><span class="badge bg-success-subtle text-success">Available</span></td>
                    </tr>
                    <tr>
                        <td class="fw-bold text-dark">Main Central Warehouse</td>
                        <td>RACK-A2</td>
                        <td>BIN-ROW-2</td>
                        <td>300 Litres</td>
                        <td><span class="badge bg-warning-subtle text-warning">Full</span></td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

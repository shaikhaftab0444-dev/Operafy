@model IEnumerable<ERP_System.Models.InvGrn>
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Goods Receipt Note (GRN)";
}

<div class="container-fluid py-4 text-start">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-bold mb-1"><i class="fa-solid fa-receipt text-primary me-2"></i>Goods Receipt Note (GRN - Inward)</h4>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0 small">
                    <li class="breadcrumb-item"><a href="/InventoryDashboard" class="text-decoration-none">Inventory Dashboard</a></li>
                    <li class="breadcrumb-item active" aria-current="page">GRN Inwards</li>
                </ol>
            </nav>
        </div>
        <button class="btn btn-primary rounded-pill px-3 btn-sm shadow-sm" data-bs-toggle="modal" data-bs-target="#grnModal">
            <i class="fa-solid fa-plus me-1.5"></i>Log GRN Entry
        </button>
    </div>

    <!-- GRN List -->
    <div class="bg-white border rounded-3 p-4 shadow-sm">
        <h5 class="fw-bold mb-3">Inward Transactions</h5>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" style="font-size: 0.85rem;">
                <thead class="table-light">
                    <tr>
                        <th>GRN Number</th>
                        <th>Supplier</th>
                        <th>Received Date</th>
                        <th>Received By</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var g in Model)
                        {
                            <tr>
                                <td class="fw-bold text-dark">@g.GrnNo</td>
                                <td>@g.SupplierName</td>
                                <td class="text-muted">@g.ReceivedDate.ToString("dd MMM yyyy")</td>
                                <td>@g.ReceivedBy</td>
                                <td>
                                    @if (g.Status == "Completed")
                                    {
                                        <span class="badge bg-success-subtle text-success rounded-pill px-2.5 py-1">Completed</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning-subtle text-warning rounded-pill px-2.5 py-1">Pending verification</span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center py-4 text-muted">No GRN transactions logged.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- GRN Modal -->
<div class="modal fade text-start" id="grnModal" tabindex="-1" aria-labelledby="grnModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form action="/InvWarehouse/CreateGrn" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title fw-bold" id="grnModalLabel">Log Goods Receipt (GRN)</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Supplier Name</label>
                        <input type="text" name="SupplierName" class="form-control" placeholder="e.g. Global Electronics Ltd" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Received By (Auditor / Staff)</label>
                        <input type="text" name="ReceivedBy" class="form-control" placeholder="e.g. Numan Sales Man" required />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary rounded-pill px-3 btn-sm" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary rounded-pill px-3 btn-sm">Receive Goods</button>
                </div>
            </form>
        </div>
    </div>
</div>

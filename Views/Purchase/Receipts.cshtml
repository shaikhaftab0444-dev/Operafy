                    </div>

                </div>


                <div class="grn-search-wrap">

                    <i class="fa fa-search grn-search-icon"></i>

                    <input type="text"
                           id="grnSearch"
                           class="grn-search"
                           placeholder="Search GRN, PO, vendor, warehouse..."
                           autocomplete="off"
                           onkeyup="filterGRNTable()" />

                </div>

            </div>


            <div class="grn-register-info">

                <span class="grn-register-count">
                    Showing
                    <strong id="grnVisibleCount">@Model.Count</strong>
                    of
                    <strong>@Model.Count</strong>
                    GRN records
                </span>

                <span class="grn-audit-note">
                    <i class="fa fa-shield-halved me-1"></i>
                    Receiving ledger synchronized with AP
                </span>

            </div>


            <div class="grn-table-wrap">

                <table class="grn-table"
                       id="grnDataTable">

                    <thead>

                        <tr>

                            <th>GRN #</th>

                            <th>PO Reference</th>

                            <th>Vendor Partner</th>

                            <th>Received Date</th>

                            <th>Destination Bay</th>

                            <th>Units Received</th>

                            <th>Inspector</th>

                            <th>Quality Status</th>

                            <th class="text-end">
                                Actions
                            </th>

                        </tr>

                    </thead>


                    <tbody>

                        @foreach (var g in Model)
                        {
                            <tr class="grn-data-row" id="row-@g.GRNNumber" data-grn="@g.GRNNumber">

                                <!-- GRN -->
                                <td>
                                    <a href="@Url.Action("Slip", "Purchase", new { grnNumber = g.GRNNumber })"
                                       class="grn-number grn-slip-link text-decoration-none d-inline-flex align-items-center gap-1.5"
                                       title="View Official GRN Inward Slip for @g.GRNNumber">
                                        <i class="fa fa-receipt text-primary" style="font-size: 0.72rem;"></i>
                                        <span>@g.GRNNumber</span>
                                    </a>
                                </td>


                                <!-- PO -->
                                <td>
                                    <span class="grn-po">
                                        @g.PONumber
                                    </span>
                                </td>


                                <!-- Vendor -->
                                <td>
                                    <span class="grn-vendor">
                                        @g.VendorName
                                    </span>
                                </td>


                                <!-- Date -->
                                <td>
                                    <span class="grn-date">
                                        <i class="fa fa-calendar-day me-1"></i>
                                        @g.ReceivedDate
                                    </span>
                                </td>


                                <!-- Warehouse -->
                                <td>
                                    <span class="grn-warehouse">
                                        <i class="fa fa-warehouse"></i>
                                        @g.Warehouse
                                    </span>
                                </td>


                                <!-- Units -->
                                <td>
                                    <span class="grn-units">
                                        @g.ItemsReceived
                                    </span>
                                    <span class="text-muted ms-1" style="font-size:0.63rem;">
                                        Units
                                    </span>
                                </td>


                                <!-- Inspector -->
                                <td>
                                    <span class="grn-inspector">
                                        <i class="fa fa-user-check"></i>
                                        @g.InspectedBy
                                    </span>
                                </td>


                                <!-- Status -->
                                <td id="status-cell-@g.GRNNumber">
                                    @if (g.Status == "Quality Quarantine")
                                    {
                                        <span class="grn-status grn-status-quarantine">
                                            <i class="fa fa-triangle-exclamation"></i>
                                            Quarantine
                                        </span>
                                    }
                                    else if (g.Status == "3-Way Matched")
                                    {
                                        <span class="grn-status grn-status-matched">
                                            <i class="fa fa-handshake-angle"></i>
                                            3-Way Matched
                                        </span>
                                    }
                                    else if (g.Status == "Completed & Stocked")
                                    {
                                        <span class="grn-status" style="background:#f5f3ff; color:#7c3aed; border:1px solid #ddd6fe;">
                                            <i class="fa fa-boxes-stacked"></i>
                                            Completed & Stocked
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="grn-status grn-status-default">
                                            <i class="fa fa-circle-check"></i>
                                            @g.Status
                                        </span>
                                    }
                                </td>


                                <!-- Actions -->
                                <td class="text-end">
                                    <a href="@Url.Action("Slip", "Purchase", new { grnNumber = g.GRNNumber })"
                                       class="btn btn-sm btn-outline-primary grn-slip-btn shadow-sm"
                                       data-grn="@g.GRNNumber"
                                       title="View official GRN inward slip for @g.GRNNumber">
                                        <i class="fa fa-receipt me-1"></i>
                                        Slip
                                    </a>
                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>


            <!-- Empty Search State -->
            <div class="grn-empty-state"
                 id="grnEmptyState">

                <div class="grn-empty-icon">

                    <i class="fa fa-magnifying-glass"></i>

                </div>

                <h5>
                    No GRN records found
                </h5>

                <p>
                    Try searching with another GRN number, PO reference,
                    vendor, warehouse, or inspector.
                </p>

            </div>

        </div>


        <!-- ==========================================
             FOOTER
             ========================================== -->

        <div class="grn-footer">

            <span>
                <i class="fa fa-database"></i>
                Goods receipt records synchronized with procurement data
            </span>

            <span>
                <i class="fa fa-shield-halved"></i>
                3-Way Match controls enabled
            </span>

        </div>

    </div>

</div>


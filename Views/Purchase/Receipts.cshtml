                            <div class="text-muted extra-small">Operafy Receiving Dock 3</div>
                        </div>
                        <div class="col-4">
                            <div class="fw-bold text-success mb-1"><i class="fa fa-stamp me-1"></i> Quality Assurance Lead</div>
                            <div class="text-dark fw-semibold extra-small" id="slipSignatureInspector">Rajesh K. (Lead Inspector)</div>
                            <span class="badge bg-success-subtle text-success extra-small border border-success-subtle mt-1 py-0.5">
                                <i class="fa fa-check-circle me-1"></i> VERIFIED & SIGNED
                            </span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="modal-footer bg-light border-top px-4 py-2.5 d-flex justify-content-between align-items-center">
                <div id="slipFooterQuarantineAction">
                    <!-- Dynamic release button injected if in quarantine -->
                </div>
                <div class="d-flex gap-2 ms-auto">
                    <button type="button" class="btn btn-secondary rounded-pill px-3.5" data-bs-dismiss="modal">Close</button>
                    <button type="button" class="btn btn-primary rounded-pill px-4 shadow-sm" onclick="printGRNSlip()">
                        <i class="fa fa-print me-1.5"></i> Print / Save Slip
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ==========================================================================
     MODAL: INWARD MATERIAL SCAN & GRN GENERATOR
     ========================================================================== -->
<div class="modal fade" id="inwardScanModal" tabindex="-1" aria-labelledby="inwardScanModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 18px;">
            <div class="modal-header border-bottom px-4 py-3">
                <div class="d-flex align-items-center gap-2">
                    <span class="badge bg-primary-subtle text-primary fw-bold">SAP MM Receiving</span>
                    <h5 class="modal-title fw-bold text-dark mb-0" id="inwardScanModalLabel">
                        <i class="fa fa-barcode text-primary me-2"></i> Inward Material Scan & GRN Generator
                    </h5>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <form id="inwardScanForm">
                <div class="modal-body p-4">
                    <!-- Scanner Viewfinder Simulation -->
                    <div class="p-3 bg-dark text-white rounded-3 mb-3 text-center position-relative overflow-hidden" style="background: linear-gradient(135deg, #0f172a, #1e293b);">
                        <div class="d-flex justify-content-between align-items-center text-secondary small mb-2">
                            <span><i class="fa fa-video text-danger me-1"></i> Optical Barcode Sensor Active</span>
                            <span class="badge bg-success-subtle text-success">READY</span>
                        </div>
                        <div class="py-2">
                            <i class="fa fa-qrcode fa-3x text-info mb-2"></i>
                            <div class="text-white-50 extra-small">Aim handheld scanner at consignment barcode or choose active PO below</div>
                        </div>
                    </div>

                    <div class="row g-3">
                        <div class="col-12 col-md-6">
                            <label class="form-label fw-bold small text-dark">Active Purchase Order (PO) *</label>
                            <select class="form-select" id="scanPoSelect" name="PONumber" required onchange="onScanPOSelected()">
                                <option value="" disabled selected>Select Inward PO Reference...</option>
                                <option value="PO-2026-0891" data-vendor="TechInfra Solutions Ltd" data-qty="12" data-item="Dell UltraSharp Monitors & Switches">PO-2026-0891 - TechInfra Solutions Ltd (12 Items)</option>
                                <option value="PO-2026-0892" data-vendor="Apex Industrial Supplies" data-qty="4" data-item="Industrial Heavy Tooling Sets">PO-2026-0892 - Apex Industrial Supplies (4 Items)</option>
                                <option value="PO-2026-0893" data-vendor="National Paper Mills" data-qty="50" data-item="Packaging Cartons">PO-2026-0893 - National Paper Mills (50 Items)</option>
                                <option value="PO-2026-0894" data-vendor="SteelCraft Heavy Metals" data-qty="18" data-item="Structural Steel Plates">PO-2026-0894 - SteelCraft Heavy Metals (18 Items)</option>
                                <option value="PO-2026-0895" data-vendor="Global Cloud Corp" data-qty="1" data-item="Dedicated Hardware Servers">PO-2026-0895 - Global Cloud Corp (1 Item)</option>
                            </select>
                        </div>

                        <div class="col-12 col-md-6">
                            <label class="form-label fw-bold small text-dark">Vendor Partner</label>
                            <input type="text" class="form-control bg-light" id="scanVendorName" name="VendorName" readonly placeholder="Auto-populated from PO" />
                        </div>

                        <div class="col-12 col-md-6">
                            <label class="form-label fw-bold small text-dark">Destination Warehouse Bay *</label>
                            <select class="form-select" id="scanWarehouse" name="Warehouse" required>
                                <option value="WH-Main Bay A" selected>WH-Main Bay A (General Receiving)</option>
                                <option value="WH-Raw Storage B3">WH-Raw Storage B3 (Raw Materials)</option>
                                <option value="WH-IT Staging Rm">WH-IT Staging Rm (Electronics & Assets)</option>
                                <option value="WH-QC Holding Cell">WH-QC Holding Cell (Quarantine Area)</option>
                            </select>
                        </div>

                        <div class="col-12 col-md-6">
                            <label class="form-label fw-bold small text-dark">Units Received *</label>
                            <input type="number" class="form-control" id="scanUnitsReceived" name="ItemsReceived" min="1" max="50000" required placeholder="e.g. 50" />
                        </div>

                        <div class="col-12 col-md-6">
                            <label class="form-label fw-bold small text-dark">Lead Inspector Name *</label>
                            <input type="text" class="form-control" id="scanInspector" name="InspectedBy" value="Rajesh K." required />
                        </div>

                        <div class="col-12 col-md-6">
                            <label class="form-label fw-bold small text-dark">Quality Intake Status</label>
                            <select class="form-select" id="scanStatus" name="Status">
                                <option value="Inspected & Accepted" selected>Inspected & Accepted (Passed QA)</option>
                                <option value="3-Way Matched">3-Way Matched (Verified with AP)</option>
                                <option value="Quality Quarantine">Quality Quarantine (Holding for Audit)</option>
                                <option value="Completed & Stocked">Completed & Stocked in Inventory</option>
                            </select>
                        </div>
                    </div>
                </div>

                <div class="modal-footer border-top px-4 py-3">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary" id="btnSubmitScan">
                        <i class="fa fa-check-circle me-1"></i> Generate & Sign GRN Slip
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {

    <script>
        var currentActiveGRN = null;
        var currentSlipData = null;

        function showGRNToast(msg, isSuccess) {
            if (isSuccess === undefined) isSuccess = true;
            var el = document.getElementById('grnLiveToast');
            var txt = document.getElementById('grnToastMessage');
            var icon = document.getElementById('grnToastIcon');
            if (!el) return;
            txt.innerText = msg;
            el.className = 'toast align-items-center text-white border-0 shadow-lg ' + (isSuccess ? 'bg-success' : 'bg-danger');
            if (icon) icon.className = isSuccess ? 'fa fa-circle-check fs-5' : 'fa fa-circle-xmark fs-5';
            try {
                var toast = bootstrap.Toast.getOrCreateInstance ? bootstrap.Toast.getOrCreateInstance(el, { delay: 4500 }) : new bootstrap.Toast(el, { delay: 4500 });
                toast.show();
            } catch (e) {
                console.log(msg);
            }
        }

        function showGRNSlipModalDirect(modalEl) {
            if (!modalEl) modalEl = document.getElementById('grnSlipModal');
            if (!modalEl) return;

            // Move modal to body if not already there, avoiding stacking context / overflow issues
            if (modalEl.parentNode !== document.body) {
                document.body.appendChild(modalEl);
            }

            // Clean up any stale stacked backdrops to prevent page lockup
            var oldBackdrops = document.querySelectorAll('.modal-backdrop');
            if (oldBackdrops.length > 0) {
                oldBackdrops.forEach(function (bd) {
                    if (!document.querySelector('.modal.show')) {
                        bd.remove();
                    }
                });
            }

            try {
                if (window.bootstrap && bootstrap.Modal) {
                    var inst = bootstrap.Modal.getOrCreateInstance 
                        ? bootstrap.Modal.getOrCreateInstance(modalEl)
                        : (bootstrap.Modal.getInstance(modalEl) || new bootstrap.Modal(modalEl));
                    inst.show();
                    return;
                }
            } catch (err) {
                console.warn('Bootstrap modal instance error:', err);
            }

            if (window.$ && $.fn && $.fn.modal) {
                $(modalEl).modal('show');
                return;
            }

            // Fallback native display
            modalEl.classList.add('show');
            modalEl.style.display = 'block';
            document.body.classList.add('modal-open');
        }

        function openGRNSlipModal(grnNo, poNo, vendor, date, warehouse, units, inspector, status) {
            currentActiveGRN = grnNo || 'GRN-2026-0411';
            currentSlipData = null;

            // 1. Instantaneous baseline render (0ms response time)
            if (document.getElementById('slipGrnNumber')) document.getElementById('slipGrnNumber').innerText = currentActiveGRN;
            if (document.getElementById('slipBarcodeText')) document.getElementById('slipBarcodeText').innerText = currentActiveGRN;
            if (document.getElementById('slipPoNumber')) document.getElementById('slipPoNumber').innerText = poNo || 'PO-2026-0893';
            if (document.getElementById('slipVendorName')) document.getElementById('slipVendorName').innerText = vendor || 'Vendor Partner';
            if (document.getElementById('slipReceivedDate')) document.getElementById('slipReceivedDate').innerText = date || '02 Sep 2026';
            if (document.getElementById('slipWarehouse')) document.getElementById('slipWarehouse').innerText = warehouse || 'WH-Main Bay A';
            if (document.getElementById('slipInspector')) document.getElementById('slipInspector').innerText = inspector || 'Rajesh K.';
            if (document.getElementById('slipSignatureInspector')) document.getElementById('slipSignatureInspector').innerText = (inspector || 'Rajesh K.') + ' (Lead Inspector)';

            var parsedUnits = parseInt(units) || 50;
            if (document.getElementById('footPoQty')) document.getElementById('footPoQty').innerText = parsedUnits + ' Units';
            if (document.getElementById('footReceivedQty')) document.getElementById('footReceivedQty').innerText = parsedUnits + ' Units';

            var isQuarantine = (status || '').toLowerCase().includes('quarantine');
            updateModalStatusBadge(status || 'Inspected & Accepted');

            // Set initial items placeholder while AJAX loads authentic order items
            var tbody = document.getElementById('slipItemsTableBody');
            if (tbody) {
                var acceptedInit = isQuarantine ? 0 : parsedUnits;
                var quarInit = isQuarantine ? parsedUnits : 0;
                var verdictInit = isQuarantine ? 'QUARANTINE HOLD' : 'PASSED QC';
                var verdictBadgeClass = isQuarantine ? 'bg-warning text-dark' : 'bg-success text-white';

                tbody.innerHTML = `
                    <tr>
                        <td class="text-center text-muted fw-bold">1</td>
                        <td class="text-start">
                            <span class="fw-bold text-dark d-block" id="slipItemDesc">${vendor ? vendor + ' Procurement Consignment Items' : 'Procurement Batch Intake Items'}</span>
                            <span class="text-muted extra-small">Technical specifications matching Purchase Order ${poNo || ''}</span>
                        </td>
                        <td class="text-center font-monospace">8471</td>
                        <td class="text-center fw-semibold">${parsedUnits} Units</td>
                        <td class="text-center fw-bold text-primary">${parsedUnits} Units</td>
                        <td class="text-center fw-bold text-success">${acceptedInit} Units</td>
                        <td class="text-center fw-bold ${quarInit > 0 ? 'text-warning' : 'text-muted'}">${quarInit} Units</td>
                        <td class="text-center">
                            <span class="badge ${verdictBadgeClass} fw-bold px-2 py-0.5 rounded-pill" style="font-size: 0.68rem;">${verdictInit}</span>
                        </td>
                        <td class="text-start extra-small text-muted">${isQuarantine ? 'Laboratory calibration testing in progress' : 'Inspected and verified against PO'}</td>
                    </tr>
                `;
            }

            // Immediately launch modal with zero delay
            showGRNSlipModalDirect(document.getElementById('grnSlipModal'));

            // 2. Asynchronously hydrate complete order-specific line items and logistics telemetry from server
            $.ajax({
                url: '@Url.Action("GetGRNDetails", "Purchase")',
                type: 'GET',
                data: { grnNumber: currentActiveGRN },
                success: function (res) {
                    if (res && res.success) {
                        hydrateGRNSlipDetails(res);
                    }
                },
                error: function (err) {
                    console.warn('GetGRNDetails background hydration warning:', err);
                }
            });
        }

        function updateModalStatusBadge(status) {
            var badge = document.getElementById('slipStatusBadge');
            if (!badge) return;

            var st = (status || '').toLowerCase();
            if (st.includes('quarantine')) {
                badge.className = 'badge bg-warning-subtle text-warning-emphasis extra-small fw-bold border border-warning';
                badge.innerHTML = '<i class="fa fa-triangle-exclamation me-1"></i> Quality Quarantine';
            } else if (st.includes('matched')) {
                badge.className = 'badge bg-success-subtle text-success extra-small fw-bold border border-success-subtle';
                badge.innerHTML = '<i class="fa fa-handshake-angle me-1"></i> 3-Way Matched';
            } else if (st.includes('stocked') || st.includes('completed')) {
                badge.className = 'badge bg-purple-subtle text-purple extra-small fw-bold border' ;
                badge.style.cssText = 'background:#f5f3ff; color:#7c3aed; border-color:#ddd6fe;';
                badge.innerHTML = '<i class="fa fa-boxes-stacked me-1"></i> Completed & Stocked';
            } else {
                badge.className = 'badge bg-success-subtle text-success extra-small fw-bold border border-success-subtle';
                badge.innerHTML = '<i class="fa fa-circle-check me-1"></i> ' + (status || 'Inspected & Accepted');
            }
        }

        function hydrateGRNSlipDetails(data) {
            currentSlipData = data;

            // Statutory & Vendor
            if (data.vendorGstin && document.getElementById('slipVendorGstin')) {
                document.getElementById('slipVendorGstin').innerText = 'GSTIN: ' + data.vendorGstin;
            }
            if (data.vendorAddress && document.getElementById('slipVendorAddress')) {
                document.getElementById('slipVendorAddress').innerText = data.vendorAddress;
                document.getElementById('slipVendorAddress').title = data.vendorAddress;
            }
            if (data.storageBin && document.getElementById('slipStorageBin')) {
                document.getElementById('slipStorageBin').innerText = 'Storage Bin: ' + data.storageBin;
            }

            // Transport & Challan
            if (data.deliveryChallanNo && document.getElementById('slipChallan')) {
                document.getElementById('slipChallan').innerText = data.deliveryChallanNo;
            }
            if (data.challanDate && document.getElementById('slipChallanDate')) {
                document.getElementById('slipChallanDate').innerText = '(' + data.challanDate + ')';
            }
            if (data.carrier && document.getElementById('slipCarrier')) {
                document.getElementById('slipCarrier').innerText = data.carrier;
            }
            if (data.vehicleNumber && document.getElementById('slipVehicle')) {
                document.getElementById('slipVehicle').innerText = data.vehicleNumber;
            }
            if (data.receivingGate && document.getElementById('slipGate')) {
                document.getElementById('slipGate').innerText = data.receivingGate;
            }

            // QA Remarks
            if (data.inspectorRemarks && document.getElementById('slipInspectorRemarks')) {
                document.getElementById('slipInspectorRemarks').innerText = data.inspectorRemarks;
            }

            // Quality status
            updateModalStatusBadge(data.status);

            // 3-Way Match Banner & Interactive Quarantine Actions
            var bannerContainer = document.getElementById('slipMatchBannerContainer');
            var footerAction = document.getElementById('slipFooterQuarantineAction');
            var isQuarantine = (data.status || '').toLowerCase().includes('quarantine');

            if (isQuarantine) {
                if (bannerContainer) {
                    bannerContainer.innerHTML = `
                        <div class="p-3 bg-warning-subtle rounded-3 border border-warning-subtle d-flex flex-wrap align-items-center justify-content-between gap-3">
                            <div class="d-flex align-items-center gap-2.5">
                                <i class="fa fa-triangle-exclamation fs-3 text-warning"></i>
                                <div>
                                    <span class="fw-bold text-dark d-block small">Quality Quarantine Protocol Active</span>
                                    <span class="text-muted extra-small">Automated 3-Way Match & AP payment disbursement held pending final metallurgical / tolerance verification.</span>
                                </div>
                            </div>
                            <div class="d-flex align-items-center gap-2">
                                <button type="button" class="btn btn-sm btn-success rounded-pill px-3 shadow-sm fw-bold" id="btnQuarantineReleaseBanner" onclick="releaseFromQuarantine()">
                                    <i class="fa fa-circle-check me-1.5"></i> Pass Quality & Release to Stock
                                </button>
                                <span class="badge bg-warning text-dark px-2.5 py-1 fw-bold" style="font-size: 0.7rem;">QC HOLD</span>
                            </div>
                        </div>
                    `;
                }

                if (footerAction) {
                    footerAction.innerHTML = `
                        <button type="button" class="btn btn-success rounded-pill px-3 shadow-sm fw-bold" id="btnQuarantineReleaseFooter" onclick="releaseFromQuarantine()">
                            <i class="fa fa-circle-check me-1.5"></i> Pass Quality & Release to Stock
                        </button>
                    `;
                }
            } else {
                if (bannerContainer) {
                    bannerContainer.innerHTML = `
                        <div class="p-3 bg-success-subtle rounded-3 border border-success-subtle d-flex flex-wrap align-items-center justify-content-between gap-2">
                            <div class="d-flex align-items-center gap-2.5">
                                <i class="fa fa-shield-check fs-4 text-success"></i>
                                <div>
                                    <span class="fw-bold text-success d-block small">${data.threeWayMatchStatus || '3-Way Match Protocol Passed'}</span>
                                    <span class="text-muted extra-small">Purchase Order, Physical Goods Receipt, and Vendor Commercial Invoice matched with 0.00% variance.</span>
                                </div>
                            </div>
                            <span class="badge bg-success text-white px-2.5 py-1 fw-bold" style="font-size: 0.7rem;">AUDIT PASSED</span>
                        </div>
                    `;
                }

                if (footerAction) {
                    footerAction.innerHTML = '';
                }
            }

            // Render authentic order items
            if (data.items && data.items.length > 0) {
                var tbody = document.getElementById('slipItemsTableBody');
                var totalPo = 0;
                var totalRec = 0;
                var totalAcc = 0;
                var totalQuar = 0;

                var html = '';
                data.items.forEach(function (item, idx) {
                    totalPo += item.poQty || 0;
                    totalRec += item.receivedQty || 0;
                    totalAcc += item.acceptedQty || 0;
                    totalQuar += item.quarantineQty || 0;

                    var verdictClass = 'bg-success text-white';
                    var verd = (item.verdict || '').toLowerCase();
                    if (verd.includes('quarantine') || verd.includes('hold')) {
                        verdictClass = 'bg-warning text-dark';
                    } else if (verd.includes('stock')) {
                        verdictClass = 'bg-primary text-white';
                    } else if (verd.includes('reject')) {
                        verdictClass = 'bg-danger text-white';
                    }

                    html += `
                        <tr>
                            <td class="text-center text-muted fw-bold">${idx + 1}</td>
                            <td class="text-start">
                                <span class="fw-bold text-dark d-block">${item.item}</span>
                                <span class="text-muted extra-small">${item.specification}</span>
                            </td>
                            <td class="text-center font-monospace">${item.hsn || '-'}</td>
                            <td class="text-center fw-semibold">${item.poQty} ${item.unit || ''}</td>
                            <td class="text-center fw-bold text-primary">${item.receivedQty} ${item.unit || ''}</td>
                            <td class="text-center fw-bold text-success">${item.acceptedQty} ${item.unit || ''}</td>
                            <td class="text-center fw-bold ${item.quarantineQty > 0 ? 'text-warning' : 'text-muted'}">${item.quarantineQty} ${item.unit || ''}</td>
                            <td class="text-center">
                                <span class="badge ${verdictClass} fw-bold px-2 py-0.5 rounded-pill" style="font-size: 0.68rem;">${item.verdict}</span>
                            </td>
                            <td class="text-start extra-small text-muted">${item.remarks || '-'}</td>
                        </tr>
                    `;
                });

                if (tbody) tbody.innerHTML = html;

                // Update footer totals
                if (document.getElementById('footPoQty')) document.getElementById('footPoQty').innerText = totalPo + ' Units';
                if (document.getElementById('footReceivedQty')) document.getElementById('footReceivedQty').innerText = totalRec + ' Units';
                if (document.getElementById('footAcceptedQty')) document.getElementById('footAcceptedQty').innerText = totalAcc + ' Units';
                if (document.getElementById('footQuarantineQty')) document.getElementById('footQuarantineQty').innerText = totalQuar + ' Units';
            }
        }

        function releaseFromQuarantine() {
            if (!currentActiveGRN) return;

            var btnBanner = document.getElementById('btnQuarantineReleaseBanner');
            var btnFooter = document.getElementById('btnQuarantineReleaseFooter');
            var loadingHtml = '<i class="fa fa-spinner fa-spin me-1.5"></i> Releasing to Stock...';

            if (btnBanner) { btnBanner.disabled = true; btnBanner.innerHTML = loadingHtml; }
            if (btnFooter) { btnFooter.disabled = true; btnFooter.innerHTML = loadingHtml; }

            $.ajax({
                url: '@Url.Action("UpdateGRNStatus", "Purchase")',
                type: 'POST',
                data: {
                    grnNumber: currentActiveGRN,
                    status: 'Inspected & Accepted',
                    remarks: 'Quarantine inspection completed. Secondary metallurgical calibration verified within allowable 0.05% tolerance. Goods cleared and released to warehouse bin.'
                },
                success: function (res) {
                    if (res && res.success) {
                        showGRNToast(res.message, true);

                        // 1. Update modal UI to accepted state
                        updateModalStatusBadge('Inspected & Accepted');

                        var bannerContainer = document.getElementById('slipMatchBannerContainer');
                        if (bannerContainer) {
                            bannerContainer.innerHTML = `
                                <div class="p-3 bg-success-subtle rounded-3 border border-success-subtle d-flex flex-wrap align-items-center justify-content-between gap-2">
                                    <div class="d-flex align-items-center gap-2.5">
                                        <i class="fa fa-shield-check fs-4 text-success"></i>
                                        <div>
                                            <span class="fw-bold text-success d-block small">3-Way Match Protocol Passed (Released from Quarantine)</span>
                                            <span class="text-muted extra-small">Consignment released by Quality Auditor. 0.00% variance verified. Automated AP Voucher cleared for disbursement.</span>
                                        </div>
                                    </div>
                                    <span class="badge bg-success text-white px-2.5 py-1 fw-bold" style="font-size: 0.7rem;">AUDIT PASSED</span>
                                </div>
                            `;
                        }

                        var footerAction = document.getElementById('slipFooterQuarantineAction');
                        if (footerAction) footerAction.innerHTML = '';

                        if (document.getElementById('slipInspectorRemarks')) {
                            document.getElementById('slipInspectorRemarks').innerText = 'Quarantine inspection completed. Secondary metallurgical calibration verified within allowable 0.05% tolerance. Goods cleared and released to warehouse bin.';
                        }

                        // Update table rows in modal items to accepted
                        var rows = document.querySelectorAll('#slipItemsTableBody tr');
                        rows.forEach(function (r) {
                            var recCell = r.children[4];
                            var accCell = r.children[5];
                            var quarCell = r.children[6];
                            var verdBadge = r.children[7].querySelector('.badge');
                            var remCell = r.children[8];

                            if (recCell && accCell && quarCell) {
                                accCell.innerText = recCell.innerText;
                                quarCell.innerText = '0 Units';
                                quarCell.className = 'text-center fw-bold text-muted';
                            }
                            if (verdBadge) {
                                verdBadge.className = 'badge bg-success text-white fw-bold px-2 py-0.5 rounded-pill';
                                verdBadge.innerText = 'PASSED QC';
                            }
                            if (remCell) {
                                remCell.innerText = 'Quality cleared following secondary calibration sign-off.';
                            }
                        });

                        var footAcc = document.getElementById('footAcceptedQty');
                        var footRec = document.getElementById('footReceivedQty');
                        var footQuar = document.getElementById('footQuarantineQty');
                        if (footAcc && footRec) footAcc.innerText = footRec.innerText;
                        if (footQuar) footQuar.innerText = '0 Units';

                        // 2. Update Ledger table row live
                        var statusCell = document.getElementById('status-cell-' + currentActiveGRN);
                        if (statusCell) {
                            statusCell.innerHTML = `
                                <span class="grn-status grn-status-default">
                                    <i class="fa fa-circle-check"></i>
                                    Inspected & Accepted
                                </span>
                            `;
                        }

                        // Update data attributes on row
                        var rowEl = document.getElementById('row-' + currentActiveGRN);
                        if (rowEl) {
                            rowEl.querySelectorAll('.grn-slip-btn, .grn-slip-link').forEach(function (el) {
                                el.setAttribute('data-status', 'Inspected & Accepted');
                            });
                        }

                        // 3. Update KPI Card counts
                        var kpiQuar = document.getElementById('kpiQuarantineCount');
                        if (kpiQuar && res.quarantineCount !== undefined) {
                            kpiQuar.innerText = res.quarantineCount;
                        }
                    } else {
                        showGRNToast(res.message || 'Failed to update quarantine status.', false);
                        if (btnBanner) { btnBanner.disabled = false; btnBanner.innerHTML = '<i class="fa fa-circle-check me-1.5"></i> Pass Quality & Release to Stock'; }
                        if (btnFooter) { btnFooter.disabled = false; btnFooter.innerHTML = '<i class="fa fa-circle-check me-1.5"></i> Pass Quality & Release to Stock'; }
                    }
                },
                error: function () {
                    showGRNToast('Communication error during quarantine release.', false);
                    if (btnBanner) { btnBanner.disabled = false; btnBanner.innerHTML = '<i class="fa fa-circle-check me-1.5"></i> Pass Quality & Release to Stock'; }
                    if (btnFooter) { btnFooter.disabled = false; btnFooter.innerHTML = '<i class="fa fa-circle-check me-1.5"></i> Pass Quality & Release to Stock'; }
                }
            });
        }

        function printGRNSlip() {
            var printContents = document.getElementById('printableGRNSlipArea');
            if (!printContents) return;

            var grnNo = document.getElementById('slipGrnNumber') ? document.getElementById('slipGrnNumber').innerText : 'GRN-Slip';
            var win = window.open('', '', 'height=850,width=1050');
            win.document.write('<!DOCTYPE html><html><head><title>Official Goods Receipt Note - ' + grnNo + '</title>');
            win.document.write('<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">');
            win.document.write('<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">');
            win.document.write(`
                <style>
                    body {
                        padding: 30px;
                        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Arial, sans-serif;
                        color: #1e293b;
                        background: #fff;
                    }
                    .badge { border: 1px solid #cbd5e1; }
                    .table { border: 1px solid #cbd5e1; }
                    .table th, .table td { border-color: #e2e8f0; }
                    @@media print {
                        body { padding: 0; }
                        button { display: none !important; }
                        @@page { margin: 1.5cm; }
                    }
                <\/style>
            `);
            win.document.write('<\/head><body>');
            win.document.write(printContents.innerHTML);
            win.document.write('<\/body><\/html>');
            win.document.close();
            win.focus();
            setTimeout(function () {
                win.print();
                win.close();
            }, 600);
        }

        function onScanPOSelected() {
            var sel = document.getElementById('scanPoSelect');
            var opt = sel.options[sel.selectedIndex];
            if (opt) {
                document.getElementById('scanVendorName').value = opt.getAttribute('data-vendor') || '';
                document.getElementById('scanUnitsReceived').value = opt.getAttribute('data-qty') || '25';
            }
        }

        $('#inwardScanForm').on('submit', function (e) {
            e.preventDefault();
            var btn = $('#btnSubmitScan');
            btn.prop('disabled', true).html('<i class="fa fa-spinner fa-spin me-1.5"></i> Registering Intake...');

            var payload = {
                PONumber: $('#scanPoSelect').val(),
                VendorName: $('#scanVendorName').val(),
                Warehouse: $('#scanWarehouse').val(),
                ItemsReceived: parseInt($('#scanUnitsReceived').val()) || 1,
                InspectedBy: $('#scanInspector').val(),
                Status: $('#scanStatus').val()
            };

            $.ajax({
                url: '@Url.Action("CreateGRN", "Purchase")',
                type: 'POST',
                data: payload,
                success: function (res) {
                    btn.prop('disabled', false).html('<i class="fa fa-check-circle me-1"></i> Generate & Sign GRN Slip');
                    var modal = bootstrap.Modal.getInstance(document.getElementById('inwardScanModal'));
                    if (modal) modal.hide();

                    if (res && res.success) {
                        showGRNToast(res.message, true);
                        var newGrn = res.grnNumber || 'GRN-2026-NEW';
                        var today = new Date().toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' });

                        var isQuar = (payload.Status || '').includes('Quarantine');
                        var isMatch = (payload.Status || '').includes('Matched');
                        var statusBadgeHtml = isQuar
                            ? '<span class="grn-status grn-status-quarantine"><i class="fa fa-triangle-exclamation"></i> Quarantine</span>'
                            : (isMatch 
                                ? '<span class="grn-status grn-status-matched"><i class="fa fa-handshake-angle"></i> 3-Way Matched</span>'
                                : `<span class="grn-status grn-status-default"><i class="fa fa-circle-check"></i> ${payload.Status}</span>`);

                        var newRow = `
                            <tr class="grn-data-row" id="row-${newGrn}" data-grn="${newGrn}" style="background: rgba(16, 185, 129, 0.08); transition: all 0.4s ease;">
                                <td>
                                    <a href="/Purchase/Slip?grnNumber=${newGrn}"
                                       class="grn-number grn-slip-link text-decoration-none d-inline-flex align-items-center gap-1.5"
                                       title="View Official GRN Inward Slip for ${newGrn}">
                                        <i class="fa fa-receipt text-primary" style="font-size: 0.72rem;"></i>
                                        <span>${newGrn}</span>
                                    </a>
                                </td>
                                <td><span class="grn-po">${payload.PONumber}</span></td>
                                <td><span class="grn-vendor">${payload.VendorName}</span></td>
                                <td><span class="grn-date"><i class="fa fa-calendar-day me-1"></i>${today}</span></td>
                                <td><span class="grn-warehouse"><i class="fa fa-warehouse"></i>${payload.Warehouse}</span></td>
                                <td><span class="grn-units">${payload.ItemsReceived}</span><span class="text-muted ms-1" style="font-size:0.63rem;">Units</span></td>
                                <td><span class="grn-inspector"><i class="fa fa-user-check"></i>${payload.InspectedBy}</span></td>
                                <td id="status-cell-${newGrn}">${statusBadgeHtml}</td>
                                <td class="text-end">
                                    <a href="/Purchase/Slip?grnNumber=${newGrn}" class="btn btn-sm btn-outline-primary grn-slip-btn shadow-sm"
                                       data-grn="${newGrn}" title="View official GRN inward slip">
                                        <i class="fa fa-receipt me-1"></i> Slip
                                    </a>
                                </td>
                            </tr>
                        `;

                        $('#grnDataTable tbody').prepend(newRow);
                        $('#inwardScanForm')[0].reset();

                        // Live KPI updates
                        var totalKpi = document.getElementById('kpiTotalGRNs');
                        if (totalKpi) totalKpi.innerText = parseInt(totalKpi.innerText || '0') + 1;

                        var unitsKpi = document.getElementById('kpiUnitsReceived');
                        if (unitsKpi) {
                            var currentVal = parseInt((unitsKpi.innerText || '0').replace(/,/g, '')) || 0;
                            unitsKpi.innerText = (currentVal + payload.ItemsReceived).toLocaleString('en-IN');
                        }

                        if (isQuar) {
                            var quarKpi = document.getElementById('kpiQuarantineCount');
                            if (quarKpi) quarKpi.innerText = parseInt(quarKpi.innerText || '0') + 1;
                        } else if (isMatch) {
                            var matchKpi = document.getElementById('kpiMatchedCount');
                            if (matchKpi) matchKpi.innerText = parseInt(matchKpi.innerText || '0') + 1;
                        }

                        filterGRNTable();
                    } else {
                        showGRNToast('Failed to create Goods Receipt Note.', false);
                    }
                },
                error: function () {
                    btn.prop('disabled', false).html('<i class="fa fa-check-circle me-1"></i> Generate & Sign GRN Slip');
                    showGRNToast('Communication error during material inward registration.', false);
                }
            });
        });

        function filterGRNTable() {
            var input = document.getElementById("grnSearch");
            var filter = input ? input.value.toUpperCase() : "";
            var table = document.getElementById("grnDataTable");
            if (!table) return;

            var rows = table.getElementsByTagName("tr");
            var visibleCount = 0;

            for (var i = 1; i < rows.length; i++) {
                var row = rows[i];
                var text = row.textContent || row.innerText;
                if (text.toUpperCase().indexOf(filter) > -1) {
                    row.style.display = "";
                    visibleCount++;
                } else {
                    row.style.display = "none";
                }
            }

            var countElement = document.getElementById("grnVisibleCount");
            if (countElement) countElement.textContent = visibleCount;

            var emptyState = document.getElementById("grnEmptyState");
            if (emptyState) emptyState.style.display = visibleCount === 0 ? "block" : "none";
        }

        // Note: .grn-slip-btn and .grn-slip-link are anchor tags linking directly to /Purchase/Slip

        document.addEventListener("DOMContentLoaded", function () {
            filterGRNTable();
        });
    </script>

}
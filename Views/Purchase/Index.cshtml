@model ERP_System.Models.PurchaseDashboardViewModel
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Purchase Manager Control Hub";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

<style>
    /* ================================================================
           PURCHASE MANAGER CONTROL HUB
           Premium Responsive ERP Procurement UI
           ================================================================ */

    :root {
        --hub-primary: #2563eb;
        --hub-primary-dark: #1d4ed8;
        --hub-cyan: #0891b2;
        --hub-emerald: #059669;
        --hub-amber: #d97706;
        --hub-red: #dc2626;
        --hub-purple: #7c3aed;
        --hub-bg: #f5f7fb;
        --hub-card: rgba(255, 255, 255, 0.96);
        --hub-border: #e7ebf2;
        --hub-text: #172033;
        --hub-muted: #718096;
        --hub-shadow: 0 8px 24px rgba(15, 23, 42, 0.055), 0 2px 6px rgba(15, 23, 42, 0.025);
        --hub-shadow-hover: 0 18px 42px rgba(15, 23, 42, 0.10), 0 4px 12px rgba(15, 23, 42, 0.04);
    }

    body.dark-mode,
    [data-theme="dark"] {
        --hub-bg: #0f172a;
        --hub-card: rgba(30, 41, 59, 0.96);
        --hub-border: rgba(148, 163, 184, 0.15);
        --hub-text: #f1f5f9;
        --hub-muted: #94a3b8;
        --hub-shadow: 0 12px 30px rgba(0, 0, 0, 0.28);
    }

    /* ================================================================
           MAIN
           ================================================================ */

    .purchase-hub-container {
        width: 100%;
        max-width: 1800px;
        margin: 0 auto;
        padding-bottom: 3rem;
        animation: hubPageIn .55s ease both;
    }

    @@keyframes hubPageIn {
        from {
            opacity: 0;
            transform: translateY(12px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* ================================================================
           HEADER
           ================================================================ */

    .hub-page-header {
        position: relative;
        padding: 1.35rem 1.5rem;
        margin-bottom: 1.35rem;
        border: 1px solid var(--hub-border);
        border-radius: 18px;
        background: var(--hub-card);
        box-shadow: var(--hub-shadow);
        overflow: hidden;
    }

        .hub-page-header::before {
            content: "";
            position: absolute;
            left: 0;
            top: 0;
            width: 4px;
            height: 100%;
            background: linear-gradient( 180deg, var(--hub-primary), var(--hub-cyan), var(--hub-emerald) );
        }

        .hub-page-header::after {
            content: "";
            position: absolute;
            width: 180px;
            height: 180px;
            right: -70px;
            top: -90px;
            border-radius: 50%;
            background: rgba(37, 99, 235, 0.055);
            pointer-events: none;
        }

    .hub-title {
        color: var(--hub-text);
        font-size: 1.42rem;
        font-weight: 800;
        letter-spacing: -0.025em;
        line-height: 1.2;
    }

    .hub-subtitle {
        color: var(--hub-muted);
        font-size: .82rem;
        line-height: 1.55;
    }

    .hub-module-badge {
        display: inline-flex;
        align-items: center;
        gap: .4rem;
        padding: .34rem .65rem;
        border-radius: 7px;
        background: #f1f5f9;
        color: #475569;
        border: 1px solid #e2e8f0;
        font-size: .65rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: .06em;
    }

    .hub-live-badge {
        display: inline-flex;
        align-items: center;
        gap: .35rem;
        padding: .34rem .65rem;
        border-radius: 999px;
        background: rgba(16, 185, 129, .10);
        color: #059669;
        border: 1px solid rgba(16, 185, 129, .18);
        font-size: .68rem;
        font-weight: 800;
    }

    .hub-live-dot {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: #10b981;
        box-shadow: 0 0 0 4px rgba(16, 185, 129, .10);
        animation: liveDotPulse 2s infinite;
    }

    @@keyframes liveDotPulse {
        0%, 100% {
            transform: scale(1);
            opacity: 1;
        }

        50% {
            transform: scale(.75);
            opacity: .65;
        }
    }

    /* ================================================================
           HEADER ACTIONS
           ================================================================ */

    .hub-nav-btn {
        display: inline-flex;
        align-items: center;
        gap: .42rem;
        min-height: 36px;
        padding: .45rem .8rem;
        border-radius: 9px;
        border: 1px solid var(--hub-border);
        background: #fff;
        color: #475569;
        font-size: .75rem;
        font-weight: 700;
        text-decoration: none;
        transition: all .2s ease;
    }

        .hub-nav-btn:hover {
            color: var(--hub-primary);
            border-color: rgba(37, 99, 235, .25);
            background: rgba(37, 99, 235, .045);
            transform: translateY(-1px);
        }

    .btn-hub-primary {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: .4rem;
        min-height: 38px;
        padding: .55rem 1rem;
        border: none;
        border-radius: 9px;
        background: linear-gradient(135deg, #2563eb, #1d4ed8);
        color: #fff;
        font-size: .78rem;
        font-weight: 750;
        box-shadow: 0 6px 16px rgba(37, 99, 235, .23);
        transition: all .2s ease;
    }

        .btn-hub-primary:hover {
            color: #fff;
            transform: translateY(-2px);
            box-shadow: 0 10px 24px rgba(37, 99, 235, .30);
            background: linear-gradient(135deg, #1d4ed8, #1e40af);
        }

        .btn-hub-primary:disabled {
            opacity: .7;
            transform: none;
        }

    /* ================================================================
           COMMON CARD
           ================================================================ */

    .glass-card {
        position: relative;
        background: var(--hub-card);
        border: 1px solid var(--hub-border);
        border-radius: 16px;
        box-shadow: var(--hub-shadow);
        overflow: hidden;
        transition: transform .25s cubic-bezier(.16, 1, .3, 1), box-shadow .25s ease, border-color .25s ease;
    }

        .glass-card:hover {
            transform: translateY(-2px);
            box-shadow: var(--hub-shadow-hover);
            border-color: rgba(37, 99, 235, .13);
        }

    .hub-section-header {
        padding: 1.05rem 1.25rem;
        border-bottom: 1px solid var(--hub-border);
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        background: linear-gradient( 180deg, rgba(248, 250, 252, .72), rgba(255, 255, 255, .45) );
    }

    .hub-section-title {
        color: var(--hub-text);
        font-size: .93rem;
        font-weight: 800;
        margin: 0;
        letter-spacing: -.01em;
    }

    .hub-section-subtitle {
        display: block;
        color: var(--hub-muted);
        font-size: .71rem;
        margin-top: .22rem;
        line-height: 1.4;
    }

    /* ================================================================
           KPI CARDS
           ================================================================ */

    .hub-kpi-card {
        position: relative;
        height: 100%;
        padding: 1.1rem 1.15rem;
        background: var(--hub-card);
        border: 1px solid var(--hub-border);
        border-radius: 15px;
        box-shadow: var(--hub-shadow);
        overflow: hidden;
        transition: all .25s ease;
    }

        .hub-kpi-card:hover {
            transform: translateY(-3px);
            box-shadow: var(--hub-shadow-hover);
        }

        .hub-kpi-card::after {
            content: "";
            position: absolute;
            width: 110px;
            height: 110px;
            right: -45px;
            bottom: -55px;
            border-radius: 50%;
            opacity: .6;
        }

    .hub-kpi-cyan {
        border-left: 4px solid var(--hub-cyan);
    }

        .hub-kpi-cyan::after {
            background: rgba(8, 145, 178, .08);
        }

    .hub-kpi-blue {
        border-left: 4px solid var(--hub-primary);
    }

        .hub-kpi-blue::after {
            background: rgba(37, 99, 235, .08);
        }

    .hub-kpi-amber {
        border-left: 4px solid var(--hub-amber);
    }

        .hub-kpi-amber::after {
            background: rgba(217, 119, 6, .08);
        }

    .hub-kpi-green {
        border-left: 4px solid var(--hub-emerald);
    }

        .hub-kpi-green::after {
            background: rgba(5, 150, 105, .08);
        }

    .hub-kpi-label {
        display: block;
        color: var(--hub-muted);
        font-size: .68rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: .055em;
        line-height: 1.4;
    }

    .hub-kpi-value {
        display: inline-flex;
        align-items: baseline;
        gap: .3rem;
        margin-top: .4rem;
        color: var(--hub-text);
        font-size: 1.48rem;
        font-weight: 800;
        line-height: 1.2;
        letter-spacing: -.025em;
    }

    .hub-kpi-icon {
        width: 46px;
        height: 46px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        font-size: 1.05rem;
    }

    .hub-icon-cyan {
        color: #0891b2;
        background: rgba(6, 182, 212, .11);
        border: 1px solid rgba(6, 182, 212, .14);
    }

    .hub-icon-blue {
        color: #2563eb;
        background: rgba(59, 130, 246, .11);
        border: 1px solid rgba(59, 130, 246, .14);
    }

    .hub-icon-amber {
        color: #d97706;
        background: rgba(245, 158, 11, .11);
        border: 1px solid rgba(245, 158, 11, .14);
    }

    .hub-icon-green {
        color: #059669;
        background: rgba(16, 185, 129, .11);
        border: 1px solid rgba(16, 185, 129, .14);
    }

    .hub-kpi-footer {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: .45rem;
        margin-top: .65rem;
    }

    .hub-mini-badge {
        display: inline-flex;
        align-items: center;
        gap: .3rem;
        padding: .25rem .52rem;
        border-radius: 999px;
        font-size: .65rem;
        font-weight: 750;
        white-space: nowrap;
    }

    .hub-badge-cyan {
        color: #0e7490;
        background: rgba(6, 182, 212, .10);
    }

    .hub-badge-blue {
        color: #1d4ed8;
        background: rgba(59, 130, 246, .10);
    }

    .hub-badge-red {
        color: #b91c1c;
        background: rgba(239, 68, 68, .10);
    }

    .hub-badge-green {
        color: #047857;
        background: rgba(16, 185, 129, .10);
    }

    .hub-mini-note {
        color: var(--hub-muted);
        font-size: .68rem;
    }

    /* ================================================================
           COMPACT MONEY
           ================================================================ */

    .compact-money {
        display: inline-flex;
        align-items: center;
        color: inherit;
        font-weight: inherit;
        cursor: help;
        border-bottom: 1px dashed rgba(100, 116, 139, .35);
        text-decoration: none;
    }

        .compact-money:hover {
            border-bottom-color: var(--hub-primary);
        }

    /* ================================================================
           CHART CARDS
           ================================================================ */

    .hub-chart-card {
        padding: 1.15rem;
    }

    .hub-chart-heading {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 1rem;
        padding-bottom: .85rem;
        margin-bottom: .9rem;
        border-bottom: 1px solid var(--hub-border);
    }

    .hub-chart-title {
        color: var(--hub-text);
        font-size: .9rem;
        font-weight: 800;
        margin: 0;
    }

    .hub-chart-description {
        color: var(--hub-muted);
        font-size: .7rem;
        margin-top: .25rem;
        display: block;
    }

    .hub-period-btn {
        border: 1px solid var(--hub-border);
        background: #fff;
        color: #64748b;
        font-size: .68rem;
        font-weight: 700;
        padding: .36rem .65rem;
        transition: all .2s ease;
    }

        .hub-period-btn:hover,
        .hub-period-btn.active {
            background: rgba(37, 99, 235, .08);
            color: var(--hub-primary);
            border-color: rgba(37, 99, 235, .22);
        }

    .hub-chart-area {
        position: relative;
        width: 100%;
        height: 315px;
    }

    .hub-doughnut-area {
        position: relative;
        width: 100%;
        height: 215px;
    }

    .hub-kpi-tag {
        display: inline-flex;
        align-items: center;
        padding: .28rem .55rem;
        border-radius: 999px;
        color: #1d4ed8;
        background: rgba(59, 130, 246, .08);
        border: 1px solid rgba(59, 130, 246, .12);
        font-size: .62rem;
        font-weight: 800;
    }

    .hub-legend {
        padding-top: .75rem;
        border-top: 1px solid var(--hub-border);
    }

    .hub-legend-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: .75rem;
        padding: .27rem 0;
        color: var(--hub-muted);
        font-size: .72rem;
    }

    .hub-legend-label {
        display: inline-flex;
        align-items: center;
        gap: .45rem;
    }

    .hub-legend-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        flex-shrink: 0;
    }

    /* ================================================================
           FULL-WIDTH OPERATION SECTIONS
           ================================================================ */

    .operations-stack {
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    .operation-card {
        width: 100%;
    }

        .operation-card .hub-section-header {
            min-height: 74px;
        }

    .operation-number {
        width: 28px;
        height: 28px;
        border-radius: 8px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        color: #fff;
        font-size: .68rem;
        font-weight: 800;
        flex-shrink: 0;
    }

    .operation-number-one {
        background: linear-gradient(135deg, #f59e0b, #d97706);
    }

    .operation-number-two {
        background: linear-gradient(135deg, #0891b2, #0369a1);
    }

    .operation-heading {
        display: flex;
        align-items: center;
        gap: .65rem;
    }

    /* ================================================================
           TABLE
           ================================================================ */

    .table-hub-wrapper {
        width: 100%;
        overflow-x: auto;
        scrollbar-width: thin;
    }

    .table-hub {
        width: 100%;
        min-width: 850px;
        margin: 0;
        border-collapse: separate;
        border-spacing: 0;
    }

        .table-hub thead th {
            padding: .78rem 1rem;
            color: #64748b;
            background: #f8fafc;
            border-bottom: 1px solid var(--hub-border);
            font-size: .65rem;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: .055em;
            white-space: nowrap;
        }

        .table-hub tbody td {
            padding: .85rem 1rem;
            color: var(--hub-text);
            border-bottom: 1px solid rgba(226, 232, 240, .65);
            font-size: .76rem;
            vertical-align: middle;
            background: transparent;
        }

        .table-hub tbody tr {
            transition: background .18s ease, transform .18s ease;
        }

            .table-hub tbody tr:hover {
                background: rgba(248, 250, 252, .78);
            }

            .table-hub tbody tr:last-child td {
                border-bottom: none;
            }

    .hub-table-primary {
        display: block;
        color: var(--hub-text);
        font-weight: 750;
        line-height: 1.35;
    }

    .hub-table-secondary {
        display: block;
        margin-top: .18rem;
        color: var(--hub-muted);
        font-size: .66rem;
        line-height: 1.35;
    }

    /* ================================================================
           STATUS BADGES
           ================================================================ */

    .badge-hub {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: .32rem;
        min-height: 27px;
        padding: .3rem .6rem;
        border-radius: 999px;
        font-size: .64rem;
        font-weight: 750;
        white-space: nowrap;
    }

    .badge-in-transit {
        color: #0e7490;
        background: rgba(6, 182, 212, .10);
        border: 1px solid rgba(6, 182, 212, .18);
    }

    .badge-confirmed {
        color: #1d4ed8;
        background: rgba(59, 130, 246, .10);
        border: 1px solid rgba(59, 130, 246, .18);
    }

    .badge-delivered {
        color: #047857;
        background: rgba(16, 185, 129, .10);
        border: 1px solid rgba(16, 185, 129, .18);
    }

    .badge-urgency-urgent {
        color: #b91c1c;
        background: rgba(239, 68, 68, .10);
        border: 1px solid rgba(239, 68, 68, .18);
        animation: urgencyPulse 2.2s infinite;
    }

    .badge-urgency-high {
        color: #b45309;
        background: rgba(245, 158, 11, .11);
        border: 1px solid rgba(245, 158, 11, .20);
    }

    .badge-urgency-medium {
        color: #475569;
        background: rgba(100, 116, 139, .10);
        border: 1px solid rgba(100, 116, 139, .16);
    }

    @@keyframes urgencyPulse {
        0%, 100% {
            box-shadow: 0 0 0 0 rgba(239, 68, 68, .02);
        }

        50% {
            box-shadow: 0 0 0 4px rgba(239, 68, 68, .06);
        }
    }

    /* ================================================================
           ACTION BUTTONS
           ================================================================ */

    .btn-po-create,
    .btn-po-reject {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: .28rem;
        border-radius: 7px;
        padding: .38rem .65rem;
        font-size: .64rem;
        font-weight: 750;
        transition: all .18s ease;
    }

    .btn-po-create {
        color: #047857;
        background: rgba(16, 185, 129, .09);
        border: 1px solid rgba(16, 185, 129, .20);
    }

        .btn-po-create:hover {
            color: #fff;
            background: #059669;
            border-color: #059669;
            transform: translateY(-1px);
            box-shadow: 0 4px 10px rgba(5, 150, 105, .20);
        }

    .btn-po-reject {
        color: #b91c1c;
        background: rgba(239, 68, 68, .08);
        border: 1px solid rgba(239, 68, 68, .18);
    }

        .btn-po-reject:hover {
            color: #fff;
            background: #dc2626;
            border-color: #dc2626;
            transform: translateY(-1px);
            box-shadow: 0 4px 10px rgba(220, 38, 38, .20);
        }

    .view-all-link {
        display: inline-flex;
        align-items: center;
        gap: .35rem;
        color: var(--hub-primary);
        font-size: .7rem;
        font-weight: 750;
        text-decoration: none;
        transition: all .2s ease;
    }

        .view-all-link:hover {
            color: var(--hub-primary-dark);
            transform: translateX(2px);
        }

    /* ================================================================
           EMPTY STATE
           ================================================================ */

    .hub-empty-state {
        padding: 2.5rem 1rem;
        text-align: center;
        color: var(--hub-muted);
    }

    .hub-empty-icon {
        width: 46px;
        height: 46px;
        margin: 0 auto .65rem;
        border-radius: 13px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #94a3b8;
        background: #f8fafc;
        border: 1px solid var(--hub-border);
    }

    .hub-empty-state strong {
        display: block;
        color: var(--hub-text);
        font-size: .78rem;
        margin-bottom: .2rem;
    }

    .hub-empty-state span {
        font-size: .7rem;
    }

    /* ================================================================
           MODAL
           ================================================================ */

    .modal-glass .modal-dialog {
        max-width: 850px;
    }

    .modal-glass .modal-content {
        border: 1px solid rgba(226, 232, 240, .9);
        border-radius: 18px;
        overflow: hidden;
        box-shadow: 0 30px 70px rgba(15, 23, 42, .20);
    }

    .modal-glass .modal-header {
        padding: 1.15rem 1.3rem;
        background: #f8fafc;
    }

    .modal-glass .modal-body {
        background: #fff;
    }

    .modal-glass .modal-footer {
        padding: .9rem 1.3rem;
        background: #f8fafc;
    }

    .hub-form-label {
        color: #334155;
        font-size: .72rem;
        font-weight: 750;
        margin-bottom: .35rem;
    }

    .hub-form-control,
    .modal-glass .form-select,
    .modal-glass .form-control {
        min-height: 40px;
        border: 1px solid #dbe2ea;
        border-radius: 9px;
        color: #1e293b;
        background: #fff;
        font-size: .76rem;
        box-shadow: none;
        transition: all .18s ease;
    }

        .modal-glass .form-select:focus,
        .modal-glass .form-control:focus {
            border-color: rgba(37, 99, 235, .55);
            box-shadow: 0 0 0 3px rgba(37, 99, 235, .08);
        }

    .modal-glass textarea.form-control {
        min-height: 78px;
        resize: vertical;
    }

    .modal-money-symbol {
        min-width: 40px;
        justify-content: center;
        border: 1px solid #dbe2ea;
        background: #f8fafc;
        color: #475569;
        border-radius: 9px 0 0 9px;
        font-weight: 800;
    }

    .modal-money-input {
        border-radius: 0 9px 9px 0 !important;
    }

    /* ================================================================
           TOAST
           ================================================================ */

    #hubLiveToast {
        border-radius: 11px;
        min-width: 280px;
    }

    /* ================================================================
           RESPONSIVE
           ================================================================ */

    @@media (max-width: 1199.98px) {
        .purchase-hub-container {
            padding-left: .75rem !important;
            padding-right: .75rem !important;
        }

        .hub-title {
            font-size: 1.3rem;
        }

        .hub-chart-area {
            height: 290px;
        }
    }

    @@media (max-width: 991.98px) {
        .hub-page-header {
            padding: 1.1rem;
        }

        .hub-header-actions {
            width: 100%;
        }
        .hub-nav-btn,
        .hub-header-actions .btn-hub-primary {
            flex: 1 1 auto;
        }

        .hub-chart-area {
            height: 280px;
        }

        .hub-doughnut-area {
            height: 230px;
        }
    }

    @@media (max-width: 767.98px) {
        .purchase-hub-container {
            padding-left: .5rem !important;
            padding-right: .5rem !important;
            padding-bottom: 2rem;
        }

        .hub-page-header {
            border-radius: 13px;
            padding: 1rem;
        }

        .hub-title {
            font-size: 1.1rem;
        }

        .hub-subtitle {
            font-size: .74rem;
        }

        .hub-header-actions {
            display: grid !important;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            width: 100%;
        }

        .hub-header-actions .btn-hub-primary {
            grid-column: 1 / -1;
        }

        .hub-nav-btn {
            width: 100%;
            justify-content: center;
        }

        .hub-kpi-card {
            padding: 1rem;
        }

        .hub-kpi-value {
            font-size: 1.32rem;
        }

        .hub-section-header {
            padding: .95rem;
            align-items: flex-start;
        }

        .operation-heading {
            align-items: flex-start;
        }

        .hub-section-subtitle {
            max-width: 95%;
        }

        .hub-chart-card {
            padding: .9rem;
        }

        .hub-chart-heading {
            flex-direction: column;
            align-items: stretch;
        }

        .hub-period-buttons {
            width: 100%;
        }

        .hub-period-buttons .hub-period-btn {
            flex: 1;
        }

        .hub-chart-area {
            height: 255px;
        }

        .hub-doughnut-area {
            height: 220px;
        }

        .operations-stack {
            gap: .85rem;
        }

        #hubLiveToast {
            min-width: 0;
            width: calc(100vw - 2rem);
        }
    }

    @@media (max-width: 479.98px) {
        .hub-module-badge {
            font-size: .57rem;
        }

        .hub-live-badge {
            font-size: .6rem;
        }

        .hub-title {
            font-size: 1rem;
        }

        .hub-kpi-value {
            font-size: 1.2rem;
        }

        .hub-kpi-icon {
            width: 40px;
            height: 40px;
            font-size: .9rem;
        }

        .hub-header-actions {
            grid-template-columns: 1fr;
        }

        .hub-header-actions .btn-hub-primary {
            grid-column: auto;
        }

        .hub-chart-area {
            height: 225px;
        }

        .hub-doughnut-area {
            height: 200px;
        }

        .operation-card .hub-section-header {
            min-height: auto;
        }
    }

    /* ================================================================
       PRINT
       ================================================================ */

    @@media print {
        body {
            background: #fff !important;
        }

        .purchase-hub-container {
            max-width: none;
            padding: 0 !important;
        }

        .hub-page-header,
        .glass-card,
        .hub-kpi-card {
            box-shadow: none !important;
            break-inside: avoid;
        }

        .hub-header-actions,
        .btn-po-create,
        .btn-po-reject,
        .view-all-link {
            display: none !important;
        }
    }

    /* ================================================================
       REDUCED MOTION
       ================================================================ */

    @@media (prefers-reduced-motion: reduce) {
        *,
        *::before,
        *::after {
            animation-duration: .01ms !important;
            animation-iteration-count: 1 !important;
            transition-duration: .01ms !important;
        }
    }
</style>

<div class="purchase-hub-container container-fluid px-2 px-md-3 px-xl-4 mt-3">

    <!-- ================================================================
         TOAST
         ================================================================ -->
    <div class="position-fixed top-0 end-0 p-3" style="z-index: 1090;">
        <div id="hubLiveToast"
             class="toast align-items-center text-white border-0 shadow-lg"
             role="alert"
             aria-live="assertive"
             aria-atomic="true">

            <div class="d-flex">
                <div class="toast-body d-flex align-items-center gap-2">
                    <i id="toastIcon" class="fa fa-circle-check fs-5"></i>
                    <span id="toastMessage">Operation completed successfully.</span>
                </div>

                <button type="button"
                        class="btn-close btn-close-white me-2 m-auto"
                        data-bs-dismiss="toast"
                        aria-label="Close">
                </button>
            </div>
        </div>
    </div>


    <!-- ================================================================
         PAGE HEADER
         ================================================================ -->
    <div class="hub-page-header">

        <div class="d-flex flex-column flex-xl-row justify-content-between align-items-start gap-3">

            <div class="flex-grow-1">

                <div class="d-flex flex-wrap align-items-center gap-2 mb-2">

                    <span class="hub-module-badge">
                        <i class="fa fa-layer-group text-primary"></i>
                        SAP MM / NetSuite Workflow
                    </span>

                    <span class="hub-live-badge">
                        <span class="hub-live-dot"></span>
                        Live Hub
                    </span>

                </div>

                <h3 class="hub-title mb-1 d-flex align-items-center gap-2">
                    <i class="fa fa-cart-flatbed-suitcase text-primary"></i>
                    Purchase Manager Control Hub
                </h3>

                <p class="hub-subtitle mb-0">
                    Procurement governance, vendor performance index, and automated Purchase Order execution.
                </p>

            </div>


            <div class="hub-header-actions d-flex flex-wrap align-items-center gap-2">

                <a href="@Url.Action("Requisitions", "Purchase")"
                   class="hub-nav-btn">
                    <i class="fa fa-clipboard-list"></i>
                    PR Console
                </a>

                <a href="@Url.Action("Orders", "Purchase")"
                   class="hub-nav-btn">
                    <i class="fa fa-file-invoice"></i>
                    PO Registry
                </a>

                <a href="@Url.Action("Vendors", "Purchase")"
                   class="hub-nav-btn">
                    <i class="fa fa-handshake"></i>
                    Scorecards
                </a>

                <a href="@Url.Action("Receipts", "Purchase")"
                   class="hub-nav-btn">
                    <i class="fa fa-boxes"></i>
                    GRN Tracking
                </a>

                <button type="button"
                        class="btn btn-hub-primary"
                        data-bs-toggle="modal"
                        data-bs-target="#createPOModal">
                    <i class="fa fa-plus-circle"></i>
                    Generate Purchase Order
                </button>

            </div>
        </div>

    </div>


    <!-- ================================================================
         KPI CARDS
         ================================================================ -->
    <div class="row g-3 mb-4">

        <!-- TOTAL PROCUREMENT SPEND -->
        <div class="col-12 col-sm-6 col-xl-3">

            <div class="hub-kpi-card hub-kpi-cyan">

                <div class="d-flex justify-content-between align-items-start gap-3">

                    <div class="min-w-0">

                        <span class="hub-kpi-label">
                            Total Procurement Spend
                        </span>

                        <div class="hub-kpi-value">

                            <span class="compact-money"
                                  data-value="@Model.TotalProcurementSpend"
                                  aria-label="Total Procurement Spend">
                                @Model.TotalProcurementSpend
                            </span>

                        </div>

                        <div class="hub-kpi-footer">

                            <span class="hub-mini-badge hub-badge-cyan">
                                <i class="fa fa-arrow-trend-up"></i>
                                +8.4% MoM
                            </span>

                            <span class="hub-mini-note">
                                YTD Budget on track
                            </span>

                        </div>

                    </div>

                    <div class="hub-kpi-icon hub-icon-cyan">
                        <i class="fa fa-wallet"></i>
                    </div>

                </div>

            </div>

        </div>


        <!-- ACTIVE PURCHASE ORDERS -->
        <div class="col-12 col-sm-6 col-xl-3">

            <div class="hub-kpi-card hub-kpi-blue">

                <div class="d-flex justify-content-between align-items-start gap-3">

                    <div>

                        <span class="hub-kpi-label">
                            Active Purchase Orders
                        </span>

                        <div class="hub-kpi-value">
                            @Model.ActiveOrdersCount
                            <span class="fs-6 fw-semibold text-muted">
                                Live Orders
                            </span>
                        </div>

                        <div class="hub-kpi-footer">

                            <span class="hub-mini-badge hub-badge-blue">
                                <i class="fa fa-truck-fast"></i>
                                5 In Transit
                            </span>

                            <span class="hub-mini-note">
                                Avg SLA 4.2 days
                            </span>

                        </div>

                    </div>

                    <div class="hub-kpi-icon hub-icon-blue">
                        <i class="fa fa-file-invoice-dollar"></i>
                    </div>

                </div>

            </div>

        </div>


        <!-- PENDING REQUISITIONS -->
        <div class="col-12 col-sm-6 col-xl-3">

            <div class="hub-kpi-card hub-kpi-amber">

                <div class="d-flex justify-content-between align-items-start gap-3">

                    <div>

                        <span class="hub-kpi-label">
                            Pending PR Approvals
                        </span>

                        <div class="hub-kpi-value">
                            @Model.PendingRequisitionsCount
                            <span class="fs-6 fw-semibold text-warning">
                                Action Req.
                            </span>
                        </div>

                        <div class="hub-kpi-footer">

                            <span class="hub-mini-badge hub-badge-red">
                                <i class="fa fa-triangle-exclamation"></i>
                                2 Critical
                            </span>

                            <span class="hub-mini-note">
                                IT & Operations
                            </span>

                        </div>

                    </div>

                    <div class="hub-kpi-icon hub-icon-amber">
                        <i class="fa fa-clipboard-check"></i>
                    </div>

                </div>

            </div>

        </div>


        <!-- APPROVED VENDORS -->
        <div class="col-12 col-sm-6 col-xl-3">

            <div class="hub-kpi-card hub-kpi-green">

                <div class="d-flex justify-content-between align-items-start gap-3">

                    <div>

                        <span class="hub-kpi-label">
                            Approved Vendors
                        </span>

                        <div class="hub-kpi-value">
                            @Model.ApprovedVendorsCount
                            <span class="fs-6 fw-semibold text-muted">
                                Partners
                            </span>
                        </div>

                        <div class="hub-kpi-footer">

                            <span class="hub-mini-badge hub-badge-green">
                                <i class="fa fa-star"></i>
                                96.4% Compliance
                            </span>

                            <span class="hub-mini-note">
                                ISO-9001 certified
                            </span>

                        </div>

                    </div>

                    <div class="hub-kpi-icon hub-icon-green">
                        <i class="fa fa-handshake"></i>
                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- ================================================================
         PROCUREMENT ANALYTICS
         ================================================================ -->
    <div class="row g-3 mb-4">

        <!-- BAR CHART -->
        <div class="col-12 col-lg-8">

            <div class="glass-card hub-chart-card h-100">

                <div class="hub-chart-heading">

                    <div>

                        <h5 class="hub-chart-title d-flex align-items-center gap-2">
                            <i class="fa fa-chart-column text-primary"></i>
                            Spend by Department & Category
                        </h5>

                        <span class="hub-chart-description">
                            Comparative quarterly material & CAPEX spend across core cost centers
                        </span>

                    </div>

                    <div class="btn-group btn-group-sm hub-period-buttons"
                         role="group">

                        <button type="button"
                                class="hub-period-btn active"
                                onclick="updateChartPeriod('Q3')">
                            Q3 2026
                        </button>

                        <button type="button"
                                class="hub-period-btn"
                                onclick="updateChartPeriod('YTD')">
                            YTD Full
                        </button>

                    </div>

                </div>

                <div class="hub-chart-area">
                    <canvas id="procurementSpendChart"></canvas>
                </div>

            </div>

        </div>


        <!-- DOUGHNUT CHART -->
        <div class="col-12 col-lg-4">

            <div class="glass-card hub-chart-card h-100">

                <div class="hub-chart-heading">

                    <div>

                        <h5 class="hub-chart-title d-flex align-items-center gap-2">
                            <i class="fa fa-chart-pie"
                               style="color:#0891b2;"></i>
                            Vendor SLA Breakdown
                        </h5>

                        <span class="hub-chart-description">
                            On-time fulfillment index
                        </span>

                    </div>

                    <span class="hub-kpi-tag">
                        NetSuite KPI
                    </span>

                </div>


                <div class="hub-doughnut-area">
                    <canvas id="vendorDeliveryChart"></canvas>
                </div>


                <div class="hub-legend">

                    <div class="hub-legend-row">

                        <span class="hub-legend-label">
                            <span class="hub-legend-dot"
                                  style="background:#10b981;"></span>

                            On-Time Deliveries
                        </span>

                        <strong>78%</strong>

                    </div>


                    <div class="hub-legend-row">

                        <span class="hub-legend-label">
                            <span class="hub-legend-dot"
                                  style="background:#06b6d4;"></span>

                            In Transit (Within SLA)
                        </span>

                        <strong>15%</strong>

                    </div>


                    <div class="hub-legend-row">

                        <span class="hub-legend-label">
                            <span class="hub-legend-dot"
                                  style="background:#f59e0b;"></span>

                            Delayed / Pending Port
                        </span>

                        <strong>7%</strong>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- ================================================================
         BOTTOM OPERATIONS
         IMPORTANT:
         1. Urgent Requisition Approvals - FULL WIDTH
         2. Active PO Status Tracker - FULL WIDTH BELOW
         ================================================================ -->

    <div class="operations-stack">

        <!-- ============================================================
             1. URGENT REQUISITION APPROVALS
             ============================================================ -->

        <div class="glass-card operation-card">

            <div class="hub-section-header">

                <div class="operation-heading">

                    <span class="operation-number operation-number-one">
                        01
                    </span>

                    <div>

                        <h5 class="hub-section-title">
                            <i class="fa fa-signature text-warning me-1"></i>
                            Urgent Requisition Approvals
                        </h5>

                        <span class="hub-section-subtitle">
                            One-click Purchase Order generation & rejection triggers
                        </span>

                    </div>

                </div>

                <span class="hub-mini-badge"
                      style="color:#b45309;background:rgba(245,158,11,.10);">
                    @Model.PendingApprovals.Count Pending
                </span>

            </div>


            <div class="table-hub-wrapper">

                <table class="table table-hub align-middle"
                       id="requisitionsTable">

                    <thead>

                        <tr>

                            <th>PR ID & Dept</th>
                            <th>Item Summary</th>
                            <th>Est. Cost</th>
                            <th>Urgency</th>
                            <th class="text-end">Actions</th>

                        </tr>

                    </thead>


                    <tbody>

                        @if (Model.PendingApprovals != null && Model.PendingApprovals.Any())
                        {
                            foreach (var req in Model.PendingApprovals)
                            {
                                <tr id="req-row-@req.Id">

                                    <td>

                                        <span class="hub-table-primary">
                                            #@req.Id
                                        </span>

                                        <span class="hub-table-secondary">
                                            @req.Department
                                        </span>

                                        <span class="hub-table-secondary">
                                            <i class="fa fa-user me-1"></i>
                                            @req.RequestedBy
                                        </span>

                                    </td>


                                    <td>

                                        <span class="hub-table-primary">
                                            @req.ItemSummary
                                        </span>

                                        <span class="hub-table-secondary">
                                            Requested: @req.RequestedOn
                                        </span>

                                    </td>


                                    <td>

                                        <span class="hub-table-primary">
                                            <span class="compact-money"
                                                  data-value="@req.EstimatedCost"
                                                  aria-label="Estimated Cost">
                                                @req.EstimatedCost
                                            </span>
                                        </span>

                                    </td>


                                    <td>

                                        @if (req.Urgency == "Urgent")
                                        {
                                            <span class="badge-hub badge-urgency-urgent">
                                                <i class="fa fa-circle-exclamation"></i>
                                                Urgent
                                            </span>
                                        }
                                        else if (req.Urgency == "High")
                                        {
                                            <span class="badge-hub badge-urgency-high">
                                                <i class="fa fa-clock"></i>
                                                High
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge-hub badge-urgency-medium">
                                                <i class="fa fa-minus"></i>
                                                Medium
                                            </span>
                                        }

                                    </td>


                                    <td class="text-end">

                                        <div class="d-flex justify-content-end gap-1">

                                            <button type="button"
                                                    class="btn btn-po-create"
                                                    title="Convert to Purchase Order"
                                                    onclick="openCreatePOFromReq('@req.Id', '@req.ItemSummary', '@req.EstimatedCost', '@req.Department')">

                                                <i class="fa fa-file-invoice"></i>
                                                Create PO

                                            </button>


                                            <button type="button"
                                                    class="btn btn-po-reject"
                                                    title="Reject Requisition"
                                                    onclick="handleRequisitionAction(@req.Id, 'Rejected')">

                                                <i class="fa fa-xmark"></i>

                                            </button>

                                        </div>

                                    </td>

                                </tr>
                            }
                        }
                        else
                        {
                            <tr>

                                <td colspan="5">

                                    <div class="hub-empty-state">

                                        <div class="hub-empty-icon">
                                            <i class="fa fa-clipboard-check"></i>
                                        </div>

                                        <strong>
                                            No pending requisitions
                                        </strong>

                                        <span>
                                            No requisitions are currently awaiting approval.
                                        </span>

                                    </div>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>


        <!-- ============================================================
             2. ACTIVE PO STATUS TRACKER
             FULL WIDTH BELOW APPROVALS
             ============================================================ -->

        <div class="glass-card operation-card">

            <div class="hub-section-header">

                <div class="operation-heading">

                    <span class="operation-number operation-number-two">
                        02
                    </span>

                    <div>

                        <h5 class="hub-section-title">
                            <i class="fa fa-truck-ramp-box me-1"
                               style="color:#0891b2;"></i>
                            Active PO Status Tracker
                        </h5>

                        <span class="hub-section-subtitle">
                            Real-time shipping milestones & payment terms
                        </span>

                    </div>

                </div>


                <a href="@Url.Action("Orders", "Purchase")"
                   class="view-all-link">

                    View All POs
                    <i class="fa fa-chevron-right"></i>

                </a>

            </div>


            <div class="table-hub-wrapper">

                <table class="table table-hub align-middle"
                       id="activePOTable">

                    <thead>

                        <tr>

                            <th>PO Number</th>
                            <th>Vendor Partner</th>
                            <th>Value</th>
                            <th>Status</th>
                            <th>Terms</th>

                        </tr>

                    </thead>


                    <tbody>

                        @if (Model.RecentPurchaseOrders != null && Model.RecentPurchaseOrders.Any())
                        {
                            foreach (var po in Model.RecentPurchaseOrders)
                            {
                                <tr>

                                    <td>

                                        <span class="hub-table-primary">
                                            @po.PONumber
                                        </span>

                                        <span class="hub-table-secondary">
                                            @po.OrderDate
                                        </span>

                                    </td>


                                    <td>

                                        <span class="hub-table-primary">
                                            @po.VendorName
                                        </span>

                                        <span class="hub-table-secondary">
                                            @po.ItemsCount line items
                                        </span>

                                    </td>


                                    <td>

                                        <span class="hub-table-primary">

                                            <span class="compact-money"
                                                  data-value="@po.TotalAmount"
                                                  aria-label="Purchase Order Value">
                                                @po.TotalAmount
                                            </span>

                                        </span>

                                    </td>


                                    <td>

                                        @if (po.Status == "In Transit")
                                        {
                                            <span class="badge-hub badge-in-transit">

                                                <i class="fa fa-plane-departure"></i>
                                                In Transit

                                            </span>
                                        }
                                        else if (po.Status == "Confirmed")
                                        {
                                            <span class="badge-hub badge-confirmed">

                                                <i class="fa fa-circle-check"></i>
                                                Confirmed

                                            </span>
                                        }
                                        else if (po.Status == "Delivered")
                                        {
                                            <span class="badge-hub badge-delivered">

                                                <i class="fa fa-box-open"></i>
                                                Delivered

                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-light text-dark border">
                                                @po.Status
                                            </span>
                                        }

                                    </td>


                                    <td>

                                        <span class="badge bg-secondary-subtle text-secondary small rounded-pill">
                                            @po.PaymentTerms
                                        </span>

                                    </td>

                                </tr>
                            }
                        }
                        else
                        {
                            <tr>

                                <td colspan="5">

                                    <div class="hub-empty-state">

                                        <div class="hub-empty-icon">
                                            <i class="fa fa-truck"></i>
                                        </div>

                                        <strong>
                                            No active purchase orders
                                        </strong>

                                        <span>
                                            No active purchase orders were found.
                                        </span>

                                    </div>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>


<!-- =====================================================================
     CREATE PURCHASE ORDER MODAL
     ===================================================================== -->

<div class="modal fade modal-glass"
     id="createPOModal"
     tabindex="-1"
     aria-labelledby="createPOModalLabel"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered modal-lg">

        <div class="modal-content border-0">

            <div class="modal-header border-bottom">

                <div>

                    <h5 class="modal-title fw-bold text-dark d-flex align-items-center gap-2"
                        id="createPOModalLabel">

                        <i class="fa fa-file-circle-plus text-primary"></i>

                        Dispatch Purchase Order

                    </h5>

                    <span class="text-muted small">
                        Standard PO creation with vendor SLA and accounting terms
                    </span>

                </div>


                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Close">
                </button>

            </div>


            <form id="createPOForm">

                <div class="modal-body p-3 p-md-4">

                    <input type="hidden"
                           id="modalRequisitionId"
                           name="RequisitionId"
                           value="" />


                    <div class="row g-3">

                        <!-- VENDOR -->
                        <div class="col-12 col-md-6">

                            <label class="hub-form-label">
                                Approved Vendor Partner *
                            </label>

                            <select class="form-select"
                                    id="poVendorName"
                                    name="VendorName"
                                    required>

                                <option value="" disabled selected>
                                    Select Vendor Partner...
                                </option>

                                <option value="TechInfra Solutions Ltd">
                                    TechInfra Solutions Ltd (Rating: 4.8 / Preferred)
                                </option>

                                <option value="Apex Industrial Supplies">
                                    Apex Industrial Supplies (Rating: 4.5 / Tier 1)
                                </option>

                                <option value="National Paper Mills">
                                    National Paper Mills (Rating: 4.2 / Tier 2)
                                </option>

                                <option value="SteelCraft Heavy Metals">
                                    SteelCraft Heavy Metals (Rating: 4.6 / Raw Materials)
                                </option>

                                <option value="Delta Logistics & Freight">
                                    Delta Logistics & Freight (Rating: 3.9 / Logistics)
                                </option>

                                <option value="Global Cloud Corp">
                                    Global Cloud Corp (Rating: 4.9 / Software)
                                </option>

                            </select>

                        </div>


                        <!-- DELIVERY DATE -->
                        <div class="col-12 col-md-6">

                            <label class="hub-form-label">
                                Expected Delivery Date *
                            </label>

                            <input type="date"
                                   class="form-control"
                                   id="poDeliveryDate"
                                   name="DeliveryDate"
                                   required />

                        </div>


                        <!-- PAYMENT TERMS -->
                        <div class="col-12 col-md-6">

                            <label class="hub-form-label">
                                Payment Terms *
                            </label>

                            <select class="form-select"
                                    id="poPaymentTerms"
                                    name="PaymentTerms"
                                    required>

                                <option value="Net 30" selected>
                                    Net 30 Days (Standard)
                                </option>

                                <option value="Net 45">
                                    Net 45 Days
                                </option>

                                <option value="Net 60">
                                    Net 60 Days
                                </option>

                                <option value="Advance 50%">
                                    Advance 50% + Balance upon GRN
                                </option>

                                <option value="Immediate">
                                    Immediate / Letter of Credit
                                </option>

                            </select>

                        </div>


                        <!-- PO VALUE -->
                        <div class="col-12 col-md-6">

                            <label class="hub-form-label">
                                Estimated PO Value
                            </label>

                            <div class="input-group">

                                <span class="input-group-text modal-money-symbol">
                                    ₹
                                </span>

                                <input type="text"
                                       class="form-control modal-money-input"
                                       id="poEstimatedCost"
                                       name="EstimatedCost"
                                       placeholder="e.g. 1,45,000.00" />

                            </div>

                        </div>


                        <!-- ITEM SUMMARY -->
                        <div class="col-12">

                            <label class="hub-form-label">
                                Item Summary & Procurement Scope *
                            </label>

                            <input type="text"
                                   class="form-control"
                                   id="poItemSummary"
                                   name="ItemSummary"
                                   placeholder="Item description, part numbers, quantity, specification"
                                   required />

                        </div>


                        <!-- NOTES -->
                        <div class="col-12">

                            <label class="hub-form-label">
                                Procurement Notes & Delivery Bay Instructions
                            </label>

                            <textarea class="form-control"
                                      id="poNotes"
                                      name="Notes"
                                      rows="2"
                                      placeholder="E.g. Delivery via Dock 3, inspection certificate required on arrival."></textarea>

                        </div>

                    </div>

                </div>


                <div class="modal-footer border-top">

                    <button type="button"
                            class="btn btn-light rounded-2"
                            data-bs-dismiss="modal">
                        Cancel
                    </button>

                    <button type="submit"
                            class="btn btn-hub-primary"
                            id="btnSubmitPO">

                        <i class="fa fa-paper-plane"></i>
                        Confirm & Dispatch PO

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>


@section Scripts {

    <!-- Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <script>

        /* ================================================================
           INDIAN CURRENCY COMPACT FORMAT
           
           Examples:
           ₹1,000        -> ₹1K
           ₹10,000       -> ₹10K
           ₹1,00,000     -> ₹1L
           ₹5,00,000     -> ₹5L
           ₹10,00,000    -> ₹10L
           ₹1,00,00,000  -> ₹1Cr
           ================================================================ */

        function parseMoneyValue(value) {

            if (value === null || value === undefined) {
                return 0;
            }

            var text = String(value);

            /*
             * Supports values such as:
             * ₹1,00,000
             * ₹ 1,00,000.00
             * 1,00,000
             * 100000
             */
            text = text
                .replace(/₹/g, '')
                .replace(/,/g, '')
                .replace(/\s/g, '')
                .replace(/[^\d.-]/g, '');

            var number = Number(text);

            return Number.isFinite(number) ? number : 0;
        }


        function trimCompactNumber(number) {

            return Number(number.toFixed(2))
                .toString();
        }


        function formatCompactIndianMoney(value) {

            var number = parseMoneyValue(value);

            if (!Number.isFinite(number)) {
                return '₹0';
            }

            var absolute = Math.abs(number);
            var sign = number < 0 ? '-' : '';

            if (absolute >= 10000000) {

                return sign +
                    '₹' +
                    trimCompactNumber(absolute / 10000000) +
                    'Cr';
            }

            if (absolute >= 100000) {

                return sign +
                    '₹' +
                    trimCompactNumber(absolute / 100000) +
                    'L';
            }

            if (absolute >= 1000) {

                return sign +
                    '₹' +
                    trimCompactNumber(absolute / 1000) +
                    'K';
            }

            return sign +
                '₹' +
                absolute.toLocaleString('en-IN', {
                    maximumFractionDigits: 2
                });
        }

        function formatExactIndianMoney(value) {

                    var number = parseMoneyValue(value);

                    if (!Number.isFinite(number)) {
                        number = 0;
                    }

                    return '₹' +
                        number.toLocaleString('en-IN', {
                            minimumFractionDigits: 2,
                            maximumFractionDigits: 2
                        });
                }


                /*
                 * Converts every element having:
                 *
                 * class="compact-money"
                 * data-value="..."
                 *
                 * Display:
                 * ₹1L
                 *
                 * Hover:
                 * ₹1,00,000.00
                 */
                function initializeCompactMoney() {

                    document.querySelectorAll('.compact-money').forEach(function (element) {

                        var rawValue = element.getAttribute('data-value');

                        if (!rawValue) {
                            return;
                        }

                        element.textContent =
                            formatCompactIndianMoney(rawValue);

                        var exactValue =
                            formatExactIndianMoney(rawValue);

                        element.setAttribute('title', exactValue);
                        element.setAttribute('data-full-value', exactValue);
                        element.setAttribute('aria-label', exactValue);

                    });

                }


                /* ================================================================
                   PAGE INITIALIZATION
                   ================================================================ */

                document.addEventListener("DOMContentLoaded", function () {

                    /*
                     * Default delivery date = 7 days from today
                     */
                    var defaultDelivery = new Date();

                    defaultDelivery.setDate(
                        defaultDelivery.getDate() + 7
                    );

                    var dateStr =
                        defaultDelivery.toISOString().split('T')[0];

                    var dateInput =
                        document.getElementById("poDeliveryDate");

                    if (dateInput) {
                        dateInput.value = dateStr;
                    }


                    /*
                     * Initialize compact currency
                     */
                    initializeCompactMoney();


                    /*
                     * Initialize charts
                     */
                    initProcurementSpendChart();
                    initVendorDeliveryChart();

                });


                /* ================================================================
                   TOAST
                   ================================================================ */

                function showHubToast(message, isSuccess = true) {

                    var toastEl =
                        document.getElementById('hubLiveToast');

                    var msgEl =
                        document.getElementById('toastMessage');

                    var iconEl =
                        document.getElementById('toastIcon');

                    if (!toastEl) {
                        return;
                    }

                    msgEl.innerText = message;

                    toastEl.className =
                        'toast align-items-center text-white border-0 shadow-lg ' +
                        (isSuccess ? 'bg-success' : 'bg-danger');

                    iconEl.className =
                        isSuccess
                            ? 'fa fa-circle-check fs-5 me-1'
                            : 'fa fa-circle-xmark fs-5 me-1';


                    var bsToast =
                        new bootstrap.Toast(toastEl, {
                            delay: 4000
                        });

                    bsToast.show();

                }


                /* ================================================================
                   PROCUREMENT SPEND BAR CHART
                   ================================================================ */

                var spendChartInstance = null;

                function initProcurementSpendChart() {

                    var ctx =
                        document.getElementById('procurementSpendChart');

                    if (!ctx) {
                        return;
                    }


                    spendChartInstance =
                        new Chart(ctx, {

                            type: 'bar',

                            data: {

                                labels: [
                                    'Information Technology',
                                    'Operations & Warehouse',
                                    'Administration & HR',
                                    'Logistics & Fleet',
                                    'R&D / QA'
                                ],

                                datasets: [

                                    {
                                        label: 'Direct Procurement (₹ Lakhs)',

                                        data: [
                                            18.5,
                                            12.8,
                                            4.2,
                                            5.6,
                                            3.1
                                        ],

                                        backgroundColor:
                                            'rgba(6, 182, 212, 0.78)',

                                        borderColor:
                                            '#0891b2',

                                        borderWidth: 1,

                                        borderRadius: 6,

                                        borderSkipped: false
                                    },

                                    {
                                        label: 'CAPEX & Assets (₹ Lakhs)',

                                        data: [
                                            9.2,
                                            6.4,
                                            1.8,
                                            2.5,
                                            1.2
                                        ],

                                        backgroundColor:
                                            'rgba(59, 130, 246, 0.78)',

                                        borderColor:
                                            '#2563eb',

                                        borderWidth: 1,

                                        borderRadius: 6,

                                        borderSkipped: false
                                    }

                                ]

                            },

                            options: {

                                responsive: true,

                                maintainAspectRatio: false,

                                interaction: {
                                    mode: 'index',
                                    intersect: false
                                },

                                plugins: {

                                    legend: {

                                        position: 'top',

                                        labels: {

                                            font: {
                                                family: 'Plus Jakarta Sans',
                                                size: 11,
                                                weight: '600'
                                            },

                                            usePointStyle: true,

                                            boxWidth: 8,

                                            padding: 15

                                        }

                                    },

                                    tooltip: {

                                        backgroundColor:
                                            'rgba(15, 23, 42, .94)',

                                        padding: 10,

                                        cornerRadius: 8,

                                        callbacks: {

                                            label: function (context) {

                                                return context.dataset.label +
                                                    ': ₹ ' +
                                                    context.parsed.y +
                                                    ' Lakhs';

                                            }

                                        }

                                    }

                                },

                                scales: {

                                    y: {

                                        beginAtZero: true,

                                        grid: {
                                            color: 'rgba(226, 232, 240, 0.55)'
                                        },

                                        ticks: {

                                            callback: function (value) {
                                                return '₹ ' + value + ' L';
                                            },

                                            font: {
                                                size: 10
                                            }

                                        }

                                    },

                                    x: {

                                        grid: {
                                            display: false
                                        },

                                        ticks: {

                                            font: {
                                                size: 10
                                            },

                                            maxRotation: 0,

                                            minRotation: 0

                                        }

                                    }

                                }

                            }

                        });

                }


                function updateChartPeriod(period) {

                    if (!spendChartInstance) {
                        return;
                    }


                    if (period === 'YTD') {

                        spendChartInstance.data.datasets[0].data = [
                            42.0,
                            28.5,
                            11.2,
                            14.8,
                            8.4
                        ];

                        spendChartInstance.data.datasets[1].data = [
                            21.5,
                            14.2,
                            5.1,
                            7.8,
                            3.9
                        ];

                    }
                    else {

                        spendChartInstance.data.datasets[0].data = [
                            18.5,
                            12.8,
                            4.2,
                            5.6,
                            3.1
                        ];

                        spendChartInstance.data.datasets[1].data = [
                            9.2,
                            6.4,
                            1.8,
                            2.5,
                            1.2
                        ];

                    }


                    spendChartInstance.update();


                    /*
                     * Update active period button
                     */
                    document
                        .querySelectorAll('.hub-period-btn')
                        .forEach(function (button) {

                            button.classList.remove('active');

                        });


                    var buttons =
                        document.querySelectorAll('.hub-period-btn');

                    if (period === 'YTD' && buttons[1]) {
                        buttons[1].classList.add('active');
                    }
                    else if (buttons[0]) {
                        buttons[0].classList.add('active');
                    }

                }


                /* ================================================================
                   VENDOR DELIVERY DOUGHNUT
                   ================================================================ */

                function initVendorDeliveryChart() {

                    var ctx =
                        document.getElementById('vendorDeliveryChart');

                    if (!ctx) {
                        return;
                    }


                    new Chart(ctx, {

                        type: 'doughnut',

                        data: {

                            labels: [
                                'On-Time Deliveries',
                                'In Transit (Within SLA)',
                                'Delayed / Port Holds'
                            ],

                            datasets: [

                                {

                                    data: [
                                        78,
                                        15,
                                        7
                                    ],

                                    backgroundColor: [

                                        'rgba(16, 185, 129, 0.88)',
                                        'rgba(6, 182, 212, 0.88)',
                                        'rgba(245, 158, 11, 0.88)'

                                    ],

                                    borderColor: '#ffffff',

                                    borderWidth: 3,

                                    hoverOffset: 7

                                }

                            ]

                        },

                        options: {

                            responsive: true,

                            maintainAspectRatio: false,

                            cutout: '72%',

                            plugins: {

                                legend: {
                                    display: false
                                },

                                tooltip: {

                                    backgroundColor:
                                        'rgba(15, 23, 42, .94)',

                                    padding: 10,

                                    cornerRadius: 8,

                                    callbacks: {

                                        label: function (context) {

                                            return ' ' +
                                                context.label +
                                                ': ' +
                                                context.parsed +
                                                '%';

                                        }

                                    }

                                }

                            }

                        }

                    });

                }


                /* ================================================================
                   OPEN CREATE PO MODAL FROM REQUISITION
                   ================================================================ */

                function openCreatePOFromReq(
                    reqId,
                    itemSummary,
                    cost,
                    dept
                ) {

                    document.getElementById(
                        'modalRequisitionId'
                    ).value = reqId;


                    document.getElementById(
                        'poItemSummary'
                    ).value = itemSummary || '';


                    document.getElementById(
                        'poEstimatedCost'
                    ).value =
                        (cost || '').replace(/[₹, ]/g, '');


                    document.getElementById(
                        'poNotes'
                    ).value =
                        'Generated from Requisition PR #' +
                        reqId +
                        ' (' +
                        dept +
                        ')';


                    var modalEl =
                        document.getElementById('createPOModal');

                    var modal =
                        new bootstrap.Modal(modalEl);

                    modal.show();

                }


                /* ================================================================
                   AJAX REQUISITION ACTION
                   ================================================================ */

                function handleRequisitionAction(
                    reqId,
                    actionType
                ) {

                    if (!confirm(
                        'Are you sure you want to mark Requisition #' +
                        reqId +
                        ' as ' +
                        actionType +
                        '?'
                    )) {
                        return;
                    }


                    $.ajax({

                        url:
                            '@Url.Action("ApproveRequisition", "Purchase")',

                        type: 'POST',

                        data: {
                            id: reqId,
                            actionType: actionType
                        },

                        success: function (res) {

                            if (res && res.success) {

                                showHubToast(
                                    res.message,
                                    true
                                );


                                var row =
                                    document.getElementById(
                                        'req-row-' + reqId
                                    );


                                if (row) {

                                    row.style.transition =
                                        'all .4s ease';

                                    row.style.opacity = '0';

                                    row.style.transform =
                                        'translateX(25px)';


                                    setTimeout(function () {

                                        row.remove();

                                    }, 400);

                                }

                            }
                            else {

                                showHubToast(
                                    'Failed to process requisition action.',
                                    false
                                );

                            }

                        },

                        error: function () {

                            showHubToast(
                                'Server communication error. Please try again.',
                                false
                            );

                        }

                    });

                }


                /* ================================================================
                   CREATE PURCHASE ORDER
                   ================================================================ */

                $('#createPOForm').on(
                    'submit',
                    function (e) {

                        e.preventDefault();


                        var submitBtn =
                            $('#btnSubmitPO');


                        submitBtn
                            .prop('disabled', true)
                            .html(
                                '<i class="fa fa-spinner fa-spin"></i> Generating PO...'
                            );


                        var payload = {

                            VendorName:
                                $('#poVendorName').val(),

                            DeliveryDate:
                                $('#poDeliveryDate').val(),

                            PaymentTerms:
                                $('#poPaymentTerms').val(),

                            Notes:
                                $('#poNotes').val(),

                            ItemSummary:
                                $('#poItemSummary').val(),

                            EstimatedCost:
                                $('#poEstimatedCost').val()

                        };


                        var reqId =
                            $('#modalRequisitionId').val();


                        $.ajax({

                            url:
                                '@Url.Action("CreatePO", "Purchase")',

                            type: 'POST',

                            data: payload,


                            success: function (res) {

                                submitBtn
                                    .prop('disabled', false)
                                    .html(
                                        '<i class="fa fa-paper-plane"></i> Confirm & Dispatch PO'
                                    );


                                var modalEl =
                                    document.getElementById(
                                        'createPOModal'
                                    );


                                var modal =
                                    bootstrap.Modal.getInstance(
                                        modalEl
                                    );


                                if (modal) {
                                    modal.hide();
                                }


                                if (res && res.success) {

                                    showHubToast(
                                        res.message,
                                        true
                                    );


                                    /*
                                     * Remove PR row if PO
                                     * was generated from PR.
                                     */
                                    if (reqId) {

                                        var row =
                                            document.getElementById(
                                                'req-row-' + reqId
                                            );


                                        if (row) {

                                            row.style.transition =
                                                'all .4s ease';

                                            row.style.opacity = '0';


                                            setTimeout(function () {

                                                row.remove();

                                            }, 400);

                                        }

                                    }


                                    /*
                                     * Add newly created PO
                                     * to tracker.
                                     */
                                    var today =
                                        new Date().toLocaleDateString(
                                            'en-GB',
                                            {
                                                day: '2-digit',
                                                month: 'short',
                                                year: 'numeric'
                                            }
                                        );


                                    var rawAmount =
                                        payload.EstimatedCost ||
                                        '145000';


                                    var exactAmount =
                                        formatExactIndianMoney(
                                            rawAmount
                                        );


                                    var compactAmount =
                                        formatCompactIndianMoney(
                                            rawAmount
                                        );


                                    var newRowHtml = `

                                        <tr style="
                                            background: rgba(16,185,129,.045);
                                            transition: all .5s ease;
                                        ">

                                            <td>

                                                <span class="hub-table-primary">
                                                    ${res.poNumber || 'PO-2026-NEW'}
                                                </span>

                                                <span class="hub-table-secondary">
                                                    ${today}
                                                </span>

                                            </td>


                                            <td>

                                                <span class="hub-table-primary">
                                                    ${payload.VendorName}
                                                </span>

                                                <span class="hub-table-secondary">
                                                    1 line item
                                                </span>

                                            </td>


                                            <td>

                                                <span class="hub-table-primary">

                                                    <span
                                                        class="compact-money"
                                                        data-value="${rawAmount}"
                                                        data-full-value="${exactAmount}"
                                                        title="${exactAmount}"
                                                        aria-label="${exactAmount}">
                                                        ${compactAmount}
                                                    </span>

                                                </span>

                                            </td>


                                            <td>

                                                <span class="badge-hub badge-confirmed">

                                                    <i class="fa fa-circle-check"></i>

                                                    Confirmed

                                                </span>

                                            </td>


                                            <td>

                                                <span class="badge bg-secondary-subtle text-secondary small rounded-pill">
                                                    ${payload.PaymentTerms}
                                                </span>

                                            </td>

                                        </tr>

                                    `;


                                    var tableBody =
                                        $('#activePOTable tbody');


                                    tableBody.prepend(
                                        newRowHtml
                                    );


                                    $('#createPOForm')[0].reset();


                                    /*
                                     * Restore default delivery
                                     * date after reset.
                                     */
                                    var newDefaultDate =
                                        new Date();

                                    newDefaultDate.setDate(
                                        newDefaultDate.getDate() + 7
                                    );


                                    $('#poDeliveryDate').val(
                                        newDefaultDate
                                            .toISOString()
                                            .split('T')[0]
                                    );

                                }
                                else {

                                    showHubToast(
                                        'Failed to create purchase order.',
                                        false
                                    );

                                }

                            },


                            error: function () {

                                submitBtn
                                    .prop('disabled', false)
                                    .html(
                                        '<i class="fa fa-paper-plane"></i> Confirm & Dispatch PO'
                                    );


                                showHubToast(
                                    'Communication error dispatching PO.',
                                    false
                                );

                            }

                        });

                    }
                );

    </script>
}
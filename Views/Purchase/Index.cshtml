@model ERP_System.Models.PurchaseViewModel
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Purchase Management";
    var inCulture = new System.Globalization.CultureInfo("en-IN");
}

<style>
    .panel-purchase {
        background: #ffffff;
        border: 1px solid var(--border-warm);
        border-radius: 12px;
        box-shadow: 0 1px 3px rgba(45,37,30,0.03);
    }
    
    .table-purchase th {
        background-color: #fcfbfa !important;
        font-size: 0.75rem;
        text-transform: uppercase;
        font-weight: 700;
        color: #7c7267;
        border-bottom: 1px solid var(--border-warm);
        padding: 1rem 1.25rem;
    }
    
    .table-purchase td {
        font-size: 0.875rem;
        color: var(--text-color);
        border-bottom: 1px solid var(--border-warm);
        padding: 1rem 1.25rem;
        vertical-align: middle;
    }

    .badge-po-pending {
        background-color: rgba(245, 158, 11, 0.08);
        color: #f59e0b;
        font-weight: 600;
        border: 1px solid rgba(245, 158, 11, 0.2);
    }
    .badge-po-approved {
        background-color: rgba(59, 130, 246, 0.08);
        color: #3b82f6;
        font-weight: 600;
        border: 1px solid rgba(59, 130, 246, 0.2);
    }
    .badge-po-received {
        background-color: rgba(16, 185, 129, 0.08);
        color: #10b981;
        font-weight: 600;
        border: 1px solid rgba(16, 185, 129, 0.2);
    }
    .badge-po-paid {
        background-color: rgba(13, 20, 36, 0.08);
        color: #0d1424;
        font-weight: 600;
        border: 1px solid rgba(13, 20, 36, 0.2);
    }

    .kpi-card-warm {
        background: #ffffff;
        border: 1px solid var(--border-warm);
        border-radius: 12px;
        padding: 1.25rem;
        box-shadow: 0 1px 3px rgba(13,20,36,0.03);
        display: flex;
        align-items: center;
        gap: 1.25rem;
    }
    .kpi-icon-box {
        width: 48px;
        height: 48px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.35rem;
        flex-shrink: 0;
    }

    .btn-action-warm {
        border: 1px solid var(--border-warm);
        background-color: #ffffff;
        color: var(--text-color);
        font-size: 0.8rem;
        font-weight: 600;
        padding: 0.35rem 0.75rem;
        border-radius: 6px;
        transition: all 0.2s;
    }
    .btn-action-warm:hover {
        background-color: #faf8f5;
        border-color: #cbd5e1;
        color: var(--primary-warm);
    }
</style>

<!-- Top Header & Breadcrumbs -->
<div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-3 mb-4 text-start">
    <div>
        <h4 class="fw-bold mb-1" style="color: var(--text-color);">Purchase Management</h4>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0 small">
                <li class="breadcrumb-item"><a href="/Dashboard" class="text-decoration-none">Dashboard</a></li>
                <li class="breadcrumb-item active" aria-current="page">Purchase Orders</li>
            </ol>
        </nav>
    </div>
    
    <div class="d-flex gap-2">
        <a href="/Suppliers" class="btn btn-outline-secondary btn-sm px-3 py-2 fw-semibold">
            <i class="fa-solid fa-truck-field me-1.5"></i> Manage Suppliers
        </a>
        <button type="button" class="btn btn-primary-warm px-4 py-2" data-bs-toggle="modal" data-bs-target="#createPOModal">
            <i class="fa-solid fa-plus me-1.5"></i> Create Purchase Order
        </button>
    </div>
</div>

<!-- Alerts -->
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm text-start mb-4" role="alert">
        <i class="fa-solid fa-circle-check me-2"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm text-start mb-4" role="alert">
        <i class="fa-solid fa-triangle-exclamation me-2"></i> @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- KPI Summary Cards Row -->
<div class="row g-3 mb-4 text-start">
    <div class="col-xl-3 col-sm-6">
        <div class="kpi-card-warm">
            <div class="kpi-icon-box bg-primary bg-opacity-10 text-primary">
                <i class="fa-solid fa-money-bill-wave"></i>
            </div>
            <div>
                <div class="text-muted small fw-semibold text-uppercase">Total Purchase Spend</div>
                <div class="fs-4 fw-bold text-dark">@Model.TotalPurchaseSpend.ToString("C0", inCulture)</div>
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-sm-6">
        <div class="kpi-card-warm">
            <div class="kpi-icon-box bg-info bg-opacity-10 text-info">
                <i class="fa-solid fa-cart-shopping"></i>
            </div>
            <div>
                <div class="text-muted small fw-semibold text-uppercase">Total Orders Logged</div>
                <div class="fs-4 fw-bold text-dark">@Model.TotalOrdersCount Orders</div>
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-sm-6">
        <div class="kpi-card-warm">
            <div class="kpi-icon-box bg-warning bg-opacity-10 text-warning">
                <i class="fa-solid fa-clock"></i>
            </div>
            <div>
                <div class="text-muted small fw-semibold text-uppercase">Pending Orders</div>
                <div class="fs-4 fw-bold text-warning">@Model.PendingOrdersCount Awaiting</div>
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-sm-6">
        <div class="kpi-card-warm">
            <div class="kpi-icon-box bg-success bg-opacity-10 text-success">
                <i class="fa-solid fa-truck-ramp-box"></i>
            </div>
            <div>
                <div class="text-muted small fw-semibold text-uppercase">Active Suppliers</div>
                <div class="fs-4 fw-bold text-success">@Model.TotalSuppliersCount Vendors</div>
            </div>
        </div>
    </div>
</div>

<!-- Filters & Search Bar -->
<div class="panel-purchase p-3 mb-4 text-start">
    <form method="get" asp-action="Index" class="row g-3 align-items-center">
        <div class="col-lg-5 col-md-6">
            <div class="input-group">
                <span class="input-group-text bg-white border-end-0 text-muted"><i class="fa-solid fa-magnifying-glass"></i></span>
                <input type="text" name="search" class="form-control border-start-0 ps-0" placeholder="Search PO number or supplier name..." value="@Model.SearchTerm">
            </div>
        </div>

        <div class="col-lg-3 col-md-6">
            <select name="status" class="form-select">
                <option value="">All Order Statuses</option>
                <option value="Pending" selected="@(Model.SelectedStatus == "Pending" ? "selected" : null)">Pending</option>
                <option value="Approved" selected="@(Model.SelectedStatus == "Approved" ? "selected" : null)">Approved</option>
                <option value="Received" selected="@(Model.SelectedStatus == "Received" ? "selected" : null)">Received</option>
                <option value="Paid" selected="@(Model.SelectedStatus == "Paid" ? "selected" : null)">Paid</option>
            </select>
        </div>

        <div class="col-lg-3 col-md-6">
            <select name="supplier" class="form-select">
                <option value="">All Vendors / Suppliers</option>
                @foreach (var s in Model.SuppliersList)
                {
                    <option value="@s.SupplierName" selected="@(Model.SelectedSupplier == s.SupplierName ? "selected" : null)">@s.SupplierName</option>
                }
            </select>
        </div>

        <div class="col-lg-1 col-md-6 text-end">
            <button type="submit" class="btn btn-primary-warm w-100"><i class="fa-solid fa-filter me-1"></i> Filter</button>
        </div>
    </form>
</div>

<!-- Purchase Orders Registry Table Panel -->
<div class="panel-purchase p-0 overflow-hidden mb-5 text-start">
    <div class="p-3 bg-light border-bottom d-flex justify-content-between align-items-center">
        <h6 class="fw-bold mb-0 text-dark"><i class="fa-solid fa-file-invoice-dollar me-2 text-muted"></i>Purchase Orders Registry</h6>
        <span class="badge bg-secondary rounded-pill font-monospace fs-7">Showing @Model.PurchaseOrders.Count POs</span>
    </div>

    <div class="table-responsive">
        <table class="table table-purchase mb-0">
            <thead>
                <tr>
                    <th>PO Number</th>
                    <th>Date</th>
                    <th>Supplier / Vendor</th>
                    <th>Type</th>
                    <th>Total Amount</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.PurchaseOrders != null && Model.PurchaseOrders.Any())
                {
                    foreach (var po in Model.PurchaseOrders)
                    {
                        var badgeClass = po.Status == "Paid" ? "badge-po-paid" :
                                         po.Status == "Received" ? "badge-po-received" :
                                         po.Status == "Approved" ? "badge-po-approved" : "badge-po-pending";

                        <tr>
                            <td>
                                <a href="#" class="fw-bold text-primary font-monospace text-decoration-none">@po.TransactionNo</a>
                            </td>
                            <td class="text-muted">
                                <i class="fa-regular fa-calendar me-1 small"></i> @po.Date.ToString("dd MMM yyyy")
                            </td>
                            <td>
                                <div class="fw-bold text-dark mb-0">@po.PartyName</div>
                                <div class="text-muted small">Vendor Account</div>
                            </td>
                            <td>
                                <span class="badge bg-light text-dark border">@po.Type</span>
                            </td>
                            <td class="fw-bold text-dark fs-6">
                                @po.Amount.ToString("C0", inCulture)
                            </td>
                            <td>
                                <span class="badge rounded-pill px-2.5 py-1.5 @badgeClass">
                                    <i class="fa-solid fa-circle me-1" style="font-size:0.5rem;"></i> @po.Status
                                </span>
                            </td>
                            <td class="text-end">
                                <div class="btn-group">
                                    @if (po.Status == "Pending" || po.Status == "Approved")
                                    {
                                        <form method="post" asp-action="UpdateStatus" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="transactionId" value="@po.TransactionId" />
                                            <input type="hidden" name="newStatus" value="Received" />
                                            <button type="submit" class="btn btn-action-warm btn-sm me-1 text-success" title="Receive Goods & Auto-Restock Inventory">
                                                <i class="fa-solid fa-box-open me-1"></i> Receive
                                            </button>
                                        </form>
                                    }

                                    <button type="button" class="btn btn-action-warm btn-sm me-1" 
                                            onclick="openUpdateModal(@po.TransactionId, '@po.TransactionNo', '@po.Status')">
                                        <i class="fa-solid fa-pen-to-square text-primary me-1"></i> Status
                                    </button>

                                    <form method="post" asp-action="Delete" class="d-inline" onsubmit="return confirm('Are you sure you want to cancel this purchase order?');">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="transactionId" value="@po.TransactionId" />
                                        <button type="submit" class="btn btn-action-warm btn-sm text-danger" title="Cancel Order">
                                            <i class="fa-solid fa-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="text-center text-muted py-5">
                            <i class="fa-solid fa-cart-shopping fa-2x mb-3 text-muted opacity-50"></i>
                            <div>No purchase orders match your filter parameters.</div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Create Purchase Order Modal -->
<div class="modal fade text-start" id="createPOModal" tabindex="-1" aria-labelledby="createPOModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow">
            <form method="post" asp-action="CreateOrder">
                @Html.AntiForgeryToken()
                <div class="modal-header bg-light">
                    <h5 class="modal-title fw-bold" id="createPOModalLabel"><i class="fa-solid fa-cart-plus me-2 text-primary"></i>Create New Purchase Order</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Supplier / Vendor Name</label>
                            <select name="supplierName" class="form-select" required>
                                <option value="">Select Supplier...</option>
                                @foreach (var sup in Model.SuppliersList)
                                {
                                    <option value="@sup.SupplierName">@sup.SupplierName (@sup.City)</option>
                                }
                                <option value="Sharma Suppliers">Sharma Suppliers</option>
                                <option value="XYZ Traders">XYZ Traders</option>
                                <option value="TechSupply Corp">TechSupply Corp</option>
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Inventory Product SKU</label>
                            <select name="productId" class="form-select" required>
                                @foreach (var prod in Model.ProductsList)
                                {
                                    <option value="@prod.ProductId">@prod.ProductName (@prod.Category) - Stock: @prod.StockQty</option>
                                }
                            </select>
                        </div>

                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Order Quantity</label>
                            <input type="number" name="quantity" class="form-control" value="50" min="1" required />
                        </div>

                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Unit Price (₹)</label>
                            <input type="number" name="unitPrice" class="form-control" value="500" min="1" step="0.01" required />
                        </div>

                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Initial Status</label>
                            <select name="status" class="form-select">
                                <option value="Pending">Pending Approval</option>
                                <option value="Approved">Approved</option>
                                <option value="Received">Received (Restock Now)</option>
                            </select>
                        </div>

                        <div class="col-12">
                            <label class="form-label fw-semibold">Purchase Order Notes</label>
                            <textarea name="notes" class="form-control" rows="2" placeholder="Expected delivery date, terms, or remarks..."></textarea>
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary-warm px-4">Generate Purchase Order</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Update Status Modal -->
<div class="modal fade text-start" id="updateStatusModal" tabindex="-1" aria-labelledby="updateStatusModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <form method="post" asp-action="UpdateStatus">
                @Html.AntiForgeryToken()
                <input type="hidden" name="transactionId" id="modalTxId" />
                <div class="modal-header bg-light">
                    <h5 class="modal-title fw-bold" id="updateStatusModalLabel"><i class="fa-solid fa-pen-to-square me-2 text-primary"></i>Update Order Status</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">PO Number</label>
                        <input type="text" id="modalTxNo" class="form-control bg-light" readonly />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Select New Status</label>
                        <select name="newStatus" id="modalNewStatus" class="form-select" required>
                            <option value="Pending">Pending</option>
                            <option value="Approved">Approved</option>
                            <option value="Received">Received (Fulfill & Restock Inventory)</option>
                            <option value="Paid">Paid & Completed</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary-warm px-4">Update Status</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function openUpdateModal(txId, txNo, currentStatus) {
            document.getElementById('modalTxId').value = txId;
            document.getElementById('modalTxNo').value = txNo;
            document.getElementById('modalNewStatus').value = currentStatus;
            
            const modalEl = new bootstrap.Modal(document.getElementById('updateStatusModal'));
            modalEl.show();
        }
    </script>
}

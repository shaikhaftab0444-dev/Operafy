                                <div class="d-flex justify-content-between text-muted small mb-1.5">
                                    <span>Integrated GST (18% IGST):</span>
                                    <span class="fw-bold text-dark" id="modalTaxAmount">₹ 0.00</span>
                                </div>
                                <div class="d-flex justify-content-between text-muted small mb-2 pb-2 border-bottom">
                                    <span>Round Off:</span>
                                    <span class="fw-semibold text-dark">₹ 0.00</span>
                                </div>
                                <div class="d-flex justify-content-between align-items-center">
                                    <span class="fw-bold text-dark fs-6">Total PO Value:</span>
                                    <span class="fw-extrabold fs-4 text-primary" id="modalGrandTotal">₹ 0.00</span>

</div>

<!-- Floating Real-Time Operational Feedback Toast -->
<div id="poToastBox" class="po-toast-box">
    <div class="toast show align-items-center text-white bg-dark border-0 shadow-lg" role="alert" aria-live="assertive" aria-atomic="true">
        <div class="d-flex">
            <div class="toast-body d-flex align-items-center gap-2 py-2.5 px-3">
                <i class="fa fa-circle-check text-success fs-5" id="poToastIcon"></i>
                <span id="poToastMessage" class="small fw-semibold">Action completed successfully.</span>
            </div>
            <button type="button" class="btn-close btn-close-white me-2 m-auto" onclick="hidePOToast()"></button>
        </div>
    </div>
</div>

@section Scripts {

    <script>

        /* =====================================================
           MONEY FORMATTERS
           ===================================================== */

        function parseMoneyValue(value) {

            if (typeof value === "number") {

                return Number.isFinite(value)
                    ? value
                    : 0;
            }

            var cleaned = String(value ?? "")
                .replace(/[^0-9.-]/g, "");

            var number = Number(cleaned);

            return Number.isFinite(number)
                ? number
                : 0;
        }


        function trimMoneyDecimal(value) {

            return value
                .toFixed(2)
                .replace(/\.00$/, "")
                .replace(/(\.\d)0$/, "$1");
        }


        function compactIndianMoney(value) {

            var number = parseMoneyValue(value);

            var abs = Math.abs(number);

            var sign = number < 0
                ? "-"
                : "";


            if (abs >= 10000000) {

                return sign +
                    "₹" +
                    trimMoneyDecimal(abs / 10000000) +
                    "Cr";
            }


            if (abs >= 100000) {

                return sign +
                    "₹" +
                    trimMoneyDecimal(abs / 100000) +
                    "L";
            }


            if (abs >= 1000) {

                return sign +
                    "₹" +
                    trimMoneyDecimal(abs / 1000) +
                    "K";
            }


            return sign +
                "₹" +
                abs.toLocaleString("en-IN", {
                    maximumFractionDigits: 2
                });
        }


        function exactIndianMoney(value) {

            var number = parseMoneyValue(value);

            var formatted =
                Math.abs(number).toLocaleString(
                    "en-IN",
                    {
                        minimumFractionDigits: 2,
                        maximumFractionDigits: 2
                    }
                );

            return number < 0
                ? "-₹" + formatted
                : "₹" + formatted;
        }


        function applyCompactMoneyFormatting(root) {

            var scope = root || document;

            scope
                .querySelectorAll(".compact-money")
                .forEach(function (element) {

                    var rawValue =
                        element.getAttribute("data-value") || "0";

                    var compactValue =
                        compactIndianMoney(rawValue);

                    var exactValue =
                        exactIndianMoney(rawValue);

                    element.textContent =
                        compactValue;

                    element.setAttribute(
                        "title",
                        exactValue
                    );

                    element.setAttribute(
                        "data-full-value",
                        exactValue
                    );

                    element.setAttribute(
                        "aria-label",
                        exactValue
                    );

                });
        }


        /* =====================================================
           SEARCH
           ===================================================== */

        function filterPOTable() {

            var searchInput =
                document.getElementById("poSearch");

            if (!searchInput) {
                return;
            }

            var filter =
                searchInput.value
                    .toUpperCase()
                    .trim();

            var table =
                document.getElementById("poDataTable");

            if (!table) {
                return;
            }

            var tbody =
                table.getElementsByTagName("tbody")[0];

            if (!tbody) {
                return;
            }

            var rows =
                tbody.getElementsByTagName("tr");

            var visibleCount = 0;


            for (var i = 0; i < rows.length; i++) {

                var row = rows[i];

                if (row.id === "poEmptyRow") {
                    continue;
                }

                var text =
                    row.textContent ||
                    row.innerText;

                var matches =
                    text
                        .toUpperCase()
                        .indexOf(filter) > -1;

                row.style.display =
                    matches ? "" : "none";

                if (matches) {
                    visibleCount++;
                }
            }


            var clearButton =
                document.getElementById(
                    "poSearchClear"
                );

            if (clearButton) {

                clearButton.style.display =
                    filter.length > 0
                        ? "flex"
                        : "none";
            }


            updatePOResultCount(
                visibleCount,
                filter
            );
        }


        function updatePOResultCount(
            count,
            filter
        ) {

            var resultCount =
                document.getElementById(
                    "poResultCount"
                );

            if (!resultCount) {
                return;
            }


            if (filter && filter.length > 0) {

                resultCount.textContent =
                    count +
                    " matching order" +
                    (count === 1 ? "" : "s");

            }
            else {

                resultCount.textContent =
                    count +
                    " order" +
                    (count === 1 ? "" : "s");
            }
        }


        function clearPOSearch() {

            var searchInput =
                document.getElementById(
                    "poSearch"
                );

            if (!searchInput) {
                return;
            }

            searchInput.value = "";

            filterPOTable();

            searchInput.focus();
        }


        /* =====================================================
           REAL-TIME PO DETAILS, WORKFLOW & PRINT
           ===================================================== */

        window.currentActivePONumber = "";
        window.currentActivePOData = null;

        function showPOToast(message, isSuccess = true) {
            var box = document.getElementById("poToastBox");
            var msgEl = document.getElementById("poToastMessage");
            var iconEl = document.getElementById("poToastIcon");
            if (!box || !msgEl) return;

            msgEl.textContent = message;
            if (iconEl) {
                iconEl.className = isSuccess
                    ? "fa fa-circle-check text-success fs-5"
                    : "fa fa-triangle-exclamation text-warning fs-5";
            }
            box.style.display = "block";
            clearTimeout(window._poToastTimeout);
            window._poToastTimeout = setTimeout(function() {
                hidePOToast();
            }, 4500);
        }

        window.hidePOToast = function() {
            var box = document.getElementById("poToastBox");
            if (box) box.style.display = "none";
        };

        function showPOModalDirect() {
            var modalEl = document.getElementById("poDetailsModal");
            if (!modalEl) return;

            // Move modal to body if not already there, avoiding stacking context / overflow issues
            if (modalEl.parentNode !== document.body) {
                document.body.appendChild(modalEl);
            }

            try {
                if (window.bootstrap && window.bootstrap.Modal) {
                    var modal = (typeof bootstrap.Modal.getOrCreateInstance === "function")
                        ? bootstrap.Modal.getOrCreateInstance(modalEl)
                        : (bootstrap.Modal.getInstance(modalEl) || new bootstrap.Modal(modalEl));
                    modal.show();
                    return;
                }
            } catch (e) {
                console.warn("Bootstrap getOrCreateInstance fallback:", e);
            }

            try {
                if (window.jQuery && typeof window.jQuery(modalEl).modal === "function") {
                    window.jQuery(modalEl).modal("show");
                    return;
                }
            } catch (e) {
                console.warn("jQuery modal fallback:", e);
            }

            // Direct DOM Fallback
            modalEl.classList.add("show");
            modalEl.style.display = "block";
            document.body.classList.add("modal-open");
            var existingBackdrop = document.getElementById("poModalFallbackBackdrop");
            if (!existingBackdrop) {
                var backdrop = document.createElement("div");
                backdrop.className = "modal-backdrop fade show";
                backdrop.id = "poModalFallbackBackdrop";
                backdrop.onclick = function() {
                    modalEl.classList.remove("show");
                    modalEl.style.display = "none";
                    document.body.classList.remove("modal-open");
                    backdrop.remove();
                };
                document.body.appendChild(backdrop);
            }
        }

        function updateStepperUI(status) {
            var s1 = document.getElementById("step-1");
            var s2 = document.getElementById("step-2");
            var s3 = document.getElementById("step-3");
            var s4 = document.getElementById("step-4");
            var statusBadge = document.getElementById("stepperCurrentStatus");

            if (!s1 || !s2 || !s3 || !s4) return;

            // Reset classes
            [s1, s2, s3, s4].forEach(function(el) {
                el.className = "po-step";
            });

            s1.className = "po-step completed";

            var st = String(status || "").toLowerCase();
            if (st.indexOf("transit") > -1) {
                s2.className = "po-step completed";
                s3.className = "po-step active";
                if (statusBadge) {
                    statusBadge.className = "badge bg-info-subtle text-info fw-bold";
                    statusBadge.innerHTML = '<i class="fa fa-truck-fast me-1"></i> In Transit (Freight Telemetry Active)';
                }
            } else if (st.indexOf("delivered") > -1) {
                s2.className = "po-step completed";
                s3.className = "po-step completed";
                s4.className = "po-step completed";
                if (statusBadge) {
                    statusBadge.className = "badge bg-success-subtle text-success fw-bold";
                    statusBadge.innerHTML = '<i class="fa fa-circle-check me-1"></i> Delivered & 3-Way Matched (AP Cleared)';
                }
            } else {
                // Confirmed or Pending
                s2.className = "po-step active";
                if (statusBadge) {
                    statusBadge.className = "badge bg-primary-subtle text-primary fw-bold";
                    statusBadge.innerHTML = '<i class="fa fa-clock me-1"></i> Confirmed & Factory Assembly Stage';
                }
            }

            // Configure quick action buttons visibility
            var btnTransit = document.getElementById("btnMarkTransit");
            var btnDelivered = document.getElementById("btnMarkDelivered");
            if (btnTransit) btnTransit.style.display = (st.indexOf("transit") === -1 && st.indexOf("delivered") === -1) ? "inline-block" : "none";
            if (btnDelivered) btnDelivered.style.display = (st.indexOf("delivered") === -1) ? "inline-block" : "none";
        }

        window.viewPODetails = function(poNumber, vendor, itemsCount, totalAmount, orderDate, status, paymentTerms) {
            window.currentActivePONumber = poNumber || "PO-2026-0891";

            // Baseline immediate assignment
            if (document.getElementById("modalPoNumber")) document.getElementById("modalPoNumber").textContent = window.currentActivePONumber;
            if (document.getElementById("modalPoDate")) document.getElementById("modalPoDate").textContent = orderDate || "29 Aug 2026";
            if (document.getElementById("stepPoDate")) document.getElementById("stepPoDate").textContent = orderDate || "29 Aug 2026";
            if (document.getElementById("modalVendorName")) document.getElementById("modalVendorName").textContent = vendor || "TechInfra Solutions Ltd";
            if (document.getElementById("modalPaymentTerms")) document.getElementById("modalPaymentTerms").textContent = paymentTerms || "Net 30";
            if (document.getElementById("modalPoStatus")) document.getElementById("modalPoStatus").textContent = status || "Active";
            if (document.getElementById("modalGrandTotal")) document.getElementById("modalGrandTotal").textContent = totalAmount || "₹ 0.00";

            updateStepperUI(status);

            // Set placeholder skeleton while fetching complete voucher
            var tbody = document.getElementById("modalPoItemsBody");
            if (tbody) {
                tbody.innerHTML = '<tr><td colspan="6" class="py-4 text-center text-muted">' +
                    '<div class="spinner-border spinner-border-sm text-primary me-2" role="status"></div>' +
                    'Loading official ERP verified line items & GST tax breakdown...</td></tr>';
            }

            // Show modal IMMEDIATELY for responsive feel
            showPOModalDirect();

            // Real-time server query for accurate supplier & item dossier
            fetch('@Url.Action("GetPODetails", "Purchase")?poNumber=' + encodeURIComponent(window.currentActivePONumber))
                .then(function(res) { return res.json(); })
                .then(function(data) {
                    if (data && data.success) {
                        window.currentActivePOData = data;

                        if (document.getElementById("modalPoNumber")) document.getElementById("modalPoNumber").textContent = data.poNumber || window.currentActivePONumber;
                        if (document.getElementById("modalPoDate")) document.getElementById("modalPoDate").textContent = data.orderDate || orderDate;
                        if (document.getElementById("modalDeliveryDate")) document.getElementById("modalDeliveryDate").textContent = data.deliveryDate || "7 Days from Order";
                        if (document.getElementById("modalVendorName")) document.getElementById("modalVendorName").textContent = data.vendorName || vendor;
                        if (document.getElementById("modalPaymentTerms")) document.getElementById("modalPaymentTerms").textContent = data.paymentTerms || paymentTerms;
                        if (document.getElementById("modalPoStatus")) document.getElementById("modalPoStatus").textContent = data.status || status;
                        if (document.getElementById("modalVendorGstin")) document.getElementById("modalVendorGstin").textContent = data.gstin || "29AAACE9912K1Z9";
                        if (document.getElementById("modalVendorPan")) document.getElementById("modalVendorPan").textContent = data.pan || "AAACE9912K";
                        if (document.getElementById("modalVendorAddress")) document.getElementById("modalVendorAddress").textContent = data.vendorAddress || "Commercial Hub, Bangalore - 560100";
                        if (document.getElementById("modalVendorEmail")) document.getElementById("modalVendorEmail").textContent = data.vendorEmail || "procurement-support@@supplier.com";
                        if (document.getElementById("modalVendorPhone")) document.getElementById("modalVendorPhone").textContent = data.vendorPhone || "+91 80 4122 8900";

                        if (document.getElementById("modalWarehouse")) document.getElementById("modalWarehouse").textContent = data.warehouse || "WH-Main Logistics Bay 3";
                        if (document.getElementById("modalShippingAddress")) document.getElementById("modalShippingAddress").textContent = data.shippingAddress || "Operafy Depot, Bangalore";
                        if (document.getElementById("modalReceivingGate")) document.getElementById("modalReceivingGate").textContent = data.receivingGate || "Commercial Inward Intake Gate #2";
                        if (document.getElementById("modalCarrier")) document.getElementById("modalCarrier").textContent = data.carrier || "BlueDart Express Freight";
                        if (document.getElementById("modalTracking")) document.getElementById("modalTracking").textContent = data.trackingNumber || ("TRK-" + window.currentActivePONumber + "-IN");
                        if (document.getElementById("stepCarrierName")) document.getElementById("stepCarrierName").textContent = data.carrier || "Courier Telemetry";

                        if (document.getElementById("modalSubtotal")) document.getElementById("modalSubtotal").textContent = data.subtotal || "₹ 0.00";
                        if (document.getElementById("modalTaxAmount")) document.getElementById("modalTaxAmount").textContent = data.taxAmount || "₹ 0.00";
                        if (document.getElementById("modalGrandTotal")) document.getElementById("modalGrandTotal").textContent = data.grandTotal || totalAmount;
                        if (document.getElementById("modalSignatory")) document.getElementById("modalSignatory").textContent = data.authorizedSignatory || "Aftab Shaik (Chief Procurement Officer)";

                        updateStepperUI(data.status);

                        if (data.items && data.items.length > 0 && tbody) {
                            tbody.innerHTML = data.items.map(function(item) {
                                return '<tr>' +
                                    '<td class="text-start">' +
                                        '<span class="fw-bold text-dark d-block">' + (item.item || 'Procurement Item') + '</span>' +
                                        '<span class="text-muted extra-small">' + (item.specification || 'Standard Industrial Grade, Conforming to Operafy Specs') + '</span>' +
                                    '</td>' +
                                    '<td class="font-monospace fw-semibold">' + (item.hsn || '8471') + '</td>' +
                                    '<td class="fw-bold fs-6">' + (item.qty || 1) + ' <span class="extra-small text-muted fw-normal">Nos</span></td>' +
                                    '<td class="fw-semibold text-dark">' + (item.unitPrice || '₹ 0.00') + '</td>' +
                                    '<td><span class="badge bg-light text-dark border extra-small">' + (item.tax || '18% IGST') + '</span></td>' +
                                    '<td class="text-end fw-extrabold text-primary">' + (item.total || '₹ 0.00') + '</td>' +
                                '</tr>';
                            }).join('');
                        }
                    }
                })
                .catch(function(err) {
                    console.warn("Could not fetch real-time PO details, baseline data retained.", err);
                });
        };

        window.triggerStatusUpdate = function(newStatus) {
            if (!window.currentActivePONumber) return;
            var poNo = window.currentActivePONumber;

            var fd = new FormData();
            fd.append("poNumber", poNo);
            fd.append("status", newStatus);

            fetch('@Url.Action("UpdatePOStatus", "Purchase")', {
                method: "POST",
                body: fd
            })
            .then(function(res) { return res.json(); })
            .then(function(res) {
                if (res && res.success) {
                    // Update modal status
                    if (document.getElementById("modalPoStatus")) document.getElementById("modalPoStatus").textContent = newStatus;
                    updateStepperUI(newStatus);

                    // Update table row in real time
                    var badge = document.getElementById("po-status-badge-" + poNo);
                    if (badge) {
                        if (newStatus === "In Transit") {
                            badge.className = "po-status po-status-transit";
                            badge.innerHTML = '<i class="fa fa-truck-fast"></i> In Transit';
                        } else if (newStatus === "Delivered") {
                            badge.className = "po-status po-status-delivered";
                            badge.innerHTML = '<i class="fa fa-box-open"></i> Delivered';
                        } else {
                            badge.className = "po-status po-status-confirmed";
                            badge.innerHTML = '<i class="fa fa-circle-check"></i> Confirmed';
                        }
                    }

                    // Update KPI cards in real time
                    if (res.inTransitCount !== undefined && document.getElementById("kpiInTransitCount")) {
                        document.getElementById("kpiInTransitCount").textContent = res.inTransitCount + " Shipments";
                    }
                    if (res.deliveredCount !== undefined && document.getElementById("kpiDeliveredCount")) {
                        document.getElementById("kpiDeliveredCount").textContent = res.deliveredCount + " Completed";
                    }
                    if (res.confirmedCount !== undefined && document.getElementById("kpiConfirmedCount")) {
                        document.getElementById("kpiConfirmedCount").textContent = res.confirmedCount + " Orders";
                    }

                    showPOToast("Status updated to '" + newStatus + "' successfully.", true);
                } else {
                    showPOToast("Could not update status: " + (res.message || "Unknown error"), false);
                }
            })
            .catch(function(err) {
                showPOToast("Error updating status in real-time.", false);
            });
        };

        window.triggerQuickGRN = function() {
            if (!window.currentActivePONumber) return;
            var poNo = window.currentActivePONumber;

            var fd = new FormData();
            fd.append("poNumber", poNo);

            fetch('@Url.Action("QuickGenerateGRN", "Purchase")', {
                method: "POST",
                body: fd
            })
            .then(function(res) { return res.json(); })
            .then(function(res) {
                if (res && res.success) {
                    updateStepperUI("Delivered");
                    if (document.getElementById("modalPoStatus")) document.getElementById("modalPoStatus").textContent = "Delivered";

                    // Update table row
                    var badge = document.getElementById("po-status-badge-" + poNo);
                    if (badge) {
                        badge.className = "po-status po-status-delivered";
                        badge.innerHTML = '<i class="fa fa-box-open"></i> Delivered';
                    }

                    showPOToast(res.message || "Goods Receipt Note created successfully.", true);
                } else {
                    showPOToast("Error generating GRN: " + (res.message || "Operation failed"), false);
                }
            })
            .catch(function(err) {
                showPOToast("Network error generating GRN.", false);
            });
        };

        window.sendCopyEmailToVendor = function() {
            if (!window.currentActivePONumber) return;
            var vendorName = document.getElementById("modalVendorName")?.textContent || "Vendor Partner";
            var vendorEmail = document.getElementById("modalVendorEmail")?.textContent || "procurement-support@@supplier.com";
            showPOToast("Official PO voucher (" + window.currentActivePONumber + ") transmitted to " + vendorName + " (" + vendorEmail + ").", true);
        };

        window.printPODetails = function() {
            var printArea = document.getElementById("printablePOArea");
            if (!printArea) return;

            // Clone printable contents
            var clone = printArea.cloneNode(true);

            // Remove non-print elements from clone
            var noPrints = clone.querySelectorAll(".no-print, .po-quick-action-bar, .po-stepper-container");
            noPrints.forEach(function(el) { el.remove(); });

            var printWin = window.open("", "_blank", "width=960,height=850");
            var doc = printWin.document;
            doc.open();
            doc.write('<!DOCTYPE html><html><head><title>Purchase Order Slip - ' + (window.currentActivePONumber || 'PO') + '<\/title>');
            doc.write('<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@@5.3.0/dist/css/bootstrap.min.css">');
            doc.write('<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">');
            doc.write('<style>' +
                'body { padding: 30px; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; color: #1e293b; background: #fff; } ' +
                'table { width: 100%; border-collapse: collapse; margin-top: 15px; } ' +
                'th, td { padding: 8px 10px !important; border: 1px solid #cbd5e1 !important; } ' +
                'th { background-color: #f1f5f9 !important; font-weight: 700; font-size: 0.75rem; text-transform: uppercase; } ' +
                '@@media print { body { padding: 10px; } .no-print { display: none !important; } }' +
                '<\/style>');
            doc.write('<\/head><body>');
            doc.write(clone.innerHTML);
            doc.write('<\/body><\/html>');
            doc.close();
            printWin.focus();
            setTimeout(function() {
                printWin.print();
                printWin.close();
            }, 450);
        };

        /* =====================================================
           INITIALIZATION
           ===================================================== */

        function initializePOPage() {
            /* Format all PO monetary values */
            applyCompactMoneyFormatting();

            /* Initialize result counter */
            var rows = document.querySelectorAll("#poDataTable tbody tr:not(#poEmptyRow)");
            updatePOResultCount(rows.length, "");
        }

        if (document.readyState === "loading") {
            document.addEventListener("DOMContentLoaded", initializePOPage);
        } else {
            initializePOPage();
        }

    </script>
}

@model List<ERP_System.Models.PurchaseOrderItem>

@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Purchase Orders (PO) - NetSuite Lifecycle Tracker";
}

<link rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

<style>
    /* =========================================================
           PURCHASE ORDER REGISTRY
           Premium ERP UI
           ========================================================= */

    :root {
        --po-primary: #2563eb;
        --po-primary-dark: #1d4ed8;
        --po-primary-soft: #eff6ff;
        --po-info: #0891b2;
        --po-info-soft: #ecfeff;
        --po-success: #16a34a;
        --po-success-soft: #f0fdf4;
        --po-warning: #d97706;
        --po-warning-soft: #fffbeb;
        --po-danger: #dc2626;
        --po-danger-soft: #fef2f2;
        --po-text: #172033;
        --po-muted: #64748b;
        --po-border: #e5e7eb;
        --po-bg: #f6f8fc;
        --po-white: #ffffff;
        --po-shadow: 0 10px 35px rgba(15, 23, 42, .06);
        --po-shadow-hover: 0 18px 45px rgba(15, 23, 42, .10);
    }

    /* =========================================================
           PAGE
           ========================================================= */

    .po-page {
        min-height: 100vh;
        background: radial-gradient( circle at top right, rgba(37, 99, 235, .055), transparent 30% ), radial-gradient( circle at bottom left, rgba(8, 145, 178, .04), transparent 28% ), var(--po-bg);
        padding-bottom: 50px;
    }

    .po-container {
        max-width: 1800px;
        margin: 0 auto;
    }

    /* =========================================================
           HEADER
           ========================================================= */

    .po-header {
        position: relative;
        background: var(--po-white);
        border: 1px solid var(--po-border);
        border-radius: 20px;
        padding: 24px 26px;
        margin-bottom: 20px;
        box-shadow: var(--po-shadow);
        overflow: hidden;
        animation: poFadeUp .45s ease both;
    }

        .po-header::before {
            content: "";
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 4px;
            background: linear-gradient( 90deg, #2563eb, #0891b2, #6366f1 );
        }

    .po-header-content {
        position: relative;
        z-index: 1;
    }

    .po-breadcrumb {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 8px;
        margin-bottom: 12px;
        font-size: 12px;
    }

        .po-breadcrumb a {
            color: var(--po-muted);
            text-decoration: none;
            transition: color .2s ease;
        }

            .po-breadcrumb a:hover {
                color: var(--po-primary);
            }

    .po-breadcrumb-separator {
        color: #cbd5e1;
    }

    .po-system-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 5px 10px;
        border-radius: 999px;
        background: var(--po-info-soft);
        color: var(--po-info);
        border: 1px solid #cffafe;
        font-size: 10px;
        font-weight: 800;
        letter-spacing: .04em;
    }

    .po-title-row {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 25px;
    }

    .po-title-wrapper {
        min-width: 0;
    }

    .po-title {
        display: flex;
        align-items: center;
        gap: 12px;
        margin: 0;
        color: var(--po-text);
        font-size: clamp(1.35rem, 2vw, 1.85rem);
        font-weight: 800;
        letter-spacing: -.035em;
        line-height: 1.2;
    }

    .po-title-icon {
        width: 44px;
        height: 44px;
        flex: 0 0 44px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 13px;
        background: linear-gradient( 135deg, #0891b2, #2563eb );
        color: #fff;
        box-shadow: 0 8px 20px rgba(8, 145, 178, .22);
    }

    .po-subtitle {
        color: var(--po-muted);
        font-size: 13px;
        line-height: 1.6;
        margin: 9px 0 0 56px;
        max-width: 850px;
    }

    .po-header-actions {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 9px;
        flex-shrink: 0;
    }

    .po-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        min-height: 38px;
        padding: 8px 15px;
        border-radius: 10px;
        font-size: 12px;
        font-weight: 700;
        transition: all .22s ease;
        white-space: nowrap;
    }

    .po-btn-dashboard {
        color: #475569;
        background: #fff;
        border: 1px solid #dbe1ea;
    }

        .po-btn-dashboard:hover {
            color: var(--po-primary);
            border-color: #bfdbfe;
            background: #f8fbff;
            transform: translateY(-1px);
        }

    .po-btn-export {
        color: #fff;
        background: linear-gradient( 135deg, #0891b2, #0e7490 );
        border: 1px solid #0891b2;
        box-shadow: 0 7px 18px rgba(8, 145, 178, .18);
    }

        .po-btn-export:hover {
            color: #fff;
            transform: translateY(-2px);
            box-shadow: 0 11px 24px rgba(8, 145, 178, .25);
        }

    /* =========================================================
           KPI CARDS
           ========================================================= */

    .po-kpi-card {
        position: relative;
        height: 100%;
        background: var(--po-white);
        border: 1px solid var(--po-border);
        border-radius: 17px;
        padding: 18px;
        box-shadow: var(--po-shadow);
        overflow: hidden;
        transition: transform .25s ease, box-shadow .25s ease, border-color .25s ease;
        animation: poFadeUp .5s ease both;
    }

        .po-kpi-card:hover {
            transform: translateY(-4px);
            box-shadow: var(--po-shadow-hover);
            border-color: #d9e1ec;
        }

        .po-kpi-card::after {
            content: "";
            position: absolute;
            width: 95px;
            height: 95px;
            right: -42px;
            top: -42px;
            border-radius: 50%;
            background: rgba(37, 99, 235, .035);
        }

    .po-kpi-top {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
    }

    .po-kpi-label {
        color: #64748b;
        font-size: 10px;
        font-weight: 800;
        letter-spacing: .075em;
        text-transform: uppercase;
    }

    .po-kpi-icon {
        width: 38px;
        height: 38px;
        flex: 0 0 38px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 11px;
        font-size: 14px;
    }

    .po-kpi-primary .po-kpi-icon {
        color: var(--po-primary);
        background: var(--po-primary-soft);
    }

    .po-kpi-info .po-kpi-icon {
        color: var(--po-info);
        background: var(--po-info-soft);
    }

    .po-kpi-success .po-kpi-icon {
        color: var(--po-success);
        background: var(--po-success-soft);
    }

    .po-kpi-warning .po-kpi-icon {
        color: var(--po-warning);
        background: var(--po-warning-soft);
    }

    .po-kpi-value {
        position: relative;
        z-index: 1;
        color: var(--po-text);
        font-size: 21px;
        font-weight: 800;
        letter-spacing: -.025em;
        margin-top: 13px;
        line-height: 1.25;
    }

    .po-kpi-meta {
        color: #94a3b8;
        font-size: 11px;
        margin-top: 7px;
        line-height: 1.45;
    }

    /* =========================================================
           MONEY
           ========================================================= */

    .compact-money {
        display: inline-flex;
        align-items: center;
        white-space: nowrap;
        color: #172033;
        font-weight: 800;
        cursor: help;
        border-bottom: 1px dashed #cbd5e1;
        line-height: 1.4;
    }

        .compact-money:hover {
            color: var(--po-primary);
            border-bottom-color: #93c5fd;
        }

    /* =========================================================
           REGISTRY CARD
           ========================================================= */

    .po-registry-card {
        background: var(--po-white);
        border: 1px solid var(--po-border);
        border-radius: 19px;
        box-shadow: var(--po-shadow);
        overflow: hidden;
        animation: poFadeUp .6s ease both;
    }

    .po-registry-header {
        padding: 20px 22px;
        border-bottom: 1px solid #edf0f4;
        background: linear-gradient( 180deg, #fff, #fcfdff );
    }

    .po-registry-heading {
        display: flex;
        align-items: center;
        gap: 11px;
    }

    .po-registry-heading-icon {
        width: 38px;
        height: 38px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--po-info);
        background: var(--po-info-soft);
    }

    .po-registry-title {
        color: var(--po-text);
        font-size: 15px;
        font-weight: 800;
        margin: 0;
    }

    .po-registry-description {
        color: #94a3b8;
        font-size: 11px;
        margin: 3px 0 0;
    }

    .po-registry-tools {
        display: flex;
        align-items: center;
        gap: 9px;
    }

    /* =========================================================
           SEARCH
           ========================================================= */

    .po-search-wrapper {
        position: relative;
        width: 285px;
    }

        .po-search-wrapper > i {
            position: absolute;
            left: 13px;
            top: 50%;
            transform: translateY(-50%);
            color: #94a3b8;
            font-size: 12px;
            pointer-events: none;
        }

    .po-search-input {
        width: 100%;
        height: 39px;
        padding: 8px 36px 8px 36px;
        border: 1px solid #dbe1e8;
        border-radius: 10px;
        outline: none;
        color: #334155;
        background: #fff;
        font-size: 12px;
        transition: all .2s ease;
    }

        .po-search-input::placeholder {
            color: #a0aec0;
        }

        .po-search-input:focus {
            border-color: #67e8f9;
            box-shadow: 0 0 0 3px rgba(8, 145, 178, .08);
        }

    .po-search-clear {
        position: absolute;
        right: 8px;
        top: 50%;
        transform: translateY(-50%);
        width: 25px;
        height: 25px;
        border: 0;
        border-radius: 6px;
        background: transparent;
        color: #94a3b8;
        display: none;
        align-items: center;
        justify-content: center;
        cursor: pointer;
    }

        .po-search-clear:hover {
            background: #f1f5f9;
            color: #475569;
        }

    .po-result-count {
        color: #94a3b8;
        font-size: 11px;
        white-space: nowrap;
    }

    /* =========================================================
           TABLE
           ========================================================= */

    .po-table-container {
        width: 100%;
        overflow-x: auto;
        overflow-y: hidden;
        scrollbar-width: thin;
    }

        .po-table-container::-webkit-scrollbar {
            height: 7px;
        }

        .po-table-container::-webkit-scrollbar-track {
            background: #f8fafc;
        }

        .po-table-container::-webkit-scrollbar-thumb {
            background: #cbd5e1;
            border-radius: 20px;
        }

    .po-table {
        width: 100%;
        min-width: 1050px;
        border-collapse: separate;
        border-spacing: 0;
        margin: 0;
    }

        .po-table thead th {
            padding: 12px 15px;
            background: #f8fafc;
            border-bottom: 1px solid #e2e8f0;
            color: #64748b;
            font-size: 10px;
            font-weight: 800;
            letter-spacing: .055em;
            text-transform: uppercase;
            white-space: nowrap;
        }

        .po-table tbody td {
            padding: 15px;
            border-bottom: 1px solid #edf1f5;
            color: #475569;
            font-size: 12px;
            vertical-align: middle;
            background: #fff;
        }

        .po-table tbody tr {
            transition: background .18s ease, box-shadow .18s ease;
        }

            .po-table tbody tr:hover td {
                background: #f8fbff;
            }

            .po-table tbody tr:last-child td {
                border-bottom: 0;
            }

    /* =========================================================
           PO NUMBER
           ========================================================= */

    .po-number {
        display: inline-flex;
        align-items: center;
        padding: 6px 9px;
        border-radius: 8px;
        background: var(--po-primary-soft);
        color: var(--po-primary);
        font-size: 11px;
        font-weight: 800;
        white-space: nowrap;
    }

    /* =========================================================
           VENDOR
           ========================================================= */

    .po-vendor-name {
        display: block;
        color: var(--po-text);
        font-weight: 700;
        line-height: 1.4;
        margin-bottom: 3px;
    }

    .po-vendor-meta {
        color: #94a3b8;
        font-size: 10px;
        font-weight: 600;
    }

    /* =========================================================
           ITEM COUNT
           ========================================================= */

    .po-items-badge {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 6px 9px;
        border-radius: 8px;
        color: #475569;
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        font-size: 10px;
        font-weight: 700;
        white-space: nowrap;
    }

    /* =========================================================
           STATUS BADGES
           ========================================================= */

    .po-status {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 6px 10px;
        border-radius: 999px;
        font-size: 10px;
        font-weight: 800;
        white-space: nowrap;
    }

    .po-status-transit {
        color: #0e7490;
        background: var(--po-info-soft);
        border: 1px solid #a5f3fc;
    }

    .po-status-confirmed {
        color: #1d4ed8;
        background: var(--po-primary-soft);
        border: 1px solid #bfdbfe;
    }

    .po-status-delivered {
        color: #15803d;
        background: var(--po-success-soft);
        border: 1px solid #bbf7d0;
    }

    /* =========================================================
           PAYMENT TERMS
           ========================================================= */

    .po-payment-badge {
        display: inline-flex;
        align-items: center;
        padding: 6px 10px;
        border-radius: 999px;
        color: #475569;
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        font-size: 10px;
        font-weight: 700;
        white-space: nowrap;
    }

    /* =========================================================
           VIEW BUTTON
           ========================================================= */

    .po-view-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        min-height: 33px;
        padding: 6px 11px;
        border-radius: 8px;
        color: #475569;
        background: #fff;
        border: 1px solid #dbe1e8;
        font-size: 10px;
        font-weight: 800;
        transition: all .2s ease;
        white-space: nowrap;
    }

        .po-view-btn:hover {
            color: var(--po-primary);
            background: var(--po-primary-soft);
            border-color: #bfdbfe;
            transform: translateY(-1px);
        }

    /* =========================================================
           EMPTY STATE
           ========================================================= */

    .po-empty-state {
        padding: 55px 20px;
        text-align: center;
    }

    .po-empty-icon {
        width: 62px;
        height: 62px;
        margin: 0 auto 15px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 17px;
        background: #f1f5f9;
        color: #94a3b8;
        font-size: 23px;
    }

    .po-empty-state h6 {
        color: #334155;
        font-weight: 800;
        margin-bottom: 5px;
    }

    .po-empty-state p {
        color: #94a3b8;
        font-size: 12px;
        margin: 0;
    }

    /* =========================================================
           FOOTER
           ========================================================= */

    .po-registry-footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 15px;
        padding: 12px 18px;
        background: #fafbfc;
        border-top: 1px solid #edf1f5;
        color: #94a3b8;
        font-size: 10px;
    }

    .po-footer-item {
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }

        .po-footer-item i {
            color: #64748b;
        }

    /* =========================================================
           ANIMATIONS
           ========================================================= */

    @@keyframes poFadeUp {
        from {
            opacity: 0;
            transform: translateY(10px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* =========================================================
           RESPONSIVE
           ========================================================= */

    @@media (max-width: 1199.98px) {

        .po-title-row {
            flex-direction: column;
            align-items: stretch;
        }

        .po-header-actions {
            justify-content: flex-start;
        }

        .po-search-wrapper {
            width: 260px;
        }
    }

    @@media (max-width: 991.98px) {

        .po-header {
            padding: 20px;
        }

        .po-registry-header {
            padding: 18px;
        }

            .po-registry-header > .d-flex {
                flex-direction: column;
                align-items: stretch !important;
            }

        .po-registry-tools {
            width: 100%;
        }

        .po-search-wrapper {
            width: 100%;
        }

        .po-result-count {
            display: none;
        }

        .po-kpi-value {
            font-size: 19px;
        }
    }

    @@media (max-width: 767.98px) {

        .po-page {
            padding-bottom: 30px;
        }

        .po-container {
            padding-left: 10px !important;
            padding-right: 10px !important;
        }

        .po-header {
            border-radius: 15px;
            padding: 17px;
            margin-bottom: 15px;
        }

        .po-title {
            font-size: 1.28rem;
        }

        .po-title-icon {
            width: 39px;
            height: 39px;
            flex-basis: 39px;
            border-radius: 11px;
        }

        .po-subtitle {
            margin-left: 0;
            margin-top: 9px;
            font-size: 12px;
        }

        .po-header-actions {
            display: grid;
            grid-template-columns: 1fr 1fr;
            width: 100%;
        }

        .po-btn {
            width: 100%;
        }

        .po-registry-card {
            border-radius: 15px;
        }

        .po-registry-tools {
            display: block;
        }

        .po-search-wrapper {
            width: 100%;
        }

        .po-table thead th,
        .po-table tbody td {
            padding-left: 12px;
            padding-right: 12px;
        }

        .po-registry-footer {
            align-items: flex-start;
            flex-direction: column;
            gap: 7px;
        }
    }

    @@media (max-width: 575.98px) {

        .po-header {
            padding: 15px;
        }

        .po-breadcrumb {
            font-size: 10px;
        }

        .po-system-badge {
            font-size: 9px;
            padding: 4px 8px;
        }

        .po-title {
            font-size: 1.15rem;
            gap: 9px;
        }

        .po-title-icon {
            width: 35px;
            height: 35px;
            flex-basis: 35px;
            font-size: 13px;
        }

        .po-header-actions {
            grid-template-columns: 1fr;
        }

        .po-kpi-card {
            padding: 15px;
            border-radius: 14px;
        }

        .po-kpi-value {
            font-size: 18px;
        }

        .po-registry-header {
            padding: 15px;
        }

        .po-registry-title {
            font-size: 14px;
        }

        .po-registry-description {
            font-size: 10px;
        }
    }

    @@media (prefers-reduced-motion: reduce) {

        *,
        *::before,
        *::after {
            animation-duration: .01ms !important;
            animation-iteration-count: 1 !important;
            transition-duration: .01ms !important;
            scroll-behavior: auto !important;
        }
    }

    /* =========================================================
           PRINT
           ========================================================= */

    @@media print {

        .po-page {
            background: #fff !important;
            padding: 0 !important;
        }

        .po-header,
        .po-kpi-card,
        .po-registry-card {
            box-shadow: none !important;
        }

        .po-header-actions,
        .po-registry-tools,
        .po-registry-footer {
            display: none !important;
        }

        .po-header,
        .po-kpi-card,
        .po-registry-card {
            border: 1px solid #ddd !important;
        }

        .po-table {
            min-width: 100% !important;
        }

        .po-table-container {
            overflow: visible !important;
        }
    }
</style>


<div class="po-page">

    <div class="container-fluid px-2 px-md-4 pt-3 pt-md-4 po-container">

        <!-- =====================================================
             HEADER
             ===================================================== -->

        <div class="po-header">

            <div class="po-header-content">

                <div class="po-breadcrumb">

                    <a href="@Url.Action("Index", "Purchase")">
                        <i class="fa fa-arrow-left me-1"></i>
                        Control Hub
                    </a>

                    <span class="po-breadcrumb-separator">/</span>

                    <span class="po-system-badge">
                        <i class="fa fa-boxes-stacked"></i>
                        NetSuite PO Fulfillment Suite
                    </span>

                </div>


                <div class="po-title-row">

                    <div class="po-title-wrapper">

                        <h1 class="po-title">

                            <span class="po-title-icon">
                                <i class="fa fa-file-invoice"></i>
                            </span>

                            <span>
                                Purchase Orders Registry
                            </span>

                        </h1>

                        <p class="po-subtitle">
                            Monitor supplier purchase orders, dispatch commitments,
                            shipping progress, delivery milestones, and payment terms
                            from one centralized procurement workspace.
                        </p>

                    </div>


                    <div class="po-header-actions">

                        <a href="@Url.Action("Index", "Purchase")"
                           class="btn po-btn po-btn-dashboard">

                            <i class="fa fa-gauge"></i>
                            Dashboard

                        </a>


                        <div class="d-flex gap-2">
                            <a href="@Url.Action("ExportPOLedger", "Purchase")"
                               class="btn po-btn po-btn-export text-decoration-none">
                                <i class="fa fa-file-arrow-down me-1"></i>
                                Export PO Ledger (CSV)
                            </a>
                            <button type="button"
                                    class="btn po-btn po-btn-dashboard"
                                    onclick="window.print()">
                                <i class="fa fa-print"></i>
                                Print
                            </button>
                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- =====================================================
             KPI CARDS
             ===================================================== -->

        <div class="row g-3 mb-4">

            <!-- Total Value -->
            <div class="col-12 col-sm-6 col-lg-3">

                <div class="po-kpi-card po-kpi-primary">

                    <div class="po-kpi-top">


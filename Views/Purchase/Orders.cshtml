<div class="po-page">

    <div class="container-fluid px-2 px-md-4 pt-3 pt-md-4 po-container">

        <!-- =====================================================
             HEADER
             ===================================================== -->

        <div class="po-header">

            <div class="po-header-content">

                <div class="po-breadcrumb">

                    <a href="@Url.Action("Index", "Purchase")">
                        <i class="fa fa-arrow-left me-1"></i>
                        Control Hub
                    </a>

                    <span class="po-breadcrumb-separator">/</span>

                    <span class="po-system-badge">
                        <i class="fa fa-boxes-stacked"></i>
                        NetSuite PO Fulfillment Suite
                    </span>

                </div>


                <div class="po-title-row">

                    <div class="po-title-wrapper">

                        <h1 class="po-title">

                            <span class="po-title-icon">
                                <i class="fa fa-file-invoice"></i>
                            </span>

                            <span>
                                Purchase Orders Registry
                            </span>

                        </h1>

                        <p class="po-subtitle">
                            Monitor supplier purchase orders, dispatch commitments,
                            shipping progress, delivery milestones, and payment terms
                            from one centralized procurement workspace.
                        </p>

                    </div>


                    <div class="po-header-actions">

                        <a href="@Url.Action("Index", "Purchase")"
                           class="btn po-btn po-btn-dashboard">

                            <i class="fa fa-gauge"></i>
                            Dashboard

                        </a>


                        <div class="d-flex gap-2">
                            <a href="@Url.Action("ExportPOLedger", "Purchase")"
                               class="btn po-btn po-btn-export text-decoration-none">
                                <i class="fa fa-file-arrow-down me-1"></i>
                                Export PO Ledger (CSV)
                            </a>
                            <button type="button"
                                    class="btn po-btn po-btn-dashboard"
                                    onclick="window.print()">
                                <i class="fa fa-print"></i>
                                Print
                            </button>
                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- =====================================================
             KPI CARDS
             ===================================================== -->

        <div class="row g-3 mb-4">

            <!-- Total Value -->
            <div class="col-12 col-sm-6 col-lg-3">

                <div class="po-kpi-card po-kpi-primary">

                    <div class="po-kpi-top">

                        <div class="po-kpi-label">
                            Total Dispatched Value
                        </div>

                        <div class="po-kpi-icon">
                            <i class="fa fa-indian-rupee-sign"></i>
                        </div>

                    </div>

                    <div class="po-kpi-value">

                        <span class="compact-money"
                              data-value="@totalDispatchedVal"
                              id="kpiTotalDispatchedVal">
                            ₹ @totalDispatchedVal.ToString("N0", new System.Globalization.CultureInfo("en-IN"))
                        </span>

                    </div>

                    <div class="po-kpi-meta">
                        <i class="fa fa-file-invoice me-1"></i>
                        Across @(Model?.Count ?? 0) Active Purchase Orders
                    </div>

                </div>

            </div>


            <!-- In Transit -->
            <div class="col-12 col-sm-6 col-lg-3">

                <div class="po-kpi-card po-kpi-info">

                    <div class="po-kpi-top">

                        <div class="po-kpi-label">
                            In Transit Shipments
                        </div>

                        <div class="po-kpi-icon">
                            <i class="fa fa-truck-fast"></i>
                        </div>

                    </div>

                    <div class="po-kpi-value" id="kpiInTransitCount">
                        @Model.Count(p => p.Status == "In Transit") Shipments
                    </div>

                    <div class="po-kpi-meta">
                        <i class="fa fa-location-crosshairs me-1"></i>
                        Active GPS courier telemetry
                    </div>

                </div>

            </div>


            <!-- Delivered -->
            <div class="col-12 col-sm-6 col-lg-3">

                <div class="po-kpi-card po-kpi-success">

                    <div class="po-kpi-top">

                        <div class="po-kpi-label">
                            Delivered &amp; 3-Way Matched
                        </div>

                        <div class="po-kpi-icon">
                            <i class="fa fa-circle-check"></i>
                        </div>

                    </div>

                    <div class="po-kpi-value" id="kpiDeliveredCount">
                        @Model.Count(p => p.Status == "Delivered") Completed
                    </div>

                    <div class="po-kpi-meta">
                        <i class="fa fa-check-double me-1"></i>
                        Cleared for AP payment
                    </div>

                </div>

            </div>


            <!-- Confirmed -->
            <div class="col-12 col-sm-6 col-lg-3">

                <div class="po-kpi-card po-kpi-warning">

                    <div class="po-kpi-top">

                        <div class="po-kpi-label">
                            Confirmed Pending Dispatch
                        </div>

                        <div class="po-kpi-icon">
                            <i class="fa fa-clock"></i>
                        </div>

                    </div>

                    <div class="po-kpi-value" id="kpiConfirmedCount">
                        @Model.Count(p => p.Status == "Confirmed") Orders
                    </div>

                    <div class="po-kpi-meta">
                        <i class="fa fa-industry me-1"></i>
                        Factory assembly stage
                    </div>

                </div>

            </div>

        </div>


        <!-- =====================================================
             PO REGISTRY
             ===================================================== -->

        <div class="po-registry-card">

            <!-- Registry Header -->
            <div class="po-registry-header">

                <div class="d-flex flex-column flex-lg-row justify-content-between align-items-start align-items-lg-center gap-3">

                    <div class="po-registry-heading">

                        <div class="po-registry-heading-icon">
                            <i class="fa fa-table-list"></i>
                        </div>

                        <div>

                            <h2 class="po-registry-title">
                                Purchase Order Directory
                            </h2>

                            <p class="po-registry-description">
                                Supplier commitments and fulfillment lifecycle
                            </p>

                        </div>

                    </div>


                    <div class="po-registry-tools">

                        <div class="po-search-wrapper">

                            <i class="fa fa-search"></i>

                            <input type="text"
                                   id="poSearch"
                                   class="po-search-input"
                                   placeholder="Search PO#, vendor, status..."
                                   autocomplete="off"
                                   onkeyup="filterPOTable()" />

                            <button type="button"
                                    id="poSearchClear"
                                    class="po-search-clear"
                                    onclick="clearPOSearch()"
                                    title="Clear search">

                                <i class="fa fa-xmark"></i>

                            </button>

                        </div>


                        <span id="poResultCount"
                              class="po-result-count">

                            @Model.Count
                            order@(Model.Count == 1 ? "" : "s")

                        </span>

                    </div>

                </div>

            </div>


            <!-- =================================================
                 TABLE
                 ================================================= -->

            <div class="po-table-container">

                <table class="po-table"
                       id="poDataTable">

                    <thead>

                        <tr>

                            <th>
                                PO Number
                            </th>

                            <th>
                                Vendor Partner
                            </th>

                            <th>
                                Items Count
                            </th>

                            <th>
                                PO Value
                            </th>

                            <th>
                                Order Date
                            </th>

                            <th>
                                Shipping Status
                            </th>

                            <th>
                                Payment Terms
                            </th>

                            <th class="text-end">
                                Actions
                            </th>

                        </tr>

                    </thead>


                    <tbody>

                        @if (Model != null && Model.Any())
                        {
                            foreach (var po in Model)
                            {
                                <tr id="po-row-@po.PONumber">

                                    <!-- PO Number -->
                                    <td>

                                        <a href="@Url.Action("OrderDetails", "Purchase", new { poNumber = po.PONumber })"
                                           class="po-number"
                                           title="Click to view full voucher slip for @po.PONumber">
                                            <i class="fa fa-file-lines me-1"></i>
                                            @po.PONumber
                                        </a>

                                    </td>


                                    <!-- Vendor -->
                                    <td>

                                        <span class="po-vendor-name">
                                            @po.VendorName
                                        </span>

                                        <span class="po-vendor-meta">
                                            <i class="fa fa-circle-check me-1"></i>
                                            GSTIN Verified Partner
                                        </span>

                                    </td>


                                    <!-- Items -->
                                    <td>

                                        <span class="po-items-badge">

                                            <i class="fa fa-list"></i>

                                            @po.ItemsCount
                                            Line Item@(po.ItemsCount == 1 ? "" : "s")

                                        </span>

                                    </td>


                                    <!-- PO Value -->
                                    <td>

                                        <span class="compact-money"
                                              data-value="@po.TotalAmount">
                                            @po.TotalAmount
                                        </span>

                                    </td>


                                    <!-- Order Date -->
                                    <td>

                                        <span class="text-muted">
                                            <i class="fa fa-calendar-days me-1"></i>
                                            @po.OrderDate
                                        </span>

                                    </td>


                                    <!-- Status -->
                                    <td class="po-status-cell" id="po-status-cell-@po.PONumber">

                                        @if (po.Status == "In Transit")
                                        {
                                            <span class="po-status po-status-transit" id="po-status-badge-@po.PONumber">

                                                <i class="fa fa-truck-fast"></i>

                                                In Transit

                                            </span>
                                        }
                                        else if (po.Status == "Confirmed")
                                        {
                                            <span class="po-status po-status-confirmed" id="po-status-badge-@po.PONumber">

                                                <i class="fa fa-circle-check"></i>

                                                Confirmed

                                            </span>
                                        }
                                        else
                                        {
                                            <span class="po-status po-status-delivered" id="po-status-badge-@po.PONumber">

                                                <i class="fa fa-box-open"></i>

                                                Delivered

                                            </span>
                                        }

                                    </td>


                                    <!-- Payment Terms -->
                                    <td>

                                        <span class="po-payment-badge">

                                            <i class="fa fa-credit-card me-1"></i>

                                            @po.PaymentTerms

                                        </span>

                                    </td>


                                    <!-- Actions -->
                                    <td class="text-end">

                                        <a href="@Url.Action("OrderDetails", "Purchase", new { poNumber = po.PONumber })"
                                           class="btn po-view-btn shadow-sm"
                                           data-po="@po.PONumber"
                                           title="View official PO details & voucher slip for @po.PONumber">
                                            <i class="fa fa-eye me-1"></i>
                                            View
                                        </a>

                                    </td>

                                </tr>
                            }
                        }
                        else
                        {
                            <tr id="poEmptyRow">

                                <td colspan="8">

                                    <div class="po-empty-state">

                                        <div class="po-empty-icon">
                                            <i class="fa fa-file-circle-xmark"></i>
                                        </div>

                                        <h6>
                                            No Purchase Orders Found
                                        </h6>

                                        <p>
                                            There are currently no purchase orders available
                                            in the registry.
                                        </p>

                                    </div>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>


            <!-- Footer -->
            <div class="po-registry-footer">

                <div class="po-footer-item">

                    <i class="fa fa-circle-info"></i>

                    <span>
                        Hover over monetary values to view the exact Indian-formatted amount.
                    </span>

                </div>


                <div class="po-footer-item">

                    <i class="fa fa-arrows-left-right"></i>

                    <span>
                        Scroll horizontally on smaller screens to view all PO columns.
                    </span>

                </div>

            </div>

        </div>

    </div>

</div>


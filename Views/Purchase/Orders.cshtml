@section Scripts {

    <script>

        /* =====================================================
           MONEY FORMATTERS
           ===================================================== */

        function parseMoneyValue(value) {

            if (typeof value === "number") {

                return Number.isFinite(value)
                    ? value
                    : 0;
            }

            var cleaned = String(value ?? "")
                .replace(/[^0-9.-]/g, "");

            var number = Number(cleaned);

            return Number.isFinite(number)
                ? number
                : 0;
        }


        function trimMoneyDecimal(value) {

            return value
                .toFixed(2)
                .replace(/\.00$/, "")
                .replace(/(\.\d)0$/, "$1");
        }


        function compactIndianMoney(value) {

            var number = parseMoneyValue(value);

            var abs = Math.abs(number);

            var sign = number < 0
                ? "-"
                : "";


            if (abs >= 10000000) {

                return sign +
                    "₹" +
                    trimMoneyDecimal(abs / 10000000) +
                    "Cr";
            }


            if (abs >= 100000) {

                return sign +
                    "₹" +
                    trimMoneyDecimal(abs / 100000) +
                    "L";
            }


            if (abs >= 1000) {

                return sign +
                    "₹" +
                    trimMoneyDecimal(abs / 1000) +
                    "K";
            }


            return sign +
                "₹" +
                abs.toLocaleString("en-IN", {
                    maximumFractionDigits: 2
                });
        }


        function exactIndianMoney(value) {

            var number = parseMoneyValue(value);

            var formatted =
                Math.abs(number).toLocaleString(
                    "en-IN",
                    {
                        minimumFractionDigits: 2,
                        maximumFractionDigits: 2
                    }
                );

            return number < 0
                ? "-₹" + formatted
                : "₹" + formatted;
        }


        function applyCompactMoneyFormatting(root) {

            var scope = root || document;

            scope
                .querySelectorAll(".compact-money")
                .forEach(function (element) {

                    var rawValue =
                        element.getAttribute("data-value") || "0";

                    var compactValue =
                        compactIndianMoney(rawValue);

                    var exactValue =
                        exactIndianMoney(rawValue);

                    element.textContent =
                        compactValue;

                    element.setAttribute(
                        "title",
                        exactValue
                    );

                    element.setAttribute(
                        "data-full-value",
                        exactValue
                    );

                    element.setAttribute(
                        "aria-label",
                        exactValue
                    );

                });
        }


        /* =====================================================
           SEARCH
           ===================================================== */

        function filterPOTable() {

            var searchInput =
                document.getElementById("poSearch");

            if (!searchInput) {
                return;
            }

            var filter =
                searchInput.value
                    .toUpperCase()
                    .trim();

            var table =
                document.getElementById("poDataTable");

            if (!table) {
                return;
            }

            var tbody =
                table.getElementsByTagName("tbody")[0];

            if (!tbody) {
                return;
            }

            var rows =
                tbody.getElementsByTagName("tr");

            var visibleCount = 0;


            for (var i = 0; i < rows.length; i++) {

                var row = rows[i];

                if (row.id === "poEmptyRow") {
                    continue;
                }

                var text =
                    row.textContent ||
                    row.innerText;

                var matches =
                    text
                        .toUpperCase()
                        .indexOf(filter) > -1;

                row.style.display =
                    matches ? "" : "none";

                if (matches) {
                    visibleCount++;
                }
            }


            var clearButton =
                document.getElementById(
                    "poSearchClear"
                );

            if (clearButton) {

                clearButton.style.display =
                    filter.length > 0
                        ? "flex"
                        : "none";
            }


            updatePOResultCount(
                visibleCount,
                filter
            );
        }


        function updatePOResultCount(
            count,
            filter
        ) {

            var resultCount =
                document.getElementById(
                    "poResultCount"
                );

            if (!resultCount) {
                return;
            }


            if (filter && filter.length > 0) {

                resultCount.textContent =
                    count +
                    " matching order" +
                    (count === 1 ? "" : "s");

            }
            else {

                resultCount.textContent =
                    count +
                    " order" +
                    (count === 1 ? "" : "s");
            }
        }


        function clearPOSearch() {

            var searchInput =
                document.getElementById(
                    "poSearch"
                );

            if (!searchInput) {
                return;
            }

            searchInput.value = "";

            filterPOTable();

            searchInput.focus();
        }


        /* =====================================================
           VIEW PO DETAILS & PRINT
           ===================================================== */

        function viewPODetails(poNumber, vendor, itemsCount, totalAmount, orderDate, status, paymentTerms) {
            // Populate immediate baseline values
            if (document.getElementById("modalPoNumber")) document.getElementById("modalPoNumber").textContent = poNumber || "PO-2026-0891";
            if (document.getElementById("modalPoDate")) document.getElementById("modalPoDate").textContent = orderDate || "29 Aug 2026";
            if (document.getElementById("modalVendorName")) document.getElementById("modalVendorName").textContent = vendor || "TechInfra Solutions Ltd";
            if (document.getElementById("modalPaymentTerms")) document.getElementById("modalPaymentTerms").textContent = paymentTerms || "Net 30";
            if (document.getElementById("modalPoStatus")) document.getElementById("modalPoStatus").textContent = status || "Active";
            if (document.getElementById("modalGrandTotal")) document.getElementById("modalGrandTotal").textContent = totalAmount || "₹ 4,20,000.00";

            // Live fetch for enterprise details
            fetch('@Url.Action("GetPODetails", "Purchase")?poNumber=' + encodeURIComponent(poNumber || ''))
                .then(function (res) { return res.json(); })
                .then(function (data) {
                    if (data && data.success) {
                        if (data.po) {
                            if (document.getElementById("modalPoNumber")) document.getElementById("modalPoNumber").textContent = data.po.poNumber;
                            if (document.getElementById("modalPoDate")) document.getElementById("modalPoDate").textContent = data.po.orderDate;
                            if (document.getElementById("modalVendorName")) document.getElementById("modalVendorName").textContent = data.po.vendorName;
                            if (document.getElementById("modalPaymentTerms")) document.getElementById("modalPaymentTerms").textContent = data.po.paymentTerms;
                            if (document.getElementById("modalPoStatus")) document.getElementById("modalPoStatus").textContent = data.po.status;
                            if (document.getElementById("modalGrandTotal")) document.getElementById("modalGrandTotal").textContent = data.grandTotal || data.po.totalAmount;
                        }
                        if (data.gstin && document.getElementById("modalVendorGstin")) document.getElementById("modalVendorGstin").textContent = data.gstin;
                        if (data.subtotal && document.getElementById("modalSubtotal")) document.getElementById("modalSubtotal").textContent = data.subtotal;
                        if (data.taxAmount && document.getElementById("modalTaxAmount")) document.getElementById("modalTaxAmount").textContent = data.taxAmount;
                        if (data.authorizedSignatory && document.getElementById("modalSignatory")) document.getElementById("modalSignatory").textContent = data.authorizedSignatory;

                        if (data.items && data.items.length > 0) {
                            var tbody = document.getElementById("modalPoItemsBody");
                            if (tbody) {
                                tbody.innerHTML = data.items.map(function (item) {
                                    return '<tr>' +
                                        '<td class="text-start"><span class="fw-bold text-dark d-block">' + item.item + '</span><span class="text-muted extra-small">Material Grade Standard, Verified Specifications</span></td>' +
                                        '<td>' + item.hsn + '</td>' +
                                        '<td class="fw-bold">' + item.qty + ' Nos</td>' +
                                        '<td>' + item.unitPrice + '</td>' +
                                        '<td>' + item.tax + '</td>' +
                                        '<td class="text-end fw-bold">' + item.total + '</td>' +
                                        '</tr>';
                                }).join('');
                            }
                        }
                    }
                })
                .catch(function (err) {
                    console.warn("Could not fetch detailed PO info, displaying cached data.", err);
                })
                .finally(function () {
                    var modalEl = document.getElementById("poDetailsModal");
                    if (modalEl) {
                        var modal = bootstrap.Modal.getInstance(modalEl) || new bootstrap.Modal(modalEl);
                        modal.show();
                    }
                });
        }

        function printPODetails() {
            var printContents = document.getElementById('printablePOArea').innerHTML;
            var printWin = window.open('', '_blank', 'width=900,height=800');
            printWin.document.write('<html><head><title>Purchase Order Slip</title>');
            printWin.document.write('<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">');
            printWin.document.write('<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">');
            printWin.document.write('<style>body{padding:25px;font-family:Segoe UI,sans-serif;color:#1e293b;} @@media print {.no-print{display:none;}}</style>');
            printWin.document.write('</head><body>');
            printWin.document.write(printContents);
            printWin.document.write('</body></html>');
            printWin.document.close();
            printWin.focus();
            setTimeout(function() {
                printWin.print();
                printWin.close();
            }, 400);
        }


        /* =====================================================
           INITIALIZATION
           ===================================================== */

        document.addEventListener(
            "DOMContentLoaded",
            function () {

                /* Format all PO monetary values */
                applyCompactMoneyFormatting();


                /* Initialize result counter */
                var rows =
                    document.querySelectorAll(
                        "#poDataTable tbody tr:not(#poEmptyRow)"
                    );

                updatePOResultCount(
                    rows.length,
                    ""
                );

            }
        );

    </script>
}
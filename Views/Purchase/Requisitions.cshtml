@model List<ERP_System.Models.RequisitionItem>

@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Purchase Requisitions (PR) - SAP MM Console";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

<style>
    /* =========================================================
           PURCHASE REQUISITION CONSOLE
           Premium ERP UI
           ========================================================= */

    :root {
        --pr-primary: #2563eb;
        --pr-primary-dark: #1d4ed8;
        --pr-primary-soft: #eff6ff;
        --pr-success: #16a34a;
        --pr-success-soft: #f0fdf4;
        --pr-danger: #dc2626;
        --pr-danger-soft: #fef2f2;
        --pr-warning: #d97706;
        --pr-warning-soft: #fffbeb;
        --pr-info: #0891b2;
        --pr-info-soft: #ecfeff;
        --pr-text: #172033;
        --pr-muted: #64748b;
        --pr-border: #e5e7eb;
        --pr-bg: #f6f8fc;
        --pr-white: #ffffff;
        --pr-shadow: 0 10px 35px rgba(15, 23, 42, 0.06);
        --pr-shadow-hover: 0 18px 45px rgba(15, 23, 42, 0.10);
    }

    /* Page */
    .pr-page {
        min-height: 100vh;
        background: radial-gradient(circle at top right, rgba(37, 99, 235, 0.055), transparent 30%), radial-gradient(circle at bottom left, rgba(14, 165, 233, 0.04), transparent 28%), var(--pr-bg);
        padding-bottom: 50px;
    }

    .pr-container {
        max-width: 1800px;
        margin: 0 auto;
    }

    /* =========================================================
           HEADER
           ========================================================= */

    .pr-header {
        position: relative;
        background: var(--pr-white);
        border: 1px solid var(--pr-border);
        border-radius: 20px;
        padding: 24px 26px;
        margin-bottom: 20px;
        box-shadow: var(--pr-shadow);
        overflow: hidden;
        animation: prFadeUp .45s ease both;
    }

        .pr-header::before {
            content: "";
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 4px;
            background: linear-gradient(90deg, #2563eb, #06b6d4, #6366f1);
        }

    .pr-header-content {
        position: relative;
        z-index: 1;
    }

    .pr-breadcrumb {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 8px;
        margin-bottom: 12px;
        font-size: 12px;
    }

        .pr-breadcrumb a {
            color: var(--pr-muted);
            text-decoration: none;
            transition: color .2s ease;
        }

            .pr-breadcrumb a:hover {
                color: var(--pr-primary);
            }

    .pr-breadcrumb-separator {
        color: #cbd5e1;
    }

    .pr-system-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 5px 10px;
        border-radius: 999px;
        background: var(--pr-primary-soft);
        color: var(--pr-primary);
        border: 1px solid #dbeafe;
        font-size: 10px;
        font-weight: 800;
        letter-spacing: .04em;
    }

    .pr-title-row {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 25px;
    }

    .pr-title-wrapper {
        min-width: 0;
    }

    .pr-title {
        display: flex;
        align-items: center;
        gap: 12px;
        margin: 0;
        color: var(--pr-text);
        font-size: clamp(1.35rem, 2vw, 1.85rem);
        font-weight: 800;
        letter-spacing: -.035em;
        line-height: 1.2;
    }

    .pr-title-icon {
        width: 44px;
        height: 44px;
        flex: 0 0 44px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 13px;
        background: linear-gradient(135deg, #2563eb, #4f46e5);
        color: #fff;
        box-shadow: 0 8px 20px rgba(37, 99, 235, .22);
    }

    .pr-subtitle {
        color: var(--pr-muted);
        font-size: 13px;
        line-height: 1.6;
        margin: 9px 0 0 56px;
        max-width: 850px;
    }

    .pr-header-actions {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 9px;
        flex-shrink: 0;
    }

    .pr-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        min-height: 38px;
        padding: 8px 15px;
        border-radius: 10px;
        font-size: 12px;
        font-weight: 700;
        transition: all .22s ease;
        white-space: nowrap;
    }

    .pr-btn-dashboard {
        color: #475569;
        background: #fff;
        border: 1px solid #dbe1ea;
    }

        .pr-btn-dashboard:hover {
            color: var(--pr-primary);
            border-color: #bfdbfe;
            background: #f8fbff;
            transform: translateY(-1px);
        }

    .pr-btn-primary {
        color: #fff;
        background: linear-gradient(135deg, #2563eb, #1d4ed8);
        border: 1px solid #2563eb;
        box-shadow: 0 7px 18px rgba(37, 99, 235, .18);
    }

        .pr-btn-primary:hover {
            color: #fff;
            transform: translateY(-2px);
            box-shadow: 0 11px 24px rgba(37, 99, 235, .25);
        }

    /* =========================================================
           KPI CARDS
           ========================================================= */

    .pr-kpi-card {
        position: relative;
        height: 100%;
        background: var(--pr-white);
        border: 1px solid var(--pr-border);
        border-radius: 17px;
        padding: 18px;
        box-shadow: var(--pr-shadow);
        overflow: hidden;
        transition: transform .25s ease, box-shadow .25s ease, border-color .25s ease;
        animation: prFadeUp .5s ease both;
    }

        .pr-kpi-card:hover {
            transform: translateY(-4px);
            box-shadow: var(--pr-shadow-hover);
            border-color: #d9e1ec;
        }

        .pr-kpi-card::after {
            content: "";
            position: absolute;
            width: 90px;
            height: 90px;
            border-radius: 50%;
            right: -38px;
            top: -38px;
            background: rgba(37, 99, 235, .035);
        }

    .pr-kpi-top {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
    }

    .pr-kpi-label {
        color: #64748b;
        font-size: 10px;
        font-weight: 800;
        letter-spacing: .08em;
        text-transform: uppercase;
    }

    .pr-kpi-icon {
        width: 38px;
        height: 38px;
        flex: 0 0 38px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 11px;
        font-size: 14px;
    }

    .pr-kpi-warning .pr-kpi-icon {
        color: var(--pr-warning);
        background: var(--pr-warning-soft);
    }

    .pr-kpi-danger .pr-kpi-icon {
        color: var(--pr-danger);
        background: var(--pr-danger-soft);
    }

    .pr-kpi-info .pr-kpi-icon {
        color: var(--pr-info);
        background: var(--pr-info-soft);
    }

    .pr-kpi-success .pr-kpi-icon {
        color: var(--pr-success);
        background: var(--pr-success-soft);
    }

    .pr-kpi-value {
        position: relative;
        z-index: 1;
        color: var(--pr-text);
        font-size: 21px;
        font-weight: 800;
        letter-spacing: -.025em;
        margin-top: 13px;
        line-height: 1.2;
    }

    .pr-kpi-meta {
        color: #94a3b8;
        font-size: 11px;
        margin-top: 7px;
        line-height: 1.45;
    }

        .pr-kpi-meta.warning {
            color: var(--pr-warning);
        }

        .pr-kpi-meta.danger {
            color: var(--pr-danger);
        }

        .pr-kpi-meta.success {
            color: var(--pr-success);
        }

    /* =========================================================
           MAIN REGISTER CARD
           ========================================================= */

    .pr-register-card {
        background: var(--pr-white);
        border: 1px solid var(--pr-border);
        border-radius: 19px;
        box-shadow: var(--pr-shadow);
        overflow: hidden;
        animation: prFadeUp .6s ease both;
    }

    .pr-register-header {
        padding: 20px 22px;
        border-bottom: 1px solid #edf0f4;
        background: linear-gradient(180deg, #fff, #fcfdff);
    }

    .pr-register-heading {
        display: flex;
        align-items: center;
        gap: 11px;
    }

    .pr-register-heading-icon {
        width: 38px;
        height: 38px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--pr-primary);
        background: var(--pr-primary-soft);
    }

    .pr-register-title {
        color: var(--pr-text);
        font-size: 15px;
        font-weight: 800;
        margin: 0;
    }

    .pr-register-description {
        color: #94a3b8;
        font-size: 11px;
        margin: 3px 0 0;
    }

    .pr-register-tools {
        display: flex;
        align-items: center;
        gap: 9px;
    }

    .pr-search-wrapper {
        position: relative;
        width: 280px;
    }

        .pr-search-wrapper i {
            position: absolute;
            left: 13px;
            top: 50%;
            transform: translateY(-50%);
            color: #94a3b8;
            font-size: 12px;
            pointer-events: none;
        }

    .pr-search-input {
        width: 100%;
        height: 39px;
        padding: 8px 13px 8px 36px;
        border: 1px solid #dbe1e8;
        border-radius: 10px;
        outline: none;
        color: #334155;
        background: #fff;
        font-size: 12px;
        transition: all .2s ease;
    }

        .pr-search-input::placeholder {
            color: #a0aec0;
        }

        .pr-search-input:focus {
            border-color: #93c5fd;
            box-shadow: 0 0 0 3px rgba(37, 99, 235, .08);
        }

    .pr-search-clear {
        position: absolute;
        right: 9px;
        top: 50%;
        transform: translateY(-50%);
        width: 24px;
        height: 24px;
        border: 0;
        border-radius: 6px;
        background: transparent;
        color: #94a3b8;
        display: none;
        align-items: center;
        justify-content: center;
        cursor: pointer;
    }

        .pr-search-clear:hover {
            background: #f1f5f9;
            color: #475569;
        }

    .pr-result-count {
        color: #94a3b8;
        font-size: 11px;
        white-space: nowrap;
    }

    /* =========================================================
           TABLE
           ========================================================= */

    .pr-table-container {
        width: 100%;
        overflow-x: auto;
        overflow-y: hidden;
        scrollbar-width: thin;
    }

        .pr-table-container::-webkit-scrollbar {
            height: 7px;
        }

        .pr-table-container::-webkit-scrollbar-track {
            background: #f8fafc;
        }

        .pr-table-container::-webkit-scrollbar-thumb {
            background: #cbd5e1;
            border-radius: 20px;
        }

    .pr-table {
        width: 100%;
        min-width: 1050px;
        border-collapse: separate;
        border-spacing: 0;
        margin: 0;
    }

        .pr-table thead th {
            padding: 12px 15px;
            background: #f8fafc;
            border-bottom: 1px solid #e2e8f0;
            color: #64748b;
            font-size: 10px;
            font-weight: 800;
            letter-spacing: .055em;
            text-transform: uppercase;
            white-space: nowrap;
        }

        .pr-table tbody td {
            padding: 15px;
            border-bottom: 1px solid #edf1f5;
            color: #475569;
            font-size: 12px;
            vertical-align: middle;
            background: #fff;
        }

        .pr-table tbody tr {
            transition: background .18s ease, box-shadow .18s ease;
        }

            .pr-table tbody tr:hover td {
                background: #f8fbff;
            }

            .pr-table tbody tr:last-child td {
                border-bottom: 0;
            }

    .pr-id {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 6px 9px;
        border-radius: 8px;
        background: var(--pr-primary-soft);
        color: var(--pr-primary);
        font-size: 11px;
        font-weight: 800;
        white-space: nowrap;
    }

    .pr-department {
        color: var(--pr-text);
        font-weight: 700;
        display: block;
        margin-bottom: 3px;
    }

    .pr-cost-center {
        color: #94a3b8;
        font-size: 10px;
        font-weight: 600;
    }

    .pr-requester {
        display: flex;
        align-items: center;
        gap: 7px;
        color: #334155;
        font-weight: 650;
        white-space: nowrap;
    }

    .pr-requester-icon {
        width: 27px;
        height: 27px;
        border-radius: 8px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        color: #64748b;
        background: #f1f5f9;
        flex-shrink: 0;
    }

    .pr-item-summary {
        color: #1e293b;
        font-weight: 650;
        line-height: 1.45;
        max-width: 260px;
    }

    /* =========================================================
           MONEY
           ========================================================= */

    .compact-money {
        display: inline-flex;
        align-items: center;
        white-space: nowrap;
        color: #172033;
        font-weight: 800;
        cursor: help;
        border-bottom: 1px dashed #cbd5e1;
        line-height: 1.4;
    }

        .compact-money:hover {
            color: var(--pr-primary);
            border-bottom-color: #93c5fd;
        }

    /* =========================================================
           BADGES
           ========================================================= */

    .pr-urgency-badge {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 6px 9px;
        border-radius: 999px;
        font-size: 10px;
        font-weight: 800;
        white-space: nowrap;
    }

    .badge-urgency-urgent {
        background: var(--pr-danger-soft);
        color: #b91c1c;
        border: 1px solid #fecaca;
    }

    .badge-urgency-high {
        background: var(--pr-warning-soft);
        color: #b45309;
        border: 1px solid #fde68a;
    }

    .badge-urgency-medium {
        background: #f8fafc;
        color: #475569;
        border: 1px solid #e2e8f0;
    }

    /* =========================================================
           ACTION BUTTONS
           ========================================================= */

    .pr-action-group {
        display: inline-flex;
        align-items: center;
        justify-content: flex-end;
        gap: 6px;
    }

    .pr-action-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        min-height: 32px;
        padding: 6px 10px;
        border-radius: 8px;
        font-size: 10px;
        font-weight: 800;
        transition: all .2s ease;
    }

    .pr-approve-btn {
        color: #15803d;
        border: 1px solid #bbf7d0;
        background: #f0fdf4;
    }

        .pr-approve-btn:hover {
            color: #fff;
            background: #16a34a;
            border-color: #16a34a;
            transform: translateY(-1px);
            box-shadow: 0 5px 12px rgba(22, 163, 74, .18);
        }

    .pr-reject-btn {
        width: 34px;
        padding: 6px;
        color: #dc2626;
        border: 1px solid #fecaca;
        background: #fef2f2;
    }

        .pr-reject-btn:hover {
            color: #fff;
            background: #dc2626;
            border-color: #dc2626;
            transform: translateY(-1px);
            box-shadow: 0 5px 12px rgba(220, 38, 38, .18);
        }

    /* =========================================================
           EMPTY STATE
           ========================================================= */

    .pr-empty-state {
        padding: 55px 20px;
        text-align: center;
    }

    .pr-empty-icon {
        width: 62px;
        height: 62px;
        margin: 0 auto 15px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 17px;
        background: #f1f5f9;
        color: #94a3b8;
        font-size: 23px;
    }

    .pr-empty-state h6 {
        color: #334155;
        font-weight: 800;
        margin-bottom: 5px;
    }

    .pr-empty-state p {
        color: #94a3b8;
        font-size: 12px;
        margin: 0;
    }

    /* =========================================================
           FOOTER INFO
           ========================================================= */

    .pr-register-footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 15px;
        padding: 12px 18px;
        background: #fafbfc;
        border-top: 1px solid #edf1f5;
        color: #94a3b8;
        font-size: 10px;
    }

    .pr-footer-item {
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }

        .pr-footer-item i {
            color: #64748b;
        }

    /* =========================================================
           TOAST
           ========================================================= */

    .pr-toast {
        position: fixed;
        right: 22px;
        bottom: 22px;
        z-index: 9999;
        min-width: 290px;
        max-width: 420px;
        padding: 13px 16px;
        border-radius: 12px;
        background: #172033;
        color: #fff;
        box-shadow: 0 18px 40px rgba(15, 23, 42, .20);
        display: none;
        align-items: center;
        gap: 10px;
        font-size: 12px;
        font-weight: 650;
        animation: prToastIn .3s ease both;
    }

        .pr-toast.show {
            display: flex;
        }

        .pr-toast i {
            color: #86efac;
        }

    /* =========================================================
           ANIMATIONS
           ========================================================= */

    @@keyframes prFadeUp {
        from {
            opacity: 0;
            transform: translateY(10px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@keyframes prToastIn {
        from {
            opacity: 0;
            transform: translateY(10px) scale(.98);
        }

        to {
            opacity: 1;
            transform: translateY(0) scale(1);
        }
    }

    /* =========================================================
           RESPONSIVE
           ========================================================= */

    @@media (max-width: 1199.98px) {
        .pr-title-row {
            flex-direction: column;
            align-items: stretch;
        }

        .pr-header-actions {
            justify-content: flex-start;
        }

        .pr-search-wrapper {
            width: 260px;
        }
    }

    @@media (max-width: 991.98px) {
        .pr-header {
            padding: 20px;
        }

        .pr-register-header {
            padding: 18px;
        }

            .pr-register-header > .d-flex {
                flex-direction: column;
                align-items: stretch !important;
            }

        .pr-register-tools {
            width: 100%;
        }

        .pr-search-wrapper {
            width: 100%;
        }

        .pr-result-count {
            display: none;
        }

        .pr-kpi-value {
            font-size: 19px;
        }
    }

    @@media (max-width: 767.98px) {
        .pr-page {
            padding-bottom: 30px;
        }

        .pr-container {
            padding-left: 10px !important;
            padding-right: 10px !important;
        }

        .pr-header {
            border-radius: 15px;
            padding: 17px;
            margin-bottom: 15px;
        }

        .pr-title {
            font-size: 1.28rem;
        }

        .pr-title-icon {
            width: 39px;
            height: 39px;
            flex-basis: 39px;
            border-radius: 11px;
        }

        .pr-subtitle {
            margin-left: 0;
            margin-top: 9px;
            font-size: 12px;
        }

        .pr-header-actions {
            display: grid;
            grid-template-columns: 1fr 1fr;
            width: 100%;
        }

        .pr-btn {
            width: 100%;
        }

        .pr-register-card {
            border-radius: 15px;
        }

        .pr-register-tools {
            display: block;
        }

        .pr-search-wrapper {
            width: 100%;
        }

        .pr-table thead th,
        .pr-table tbody td {
            padding-left: 12px;
            padding-right: 12px;
        }

        .pr-register-footer {
            align-items: flex-start;
            flex-direction: column;
            gap: 7px;
        }

        .pr-toast {
            right: 12px;
            left: 12px;
            bottom: 12px;
            min-width: auto;
            max-width: none;
        }
    }

    @@media (max-width: 575.98px) {
        .pr-header {
            padding: 15px;
        }

        .pr-breadcrumb {
            font-size: 10px;
        }

        .pr-system-badge {
            font-size: 9px;
            padding: 4px 8px;
        }

        .pr-title {
            font-size: 1.15rem;
            gap: 9px;
        }

        .pr-title-icon {
            width: 35px;
            height: 35px;
            flex-basis: 35px;
            font-size: 13px;
        }

        .pr-header-actions {
            grid-template-columns: 1fr;
        }

        .pr-kpi-card {
            padding: 15px;
            border-radius: 14px;
        }

        .pr-kpi-value {
            font-size: 18px;
        }

        .pr-register-header {
            padding: 15px;
        }

        .pr-register-title {
            font-size: 14px;
        }

        .pr-register-description {
            font-size: 10px;
        }

        .pr-action-group {
            justify-content: flex-start;
        }
    }

    @@media (prefers-reduced-motion: reduce) {
        *,
        *::before,
        *::after {
            animation-duration: .01ms !important;
            animation-iteration-count: 1 !important;
            transition-duration: .01ms !important;
            scroll-behavior: auto !important;
        }
    }
</style>

<div class="pr-page">
    <div class="container-fluid px-2 px-md-4 pt-3 pt-md-4 pr-container">

        <!-- =====================================================
             PAGE HEADER
             ===================================================== -->
        <div class="pr-header">
            <div class="pr-header-content">

                <div class="pr-breadcrumb">
                    <a href="@Url.Action("Index", "Purchase")">
                        <i class="fa fa-arrow-left me-1"></i>
                        Control Hub
                    </a>

                    <span class="pr-breadcrumb-separator">/</span>

                    <span class="pr-system-badge">
                        <i class="fa fa-layer-group"></i>
                        SAP MM ME51N / ME54N
                    </span>
                </div>

                <div class="pr-title-row">

                    <div class="pr-title-wrapper">

                        <h1 class="pr-title">
                            <span class="pr-title-icon">
                                <i class="fa fa-clipboard-list"></i>
                            </span>

                            <span>Purchase Requisition Console</span>
                        </h1>

                        <p class="pr-subtitle">
                            Manage departmental procurement requests, review approval queues,
                            and prepare requisitions for purchase order conversion.
                        </p>

                    </div>

                    <div class="pr-header-actions">

                        <a href="@Url.Action("Index", "Purchase")"
                           class="btn pr-btn pr-btn-dashboard">
                            <i class="fa fa-gauge"></i>
                            Dashboard
                        </a>

                    </div>

                </div>

            </div>
        </div>


        <!-- =====================================================
             SUMMARY STATISTICS
             ===================================================== -->
        <div class="row g-3 mb-4">

            <!-- Pending -->
            <div class="col-12 col-sm-6 col-lg-3">
                <div class="pr-kpi-card pr-kpi-warning">

                    <div class="pr-kpi-top">

                        <div class="pr-kpi-label">
                            Pending Approval
                        </div>

                        <div class="pr-kpi-icon">
                            <i class="fa fa-hourglass-half"></i>
                        </div>

                    </div>

                    <div class="pr-kpi-value">
                        @Model.Count(r => r.Status == "Pending" || string.IsNullOrEmpty(r.Status)) Requisitions
                    </div>

                    <div class="pr-kpi-meta">
                        <i class="fa fa-clock me-1"></i>
                        Average response SLA: 18 hours
                    </div>

                </div>
            </div>


            <!-- Urgent -->
            <div class="col-12 col-sm-6 col-lg-3">
                <div class="pr-kpi-card pr-kpi-danger">

                    <div class="pr-kpi-top">

                        <div class="pr-kpi-label">
                            Urgent Priority
                        </div>

                        <div class="pr-kpi-icon">
                            <i class="fa fa-bolt"></i>
                        </div>

                    </div>

                    <div class="pr-kpi-value">
                        @Model.Count(r => r.Urgency == "Urgent") Items
                    </div>

                    <div class="pr-kpi-meta danger">
                        <i class="fa fa-triangle-exclamation me-1"></i>
                        Needs same-day release
                    </div>

                </div>
            </div>


            <!-- Total Value -->
            <div class="col-12 col-sm-6 col-lg-3">
                <div class="pr-kpi-card pr-kpi-info">

                    <div class="pr-kpi-top">

                        <div class="pr-kpi-label">
                            Total Estimated Value
                        </div>

                        <div class="pr-kpi-icon">
                            <i class="fa fa-indian-rupee-sign"></i>
                        </div>

                    </div>

                    <div class="pr-kpi-value">
                        <span class="compact-money"
                              data-value="486500"
                              title="₹4,86,500.00">
                            ₹4.87L
                        </span>
                    </div>

                    <div class="pr-kpi-meta">
                        <i class="fa fa-circle-check me-1"></i>
                        Pre-approved budget allocation
                    </div>

                </div>
            </div>


            <!-- Accreditation -->
            <div class="col-12 col-sm-6 col-lg-3">
                <div class="pr-kpi-card pr-kpi-success">

                    <div class="pr-kpi-top">

                        <div class="pr-kpi-label">
                            Approval Accreditation
                        </div>

                        <div class="pr-kpi-icon">
                            <i class="fa fa-shield-halved"></i>
                        </div>

                    </div>

                    <div class="pr-kpi-value">
                        Tier 2 Verified
                    </div>

                    <div class="pr-kpi-meta success">
                        <i class="fa fa-user-check me-1"></i>
                        Dual signatory authority
                    </div>

                </div>
            </div>

        </div>


        <!-- =====================================================
             REQUISITION REGISTER
             ===================================================== -->
        <div class="pr-register-card">

            <!-- Register Header -->
            <div class="pr-register-header">

                <div class="d-flex flex-column flex-lg-row justify-content-between align-items-start align-items-lg-center gap-3">

                    <div class="pr-register-heading">

                        <div class="pr-register-heading-icon">
                            <i class="fa fa-table-list"></i>
                        </div>

                        <div>
                            <h2 class="pr-register-title">
                                Requisition Register
                            </h2>

                            <p class="pr-register-description">
                                Review and process departmental purchase requests
                            </p>
                        </div>

                    </div>


                    <div class="pr-register-tools d-flex flex-wrap align-items-center gap-2">

                        <div class="btn-group btn-group-sm" role="group" aria-label="Status Filters">
                            <button type="button" class="btn btn-outline-secondary active" onclick="filterByStatus('All', this)">All (@Model.Count)</button>
                            <button type="button" class="btn btn-outline-warning" onclick="filterByStatus('Pending', this)">Pending (@Model.Count(r => r.Status == "Pending" || string.IsNullOrEmpty(r.Status)))</button>
                            <button type="button" class="btn btn-outline-success" onclick="filterByStatus('Approved', this)">Approved (@Model.Count(r => r.Status == "Approved"))</button>
                            <button type="button" class="btn btn-outline-danger" onclick="filterByStatus('Rejected', this)">Rejected (@Model.Count(r => r.Status == "Rejected"))</button>
                        </div>

                        <div class="pr-search-wrapper">

                            <i class="fa fa-search"></i>

                            <input type="text"
                                   id="prSearch"
                                   class="pr-search-input"
                                   placeholder="Search item, requester, department..."
                                   autocomplete="off"
                                   onkeyup="filterPRTable()" />

                            <button type="button"
                                    id="prSearchClear"
                                    class="pr-search-clear"
                                    onclick="clearPRSearch()"
                                    title="Clear search">
                                <i class="fa fa-xmark"></i>
                            </button>

                        </div>

                        <span id="prResultCount" class="pr-result-count">
                            @Model.Count request@(Model.Count == 1 ? "" : "s")
                        </span>

                    </div>

                </div>

            </div>


            <!-- Table -->
            <div class="pr-table-container">

                <table class="pr-table"
                       id="prDataTable">

                    <thead>

                        <tr>

                            <th>PR #</th>

                            <th>
                                Department &amp;<br />
                                Cost Center
                            </th>

                            <th>
                                Requested By
                            </th>

                            <th>
                                Item Scope &amp; Details
                            </th>

                            <th>
                                Estimated Cost
                            </th>

                            <th>
                                Urgency
                            </th>

                            <th>
                                Requested Date
                            </th>

                            <th class="text-end">
                                Approval Actions
                            </th>

                        </tr>

                    </thead>

                    <tbody>

                        @if (Model != null && Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                var department = item.Department ?? "";
                                var costCenterPrefix = department
                                .Substring(0, Math.Min(3, department.Length))
                                .ToUpper();

                                <tr id="pr-row-@item.Id"
                                    data-status="@(item.Status ?? "Pending")"
                                    style="@(item.Status == "Approved" ? "background-color: rgba(34, 197, 94, 0.05);" : item.Status == "Rejected" ? "background-color: rgba(239, 68, 68, 0.05);" : "")">

                                    <!-- PR Number -->
                                    <td>
                                        <span class="pr-id">
                                            #@item.Id
                                        </span>
                                    </td>


                                    <!-- Department -->
                                    <td>

                                        <span class="pr-department">
                                            @item.Department
                                        </span>

                                        <span class="pr-cost-center">
                                            <i class="fa fa-building me-1"></i>
                                            CC-@costCenterPrefix-101
                                        </span>

                                    </td>


                                    <!-- Requested By -->
                                    <td>

                                        <div class="pr-requester">

                                            <span class="pr-requester-icon">
                                                <i class="fa fa-user"></i>
                                            </span>

                                            <span>
                                                @item.RequestedBy
                                            </span>

                                        </div>

                                    </td>


                                    <!-- Item -->
                                    <td>

                                        <div class="pr-item-summary"
                                             title="@item.ItemSummary">

                                            @item.ItemSummary

                                        </div>

                                    </td>


                                    <!-- Estimated Cost -->
                                    <td>

                                        <span class="compact-money"
                                              data-value="@item.EstimatedCost">
                                        </span>

                                    </td>


                                    <!-- Urgency -->
                                    <td>

                                        @if (item.Urgency == "Urgent")
                                        {
                                            <span class="pr-urgency-badge badge-urgency-urgent">
                                                <i class="fa fa-bolt"></i>
                                                Urgent
                                            </span>
                                        }
                                        else if (item.Urgency == "High")
                                        {
                                            <span class="pr-urgency-badge badge-urgency-high">
                                                <i class="fa fa-clock"></i>
                                                High
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="pr-urgency-badge badge-urgency-medium">
                                                <i class="fa fa-minus"></i>
                                                Medium
                                            </span>
                                        }

                                    </td>


                                    <!-- Requested Date -->
                                    <td>

                                        <span class="text-muted">
                                            <i class="fa fa-calendar-days me-1"></i>
                                            @item.RequestedOn
                                        </span>

                                    </td>


                                    <!-- Actions -->
                                    <td class="text-end" id="pr-action-cell-@item.Id">
                                        @if (item.Status == "Pending" || string.IsNullOrEmpty(item.Status))
                                        {
                                            <button type="button" class="btn btn-sm btn-success px-2 me-1 shadow-sm" onclick="handlePrDecision(@item.Id, 'Approved')">
                                                <i class="fa fa-check me-1"></i> Approve
                                            </button>
                                            <button type="button" class="btn btn-sm btn-outline-danger px-2 me-1 shadow-sm" onclick="handlePrDecision(@item.Id, 'Rejected')">
                                                <i class="fa fa-times me-1"></i> Reject
                                            </button>
                                        }
                                        else if (item.Status == "Approved")
                                        {
                                            <a href="@Url.Action("CreatePOFromPR", "Purchase", new { prId = item.Id })" class="btn btn-sm btn-primary px-2 shadow-sm">
                                                <i class="fa fa-file-invoice me-1"></i> Convert to PO
                                            </a>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary px-2.5 py-1.5">@item.Status</span>
                                        }
                                    </td>

                                </tr>
                            }
                        }
                        else
                        {
                            <tr id="prEmptyRow">

                                <td colspan="8">

                                    <div class="pr-empty-state">

                                        <div class="pr-empty-icon">
                                            <i class="fa fa-clipboard-check"></i>
                                        </div>

                                        <h6>
                                            No Purchase Requisitions
                                        </h6>

                                        <p>
                                            There are currently no requisitions waiting for approval.
                                        </p>

                                    </div>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>


            <!-- Register Footer -->
            <div class="pr-register-footer">

                <div class="pr-footer-item">
                    <i class="fa fa-circle-info"></i>
                    <span>
                        Select Approve to release a requisition for PO conversion.
                    </span>
                </div>

                <div class="pr-footer-item">
                    <i class="fa fa-arrows-left-right"></i>
                    <span>
                        Scroll horizontally on smaller screens to view all columns.
                    </span>
                </div>

            </div>

        </div>

    </div>
</div>


<!-- =========================================================
     TOAST
     ========================================================= -->
<div id="prToast" class="pr-toast">
    <i class="fa fa-circle-check"></i>
    <span id="prToastMessage"></span>
</div>

@section Scripts {

    <script>

        /* =====================================================
           MONEY FORMATTERS
           ===================================================== */

        function parseMoneyValue(value) {

            if (typeof value === "number") {
                return Number.isFinite(value) ? value : 0;
            }

            var cleaned = String(value ?? "")
                .replace(/[^0-9.-]/g, "");

            var number = Number(cleaned);

            return Number.isFinite(number) ? number : 0;
        }


        function trimMoneyDecimal(value) {

            return value
                .toFixed(2)
                .replace(/\.00$/, "")
                .replace(/(\.\d)0$/, "$1");
        }


        function compactIndianMoney(value) {

            var number = parseMoneyValue(value);

            var abs = Math.abs(number);

            var sign = number < 0 ? "-" : "";

            if (abs >= 10000000) {

                return sign +
                    "₹" +
                    trimMoneyDecimal(abs / 10000000) +
                    "Cr";
            }

            if (abs >= 100000) {

                return sign +
                    "₹" +
                    trimMoneyDecimal(abs / 100000) +
                    "L";
            }

            if (abs >= 1000) {

                return sign +
                    "₹" +
                    trimMoneyDecimal(abs / 1000) +
                    "K";
            }

            return sign +
                "₹" +
                abs.toLocaleString("en-IN", {
                    maximumFractionDigits: 2
                });
        }


        function exactIndianMoney(value) {

            var number = parseMoneyValue(value);

            var formatted = Math.abs(number).toLocaleString("en-IN", {
                minimumFractionDigits: 2,
                maximumFractionDigits: 2
            });

            return number < 0
                ? "-₹" + formatted
                : "₹" + formatted;
        }


        function applyCompactMoneyFormatting(root) {

            var scope = root || document;

            scope.querySelectorAll(".compact-money").forEach(function (element) {

                var rawValue = element.getAttribute("data-value") || "0";

                var compactValue = compactIndianMoney(rawValue);
                var exactValue = exactIndianMoney(rawValue);

                element.textContent = compactValue;

                element.setAttribute("title", exactValue);
                element.setAttribute("data-full-value", exactValue);
                element.setAttribute("aria-label", exactValue);

            });
        }


        /* =====================================================
           SEARCH & FILTERS
           ===================================================== */

        function filterPRTable() {

            var searchInput = document.getElementById("prSearch");

            if (!searchInput) {
                return;
            }

            var filter = searchInput.value.toUpperCase().trim();

            var table = document.getElementById("prDataTable");

            if (!table) {
                return;
            }

            var tbody = table.getElementsByTagName("tbody")[0];

            if (!tbody) {
                return;
            }

            var rows = tbody.getElementsByTagName("tr");

            var visibleCount = 0;

            for (var i = 0; i < rows.length; i++) {

                var row = rows[i];

                if (row.id === "prEmptyRow") {
                    continue;
                }

                var text = row.textContent || row.innerText;

                var matches =
                    text.toUpperCase().indexOf(filter) > -1;

                row.style.display = matches ? "" : "none";

                if (matches) {
                    visibleCount++;
                }
            }


            var clearButton =
                document.getElementById("prSearchClear");

            if (clearButton) {

                clearButton.style.display =
                    filter.length > 0
                        ? "flex"
                        : "none";
            }


            updatePRResultCount(visibleCount, filter);
        }


        function updatePRResultCount(count, filter) {

            var resultCount =
                document.getElementById("prResultCount");

            if (!resultCount) {
                return;
            }

            if (filter && filter.length > 0) {

                resultCount.textContent =
                    count +
                    " matching request" +
                    (count === 1 ? "" : "s");

            }
            else {

                resultCount.textContent =
                    count +
                    " request" +
                    (count === 1 ? "" : "s");
            }
        }


        function clearPRSearch() {

            var searchInput =
                document.getElementById("prSearch");

            if (!searchInput) {
                return;
            }

            searchInput.value = "";

            filterPRTable();

            searchInput.focus();
        }


        /* =====================================================
           TOAST
           ===================================================== */

        var prToastTimer = null;

        function showPRToast(message, isError) {

            if (typeof toastr !== "undefined") {
                if (isError) {
                    toastr.error(message);
                } else {
                    toastr.success(message);
                }
                return;
            }

            var toast =
                document.getElementById("prToast");

            var toastMessage =
                document.getElementById("prToastMessage");

            if (!toast || !toastMessage) {
                return;
            }

            toastMessage.textContent =
                message || "Operation completed successfully.";

            toast.classList.add("show");

            clearTimeout(prToastTimer);

            prToastTimer = setTimeout(function () {

                toast.classList.remove("show");

            }, 3000);
        }


        /* =====================================================
           REQUISITION ACTION DECISION (APPROVE / REJECT)
           ===================================================== */

        function handlePrDecision(prId, decision) {

            var actionText = decision === "Approved" ? "approve and release" : "reject";

            if (!confirm("Are you sure you want to " + actionText + " Requisition #" + prId + "?")) {
                return;
            }

            $.post('@Url.Action("UpdatePRStatus", "Purchase")', {
                prId: prId,
                status: decision
            }, function (res) {
                if (res && res.success) {
                    var row = document.getElementById("pr-row-" + prId);
                    var cell = document.getElementById("pr-action-cell-" + prId);

                    if (decision === "Approved") {
                        if (cell) {
                            var createPoUrl = '@Url.Action("CreatePOFromPR", "Purchase")' + '?prId=' + prId;
                            cell.innerHTML = '<a href="' + createPoUrl + '" class="btn btn-sm btn-primary px-2 shadow-sm"><i class="fa fa-file-invoice me-1"></i> Convert to PO</a>';
                        }
                        if (row) {
                            row.setAttribute("data-status", "Approved");
                            row.style.transition = "background-color 0.4s ease";
                            row.style.backgroundColor = "rgba(34, 197, 94, 0.08)";
                        }
                    } else {
                        if (cell) {
                            cell.innerHTML = '<span class="badge bg-danger px-2.5 py-1.5"><i class="fa fa-times me-1"></i> Rejected</span>';
                        }
                        if (row) {
                            row.setAttribute("data-status", "Rejected");
                            row.style.transition = "background-color 0.4s ease";
                            row.style.backgroundColor = "rgba(239, 68, 68, 0.08)";
                        }
                    }

                    // Update Pending KPI counter
                    var pendingKpi = document.querySelector(".pr-kpi-warning .pr-kpi-value");
                    if (pendingKpi) {
                        var cur = parseInt(pendingKpi.textContent, 10);
                        if (!isNaN(cur) && cur > 0) {
                            pendingKpi.textContent = (cur - 1) + " Requisitions";
                        }
                    }

                    // Update status filter counts
                    updateFilterPills();

                    showPRToast(res.message || ("Purchase Requisition #" + prId + " marked as " + decision + "."));
                } else {
                    showPRToast(res && res.message ? res.message : "Unable to process requisition decision.", true);
                }
            }).fail(function () {
                showPRToast("Unable to communicate with the procurement server. Please try again.", true);
            });
        }

        // Backwards compatibility alias
        function prAction(id, action) {
            handlePrDecision(id, action);
        }

        /* Status filter function */
        function filterByStatus(status, btn) {
            document.querySelectorAll("[onclick^='filterByStatus']").forEach(function (b) {
                b.classList.remove("active");
            });
            if (btn) btn.classList.add("active");

            var rows = document.querySelectorAll("#prDataTable tbody tr[id^='pr-row-']");
            var count = 0;
            rows.forEach(function (row) {
                var rowStatus = row.getAttribute("data-status") || "Pending";
                if (status === "All" || rowStatus.toLowerCase() === status.toLowerCase()) {
                    row.style.display = "";
                    count++;
                } else {
                    row.style.display = "none";
                }
            });
            var resultCount = document.getElementById("prResultCount");
            if (resultCount) {
                resultCount.textContent = count + " request" + (count === 1 ? "" : "s");
            }
        }

        function updateFilterPills() {
            var rows = document.querySelectorAll("#prDataTable tbody tr[id^='pr-row-']");
            var pending = 0, approved = 0, rejected = 0;
            rows.forEach(function(r) {
                var st = (r.getAttribute("data-status") || "Pending").toLowerCase();
                if (st === "approved") approved++;
                else if (st === "rejected") rejected++;
                else pending++;
            });
            var btnAll = document.querySelector("[onclick*=\"'All'\"]");
            var btnPen = document.querySelector("[onclick*=\"'Pending'\"]");
            var btnApp = document.querySelector("[onclick*=\"'Approved'\"]");
            var btnRej = document.querySelector("[onclick*=\"'Rejected'\"]");
            if (btnAll) btnAll.textContent = "All (" + rows.length + ")";
            if (btnPen) btnPen.textContent = "Pending (" + pending + ")";
            if (btnApp) btnApp.textContent = "Approved (" + approved + ")";
            if (btnRej) btnRej.textContent = "Rejected (" + rejected + ")";
        }


        /* =====================================================
           INITIALIZATION
           ===================================================== */

        document.addEventListener("DOMContentLoaded", function () {

            /* Format all monetary values */
            applyCompactMoneyFormatting();

            /* Set initial result count */
            var rows =
                document.querySelectorAll(
                    "#prDataTable tbody tr[id^='pr-row-']"
                );

            updatePRResultCount(
                rows.length,
                ""
            );

        });

    </script>
}
@model ERP_System.Models.GRNSlipDetailViewModel
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = $"Goods Receipt Slip - {Model.GRNNumber} | {Model.VendorName}";
}

<link rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

<style>
    :root {
        --grns-primary: #2563eb;
        --grns-primary-dark: #1d4ed8;
        --grns-primary-soft: #eff6ff;
        --grns-success: #16a34a;
        --grns-success-soft: #f0fdf4;
        --grns-info: #0891b2;
        --grns-info-soft: #ecfeff;
        --grns-warning: #d97706;
        --grns-warning-soft: #fffbeb;
        --grns-danger: #dc2626;
        --grns-danger-soft: #fef2f2;
        --grns-purple: #7c3aed;
        --grns-border: #e2e8f0;
        --grns-bg: #f8fafc;
        --grns-card: #ffffff;
        --grns-text: #0f172a;
        --grns-muted: #64748b;
        --grns-shadow: 0 10px 30px rgba(15, 23, 42, 0.06);
    }

    .grns-page {
        min-height: calc(100vh - 80px);
        background: radial-gradient(circle at top right, rgba(37, 99, 235, 0.05), transparent 30%),
                    radial-gradient(circle at bottom left, rgba(8, 145, 178, 0.04), transparent 28%),
                    var(--grns-bg);
        padding-bottom: 60px;
    }

    .grns-container {
        max-width: 1200px;
        margin: 0 auto;
    }

    .grns-header-card {
        background: #ffffff;
        border: 1px solid var(--grns-border);
        border-radius: 18px;
        padding: 22px 26px;
        box-shadow: var(--grns-shadow);
        margin-bottom: 24px;
    }

    .grns-breadcrumb {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 0.78rem;
        font-weight: 650;
        color: var(--grns-muted);
        margin-bottom: 12px;
    }

    .grns-breadcrumb a {
        color: var(--grns-muted);
        text-decoration: none;
        transition: color 0.2s;
    }

    .grns-breadcrumb a:hover {
        color: var(--grns-primary);
    }

    .grns-voucher-card {
        background: #ffffff;
        border: 1px solid var(--grns-border);
        border-radius: 18px;
        padding: 32px;
        box-shadow: var(--grns-shadow);
        margin-bottom: 24px;
    }

    .grns-badge-pill {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 6px 12px;
        border-radius: 30px;
        font-size: 0.78rem;
        font-weight: 750;
    }

    .grns-table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 15px;
        margin-bottom: 20px;
    }

    .grns-table thead th {
        background: #f8fafc;
        color: #475569;
        font-size: 0.74rem;
        font-weight: 750;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        padding: 12px 14px;
        border-bottom: 2px solid #e2e8f0;
        border-top: 1px solid #e2e8f0;
    }

    .grns-table tbody td {
        padding: 13px 14px;
        font-size: 0.84rem;
        color: #1e293b;
        border-bottom: 1px solid #edf2f7;
        vertical-align: middle;
    }

    .grns-barcode {
        font-family: 'Courier New', monospace;
        letter-spacing: 3px;
        font-weight: 800;
        padding: 6px 12px;
        background: #f1f5f9;
        border-radius: 6px;
        display: inline-block;
    }

    .grns-toast-box {
        position: fixed;
        bottom: 24px;
        right: 24px;
        z-index: 9999;
        min-width: 340px;
        display: none;
    }

    @@media print {
        header, .sidebar, #sidebar, .grns-breadcrumb, .no-print, .btn, .footer, .grns-toast-box {
            display: none !important;
        }
        .main-inner, .wrapper, body, .grns-page {
            padding: 0 !important;
            margin: 0 !important;
            background: #fff !important;
        }
        .grns-voucher-card, .grns-header-card {
            border: none !important;
            box-shadow: none !important;
            padding: 0 !important;
        }
    }
</style>

<div class="grns-page pt-3">
    <div class="grns-container">

        <!-- Top Header Card -->
        <div class="grns-header-card no-print">
            <div class="grns-breadcrumb">
                <a href="@Url.Action("Index", "Purchase")"><i class="fa fa-layer-group me-1"></i> Control Hub</a>
                <span>/</span>
                <a href="@Url.Action("Receipts", "Purchase")">Goods Receipts Registry</a>
                <span>/</span>
                <span class="text-dark">Inward Slip: @Model.GRNNumber</span>
            </div>

            <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
                <div class="d-flex align-items-center gap-3">
                    <div class="p-3 bg-primary-subtle text-primary rounded-4 shadow-sm fs-3">
                        <i class="fa fa-receipt"></i>
                    </div>
                    <div>
                        <div class="d-flex flex-wrap align-items-center gap-2 mb-1">
                            <span class="badge bg-primary-subtle text-primary fw-bold extra-small px-2 py-1">SAP MM MIGO 101 &bull; MATERIAL INWARD SLIP</span>
                            <span class="grns-badge-pill @(Model.Status == "Quality Quarantine" ? "bg-warning-subtle text-warning border border-warning-subtle" : "bg-success-subtle text-success border border-success-subtle")" id="hdrStatusBadge">
                                <i class="fa @(Model.Status == "Quality Quarantine" ? "fa-triangle-exclamation" : "fa-circle-check")"></i>
                                @Model.Status
                            </span>
                            <span class="badge bg-light text-dark border extra-small">Movement: 101 Inward</span>
                        </div>
                        <h2 class="fw-extrabold text-dark mb-0">Goods Receipt Slip: @Model.GRNNumber</h2>
                        <span class="text-muted small">Vendor: <strong>@Model.VendorName</strong> &bull; Received on @Model.ReceivedDate &bull; PO: <strong>@Model.PONumber</strong></span>
                    </div>
                </div>

                <div class="d-flex flex-wrap align-items-center gap-2">
                    <a href="@Url.Action("Receipts", "Purchase")" class="btn btn-outline-secondary rounded-pill px-3.5 shadow-sm fw-semibold">
                        <i class="fa fa-arrow-left me-1"></i> Back to Receipts
                    </a>
                    <a href="@Url.Action("OrderDetails", "Purchase", new { poNumber = Model.PONumber })" class="btn btn-outline-primary rounded-pill px-3 shadow-sm fw-semibold" title="View associated Purchase Order">
                        <i class="fa fa-file-invoice me-1"></i> View PO (@Model.PONumber)
                    </a>
                    <a href="@Url.Action("VendorAudit", "Purchase", new { vendorName = Model.VendorName })" class="btn btn-outline-info rounded-pill px-3 shadow-sm fw-semibold" title="View vendor quality dossier">
                        <i class="fa fa-award me-1"></i> Vendor Audit
                    </a>
                    <button type="button" class="btn btn-primary rounded-pill px-3.5 shadow-sm fw-semibold" onclick="window.print()">
                        <i class="fa fa-print me-1"></i> Print Inward Slip
                    </button>
                </div>
            </div>
        </div>

        <!-- 3-Way Match & Quarantine Alert Banner -->
        @if (Model.Status == "Quality Quarantine")
        {
            <div class="alert alert-warning border border-warning-subtle rounded-3 p-3 mb-4 shadow-sm d-flex flex-wrap justify-content-between align-items-center gap-3 no-print" id="quarantineBanner">
                <div class="d-flex align-items-center gap-3">
                    <i class="fa fa-triangle-exclamation fs-3 text-warning"></i>
                    <div>
                        <h6 class="fw-bold mb-0 text-dark">Quality Quarantine Hold Active</h6>
                        <span class="small text-muted">@Model.ThreeWayMatchStatus. Secondary metallurgical / mechanical inspection pending.</span>
                    </div>
                </div>
                <button type="button" class="btn btn-success btn-sm rounded-pill px-3 shadow-sm fw-bold" onclick="releaseQuarantine()">
                    <i class="fa fa-circle-check me-1"></i> Pass Quality &amp; Release to Stock
                </button>
            </div>
        }
        else
        {
            <div class="alert alert-success border border-success-subtle rounded-3 p-3 mb-4 shadow-sm d-flex align-items-center gap-3 no-print">
                <i class="fa fa-circle-check fs-3 text-success"></i>
                <div>
                    <h6 class="fw-bold mb-0 text-dark">SAP MM &amp; NetSuite 3-Way Match Verified</h6>
                    <span class="small text-muted">@Model.ThreeWayMatchStatus. Variance: <strong>@Model.Variance</strong>. Authorized for AP disbursement.</span>
                </div>
            </div>
        }

        <!-- Official Printable Inward Slip -->
        <div class="grns-voucher-card" id="printableGRNArea">

            <!-- Company & Slip Header -->
            <div class="row align-items-center mb-4 pb-3 border-bottom g-3">
                <div class="col-sm-7">
                    <div class="d-flex align-items-center gap-2 mb-1">
                        <i class="fa-solid fa-layer-group fs-3 text-primary"></i>
                        <h3 class="fw-extrabold text-dark mb-0">Operafy ERP Systems Ltd</h3>
                    </div>
                    <div class="text-muted small fw-semibold">Central Logistics Depot &bull; Materials Management Receiving Bay</div>
                    <div class="text-muted extra-small mt-0.5" style="font-size: 0.75rem;">
                        Operafy Logistics Bay 3, Nelamangala Industrial Corridor, Bangalore - 562123 | GSTIN: 29AAACE9912K1Z9 | CIN: U72200KA2024PLC189210
                    </div>
                </div>
                <div class="col-sm-5 text-sm-end">
                    <div class="badge bg-dark text-white text-uppercase px-3 py-1.5 fw-bold mb-1" style="letter-spacing: 0.08em; font-size: 0.76rem;">
                        GOODS RECEIPT NOTE (MIGO 101)
                    </div>
                    <div class="fw-extrabold fs-4 text-primary font-monospace">@Model.GRNNumber</div>
                    <div class="text-muted small">
                        Inward Date: <span class="fw-bold text-dark">@Model.ReceivedDate</span>
                    </div>
                    <div class="text-muted small">
                        PO Reference: <a href="@Url.Action("OrderDetails", "Purchase", new { poNumber = Model.PONumber })" class="fw-bold text-primary font-monospace text-decoration-none">@Model.PONumber</a>
                    </div>
                </div>
            </div>

            <!-- Consignment Telemetry Grid -->
            <div class="row g-3 mb-4">
                <!-- Vendor Info -->
                <div class="col-md-6">
                    <div class="p-3 bg-light rounded-3 h-100 border">
                        <span class="text-muted text-uppercase fw-bold extra-small d-block mb-1">Supplier / Consignor Details:</span>
                        <h5 class="fw-bold text-dark mb-1">@Model.VendorName</h5>
                        <div class="extra-small text-muted mb-2">
                            <span class="d-block"><strong>GSTIN:</strong> @Model.VendorGstin &bull; <span class="badge bg-success-subtle text-success">Verified</span></span>
                            <span class="d-block mt-0.5"><i class="fa fa-location-dot me-1"></i> @Model.VendorAddress</span>
                        </div>
                        <div class="extra-small text-muted">
                            <span class="d-block"><strong>Delivery Challan:</strong> <span class="font-monospace fw-bold text-dark">@Model.DeliveryChallanNo</span> (Dated: @Model.ChallanDate)</span>
                        </div>
                    </div>
                </div>

                <!-- Inward Logistics Bay -->
                <div class="col-md-6">
                    <div class="p-3 bg-light rounded-3 h-100 border">
                        <span class="text-muted text-uppercase fw-bold extra-small d-block mb-1">Warehouse Bay &amp; Logistics Telemetry:</span>
                        <h6 class="fw-bold text-dark mb-1">@Model.Warehouse &bull; <span class="badge bg-primary-subtle text-primary">@Model.StorageBin</span></h6>
                        <div class="extra-small text-muted mb-2">
                            <span class="d-block"><strong>Receiving Intake Gate:</strong> @Model.ReceivingGate</span>
                            <span class="d-block mt-0.5"><strong>Carrier Transporter:</strong> @Model.Carrier</span>
                            <span class="d-block mt-0.5"><strong>Vehicle Number:</strong> <span class="font-monospace fw-bold text-dark">@Model.VehicleNumber</span> &bull; <strong>Bill of Lading:</strong> @Model.BillOfLading</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Commercial Metadata Bar -->
            <div class="row g-2 p-2.5 bg-light rounded-3 mb-4 text-center border">
                <div class="col-3">
                    <span class="extra-small text-muted d-block">SAP Movement</span>
                    <span class="fw-bold text-dark small"><i class="fa fa-truck-ramp-box me-1 text-primary"></i> 101 Inward Stock</span>
                </div>
                <div class="col-3">
                    <span class="extra-small text-muted d-block">Total Units Inward</span>
                    <span class="fw-bold text-dark small" id="dispItemsReceived"><i class="fa fa-boxes-stacked me-1 text-primary"></i> @Model.ItemsReceived Units</span>
                </div>
                <div class="col-3">
                    <span class="extra-small text-muted d-block">Lead QA Inspector</span>
                    <span class="fw-bold text-dark small"><i class="fa fa-user-check me-1 text-primary"></i> @Model.InspectedBy</span>
                </div>
                <div class="col-3">
                    <span class="extra-small text-muted d-block">Current Status</span>
                    <span class="fw-bold text-dark small" id="barStatusText">
                        <i class="fa fa-circle-check me-1 text-success"></i> @Model.Status
                    </span>
                </div>
            </div>

            <!-- Verified Itemized Line Items Table -->
            <h6 class="fw-bold text-dark mb-2">
                <i class="fa fa-list-check text-primary me-1.5"></i> Inward Inspection &amp; Storage Bin Allocation Schedule
            </h6>

            <div class="table-responsive">
                <table class="grns-table">
                    <thead>
                        <tr>
                            <th style="width: 40%;">Material Description &amp; Technical Specifications</th>
                            <th style="width: 12%;">HSN/SAC</th>
                            <th style="width: 10%;">Ordered</th>
                            <th style="width: 10%;">Received</th>
                            <th style="width: 10%;">Accepted</th>
                            <th style="width: 18%;">Quality Verdict &amp; Bin</th>
                        </tr>
                    </thead>
                    <tbody id="grnItemsTableBody">
                        @if (Model.Items != null && Model.Items.Any())
                        {
                            foreach (var item in Model.Items)
                            {
                                <tr>
                                    <td>
                                        <span class="fw-bold text-dark d-block">@item.Item</span>
                                        <span class="text-muted extra-small">@(string.IsNullOrWhiteSpace(item.Specification) ? "Conforms to Operafy Procurement Specifications" : item.Specification) &bull; Unit: @item.Unit</span>
                                    </td>
                                    <td class="font-monospace fw-semibold">@item.Hsn</td>
                                    <td class="fw-semibold">@item.PoQty</td>
                                    <td class="fw-bold fs-6">@item.ReceivedQty</td>
                                    <td class="fw-bold text-success">@item.AcceptedQty</td>
                                    <td>
                                        <span class="badge @(item.Verdict.Contains("QUARANTINE") ? "bg-warning-subtle text-warning" : "bg-success-subtle text-success") extra-small fw-bold">
                                            @item.Verdict
                                        </span>
                                        <span class="extra-small text-muted d-block mt-0.5">Bin: @Model.StorageBin</span>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td>
                                    <span class="fw-bold text-dark d-block">Procured Materials Batch</span>
                                    <span class="text-muted extra-small">Conforms to Purchase Order Specifications</span>
                                </td>
                                <td class="font-monospace fw-semibold">8471</td>
                                <td class="fw-semibold">@Model.ItemsReceived</td>
                                <td class="fw-bold fs-6">@Model.ItemsReceived</td>
                                <td class="fw-bold text-success">@Model.ItemsReceived</td>
                                <td>
                                    <span class="badge bg-success-subtle text-success extra-small fw-bold">PASSED QC</span>
                                    <span class="extra-small text-muted d-block mt-0.5">Bin: @Model.StorageBin</span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Inspector Observations & Sign-off -->
            <div class="p-3.5 bg-light rounded-3 border mb-4">
                <h6 class="fw-bold text-dark mb-1.5">
                    <i class="fa fa-microscope text-primary me-1.5"></i> Quality Assurance Audit Findings &amp; Observations:
                </h6>
                <p class="text-muted extra-small mb-0" id="dispInspectorRemarks" style="line-height: 1.6;">
                    @Model.InspectorRemarks
                </p>
            </div>

            <!-- Signatures & Barcode Strip -->
            <div class="row pt-3 border-top g-3 align-items-end">
                <div class="col-sm-4 text-center text-sm-start">
                    <div class="grns-barcode mb-1">|||| | |||||| || |||| ||||| ||</div>
                    <div class="extra-small text-muted font-monospace">@Model.GRNNumber</div>
                </div>

                <div class="col-sm-4 text-center">
                    <div class="fw-bold text-dark font-monospace" style="border-bottom: 2px dashed #cbd5e1; padding-bottom: 4px; font-size: 0.8rem;">
                        KA-01-EA-9821 / BlueDart
                    </div>
                    <span class="extra-small text-muted d-block" style="font-size: 0.68rem;">Carrier Driver / Transporter Acknowledgment</span>
                </div>

                <div class="col-sm-4 text-center text-sm-end">
                    <div class="fw-bold text-dark font-monospace" style="border-bottom: 2px dashed #cbd5e1; padding-bottom: 4px; font-size: 0.8rem;">
                        <i class="fa fa-stamp text-success me-1"></i> @Model.InspectedBy
                    </div>
                    <span class="extra-small text-muted d-block" style="font-size: 0.68rem;">Lead Quality Inspector &bull; Operafy Receiving Bay</span>
                    <span class="extra-small text-success fw-semibold"><i class="fa fa-certificate me-0.5"></i> SAP MM Verified Hash</span>
                </div>
            </div>

        </div>

    </div>
</div>

<!-- Real-Time Toast Notifications -->
<div class="grns-toast-box" id="grnsToastBox">
    <div class="card border-0 shadow-lg" style="border-radius: 12px; background: #1e293b; color: #fff;">
        <div class="card-body p-3 d-flex align-items-center justify-content-between gap-3">
            <div class="d-flex align-items-center gap-2.5">
                <i class="fa fa-circle-check text-success fs-5" id="grnsToastIcon"></i>
                <span class="small fw-semibold" id="grnsToastMessage">Operation successful</span>
            </div>
            <button type="button" class="btn-close btn-close-white btn-sm" onclick="hideToast()"></button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        var currentGrnNumber = "@Model.GRNNumber";

        function showToast(message, isSuccess) {
            var box = document.getElementById("grnsToastBox");
            var msgEl = document.getElementById("grnsToastMessage");
            var iconEl = document.getElementById("grnsToastIcon");
            if (!box || !msgEl) return;

            msgEl.textContent = message;
            if (iconEl) {
                iconEl.className = (isSuccess !== false)
                    ? "fa fa-circle-check text-success fs-5"
                    : "fa fa-triangle-exclamation text-warning fs-5";
            }
            box.style.display = "block";
            clearTimeout(window._grnsToastTimeout);
            window._grnsToastTimeout = setTimeout(hideToast, 4500);
        }

        function hideToast() {
            var box = document.getElementById("grnsToastBox");
            if (box) box.style.display = "none";
        }

        function releaseQuarantine() {
            var fd = new FormData();
            fd.append("grnNumber", currentGrnNumber);
            fd.append("status", "Inspected & Accepted");
            fd.append("remarks", "Consignment cleared secondary mechanical and metallurgical QA testing. 100% accepted and transferred to active warehouse bin.");

            fetch('@Url.Action("UpdateGRNStatus", "Purchase")', {
                method: "POST",
                body: fd
            })
            .then(function(res) { return res.json(); })
            .then(function(res) {
                if (res && res.success) {
                    showToast("Quality quarantine cleared! Goods released to warehouse inventory.", true);

                    // Update UI elements
                    var hdrBadge = document.getElementById("hdrStatusBadge");
                    if (hdrBadge) {
                        hdrBadge.className = "grns-badge-pill bg-success-subtle text-success border border-success-subtle";
                        hdrBadge.innerHTML = '<i class="fa fa-circle-check"></i> Inspected & Accepted';
                    }
                    var barText = document.getElementById("barStatusText");
                    if (barText) {
                        barText.innerHTML = '<i class="fa fa-circle-check me-1 text-success"></i> Inspected & Accepted';
                    }
                    var remarksEl = document.getElementById("dispInspectorRemarks");
                    if (remarksEl) {
                        remarksEl.textContent = "Consignment cleared secondary mechanical and metallurgical QA testing. 100% accepted and transferred to active warehouse bin.";
                    }
                    var banner = document.getElementById("quarantineBanner");
                    if (banner) {
                        banner.className = "alert alert-success border border-success-subtle rounded-3 p-3 mb-4 shadow-sm d-flex align-items-center gap-3 no-print";
                        banner.innerHTML = '<i class="fa fa-circle-check fs-3 text-success"></i><div><h6 class="fw-bold mb-0 text-dark">SAP MM &amp; NetSuite 3-Way Match Verified</h6><span class="small text-muted">Quality quarantine cleared. 100% Matched: PO, Delivery Challan &amp; Vendor Bill Fully Aligned. Authorized for AP disbursement.</span></div>';
                    }

                    // Update items table badges
                    var tbody = document.getElementById("grnItemsTableBody");
                    if (tbody) {
                        tbody.querySelectorAll(".badge.bg-warning-subtle").forEach(function(b) {
                            b.className = "badge bg-success-subtle text-success extra-small fw-bold";
                            b.textContent = "PASSED QC";
                        });
                    }
                } else {
                    showToast("Could not clear quarantine: " + (res.message || "Failed"), false);
                }
            })
            .catch(function() {
                showToast("Network error updating quarantine status.", false);
            });
        }
    </script>
}

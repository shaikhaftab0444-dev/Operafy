@model ERP_System.Models.VendorAuditDossier
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = $"Supplier Audit Report - {Model.VendorName} | SAP MM Evaluation";
}

<link rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

<style>
    :root {
        --va-primary: #2563eb;
        --va-primary-dark: #1d4ed8;
        --va-primary-soft: #eff6ff;
        --va-success: #16a34a;
        --va-success-soft: #f0fdf4;
        --va-info: #0891b2;
        --va-info-soft: #ecfeff;
        --va-warning: #d97706;
        --va-warning-soft: #fffbeb;
        --va-danger: #dc2626;
        --va-danger-soft: #fef2f2;
        --va-purple: #7c3aed;
        --va-purple-soft: #f5f3ff;
        --va-border: #e2e8f0;
        --va-bg: #f8fafc;
        --va-card: #ffffff;
        --va-text: #0f172a;
        --va-muted: #64748b;
        --va-shadow: 0 10px 30px rgba(15, 23, 42, 0.06);
    }

    .va-page {
        min-height: calc(100vh - 80px);
        background: radial-gradient(circle at top right, rgba(37, 99, 235, 0.05), transparent 30%),
                    radial-gradient(circle at bottom left, rgba(8, 145, 178, 0.04), transparent 28%),
                    var(--va-bg);
        padding-bottom: 60px;
    }

    .va-container {
        max-width: 1250px;
        margin: 0 auto;
    }

    .va-header-card {
        background: #ffffff;
        border: 1px solid var(--va-border);
        border-radius: 18px;
        padding: 24px 28px;
        box-shadow: var(--va-shadow);
        margin-bottom: 24px;
    }

    .va-breadcrumb {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 0.78rem;
        font-weight: 650;
        color: var(--va-muted);
        margin-bottom: 12px;
    }

    .va-breadcrumb a {
        color: var(--va-muted);
        text-decoration: none;
        transition: color 0.2s;
    }

    .va-breadcrumb a:hover {
        color: var(--va-primary);
    }

    .va-content-card {
        background: #ffffff;
        border: 1px solid var(--va-border);
        border-radius: 18px;
        padding: 30px;
        box-shadow: var(--va-shadow);
        margin-bottom: 24px;
    }

    .va-kpi-card {
        background: #ffffff;
        border: 1px solid var(--va-border);
        border-radius: 14px;
        padding: 18px 20px;
        box-shadow: 0 4px 15px rgba(15, 23, 42, 0.03);
        transition: transform 0.2s, box-shadow 0.2s;
    }

    .va-kpi-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 25px rgba(15, 23, 42, 0.07);
    }

    .va-progress {
        height: 7px;
        border-radius: 10px;
        background-color: #f1f5f9;
        overflow: hidden;
        margin-top: 8px;
    }

    .va-progress-bar {
        height: 100%;
        border-radius: 10px;
    }

    .va-table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 10px;
    }

    .va-table thead th {
        background: #f8fafc;
        color: #475569;
        font-size: 0.74rem;
        font-weight: 750;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        padding: 11px 14px;
        border-bottom: 2px solid #e2e8f0;
        border-top: 1px solid #e2e8f0;
    }

    .va-table tbody td {
        padding: 12px 14px;
        font-size: 0.84rem;
        color: #1e293b;
        border-bottom: 1px solid #edf2f7;
        vertical-align: middle;
    }

    .va-table tbody tr:hover {
        background-color: #f8fbff;
    }

    .va-badge-pill {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 5px 12px;
        border-radius: 30px;
        font-size: 0.76rem;
        font-weight: 750;
    }

    .va-toast-box {
        position: fixed;
        bottom: 24px;
        right: 24px;
        z-index: 9999;
        min-width: 340px;
        display: none;
    }

    @@media print {
        header, .sidebar, #sidebar, .va-breadcrumb, .no-print, .btn, .footer, .va-toast-box {
            display: none !important;
        }
        .main-inner, .wrapper, body, .va-page {
            padding: 0 !important;
            margin: 0 !important;
            background: #fff !important;
        }
        .va-content-card, .va-header-card {
            border: none !important;
            box-shadow: none !important;
            padding: 0 !important;
        }
    }
</style>

<div class="va-page pt-3">
    <div class="va-container">

        <!-- Header Card -->
        <div class="va-header-card no-print">
            <div class="va-breadcrumb">
                <a href="@Url.Action("Index", "Purchase")"><i class="fa fa-layer-group me-1"></i> Control Hub</a>
                <span>/</span>
                <a href="@Url.Action("Vendors", "Purchase")">Vendor Directory</a>
                <span>/</span>
                <span class="text-dark">Audit Report: @Model.VendorName</span>
            </div>

            <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
                <div class="d-flex align-items-center gap-3">
                    <div class="p-3 bg-primary-subtle text-primary rounded-4 shadow-sm fs-2">
                        <i class="fa fa-shield-halved"></i>
                    </div>
                    <div>
                        <div class="d-flex flex-wrap align-items-center gap-2 mb-1">
                            <span class="badge bg-primary-subtle text-primary fw-bold extra-small px-2 py-1">SAP MM / SRM AUDIT DOSSIER</span>
                            <span class="va-badge-pill bg-success-subtle text-success border border-success-subtle" id="hdrStatusPill">
                                <i class="fa fa-circle-check"></i>
                                @Model.Status
                            </span>
                            <span class="va-badge-pill bg-warning-subtle text-warning border border-warning-subtle">
                                <i class="fa fa-star"></i>
                                @Model.Rating Rating
                            </span>
                            <span class="va-badge-pill bg-info-subtle text-info border border-info-subtle" id="hdrRiskPill">
                                <i class="fa fa-award"></i>
                                @Model.RiskGrade
                            </span>
                        </div>
                        <h2 class="fw-extrabold text-dark mb-0">@Model.VendorName</h2>
                        <span class="text-muted small">Category: <strong>@Model.Category</strong> &bull; Registered MSME / GSTIN Supplier</span>
                    </div>
                </div>

                <div class="d-flex align-items-center gap-2">
                    <a href="@Url.Action("Vendors", "Purchase")" class="btn btn-outline-secondary rounded-pill px-3.5 shadow-sm fw-semibold">
                        <i class="fa fa-arrow-left me-1"></i> Back to Vendors
                    </a>
                    <button type="button" class="btn btn-primary rounded-pill px-3.5 shadow-sm fw-semibold" onclick="window.print()">
                        <i class="fa fa-print me-1"></i> Print Audit Report
                    </button>
                </div>
            </div>
        </div>

        <!-- KPI Performance Grid -->
        <div class="row g-3 mb-4">
            <div class="col-md-4 col-sm-6">
                <div class="va-kpi-card">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <span class="extra-small fw-bold text-muted text-uppercase">On-Time Delivery SLA</span>
                        <i class="fa fa-truck-fast text-success fs-5"></i>
                    </div>
                    <div class="fs-3 fw-extrabold text-dark">@Model.OnTimeDeliveryRate</div>
                    <div class="va-progress">
                        <div class="va-progress-bar bg-success" style="width: @(Model.OnTimeDeliveryRate.Replace("%", ""))%;"></div>
                    </div>
                    <span class="extra-small text-muted mt-1 d-block">Contractual SLA Threshold: 90%</span>
                </div>
            </div>

            <div class="col-md-4 col-sm-6">
                <div class="va-kpi-card">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <span class="extra-small fw-bold text-muted text-uppercase">Quality Acceptance Rate</span>
                        <i class="fa fa-certificate text-primary fs-5"></i>
                    </div>
                    <div class="fs-3 fw-extrabold text-dark">@Model.QualityScore</div>
                    <div class="va-progress">
                        <div class="va-progress-bar bg-primary" style="width: @(Model.QualityScore.Replace("%", ""))%;"></div>
                    </div>
                    <span class="extra-small text-muted mt-1 d-block">Batch Inward Inspection Standard: 95%</span>
                </div>
            </div>

            <div class="col-md-4 col-sm-6">
                <div class="va-kpi-card">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <span class="extra-small fw-bold text-muted text-uppercase">Cumulative Spend (YTD)</span>
                        <i class="fa fa-indian-rupee-sign text-purple fs-5"></i>
                    </div>
                    <div class="fs-3 fw-extrabold text-dark">@Model.SpendYTD</div>
                    <div class="va-progress">
                        <div class="va-progress-bar bg-info" style="width: 85%;"></div>
                    </div>
                    <span class="extra-small text-muted mt-1 d-block">Net Dispatched Procurement Volume</span>
                </div>
            </div>

            <div class="col-md-4 col-sm-6">
                <div class="va-kpi-card">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <span class="extra-small fw-bold text-muted text-uppercase">Defect / Rejection Ratio</span>
                        <i class="fa fa-triangle-exclamation text-danger fs-5"></i>
                    </div>
                    <div class="fs-3 fw-extrabold text-dark">@(Model.DefectRatio ?? "0.15%")</div>
                    <span class="badge bg-success-subtle text-success extra-small fw-bold mt-2">Within Six Sigma Limits (&lt;1%)</span>
                </div>
            </div>

            <div class="col-md-4 col-sm-6">
                <div class="va-kpi-card">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <span class="extra-small fw-bold text-muted text-uppercase">Price Competitiveness Index</span>
                        <i class="fa fa-chart-line text-info fs-5"></i>
                    </div>
                    <div class="fs-3 fw-extrabold text-dark">@(Model.PriceCompetitiveness ?? "96%")</div>
                    <span class="badge bg-info-subtle text-info extra-small fw-bold mt-2">Ranked Tier 1 Benchmark</span>
                </div>
            </div>

            <div class="col-md-4 col-sm-6">
                <div class="va-kpi-card">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <span class="extra-small fw-bold text-muted text-uppercase">3-Way Match Clearance</span>
                        <i class="fa fa-file-circle-check text-success fs-5"></i>
                    </div>
                    <div class="fs-4 fw-extrabold text-success">Automated</div>
                    <span class="extra-small text-muted mt-2 d-block">PO &bull; GRN &bull; Invoice Auto-Matched</span>
                </div>
            </div>
        </div>

        <!-- Main Report Card -->
        <div class="va-content-card" id="printableAuditArea">

            <!-- Report Header -->
            <div class="row align-items-center pb-3 mb-4 border-bottom g-3">
                <div class="col-sm-8">
                    <div class="d-flex align-items-center gap-2 mb-1">
                        <i class="fa-solid fa-layer-group fs-3 text-primary"></i>
                        <h4 class="fw-extrabold text-dark mb-0">Operafy ERP Systems Ltd</h4>
                    </div>
                    <div class="text-muted small fw-semibold">Supplier Relationship Management (SRM) &amp; Vendor Audit Directorate</div>
                    <div class="text-muted extra-small" style="font-size: 0.75rem;">
                        Global Procurement Standards &bull; ISO 9001:2015 Clause 8.4 Vendor Quality Evaluation Framework
                    </div>
                </div>
                <div class="col-sm-4 text-sm-end">
                    <div class="badge bg-dark text-white text-uppercase px-3 py-1.5 fw-bold mb-1" style="letter-spacing: 0.08em; font-size: 0.75rem;">
                        OFFICIAL AUDIT REPORT
                    </div>
                    <div class="fw-bold text-dark small">Audit Conducted: <span class="text-primary font-monospace">@Model.AuditDate</span></div>
                    <div class="text-muted extra-small">Valid Until: <span class="fw-semibold text-dark">@Model.AuditValidUntil</span></div>
                </div>
            </div>

            <!-- Statutory Credentials & Banking Grid -->
            <div class="row g-4 mb-4">
                <!-- Col 1: Statutory & Identifiers -->
                <div class="col-md-6">
                    <div class="p-3.5 bg-light rounded-3 h-100 border">
                        <h6 class="fw-bold text-dark mb-3">
                            <i class="fa fa-id-card text-primary me-2"></i> Statutory &amp; Corporate Credentials
                        </h6>
                        <table class="table table-sm table-borderless extra-small mb-0">
                            <tbody>
                                <tr>
                                    <td class="text-muted fw-bold" style="width: 35%;">GSTIN:</td>
                                    <td>
                                        <span class="font-monospace fw-bold text-dark">@Model.Gstin</span>
                                        <span class="badge bg-success-subtle text-success ms-1">Active (GSTN)</span>
                                    </td>
                                </tr>
                                <tr>
                                    <td class="text-muted fw-bold">Permanent A/C (PAN):</td>
                                    <td class="font-monospace fw-bold text-dark">@Model.Pan</td>
                                </tr>
                                <tr>
                                    <td class="text-muted fw-bold">MSME / UDYAM Reg:</td>
                                    <td class="font-monospace text-dark">@(Model.UdyamRegNo ?? "UDYAM-KR-03-0098211")</td>
                                </tr>
                                <tr>
                                    <td class="text-muted fw-bold">Corporate Identity (CIN):</td>
                                    <td class="font-monospace text-dark">@(Model.CinNumber ?? "U72200KA2018PTC112345")</td>
                                </tr>
                                <tr>
                                    <td class="text-muted fw-bold">Registered Corporate HQ:</td>
                                    <td class="text-dark">@Model.RegisteredAddress</td>
                                </tr>
                                <tr>
                                    <td class="text-muted fw-bold">Manufacturing/Hub:</td>
                                    <td class="text-dark">@(Model.PlantLocation ?? "Logistics Park, Bangalore")</td>
                                </tr>
                                <tr>
                                    <td class="text-muted fw-bold">Key Commercial Contact:</td>
                                    <td class="text-dark">
                                        <strong>@Model.ContactPerson</strong><br>
                                        <span class="text-muted"><i class="fa fa-envelope me-1"></i> @Model.ContactEmail</span> &bull;
                                        <span class="text-muted"><i class="fa fa-phone me-1"></i> @Model.ContactPhone</span>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- Col 2: Banking & Commercial Terms -->
                <div class="col-md-6">
                    <div class="p-3.5 bg-light rounded-3 h-100 border">
                        <h6 class="fw-bold text-dark mb-3">
                            <i class="fa fa-building-columns text-primary me-2"></i> Banking &amp; Commercial Terms
                        </h6>
                        <table class="table table-sm table-borderless extra-small mb-0">
                            <tbody>
                                <tr>
                                    <td class="text-muted fw-bold" style="width: 35%;">Operating Bank:</td>
                                    <td class="fw-bold text-dark">@(Model.BankName ?? "HDFC Bank Ltd (Corporate Branch)")</td>
                                </tr>
                                <tr>
                                    <td class="text-muted fw-bold">Account Number:</td>
                                    <td class="font-monospace text-dark">@(Model.BankAccountMasked ?? "502000492819XX") <span class="badge bg-light text-muted border">Masked</span></td>
                                </tr>
                                <tr>
                                    <td class="text-muted fw-bold">RTGS / NEFT IFSC:</td>
                                    <td class="font-monospace text-dark">@(Model.IfscCode ?? "HDFC0000128")</td>
                                </tr>
                                <tr>
                                    <td class="text-muted fw-bold">Payment Credit Terms:</td>
                                    <td><span class="badge bg-primary-subtle text-primary fw-bold">@Model.PaymentTerms</span></td>
                                </tr>
                                <tr>
                                    <td class="text-muted fw-bold">Agreed Lead Time SLA:</td>
                                    <td class="text-dark fw-semibold">@(Model.LeadTimeDays ?? "4-7 Business Days")</td>
                                </tr>
                                <tr>
                                    <td class="text-muted fw-bold">AP 3-Way Match:</td>
                                    <td><span class="badge bg-success-subtle text-success fw-bold">Passed Automated Check</span></td>
                                </tr>
                                <tr>
                                    <td class="text-muted fw-bold">Risk Assessment Grade:</td>
                                    <td>
                                        <span class="badge bg-info-subtle text-info fw-bold" id="cardRiskGrade">
                                            @Model.RiskGrade
                                        </span>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- Accreditations & Certifications -->
            <div class="mb-4">
                <h6 class="fw-bold text-dark mb-2.5">
                    <i class="fa fa-award text-primary me-1.5"></i> Quality &amp; Regulatory Accreditations
                </h6>
                <div class="d-flex flex-wrap gap-2">
                    @if (Model.Certifications != null && Model.Certifications.Any())
                    {
                        foreach (var cert in Model.Certifications)
                        {
                            <div class="p-2 px-3 bg-light rounded-pill border d-inline-flex align-items-center gap-2 extra-small">
                                <i class="fa fa-check-circle text-success"></i>
                                <span class="fw-semibold text-dark">@cert</span>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="p-2 px-3 bg-light rounded-pill border d-inline-flex align-items-center gap-2 extra-small">
                            <i class="fa fa-check-circle text-success"></i>
                            <span class="fw-semibold text-dark">ISO 9001:2015 Quality Management System</span>
                        </div>
                        <div class="p-2 px-3 bg-light rounded-pill border d-inline-flex align-items-center gap-2 extra-small">
                            <i class="fa fa-check-circle text-success"></i>
                            <span class="fw-semibold text-dark">ISO/IEC 27001:2022 Information Security</span>
                        </div>
                        <div class="p-2 px-3 bg-light rounded-pill border d-inline-flex align-items-center gap-2 extra-small">
                            <i class="fa fa-check-circle text-success"></i>
                            <span class="fw-semibold text-dark">RoHS &amp; REACH Directive Compliance</span>
                        </div>
                        <div class="p-2 px-3 bg-light rounded-pill border d-inline-flex align-items-center gap-2 extra-small">
                            <i class="fa fa-check-circle text-success"></i>
                            <span class="fw-semibold text-dark">Dun &amp; Bradstreet Comprehensive 5A1 Rating</span>
                        </div>
                    }
                </div>
            </div>

            <!-- Executed Purchase Orders History -->
            <div class="mb-4">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <h6 class="fw-bold text-dark mb-0">
                        <i class="fa fa-file-invoice text-primary me-1.5"></i> Recent Purchase Orders &amp; Fulfillment Track Record
                    </h6>
                    <span class="extra-small text-muted">Showing recent procurement contracts</span>
                </div>

                <div class="table-responsive">
                    <table class="va-table">
                        <thead>
                            <tr>
                                <th style="width: 20%;">PO Reference</th>
                                <th style="width: 20%;">Order Date</th>
                                <th style="width: 15%;">Items Count</th>
                                <th style="width: 20%;">Total Value (₹)</th>
                                <th style="width: 15%;">Fulfillment</th>
                                <th style="width: 10%;" class="text-end">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.RecentOrders != null && Model.RecentOrders.Any())
                            {
                                foreach (var ord in Model.RecentOrders)
                                {
                                    <tr>
                                        <td>
                                            <a href="@Url.Action("OrderDetails", "Purchase", new { poNumber = ord.PONumber })" class="font-monospace fw-bold text-primary text-decoration-none">
                                                <i class="fa fa-file-lines me-1"></i> @ord.PONumber
                                            </a>
                                        </td>
                                        <td class="text-muted small">@ord.OrderDate</td>
                                        <td class="fw-semibold">@ord.ItemsCount Line Item@(ord.ItemsCount == 1 ? "" : "s")</td>
                                        <td class="fw-bold text-dark">@ord.TotalAmount</td>
                                        <td>
                                            <span class="badge @(ord.Status == "Delivered" ? "bg-success-subtle text-success" : (ord.Status == "In Transit" ? "bg-info-subtle text-info" : "bg-primary-subtle text-primary")) extra-small fw-bold">
                                                @ord.Status
                                            </span>
                                        </td>
                                        <td class="text-end">
                                            <a href="@Url.Action("OrderDetails", "Purchase", new { poNumber = ord.PONumber })" class="btn btn-sm btn-outline-primary py-0.5 px-2" style="font-size: 0.72rem;">
                                                <i class="fa fa-eye me-1"></i> View Slip
                                            </a>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td>
                                        <a href="@Url.Action("OrderDetails", "Purchase", new { poNumber = "PO-2026-0891" })" class="font-monospace fw-bold text-primary text-decoration-none">
                                            <i class="fa fa-file-lines me-1"></i> PO-2026-0891
                                        </a>
                                    </td>
                                    <td class="text-muted small">29 Aug 2026</td>
                                    <td class="fw-semibold">3 Line Items</td>
                                    <td class="fw-bold text-dark">₹ 4,20,000.00</td>
                                    <td><span class="badge bg-info-subtle text-info extra-small fw-bold">In Transit</span></td>
                                    <td class="text-end">
                                        <a href="@Url.Action("OrderDetails", "Purchase", new { poNumber = "PO-2026-0891" })" class="btn btn-sm btn-outline-primary py-0.5 px-2" style="font-size: 0.72rem;">
                                            <i class="fa fa-eye me-1"></i> View Slip
                                        </a>
                                    </td>
                                </tr>
                                <tr>
                                    <td>
                                        <a href="@Url.Action("OrderDetails", "Purchase", new { poNumber = "PO-2026-0885" })" class="font-monospace fw-bold text-primary text-decoration-none">
                                            <i class="fa fa-file-lines me-1"></i> PO-2026-0885
                                        </a>
                                    </td>
                                    <td class="text-muted small">15 Aug 2026</td>
                                    <td class="fw-semibold">5 Line Items</td>
                                    <td class="fw-bold text-dark">₹ 8,90,000.00</td>
                                    <td><span class="badge bg-success-subtle text-success extra-small fw-bold">Delivered</span></td>
                                    <td class="text-end">
                                        <a href="@Url.Action("OrderDetails", "Purchase", new { poNumber = "PO-2026-0885" })" class="btn btn-sm btn-outline-primary py-0.5 px-2" style="font-size: 0.72rem;">
                                            <i class="fa fa-eye me-1"></i> View Slip
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Lead Auditor Assessment & Interactive Findings -->
            <div class="p-3.5 bg-light rounded-3 border mb-3">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h6 class="fw-bold text-dark mb-0">
                        <i class="fa fa-clipboard-check text-success me-2"></i> Lead Auditor Assessment &amp; Governance
                    </h6>
                    <span class="extra-small text-muted">Auditor: <strong>@(Model.LeadAuditor ?? "Rajesh Khanna, Lead SRM Quality Auditor")</strong></span>
                </div>

                <div class="mb-3">
                    <label class="extra-small fw-bold text-muted text-uppercase d-block mb-1">Auditor Findings &amp; Quality Observations:</label>
                    <textarea id="liveAuditorRemarks" class="form-control form-control-sm" rows="3" placeholder="Enter findings or observations...">@Model.AuditorRemarks</textarea>
                </div>

                <div class="row g-3 align-items-end no-print">
                    <div class="col-md-4">
                        <label class="extra-small fw-bold text-muted text-uppercase d-block mb-1">Audit Status Classification:</label>
                        <select id="liveAuditStatus" class="form-select form-select-sm">
                            <option value="Preferred Partner" selected="@(Model.Status == "Preferred Partner")">Preferred Partner (Tier 1)</option>
                            <option value="Approved Tier 1" selected="@(Model.Status == "Approved Tier 1")">Approved Tier 1</option>
                            <option value="Approved Tier 2" selected="@(Model.Status == "Approved Tier 2")">Approved Tier 2</option>
                            <option value="Under Review" selected="@(Model.Status == "Under Review")">Under Review (Quality Hold)</option>
                            <option value="Suspended" selected="@(Model.Status == "Suspended")">Suspended</option>
                        </select>
                    </div>

                    <div class="col-md-4">
                        <label class="extra-small fw-bold text-muted text-uppercase d-block mb-1">Risk Grade Evaluation:</label>
                        <select id="liveRiskGrade" class="form-select form-select-sm">
                            <option value="Low Risk (Grade AAA)" selected="@(Model.RiskGrade?.Contains("AAA") == true)">Low Risk (Grade AAA)</option>
                            <option value="Low Risk (Grade AA)" selected="@(Model.RiskGrade?.Contains("AA") == true)">Low Risk (Grade AA)</option>
                            <option value="Moderate Risk (Grade B)" selected="@(Model.RiskGrade?.Contains("Grade B") == true)">Moderate Risk (Grade B)</option>
                            <option value="High Risk (Grade C)" selected="@(Model.RiskGrade?.Contains("Grade C") == true)">High Risk (Grade C)</option>
                        </select>
                    </div>

                    <div class="col-md-4">
                        <button type="button" class="btn btn-sm btn-primary w-100 fw-bold" onclick="saveAuditFindings()">
                            <i class="fa fa-floppy-disk me-1"></i> Save Auditor Review
                        </button>
                    </div>
                </div>

                <div class="row pt-3 mt-3 border-top g-3 align-items-center">
                    <div class="col-sm-7">
                        <div class="text-muted extra-small">
                            Next Mandatory Audit: <span class="fw-bold text-dark" id="dispNextAuditDate">@(Model.NextAuditDate ?? "15 Feb 2027")</span> &bull; 
                            Governance: <span class="text-success fw-semibold"><i class="fa fa-certificate me-0.5"></i> SAP MM Verified Cryptographic Hash</span>
                        </div>
                    </div>
                    <div class="col-sm-5 text-sm-end">
                        <div class="d-inline-block text-center">
                            <div class="fw-bold text-dark font-monospace" style="border-bottom: 2px dashed #cbd5e1; padding-bottom: 4px; font-size: 0.8rem;">
                                <i class="fa fa-signature text-primary me-1"></i> @(Model.LeadAuditor ?? "Rajesh Khanna, Lead SRM Quality Auditor")
                            </div>
                            <span class="extra-small text-muted d-block" style="font-size: 0.68rem;">SRM Quality Assurance &bull; Operafy ERP</span>
                        </div>
                    </div>
                </div>
            </div>

        </div>

    </div>
</div>

<!-- Real-Time Toast Notification -->
<div class="va-toast-box" id="vaToastBox">
    <div class="card border-0 shadow-lg" style="border-radius: 12px; background: #1e293b; color: #fff;">
        <div class="card-body p-3 d-flex align-items-center justify-content-between gap-3">
            <div class="d-flex align-items-center gap-2.5">
                <i class="fa fa-circle-check text-success fs-5" id="vaToastIcon"></i>
                <span class="small fw-semibold" id="vaToastMessage">Audit findings saved successfully.</span>
            </div>
            <button type="button" class="btn-close btn-close-white btn-sm" onclick="hideToast()"></button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        var currentVendorName = "@Model.VendorName";

        function showToast(message, isSuccess) {
            var box = document.getElementById("vaToastBox");
            var msgEl = document.getElementById("vaToastMessage");
            var iconEl = document.getElementById("vaToastIcon");
            if (!box || !msgEl) return;

            msgEl.textContent = message;
            if (iconEl) {
                iconEl.className = (isSuccess !== false)
                    ? "fa fa-circle-check text-success fs-5"
                    : "fa fa-triangle-exclamation text-warning fs-5";
            }
            box.style.display = "block";
            clearTimeout(window._vaToastTimeout);
            window._vaToastTimeout = setTimeout(hideToast, 4500);
        }

        function hideToast() {
            var box = document.getElementById("vaToastBox");
            if (box) box.style.display = "none";
        }

        function saveAuditFindings() {
            var remarks = document.getElementById("liveAuditorRemarks")?.value || "";
            var status = document.getElementById("liveAuditStatus")?.value || "Preferred Partner";
            var riskGrade = document.getElementById("liveRiskGrade")?.value || "Low Risk (Grade AAA)";
            var nextDate = document.getElementById("dispNextAuditDate")?.textContent || "15 Feb 2027";

            // Submit status update
            var fdStatus = new FormData();
            fdStatus.append("vendorName", currentVendorName);
            fdStatus.append("status", status);

            fetch('@Url.Action("UpdateVendorAuditStatus", "Purchase")', {
                method: "POST",
                body: fdStatus
            });

            // Submit remarks and risk update
            var fdRemarks = new FormData();
            fdRemarks.append("vendorName", currentVendorName);
            fdRemarks.append("remarks", remarks);
            fdRemarks.append("nextAuditDate", nextDate);
            fdRemarks.append("riskGrade", riskGrade);

            fetch('@Url.Action("SaveVendorAuditRemarks", "Purchase")', {
                method: "POST",
                body: fdRemarks
            })
            .then(function(res) { return res.json(); })
            .then(function(res) {
                if (res && res.success) {
                    showToast("Auditor findings and evaluation saved successfully.", true);

                    // Update UI pills
                    var statusPill = document.getElementById("hdrStatusPill");
                    if (statusPill) {
                        statusPill.innerHTML = '<i class="fa fa-circle-check"></i> ' + status;
                    }
                    var riskPill = document.getElementById("hdrRiskPill");
                    if (riskPill) {
                        riskPill.innerHTML = '<i class="fa fa-award"></i> ' + riskGrade;
                    }
                    var cardRisk = document.getElementById("cardRiskGrade");
                    if (cardRisk) {
                        cardRisk.textContent = riskGrade;
                    }
                } else {
                    showToast("Error saving findings: " + (res.message || "Operation failed"), false);
                }
            })
            .catch(function() {
                showToast("Network error updating auditor remarks.", false);
            });
        }
    </script>
}

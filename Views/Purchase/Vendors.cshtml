@model List<ERP_System.Models.VendorScorecardItem>
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Vendor Scorecards & Directory - SAP MM Evaluation";

    decimal avgRatingVal = 4.6m;
    if (Model != null && Model.Any())
    {
        var validRatings = new List<decimal>();
        foreach (var v in Model)
        {
            var part = (v.Rating ?? "").Split('/')[0].Trim();
            if (decimal.TryParse(part, System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out decimal r))
            {
                validRatings.Add(r);
            }
        }
        if (validRatings.Any())
        {
            avgRatingVal = Math.Round(validRatings.Average(), 1);
        }
    }
}


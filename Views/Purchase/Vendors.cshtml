<script>
    document.addEventListener("DOMContentLoaded", function () {

        const searchInput = document.getElementById("vendorSearch");
        const categoryFilter = document.getElementById("vendorCategoryFilter");
        const statusFilter = document.getElementById("vendorStatusFilter");
        const resultCount = document.getElementById("vendorResultCount");
        const emptyState = document.getElementById("vendorEmpty");
        const vendorItems = Array.from(document.querySelectorAll(".vendor-item"));
        const averageRatingElement = document.getElementById("averageRating");

        function normalize(value) {
            return (value || "").toString().trim().toLowerCase();
        }

        function filterVendors() {

            const searchTerm = normalize(searchInput.value);
            const selectedCategory = normalize(categoryFilter.value);
            const selectedStatus = normalize(statusFilter.value);

            let visibleCount = 0;

            vendorItems.forEach(function (vendor) {

                const name = normalize(vendor.dataset.name);
                const category = normalize(vendor.dataset.category);
                const status = normalize(vendor.dataset.status);

                const matchesSearch =
                    !searchTerm ||
                    name.includes(searchTerm) ||
                    category.includes(searchTerm) ||
                    status.includes(searchTerm);

                const matchesCategory =
                    selectedCategory === "all" ||
                    category === selectedCategory;

                const matchesStatus =
                    selectedStatus === "all" ||
                    status === selectedStatus;

                const shouldShow =
                    matchesSearch &&
                    matchesCategory &&
                    matchesStatus;

                vendor.style.display = shouldShow ? "" : "none";

                if (shouldShow) {
                    visibleCount++;
                }
            });

            resultCount.textContent = visibleCount;

            emptyState.style.display =
                visibleCount === 0 ? "block" : "none";
        }

        function calculateAverageRating() {

            const ratingValues = [];

            vendorItems.forEach(function (vendor) {

                const ratingText =
                    vendor.querySelector(".vendor-rating > span:last-child")?.textContent || "";

                const match = ratingText.replace(",", ".").match(/[\d.]+/);

                if (match) {

                    const rating = parseFloat(match[0]);

                    if (!isNaN(rating)) {
                        ratingValues.push(rating);
                    }
                }
            });

            if (ratingValues.length > 0) {

                const total = ratingValues.reduce(
                    (sum, rating) => sum + rating,
                    0
                );

                const average = total / ratingValues.length;

                averageRatingElement.textContent =
                    average.toFixed(1) + " / 5";

            } else {

                averageRatingElement.textContent = "-";
            }
        }

        function compactIndianMoney(value) {

            if (value === null || value === undefined) {
                return "";
            }

            let numeric = String(value)
                .replace(/[₹,\s]/g, "")
                .replace(/[^0-9.-]/g, "");

            const amount = parseFloat(numeric);

            if (isNaN(amount)) {
                return value;
            }

            if (Math.abs(amount) >= 10000000) {
                return "₹" + (amount / 10000000).toFixed(2) + "Cr";
            }

            if (Math.abs(amount) >= 100000) {
                return "₹" + (amount / 100000).toFixed(2) + "L";
            }

            if (Math.abs(amount) >= 1000) {
                return "₹" + (amount / 1000).toFixed(1) + "K";
            }

            return "₹" + amount.toLocaleString("en-IN", {
                maximumFractionDigits: 2
            });
        }

        function exactIndianMoney(value) {

            if (value === null || value === undefined) {
                return "";
            }

            let numeric = String(value)
                .replace(/[₹,\s]/g, "")
                .replace(/[^0-9.-]/g, "");

            const amount = parseFloat(numeric);

            if (isNaN(amount)) {
                return value;
            }

            return "₹" + amount.toLocaleString("en-IN", {
                minimumFractionDigits: 2,
                maximumFractionDigits: 2
            });
        }

        function formatSpendValues() {

            document.querySelectorAll(".vendor-money").forEach(function (element) {

                const originalValue =
                    element.dataset.value || element.textContent;

                const exactValue =
                    exactIndianMoney(originalValue);

                const compactValue =
                    compactIndianMoney(originalValue);

                element.textContent = compactValue;

                element.title = exactValue;
                element.setAttribute("aria-label", exactValue);
            });
        }

        searchInput.addEventListener("input", filterVendors);
        categoryFilter.addEventListener("change", filterVendors);
        statusFilter.addEventListener("change", filterVendors);

        calculateAverageRating();
        formatSpendValues();
        filterVendors();

        /* Vendor Onboarding Form Handler */
        var onboardForm = document.getElementById("onboardVendorForm");
        if (onboardForm) {
            onboardForm.addEventListener("submit", function(e) {
                e.preventDefault();
                var btn = document.getElementById("btnSubmitOnboardVendor");
                if (btn) btn.disabled = true;

                var nameVal = document.getElementById("newVendorName").value;
                var catVal = document.getElementById("newVendorCategory").value;
                var rateVal = document.getElementById("newVendorRating").value || "4.8 / 5.0";
                var statusVal = "Approved Partner";

                var formData = {
                    Name: nameVal,
                    Category: catVal,
                    Rating: rateVal,
                    SpendYTD: "₹ 0.00",
                    OnTimeDeliveryRate: "100%",
                    QualityScore: "100%",
                    Status: statusVal
                };

                fetch('@Url.Action("OnboardVendor", "Purchase")', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                    body: new URLSearchParams(formData)
                })
                .then(function(res) { return res.json(); })
                .then(function(data) {
                    if (data && data.success) {
                        var modalEl = document.getElementById("onboardVendorModal");
                        var modalInstance = bootstrap.Modal.getInstance(modalEl);
                        if (modalInstance) modalInstance.hide();
                        onboardForm.reset();

                        showVendorToast(data.message || "Vendor successfully onboarded!", true);

                        // Prepend newly created vendor card dynamically
                        var grid = document.querySelector(".vendor-grid");
                        if (grid) {
                            var newCard = document.createElement("div");
                            newCard.className = "vendor-card vendor-item";
                            newCard.setAttribute("data-name", formData.Name);
                            newCard.setAttribute("data-category", formData.Category);
                            newCard.setAttribute("data-status", formData.Status);
                            newCard.innerHTML = `
                                <div class="vendor-card-body">
                                    <div class="vendor-header">
                                        <div class="vendor-title-wrap">
                                            <div class="vendor-avatar">` + formData.Name.substring(0, 2).toUpperCase() + `</div>
                                            <div>
                                                <h5 class="vendor-name mb-0">` + formData.Name + `</h5>
                                                <div class="vendor-category">` + formData.Category + `</div>
                                            </div>
                                        </div>
                                        <span class="vendor-badge badge-active">` + formData.Status + `</span>
                                    </div>
                                    <div class="vendor-stats-grid">
                                        <div class="vendor-stat">
                                            <div class="vendor-stat-label">Spend YTD</div>
                                            <div class="vendor-stat-value vendor-money" data-value="0">₹0</div>
                                        </div>
                                        <div class="vendor-stat">
                                            <div class="vendor-stat-label">SLA Rating</div>
                                            <div class="vendor-stat-value rating-high"><i class="fa fa-star"></i> ` + formData.Rating + `</div>
                                        </div>
                                    </div>
                                    <div class="vendor-performance">
                                        <div class="vendor-score-row">
                                            <div class="vendor-score-heading">
                                                <span class="vendor-score-label"><i class="fa fa-truck-fast me-1"></i> On-Time Delivery</span>
                                                <span class="vendor-score-value green">100%</span>
                                            </div>
                                            <div class="vendor-progress"><div class="vendor-progress-bar green" style="width: 100%"></div></div>
                                        </div>
                                    </div>
                                </div>
                                <div class="vendor-card-footer">
                                    <span class="vendor-verified"><i class="fa fa-circle-check"></i> GSTIN Verified</span>
                                    <button type="button" class="btn btn-sm btn-outline-primary vendor-audit-btn" onclick="openVendorAuditModal('` + formData.Name + `', '` + formData.Category + `', '` + formData.Rating + `', '₹ 0.00', '100%', '100%', '` + formData.Status + `')">
                                        <i class="fa fa-file-contract me-1"></i> Full Audit Report
                                    </button>
                                </div>`;
                            grid.prepend(newCard);

                            // Update KPI count
                            var totalKpi = document.querySelector(".vendor-kpi-value");
                            if (totalKpi) {
                                var cur = parseInt(totalKpi.textContent.trim(), 10) || 0;
                                totalKpi.textContent = cur + 1;
                            }
                        }
                    } else {
                        showVendorToast(data.message || "Failed to onboard vendor.", false);
                    }
                })
                .catch(function(err) {
                    showVendorToast("Network error submitting vendor.", false);
                })
                .finally(function() {
                    if (btn) btn.disabled = false;
                });
            });
        }

    });

    /* Vendor Toast Notification Helper */
    function showVendorToast(message, isSuccess = true) {
        var toastEl = document.getElementById("vendorLiveToast");
        if (!toastEl) return;
        var msgEl = document.getElementById("vendorToastMessage");
        var iconEl = document.getElementById("vendorToastIcon");
        if (msgEl) msgEl.textContent = message;
        if (iconEl) {
            iconEl.className = isSuccess ? "fa fa-circle-check fs-5 text-white" : "fa fa-triangle-exclamation fs-5 text-white";
        }
        toastEl.className = "toast align-items-center text-white border-0 shadow-lg " + (isSuccess ? "bg-success" : "bg-danger");
        var toast = bootstrap.Toast.getInstance(toastEl) || new bootstrap.Toast(toastEl, { delay: 4000 });
        toast.show();
    }

    /* Vendor Audit Modal & Print Handlers */
    window.openVendorAuditModal = function(name, category, rating, spendYtd, onTimeRate, qualityScore, status) {
        if (document.getElementById("auditVendorName")) document.getElementById("auditVendorName").textContent = name || "Supplier Partner";
        if (document.getElementById("auditVendorCategory")) document.getElementById("auditVendorCategory").textContent = category || "Enterprise Partner";
        if (document.getElementById("auditVendorRating")) document.getElementById("auditVendorRating").textContent = rating || "4.8 / 5.0";
        if (document.getElementById("auditVendorStatus")) document.getElementById("auditVendorStatus").textContent = status || "Preferred Partner";
        if (document.getElementById("auditVendorSpend")) document.getElementById("auditVendorSpend").textContent = spendYtd || "₹ 24,50,000";
        if (document.getElementById("auditOnTimeRate")) document.getElementById("auditOnTimeRate").textContent = onTimeRate || "98%";
        if (document.getElementById("auditQualityScore")) document.getElementById("auditQualityScore").textContent = qualityScore || "99%";

        // Live fetch for audit details
        fetch('@Url.Action("GetVendorAudit", "Purchase")?vendorName=' + encodeURIComponent(name || ''))
            .then(function(res) { return res.json(); })
            .then(function(data) {
                if (data && data.success) {
                    if (data.gstin && document.getElementById("auditVendorGstin")) document.getElementById("auditVendorGstin").textContent = data.gstin;
                    if (data.pan && document.getElementById("auditVendorPan")) document.getElementById("auditVendorPan").textContent = data.pan;
                    if (data.contactEmail && document.getElementById("auditVendorEmail")) document.getElementById("auditVendorEmail").textContent = data.contactEmail;
                    if (data.contactPhone && document.getElementById("auditVendorPhone")) document.getElementById("auditVendorPhone").textContent = data.contactPhone;
                    if (data.leadTimeDays && document.getElementById("auditLeadTime")) document.getElementById("auditLeadTime").textContent = data.leadTimeDays;
                    if (data.paymentTerms && document.getElementById("auditPaymentTerms")) document.getElementById("auditPaymentTerms").textContent = data.paymentTerms;
                    if (data.rejectionRate && document.getElementById("auditDefectRate")) document.getElementById("auditDefectRate").textContent = data.rejectionRate;

                    if (data.certifications && data.certifications.length > 0) {
                        var certList = document.getElementById("auditCertificationsList");
                        if (certList) {
                            certList.innerHTML = data.certifications.map(function(c) {
                                return '<li><i class="fa fa-check-circle text-success me-1"></i> ' + c + '</li>';
                            }).join('');
                        }
                    }

                    if (data.recentPOs && data.recentPOs.length > 0) {
                        var poList = document.getElementById("auditRecentPOsList");
                        if (poList) {
                            poList.innerHTML = data.recentPOs.map(function(p) {
                                return '<li><i class="fa fa-file-invoice text-primary me-1"></i> ' + p + '</li>';
                            }).join('');
                        }
                    }
                }
            })
            .catch(function(err) {
                console.warn("Could not load full vendor audit data.", err);
            })
            .finally(function() {
                var modalEl = document.getElementById("vendorAuditModal");
                if (modalEl) {
                    var modal = bootstrap.Modal.getInstance(modalEl) || new bootstrap.Modal(modalEl);
                    modal.show();
                }
            });
    };

    window.printVendorAudit = function() {
        var printContents = document.getElementById('printableVendorAuditArea').innerHTML;
        var printWin = window.open('', '_blank', 'width=900,height=800');
        printWin.document.write('<html><head><title>Vendor Performance Audit Dossier</title>');
        printWin.document.write('<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">');
        printWin.document.write('<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">');
        printWin.document.write('<style>body{padding:25px;font-family:Segoe UI,sans-serif;color:#1e293b;} @@media print {.no-print{display:none;}}</style>');
        printWin.document.write('</head><body>');
        printWin.document.write(printContents);
        printWin.document.write('</body></html>');
        printWin.document.close();
        printWin.focus();
        setTimeout(function() {
            printWin.print();
            printWin.close();
        }, 400);
    };
</script>
<!-- ==========================================================================
     MODAL: ONBOARD NEW VENDOR
     ========================================================================== -->
<div class="modal fade" id="onboardVendorModal" tabindex="-1" aria-labelledby="onboardVendorModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 18px; overflow: hidden;">
            <div class="modal-header bg-light border-bottom px-4 py-3 d-flex justify-content-between align-items-center">
                <div class="d-flex align-items-center gap-2">
                    <span class="badge bg-success-subtle text-success fw-bold px-2.5 py-1">SAP MM XK01</span>
                    <h5 class="modal-title fw-bold text-dark mb-0" id="onboardVendorModalLabel">
                        <i class="fa fa-building-circle-check text-success me-2"></i> Onboard New Enterprise Supplier
                    </h5>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <form id="onboardVendorForm">
                <div class="modal-body p-4">
                    <p class="text-muted small mb-3">
                        Register a new corporate vendor into the procurement registry. All fields will be verified against GSTIN and procurement compliance databases.
                    </p>

                    <div class="row g-3">
                        <div class="col-md-7">
                            <label class="form-label small fw-bold text-dark">Supplier Enterprise Legal Name *</label>
                            <input type="text" class="form-control" name="Name" id="newVendorName" placeholder="e.g. Apex Industrial Solutions Ltd" required />
                        </div>
                        <div class="col-md-5">
                            <label class="form-label small fw-bold text-dark">Procurement Category *</label>
                            <select class="form-select" name="Category" id="newVendorCategory" required>
                                <option value="Industrial Hardware">Industrial Hardware</option>
                                <option value="IT Infrastructure">IT Infrastructure & Hardware</option>
                                <option value="Packaging & Office">Packaging & Office Supplies</option>
                                <option value="Raw Materials">Raw Materials & Alloys</option>
                                <option value="Logistics & Fleet">Logistics & Fleet Support</option>
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-dark">GSTIN Identification No. *</label>
                            <input type="text" class="form-control text-uppercase" name="GSTIN" id="newVendorGstin" placeholder="e.g. 29AAACE1234F1Z8" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-dark">PAN Number *</label>
                            <input type="text" class="form-control text-uppercase" name="PAN" id="newVendorPan" placeholder="e.g. AAACE1234F" required />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-dark">Key Contact Person & Title *</label>
                            <input type="text" class="form-control" name="ContactPerson" id="newVendorContact" placeholder="e.g. Anil Sharma (Key Account Director)" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-dark">Official Corporate Email *</label>
                            <input type="email" class="form-control" name="Email" id="newVendorEmail" placeholder="e.g. accounts@@vendorcorp.com" required />
                        </div>

                        <div class="col-md-4">
                            <label class="form-label small fw-bold text-dark">Contact Phone / Mobile *</label>
                            <input type="tel" class="form-control" name="Phone" id="newVendorPhone" placeholder="+91 98450 12345" required />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-bold text-dark">Credit & Payment Terms</label>
                            <select class="form-select" name="PaymentTerms" id="newVendorTerms">
                                <option value="Net 30">Net 30 Days</option>
                                <option value="Net 45">Net 45 Days</option>
                                <option value="Net 60">Net 60 Days</option>
                                <option value="Advance 50%">Advance 50%</option>
                                <option value="Immediate">Immediate / Advance</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-bold text-dark">Initial Baseline Rating</label>
                            <input type="text" class="form-control" name="Rating" id="newVendorRating" value="4.8 / 5.0" />
                        </div>

                        <div class="col-12">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="vendorComplianceCheck" checked required />
                                <label class="form-check-label small text-muted" for="vendorComplianceCheck">
                                    I confirm that this supplier adheres to Operafy Vendor Code of Conduct, Anti-Bribery policies, and verified MSME/GSTIN credentials.
                                </label>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="modal-footer bg-light px-4 py-3 d-flex justify-content-between">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-success btn-sm px-4" id="btnSubmitOnboardVendor">
                        <i class="fa fa-check me-1"></i> Register & Onboard Supplier
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>


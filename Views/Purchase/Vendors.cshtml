@model List<ERP_System.Models.VendorScorecardItem>
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Vendor Scorecards & Directory - SAP MM Evaluation";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

<style>
    :root {
        --vendor-primary: #2563eb;
        --vendor-primary-dark: #1d4ed8;
        --vendor-success: #16a34a;
        --vendor-warning: #f59e0b;
        --vendor-danger: #dc2626;
        --vendor-purple: #7c3aed;
        --vendor-text: #172033;
        --vendor-muted: #64748b;
        --vendor-border: #e5e7eb;
        --vendor-bg: #f5f7fb;
        --vendor-card: #ffffff;
        --vendor-shadow: 0 8px 30px rgba(15, 23, 42, 0.06);
        --vendor-shadow-hover: 0 18px 45px rgba(15, 23, 42, 0.11);
    }

    .vendor-page {
        min-height: calc(100vh - 80px);
        background: radial-gradient(circle at 5% 0%, rgba(37, 99, 235, 0.06), transparent 28%), radial-gradient(circle at 95% 10%, rgba(22, 163, 74, 0.05), transparent 25%), var(--vendor-bg);
        padding-bottom: 50px;
    }

    .vendor-container {
        max-width: 1600px;
        margin: 0 auto;
    }

    /* =========================
           HEADER
           ========================= */

    .vendor-header {
        background: rgba(255, 255, 255, 0.92);
        border: 1px solid rgba(226, 232, 240, 0.9);
        border-radius: 20px;
        padding: 22px 24px;
        box-shadow: var(--vendor-shadow);
        backdrop-filter: blur(12px);
        animation: vendorFadeDown 0.55s ease both;
    }

    .vendor-breadcrumb {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 8px;
        margin-bottom: 12px;
    }

        .vendor-breadcrumb a {
            color: var(--vendor-muted);
            text-decoration: none;
            font-size: 0.78rem;
            font-weight: 600;
            transition: color 0.2s ease;
        }

            .vendor-breadcrumb a:hover {
                color: var(--vendor-primary);
            }

    .vendor-breadcrumb-divider {
        color: #cbd5e1;
        font-size: 0.75rem;
    }

    .vendor-module-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 5px 10px;
        border-radius: 999px;
        background: #ecfdf3;
        color: #15803d;
        border: 1px solid #bbf7d0;
        font-size: 0.69rem;
        font-weight: 800;
        letter-spacing: 0.2px;
    }

    .vendor-title-row {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 20px;
    }

    .vendor-title-icon {
        width: 46px;
        height: 46px;
        flex: 0 0 46px;
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(135deg, #dcfce7, #f0fdf4);
        color: var(--vendor-success);
        border: 1px solid #bbf7d0;
        box-shadow: 0 8px 18px rgba(22, 163, 74, 0.1);
    }

    .vendor-title {
        color: var(--vendor-text);
        font-size: clamp(1.2rem, 2vw, 1.65rem);
        font-weight: 800;
        letter-spacing: -0.4px;
        margin: 0;
    }

    .vendor-subtitle {
        color: var(--vendor-muted);
        font-size: 0.83rem;
        line-height: 1.6;
        margin: 4px 0 0;
        max-width: 850px;
    }

    .vendor-actions {
        display: flex;
        align-items: center;
        gap: 9px;
        flex-wrap: wrap;
    }

    .vendor-btn {
        border-radius: 10px !important;
        font-size: 0.78rem !important;
        font-weight: 700 !important;
        min-height: 38px;
        padding: 8px 14px !important;
        transition: all 0.22s ease !important;
    }

        .vendor-btn:hover {
            transform: translateY(-2px);
        }

    .vendor-btn-primary {
        box-shadow: 0 6px 16px rgba(22, 163, 74, 0.18);
    }

    /* =========================
           KPI CARDS
           ========================= */

    .vendor-kpi-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 16px;
        margin-top: 18px;
    }

    .vendor-kpi {
        position: relative;
        overflow: hidden;
        background: var(--vendor-card);
        border: 1px solid var(--vendor-border);
        border-radius: 16px;
        padding: 18px;
        box-shadow: var(--vendor-shadow);
        transition: all 0.25s ease;
        animation: vendorFadeUp 0.55s ease both;
    }

        .vendor-kpi:nth-child(1) {
            animation-delay: 0.05s;
        }

        .vendor-kpi:nth-child(2) {
            animation-delay: 0.1s;
        }

        .vendor-kpi:nth-child(3) {
            animation-delay: 0.15s;
        }

        .vendor-kpi:nth-child(4) {
            animation-delay: 0.2s;
        }

        .vendor-kpi:hover {
            transform: translateY(-4px);
            box-shadow: var(--vendor-shadow-hover);
            border-color: #dbeafe;
        }

        .vendor-kpi::after {
            content: "";
            position: absolute;
            right: -28px;
            top: -28px;
            width: 90px;
            height: 90px;
            border-radius: 50%;
            background: rgba(37, 99, 235, 0.035);
        }

    .vendor-kpi-top {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
    }

    .vendor-kpi-icon {
        width: 42px;
        height: 42px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.95rem;
    }

        .vendor-kpi-icon.blue {
            background: #eff6ff;
            color: #2563eb;
        }

        .vendor-kpi-icon.green {
            background: #f0fdf4;
            color: #16a34a;
        }

        .vendor-kpi-icon.orange {
            background: #fff7ed;
            color: #ea580c;
        }

        .vendor-kpi-icon.purple {
            background: #faf5ff;
            color: #7c3aed;
        }

    .vendor-kpi-label {
        color: var(--vendor-muted);
        font-size: 0.72rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.45px;
        margin-top: 12px;
    }

    .vendor-kpi-value {
        color: var(--vendor-text);
        font-size: 1.45rem;
        font-weight: 800;
        margin-top: 3px;
        letter-spacing: -0.5px;
    }

    .vendor-kpi-note {
        color: #94a3b8;
        font-size: 0.69rem;
        margin-top: 3px;
    }

    /* =========================
           FILTER BAR
           ========================= */

    .vendor-toolbar {
        margin-top: 20px;
        background: rgba(255, 255, 255, 0.94);
        border: 1px solid var(--vendor-border);
        border-radius: 16px;
        padding: 13px;
        box-shadow: var(--vendor-shadow);
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        flex-wrap: wrap;
        animation: vendorFadeUp 0.55s 0.2s ease both;
    }

    .vendor-search-wrap {
        position: relative;
        flex: 1 1 300px;
        max-width: 520px;
    }

        .vendor-search-wrap i {
            position: absolute;
            left: 14px;
            top: 50%;
            transform: translateY(-50%);
            color: #94a3b8;
            font-size: 0.8rem;
            pointer-events: none;
        }

    .vendor-search {
        width: 100%;
        height: 40px;
        border: 1px solid #dbe2ea;
        border-radius: 10px;
        background: #f8fafc;
        color: var(--vendor-text);
        padding: 0 14px 0 38px;
        font-size: 0.78rem;
        outline: none;
        transition: all 0.2s ease;
    }

        .vendor-search:focus {
            background: #fff;
            border-color: #93c5fd;
            box-shadow: 0 0 0 4px rgba(37, 99, 235, 0.08);
        }

    .vendor-filter-group {
        display: flex;
        align-items: center;
        gap: 8px;
        flex-wrap: wrap;
    }

    .vendor-filter {
        height: 40px;
        border: 1px solid #dbe2ea;
        border-radius: 10px;
        background: #fff;
        color: #475569;
        padding: 0 12px;
        font-size: 0.76rem;
        font-weight: 600;
        outline: none;
        cursor: pointer;
    }

        .vendor-filter:focus {
            border-color: #93c5fd;
            box-shadow: 0 0 0 4px rgba(37, 99, 235, 0.08);
        }

    .vendor-result-count {
        color: #64748b;
        font-size: 0.73rem;
        font-weight: 700;
        white-space: nowrap;
    }

    /* =========================
           SECTION HEADER
           ========================= */

    .vendor-section-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        margin: 24px 2px 13px;
    }

    .vendor-section-title {
        display: flex;
        align-items: center;
        gap: 9px;
        color: var(--vendor-text);
        font-size: 0.98rem;
        font-weight: 800;
        margin: 0;
    }

    .vendor-section-title-icon {
        width: 30px;
        height: 30px;
        border-radius: 9px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #eff6ff;
        color: #2563eb;
        font-size: 0.75rem;
    }

    .vendor-section-note {
        color: #94a3b8;
        font-size: 0.7rem;
        font-weight: 600;
    }

    /* =========================
           VENDOR CARDS
           ========================= */

    .vendor-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 17px;
    }

    .vendor-card {
        position: relative;
        overflow: hidden;
        background: var(--vendor-card);
        border: 1px solid var(--vendor-border);
        border-radius: 18px;
        box-shadow: var(--vendor-shadow);
        padding: 19px;
        transition: all 0.28s ease;
        animation: vendorCardIn 0.55s ease both;
    }

        .vendor-card:hover {
            transform: translateY(-5px);
            box-shadow: var(--vendor-shadow-hover);
            border-color: #d5e3f8;
        }

        .vendor-card::before {
            content: "";
            position: absolute;
            left: 0;
            top: 0;
            width: 100%;
            height: 3px;
            background: linear-gradient(90deg, #16a34a, #2563eb);
            opacity: 0;
            transition: opacity 0.25s ease;
        }

        .vendor-card:hover::before {
            opacity: 1;
        }

    .vendor-card-head {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 12px;
    }

    .vendor-identity {
        min-width: 0;
    }

    .vendor-category {
        display: inline-flex;
        align-items: center;
        padding: 4px 8px;
        border-radius: 7px;
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        color: #64748b;
        font-size: 0.64rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.3px;
        margin-bottom: 7px;
    }

    .vendor-name {
        color: var(--vendor-text);
        font-size: 0.98rem;
        font-weight: 800;
        margin: 0;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .vendor-status {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        white-space: nowrap;
        border-radius: 999px;
        padding: 6px 9px;
        background: #ecfdf3;
        border: 1px solid #bbf7d0;
        color: #15803d;
        font-size: 0.64rem;
        font-weight: 800;
    }

        .vendor-status i {
            font-size: 0.62rem;
        }

    .vendor-meta {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        margin-top: 14px;
        padding-bottom: 13px;
        border-bottom: 1px solid #eef2f7;
    }

    .vendor-rating {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        color: #b45309;
        font-size: 0.78rem;
        font-weight: 800;
    }

    .vendor-rating-star {
        width: 27px;
        height: 27px;
        border-radius: 8px;
        background: #fffbeb;
        color: #f59e0b;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 0.72rem;
    }

    .vendor-spend {
        text-align: right;
        min-width: 0;
    }

    .vendor-spend-label {
        display: block;
        color: #94a3b8;
        font-size: 0.61rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.25px;
    }

    .vendor-spend-value {
        display: block;
        color: #334155;
        font-size: 0.77rem;
        font-weight: 800;
        margin-top: 2px;
    }

    .vendor-score-panel {
        margin-top: 14px;
        padding: 14px;
        border-radius: 13px;
        background: #f8fafc;
        border: 1px solid #edf1f5;
    }

    .vendor-score-row + .vendor-score-row {
        margin-top: 14px;
    }

    .vendor-score-heading {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        margin-bottom: 7px;
    }

    .vendor-score-label {
        color: #64748b;
        font-size: 0.7rem;
        font-weight: 700;
    }

    .vendor-score-value {
        font-size: 0.7rem;
        font-weight: 800;
    }

        .vendor-score-value.green {
            color: #16a34a;
        }

        .vendor-score-value.blue {
            color: #2563eb;
        }

    .vendor-progress {
        height: 7px;
        overflow: hidden;
        border-radius: 999px;
        background: #e9eef5;
    }

    .vendor-progress-bar {
        height: 100%;
        border-radius: inherit;
        position: relative;
        overflow: hidden;
        transition: width 1s ease;
    }

        .vendor-progress-bar.green {
            background: linear-gradient(90deg, #22c55e, #16a34a);
        }

        .vendor-progress-bar.blue {
            background: linear-gradient(90deg, #60a5fa, #2563eb);
        }

        .vendor-progress-bar::after {
            content: "";
            position: absolute;
            top: 0;
            left: -35%;
            width: 35%;
            height: 100%;
            background: rgba(255,255,255,0.35);
            transform: skewX(-20deg);
            animation: vendorProgressShine 2.7s infinite;
        }

    .vendor-card-footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        margin-top: 15px;
        padding-top: 13px;
        border-top: 1px solid #eef2f7;
    }

    .vendor-verified {
        display: flex;
        align-items: center;
        gap: 6px;
        color: #64748b;
        font-size: 0.63rem;
        font-weight: 700;
        line-height: 1.3;
    }

        .vendor-verified i {
            color: #16a34a;
            font-size: 0.75rem;
        }

    .vendor-audit-btn {
        border-radius: 9px !important;
        font-size: 0.67rem !important;
        font-weight: 800 !important;
        padding: 7px 10px !important;
        white-space: nowrap;
        transition: all 0.2s ease !important;
    }

        .vendor-audit-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 14px rgba(37, 99, 235, 0.1);
        }

    /* =========================
           EMPTY STATE
           ========================= */

    .vendor-empty {
        display: none;
        background: #fff;
        border: 1px dashed #cbd5e1;
        border-radius: 18px;
        padding: 55px 20px;
        text-align: center;
        margin-top: 15px;
    }

    .vendor-empty-icon {
        width: 55px;
        height: 55px;
        margin: 0 auto 12px;
        border-radius: 15px;
        background: #f1f5f9;
        color: #94a3b8;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.15rem;
    }

    .vendor-empty h5 {
        color: var(--vendor-text);
        font-weight: 800;
        font-size: 0.95rem;
        margin-bottom: 5px;
    }

    .vendor-empty p {
        color: #94a3b8;
        font-size: 0.74rem;
        margin: 0;
    }

    /* =========================
           FOOTER INFO
           ========================= */

    .vendor-footer-info {
        margin-top: 20px;
        padding: 13px 15px;
        background: rgba(255, 255, 255, 0.75);
        border: 1px solid #e5e7eb;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        flex-wrap: wrap;
        color: #94a3b8;
        font-size: 0.67rem;
        font-weight: 600;
    }

        .vendor-footer-info span {
            display: inline-flex;
            align-items: center;
            gap: 6px;
        }

        .vendor-footer-info i {
            color: #64748b;
        }

    /* =========================
           ANIMATIONS
           ========================= */

    @@keyframes vendorFadeDown {
        from {
            opacity: 0;
            transform: translateY(-12px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@keyframes vendorFadeUp {
        from {
            opacity: 0;
            transform: translateY(16px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@keyframes vendorCardIn {
        from {
            opacity: 0;
            transform: translateY(20px) scale(0.985);
        }

        to {
            opacity: 1;
            transform: translateY(0) scale(1);
        }
    }

    @@keyframes vendorProgressShine {
        0% {
            left: -35%;
        }

        45%,
        100% {
            left: 120%;
        }
    }

    /* =========================
           RESPONSIVE
           ========================= */

    @@media (max-width: 1199.98px) {
        .vendor-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .vendor-kpi-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @@media (max-width: 767.98px) {
        .vendor-page {
            padding-bottom: 30px;
        }

        .vendor-header {
            padding: 17px;
            border-radius: 16px;
        }

        .vendor-title-row {
            flex-direction: column;
        }

        .vendor-actions {
            width: 100%;
        }

            .vendor-actions .vendor-btn {
                flex: 1 1 auto;
            }

        .vendor-kpi-grid {
            grid-template-columns: 1fr 1fr;
            gap: 10px;
        }

        .vendor-kpi {
            padding: 14px;
            border-radius: 14px;
        }

        .vendor-kpi-value {
            font-size: 1.2rem;
        }

        .vendor-kpi-icon {
            width: 36px;
            height: 36px;
            border-radius: 10px;
        }

        .vendor-toolbar {
            align-items: stretch;
        }

        .vendor-search-wrap {
            max-width: none;
            flex-basis: 100%;
        }

        .vendor-filter-group {
            width: 100%;
        }

        .vendor-filter {
            flex: 1 1 0;
        }

        .vendor-result-count {
            width: 100%;
        }

        .vendor-grid {
            grid-template-columns: 1fr;
            gap: 12px;
        }

        .vendor-section-header {
            align-items: flex-start;
            flex-direction: column;
            margin-top: 20px;
        }
    }

    @@media (max-width: 479.98px) {
        .vendor-container {
            padding-left: 10px !important;
            padding-right: 10px !important;
        }

        .vendor-header {
            padding: 15px;
        }

        .vendor-title-icon {
            width: 40px;
            height: 40px;
            flex-basis: 40px;
        }

        .vendor-subtitle {
            font-size: 0.76rem;
        }

        .vendor-actions {
            flex-direction: column;
        }

            .vendor-actions .vendor-btn {
                width: 100%;
            }

        .vendor-kpi-grid {
            grid-template-columns: 1fr;
        }

        .vendor-filter-group {
            flex-direction: column;
        }

        .vendor-filter {
            width: 100%;
        }

        .vendor-meta {
            align-items: flex-start;
            flex-direction: column;
        }

        .vendor-spend {
            text-align: left;
        }

        .vendor-card {
            padding: 16px;
        }

        .vendor-card-head {
            gap: 8px;
        }

        .vendor-status {
            font-size: 0.58rem;
            padding: 5px 7px;
        }

        .vendor-card-footer {
            align-items: stretch;
            flex-direction: column;
        }

        .vendor-audit-btn {
            width: 100%;
        }

        .vendor-footer-info {
            align-items: flex-start;
            flex-direction: column;
        }
    }

    /* =========================
           REDUCED MOTION
           ========================= */

    @@media (prefers-reduced-motion: reduce) {
        .vendor-header,
        .vendor-kpi,
        .vendor-toolbar,
        .vendor-card {
            animation: none !important;
        }

        .vendor-progress-bar::after {
            animation: none !important;
        }

        .vendor-card,
        .vendor-kpi,
        .vendor-btn,
        .vendor-audit-btn {
            transition: none !important;
        }
    }

    /* =========================
           PRINT
           ========================= */

    @@media print {
        .vendor-page {
            background: #fff !important;
        }

        .vendor-header,
        .vendor-kpi,
        .vendor-toolbar,
        .vendor-card,
        .vendor-footer-info {
            box-shadow: none !important;
        }

        .vendor-actions,
        .vendor-toolbar,
        .vendor-audit-btn {
            display: none !important;
        }

        .vendor-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .vendor-card {
            break-inside: avoid;
        }
    }
</style>

<div class="vendor-page">
    <div class="container-fluid px-2 px-md-4 pt-3 vendor-container">

        <!-- =========================
             HEADER
             ========================= -->
        <div class="vendor-header">

            <div class="vendor-breadcrumb">
                <a href="@Url.Action("Index", "Purchase")">
                    <i class="fa fa-arrow-left me-1"></i>
                    Control Hub
                </a>

                <span class="vendor-breadcrumb-divider">/</span>

                <span class="vendor-module-badge">
                    <i class="fa fa-shield-halved"></i>
                    SAP MM Vendor Evaluation
                    <span>(ME61)</span>
                </span>
            </div>

            <div class="vendor-title-row">

                <div class="d-flex align-items-start gap-3">

                    <div class="vendor-title-icon">
                        <i class="fa fa-handshake"></i>
                    </div>

                    <div>
                        <h3 class="vendor-title">
                            Vendor Directory & Scorecard Matrix
                        </h3>

                        <p class="vendor-subtitle">
                            Quantitative supplier performance tracking across
                            on-time delivery, quality acceptance, supplier ratings,
                            and cumulative procurement spend.
                        </p>

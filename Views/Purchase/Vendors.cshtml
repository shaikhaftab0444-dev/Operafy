@section Scripts {
<script>
    // Bulletproof modal launcher with triple fallback
    function showVendorAuditModalDirect(modalEl) {
        if (!modalEl) modalEl = document.getElementById("vendorAuditModal");
        if (!modalEl) return;

        // Ensure modal is attached to document.body to prevent stacking context clipping
        if (modalEl.parentNode !== document.body) {
            document.body.appendChild(modalEl);
        }

        try {
            if (window.bootstrap && window.bootstrap.Modal) {
                var modalInstance = window.bootstrap.Modal.getOrCreateInstance(modalEl, {
                    backdrop: 'static',
                    keyboard: true
                });
                if (modalInstance) {
                    modalInstance.show();
                    return;
                }
            }
        } catch (e) {
            console.warn("Bootstrap getOrCreateInstance fallback:", e);
        }

        try {
            if (window.jQuery && window.jQuery(modalEl).modal) {
                window.jQuery(modalEl).modal('show');
                return;
            }
        } catch (e) {
            console.warn("jQuery modal fallback:", e);
        }

        // Pure DOM display fallback
        modalEl.classList.add("show");
        modalEl.style.display = "block";
        modalEl.removeAttribute("aria-hidden");
        modalEl.setAttribute("aria-modal", "true");
        if (!document.querySelector(".modal-backdrop")) {
            var backdrop = document.createElement("div");
            backdrop.className = "modal-backdrop fade show vendor-audit-backdrop";
            document.body.appendChild(backdrop);
            backdrop.onclick = function() {
                modalEl.style.display = "none";
                modalEl.classList.remove("show");
                backdrop.remove();
            };
        }
    }

    /* Vendor Toast Notification Helper */
    function showVendorToast(message, isSuccess) {
        if (isSuccess === undefined) isSuccess = true;
        var toastEl = document.getElementById("vendorLiveToast");
        if (!toastEl) return;
        var msgEl = document.getElementById("vendorToastMessage");
        var iconEl = document.getElementById("vendorToastIcon");
        if (msgEl) msgEl.textContent = message;
        if (iconEl) {
            iconEl.className = isSuccess ? "fa fa-circle-check fs-5 text-white" : "fa fa-triangle-exclamation fs-5 text-white";
        }
        toastEl.className = "toast align-items-center text-white border-0 shadow-lg " + (isSuccess ? "bg-success" : "bg-danger");
        var toast = (window.bootstrap && window.bootstrap.Toast) ? (window.bootstrap.Toast.getInstance(toastEl) || new window.bootstrap.Toast(toastEl, { delay: 4000 })) : null;
        if (toast) {
            toast.show();
        } else {
            toastEl.style.display = "block";
            setTimeout(function() { toastEl.style.display = "none"; }, 4000);
        }
    }

    /* Active Vendor Reference for In-Modal Actions */
    window.currentAuditVendor = "";

    /* Vendor Audit Modal & Print Handlers */
    window.openVendorAuditModal = function(name, category, rating, spendYtd, onTimeRate, qualityScore, status) {
        window.currentAuditVendor = name || "";

        // Instant baseline UI population
        if (document.getElementById("auditVendorName")) document.getElementById("auditVendorName").textContent = name || "Supplier Partner";
        if (document.getElementById("auditVendorCategory")) document.getElementById("auditVendorCategory").textContent = category || "Enterprise Partner";
        if (document.getElementById("auditVendorRating")) document.getElementById("auditVendorRating").textContent = rating || "4.8 / 5.0";
        if (document.getElementById("auditVendorStatusBadge")) document.getElementById("auditVendorStatusBadge").textContent = status || "Preferred Partner";
        if (document.getElementById("auditVendorSpend")) document.getElementById("auditVendorSpend").textContent = spendYtd || "₹ 24,50,000.00";
        if (document.getElementById("auditOnTimeRate")) document.getElementById("auditOnTimeRate").textContent = onTimeRate || "98%";
        if (document.getElementById("auditQualityScore")) document.getElementById("auditQualityScore").textContent = qualityScore || "99%";

        var statusSelect = document.getElementById("auditStatusSelect");
        if (statusSelect && status) {
            for (var i = 0; i < statusSelect.options.length; i++) {
                if (statusSelect.options[i].value.toLowerCase() === status.toLowerCase() ||
                    status.toLowerCase().includes(statusSelect.options[i].value.toLowerCase())) {
                    statusSelect.selectedIndex = i;
                    break;
                }
            }
        }

        // Open modal IMMEDIATELY with zero lag
        var modalEl = document.getElementById("vendorAuditModal");
        showVendorAuditModalDirect(modalEl);

        // Indicate loading on dynamic table
        var tbody = document.getElementById("auditRecentOrdersTableBody");
        if (tbody) {
            tbody.innerHTML = '<tr><td colspan="6" class="text-center py-3 text-muted"><i class="fa fa-spinner fa-spin me-1 text-primary"></i> Fetching live orders & compliance records from data store...</td></tr>';
        }

        // Live fetch for rich audit dossier details
        fetch('@Url.Action("GetVendorAudit", "Purchase")?vendorName=' + encodeURIComponent(name || ''))
            .then(function(res) { return res.json(); })
            .then(function(data) {
                if (data && data.success) {
                    if (data.gstin && document.getElementById("auditVendorGstin")) document.getElementById("auditVendorGstin").textContent = data.gstin;
                    if (data.gstinStatus && document.getElementById("auditGstinStatus")) document.getElementById("auditGstinStatus").textContent = data.gstinStatus;
                    if (data.pan && document.getElementById("auditVendorPan")) document.getElementById("auditVendorPan").textContent = data.pan;
                    if (data.udyamRegNo && document.getElementById("auditUdyamReg")) document.getElementById("auditUdyamReg").textContent = data.udyamRegNo;
                    if (data.cinNumber && document.getElementById("auditCinNumber")) document.getElementById("auditCinNumber").textContent = data.cinNumber;
                    if (data.registeredAddress && document.getElementById("auditRegAddress")) document.getElementById("auditRegAddress").textContent = data.registeredAddress;
                    if (data.plantLocation && document.getElementById("auditPlantLocation")) document.getElementById("auditPlantLocation").textContent = data.plantLocation;
                    if (data.contactPerson && document.getElementById("auditVendorContact")) document.getElementById("auditVendorContact").textContent = data.contactPerson;
                    if (data.contactEmail && document.getElementById("auditVendorEmail")) document.getElementById("auditVendorEmail").textContent = data.contactEmail;
                    if (data.contactPhone && document.getElementById("auditVendorPhone")) document.getElementById("auditVendorPhone").textContent = data.contactPhone;
                    if (data.paymentTerms && document.getElementById("auditPaymentTerms")) document.getElementById("auditPaymentTerms").textContent = data.paymentTerms;
                    if (data.leadTimeDays && document.getElementById("auditLeadTime")) document.getElementById("auditLeadTime").textContent = data.leadTimeDays;
                    if (data.bankName && document.getElementById("auditBankName")) document.getElementById("auditBankName").textContent = data.bankName;
                    if (data.bankAccountMasked && document.getElementById("auditBankAcc")) document.getElementById("auditBankAcc").textContent = data.bankAccountMasked;
                    if (data.ifscCode && document.getElementById("auditIfscCode")) document.getElementById("auditIfscCode").textContent = data.ifscCode;
                    if (data.rejectionRate && document.getElementById("auditDefectRate")) document.getElementById("auditDefectRate").textContent = data.rejectionRate;
                    if (data.priceCompetitiveness && document.getElementById("auditPriceIndex")) document.getElementById("auditPriceIndex").textContent = data.priceCompetitiveness;
                    if (data.riskGrade && document.getElementById("auditRiskGrade")) document.getElementById("auditRiskGrade").textContent = data.riskGrade;
                    if (data.leadAuditor && document.getElementById("auditLeadAuditor")) document.getElementById("auditLeadAuditor").textContent = data.leadAuditor;
                    if (data.auditDate && document.getElementById("auditDate")) document.getElementById("auditDate").textContent = data.auditDate;
                    if (data.auditValidUntil && document.getElementById("auditValidUntil")) document.getElementById("auditValidUntil").textContent = data.auditValidUntil;
                    if (data.nextAuditDate && document.getElementById("auditNextDateField")) document.getElementById("auditNextDateField").value = data.nextAuditDate;
                    if (data.auditorRemarks && document.getElementById("auditRemarksField")) document.getElementById("auditRemarksField").value = data.auditorRemarks;

                    if (data.certifications && data.certifications.length > 0) {
                        var certList = document.getElementById("auditCertificationsList");
                        if (certList) {
                            certList.innerHTML = data.certifications.map(function(c) {
                                return '<li class="col"><i class="fa fa-check-circle text-success me-1"></i> ' + c + '</li>';
                            }).join('');
                        }
                    }

                    // Render live purchase orders
                    if (tbody) {
                        if (data.recentOrders && data.recentOrders.length > 0) {
                            var html = '';
                            data.recentOrders.forEach(function(po) {
                                var badgeClass = 'bg-primary';
                                if (po.status === 'Delivered') badgeClass = 'bg-success';
                                else if (po.status === 'In Transit') badgeClass = 'bg-info text-dark';
                                else if (po.status === 'Confirmed') badgeClass = 'bg-warning text-dark';

                                html += '<tr>' +
                                    '<td><a href="/Purchase/Orders" class="fw-bold text-primary text-decoration-none"><i class="fa fa-file-invoice me-1"></i>' + po.poNumber + '</a></td>' +
                                    '<td>' + (po.orderDate || 'Recent') + '</td>' +
                                    '<td><span class="badge bg-light text-dark border">' + (po.itemsCount || 1) + ' Items</span></td>' +
                                    '<td><strong class="text-dark">' + (po.totalAmount || '₹ 0.00') + '</strong></td>' +
                                    '<td><span class="badge ' + badgeClass + '">' + (po.status || 'Confirmed') + '</span></td>' +
                                    '<td><span class="text-muted extra-small">' + (po.paymentTerms || 'Net 30') + '</span></td>' +
                                    '</tr>';
                            });
                            tbody.innerHTML = html;
                        } else {
                            tbody.innerHTML = '<tr><td colspan="6" class="text-center py-2 text-muted">No purchase orders recorded yet for this supplier.</td></tr>';
                        }
                    }
                }
            })
            .catch(function(err) {
                console.warn("Could not load full vendor audit data.", err);
                if (tbody) {
                    tbody.innerHTML = '<tr><td colspan="6" class="text-center py-2 text-muted">Could not load remote records. Showing cached snapshot.</td></tr>';
                }
            });
    };

    /* Real-Time Status Update from Audit Dossier */
    window.quickUpdateVendorAuditStatus = function() {
        var statusSelect = document.getElementById("auditStatusSelect");
        if (!statusSelect || !window.currentAuditVendor) return;
        var newStatus = statusSelect.value;

        fetch('@Url.Action("UpdateVendorAuditStatus", "Purchase")', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: new URLSearchParams({ vendorName: window.currentAuditVendor, status: newStatus })
        })
        .then(function(res) { return res.json(); })
        .then(function(data) {
            if (data && data.success) {
                showVendorToast(data.message, true);
                var badge = document.getElementById("auditVendorStatusBadge");
                if (badge) badge.textContent = newStatus;

                // Sync card on grid
                document.querySelectorAll(".vendor-item").forEach(function(card) {
                    if (card.dataset.name === window.currentAuditVendor) {
                        card.dataset.status = newStatus;
                        var cardStatusEl = card.querySelector(".vendor-status");
                        if (cardStatusEl) cardStatusEl.innerHTML = '<i class="fa fa-certificate"></i> ' + newStatus;
                    }
                });

                // Update Active Vendors KPI
                var kpiEl = document.getElementById("activeVendorCount");
                if (kpiEl && data.activeVendorsCount !== undefined) {
                    kpiEl.textContent = data.activeVendorsCount;
                }
            } else {
                showVendorToast((data && data.message) || "Could not update status.", false);
            }
        })
        .catch(function(err) {
            showVendorToast("Network error updating vendor status.", false);
        });
    };

    /* Save Auditor Findings & Next Date */
    window.saveAuditAssessmentNotes = function() {
        if (!window.currentAuditVendor) return;
        var remarks = document.getElementById("auditRemarksField") ? document.getElementById("auditRemarksField").value : "";
        var nextDate = document.getElementById("auditNextDateField") ? document.getElementById("auditNextDateField").value : "";
        var riskGrade = document.getElementById("auditRiskGradeSelect") ? document.getElementById("auditRiskGradeSelect").value : "";

        var btn = document.getElementById("btnSaveAuditNotes");
        if (btn) {
            btn.disabled = true;
            btn.innerHTML = '<i class="fa fa-spinner fa-spin me-1"></i> Saving...';
        }

        fetch('@Url.Action("SaveVendorAuditRemarks", "Purchase")', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: new URLSearchParams({
                vendorName: window.currentAuditVendor,
                remarks: remarks,
                nextAuditDate: nextDate,
                riskGrade: riskGrade
            })
        })
        .then(function(res) { return res.json(); })
        .then(function(data) {
            if (data && data.success) {
                showVendorToast(data.message || "Audit assessment saved successfully.", true);
                var riskBadge = document.getElementById("auditRiskGrade");
                if (riskBadge && riskGrade) riskBadge.textContent = riskGrade;
            } else {
                showVendorToast((data && data.message) || "Could not save audit notes.", false);
            }
        })
        .catch(function(err) {
            showVendorToast("Network error saving audit notes.", false);
        })
        .finally(function() {
            if (btn) {
                btn.disabled = false;
                btn.innerHTML = '<i class="fa fa-floppy-disk me-1"></i> Save Assessment Notes';
            }
        });
    };

    /* High-Fidelity Printable Audit Certificate */
    window.printVendorAudit = function() {

                    SAP MM Vendor Evaluation
                    <span>(ME61)</span>
                </span>
            </div>

            <div class="vendor-title-row">

                <div class="d-flex align-items-start gap-3">

                    <div class="vendor-title-icon">
                        <i class="fa fa-handshake"></i>
                    </div>

                    <div>
                        <h3 class="vendor-title">
                            Vendor Directory & Scorecard Matrix
                        </h3>

                        <p class="vendor-subtitle">
                            Quantitative supplier performance tracking across
                            on-time delivery, quality acceptance, supplier ratings,
                            and cumulative procurement spend.
                        </p>
                    </div>

                </div>

                <div class="vendor-actions">

                    <a href="@Url.Action("Index", "Purchase")"
                       class="btn btn-outline-secondary vendor-btn">

                        <i class="fa fa-gauge me-1"></i>
                        Dashboard

                    </a>

                    <button type="button"
                            class="btn btn-success vendor-btn vendor-btn-primary"
                            data-bs-toggle="modal"
                            data-bs-target="#onboardVendorModal">

                        <i class="fa fa-user-plus me-1"></i>
                        Onboard New Vendor

                    </button>

                </div>

            </div>

        </div>

        <!-- =========================
             KPI SUMMARY
             ========================= -->
        <div class="vendor-kpi-grid">

            <div class="vendor-kpi">

                <div class="vendor-kpi-top">
                    <div>
                        <div class="vendor-kpi-label mt-0">
                            Total Vendors
                        </div>

                        <div class="vendor-kpi-value">
                            @(Model?.Count ?? 0)
                        </div>

                        <div class="vendor-kpi-note">
                            Registered supplier records
                        </div>
                    </div>

                    <div class="vendor-kpi-icon blue">
                        <i class="fa fa-building"></i>
                    </div>
                </div>

            </div>

            <div class="vendor-kpi">

                <div class="vendor-kpi-top">
                    <div>
                        <div class="vendor-kpi-label mt-0">
                            Active Vendors
                        </div>

                        <div class="vendor-kpi-value" id="activeVendorCount">
                            @(Model?.Count(v => v.Status != null && !v.Status.Contains("Blacklist", StringComparison.OrdinalIgnoreCase) && !v.Status.Contains("Suspend", StringComparison.OrdinalIgnoreCase)) ?? 0)
                        </div>

                        <div class="vendor-kpi-note">
                            Currently approved suppliers
                        </div>
                    </div>

                    <div class="vendor-kpi-icon green">
                        <i class="fa fa-circle-check"></i>
                    </div>
                </div>

            </div>

            <div class="vendor-kpi">

                <div class="vendor-kpi-top">
                    <div>
                        <div class="vendor-kpi-label mt-0">
                            Avg. Rating
                        </div>

                        <div class="vendor-kpi-value" id="averageRating">
                            @avgRatingVal.ToString("0.0") / 5.0
                        </div>

                        <div class="vendor-kpi-note">
                            Supplier performance index
                        </div>
                    </div>

                    <div class="vendor-kpi-icon orange">
                        <i class="fa fa-star"></i>
                    </div>
                </div>

            </div>

            <div class="vendor-kpi">

                <div class="vendor-kpi-top">
                    <div>
                        <div class="vendor-kpi-label mt-0">
                            Verified Suppliers
                        </div>

                        <div class="vendor-kpi-value">
                            @(Model?.Count ?? 0)
                        </div>

                        <div class="vendor-kpi-note">
                            GSTIN verified & audited
                        </div>
                    </div>

                    <div class="vendor-kpi-icon purple">
                        <i class="fa fa-certificate"></i>
                    </div>
                </div>

            </div>

        </div>

        <!-- =========================
             FILTER / SEARCH TOOLBAR
             ========================= -->
        <div class="vendor-toolbar">

            <div class="vendor-search-wrap">

                <i class="fa fa-search"></i>

                <input type="text"
                       id="vendorSearch"
                       class="vendor-search"
                       placeholder="Search vendor, category or status..."
                       autocomplete="off" />

            </div>

            <div class="vendor-filter-group">

                <select id="vendorCategoryFilter" class="vendor-filter">
                    <option value="all">All Categories</option>

                    @foreach (var category in Model
                                        .Where(v => !string.IsNullOrWhiteSpace(v.Category))
                                        .Select(v => v.Category)
                                        .Distinct()
                                        .OrderBy(v => v))
                    {
                        <option value="@category.ToLower()">
                            @category
                        </option>
                    }
                </select>

                <select id="vendorStatusFilter" class="vendor-filter">
                    <option value="all">All Status</option>

                    @foreach (var status in Model
                                        .Where(v => !string.IsNullOrWhiteSpace(v.Status))
                                        .Select(v => v.Status)
                                        .Distinct()
                                        .OrderBy(v => v))
                    {
                        <option value="@status.ToLower()">
                            @status
                        </option>
                    }
                </select>

            </div>

            <div class="vendor-result-count">
                Showing <span id="vendorResultCount">@(Model?.Count ?? 0)</span> vendors
            </div>

        </div>

        <!-- =========================
             SECTION TITLE
             ========================= -->
        <div class="vendor-section-header">

            <h4 class="vendor-section-title">

                <span class="vendor-section-title-icon">
                    <i class="fa fa-chart-column"></i>
                </span>

                Supplier Performance Scorecards

            </h4>

            <span class="vendor-section-note">
                Live procurement evaluation matrix
            </span>

        </div>

        <!-- =========================
             VENDOR GRID
             ========================= -->
        <div class="vendor-grid" id="vendorGrid">

            @foreach (var v in Model)
            {
                <div class="vendor-card vendor-item"
                     data-name="@v.Name"
                     data-category="@v.Category"
                     data-status="@v.Status">

                    <div>

                        <!-- Card Header -->
                        <div class="vendor-card-head">

                            <div class="vendor-identity">

                                <span class="vendor-category">
                                    @v.Category
                                </span>

                                <a href="@Url.Action("VendorAudit", "Purchase", new { vendorName = v.Name })"
                                   class="text-decoration-none"
                                   title="Click to view full audit report for @v.Name">
                                    <h5 class="vendor-name">
                                        @v.Name
                                    </h5>
                                </a>

                            </div>

                            <span class="vendor-status">

                                <i class="fa fa-certificate"></i>

                                @v.Status

                            </span>

                        </div>

                        <!-- Rating + Spend -->
                        <div class="vendor-meta">

                            <div class="vendor-rating">

                                <span class="vendor-rating-star">
                                    <i class="fa fa-star"></i>
                                </span>

                                <span>
                                    @v.Rating
                                </span>

                            </div>

                            <div class="vendor-spend">

                                <span class="vendor-spend-label">
                                    Cumulative YTD
                                </span>

                                <span class="vendor-spend-value vendor-money"
                                      data-value="@v.SpendYTD">
                                    @v.SpendYTD
                                </span>

                            </div>

                        </div>

                        <!-- Performance Score Panel -->
                        <div class="vendor-score-panel">

                            <!-- On-Time Delivery -->
                            <div class="vendor-score-row">

                                <div class="vendor-score-heading">

                                    <span class="vendor-score-label">
                                        <i class="fa fa-truck-fast me-1"></i>
                                        On-Time Delivery SLA
                                    </span>

                                    <span class="vendor-score-value green">
                                        @v.OnTimeDeliveryRate
                                    </span>

                                </div>

                                <div class="vendor-progress">

                                    <div class="vendor-progress-bar green"
                                         style="width: @v.OnTimeDeliveryRate">
                                    </div>

                                </div>

                            </div>

                            <!-- Quality Score -->
                            <div class="vendor-score-row">

                                <div class="vendor-score-heading">

                                    <span class="vendor-score-label">
                                        <i class="fa fa-circle-check me-1"></i>
                                        Quality Acceptance Score
                                    </span>

                                    <span class="vendor-score-value blue">
                                        @v.QualityScore
                                    </span>

                                </div>

                                <div class="vendor-progress">

                                    <div class="vendor-progress-bar blue"
                                         style="width: @v.QualityScore">
                                    </div>

                                </div>

                            </div>

                        </div>

                    </div>

                    <!-- Card Footer -->
                    <div class="vendor-card-footer">

                        <span class="vendor-verified">

                            <i class="fa fa-circle-check"></i>

                            GSTIN Verified & Audited

                        </span>

                        <a href="@Url.Action("VendorAudit", "Purchase", new { vendorName = v.Name })"
                           class="btn btn-sm btn-outline-primary vendor-audit-btn"
                           data-name="@v.Name"
                           title="View full audit report for @v.Name">
                            <i class="fa fa-file-contract me-1"></i>
                            Full Audit Report
                        </a>

                    </div>

                </div>
            }

        </div>

        <!-- =========================
             EMPTY SEARCH STATE
             ========================= -->
        <div class="vendor-empty" id="vendorEmpty">

            <div class="vendor-empty-icon">
                <i class="fa fa-magnifying-glass"></i>
            </div>

            <h5>No vendors found</h5>

            <p>
                Try changing the search term or selecting a different filter.
            </p>

        </div>

        <!-- =========================
             FOOTER INFORMATION
             ========================= -->
        <div class="vendor-footer-info">

            <span>
                <i class="fa fa-database"></i>
                Supplier records synchronized with procurement master data
            </span>

            <span>
                <i class="fa fa-shield-halved"></i>
                SAP MM evaluation controls enabled
            </span>

        </div>

    </div>
</div>


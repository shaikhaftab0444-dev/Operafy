@model ERP_System.Models.NotificationViewModel
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Notification Center";
}

<style>
    .panel-notifications {
        background: #ffffff;
        border: 1px solid var(--border-warm);
        border-radius: 12px;
        box-shadow: 0 1px 3px rgba(45,37,30,0.03);
    }

    .notif-card-item {
        padding: 1rem 1.25rem;
        border-bottom: 1px solid var(--border-warm);
        transition: background-color 0.2s;
    }
    .notif-card-item:hover {
        background-color: #f8fafc;
    }
    .notif-card-item.unread-bg {
        background-color: rgba(59, 130, 246, 0.03);
    }

    .notif-icon-box {
        width: 44px;
        height: 44px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.15rem;
        flex-shrink: 0;
    }

    .btn-pill-filter {
        border-radius: 20px;
        padding: 0.35rem 0.9rem;
        font-size: 0.825rem;
        font-weight: 600;
        border: 1px solid #cbd5e1;
        background-color: #ffffff;
        color: #475569;
        text-decoration: none;
        transition: all 0.2s;
    }
    .btn-pill-filter:hover, .btn-pill-filter.active {
        background-color: #2563eb;
        color: #ffffff;
        border-color: #2563eb;
    }
</style>

<!-- Top Header & Breadcrumbs -->
<div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-3 mb-4 text-start">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-1 small">
                <li class="breadcrumb-item"><a href="/Dashboard" class="text-decoration-none text-muted">Dashboard</a></li>
                <li class="breadcrumb-item active fw-semibold text-primary" aria-current="page">Notifications</li>
            </ol>
        </nav>
        <h4 class="fw-bold m-0 text-dark">Notification Center</h4>
        <p class="text-muted small m-0">View system alerts, activity logs, and real-time operational notifications personalized for your account.</p>
    </div>
    <div class="d-flex gap-2">
        <form method="post" asp-action="MarkAllAsRead" asp-route-category="@Model.SelectedCategory" asp-route-status="@Model.FilterStatus">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-outline-primary btn-sm px-3 py-2 fw-semibold">
                <i class="fa-solid fa-check-double me-1"></i> Mark All as Read
            </button>
        </form>
    </div>
</div>

<!-- TempData Success Alerts -->
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm mb-4" role="alert">
        <i class="fa-solid fa-circle-check me-2"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Category & Status Filter Bar -->
<div class="panel-notifications p-3 mb-4">
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
        <!-- Category Filters -->
        <div class="d-flex flex-wrap gap-1.5 align-items-center">
            <span class="text-muted small fw-semibold me-2">Categories:</span>
            <a href="/Notifications?status=@Model.FilterStatus" class="btn-pill-filter @(string.IsNullOrEmpty(Model.SelectedCategory) ? "active" : "")">All (@Model.TotalCount)</a>
            <a href="/Notifications?category=System&status=@Model.FilterStatus" class="btn-pill-filter @(Model.SelectedCategory == "System" ? "active" : "")">System</a>
            <a href="/Notifications?category=Sales&status=@Model.FilterStatus" class="btn-pill-filter @(Model.SelectedCategory == "Sales" ? "active" : "")">Sales</a>
            <a href="/Notifications?category=Inventory&status=@Model.FilterStatus" class="btn-pill-filter @(Model.SelectedCategory == "Inventory" ? "active" : "")">Inventory</a>
            <a href="/Notifications?category=Purchase&status=@Model.FilterStatus" class="btn-pill-filter @(Model.SelectedCategory == "Purchase" ? "active" : "")">Purchase</a>
            <a href="/Notifications?category=HR&status=@Model.FilterStatus" class="btn-pill-filter @(Model.SelectedCategory == "HR" ? "active" : "")">HR</a>
            <a href="/Notifications?category=Finance&status=@Model.FilterStatus" class="btn-pill-filter @(Model.SelectedCategory == "Finance" ? "active" : "")">Finance</a>
        </div>

        <!-- Read / Unread Status Filter -->
        <div class="btn-group btn-group-sm">
            <a href="/Notifications?status=all@(string.IsNullOrEmpty(Model.SelectedCategory) ? "" : "&category=" + Model.SelectedCategory)" class="btn btn-outline-secondary @(Model.FilterStatus == "all" ? "active" : "")">All</a>
            <a href="/Notifications?status=unread@(string.IsNullOrEmpty(Model.SelectedCategory) ? "" : "&category=" + Model.SelectedCategory)" class="btn btn-outline-secondary @(Model.FilterStatus == "unread" ? "active" : "")">Unread (@Model.UnreadCount)</a>
        </div>
    </div>
</div>

<!-- Notification List Container -->
<div class="panel-notifications overflow-hidden mb-4">
    @if (Model.Notifications.Any())
    {
        @foreach (var item in Model.Notifications)
        {
            <div class="notif-card-item d-flex align-items-start gap-3 @(!item.IsRead ? "unread-bg" : "")">
                <div class="notif-icon-box @item.BgColorClass @item.ColorClass">
                    <i class="fa-solid @item.IconClass"></i>
                </div>
                <div class="flex-grow-1 min-width-0 text-start">
                    <div class="d-flex justify-content-between align-items-start gap-2 mb-1">
                        <div class="d-flex align-items-center gap-2">
                            <h6 class="fw-bold text-dark mb-0">@item.Title</h6>
                            <span class="badge bg-secondary-subtle text-dark border px-2 py-0.5" style="font-size: 0.7rem;">@item.Category</span>
                            @if (!item.IsRead)
                            {
                                <span class="badge bg-primary rounded-pill px-2 py-0.5" style="font-size: 0.65rem;">New</span>
                            }
                        </div>
                        <span class="text-muted small" style="font-size: 0.78rem;">
                            <i class="fa-regular fa-clock me-1"></i>@item.CreatedAt.ToString("MMM dd, yyyy - hh:mm tt")
                        </span>
                    </div>
                    <p class="text-secondary small mb-2" style="line-height: 1.4;">@item.Description</p>
                    <div class="d-flex align-items-center gap-2">
                        @if (!string.IsNullOrEmpty(item.TargetUrl) && item.TargetUrl != "#")
                        {
                            <a href="@item.TargetUrl" class="btn btn-sm btn-outline-primary py-0.5 px-2.5" style="font-size: 0.75rem;">
                                Open Module <i class="fa-solid fa-arrow-up-right-from-square ms-1"></i>
                            </a>
                        }
                        @if (!item.IsRead)
                        {
                            <form method="post" asp-action="MarkAsRead" asp-route-id="@item.NotificationId" asp-route-category="@Model.SelectedCategory" asp-route-status="@Model.FilterStatus" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-link text-decoration-none text-muted py-0 px-2" style="font-size: 0.75rem;">
                                    Mark as read
                                </button>
                            </form>
                        }
                        <form method="post" asp-action="ClearNotification" asp-route-id="@item.NotificationId" asp-route-category="@Model.SelectedCategory" asp-route-status="@Model.FilterStatus" class="d-inline">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-link text-decoration-none text-danger py-0 px-2" style="font-size: 0.75rem;">
                                Clear
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <div class="text-center py-5">
            <i class="fa-regular fa-bell-slash text-muted d-block fs-1 mb-3"></i>
            <h6 class="fw-bold text-dark mb-1">No Notifications Found</h6>
            <p class="text-muted small">You're all caught up! There are no notifications matching your current filter.</p>
        </div>
    }
</div>

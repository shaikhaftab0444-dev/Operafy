@model ERP_System.Models.TaxSummaryViewModel
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Statutory Tax Filing Hub";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

<style>
    :root {
        --tax-primary: #2563eb;
        --tax-primary-dark: #1d4ed8;
        --tax-success: #059669;
        --tax-warning: #d97706;
        --tax-danger: #dc2626;
        --tax-info: #0891b2;
        --tax-text: #0f172a;
        --tax-muted: #64748b;
        --tax-border: #e2e8f0;
        --tax-soft: #f8fafc;
        --tax-white: #ffffff;
        --tax-shadow: 0 8px 30px rgba(15, 23, 42, 0.06);
        --tax-shadow-hover: 0 14px 38px rgba(15, 23, 42, 0.10);
    }

    .tax-wrapper {
        min-height: 100vh;
        padding: 12px 0 35px;
        font-family: "Segoe UI", system-ui, -apple-system, BlinkMacSystemFont, sans-serif;
        color: var(--tax-text);
    }

    .tax-container {
        max-width: 1700px;
        margin: 0 auto;
    }

    /* =========================
           PAGE HEADER
           ========================= */

    .tax-page-header {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 20px;
        margin-bottom: 28px;
    }

    .tax-header-left {
        min-width: 0;
    }

    .tax-eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        color: var(--tax-primary);
        font-size: 11px;
        font-weight: 800;
        letter-spacing: 0.13em;
        text-transform: uppercase;
        margin-bottom: 7px;
    }

        .tax-eyebrow::before {
            content: "";
            width: 28px;
            height: 2px;
            background: var(--tax-primary);
            border-radius: 20px;
        }

    .tax-title {
        margin: 0;
        font-size: clamp(24px, 2.2vw, 34px);
        font-weight: 800;
        letter-spacing: -0.035em;
        color: #0f172a;
        line-height: 1.15;
    }

    .tax-subtitle {
        margin: 9px 0 0;
        color: var(--tax-muted);
        font-size: 14px;
        line-height: 1.6;
    }

    .tax-header-actions {
        display: flex;
        align-items: center;
        gap: 10px;
        flex-shrink: 0;
    }

    .tax-action-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        min-height: 42px;
        padding: 0 16px;
        border-radius: 10px;
        font-size: 13px;
        font-weight: 700;
        text-decoration: none;
        transition: all 0.22s ease;
    }

    .tax-print-btn {
        border: 1px solid var(--tax-border);
        background: var(--tax-white);
        color: #334155;
    }

        .tax-print-btn:hover {
            color: var(--tax-primary);
            border-color: #bfdbfe;
            background: #eff6ff;
            transform: translateY(-1px);
        }

    .tax-back-btn {
        border: 1px solid #334155;
        background: #334155;
        color: #fff;
    }

        .tax-back-btn:hover {
            background: #1e293b;
            border-color: #1e293b;
            color: #fff;
            transform: translateY(-1px);
        }

    /* =========================
           SUMMARY CARDS
           ========================= */

    .tax-summary-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 18px;
        margin-bottom: 22px;
    }

    .tax-summary-card {
        position: relative;
        overflow: hidden;
        background: var(--tax-white);
        border: 1px solid var(--tax-border);
        border-radius: 18px;
        box-shadow: var(--tax-shadow);
        padding: 22px;
        transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
    }

        .tax-summary-card:hover {
            transform: translateY(-3px);
            box-shadow: var(--tax-shadow-hover);
        }

        .tax-summary-card::after {
            content: "";
            position: absolute;
            width: 120px;
            height: 120px;
            border-radius: 50%;
            right: -55px;
            bottom: -65px;
            opacity: 0.06;
        }

        .tax-summary-card.gst-outward::after {
            background: var(--tax-primary);
        }

        .tax-summary-card.gst-input::after {
            background: var(--tax-warning);
        }

        .tax-summary-card.net-payable::after {
            background: var(--tax-danger);
        }

    .tax-card-top {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        margin-bottom: 18px;
    }

    .tax-card-label {
        display: flex;
        align-items: center;
        gap: 10px;
        color: #475569;
        font-size: 11px;
        font-weight: 800;
        letter-spacing: 0.08em;
        text-transform: uppercase;
    }

    .tax-card-icon {
        width: 38px;
        height: 38px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 11px;
        font-size: 15px;
    }

        .tax-card-icon.blue {
            color: var(--tax-primary);
            background: #eff6ff;
        }

        .tax-card-icon.amber {
            color: var(--tax-warning);
            background: #fffbeb;
        }

        .tax-card-icon.red {
            color: var(--tax-danger);
            background: #fef2f2;
        }

    .tax-card-status {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 5px 8px;
        border-radius: 999px;
        font-size: 10px;
        font-weight: 800;
        background: #f8fafc;
        color: #64748b;
    }

        .tax-card-status i {
            font-size: 6px;
        }

    .tax-card-content {
        position: relative;
        z-index: 1;
    }

    .tax-metric-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 15px;
        padding: 9px 0;
    }

    .tax-metric-label {
        color: #64748b;
        font-size: 13px;
    }

    .tax-metric-value {
        color: #1e293b;
        font-size: 14px;
        font-weight: 750;
        text-align: right;
        white-space: nowrap;
    }

    .tax-divider {
        height: 1px;
        border: 0;
        background: #edf2f7;
        margin: 5px 0 8px;
    }

    .tax-total-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 15px;
        padding-top: 7px;
    }

    .tax-total-label {
        font-size: 13px;
        font-weight: 700;
    }

    .tax-total-value {
        font-size: 20px;
        font-weight: 850;
        letter-spacing: -0.02em;
        white-space: nowrap;
    }

    .text-tax-success {
        color: var(--tax-success);
    }

    .text-tax-primary {
        color: var(--tax-primary);
    }

    .text-tax-danger {
        color: var(--tax-danger);
    }

    /* =========================
           COMMON SECTION CARD
           ========================= */

    .tax-section-card {
        background: var(--tax-white);
        border: 1px solid var(--tax-border);
        border-radius: 18px;
        box-shadow: var(--tax-shadow);
        overflow: hidden;
    }

    .tax-section-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 15px;
        padding: 20px 22px;
        border-bottom: 1px solid #edf2f7;
        background: #fff;
    }

    .tax-section-heading {
        display: flex;
        align-items: center;
        gap: 11px;
        min-width: 0;
    }

    .tax-section-heading-icon {
        width: 38px;
        height: 38px;
        flex: 0 0 38px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 11px;
        background: #eff6ff;
        color: var(--tax-primary);
        font-size: 14px;
    }

    .tax-section-heading h2 {
        margin: 0;
        color: #0f172a;
        font-size: 16px;
        font-weight: 800;
    }

    .tax-section-heading p {
        margin: 3px 0 0;
        color: #94a3b8;
        font-size: 11px;
    }

    .tax-period-pill {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 7px 11px;
        border-radius: 999px;
        background: #f8fafc;
        border: 1px solid var(--tax-border);
        color: #475569;
        font-size: 11px;
        font-weight: 750;
        white-space: nowrap;
    }

    .tax-section-body {
        padding: 0;
    }

    /* =========================
           FILING TABLE
           ========================= */

    .tax-table-wrap {
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
    }

    .tax-table {
        width: 100%;
        min-width: 920px;
        margin: 0;
        border-collapse: separate;
        border-spacing: 0;
    }

        .tax-table thead th {
            padding: 13px 18px;
            background: #f8fafc;
            border-bottom: 1px solid var(--tax-border);
            color: #64748b;
            font-size: 10px;
            font-weight: 850;
            letter-spacing: 0.07em;
            text-transform: uppercase;
            white-space: nowrap;
        }

        .tax-table tbody td {
            padding: 15px 18px;
            border-bottom: 1px solid #f1f5f9;
            color: #475569;
            font-size: 13px;
            vertical-align: middle;
            background: #fff;
        }

        .tax-table tbody tr {
            transition: background 0.18s ease;
        }

            .tax-table tbody tr:hover td {
                background: #f8fbff;
            }

            .tax-table tbody tr:last-child td {
                border-bottom: 0;
            }

    .tax-form-name {
        display: inline-flex;
        align-items: center;
        gap: 9px;
        color: #1e293b;
        font-weight: 800;
    }

    .tax-form-icon {
        width: 30px;
        height: 30px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 8px;
        background: #f1f5f9;
        color: #64748b;
        font-size: 11px;
    }

    .tax-period-text {
        color: #475569;
        font-weight: 600;
    }

    .tax-date {
        color: #334155;
        font-weight: 650;
        white-space: nowrap;
    }

    .tax-challan {
        display: inline-flex;
        align-items: center;
        max-width: 190px;
        padding: 5px 8px;
        overflow: hidden;
        border: 1px solid #e2e8f0;
        border-radius: 7px;
        background: #f8fafc;
        color: #475569 !important;
        font-size: 11px;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .tax-status {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 6px 10px;
        border-radius: 999px;
        font-size: 10px;
        font-weight: 800;
        white-space: nowrap;
    }

        .tax-status.filed {
            color: #047857;
            background: #ecfdf5;
            border: 1px solid #a7f3d0;
        }

        .tax-status.pending {
            color: #b45309;
            background: #fffbeb;
            border: 1px solid #fde68a;
        }

        .tax-status i {
            font-size: 6px;
        }

    .tax-download-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        min-height: 34px;
        padding: 0 11px;
        border: 1px solid #cbd5e1;
        border-radius: 8px;
        background: #fff;
        color: #475569;
        font-size: 11px;
        font-weight: 750;
        white-space: nowrap;
        transition: all 0.2s ease;
    }

        .tax-download-btn:hover {
            border-color: #93c5fd;
            background: #eff6ff;
            color: var(--tax-primary);
            transform: translateY(-1px);
        }

    .tax-empty {
        text-align: center;
        padding: 50px 20px !important;
    }

    .tax-empty-icon {
        width: 52px;
        height: 52px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 15px;
        background: #f8fafc;
        color: #94a3b8;
        margin-bottom: 12px;
        font-size: 19px;
    }

    .tax-empty-title {
        margin: 0;
        color: #334155;
        font-size: 14px;
        font-weight: 800;
    }

    .tax-empty-text {
        margin: 5px 0 0;
        color: #94a3b8;
        font-size: 12px;
    }

    /* =========================
           DETAILS GRID
           ========================= */

    .tax-details-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 18px;
        margin-top: 22px;
    }

    .tax-detail-card {
        background: var(--tax-white);
        border: 1px solid var(--tax-border);
        border-radius: 18px;
        box-shadow: var(--tax-shadow);
        overflow: hidden;
    }

    .tax-detail-header {
        display: flex;
        align-items: center;
        gap: 11px;
        padding: 19px 20px;
        border-bottom: 1px solid #edf2f7;
    }

    .tax-detail-icon {
        width: 37px;
        height: 37px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 10px;
        background: #f8fafc;
        color: #64748b;
        font-size: 14px;
    }

    .tax-detail-header h3 {
        margin: 0;
        color: #1e293b;
        font-size: 14px;
        font-weight: 800;
    }

    .tax-detail-header span {
        display: block;
        margin-top: 2px;
        color: #94a3b8;
        font-size: 10px;
    }

    .tax-detail-body {
        padding: 0;
    }

    .tax-detail-table-wrap {
        overflow-x: auto;
    }

    .tax-detail-table {
        width: 100%;
        min-width: 560px;
        border-collapse: collapse;
        margin: 0;
    }

        .tax-detail-table th {
            padding: 11px 14px;
            background: #f8fafc;
            border-bottom: 1px solid var(--tax-border);
            color: #64748b;
            font-size: 9px;
            font-weight: 850;
            letter-spacing: 0.06em;
            text-transform: uppercase;
            white-space: nowrap;
        }

        .tax-detail-table td {
            padding: 12px 14px;
            border-bottom: 1px solid #f1f5f9;
            color: #475569;
            font-size: 11px;
            white-space: nowrap;
        }

        .tax-detail-table tbody tr:hover td {
            background: #f8fbff;
        }

        .tax-detail-table tfoot td {
            background: #f8fafc;
            color: #1e293b;
            font-weight: 800;
            border-top: 1px solid var(--tax-border);
            border-bottom: 0;
        }

    .tax-number {
        text-align: right;
        font-variant-numeric: tabular-nums;
        font-weight: 650;
    }

    .tax-category {
        color: #334155;
        font-weight: 700;
    }

    .tax-code-badge {
        display: inline-flex;
        align-items: center;
        padding: 5px 7px;
        border-radius: 6px;
        background: #f1f5f9;
        color: #475569;
        font-size: 10px;
        font-weight: 800;
    }

    /* =========================
           FOOTER NOTE
           ========================= */

    .tax-footer-note {
        display: flex;
        align-items: flex-start;
        gap: 10px;
        margin-top: 18px;
        padding: 13px 15px;
        border: 1px solid #dbeafe;
        border-radius: 12px;
        background: #eff6ff;
        color: #475569;
        font-size: 11px;
        line-height: 1.6;
    }

        .tax-footer-note i {
            color: var(--tax-primary);
            margin-top: 2px;
        }

    /* =========================
           ANIMATIONS
           ========================= */

    .tax-animate {
        animation: taxFadeUp 0.5s ease both;
    }

    .tax-delay-1 {
        animation-delay: 0.05s;
    }

    .tax-delay-2 {
        animation-delay: 0.1s;
    }

    .tax-delay-3 {
        animation-delay: 0.15s;
    }

    @@keyframes taxFadeUp {
        from

    {
        opacity: 0;
        transform: translateY(10px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }

    }

    /* =========================
           RESPONSIVE
           ========================= */

    @@media (max-width: 1200px) {
        .tax-summary-grid

    {
        gap: 14px;
    }

    .tax-summary-card {
        padding: 18px;
    }

    .tax-total-value {
        font-size: 18px;
    }

    }

    @@media (max-width: 992px) {
        .tax-page-header

    {
        align-items: flex-start;
        flex-direction: column;
    }

    .tax-header-actions {
        width: 100%;
    }

        .tax-header-actions .tax-action-btn {
            flex: 1;
        }

    .tax-summary-grid {
        grid-template-columns: 1fr;
    }

    .tax-details-grid {
        grid-template-columns: 1fr;
    }

    }

    @@media (max-width: 768px) {
        .tax-wrapper

    {
        padding: 8px 0 25px;
    }

    .tax-container {
        padding-left: 12px !important;
        padding-right: 12px !important;
    }

    .tax-title {
        font-size: 25px;
    }

    .tax-subtitle {
        font-size: 13px;
    }

    .tax-header-actions {
        display: grid;
        grid-template-columns: 1fr 1fr;
    }

    .tax-action-btn {
        width: 100%;
        padding: 0 10px;
    }

    .tax-section-header {
        align-items: flex-start;
        flex-direction: column;
    }

    .tax-period-pill {
        align-self: flex-start;
    }

    .tax-detail-header {
        padding: 16px;
    }

    }

    @@media (max-width: 576px) {
        .tax-title

    {
        font-size: 22px;
    }

    .tax-eyebrow {
        font-size: 9px;
    }

    .tax-header-actions {
        grid-template-columns: 1fr;
    }

    .tax-summary-card {
        padding: 17px;
        border-radius: 15px;
    }

    .tax-card-top {
        align-items: flex-start;
    }

    .tax-card-label {
        font-size: 10px;
    }

    .tax-metric-label,
    .tax-metric-value,
    .tax-total-label {
        font-size: 12px;
    }

    .tax-total-value {
        font-size: 17px;
    }

    .tax-section-card,
    .tax-detail-card {
        border-radius: 15px;
    }

    .tax-section-header {
        padding: 16px;
    }

    .tax-section-heading h2 {
        font-size: 14px;
    }

    .tax-section-heading p {
        font-size: 10px;
    }

    .tax-footer-note {
        font-size: 10px;
    }

    }

    /* =========================
           ACCESSIBILITY
           ========================= */

    button:focus-visible,
    a:focus-visible {
        outline: 3px solid rgba(37, 99, 235, 0.2);
        outline-offset: 2px;
    }

    /* =========================
           PRINT
           ========================= */

    @@media print {
        body

    {
        background: #fff !important;
    }

    .tax-wrapper {
        padding: 0;
    }

    .tax-header-actions,
    .tax-download-btn {
        display: none !important;
    }

    .tax-summary-card,
    .tax-section-card,
    .tax-detail-card {
        box-shadow: none !important;
        border: 1px solid #d1d5db !important;
        break-inside: avoid;
    }

    .tax-summary-grid,
    .tax-details-grid {
        gap: 10px;
    }

    .tax-title {
        font-size: 25px;
    }

    .tax-table tbody tr:hover td,
    .tax-detail-table tbody tr:hover td {
        background: transparent !important;
    }

    }

    @@media (prefers-reduced-motion: reduce) {
        *, *::before, *::after

    {
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.01ms !important;
    }

    }
</style>

<div class="tax-wrapper">
    <div class="container-fluid px-4 tax-container">

        <!-- =========================
             PAGE HEADER
             ========================= -->
        <div class="tax-page-header tax-animate">
            <div class="tax-header-left">
                <div class="tax-eyebrow">
                    Statutory Tax Compliance
                </div>

                <h1 class="tax-title">
                    GST &amp; TDS Return Hub
                </h1>

                <p class="tax-subtitle">
                    Monitor GST liabilities, input tax credit, TDS deductions and statutory filing compliance from one place.
                </p>
            </div>

            <div class="tax-header-actions">
                <button type="button"
                        class="tax-action-btn tax-print-btn"
                        onclick="window.print()">
                    <i class="fa-solid fa-print"></i>
                    <span>Print Summary</span>
                </button>

                <a asp-action="Index"
                   class="tax-action-btn tax-back-btn">
                    <i class="fa-solid fa-arrow-left"></i>
                    <span>Back to Dashboard</span>
                </a>
            </div>
        </div>

        <!-- =========================
             TAX SUMMARY CARDS
             ========================= -->
        <div class="tax-summary-grid">

            <!-- GST OUTWARD -->
            <div class="tax-summary-card gst-outward tax-animate tax-delay-1">
                <div class="tax-card-top">
                    <div class="tax-card-label">
                        <span class="tax-card-icon blue">
                            <i class="fa-solid fa-arrow-right-to-bracket"></i>
                        </span>
                        GST Outward Sales
                    </div>

                    <span class="tax-card-status">
                        <i class="fa-solid fa-circle text-primary"></i>
                        Outward
                    </span>
                </div>

                <div class="tax-card-content">
                    <div class="tax-metric-row">
                        <span class="tax-metric-label">Taxable Sales</span>
                        <strong class="tax-metric-value">
                            ₹ @Model.TaxableSales.ToString("N2")
                        </strong>
                    </div>

                    <hr class="tax-divider" />

                    <div class="tax-total-row">
                        <span class="tax-total-label text-tax-success">
                            Total GST Liability
                        </span>

                        <strong class="tax-total-value text-tax-success">
                            ₹ @Model.TotalGSTCollected.ToString("N2")
                        </strong>
                    </div>
                </div>
            </div>

            <!-- GST INPUT TAX CREDIT -->
            <div class="tax-summary-card gst-input tax-animate tax-delay-2">
                <div class="tax-card-top">
                    <div class="tax-card-label">
                        <span class="tax-card-icon amber">
                            <i class="fa-solid fa-arrow-right-from-bracket"></i>
                        </span>
                        Input Tax Credit
                    </div>

                    <span class="tax-card-status">
                        <i class="fa-solid fa-circle text-warning"></i>
                        ITC
                    </span>
                </div>

                <div class="tax-card-content">
                    <div class="tax-metric-row">
                        <span class="tax-metric-label">Eligible Purchases</span>
                        <strong class="tax-metric-value">
                            ₹ @Model.TaxablePurchases.ToString("N2")
                        </strong>
                    </div>

                    <hr class="tax-divider" />

                    <div class="tax-total-row">
                        <span class="tax-total-label text-tax-primary">
                            Total ITC Available
                        </span>

                        <strong class="tax-total-value text-tax-primary">
                            ₹ @Model.TotalGSTPaid.ToString("N2")
                        </strong>
                    </div>
                </div>
            </div>

            <!-- NET PAYABLE -->
            <div class="tax-summary-card net-payable tax-animate tax-delay-3">
                <div class="tax-card-top">
                    <div class="tax-card-label">
                        <span class="tax-card-icon red">
                            <i class="fa-solid fa-scale-balanced"></i>
                        </span>
                        Net Tax Payable
                    </div>

                    <span class="tax-card-status">
                        <i class="fa-solid fa-circle text-danger"></i>
                        Due
                    </span>
                </div>

                <div class="tax-card-content">
                    <div class="tax-metric-row">
                        <span class="tax-metric-label">
                            Net GST (Outward - ITC)
                        </span>

                        <strong class="tax-metric-value">
                            ₹ @Model.NetGstPayable.ToString("N2")
                        </strong>
                    </div>

                    <div class="tax-metric-row">
                        <span class="tax-metric-label">
                            TDS Deducted (Form 26Q)
                        </span>

                        <strong class="tax-metric-value">
                            ₹ @Model.TdsDeducted.ToString("N2")
                        </strong>
                    </div>

                    <hr class="tax-divider" />

                    <div class="tax-total-row">
                        <span class="tax-total-label text-tax-danger">
                            Total Liability Due
                        </span>

                        <strong class="tax-total-value text-tax-danger">
                            ₹ @((Model.NetGstPayable + Model.TdsDeducted).ToString("N2"))
                        </strong>
                    </div>
                </div>
            </div>

        </div>

        <!-- =========================
             STATUTORY COMPLIANCE CALENDAR
             ========================= -->
        <div class="tax-section-card tax-animate">

            <div class="tax-section-header">
                <div class="tax-section-heading">
                    <span class="tax-section-heading-icon">
                        <i class="fa-solid fa-calendar-days"></i>
                    </span>

                    <div>
                        <h2>Statutory Compliance Calendar</h2>
                        <p>Track return filing dates, payment references and statutory status</p>
                    </div>
                </div>

                <span class="tax-period-pill">
                    <i class="fa-regular fa-calendar"></i>
                    @Model.Period
                </span>
            </div>

            <div class="tax-section-body">
                <div class="tax-table-wrap">
                    <table class="tax-table">
                        <thead>
                            <tr>
                                <th>Form Code</th>
                                <th>Filing Period</th>
                                <th>Due Date</th>
                                <th>Filing Date</th>
                                <th>Status</th>
                                <th>Payment Challan Reference</th>
                                <th class="text-center">Action</th>
                            </tr>
                        </thead>

                        <tbody>
                            @if (Model.FilingStatusList != null && Model.FilingStatusList.Any())
                            {
                                @foreach (var filing in Model.FilingStatusList)
                                {
                                    var isFiled = filing.Status == "Filed";
                                    var statusClass = isFiled ? "filed" : "pending";

                                    <tr>
                                        <td>
                                            <span class="tax-form-name">
                                                <span class="tax-form-icon">
                                                    <i class="fa-solid fa-file-invoice"></i>
                                                </span>
                                                @filing.FormName
                                            </span>
                                        </td>

                                        <td>
                                            <span class="tax-period-text">
                                                @filing.Period
                                            </span>
                                        </td>

                                        <td>
                                            <span class="tax-date">
                                                @filing.DueDate.ToString("dd-MMM-yyyy")
                                            </span>
                                        </td>

                                        <td>
                                            <span class="tax-date">
                                                @(filing.FilingDate?.ToString("dd-MMM-yyyy") ?? "-")
                                            </span>
                                        </td>

                                        <td>
                                            <span class="tax-status @statusClass">
                                                <i class="fa-solid fa-circle"></i>
                                                @filing.Status
                                            </span>
                                        </td>

                                        <td>
                                            <code class="tax-challan">
                                                @(string.IsNullOrEmpty(filing.PaymentChallanNo)
                                                                                        ? "N/A"
                                                                                        : filing.PaymentChallanNo)
                                    </code>
                                </td>

                                        <td class="text-center">
                                            <button type="button"
                                                    class="tax-download-btn"
                                                    onclick="downloadComputation('@filing.FormName')">
                                                <i class="fa-solid fa-download"></i>
                                                Download Computation
                                            </button>
                                        </td>
                                    </tr>
                                                        }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="7" class="tax-empty">
                                        <div class="tax-empty-icon">
                                            <i class="fa-solid fa-calendar-xmark"></i>
                                        </div>

                                        <p class="tax-empty-title">
                                            No filing records available
                                        </p>

                                        <p class="tax-empty-text">
                                            There are no statutory filing records for the selected period.
                                        </p>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- =========================
             OUTWARD + TDS DETAILS
             ========================= -->
        <div class="tax-details-grid">

            <!-- GST OUTWARD DETAILS -->
            <div class="tax-detail-card tax-animate tax-delay-1">

                <div class="tax-detail-header">
                    <span class="tax-detail-icon">
                        <i class="fa-solid fa-tags"></i>
                    </span>

                    <div>
                        <h3>GSTR-1 Outward Supply Summary</h3>
                        <span>HSN / tax slab wise outward supply overview</span>
                    </div>
                </div>

                <div class="tax-detail-body">
                    <div class="tax-detail-table-wrap">
                        <table class="tax-detail-table">
                            <thead>
                                <tr>
                                    <th>Category / Slab</th>
                                    <th class="text-end">Taxable Value</th>
                                    <th class="text-end">CGST (9%)</th>
                                    <th class="text-end">SGST (9%)</th>
                                </tr>
                            </thead>

                            <tbody>
                                <tr>
                                    <td>
                                        <span class="tax-category">
                                            GST 18% Standard Goods
                                        </span>
                                    </td>

                                    <td class="tax-number">
                                        ₹ 1,50,00,000
                                    </td>

                                    <td class="tax-number">
                                        ₹ 13,50,000
                                    </td>

                                    <td class="tax-number">
                                        ₹ 13,50,000
                                    </td>
                                </tr>

                                <tr>
                                    <td>
                                        <span class="tax-category">
                                            GST 18% Consulting Services
                                        </span>
                                    </td>

                                    <td class="tax-number">
                                        ₹ 35,00,000
                                    </td>

                                    <td class="tax-number">
                                        ₹ 3,15,000
                                    </td>

                                    <td class="tax-number">
                                        ₹ 3,15,000
                                    </td>
                                </tr>
                            </tbody>

                            <tfoot>
                                <tr>
                                    <td>Total Outward Details</td>

                                    <td class="tax-number">
                                        ₹ 1,85,00,000
                                    </td>

                                    <td class="tax-number">
                                        ₹ 16,65,000
                                    </td>

                                    <td class="tax-number">
                                        ₹ 16,65,000
                                    </td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>
            </div>

            <!-- TDS DETAILS -->
            <div class="tax-detail-card tax-animate tax-delay-2">

                <div class="tax-detail-header">
                    <span class="tax-detail-icon">
                        <i class="fa-solid fa-list-check"></i>
                    </span>

                    <div>
                        <h3>TDS Deduction Details</h3>
                        <span>Quarterly return — Form 26Q summary</span>
                    </div>
                </div>

                <div class="tax-detail-body">
                    <div class="tax-detail-table-wrap">
                        <table class="tax-detail-table">
                            <thead>
                                <tr>
                                    <th>Section Code</th>
                                    <th>Nature of Payment</th>
                                    <th class="text-end">Base Amount</th>
                                    <th class="text-end">TDS Deducted (10%)</th>
                                </tr>
                            </thead>

                            <tbody>
                                <tr>
                                    <td>
                                        <span class="tax-code-badge">
                                            Section 194C
                                        </span>
                                    </td>

                                    <td>
                                        <span class="tax-category">
                                            Contractor Payments
                                        </span>
                                    </td>

                                    <td class="tax-number">
                                        ₹ 12,00,000
                                    </td>

                                    <td class="tax-number">
                                        ₹ 1,20,000
                                    </td>
                                </tr>

                                <tr>
                                    <td>
                                        <span class="tax-code-badge">
                                            Section 194J
                                        </span>
                                    </td>

                                    <td>
                                        <span class="tax-category">
                                            Professional Fees
                                        </span>
                                    </td>

                                    <td class="tax-number">
                                        ₹ 12,00,000
                                    </td>

                                    <td class="tax-number">
                                        ₹ 1,20,000
                                    </td>
                                </tr>
                            </tbody>

                            <tfoot>
                                <tr>
                                    <td>Total TDS Deductions</td>

                                    <td>-</td>

                                    <td class="tax-number">
                                        ₹ 24,00,000
                                    </td>

                                    <td class="tax-number">
                                        ₹ 2,40,000
                                    </td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>
            </div>

        </div>

        <!-- =========================
             INFORMATION NOTE
             ========================= -->
        <div class="tax-footer-note">
            <i class="fa-solid fa-circle-info"></i>

            <div>
                <strong>Compliance overview:</strong>
                Review the statutory filing calendar regularly to ensure GST returns,
                TDS returns and associated payment challans are completed within their
                applicable filing periods.
            </div>
        </div>

    </div>
</div>

@section Scripts {
    <script>
        function downloadComputation(formName) {
            alert(`Generating statutory tax computation sheet for form ${formName} (@Model.Period). Download will start shortly.`);
        }
    </script>
}
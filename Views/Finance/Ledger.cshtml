@model List<ERP_System.Models.JournalEntryViewModel>
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "General Ledger & Journal Vouchers";
    var accounts = ViewBag.AccountHeads as List<ERP_System.Models.AccountHead> ?? new List<ERP_System.Models.AccountHead>();
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

<style>
    :root {
        --ledger-primary: #2563eb;
        --ledger-primary-dark: #1d4ed8;
        --ledger-text: #0f172a;
        --ledger-muted: #64748b;
        --ledger-border: #e2e8f0;
        --ledger-bg: #f8fafc;
        --ledger-card: #ffffff;
        --ledger-success: #059669;
        --ledger-danger: #dc2626;
        --ledger-warning: #d97706;
    }

    * {
        box-sizing: border-box;
    }

    .ledger-wrapper {
        min-height: 100vh;
        padding: 20px 0 40px;
        background: radial-gradient(circle at top right, rgba(37, 99, 235, 0.05), transparent 30%), linear-gradient(180deg, #f8fafc 0%, #f1f5f9 100%);
        font-family: "Segoe UI", system-ui, -apple-system, BlinkMacSystemFont, sans-serif;
        color: var(--ledger-text);
    }

    .ledger-container {
        max-width: 1800px;
        margin: 0 auto;
        padding: 0 24px;
    }

    /* =========================
           HEADER
           ========================= */

    .ledger-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        margin-bottom: 24px;
        animation: ledgerFadeUp .45s ease both;
    }

    .ledger-header-left {
        min-width: 0;
    }

    .ledger-eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        color: var(--ledger-primary);
        font-size: 12px;
        font-weight: 800;
        letter-spacing: .12em;
        text-transform: uppercase;
        margin-bottom: 7px;
    }

        .ledger-eyebrow::before {
            content: "";
            width: 24px;
            height: 3px;
            border-radius: 999px;
            background: var(--ledger-primary);
        }

    .ledger-title {
        margin: 0;
        font-size: clamp(24px, 2vw, 32px);
        line-height: 1.15;
        font-weight: 800;
        letter-spacing: -.025em;
        color: #0f172a;
    }

    .ledger-subtitle {
        margin: 7px 0 0;
        color: var(--ledger-muted);
        font-size: 14px;
    }

    .ledger-header-actions {
        display: flex;
        align-items: center;
        gap: 10px;
        flex-shrink: 0;
    }

    .ledger-btn {
        min-height: 42px;
        border-radius: 10px !important;
        padding: 9px 15px !important;
        font-size: 13px !important;
        font-weight: 700 !important;
        display: inline-flex !important;
        align-items: center;
        justify-content: center;
        gap: 7px;
        transition: all .22s ease;
        border-width: 1px !important;
    }

    .ledger-btn-primary {
        background: var(--ledger-primary);
        border-color: var(--ledger-primary);
        color: #fff;
        box-shadow: 0 7px 18px rgba(37, 99, 235, .16);
    }

        .ledger-btn-primary:hover {
            background: var(--ledger-primary-dark);
            border-color: var(--ledger-primary-dark);
            color: #fff;
            transform: translateY(-1px);
            box-shadow: 0 10px 22px rgba(37, 99, 235, .22);
        }

    .ledger-btn-secondary {
        background: #fff;
        border-color: var(--ledger-border);
        color: #334155;
    }

        .ledger-btn-secondary:hover {
            background: #f8fafc;
            border-color: #cbd5e1;
            color: #0f172a;
            transform: translateY(-1px);
        }

    /* =========================
           SUMMARY CARDS
           ========================= */

    .ledger-summary-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 16px;
        margin-bottom: 22px;
    }

    .ledger-summary-card {
        position: relative;
        overflow: hidden;
        background: var(--ledger-card);
        border: 1px solid rgba(226, 232, 240, .95);
        border-radius: 16px;
        padding: 18px;
        box-shadow: 0 8px 26px rgba(15, 23, 42, .045);
        animation: ledgerFadeUp .5s ease both;
    }

        .ledger-summary-card:nth-child(2) {
            animation-delay: .05s;
        }

        .ledger-summary-card:nth-child(3) {
            animation-delay: .1s;
        }

        .ledger-summary-card:nth-child(4) {
            animation-delay: .15s;
        }

        .ledger-summary-card::after {
            content: "";
            position: absolute;
            right: -28px;
            bottom: -32px;
            width: 100px;
            height: 100px;
            border-radius: 50%;
            background: rgba(37, 99, 235, .045);
        }

    .ledger-summary-top {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
    }

    .ledger-summary-label {
        color: var(--ledger-muted);
        font-size: 12px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .05em;
    }

    .ledger-summary-value {
        margin-top: 7px;
        color: #0f172a;
        font-size: 25px;
        line-height: 1;
        font-weight: 800;
    }

    .ledger-summary-icon {
        width: 42px;
        height: 42px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #eff6ff;
        color: var(--ledger-primary);
        font-size: 17px;
        flex-shrink: 0;
    }

    .ledger-summary-card:nth-child(2) .ledger-summary-icon {
        background: #ecfdf5;
        color: var(--ledger-success);
    }

    .ledger-summary-card:nth-child(3) .ledger-summary-icon {
        background: #fff7ed;
        color: var(--ledger-warning);
    }

    .ledger-summary-card:nth-child(4) .ledger-summary-icon {
        background: #fef2f2;
        color: var(--ledger-danger);
    }

    .ledger-summary-footer {
        margin-top: 13px;
        color: #94a3b8;
        font-size: 12px;
    }

    /* =========================
           MAIN LAYOUT
           ========================= */

    .ledger-main-grid {
        display: grid;
        grid-template-columns: minmax(300px, .85fr) minmax(0, 1.75fr);
        gap: 20px;
        align-items: start;
    }

    .ledger-card {
        background: var(--ledger-card);
        border: 1px solid rgba(226, 232, 240, .95);
        border-radius: 17px;
        box-shadow: 0 8px 28px rgba(15, 23, 42, .045);
        overflow: hidden;
        animation: ledgerFadeUp .55s ease both;
    }

    .ledger-card-header {
        padding: 18px 20px;
        border-bottom: 1px solid #edf2f7;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 15px;
    }

    .ledger-card-title-wrap {
        min-width: 0;
    }

    .ledger-card-title {
        display: flex;
        align-items: center;
        gap: 9px;
        margin: 0;
        font-size: 16px;
        font-weight: 800;
        color: #0f172a;
    }

        .ledger-card-title i {
            color: var(--ledger-primary);
            font-size: 15px;
        }

    .ledger-card-description {
        margin: 5px 0 0 24px;
        color: #94a3b8;
        font-size: 12px;
    }

    .ledger-record-count {
        padding: 5px 9px;
        border-radius: 8px;
        background: #f1f5f9;
        color: #475569;
        font-size: 11px;
        font-weight: 800;
        white-space: nowrap;
    }

    /* =========================
           CHART OF ACCOUNTS
           ========================= */

    .accounts-body {
        padding: 15px 16px 18px;
    }

    .account-group {
        margin-bottom: 12px;
    }

        .account-group:last-child {
            margin-bottom: 0;
        }

    .account-group-header {
        min-height: 43px;
        padding: 9px 11px;
        border: 1px solid #e8edf3;
        border-radius: 11px;
        background: #f8fafc;
        color: #334155;
        font-size: 13px;
        font-weight: 800;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        transition: all .2s ease;
    }

        .account-group-header:hover {
            background: #f1f5f9;
            border-color: #dbe3ec;
        }

    .account-group-name {
        display: flex;
        align-items: center;
        gap: 8px;
        min-width: 0;
    }

        .account-group-name i {
            color: #64748b;
            font-size: 12px;
        }

    .account-group-count {
        min-width: 25px;
        height: 25px;
        padding: 0 7px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 7px;
        background: #e2e8f0;
        color: #475569;
        font-size: 11px;
        font-weight: 800;
    }

    .account-list {
        margin: 6px 0 0 10px;
        border-left: 1px dashed #dbe3ec;
    }

    .account-item {
        min-height: 40px;
        padding: 7px 9px 7px 13px;
        border-bottom: 1px solid #f1f5f9;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        font-size: 12px;
        color: #334155;
        transition: background .2s ease;
    }

        .account-item:last-child {
            border-bottom: 0;
        }

        .account-item:hover {
            background: #f8fafc;
        }

    .account-name-wrap {
        min-width: 0;
        display: flex;
        align-items: center;
        gap: 7px;
    }

    .account-code {
        padding: 3px 6px;
        border-radius: 5px;
        background: #f1f5f9;
        color: #64748b;
        font-size: 10px;
        font-weight: 800;
        white-space: nowrap;
    }

    .account-name {
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .account-active {
        color: var(--ledger-success);
        font-size: 10px;
        flex-shrink: 0;
    }

    .accounts-empty {
        padding: 35px 15px;
        text-align: center;
        color: #94a3b8;
    }

        .accounts-empty i {
            font-size: 28px;
            margin-bottom: 10px;
        }

    /* =========================
           JOURNAL TABLE
           ========================= */

    .ledger-table-wrap {
        overflow-x: auto;
    }

    .ledger-table {
        min-width: 930px;
        margin: 0 !important;
        border-collapse: separate;
        border-spacing: 0;
    }

        .ledger-table thead th {
            background: #f8fafc !important;
            color: #64748b !important;
            border-bottom: 1px solid #e2e8f0 !important;
            padding: 12px 14px !important;
            font-size: 10px !important;
            font-weight: 800 !important;
            letter-spacing: .06em;
            text-transform: uppercase;
            white-space: nowrap;
        }

        .ledger-table tbody td {
            padding: 14px !important;
            border-bottom: 1px solid #eef2f7 !important;
            color: #475569;
            font-size: 12px;
            vertical-align: middle;
        }

        .ledger-table tbody tr {
            transition: background .2s ease, transform .2s ease;
        }

            .ledger-table tbody tr:hover {
                background: #f8fbff;
            }

    .ledger-date {
        color: #475569;
        font-weight: 600;
        white-space: nowrap;
    }

    .journal-number {
        display: inline-flex;
        align-items: center;
        padding: 6px 8px;
        border-radius: 7px;
        background: #eff6ff;
        color: var(--ledger-primary);
        font-size: 11px;
        font-weight: 800;
        white-space: nowrap;
    }

    .reference-text {
        color: #475569;
        font-weight: 600;
        max-width: 145px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .account-cell {
        min-width: 145px;
    }

    .account-cell-name {
        color: #1e293b;
        font-weight: 700;
        line-height: 1.3;
    }

    .account-cell-code {
        display: block;
        margin-top: 3px;
        color: #94a3b8;
        font-size: 10px;
        font-weight: 700;
    }

    .amount-debit {
        color: #b45309;
        font-weight: 800;
        white-space: nowrap;
    }

    .amount-credit {
        color: #047857;
        font-weight: 800;
        white-space: nowrap;
    }

    .amount-empty {
        color: #cbd5e1;
    }

    .ledger-status {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 5px 8px;
        border-radius: 7px;
        background: #ecfdf5;
        color: #047857;
        font-size: 10px;
        font-weight: 800;
        white-space: nowrap;
    }

        .ledger-status i {
            font-size: 8px;
        }

    .ledger-empty {
        padding: 60px 20px !important;
        text-align: center;
    }

    .ledger-empty-icon {
        width: 58px;
        height: 58px;
        margin: 0 auto 12px;
        border-radius: 16px;
        background: #f1f5f9;
        color: #94a3b8;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 22px;
    }

    .ledger-empty-title {
        color: #334155;
        font-weight: 800;
        font-size: 14px;
    }

    .ledger-empty-text {
        margin-top: 4px;
        color: #94a3b8;
        font-size: 12px;
    }

    /* =========================
           JOURNAL MODAL
           ========================= */

    #newJvModal .modal-dialog {
        max-width: 1050px;
        margin: 1.25rem auto;
    }

    #newJvModal .modal-content {
        border: 0;
        border-radius: 18px;
        overflow: hidden;
        box-shadow: 0 25px 70px rgba(15, 23, 42, .2);
    }

    #newJvModal .modal-header {
        padding: 18px 22px;
        background: linear-gradient(135deg, #ffffff 0%, #f8fbff 100%);
        border-bottom: 1px solid #e8edf3;
    }

    #newJvModal .modal-title {
        display: flex;
        align-items: center;
        gap: 9px;
        color: #0f172a;
        font-size: 17px;
    }

        #newJvModal .modal-title i {
            color: var(--ledger-primary);
        }

    #newJvModal .modal-body {
        padding: 22px;
        background: #fff;
        max-height: 72vh;
        overflow-y: auto;
    }

    #newJvModal .modal-footer {
        padding: 15px 22px;
        background: #f8fafc;
        border-top: 1px solid #e8edf3;
    }

    .jv-form-section {
        padding: 16px;
        margin-bottom: 18px;
        border: 1px solid #e6ebf1;
        border-radius: 13px;
        background: #fbfdff;
    }

    .jv-section-title {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 14px;
        color: #334155;
        font-size: 12px;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: .05em;
    }

        .jv-section-title i {
            color: var(--ledger-primary);
        }

    .jv-field-label {
        display: block;
        margin-bottom: 6px;
        color: #475569;
        font-size: 11px;
        font-weight: 800;
    }

    #newJvModal .form-control,
    #newJvModal .form-select {
        min-height: 42px;
        border: 1px solid #dbe3ec;
        border-radius: 9px;
        color: #334155;
        font-size: 12px;
        box-shadow: none;
        transition: border-color .2s ease, box-shadow .2s ease;
    }

    #newJvModal textarea.form-control {
        min-height: auto;
        resize: vertical;
    }

    #newJvModal .form-control:focus,
    #newJvModal .form-select:focus {
        border-color: #93c5fd;
        box-shadow: 0 0 0 3px rgba(37, 99, 235, .09);
    }

    .jv-lines-card {
        border: 1px solid #e2e8f0;
        border-radius: 13px;
        overflow: hidden;
        background: #fff;
    }

    .jv-lines-scroll {
        overflow-x: auto;
    }

    #jvLinesTable {
        min-width: 720px;
        margin: 0;
    }

        #jvLinesTable thead th {
            padding: 11px 12px;
            background: #f8fafc;
            color: #64748b;
            border-bottom: 1px solid #e2e8f0;
            font-size: 10px;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: .05em;
            white-space: nowrap;
        }

        #jvLinesTable tbody td {
            padding: 10px 12px;
            border-bottom: 1px solid #eef2f7;
            vertical-align: middle;
        }

        #jvLinesTable tbody tr:last-child td {
            border-bottom: 0;
        }

    .jv-line-row {
        transition: background .2s ease;
    }

        .jv-line-row:hover {
            background: #fbfdff;
        }

    .jv-add-row {
        margin-top: 12px;
        border-radius: 9px;
        font-size: 11px;
        font-weight: 800;
    }

    .jv-remove-btn {
        width: 34px;
        height: 34px;
        padding: 0 !important;
        border-radius: 8px !important;
        display: inline-flex !important;
        align-items: center;
        justify-content: center;
    }

    .balance-panel {
        margin-top: 15px;
        padding: 14px 16px;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        background: #f8fafc;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 15px;
    }

    .balance-totals {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 18px;
    }

    .balance-item {
        display: flex;
        align-items: center;
        gap: 6px;
        color: #64748b;
        font-size: 11px;
    }

        .balance-item strong {
            color: #1e293b;
            font-size: 12px;
        }

    .balance-status {
        min-width: 95px;
        padding: 7px 11px;
        border-radius: 8px;
        text-align: center;
        font-size: 10px;
        font-weight: 800;
    }

    .balance-unbalanced {
        background: #fef2f2;
        color: #b91c1c;
    }

    .balance-balanced {
        background: #ecfdf5;
        color: #047857;
    }

    /* =========================
           MODAL FOOTER BUTTONS
           ========================= */

    #newJvModal .modal-footer .btn {
        min-height: 40px;
        border-radius: 9px;
        padding: 8px 14px;
        font-size: 12px;
        font-weight: 700;
    }

    /* =========================
           ANIMATIONS
           ========================= */

    @@keyframes ledgerFadeUp {
        from

    {
        opacity: 0;
        transform: translateY(10px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }

    }

    /* =========================
           RESPONSIVE
           ========================= */

    @@media (max-width: 1200px) {
        .ledger-summary-grid

    {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .ledger-main-grid {
        grid-template-columns: 1fr;
    }

    .accounts-body {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 10px;
    }

    .account-group {
        margin-bottom: 0;
    }

    }

    @@media (max-width: 900px) {
        .ledger-header

    {
        align-items: flex-start;
        flex-direction: column;
    }

    .ledger-header-actions {
        width: 100%;
    }

        .ledger-header-actions .ledger-btn {
            flex: 1;
        }

    }

    @@media (max-width: 768px) {
        .ledger-wrapper

    {
        padding: 14px 0 30px;
    }

    .ledger-container {
        padding: 0 14px;
    }

    .ledger-summary-grid {
        grid-template-columns: 1fr 1fr;
        gap: 10px;
    }

    .ledger-summary-card {
        padding: 14px;
        border-radius: 13px;
    }

    .ledger-summary-icon {
        width: 36px;
        height: 36px;
        border-radius: 9px;
        font-size: 14px;
    }

    .ledger-summary-value {
        font-size: 20px;
    }

    .ledger-summary-footer {
        font-size: 10px;
    }

    .accounts-body {
        grid-template-columns: 1fr;
    }

    .ledger-card-header {
        padding: 15px;
    }

    .ledger-card-description {
        display: none;
    }

    .ledger-table-wrap {
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
    }

    #newJvModal .modal-dialog {
        margin: .5rem;
    }

    #newJvModal .modal-body {
        padding: 15px;
        max-height: 78vh;
    }

    #newJvModal .modal-header {
        padding: 15px;
    }

    #newJvModal .modal-footer {
        padding: 12px 15px;
    }

    .jv-form-section {
        padding: 13px;
    }

    .balance-panel {
        align-items: stretch;
        flex-direction: column;
    }

    .balance-totals {
        justify-content: space-between;
    }

    .balance-status {
        width: 100%;
    }

    }

    @@media (max-width: 576px) {
        .ledger-title

    {
        font-size: 23px;
    }

    .ledger-subtitle {
        font-size: 12px;
    }

    .ledger-header-actions {
        flex-direction: column;
    }

        .ledger-header-actions .ledger-btn {
            width: 100%;
        }

    .ledger-summary-grid {
        grid-template-columns: 1fr;
    }

    .ledger-summary-card {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
    }

    .ledger-summary-top {
        flex: 1;
    }

    .ledger-summary-footer {
        display: none;
    }

    .ledger-summary-icon {
        order: 2;
    }

    .ledger-summary-card::after {
        display: none;
    }

    .account-item {
        font-size: 11px;
    }

    .account-name-wrap {
        max-width: calc(100% - 25px);
    }

    .account-code {
        font-size: 9px;
    }

    .balance-totals {
        flex-direction: column;
        align-items: flex-start;
        gap: 7px;
    }

    #newJvModal .modal-footer {
        flex-direction: column;
    }

        #newJvModal .modal-footer .btn {
            width: 100%;
        }

    }

    @@media (prefers-reduced-motion: reduce) {
        .ledger-summary-card, .ledger-card, .ledger-header

    {
        animation: none;
    }

    * {
        scroll-behavior: auto !important;
        transition: none !important;
    }

    }

    /* =========================
           PRINT
           ========================= */

    @@media print {
        .ledger-wrapper

    {
        background: #fff !important;
        padding: 0 !important;
    }

    .ledger-header-actions,
    .ledger-summary-grid,
    .modal,
    .modal-backdrop {
        display: none !important;
    }

    .ledger-main-grid {
        display: block;
    }

    .ledger-card {
        box-shadow: none !important;
        border: 1px solid #ddd !important;
        margin-bottom: 15px;
    }

    .accounts-body {
        display: block;
    }

    .ledger-table {
        min-width: 0;
    }

    }
</style>

<div class="ledger-wrapper">
    <div class="ledger-container">

        <!-- =========================
             HEADER
             ========================= -->
        <div class="ledger-header">
            <div class="ledger-header-left">
                <div class="ledger-eyebrow">
                    General Ledger
                </div>

                <h1 class="ledger-title">
                    Journal Vouchers & Ledger
                </h1>

                <p class="ledger-subtitle">
                    Manage double-entry accounting records, account heads and journal postings.
                </p>
            </div>

            <div class="ledger-header-actions">
                <button type="button"
                        class="btn ledger-btn ledger-btn-primary"
                        data-bs-toggle="modal"
                        data-bs-target="#newJvModal">
                    <i class="fa-solid fa-plus"></i>
                    <span>New Journal Voucher</span>
                </button>

                <a asp-action="Index"
                   class="btn ledger-btn ledger-btn-secondary">
                    <i class="fa-solid fa-arrow-left"></i>
                    <span>Back to Dashboard</span>
                </a>
            </div>
        </div>

        <!-- =========================
             SUMMARY
             ========================= -->
        <div class="ledger-summary-grid">

            <div class="ledger-summary-card">
                <div class="ledger-summary-top">
                    <div>
                        <div class="ledger-summary-label">Journal Records</div>
                        <div class="ledger-summary-value">@Model.Count</div>
                    </div>

                    <div class="ledger-summary-icon">
                        <i class="fa-solid fa-book"></i>
                    </div>
                </div>

                <div class="ledger-summary-footer">
                    Total journal ledger entries
                </div>
            </div>

            <div class="ledger-summary-card">
                <div class="ledger-summary-top">
                    <div>
                        <div class="ledger-summary-label">Account Heads</div>
                        <div class="ledger-summary-value">@accounts.Count</div>
                    </div>

                    <div class="ledger-summary-icon">
                        <i class="fa-solid fa-layer-group"></i>
                    </div>
                </div>

                <div class="ledger-summary-footer">
                    Available chart of accounts
                </div>
            </div>

            <div class="ledger-summary-card">
                <div class="ledger-summary-top">
                    <div>
                        <div class="ledger-summary-label">Debit Entries</div>
                        <div class="ledger-summary-value">
                            @Model.Count(x => x.Debit > 0)
                        </div>
                    </div>

                    <div class="ledger-summary-icon">
                        <i class="fa-solid fa-arrow-down"></i>
                    </div>
                </div>

                <div class="ledger-summary-footer">
                    Posted debit-side records
                </div>
            </div>

            <div class="ledger-summary-card">
                <div class="ledger-summary-top">
                    <div>
                        <div class="ledger-summary-label">Credit Entries</div>
                        <div class="ledger-summary-value">
                            @Model.Count(x => x.Credit > 0)
                        </div>
                    </div>

                    <div class="ledger-summary-icon">
                        <i class="fa-solid fa-arrow-up"></i>
                    </div>
                </div>

                <div class="ledger-summary-footer">
                    Posted credit-side records
                </div>
            </div>

        </div>

        <!-- =========================
             MAIN CONTENT
             ========================= -->
        <div class="ledger-main-grid">

            <!-- =========================
                 CHART OF ACCOUNTS
                 ========================= -->
            <div class="ledger-card">

                <div class="ledger-card-header">
                    <div class="ledger-card-title-wrap">
                        <h5 class="ledger-card-title">
                            <i class="fa-solid fa-folder-tree"></i>
                            Chart of Accounts
                        </h5>

                        <div class="ledger-card-description">
                            Account heads grouped by accounting type.
                        </div>
                    </div>

                    <span class="ledger-record-count">
                        @accounts.Count Accounts
                    </span>
                </div>

                <div class="accounts-body">

                    @foreach (var type in new[] { "Asset", "Liability", "Equity", "Revenue", "Expense" })
                    {
                        var groupAccounts = accounts
                        .Where(a => a.AccountType == type)
                        .ToList();

                        <div class="account-group">

                            <div class="account-group-header">

                                <div class="account-group-name">
                                    @if (type == "Asset")
                                    {
                                        <i class="fa-solid fa-building-columns"></i>
                                    }
                                    else if (type == "Liability")
                                    {
                                        <i class="fa-solid fa-scale-balanced"></i>
                                    }
                                    else if (type == "Equity")
                                    {
                                        <i class="fa-solid fa-chart-pie"></i>
                                    }
                                    else if (type == "Revenue")
                                    {
                                        <i class="fa-solid fa-arrow-trend-up"></i>
                                    }
                                    else
                                    {
                                        <i class="fa-solid fa-arrow-trend-down"></i>
                                    }

                                    <span>@typesPlural(type)</span>
                                </div>

                                <span class="account-group-count">
                                    @groupAccounts.Count
                                </span>

                            </div>

                            @if (groupAccounts.Any())
                            {
                                <div class="account-list">

                                    @foreach (var acc in groupAccounts)
                                    {
                                        <div class="account-item">

                                            <div class="account-name-wrap">

                                                <span class="account-code">
                                                    @acc.HeadCode
                                                </span>

                                                <span class="account-name"
                                                      title="@acc.HeadName">
                                                    @acc.HeadName
                                                </span>

                                            </div>

                                            <i class="fa-solid fa-circle-check account-active"
                                               title="Active account"></i>

                                        </div>
                                    }

                                </div>
                            }
                            else
                            {
                                <div class="account-list">
                                    <div class="account-item">
                                        <span class="text-secondary small">
                                            No accounts available
                                        </span>
                                    </div>
                                </div>
                            }

                        </div>
                    }

                </div>

            </div>

            <!-- =========================
                 JOURNAL LEDGER
                 ========================= -->
            <div class="ledger-card">

                <div class="ledger-card-header">

                    <div class="ledger-card-title-wrap">
                        <h5 class="ledger-card-title">
                            <i class="fa-solid fa-clock-rotate-left"></i>
                            Audit Trail & Journal Ledger
                        </h5>

                        <div class="ledger-card-description">
                            Complete record of posted double-entry transactions.
                        </div>
                    </div>

                    <span class="ledger-record-count">
                        @Model.Count Records
                    </span>

                </div>

                <div class="ledger-table-wrap">

                    <table class="table align-middle ledger-table">

                        <thead>
                            <tr>
                                <th>Posting Date</th>
                                <th>Journal No</th>
                                <th>Reference</th>
                                <th>Account Name</th>
                                <th>Debit</th>
                                <th>Credit</th>
                                <th>Status</th>
                            </tr>
                        </thead>

                        <tbody>

                            @if (Model.Any())
                            {
                                @foreach (var jv in Model)
                                {
                                    <tr>

                                        <td>
                                            <span class="ledger-date">
                                                @jv.PostingDate.ToString("dd-MMM-yyyy")
                                            </span>
                                        </td>

                                        <td>
                                            <span class="journal-number">
                                                @jv.JournalNo
                                            </span>
                                        </td>

                                        <td>
                                            <span class="reference-text"
                                                  title="@jv.Reference">
                                                @jv.Reference
                                            </span>
                                        </td>

                                        <td class="account-cell">

                                            <div class="account-cell-name">
                                                @jv.AccountName
                                            </div>

                                            <span class="account-cell-code">
                                                @jv.AccountCode
                                            </span>

                                        </td>

                                        <td>
                                            @if (jv.Debit > 0)
                                            {
                                                <span class="amount-debit">
                                                    ₹ @jv.Debit.ToString("N2")
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="amount-empty">—</span>
                                            }
                                        </td>

                                        <td>
                                            @if (jv.Credit > 0)
                                            {
                                                <span class="amount-credit">
                                                    ₹ @jv.Credit.ToString("N2")
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="amount-empty">—</span>
                                            }
                                        </td>

                                        <td>
                                            <span class="ledger-status">
                                                <i class="fa-solid fa-circle-check"></i>
                                                @jv.Status
                                            </span>
                                        </td>

                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="7" class="ledger-empty">

                                        <div class="ledger-empty-icon">
                                            <i class="fa-solid fa-book-open"></i>
                                        </div>

                                        <div class="ledger-empty-title">
                                            No journal records found
                                        </div>

                                        <div class="ledger-empty-text">
                                            Posted journal entries will appear here.
                                        </div>

                                    </td>
                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

            </div>

        </div>

    </div>
</div>

<!-- =========================
     NEW JOURNAL VOUCHER MODAL
     ========================= -->

<div class="modal fade"
     id="newJvModal"
     tabindex="-1"
     aria-labelledby="newJvModalLabel"
     aria-hidden="true">

    <div class="modal-dialog modal-lg modal-dialog-centered">

        <div class="modal-content">

            <div class="modal-header">

                <h5 class="modal-title fw-bold" id="newJvModalLabel">
                    <i class="fa-solid fa-pen-nib"></i>
                    Record Double-Entry Journal Voucher
                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Close">
                </button>

            </div>

            <div class="modal-body">

                <form id="jvForm">

                    <!-- BASIC DETAILS -->
                    <div class="jv-form-section">

                        <div class="jv-section-title">
                            <i class="fa-solid fa-circle-info"></i>
                            Voucher Information
                        </div>

                        <div class="row g-3">

                            <div class="col-md-6">

                                <label class="jv-field-label">
                                    Posting Date
                                </label>

                                <input type="date"
                                       id="jvDate"
                                       class="form-control"
                                       value="@DateTime.Today.ToString("yyyy-MM-dd")"
                                       required />

                            </div>

                            <div class="col-md-6">

                                <label class="jv-field-label">
                                    Reference Document ID
                                </label>

                                <input type="text"
                                       id="jvRef"
                                       class="form-control"
                                       placeholder="e.g. INVRef-12001"
                                       required />

                            </div>

                            <div class="col-12">

                                <label class="jv-field-label">
                                    Journal Description
                                </label>

                                <textarea id="jvDesc"
                                          class="form-control"
                                          rows="3"
                                          placeholder="Describe the purpose of this adjustment entry..."
                                          required></textarea>

                            </div>

                        </div>

                    </div>

                    <!-- JOURNAL LINES -->
                    <div class="jv-section-title">
                        <i class="fa-solid fa-list"></i>
                        Debit & Credit Ledger Lines
                    </div>

                    <div class="jv-lines-card">

                        <div class="jv-lines-scroll">

                            <table class="table align-middle"
                                   id="jvLinesTable">

                                <thead>

                                    <tr>
                                        <th>Ledger Account Head</th>
                                        <th width="180">Debit Amount (₹)</th>
                                        <th width="180">Credit Amount (₹)</th>
                                        <th width="50"></th>
                                    </tr>

                                </thead>

                                <tbody>

                                    <!-- FIRST LINE -->
                                    <tr class="jv-line-row">

                                        <td>

                                            <select class="form-select account-select">

                                                @foreach (var acc in accounts)
                                                {
                                                    <option value="@acc.AccountHeadId">
                                                        @acc.HeadCode • @acc.HeadName
                                                    </option>
                                                }

                                            </select>

                                        </td>

                                        <td>

                                            <input type="number"
                                                   class="form-control debit-input"
                                                   value="0.00"
                                                   step="0.01"
                                                   min="0"
                                                   oninput="calculateBalance()" />

                                        </td>

                                        <td>

                                            <input type="number"
                                                   class="form-control credit-input"
                                                   value="0.00"
                                                   step="0.01"
                                                   min="0"
                                                   oninput="calculateBalance()" />

                                        </td>

                                        <td></td>

                                    </tr>

                                    <!-- SECOND LINE -->
                                    <tr class="jv-line-row">

                                        <td>

                                            <select class="form-select account-select">

                                                @foreach (var acc in accounts)
                                                {
                                                    <option value="@acc.AccountHeadId">
                                                        @acc.HeadCode • @acc.HeadName
                                                    </option>
                                                }

                                            </select>

                                        </td>

                                        <td>

                                            <input type="number"
                                                   class="form-control debit-input"
                                                   value="0.00"
                                                   step="0.01"
                                                   min="0"
                                                   oninput="calculateBalance()" />

                                        </td>

                                        <td>

                                            <input type="number"
                                                   class="form-control credit-input"
                                                   value="0.00"
                                                   step="0.01"
                                                   min="0"
                                                   oninput="calculateBalance()" />

                                        </td>

                                        <td></td>

                                    </tr>

                                </tbody>

                            </table>

                        </div>

                    </div>

                    <button type="button"
                            class="btn btn-outline-primary btn-sm jv-add-row"
                            onclick="addJvRow()">

                        <i class="fa-solid fa-plus me-1"></i>
                        Add Entry Row

                    </button>

                    <!-- BALANCE PANEL -->
                    <div class="balance-panel">

                        <div class="balance-totals">

                            <div class="balance-item">
                                <span>Total Debits:</span>
                                <strong id="lblTotalDebit">₹ 0.00</strong>
                            </div>

                            <div class="balance-item">
                                <span>Total Credits:</span>
                                <strong id="lblTotalCredit">₹ 0.00</strong>
                            </div>

                        </div>

                        <span class="balance-status balance-unbalanced"
                              id="lblBalanceStatus">
                            Unbalanced
                        </span>

                    </div>

                </form>

            </div>

            <div class="modal-footer">

                <button type="button"
                        class="btn btn-outline-secondary"
                        data-bs-dismiss="modal">
                    Cancel
                </button>

                <button type="button"
                        class="btn btn-primary"
                        onclick="postJournalVoucher()">
                    <i class="fa-solid fa-paper-plane me-1"></i>
                    Post Journal Entry
                </button>

            </div>

        </div>

    </div>

</div>

@functions {
    string typesPlural(string type)
    {
        switch (type)
        {
            case "Asset":
                return "Assets";

            case "Liability":
                return "Liabilities";

            case "Equity":
                return "Equity";

            case "Revenue":
                return "Revenue Accounts";

            case "Expense":
                return "Expenses";

            default:
                return type;
        }
    }
}

@section Scripts {

    <script>

        /* =========================
           ADD JOURNAL ROW
           ========================= */

        function addJvRow() {

            const firstRowSelect = $('.account-select').first().html();

            const newRow = `
                <tr class="jv-line-row">

                    <td>
                        <select class="form-select account-select">
                            ${firstRowSelect}
                        </select>
                    </td>

                    <td>
                        <input type="number"
                               class="form-control debit-input"
                               value="0.00"
                               step="0.01"
                               min="0"
                               oninput="calculateBalance()" />
                    </td>

                    <td>
                        <input type="number"
                               class="form-control credit-input"
                               value="0.00"
                               step="0.01"
                               min="0"
                               oninput="calculateBalance()" />
                    </td>

                    <td>
                        <button type="button"
                                class="btn btn-outline-danger btn-sm jv-remove-btn"
                                onclick="$(this).closest('tr').remove(); calculateBalance();">

                            <i class="fa-solid fa-trash"></i>

                        </button>
                    </td>

                </tr>
            `;

            $('#jvLinesTable tbody').append(newRow);

            calculateBalance();
        }


        /* =========================
           CALCULATE BALANCE
           ========================= */

        function calculateBalance() {

            let totalDebit = 0;
            let totalCredit = 0;

            $('.debit-input').each(function () {

                totalDebit += parseFloat($(this).val()) || 0;

            });

            $('.credit-input').each(function () {

                totalCredit += parseFloat($(this).val()) || 0;

            });

            $('#lblTotalDebit')
                .text('₹ ' + totalDebit.toFixed(2));

            $('#lblTotalCredit')
                .text('₹ ' + totalCredit.toFixed(2));

            const balanceIndicator = $('#lblBalanceStatus');

            const isBalanced =
                totalDebit === totalCredit &&
                totalDebit > 0;

            if (isBalanced) {

                balanceIndicator
                    .text("Balanced")
                    .removeClass("balance-unbalanced")
                    .addClass("balance-balanced");

            }
            else {

                balanceIndicator
                    .text("Unbalanced")
                    .removeClass("balance-balanced")
                    .addClass("balance-unbalanced");

            }
        }


        /* =========================
           POST JOURNAL VOUCHER
           ========================= */

        function postJournalVoucher() {

            let totalDebit = 0;
            let totalCredit = 0;

            const lines = [];

            $('.jv-line-row').each(function () {

                const accId =
                    parseInt($(this).find('.account-select').val());

                const debVal =
                    parseFloat($(this).find('.debit-input').val()) || 0;

                const credVal =
                    parseFloat($(this).find('.credit-input').val()) || 0;

                totalDebit += debVal;
                totalCredit += credVal;

                if (debVal > 0 || credVal > 0) {

                    lines.push({
                        accountHeadId: accId,
                        debit: debVal,
                        credit: credVal
                    });

                }

            });


            if (lines.length < 2) {

                alert("A journal entry requires at least two account lines.");

                return;
            }


            if (totalDebit !== totalCredit || totalDebit === 0) {

                alert("Debits and credits must balance and be greater than 0 before posting.");

                return;
            }


            const data = {

                postingDate: $('#jvDate').val(),

                reference: $('#jvRef').val(),

                description: $('#jvDesc').val(),

                lines: lines

            };


            $.ajax({

                url: '@Url.Action("PostJournalEntry", "Finance")',

                type: 'POST',

                contentType: 'application/json',

                data: JSON.stringify(data),

                success: function (res) {

                    if (res.success) {

                        alert(res.message);

                        $('#newJvModal').modal('hide');

                        location.reload();

                    }
                    else {

                        alert("Error: " + res.message);

                    }

                },

                error: function () {

                    alert("An error occurred while posting the journal entry.");

                }

            });

        }


        /* =========================
           INITIAL BALANCE
           ========================= */

        $(document).ready(function () {

            calculateBalance();

        });

    </script>
}
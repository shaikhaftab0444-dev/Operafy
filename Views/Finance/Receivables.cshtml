    /* =========================================================
           REDUCED MOTION
           ========================================================= */

    @@media (prefers-reduced-motion: reduce) {
        .ar-page-header, .ar-summary-grid, .ar-toolbar-card, .ar-table-card

    {
        animation: none !important;
    }


@model List<ERP_System.Models.ReceivableInvoiceViewModel>
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Accounts Receivable";
    string currentFilter = ViewBag.AgingFilter ?? "All";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

<style>
    /* =========================================================
           ACCOUNTS RECEIVABLE - PREMIUM ERP UI
           ========================================================= */

    :root {
        --ar-primary: #2563eb;
        --ar-primary-dark: #1d4ed8;
        --ar-primary-soft: #eff6ff;
        --ar-success: #059669;
        --ar-success-soft: #ecfdf5;
        --ar-warning: #d97706;
        --ar-warning-soft: #fffbeb;
        --ar-danger: #dc2626;
        --ar-danger-soft: #fef2f2;
        --ar-info: #0891b2;
        --ar-info-soft: #ecfeff;
        --ar-dark: #172033;
        --ar-text: #334155;
        --ar-muted: #64748b;
        --ar-border: #e2e8f0;
        --ar-border-light: #eef2f7;
        --ar-bg: #f6f8fb;
        --ar-white: #ffffff;
        --ar-radius: 18px;
        --ar-radius-sm: 12px;
        --ar-shadow: 0 10px 30px rgba(15, 23, 42, 0.05);
        --ar-shadow-hover: 0 16px 38px rgba(15, 23, 42, 0.09);
    }

    /* =========================================================
           PAGE
           ========================================================= */

    .receivables-wrapper {
        min-height: 100vh;
        padding: 18px 0 45px;
        background: radial-gradient( circle at top right, rgba(37, 99, 235, 0.055), transparent 30% ), var(--ar-bg);
        font-family: "Segoe UI", system-ui, -apple-system, BlinkMacSystemFont, sans-serif;
        color: var(--ar-text);
    }

        .receivables-wrapper *,
        .receivables-wrapper *::before,
        .receivables-wrapper *::after {
            box-sizing: border-box;
        }

    .ar-container {
        max-width: 1700px;
        margin: 0 auto;
    }

    /* =========================================================
           HEADER
           ========================================================= */

    .ar-page-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 24px;
        margin-bottom: 24px;
        padding: 4px 2px;
        animation: arFadeUp 0.45s ease both;
    }

    .ar-header-left {
        min-width: 0;
    }

    .ar-eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 7px;
        color: var(--ar-primary);
        font-size: 0.72rem;
        font-weight: 800;
        letter-spacing: 0.13em;
        text-transform: uppercase;
    }

        .ar-eyebrow i {
            font-size: 0.7rem;
        }

    .ar-title {
        margin: 0;
        color: var(--ar-dark);
        font-size: clamp(1.55rem, 2.4vw, 2.1rem);
        line-height: 1.15;
        font-weight: 800;
        letter-spacing: -0.025em;
    }

    .ar-subtitle {
        margin: 7px 0 0;
        max-width: 760px;
        color: var(--ar-muted);
        font-size: 0.92rem;
        line-height: 1.55;
    }

    .ar-header-actions {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        flex-wrap: wrap;
        gap: 10px;
        flex-shrink: 0;
    }

    .ar-header-btn {
        min-height: 42px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        padding: 0.65rem 1rem;
        border-radius: 10px;
        font-size: 0.84rem;
        font-weight: 700;
        transition: transform 0.2s ease, box-shadow 0.2s ease, background-color 0.2s ease;
    }

        .ar-header-btn:hover {
            transform: translateY(-1px);
        }

    .ar-export-btn {
        color: var(--ar-success);
        border: 1px solid #a7f3d0;
        background: #ffffff;
    }

        .ar-export-btn:hover {
            color: #047857;
            background: var(--ar-success-soft);
            box-shadow: 0 7px 18px rgba(5, 150, 105, 0.1);
        }

    .ar-back-btn {
        color: #ffffff;
        background: var(--ar-dark);
        border: 1px solid var(--ar-dark);
        box-shadow: 0 7px 18px rgba(23, 32, 51, 0.12);
    }

        .ar-back-btn:hover {
            color: #ffffff;
            background: #0f172a;
            box-shadow: 0 10px 22px rgba(23, 32, 51, 0.18);
        }

    /* =========================================================
           SUMMARY STRIP
           ========================================================= */

    .ar-summary-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 14px;
        margin-bottom: 22px;
        animation: arFadeUp 0.55s ease both;
        animation-delay: 0.04s;
    }

    .ar-summary-card {
        position: relative;
        overflow: hidden;
        min-height: 112px;
        padding: 18px;
        border: 1px solid var(--ar-border);
        border-radius: var(--ar-radius-sm);
        background: var(--ar-white);
        box-shadow: 0 5px 20px rgba(15, 23, 42, 0.035);
        transition: transform 0.25s ease, box-shadow 0.25s ease;
    }

        .ar-summary-card:hover {
            transform: translateY(-2px);
            box-shadow: var(--ar-shadow-hover);
        }

        .ar-summary-card::after {
            content: "";
            position: absolute;
            width: 90px;
            height: 90px;
            right: -35px;
            bottom: -40px;
            border-radius: 50%;
            background: rgba(37, 99, 235, 0.045);
        }

    .ar-summary-top {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 12px;
    }

    .ar-summary-label {
        margin: 0 0 7px;
        color: var(--ar-muted);
        font-size: 0.75rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.055em;
    }

    .ar-summary-value {
        margin: 0;
        color: var(--ar-dark);
        font-size: 1.2rem;
        font-weight: 800;
        letter-spacing: -0.01em;
    }

    .ar-summary-note {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        margin-top: 7px;
        color: var(--ar-muted);
        font-size: 0.73rem;
        font-weight: 600;
    }

    .ar-summary-icon {
        width: 40px;
        height: 40px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 11px;
        flex-shrink: 0;
        font-size: 0.95rem;
    }

    .ar-icon-blue {
        color: var(--ar-primary);
        background: var(--ar-primary-soft);
    }

    .ar-icon-green {
        color: var(--ar-success);
        background: var(--ar-success-soft);
    }

    .ar-icon-orange {
        color: var(--ar-warning);
        background: var(--ar-warning-soft);
    }

    .ar-icon-red {
        color: var(--ar-danger);
        background: var(--ar-danger-soft);
    }

    /* =========================================================
           TOOLBAR
           ========================================================= */

    .ar-toolbar-card {
        margin-bottom: 18px;
        padding: 16px;
        border: 1px solid var(--ar-border);
        border-radius: var(--ar-radius);
        background: var(--ar-white);
        box-shadow: var(--ar-shadow);
        animation: arFadeUp 0.6s ease both;
        animation-delay: 0.08s;
    }

    .ar-toolbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
    }

    .ar-filter-scroll {
        min-width: 0;
        overflow-x: auto;
        scrollbar-width: thin;
        padding-bottom: 2px;
    }

    .ar-filter-tabs {
        display: inline-flex;
        align-items: center;
        flex-wrap: nowrap;
        gap: 7px;
        min-width: max-content;
    }

    .filter-tab {
        min-height: 39px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        padding: 0.55rem 0.85rem;
        border-radius: 9px !important;
        border: 1px solid var(--ar-border);
        background: #ffffff;
        color: var(--ar-muted);
        font-size: 0.78rem;
        font-weight: 700;
        white-space: nowrap;
        transition: color 0.2s ease, background-color 0.2s ease, border-color 0.2s ease, transform 0.2s ease;
    }

        .filter-tab:hover {
            color: var(--ar-primary);
            border-color: #bfdbfe;
            background: #f8fbff;
            transform: translateY(-1px);
        }

        .filter-tab.btn-primary {
            color: #ffffff !important;
            border-color: var(--ar-primary) !important;
            background: var(--ar-primary) !important;
            box-shadow: 0 5px 14px rgba(37, 99, 235, 0.16);
        }

            .filter-tab.btn-primary:hover {
                color: #ffffff !important;
                background: var(--ar-primary-dark) !important;
                border-color: var(--ar-primary-dark) !important;
            }

    .ar-search-form {
        width: min(100%, 340px);
        flex-shrink: 0;
    }

    .ar-search-box {
        position: relative;
        display: flex;
        align-items: center;
    }

    .ar-search-icon {
        position: absolute;
        left: 13px;
        z-index: 2;
        color: #94a3b8;
        font-size: 0.8rem;
        pointer-events: none;
    }

    .ar-search-input {
        width: 100%;
        min-height: 41px;
        padding: 0.62rem 48px 0.62rem 35px;
        border: 1px solid var(--ar-border);
        border-radius: 10px;
        outline: none;
        background: #ffffff;
        color: var(--ar-dark);
        font-size: 0.8rem;
        transition: border-color 0.2s ease, box-shadow 0.2s ease;
    }

        .ar-search-input::placeholder {
            color: #94a3b8;
        }

        .ar-search-input:focus {
            border-color: #93c5fd;
            box-shadow: 0 0 0 4px rgba(37, 99, 235, 0.08);
        }

    .ar-search-submit {
        position: absolute;
        right: 5px;
        width: 32px;
        height: 32px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border: 0;
        border-radius: 7px;
        color: #ffffff;
        background: var(--ar-dark);
        font-size: 0.75rem;
        cursor: pointer;
        transition: background-color 0.2s ease;
    }

        .ar-search-submit:hover {
            background: var(--ar-primary);
        }

    /* =========================================================
           TABLE CARD
           ========================================================= */

    .ar-table-card {
        overflow: hidden;
        border: 1px solid var(--ar-border);
        border-radius: var(--ar-radius);
        background: var(--ar-white);
        box-shadow: var(--ar-shadow);
        animation: arFadeUp 0.65s ease both;
        animation-delay: 0.12s;
    }

    .ar-table-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        padding: 18px 20px;
        border-bottom: 1px solid var(--ar-border-light);
    }

    .ar-table-heading {
        display: flex;
        align-items: center;
        gap: 11px;
        min-width: 0;
    }

    .ar-heading-icon {
        width: 38px;
        height: 38px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 10px;
        color: var(--ar-primary);
        background: var(--ar-primary-soft);
        flex-shrink: 0;
    }

    .ar-table-heading h2 {
        margin: 0;
        color: var(--ar-dark);
        font-size: 0.98rem;
        font-weight: 800;
    }

    .ar-table-heading p {
        margin: 3px 0 0;
        color: var(--ar-muted);
        font-size: 0.74rem;
    }

    .ar-active-filter {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 6px 10px;
        border: 1px solid #dbeafe;
        border-radius: 999px;
        color: var(--ar-primary);
        background: var(--ar-primary-soft);
        font-size: 0.72rem;
        font-weight: 700;
        white-space: nowrap;
    }

    .ar-table-wrap {
        width: 100%;
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
    }

    #receivablesTable {
        min-width: 1120px;
        margin: 0;
        border-collapse: separate;
        border-spacing: 0;
    }

        #receivablesTable thead th {
            padding: 13px 14px;
            border-bottom: 1px solid var(--ar-border);
            background: #f8fafc;
            color: #64748b;
            font-size: 0.69rem;
            font-weight: 800;
            letter-spacing: 0.065em;
            text-transform: uppercase;
            white-space: nowrap;
            vertical-align: middle;
        }

            #receivablesTable thead th:first-child {
                padding-left: 20px;
            }

        #receivablesTable tbody td {
            padding: 15px 14px;
            border-bottom: 1px solid #f1f5f9;
            color: #475569;
            font-size: 0.79rem;
            font-weight: 500;
            white-space: nowrap;
            vertical-align: middle;
        }

        #receivablesTable tbody tr {
            transition: background-color 0.18s ease, transform 0.18s ease;
        }

            #receivablesTable tbody tr:hover {
                background: #fbfdff;
            }

            #receivablesTable tbody tr:last-child td {
                border-bottom: 0;
            }

        #receivablesTable tbody td:first-child {
            padding-left: 20px;
        }

    .invoice-number {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        color: var(--ar-primary);
        font-weight: 800;
    }

        .invoice-number i {
            font-size: 0.68rem;
            opacity: 0.8;
        }

    .customer-name {
        max-width: 200px;
        overflow: hidden;
        text-overflow: ellipsis;
        color: var(--ar-dark);
        font-weight: 700;
    }

    .date-cell {
        color: #64748b;
        font-size: 0.76rem;
        font-weight: 600;
    }

    .amount-cell {
        color: #475569;
        font-weight: 700;
    }

    .balance-cell {
        color: var(--ar-dark);
        font-weight: 800;
    }

    /* =========================================================
           BADGES
           ========================================================= */

    .ar-status-badge,
    .ar-aging-badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        min-height: 27px;
        padding: 4px 9px;
        border-radius: 999px;
        font-size: 0.69rem;
        font-weight: 800;
        line-height: 1;
        white-space: nowrap;
    }

        .ar-status-badge i {
            font-size: 0.55rem;
        }

    .badge-paid {
        color: #047857 !important;
        background: var(--ar-success-soft) !important;
        border: 1px solid #a7f3d0;
    }

    .badge-pending {
        color: #b45309 !important;
        background: var(--ar-warning-soft) !important;
        border: 1px solid #fde68a;
    }

    .badge-overdue {
        color: #b91c1c !important;
        background: var(--ar-danger-soft) !important;
        border: 1px solid #fecaca;
    }

    .ar-aging-badge {
        color: #475569;
        background: #f1f5f9;
        border: 1px solid #e2e8f0;
    }

    .ar-aging-current {
        color: #047857;
        background: #ecfdf5;
        border-color: #a7f3d0;
    }

    .ar-aging-danger {
        color: #b91c1c;
        background: #fef2f2;
        border-color: #fecaca;
    }

    /* =========================================================
           ACTION BUTTON
           ========================================================= */

    .btn-action {
        min-height: 34px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 5px;
        padding: 0.48rem 0.72rem;
        border: 1px solid #bfdbfe !important;
        border-radius: 8px;
        color: var(--ar-primary) !important;
        background: #eff6ff !important;
        font-size: 0.7rem;
        font-weight: 800;
        box-shadow: none !important;
        transition: background-color 0.2s ease, color 0.2s ease, border-color 0.2s ease, transform 0.2s ease;
    }

        .btn-action:hover {
            color: #ffffff !important;
            border-color: var(--ar-primary) !important;
            background: var(--ar-primary) !important;
            transform: translateY(-1px);
        }

    .settled-label {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        color: var(--ar-success);
        font-size: 0.72rem;
        font-weight: 800;
    }

    /* =========================================================
           EMPTY STATE
           ========================================================= */

    .ar-empty-state {
        padding: 60px 20px !important;
        text-align: center;
    }

    .ar-empty-icon {
        width: 58px;
        height: 58px;
        margin: 0 auto 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 16px;
        color: #64748b;
        background: #f1f5f9;
        font-size: 1.25rem;
    }

    .ar-empty-state strong {
        display: block;
        margin-bottom: 5px;
        color: var(--ar-dark);
        font-size: 0.9rem;
    }

    .ar-empty-state span {
        color: var(--ar-muted);
        font-size: 0.78rem;
    }

    /* =========================================================
           TABLE FOOTER
           ========================================================= */

    .ar-table-footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        padding: 13px 20px;
        border-top: 1px solid var(--ar-border-light);
        background: #fcfdff;
    }

    .ar-footer-info {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        color: var(--ar-muted);
        font-size: 0.72rem;
        font-weight: 600;
    }

        .ar-footer-info i {
            color: var(--ar-primary);
        }

    .ar-scroll-hint {
        display: none;
        align-items: center;
        gap: 6px;
        color: #94a3b8;
        font-size: 0.68rem;
        font-weight: 600;
    }

    /* =========================================================
           MODAL
           ========================================================= */

    #paymentModal .modal-dialog {
        max-width: 540px;
    }

    #paymentModal .modal-content {
        overflow: hidden;
        border: 1px solid var(--ar-border);
        border-radius: 18px;
        box-shadow: 0 25px 70px rgba(15, 23, 42, 0.18);
    }

    #paymentModal .modal-header {
        padding: 18px 20px;
        border-bottom: 1px solid var(--ar-border-light);
        background: #ffffff;
    }

    #paymentModal .modal-title {
        display: flex;
        align-items: center;
        color: var(--ar-dark);
        font-size: 0.98rem;
    }

    .payment-title-icon {
        width: 36px;
        height: 36px;
        margin-right: 10px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 10px;
        color: var(--ar-success);
        background: var(--ar-success-soft);
    }

    #paymentModal .modal-body {
        padding: 20px;
        background: #fcfdff;
    }

    .payment-field {
        margin-bottom: 16px;
    }

        .payment-field:last-child {
            margin-bottom: 0;
        }

    .payment-label {
        display: block;
        margin-bottom: 7px;
        color: #475569;
        font-size: 0.75rem;
        font-weight: 800;
    }

    .payment-control {
        width: 100%;
        min-height: 43px;
        border: 1px solid var(--ar-border);
        border-radius: 9px;
        padding: 0.65rem 0.8rem;
        color: var(--ar-dark);
        background: #ffffff;
        font-size: 0.8rem;
        outline: none;
        transition: border-color 0.2s ease, box-shadow 0.2s ease;
    }

        .payment-control:focus {
            border-color: #93c5fd;
            box-shadow: 0 0 0 4px rgba(37, 99, 235, 0.08);
        }

    .payment-readonly {
        color: #64748b;
        background: #f8fafc;
    }

    .payment-amount {
        color: var(--ar-success);
        font-size: 1rem;
        font-weight: 800;
    }

    #paymentModal .modal-footer {
        display: flex;
        justify-content: flex-end;
        gap: 8px;
        padding: 15px 20px;
        border-top: 1px solid var(--ar-border-light);
        background: #ffffff;
    }

    .modal-btn {
        min-height: 40px;
        padding: 0.55rem 0.9rem;
        border-radius: 9px;
        font-size: 0.76rem;
        font-weight: 800;
    }

    .record-payment-btn {
        color: #ffffff;
        background: var(--ar-success);
        border-color: var(--ar-success);
    }

        .record-payment-btn:hover {
            color: #ffffff;
            background: #047857;
            border-color: #047857;
        }

    /* =========================================================
           ANIMATION
           ========================================================= */

    @@keyframes arFadeUp {
        from

    {
        opacity: 0;
        transform: translateY(9px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }

    }

    /* =========================================================
           RESPONSIVE - LARGE TABLETS
           ========================================================= */

    @@media (max-width: 1200px) {
        .ar-summary-grid

    {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .ar-toolbar {
        align-items: stretch;
        flex-direction: column;
    }

    .ar-search-form {
        width: 100%;
        max-width: 420px;
    }

    }

    /* =========================================================
           RESPONSIVE - TABLETS
           ========================================================= */

    @@media (max-width: 992px) {
        .receivables-wrapper

    {
        padding-top: 12px;
    }

    .ar-page-header {
        align-items: flex-start;
        flex-direction: column;
    }

    .ar-header-actions {
        width: 100%;
        justify-content: flex-start;
    }

    .ar-header-btn {
        flex: 0 0 auto;
    }

    .ar-table-header {
        align-items: flex-start;
        flex-direction: column;
    }

    .ar-active-filter {
        align-self: flex-start;
    }

    }

    /* =========================================================
           RESPONSIVE - MOBILE
           ========================================================= */

    @@media (max-width: 768px) {
        .receivables-wrapper

    {
        padding: 8px 0 30px;
    }

    .receivables-wrapper .container-fluid {
        padding-left: 12px !important;
        padding-right: 12px !important;
    }

    .ar-page-header {
        gap: 16px;
        margin-bottom: 18px;
    }

    .ar-eyebrow {
        font-size: 0.66rem;
    }

    .ar-title {
        font-size: 1.42rem;
    }

    .ar-subtitle {
        font-size: 0.8rem;
    }

    .ar-header-actions {
        display: grid;
        grid-template-columns: 1fr 1fr;
        width: 100%;
    }

    .ar-header-btn {
        width: 100%;
        min-height: 42px;
        font-size: 0.75rem;
    }

    .ar-summary-grid {
        grid-template-columns: 1fr 1fr;
        gap: 10px;
        margin-bottom: 14px;
    }

    .ar-summary-card {
        min-height: 100px;
        padding: 14px;
    }

    .ar-summary-label {
        font-size: 0.65rem;
    }

    .ar-summary-value {
        font-size: 0.95rem;
    }

    .ar-summary-note {
        font-size: 0.65rem;
    }

    .ar-summary-icon {
        width: 34px;
        height: 34px;
        font-size: 0.8rem;
    }

    .ar-toolbar-card {
        margin-bottom: 14px;
        padding: 12px;
        border-radius: 14px;
    }

    .ar-filter-scroll {
        width: 100%;
    }

    .ar-filter-tabs {

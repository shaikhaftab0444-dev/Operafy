    /* =========================================================
           PRINT
           ========================================================= */

    @@media print {
        body

    {
        background: #ffffff !important;
    }

    .receivables-wrapper {
        padding: 0 !important;
        background: #ffffff !important;
    }

    .ar-page-header {
        margin-bottom: 15px;
    }

    .ar-header-actions,
    .ar-toolbar-card,
    .ar-summary-grid,
    .btn-action,
    .ar-table-footer,
    #paymentModal {
        display: none !important;
    }

    .ar-table-card {
        border: 0 !important;

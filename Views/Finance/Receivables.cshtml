</style>

<div class="receivables-wrapper">
    <div class="container-fluid px-4 ar-container">

        <!-- =====================================================
             PAGE HEADER
             ===================================================== -->
        <header class="ar-page-header">
            <div class="ar-header-left">
                <div class="ar-eyebrow">
                    <i class="fa-solid fa-chart-line"></i>
                    Accounts Receivable
                </div>

                <h1 class="ar-title">
                    Sales Invoices &amp; Customer Aging
                </h1>

                <p class="ar-subtitle">
                    Monitor outstanding customer invoices, payment balances,
                    and receivable aging from one centralized view.
                </p>
            </div>

            <div class="ar-header-actions">
                <button type="button"
                        class="btn ar-header-btn ar-export-btn"
                        id="btnExportExcel">
                    <i class="fa-solid fa-file-excel"></i>
                    <span>Export to Excel</span>
                </button>

                <a asp-action="Index"
                   class="btn ar-header-btn ar-back-btn">
                    <i class="fa-solid fa-arrow-left"></i>
                    <span>Back to Dashboard</span>
                </a>
            </div>
        </header>


        <!-- =====================================================
             SUMMARY CARDS
             ===================================================== -->
        <section class="ar-summary-grid">

            <div class="ar-summary-card">
                <div class="ar-summary-top">
                    <div>
                        <p class="ar-summary-label">Invoice Records</p>

                        <p class="ar-summary-value">
                            @(Model?.Count ?? 0)
                        </p>

                        <span class="ar-summary-note">
                            <i class="fa-solid fa-file-invoice"></i>
                            Current view
                        </span>
                    </div>

                    <span class="ar-summary-icon ar-icon-blue">
                        <i class="fa-solid fa-file-invoice-dollar"></i>
                    </span>
                </div>
            </div>


            <div class="ar-summary-card">
                <div class="ar-summary-top">
                    <div>
                        <p class="ar-summary-label">Open Invoices</p>

                        <p class="ar-summary-value">
                            @(Model?.Count(x => x.Status != "Paid") ?? 0)
                        </p>

                        <span class="ar-summary-note">
                            <i class="fa-solid fa-clock"></i>
                            Awaiting collection
                        </span>
                    </div>

                    <span class="ar-summary-icon ar-icon-orange">
                        <i class="fa-solid fa-hourglass-half"></i>
                    </span>
                </div>
            </div>


            <div class="ar-summary-card">
                <div class="ar-summary-top">
                    <div>
                        <p class="ar-summary-label">Overdue</p>

                        <p class="ar-summary-value">
                            @(Model?.Count(x => x.Status == "Overdue") ?? 0)
                        </p>

                        <span class="ar-summary-note">
                            <i class="fa-solid fa-triangle-exclamation"></i>
                            Requires attention
                        </span>
                    </div>

                    <span class="ar-summary-icon ar-icon-red">
                        <i class="fa-solid fa-calendar-xmark"></i>
                    </span>
                </div>
            </div>


            <div class="ar-summary-card">
                <div class="ar-summary-top">
                    <div>
                        <p class="ar-summary-label">Settled</p>

                        <p class="ar-summary-value">
                            @(Model?.Count(x => x.Status == "Paid") ?? 0)
                        </p>

                        <span class="ar-summary-note">
                            <i class="fa-solid fa-circle-check"></i>
                            Fully paid
                        </span>
                    </div>

                    <span class="ar-summary-icon ar-icon-green">
                        <i class="fa-solid fa-hand-holding-dollar"></i>
                    </span>
                </div>
            </div>

        </section>


        <!-- =====================================================
             FILTER & SEARCH TOOLBAR
             ===================================================== -->
        <section class="ar-toolbar-card">

            <div class="ar-toolbar">

                <!-- Aging Filters -->
                <div class="ar-filter-scroll">
                    <div class="ar-filter-tabs">

                        <a asp-action="Receivables"
                           asp-route-agingFilter="All"
                           asp-route-search="@ViewBag.SearchTerm"
                           class="btn filter-tab @(currentFilter == "All" ? "btn-primary" : "btn-outline-secondary")">
                            <i class="fa-solid fa-layer-group"></i>
                            All Invoices
                        </a>

                        <a asp-action="Receivables"
                           asp-route-agingFilter="Current"
                           asp-route-search="@ViewBag.SearchTerm"
                           class="btn filter-tab @(currentFilter == "Current" ? "btn-primary" : "btn-outline-secondary")">
                            <i class="fa-solid fa-circle-check"></i>
                            Current
                        </a>

                        <a asp-action="Receivables"
                           asp-route-agingFilter="1-30 Days"
                           asp-route-search="@ViewBag.SearchTerm"
                           class="btn filter-tab @(currentFilter == "1-30 Days" ? "btn-primary" : "btn-outline-secondary")">
                            <i class="fa-solid fa-clock"></i>
                            1-30 Days
                        </a>

                        <a asp-action="Receivables"
                           asp-route-agingFilter="31-60 Days"
                           asp-route-search="@ViewBag.SearchTerm"
                           class="btn filter-tab @(currentFilter == "31-60 Days" ? "btn-primary" : "btn-outline-secondary")">
                            <i class="fa-solid fa-calendar-days"></i>
                            31-60 Days
                        </a>

                        <a asp-action="Receivables"
                           asp-route-agingFilter="Overdue 90+ Days"
                           asp-route-search="@ViewBag.SearchTerm"
                           class="btn filter-tab @(currentFilter == "Overdue 90+ Days" ? "btn-primary" : "btn-outline-secondary")">
                            <i class="fa-solid fa-triangle-exclamation"></i>
                            Overdue 90+ Days
                        </a>

                    </div>
                </div>


                <!-- Search -->
                <form method="get"
                      asp-action="Receivables"
                      class="ar-search-form">

                    <input type="hidden"
                           name="agingFilter"
                           value="@currentFilter" />

                    <div class="ar-search-box">

                        <i class="fa-solid fa-magnifying-glass ar-search-icon"></i>

                        <input type="text"
                               name="search"
                               value="@ViewBag.SearchTerm"
                               placeholder="Search customer or invoice..."
                               class="ar-search-input"
                               autocomplete="off" />

                        <button type="submit"
                                class="ar-search-submit"
                                aria-label="Search invoices">
                            <i class="fa-solid fa-arrow-right"></i>
                        </button>

                    </div>

                </form>

            </div>

        </section>


        <!-- =====================================================
             INVOICE TABLE
             ===================================================== -->
        <section class="ar-table-card">

            <!-- Table Header -->
            <div class="ar-table-header">

                <div class="ar-table-heading">

                    <span class="ar-heading-icon">
                        <i class="fa-solid fa-table-list"></i>
                    </span>

                    <div>
                        <h2>Receivable Invoice Register</h2>

                        <p>
                            Customer invoices and outstanding collection balances
                        </p>
                    </div>

                </div>

                <span class="ar-active-filter">
                    <i class="fa-solid fa-filter"></i>
                    @currentFilter
                </span>

            </div>


            <!-- Responsive Table -->
            <div class="ar-table-wrap">

                <table class="table align-middle mb-0"
                       id="receivablesTable">

                    <thead>
                        <tr>
                            <th>Invoice No</th>
                            <th>Customer</th>
                            <th>Invoice Date</th>
                            <th>Due Date</th>
                            <th>Total Amount</th>
                            <th>Balance Due</th>
                            <th>Aging Bucket</th>
                            <th>Status</th>
                            <th class="text-center">Action</th>
                        </tr>
                    </thead>

                    <tbody>

                        @if (Model != null && Model.Any())
                        {
                            @foreach (var invoice in Model)
                            {
                                var statusClass =
                                invoice.Status == "Paid"
                                ? "badge-paid"
                                : (invoice.Status == "Overdue"
                                ? "badge-overdue"
                                : "badge-pending");

                                var agingClass =
                                invoice.AgingBucket == "Current"
                                ? "ar-aging-current"
                                : (invoice.Status == "Overdue"
                                ? "ar-aging-danger"
                                : "");

                                <tr>

                                    <!-- Invoice -->
                                    <td>
                                        <span class="invoice-number">
                                            <i class="fa-solid fa-file-invoice"></i>
                                            @invoice.InvoiceNo
                                        </span>
                                    </td>


                                    <!-- Customer -->
                                    <td>
                                        <span class="customer-name"
                                              title="@invoice.CustomerName">
                                            @invoice.CustomerName
                                        </span>
                                    </td>


                                    <!-- Invoice Date -->
                                    <td>
                                        <span class="date-cell">
                                            <i class="fa-regular fa-calendar me-1"></i>
                                            @invoice.InvoiceDate.ToString("dd-MMM-yyyy")
                                        </span>
                                    </td>


                                    <!-- Due Date -->
                                    <td>
                                        <span class="date-cell">
                                            <i class="fa-regular fa-calendar-check me-1"></i>
                                            @invoice.DueDate.ToString("dd-MMM-yyyy")
                                        </span>
                                    </td>


                                    <!-- Total -->
                                    <td>
                                        <span class="amount-cell">
                                            ₹ @invoice.TotalAmount.ToString("N2")
                                        </span>
                                    </td>


                                    <!-- Balance -->
                                    <td>
                                        <span class="balance-cell">
                                            ₹ @invoice.BalanceDue.ToString("N2")
                                        </span>
                                    </td>


                                    <!-- Aging -->
                                    <td>
                                        <span class="ar-aging-badge @agingClass">
                                            <i class="fa-solid fa-hourglass-half"></i>
                                            @invoice.AgingBucket
                                        </span>
                                    </td>


                                    <!-- Status -->
                                    <td>
                                        <span class="ar-status-badge @statusClass">

                                            @if (invoice.Status == "Paid")
                                            {
                                                <i class="fa-solid fa-circle-check"></i>
                                            }
                                            else if (invoice.Status == "Overdue")
                                            {
                                                <i class="fa-solid fa-circle-exclamation"></i>
                                            }
                                            else
                                            {
                                                <i class="fa-solid fa-clock"></i>
                                            }

                                            @invoice.Status

                                        </span>
                                    </td>


                                    <!-- Action -->
                                    <td class="text-center">

                                        @if (invoice.Status != "Paid")
                                        {
                                            <button type="button"
                                                    class="btn btn-primary btn-sm btn-action"
                                                    onclick="openPaymentModal('@invoice.InvoiceNo', '@invoice.CustomerName', @invoice.BalanceDue)">

                                                <i class="fa-solid fa-wallet"></i>
                                                Record Payment

                                            </button>
                                        }
                                        else
                                        {
                                            <span class="settled-label">
                                                <i class="fa-solid fa-circle-check"></i>
                                                Settled
                                            </span>
                                        }

                                    </td>

                                </tr>
                            }
                        }
                        else
                        {
                            <tr>

                                <td colspan="9"
                                    class="ar-empty-state">

                                    <div class="ar-empty-icon">
                                        <i class="fa-solid fa-file-circle-xmark"></i>
                                    </div>

                                    <strong>No invoices found</strong>

                                    <span>
                                        No invoices match the selected aging bucket or search criteria.
                                    </span>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>


            <!-- Table Footer -->
            <div class="ar-table-footer">

                <span class="ar-footer-info">
                    <i class="fa-solid fa-circle-info"></i>

                    Showing
                    <strong>
                        @(Model?.Count ?? 0)
                    </strong>
                    invoice record(s)
                </span>

                <span class="ar-scroll-hint">
                    <i class="fa-solid fa-arrows-left-right"></i>
                    Swipe horizontally to view all columns
                </span>

            </div>

        </section>

    </div>
</div>


<!-- =========================================================
     RECORD PAYMENT MODAL
     ========================================================= -->

<div class="modal fade"
     id="paymentModal"
     tabindex="-1"
     aria-labelledby="paymentModalLabel"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content">

            <!-- Modal Header -->
            <div class="modal-header">

                <h5 class="modal-title fw-bold"
                    id="paymentModalLabel">

                    <span class="payment-title-icon">
                        <i class="fa-solid fa-cash-register"></i>
                    </span>

                    Record Invoice Payment

                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Close">
                </button>

            </div>


            <!-- Modal Body -->
            <div class="modal-body">

                <form id="paymentForm">

                    <!-- Invoice Number -->
                    <div class="payment-field">

                        <label class="payment-label">
                            Invoice Number
                        </label>

                        <input type="text"
                               id="modalInvoiceNo"
                               class="payment-control payment-readonly"
                               readonly />

                    </div>


                    <!-- Customer -->
                    <div class="payment-field">

                        <label class="payment-label">
                            Customer
                        </label>

                        <input type="text"
                               id="modalCustomerName"
                               class="payment-control payment-readonly"
                               readonly />

                    </div>


                    <!-- Amount -->
                    <div class="payment-field">

                        <label class="payment-label">
                            Collection Amount (₹)
                        </label>

                        <input type="number"
                               id="modalAmount"
                               class="payment-control payment-amount"
                               step="0.01"
                               min="0"
                               required />

                    </div>


                    <!-- Receiving Account -->
                    <div class="payment-field">

                        <label class="payment-label">
                            Receiving Ledger / Account
                        </label>

                        <select class="payment-control">

                            <option value="1">
                                AC-1001 • Main Cash Account
                            </option>

                            <option value="2">
                                AC-1002 • Reserve Bank Account
                            </option>

                        </select>

                    </div>


                    <!-- Reference -->
                    <div class="payment-field">

                        <label class="payment-label">
                            Treasury Reference / Receipt ID
                        </label>

                        <input type="text"
                               id="modalRef"
                               class="payment-control"
                               placeholder="UTR or Bank Reference"
                               required />

                    </div>

                </form>

            </div>


            <!-- Modal Footer -->
            <div class="modal-footer">

                <button type="button"
                        class="btn btn-outline-secondary modal-btn"
                        data-bs-dismiss="modal">
                    Close
                </button>

                <button type="button"
                        class="btn record-payment-btn modal-btn"
                        onclick="savePayment()">

                    <i class="fa-solid fa-check me-1"></i>
                    Record Cash Inflow

                </button>

            </div>

        </div>

    </div>

</div>


@section Scripts {

    <!-- SheetJS Excel Export Library -->
    <script src="https://cdn.jsdelivr.net/npm/xlsx@0.18.5/dist/xlsx.full.min.js"></script>

    <script>

        /* =====================================================
           PAYMENT MODAL
           ===================================================== */

        let activeInvoiceNo = '';

        function openPaymentModal(invoiceNo, customer, balance) {

            activeInvoiceNo = invoiceNo;

            $('#modalInvoiceNo').val(invoiceNo);
            $('#modalCustomerName').val(customer);
            $('#modalAmount').val(balance);
            $('#modalRef').val('');

            $('#paymentModal').modal('show');
        }


        /* =====================================================
           SAVE PAYMENT
           ===================================================== */

        function savePayment() {

            const amount = $('#modalAmount').val();
            const reference = $('#modalRef').val();

            if (!reference) {

                alert("Please enter a transaction reference number.");

                $('#modalRef').focus();

                return;
            }

            alert(
                `Payment of ₹${amount} registered against invoice ${activeInvoiceNo} under reference ${reference}.`
            );

            $('#paymentModal').modal('hide');

            location.reload();
        }


        /* =====================================================
           EXCEL EXPORT
           ===================================================== */

        document
            .getElementById('btnExportExcel')
            .addEventListener('click', function () {

                const table =
                    document.getElementById('receivablesTable');

                const wb =
                    XLSX.utils.table_to_book(
                        table,
                        {
                            sheet: "Accounts Receivable"
                        }
                    );

                XLSX.writeFile(
                    wb,
                    "Accounts_Receivable_Report.xlsx"
                );

            });


        /* =====================================================
           ENTER KEY SUPPORT FOR SEARCH
           ===================================================== */

        document.addEventListener('DOMContentLoaded', function () {

            const searchInput =
                document.querySelector('.ar-search-input');

            if (searchInput) {

                searchInput.addEventListener('keydown', function (event) {

                    if (event.key === 'Enter') {

                        event.preventDefault();

                        this.closest('form').submit();
                    }

                });

            }

        });

    </script>
}
@model List<ERP_System.Models.DepartmentBudgetViewModel>
@{
    ViewData["Title"] = "Departmental Budget Allocations";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
<style>
    .budgets-wrapper {
        background: #f8fafc;
        min-height: 100vh;
        padding: 1.5rem 0;
        font-family: 'Segoe UI', system-ui, sans-serif;
    }
    
    .finance-card {
        background: #ffffff;
        border: 1px solid rgba(226, 232, 240, 0.8);
        border-radius: 16px;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.02);
    }
</style>

<div class="budgets-wrapper">
    <div class="container-fluid px-4">
        
        <!-- Module Header -->
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <span class="text-uppercase text-secondary fw-semibold small tracking-wider">Financial Control</span>
                <h1 class="h3 mb-0 fw-bold text-slate-800">Departmental Budgets & Allocation Matrix</h1>
            </div>
            <div class="d-flex gap-2">
                <a asp-action="Index" class="btn btn-secondary"><i class="fa-solid fa-arrow-left me-2"></i>Back to Dashboard</a>
            </div>
        </div>

        <!-- Budgets Listing Card -->
        <div class="finance-card p-4">
            <div class="table-responsive">
                <table class="table align-middle table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Department Name</th>
                            <th>Allocated Budget</th>
                            <th>Utilized Amount</th>
                            <th>Remaining Balance</th>
                            <th width="300">Consumption Burn Rate</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var budget in Model)
                        {
                            var burn = budget.BurnRatePercentage;
                            var remaining = budget.Allocated - budget.Utilized;
                            var colorClass = burn > 90 ? "bg-danger" : (burn > 75 ? "bg-warning" : "bg-success");
                            var textStatus = burn > 95 ? "Over-allocated" : (burn > 80 ? "Critical Burn" : "Healthy");
                            var badgeClass = burn > 95 ? "badge bg-danger-subtle text-danger" : (burn > 80 ? "badge bg-warning-subtle text-warning" : "badge bg-success-subtle text-success");

                            <tr>
                                <td><span class="fw-bold text-dark">@budget.DepartmentName</span></td>
                                <td>₹ @budget.Allocated.ToString("N2")</td>
                                <td>₹ @budget.Utilized.ToString("N2")</td>
                                <td><strong class="@(remaining < 0 ? "text-danger" : "text-dark")">₹ @remaining.ToString("N2")</strong></td>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="progress flex-grow-1" style="height: 10px; border-radius: 5px;">
                                            <div class="progress-bar @colorClass" role="progressbar" style="width: @burn%" aria-valuenow="@burn" aria-valuemin="0" aria-valuemax="100"></div>
                                        </div>
                                        <span class="small fw-bold">@burn.ToString("F0")%</span>
                                    </div>
                                </td>
                                <td><span class="@badgeClass">@textStatus</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

    </div>
</div>

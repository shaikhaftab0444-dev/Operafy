@model ERP_System.Models.FinanceTeamAttendanceViewModel

@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Finance Team Attendance";
}

<style>
    /* =========================================================
           FINANCE TEAM ATTENDANCE — PREMIUM ERP UI
           UI ONLY — EXISTING RAZOR / ROUTES / FILTERS PRESERVED
           ========================================================= */

    :root {
        --fta-primary: #2563eb;
        --fta-primary-dark: #1d4ed8;
        --fta-primary-soft: #eff6ff;
        --fta-success: #059669;
        --fta-success-soft: #ecfdf5;
        --fta-warning: #d97706;
        --fta-warning-soft: #fffbeb;
        --fta-danger: #dc2626;
        --fta-danger-soft: #fef2f2;
        --fta-info: #0284c7;
        --fta-info-soft: #f0f9ff;
        --fta-purple: #7c3aed;
        --fta-text: #172033;
        --fta-muted: #64748b;
        --fta-border: #e5e7eb;
        --fta-border-soft: #edf1f5;
        --fta-surface: #ffffff;
        --fta-surface-soft: #f8fafc;
        --fta-radius: 16px;
        --fta-shadow: 0 8px 28px rgba(15, 23, 42, .055);
        --fta-shadow-hover: 0 16px 38px rgba(15, 23, 42, .11);
    }

    /* =========================================================
           PAGE
           ========================================================= */

    .finance-team-page {
        width: 100%;
        min-height: 100%;
        color: var(--fta-text);
        animation: ftaPageIn .45s ease both;
    }

        .finance-team-page *,
        .finance-team-page *::before,
        .finance-team-page *::after {
            box-sizing: border-box;
        }

    /* =========================================================
           HEADER
           ========================================================= */

    .fta-page-header {
        position: relative;
        padding: 1.35rem 1.4rem;
        margin-bottom: 1.35rem;
        border: 1px solid var(--fta-border);
        border-radius: var(--fta-radius);
        background: radial-gradient(circle at 100% 0%, rgba(37, 99, 235, .08), transparent 30%), linear-gradient(135deg, #ffffff 0%, #f8fbff 100%);
        box-shadow: var(--fta-shadow);
        overflow: hidden;
    }

        .fta-page-header::before {
            content: "";
            position: absolute;
            top: 0;
            left: 0;
            width: 5px;
            height: 100%;
            background: linear-gradient( 180deg, var(--fta-primary), #60a5fa, var(--fta-primary) );
            border-radius: 16px 0 0 16px;
        }

        .fta-page-header::after {
            content: "";
            position: absolute;
            width: 180px;
            height: 180px;
            right: -75px;
            top: -95px;
            border-radius: 50%;
            border: 1px solid rgba(37, 99, 235, .08);
            box-shadow: 0 0 0 20px rgba(37, 99, 235, .025), 0 0 0 40px rgba(37, 99, 235, .018);
            pointer-events: none;
        }

    .fta-header-content {
        position: relative;
        z-index: 2;
    }

    .fta-breadcrumb {
        margin-bottom: .45rem !important;
    }

        .fta-breadcrumb .breadcrumb-item {
            font-size: .76rem;
            font-weight: 600;
        }

            .fta-breadcrumb .breadcrumb-item + .breadcrumb-item::before {
                color: #94a3b8;
            }

        .fta-breadcrumb a {
            color: var(--fta-muted);
            transition: color .2s ease;
        }

            .fta-breadcrumb a:hover {
                color: var(--fta-primary);
            }

    .fta-title {
        font-size: 1.35rem;
        letter-spacing: -.025em;
        line-height: 1.3;
    }

    .fta-title-icon {
        width: 38px;
        height: 38px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        margin-right: .55rem;
        border-radius: 11px;
        color: var(--fta-primary);
        background: var(--fta-primary-soft);
        border: 1px solid #dbeafe;
        vertical-align: middle;
        animation: ftaIconFloat 3s ease-in-out infinite;
    }

    .fta-date-control {
        position: relative;
        z-index: 3;
        padding: .45rem;
        border: 1px solid var(--fta-border);
        border-radius: 12px;
        background: rgba(255,255,255,.8);
        box-shadow: 0 5px 16px rgba(15,23,42,.04);
        backdrop-filter: blur(8px);
    }

        .fta-date-control .form-control {
            min-width: 150px;
        }

    .fta-page-header .form-control {
        min-height: 39px;
        border-color: #dbe2ea;
        border-radius: 9px;
        font-size: .82rem;
        color: #334155;
        background: #fff;
        box-shadow: none;
        transition: all .2s ease;
    }

        .fta-page-header .form-control:focus {
            border-color: #93c5fd;
            box-shadow: 0 0 0 .2rem rgba(37,99,235,.08);
        }

    .fta-refresh-btn {
        min-height: 39px;
        border: 0;
        border-radius: 9px;
        padding-left: 1rem;
        padding-right: 1rem;
        color: #fff;
        font-weight: 700;
        background: linear-gradient(135deg, #2563eb, #3b82f6);
        box-shadow: 0 5px 14px rgba(37,99,235,.17);
        transition: all .22s ease;
    }

        .fta-refresh-btn:hover {
            color: #fff;
            transform: translateY(-2px);
            box-shadow: 0 9px 20px rgba(37,99,235,.24);
            background: linear-gradient(135deg, #1d4ed8, #2563eb);
        }

            .fta-refresh-btn:hover i {
                animation: ftaRotate .7s ease;
            }

    /* =========================================================
           KPI CARDS
           ========================================================= */

    .fta-kpi {
        position: relative;
        height: 100%;
        min-height: 128px;
        padding: 1.15rem;
        border: 1px solid var(--fta-border);
        border-radius: 15px;
        background: linear-gradient(145deg, #ffffff 0%, #fbfdff 100%);
        box-shadow: 0 4px 17px rgba(15,23,42,.045);
        overflow: hidden;
        transition: transform .25s ease, box-shadow .25s ease, border-color .25s ease;
        animation: ftaCardIn .55s ease both;
    }

        .fta-kpi:nth-child(1) {
            animation-delay: .04s;
        }

        .fta-kpi:nth-child(2) {
            animation-delay: .09s;
        }

        .fta-kpi:nth-child(3) {
            animation-delay: .14s;
        }

        .fta-kpi:nth-child(4) {
            animation-delay: .19s;
        }

        .fta-kpi::before {
            content: "";
            position: absolute;
            width: 100px;
            height: 100px;
            right: -45px;
            bottom: -48px;
            border-radius: 50%;
            background: rgba(37,99,235,.035);
            transition: transform .3s ease;
        }

        .fta-kpi::after {
            content: "";
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 3px;
            background: linear-gradient( 90deg, var(--fta-primary), #60a5fa );
            transform: scaleX(0);
            transform-origin: left;
            transition: transform .3s ease;
        }

        .fta-kpi:hover {
            transform: translateY(-5px);
            border-color: #d5deea;
            box-shadow: var(--fta-shadow-hover);
        }

            .fta-kpi:hover::after {
                transform: scaleX(1);
            }

            .fta-kpi:hover::before {
                transform: scale(1.25);
            }

    .fta-kpi-inner {
        position: relative;
        z-index: 2;
    }

    .fta-kpi-label {
        display: block;
        color: var(--fta-muted);
        font-size: .69rem;
        font-weight: 800;
        letter-spacing: .055em;
        text-transform: uppercase;
    }

    .fta-kpi-value {
        margin-top: .3rem;
        margin-bottom: 0;
        font-size: 1.65rem;
        line-height: 1;
        letter-spacing: -.035em;
    }

    .fta-kpi-icon {
        width: 52px;
        height: 52px;
        min-width: 52px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 14px;
        font-size: 1.12rem;
        border: 1px solid rgba(255,255,255,.7);
        box-shadow: inset 0 0 0 1px rgba(255,255,255,.5), 0 5px 14px rgba(15,23,42,.045);
        transition: transform .25s ease;
    }

    .fta-kpi:hover .fta-kpi-icon {
        transform: scale(1.08) rotate(-3deg);
    }

    .fta-kpi-status {
        margin-top: .55rem;
        font-size: .69rem;
        font-weight: 600;
        color: #94a3b8;
    }

        .fta-kpi-status i {
            font-size: .45rem;
            vertical-align: middle;
            margin-right: .3rem;
        }

    /* =========================================================
           MAIN TABLE CARD
           ========================================================= */

    .fta-table-card {
        border: 1px solid var(--fta-border) !important;
        border-radius: var(--fta-radius) !important;
        background: #fff;
        box-shadow: var(--fta-shadow) !important;
        overflow: hidden;
        animation: ftaCardIn .6s ease both;
        animation-delay: .18s;
    }

    .fta-table-header {
        position: relative;
        padding: 1.15rem 1.3rem !important;
        background: linear-gradient(180deg, #ffffff 0%, #fbfcfe 100%);
    }

        .fta-table-header::after {
            content: "";
            position: absolute;
            bottom: 0;
            left: 1.3rem;
            right: 1.3rem;
            height: 1px;
            background: linear-gradient( 90deg, transparent, #e2e8f0 15%, #e2e8f0 85%, transparent );
        }

    .fta-section-icon {
        width: 36px;
        height: 36px;
        min-width: 36px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 10px;
        background: var(--fta-primary-soft);
        border: 1px solid #dbeafe;
        color: var(--fta-primary);
        margin-right: .55rem;
    }

    .fta-section-title {
        font-size: .95rem;
        letter-spacing: -.01em;
    }

    .fta-section-subtitle {
        display: block;
        margin-top: .2rem;
        color: var(--fta-muted);
        font-size: .73rem;
    }

    /* =========================================================
           FILTER PANEL
           ========================================================= */

    .fta-filter-panel {
        position: relative;
        z-index: 2;
        padding: .55rem;
        border: 1px solid #e5eaf0;
        border-radius: 12px;
        background: #f8fafc;
        box-shadow: inset 0 1px 0 rgba(255,255,255,.8);
    }

        .fta-filter-panel .input-group,
        .fta-filter-panel .form-select {
            min-height: 38px;
        }

        .fta-filter-panel .input-group {
            width: 235px !important;
        }

        .fta-filter-panel .input-group-text {
            padding-left: .7rem;
            padding-right: .65rem;
            color: #94a3b8;
            border-color: #dbe2ea;
            background: #fff;
            border-radius: 9px 0 0 9px;
        }

        .fta-filter-panel .form-control,
        .fta-filter-panel .form-select {
            border-color: #dbe2ea;
            border-radius: 9px;
            color: #334155;
            background: #fff;
            font-size: .79rem;
            box-shadow: none;
            transition: all .2s ease;
        }

            .fta-filter-panel .form-control:focus,
            .fta-filter-panel .form-select:focus {
                border-color: #93c5fd;
                box-shadow: 0 0 0 .18rem rgba(37,99,235,.08);
            }

    .fta-filter-btn {
        min-height: 38px;
        padding-left: 1rem;
        padding-right: 1rem;
        border: 1px solid #cbd5e1;
        border-radius: 9px;
        background: #fff;
        color: #475569;
        font-size: .78rem;
        font-weight: 700;
        transition: all .2s ease;
    }

        .fta-filter-btn:hover {
            color: var(--fta-primary);
            border-color: #93c5fd;
            background: #eff6ff;
            transform: translateY(-1px);
        }

    /* =========================================================
           TABLE
           ========================================================= */

    .fta-table-wrapper {
        border-top: 1px solid var(--fta-border-soft);
        overflow-x: auto;
        scrollbar-width: thin;
        scrollbar-color: #cbd5e1 transparent;
    }

    .fta-table {
        min-width: 1040px;
        margin-bottom: 0 !important;
    }

        .fta-table thead th {
            padding: .9rem 1rem;
            border-bottom: 1px solid #e2e8f0;
            background: #f8fafc;
            color: #64748b;
            font-size: .67rem;
            font-weight: 800;
            letter-spacing: .065em;
            text-transform: uppercase;
            white-space: nowrap;
        }

        .fta-table tbody td {
            padding: .92rem 1rem;
            border-bottom: 1px solid #edf1f5;
            color: var(--fta-text);
            font-size: .82rem;
            vertical-align: middle;
            white-space: nowrap;
        }

        .fta-table tbody tr {
            position: relative;
            transition: background-color .2s ease, transform .2s ease;
        }

            .fta-table tbody tr:hover {
                background: #f8fbff;
            }

            .fta-table tbody tr:last-child td {
                border-bottom: 0;
            }

    /* =========================================================
           EMPLOYEE CELL
           ========================================================= */

    .fta-avatar {
        width: 43px;
        height: 43px;
        min-width: 43px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 12px;
        background: linear-gradient(135deg, #2563eb, #3b82f6);
        color: #fff;
        font-size: .78rem;
        font-weight: 800;
        letter-spacing: .02em;
        box-shadow: 0 5px 13px rgba(37,99,235,.17);
        transition: all .25s ease;
    }

    .fta-table tbody tr:hover .fta-avatar {
        transform: translateY(-2px) scale(1.05);
        box-shadow: 0 8px 18px rgba(37,99,235,.22);
    }

    .fta-employee-name {
        color: #172033;
        font-size: .83rem;
        font-weight: 750;
    }

    .fta-employee-code {
        display: inline-block;
        margin-top: .14rem;
        padding: .08rem .35rem;
        border-radius: 5px;
        background: #f1f5f9;
        color: #64748b;
        font-size: .66rem;
        text-decoration: none;
    }

    .fta-role {
        color: #334155;
        font-size: .79rem;
        font-weight: 700;
    }

    .fta-department {
        margin-top: .15rem;
        color: #94a3b8;
        font-size: .71rem;
    }

    /* =========================================================
           TIME CELLS
           ========================================================= */

    .fta-time {
        display: inline-flex;
        align-items: center;
        gap: .35rem;
        padding: .3rem .5rem;
        border-radius: 7px;
        font-size: .77rem;
        font-weight: 700;
    }

    .fta-time-in {
        color: #047857;
        background: #ecfdf5;
    }

    .fta-time-out {
        color: #b91c1c;
        background: #fef2f2;
    }

    .fta-duration {
        display: inline-flex;
        align-items: center;
        gap: .3rem;
        padding: .35rem .55rem;
        border: 1px solid #e2e8f0;
        border-radius: 7px;
        background: #f8fafc;
        color: #334155;
        font-size: .7rem;
        font-weight: 700;
    }

    /* =========================================================
           BADGES
           ========================================================= */

    .fta-source-badge,
    .fta-status-badge {
        display: inline-flex;
        align-items: center;
        white-space: nowrap;
        border-radius: 999px;
        font-weight: 700;
        line-height: 1;
    }

    .fta-source-badge {
        padding: .42rem .65rem;
        border: 1px solid #e2e8f0;
        background: #f8fafc;
        color: #64748b;
        font-size: .68rem;
    }

        .fta-source-badge i {
            margin-right: .3rem;
        }

    .fta-status-badge {
        padding: .46rem .72rem;
        font-size: .68rem;
    }

    .fta-status-present {
        color: #047857;
        background: #ecfdf5;
        border: 1px solid #bbf7d0;
    }

    .fta-status-late {
        color: #b45309;
        background: #fffbeb;
        border: 1px solid #fde68a;
    }

    .fta-status-leave {
        color: #0369a1;
        background: #f0f9ff;
        border: 1px solid #bae6fd;
    }

    .fta-status-absent {
        color: #b91c1c;
        background: #fef2f2;
        border: 1px solid #fecaca;
    }

    /* =========================================================
           EMPTY STATE
           ========================================================= */

    .fta-empty {
        padding: 4rem 1.25rem !important;
        background: radial-gradient(circle at center, rgba(37,99,235,.025), transparent 45%);
    }

    .fta-empty-icon {
        width: 65px;
        height: 65px;
        margin: 0 auto 1rem;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 18px;
        background: #f1f5f9;
        border: 1px solid #e2e8f0;
        color: #94a3b8;
        font-size: 1.5rem;
        animation: ftaEmptyFloat 3s ease-in-out infinite;
    }

    .fta-empty-title {
        margin-bottom: .3rem;
        color: #334155;
        font-size: .9rem;
        font-weight: 750;
    }

    .fta-empty-text {
        color: #94a3b8;
        font-size: .75rem;
    }

    /* =========================================================
           SCROLLBAR
           ========================================================= */

    .fta-table-wrapper::-webkit-scrollbar {
        height: 7px;
    }

    .fta-table-wrapper::-webkit-scrollbar-track {
        background: #f8fafc;
    }

    .fta-table-wrapper::-webkit-scrollbar-thumb {
        border-radius: 20px;
        background: #cbd5e1;
    }

        .fta-table-wrapper::-webkit-scrollbar-thumb:hover {
            background: #94a3b8;
        }

    /* =========================================================
           RESPONSIVE
           ========================================================= */

    @@media (max-width: 1199.98px) {
        .fta-kpi {
            min-height: 118px;
        }

        .fta-kpi-value {
            font-size: 1.45rem;
        }

        .fta-filter-panel .input-group {
            width: 205px !important;
        }
    }

    @@media (max-width: 991.98px) {
        .finance-team-page {
            padding-top: .8rem !important;
        }

        .fta-page-header {
            padding: 1.1rem;
        }

        .fta-title {
            font-size: 1.2rem;
        }

        .fta-table-header {
            padding: 1rem !important;
        }

            .fta-table-header::after {
                left: 1rem;
                right: 1rem;
            }

        .fta-filter-panel {
            width: 100%;
        }

            .fta-filter-panel .input-group {
                width: 100% !important;
            }

            .fta-filter-panel .form-select {
                flex: 1 1 160px;
            }
    }

    @@media (max-width: 767.98px) {
        .finance-team-page {
            overflow-x: hidden;
        }

        .fta-page-header {
            border-radius: 13px;
            padding: 1rem;
        }

            .fta-page-header .d-flex {
                width: 100%;
            }

        .fta-date-control {
            width: 100%;
            padding: .45rem;
        }

            .fta-date-control form {
                width: 100%;
            }

            .fta-date-control .form-control {
                flex: 1 1 auto;
                min-width: 0;
            }

        .fta-refresh-btn {
            flex: 0 0 auto;
        }

        .fta-title {
            font-size: 1.08rem;
        }

        .fta-title-icon {
            width: 34px;
            height: 34px;
            font-size: .9rem;
        }

        .fta-kpi {
            min-height: 105px;
            padding: .95rem;
            border-radius: 13px;
        }

        .fta-kpi-icon {
            width: 45px;
            height: 45px;
            min-width: 45px;
            border-radius: 11px;
            font-size: 1rem;
        }

        .fta-kpi-label {
            font-size: .63rem;
        }

        .fta-kpi-value {
            font-size: 1.3rem;
        }

        .fta-kpi-status {
            font-size: .64rem;
        }

        .fta-table-card {
            border-radius: 13px !important;
        }

        .fta-table-header {
            align-items: stretch !important;
        }

        .fta-filter-panel {
            padding: .5rem;
        }

            .fta-filter-panel .form-select {
                width: 100% !important;
                flex: 1 1 100%;
            }

        .fta-filter-btn {
            width: 100%;
        }

        .fta-table {
            min-width: 980px;
        }

            .fta-table thead th,
            .fta-table tbody td {
                padding-left: .75rem;
                padding-right: .75rem;
            }
    }

    @@media (max-width: 575.98px) {
        .finance-team-page {
            padding-left: .55rem !important;
            padding-right: .55rem !important;
        }

        .fta-page-header {
            padding: .9rem;
        }

        .fta-breadcrumb .breadcrumb-item {
            font-size: .68rem;
        }

        .fta-title {
            font-size: 1rem;
        }

        .fta-title-icon {
            width: 31px;
            height: 31px;
            margin-right: .35rem;
        }

        .fta-date-control {
            display: block !important;
        }

            .fta-date-control form {
                display: flex !important;
                flex-direction: column;
                gap: .45rem !important;
            }

            .fta-date-control .form-control,
            .fta-refresh-btn {
                width: 100%;
            }

        .fta-kpi {
            min-height: 96px;
            padding: .85rem;
        }

        .fta-kpi-icon {
            width: 40px;
            height: 40px;
            min-width: 40px;
            border-radius: 10px;
            font-size: .9rem;
        }

        .fta-kpi-label {
            font-size: .58rem;
        }

        .fta-kpi-value {
            font-size: 1.18rem;
        }

        .fta-kpi-status {
            font-size: .58rem;
        }

        .fta-section-icon {
            width: 32px;
            height: 32px;
            min-width: 32px;
        }

        .fta-section-title {
            font-size: .84rem;
        }

        .fta-section-subtitle {
            font-size: .67rem;
        }

        .fta-table-header {
            padding: .85rem !important;
        }

            .fta-table-header::after {
                left: .85rem;
                right: .85rem;
            }
    }

    /* =========================================================
           ACCESSIBILITY / REDUCED MOTION
           ========================================================= */

    @@media (prefers-reduced-motion: reduce) {
        .finance-team-page *,
        .finance-team-page *::before,
        .finance-team-page *::after {
            animation-duration: .01ms !important;
            animation-iteration-count: 1 !important;
            transition-duration: .01ms !important;
            scroll-behavior: auto !important;
        }
    }

    /* =========================================================
           ANIMATIONS
           ========================================================= */

    @@keyframes ftaPageIn {
        from {
            opacity: 0;
            transform: translateY(9px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@keyframes ftaCardIn {
        from {
            opacity: 0;
            transform: translateY(12px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@keyframes ftaIconFloat {
        0%, 100% {
            transform: translateY(0);
        }

        50% {
            transform: translateY(-3px);
        }
    }

    @@keyframes ftaRotate {
        from {
            transform: rotate(0deg);
        }

        to {
            transform: rotate(360deg);
        }
    }

    @@keyframes ftaEmptyFloat {
        0%, 100% {
            transform: translateY(0);
        }

        50% {
            transform: translateY(-5px);
        }
    }
</style>

<div class="container-fluid py-4 text-start finance-team-page">

    <!-- =====================================================
         PAGE HEADER
         ===================================================== -->

    <div class="fta-page-header">

        <div class="fta-header-content">

            <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">

                <div>

                    <nav aria-label="breadcrumb">

                        <ol class="breadcrumb fta-breadcrumb mb-1">

                            <li class="breadcrumb-item">
                                <a href="/Finance" class="text-decoration-none">
                                    Finance & Treasury
                                </a>
                            </li>

                            <li class="breadcrumb-item active text-primary"
                                aria-current="page">
                                Team Attendance
                            </li>

                        </ol>

                    </nav>

                    <h4 class="fw-bold mb-1 text-dark fta-title">

                        <span class="fta-title-icon">
                            <i class="fa-solid fa-users-viewfinder"></i>
                        </span>

                        Finance Team Attendance Radar

                    </h4>

                    <p class="text-muted small mb-0">
                        Monitor attendance, punch activity and reporting staff availability.
                    </p>

                </div>

                <div class="fta-date-control">

                    <form method="get"
                          action="/Finance/TeamAttendance"
                          class="d-flex align-items-center gap-2">

                        <input type="date"
                               name="selectedDate"
                               class="form-control form-control-sm shadow-none"
                               value="@Model.SelectedDate.ToString("yyyy-MM-dd")"
                               onchange="this.form.submit()" />

                        <button type="submit"
                                class="btn btn-sm fta-refresh-btn">

                            <i class="fa-solid fa-rotate me-1"></i>
                            Refresh

                        </button>

                    </form>

                </div>

            </div>

        </div>

    </div>


    <!-- =====================================================
         KPI SUMMARY
         ===================================================== -->

    <div class="row g-3 mb-4">

        <!-- Direct Subordinates -->

        <div class="col-12 col-sm-6 col-xl-3">

            <div class="fta-kpi">

                <div class="fta-kpi-inner">

                    <div class="d-flex align-items-center justify-content-between gap-3">

                        <div>

                            <span class="fta-kpi-label">
                                Direct Subordinates
                            </span>

                            <h3 class="fta-kpi-value fw-bold text-dark">
                                @Model.TotalTeam
                            </h3>

                            <div class="fta-kpi-status">
                                <i class="fa-solid fa-circle text-primary"></i>
                                Reporting Team
                            </div>

                        </div>

                        <div class="fta-kpi-icon bg-primary-subtle text-primary">

                            <i class="fa-solid fa-user-group"></i>

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- Present -->

        <div class="col-12 col-sm-6 col-xl-3">

            <div class="fta-kpi">

                <div class="fta-kpi-inner">

                    <div class="d-flex align-items-center justify-content-between gap-3">

                        <div>

                            <span class="fta-kpi-label">
                                Present Today
                            </span>

                            <h3 class="fta-kpi-value fw-bold text-success">
                                @Model.PresentCount
                            </h3>

                            <div class="fta-kpi-status">
                                <i class="fa-solid fa-circle text-success"></i>
                                Active at Work
                            </div>

                        </div>

                        <div class="fta-kpi-icon bg-success-subtle text-success">

                            <i class="fa-solid fa-user-check"></i>

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- Late -->

        <div class="col-12 col-sm-6 col-xl-3">

            <div class="fta-kpi">

                <div class="fta-kpi-inner">

                    <div class="d-flex align-items-center justify-content-between gap-3">

                        <div>

                            <span class="fta-kpi-label">
                                Late Check-ins
                            </span>

                            <h3 class="fta-kpi-value fw-bold text-warning">
                                @Model.LateCount
                            </h3>

                            <div class="fta-kpi-status">
                                <i class="fa-solid fa-circle text-warning"></i>
                                Requires Attention
                            </div>

                        </div>

                        <div class="fta-kpi-icon bg-warning-subtle text-warning">

                            <i class="fa-solid fa-user-clock"></i>

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- Not Clocked -->

        <div class="col-12 col-sm-6 col-xl-3">

            <div class="fta-kpi">

                <div class="fta-kpi-inner">

                    <div class="d-flex align-items-center justify-content-between gap-3">

                        <div>

                            <span class="fta-kpi-label">
                                Not Clocked / Absent
                            </span>

                            <h3 class="fta-kpi-value fw-bold text-danger">
                                @Model.NotClockedInCount
                            </h3>

                            <div class="fta-kpi-status">
                                <i class="fa-solid fa-circle text-danger"></i>
                                Pending Attendance
                            </div>

                        </div>

                        <div class="fta-kpi-icon bg-danger-subtle text-danger">

                            <i class="fa-solid fa-user-xmark"></i>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- =====================================================
         ATTENDANCE TABLE
         ===================================================== -->

    <div class="card fta-table-card">

        <!-- Table Header -->

        <div class="card-header bg-white border-0 fta-table-header">

            <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">

                <div class="d-flex align-items-center">

                    <span class="fta-section-icon">
                        <i class="fa-solid fa-calendar-day"></i>
                    </span>

                    <div>

                        <h6 class="fw-bold mb-0 text-dark fta-section-title">

                            Attendance Records for
                            @Model.SelectedDate.ToString("dd MMMM yyyy")

                        </h6>

                        <span class="fta-section-subtitle">
                            Live punch logs of your reporting staff
                        </span>

                    </div>

                </div>


                <!-- Filters -->

                <form method="get"
                      action="/Finance/TeamAttendance"
                      class="fta-filter-panel d-flex align-items-center gap-2 flex-wrap">

                    <input type="hidden"
                           name="selectedDate"
                           value="@Model.SelectedDate.ToString("yyyy-MM-dd")" />

                    <div class="input-group input-group-sm">

                        <span class="input-group-text">

                            <i class="fa-solid fa-magnifying-glass"></i>

                        </span>

                        <input type="text"
                               name="search"
                               class="form-control"
                               placeholder="Search employee..."
                               value="@Model.SearchQuery" />

                    </div>


                    <select name="statusFilter"
                            class="form-select form-select-sm"
                            style="width:160px;"
                            onchange="this.form.submit()">

                        <option value="All"
                                selected="@(Model.StatusFilter == "All")">
                            All Statuses
                        </option>

                        <option value="Present"
                                selected="@(Model.StatusFilter == "Present")">
                            Present
                        </option>

                        <option value="Late"
                                selected="@(Model.StatusFilter == "Late")">
                            Late Check-in
                        </option>

                        <option value="Leave"
                                selected="@(Model.StatusFilter == "Leave")">
                            On Leave
                        </option>

                        <option value="Not Clocked In"
                                selected="@(Model.StatusFilter == "Not Clocked In")">
                            Not Clocked In
                        </option>

                    </select>


                    <button type="submit"
                            class="btn btn-sm fta-filter-btn">

                        <i class="fa-solid fa-filter me-1"></i>
                        Filter

                    </button>

                </form>

            </div>

        </div>


        <!-- Table -->

        <div class="fta-table-wrapper">

            <table class="table table-hover align-middle fta-table">

                <thead>

                    <tr>

                        <th class="ps-4">
                            Employee
                        </th>

                        <th>
                            Department / Role
                        </th>

                        <th>
                            Clock In
                        </th>

                        <th>
                            Clock Out
                        </th>

                        <th>
                            Duration
                        </th>

                        <th>
                            Source
                        </th>

                        <th>
                            Status
                        </th>

                        <th class="pe-4">
                            Remarks
                        </th>

                    </tr>

                </thead>


                <tbody>

                    @if (Model.TeamAttendanceList != null && Model.TeamAttendanceList.Any())
                    {
                        foreach (var item in Model.TeamAttendanceList)
                        {
                            var initials = !string.IsNullOrWhiteSpace(item.EmployeeName)
                            ? string.Join("", item.EmployeeName.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(x => x[0])).ToUpper()
                            : "EM";

                            <tr>

                                <!-- Employee -->

                                <td class="ps-4">

                                    <div class="d-flex align-items-center gap-3">

                                        <div class="fta-avatar">
                                            @initials
                                        </div>

                                        <div>

                                            <div class="fta-employee-name">
                                                @item.EmployeeName
                                            </div>

                                            <code class="fta-employee-code">
                                                @item.EmployeeCode
                                            </code>

                                        </div>

                                    </div>

                                </td>


                                <!-- Department / Role -->

                                <td>

                                    <div class="fta-role">
                                        @item.Role
                                    </div>

                                    <div class="fta-department">
                                        @item.Department
                                    </div>

                                </td>


                                <!-- Clock In -->

                                <td>

                                    @if (item.CheckInTime != "-")
                                    {
                                        <span class="fta-time fta-time-in">

                                            <i class="fa-solid fa-right-to-bracket"></i>

                                            @item.CheckInTime

                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            -
                                        </span>
                                    }

                                </td>


                                <!-- Clock Out -->

                                <td>

                                    @if (item.CheckOutTime != "-")
                                    {
                                        <span class="fta-time fta-time-out">

                                            <i class="fa-solid fa-right-from-bracket"></i>

                                            @item.CheckOutTime

                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            -
                                        </span>
                                    }

                                </td>


                                <!-- Duration -->

                                <td>

                                    <span class="fta-duration">

                                        <i class="fa-regular fa-clock text-muted"></i>

                                        @item.WorkHours

                                    </span>

                                </td>


                                <!-- Source -->

                                <td>

                                    <span class="fta-source-badge">

                                        <i class="fa-solid fa-tower-broadcast"></i>

                                        @item.PunchSource

                                    </span>

                                </td>


                                <!-- Status -->

                                <td>

                                    @if (item.Status.StartsWith("Present"))
                                    {
                                        <span class="fta-status-badge fta-status-present">

                                            <i class="fa-solid fa-circle-check me-1"></i>

                                            Present

                                        </span>
                                    }
                                    else if (item.Status.Contains("Late"))
                                    {
                                        <span class="fta-status-badge fta-status-late">

                                            <i class="fa-solid fa-clock me-1"></i>

                                            Late Check-in

                                        </span>
                                    }
                                    else if (item.Status.Contains("Leave"))
                                    {
                                        <span class="fta-status-badge fta-status-leave">

                                            <i class="fa-solid fa-umbrella-beach me-1"></i>

                                            On Leave

                                        </span>
                                    }
                                    else
                                    {
                                        <span class="fta-status-badge fta-status-absent">

                                            <i class="fa-solid fa-circle-xmark me-1"></i>

                                            Not Clocked In

                                        </span>
                                    }

                        </td>


                        <!-- Remarks -->

                        <td class="pe-4">

                            <span class="text-muted small">

                                @(string.IsNullOrWhiteSpace(item.Remarks)
                                                                ? "Standard shift entry"
                                                                : item.Remarks)

                            </span>

                                </td>

                            </tr>
                                        }
                    }
                    else
                    {
                        <tr>

                            <td colspan="8"
                                class="text-center fta-empty">

                                <div class="fta-empty-icon">

                                    <i class="fa-solid fa-clipboard-user"></i>

                                </div>

                                <div class="fta-empty-title">
                                    No attendance records found
                                </div>

                                <div class="fta-empty-text">
                                    No subordinate attendance records match the current filter.
                                </div>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>
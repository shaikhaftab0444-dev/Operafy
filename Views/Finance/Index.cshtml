@model ERP_System.Models.FinanceDashboardViewModel

@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Financial Control Suite Dashboard";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

<style>
    /* =========================================================
           FINANCE DASHBOARD - PREMIUM UI
           ========================================================= */

    :root {
        --finance-primary: #2563eb;
        --finance-primary-dark: #1d4ed8;
        --finance-success: #10b981;
        --finance-warning: #f59e0b;
        --finance-danger: #ef4444;
        --finance-purple: #8b5cf6;
        --finance-dark: #0f172a;
        --finance-text: #334155;
        --finance-muted: #64748b;
        --finance-border: #e2e8f0;
        --finance-bg: #f8fafc;
        --finance-white: #ffffff;
        --finance-radius: 18px;
    }

    .finance-wrapper {
        min-height: 100vh;
        padding: 1rem 0 2.5rem;
        font-family: "Segoe UI", system-ui, -apple-system, BlinkMacSystemFont, sans-serif;
        color: var(--finance-text);
    }

    /* =========================
           PAGE ENTRANCE ANIMATION
           ========================= */

    .finance-page {
        animation: financePageEnter .65s ease both;
    }

    @@keyframes financePageEnter {
        from {
            opacity: 0;
            transform: translateY(14px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .finance-header {
        position: relative;
        overflow: hidden;
        padding: 1.35rem 1.5rem;
        margin-bottom: 1.4rem;
        border: 1px solid rgba(226, 232, 240, .85);
        border-radius: var(--finance-radius);
        background: rgba(255, 255, 255, .92);
        box-shadow: 0 8px 30px rgba(15, 23, 42, .045);
    }

        .finance-header::before {
            content: "";
            position: absolute;
            width: 220px;
            height: 220px;
            right: -90px;
            top: -130px;
            border-radius: 50%;
            background: rgba(37, 99, 235, .07);
            pointer-events: none;
        }

        .finance-header::after {
            content: "";
            position: absolute;
            width: 120px;
            height: 120px;
            right: 110px;
            bottom: -85px;
            border-radius: 50%;
            background: rgba(139, 92, 246, .055);
            pointer-events: none;
        }

    .header-content {
        position: relative;
        z-index: 2;
    }

    .module-label {
        display: inline-flex;
        align-items: center;
        gap: .45rem;
        color: var(--finance-primary);
        font-size: .72rem;
        font-weight: 800;
        letter-spacing: .12em;
        text-transform: uppercase;
        margin-bottom: .3rem;
    }

        .module-label::before {
            content: "";
            width: 7px;
            height: 7px;
            border-radius: 50%;
            background: var(--finance-success);
            box-shadow: 0 0 0 5px rgba(16, 185, 129, .10);
            animation: pulseDot 2s infinite;
        }

    @@keyframes pulseDot {
        0%, 100% {
            box-shadow: 0 0 0 4px rgba(16, 185, 129, .10);
        }

        50% {
            box-shadow: 0 0 0 8px rgba(16, 185, 129, .03);
        }
    }

    .page-title {
        margin: 0;
        color: var(--finance-dark);
        font-size: clamp(1.25rem, 2vw, 1.65rem);
        font-weight: 800;
        letter-spacing: -.035em;
    }

    .page-subtitle {
        margin: .35rem 0 0;
        color: var(--finance-muted);
        font-size: .84rem;
    }

    /* =========================
           QUICK ACTIONS
           ========================= */

    .finance-actions {
        display: flex;
        flex-wrap: wrap;
        gap: .5rem;
        position: relative;
        z-index: 3;
    }

    .finance-action {
        min-height: 38px;
        padding: .48rem .8rem;
        border-radius: 10px !important;
        font-size: .76rem;
        font-weight: 700;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: .42rem;
        transition: all .25s ease;
        white-space: nowrap;
    }

        .finance-action:hover {
            transform: translateY(-2px);
            box-shadow: 0 7px 18px rgba(15, 23, 42, .10);
        }

    /* =========================
           COMMON CARD
           ========================= */

    .finance-card {
        position: relative;
        overflow: hidden;
        height: 100%;
        background: rgba(255, 255, 255, .96);
        border: 1px solid rgba(226, 232, 240, .9);
        border-radius: var(--finance-radius);
        box-shadow: 0 7px 28px rgba(15, 23, 42, .045);
        transition: transform .3s ease, box-shadow .3s ease, border-color .3s ease;
    }

        .finance-card::before {
            content: "";
            position: absolute;
            left: 0;
            top: 0;
            width: 100%;
            height: 3px;
            background: linear-gradient( 90deg, transparent, rgba(37, 99, 235, .12), transparent );
            transform: translateX(-100%);
            transition: transform .6s ease;
        }

        .finance-card:hover {
            transform: translateY(-3px);
            border-color: rgba(148, 163, 184, .65);
            box-shadow: 0 16px 38px rgba(15, 23, 42, .08);
        }

            .finance-card:hover::before {
                transform: translateX(100%);
            }

    .card-title-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        padding-bottom: .9rem;
        margin-bottom: 1rem;
        border-bottom: 1px solid #eef2f7;
    }

    .card-title {
        display: flex;
        align-items: center;
        gap: .65rem;
        margin: 0;
        color: var(--finance-dark);
        font-size: .96rem;
        font-weight: 800;
        letter-spacing: -.01em;
    }

        .card-title i {
            width: 32px;
            height: 32px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border-radius: 9px;
            background: rgba(37, 99, 235, .08);
            color: var(--finance-primary);
            font-size: .82rem;
        }

    /* =========================
           KPI CARDS
           ========================= */

    .kpi-card {
        min-height: 145px;
        border-left: 4px solid transparent;
    }

    .kpi-liquidity {
        border-left-color: var(--finance-success);
    }

    .kpi-receivable {
        border-left-color: var(--finance-primary);
    }

    .kpi-payable {
        border-left-color: var(--finance-warning);
    }

    .kpi-margin {
        border-left-color: var(--finance-purple);
    }

    .kpi-inner {
        padding: 1.1rem 1.05rem;
    }

    .kpi-label {
        display: block;
        color: var(--finance-muted);
        font-size: .73rem;
        font-weight: 750;
        text-transform: uppercase;
        letter-spacing: .045em;
    }

    .kpi-value {
        margin: .45rem 0 .35rem;
        color: var(--finance-dark);
        font-size: clamp(1.15rem, 2vw, 1.5rem);
        font-weight: 800;
        letter-spacing: -.045em;
        line-height: 1.15;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        cursor: help;
    }

    .kpi-subtitle {
        display: block;
        font-size: .72rem;
        font-weight: 700;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    /* =========================
           COMPACT MONEY
           ========================= */

    .compact-money {
        cursor: help;
        display: inline-block;
    }

        .compact-money:hover {
            text-decoration: underline dotted;
            text-underline-offset: 3px;
        }

    .money-tooltip {
        position: relative;
        cursor: help;
    }

        .money-tooltip::after {
            content: attr(data-full-value);
            position: absolute;
            left: 50%;
            bottom: calc(100% + 10px);
            transform: translateX(-50%) translateY(4px);
            background: #0f172a;
            color: #ffffff;
            padding: .5rem .7rem;
            border-radius: 8px;
            font-size: .72rem;
            font-weight: 700;
            line-height: 1.2;
            white-space: nowrap;
            box-shadow: 0 8px 22px rgba(15, 23, 42, .18);
            opacity: 0;
            visibility: hidden;
            pointer-events: none;
            transition: opacity .18s ease, transform .18s ease;
            z-index: 1000;
        }

        .money-tooltip::before {
            content: "";
            position: absolute;
            left: 50%;
            bottom: calc(100% + 4px);
            transform: translateX(-50%);
            border: 5px solid transparent;
            border-top-color: #0f172a;
            opacity: 0;
            visibility: hidden;
            transition: opacity .18s ease;
            z-index: 1001;
        }

        .money-tooltip:hover::after {
            opacity: 1;
            visibility: visible;
            transform: translateX(-50%) translateY(0);
        }

        .money-tooltip:hover::before {
            opacity: 1;
            visibility: visible;
        }

    .kpi-icon-box {
        width: 46px;
        height: 46px;
        min-width: 46px;
        border-radius: 13px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.05rem;
        transition: transform .35s ease;
    }

    .finance-card:hover .kpi-icon-box {
        transform: rotate(-5deg) scale(1.08);
    }

    .kpi-icon-emerald {
        background: rgba(16, 185, 129, .11);
        color: var(--finance-success);
    }

    .kpi-icon-blue {
        background: rgba(37, 99, 235, .10);
        color: var(--finance-primary);
    }

    .kpi-icon-amber {
        background: rgba(245, 158, 11, .11);
        color: var(--finance-warning);
    }

    .kpi-icon-purple {
        background: rgba(139, 92, 246, .11);
        color: var(--finance-purple);
    }

    .glow-emerald {
        text-shadow: 0 0 18px rgba(16, 185, 129, .18);
    }

    .glow-blue {
        text-shadow: 0 0 18px rgba(37, 99, 235, .16);
    }

    .glow-amber {
        text-shadow: 0 0 18px rgba(245, 158, 11, .16);
    }

    .glow-purple {
        text-shadow: 0 0 18px rgba(139, 92, 246, .16);
    }

    /* =========================
           CHART
           ========================= */

    .chart-card {
        min-height: 430px;
    }

    .chart-container {
        position: relative;
        height: 335px;
        width: 100%;
    }

    .chart-switch {
        display: inline-flex;
        border: 1px solid #e2e8f0;
        border-radius: 10px;
        padding: 3px;
        background: #f8fafc;
    }

        .chart-switch .btn {
            border: 0 !important;
            border-radius: 7px !important;
            font-size: .7rem;
            font-weight: 700;
            padding: .38rem .7rem;
        }

            .chart-switch .btn.active {
                background: #fff;
                color: var(--finance-primary);
                box-shadow: 0 2px 8px rgba(15, 23, 42, .08);
            }

    /* =========================
           BUDGET
           ========================= */

    .budget-item {
        padding: .75rem;
        border: 1px solid #eef2f7;
        border-radius: 12px;
        background: #fbfdff;
        transition: all .25s ease;
    }

        .budget-item:hover {
            transform: translateX(3px);
            border-color: #dbe5f0;
            background: #fff;
            box-shadow: 0 5px 16px rgba(15, 23, 42, .04);
        }

    .budget-label {
        color: var(--finance-text);
        font-size: .76rem;
        font-weight: 750;
    }

    .budget-value {
        color: var(--finance-dark);
        font-size: .7rem;
        font-weight: 750;
    }

    .budget-progress {
        height: 9px !important;
        overflow: hidden;
        border-radius: 20px !important;
        background: #edf2f7;
    }

        .budget-progress .progress-bar {
            border-radius: 20px;
            transition: width 1s cubic-bezier(.22, 1, .36, 1);
        }

    /* =========================
           TABLES
           ========================= */

    .finance-table-wrapper {
        overflow-x: auto;
        border: 1px solid #eef2f7;
        border-radius: 13px;
    }

    .finance-table {
        width: 100%;
        min-width: 850px;
        margin: 0 !important;
        vertical-align: middle;
    }

        .finance-table thead th {
            padding: .82rem .9rem;
            color: #64748b;
            background: #f8fafc;
            border-bottom: 1px solid #e2e8f0;
            font-size: .68rem;
            font-weight: 800;
            letter-spacing: .045em;
            text-transform: uppercase;
            white-space: nowrap;
        }

        .finance-table tbody td {
            padding: .9rem;
            color: #475569;
            border-bottom: 1px solid #f1f5f9;
            font-size: .78rem;
            white-space: nowrap;
        }

        .finance-table tbody tr {
            transition: background .2s ease, transform .2s ease;
        }

            .finance-table tbody tr:hover {
                background: #f8fbff;
            }

            .finance-table tbody tr:last-child td {
                border-bottom: 0;
            }

    .bill-number {
        color: var(--finance-primary);
        font-weight: 800;
    }

    .amount-cell {
        color: var(--finance-dark) !important;
        font-weight: 800;
    }

    .description-cell {
        max-width: 300px;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    /* =========================
           ACTION BUTTONS
           ========================= */

    .btn-action {
        min-height: 34px;
        padding: .4rem .72rem;
        border-radius: 9px !important;
        font-size: .72rem;
        font-weight: 750;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: .35rem;
        transition: all .22s ease;
    }

        .btn-action:hover {
            transform: translateY(-2px);
        }

    .table-icon-btn {
        width: 34px;
        height: 34px;
        padding: 0;
        border-radius: 9px !important;
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }

    /* =========================
           STATUS / BADGES
           ========================= */

    .finance-status {
        display: inline-flex;
        align-items: center;
        gap: .4rem;
        padding: .35rem .6rem;
        border-radius: 20px;
        font-size: .67rem;
        font-weight: 800;
    }

    .status-dot {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: currentColor;
    }

    .empty-state {
        padding: 2.8rem 1rem !important;
        text-align: center;
        color: #94a3b8 !important;
    }

        .empty-state i {
            display: block;
            margin-bottom: .65rem;
            font-size: 1.7rem;
            opacity: .5;
        }

    /* =========================
           SECTION ANIMATION
           ========================= */

    .animate-section {
        opacity: 0;
        animation: sectionReveal .65s ease forwards;
    }

    .delay-1 {
        animation-delay: .08s;
    }

    .delay-2 {
        animation-delay: .16s;
    }

    .delay-3 {
        animation-delay: .24s;
    }

    .delay-4 {
        animation-delay: .32s;
    }

    @@keyframes sectionReveal {
        from {
            opacity: 0;
            transform: translateY(16px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* =========================
           RESPONSIVE
           ========================= */

    @@media (max-width: 1199.98px) {
        .finance-actions {
            width: 100%;
        }

        .finance-header {
            padding: 1.2rem;
        }

        .chart-card {
            min-height: 400px;
        }

        .chart-container {
            height: 300px;
        }
    }

    @@media (max-width: 767.98px) {
        .finance-wrapper {
            padding-top: .5rem;
        }

        .finance-header {
            padding: 1rem;
            border-radius: 14px;
        }

        .finance-actions {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            width: 100%;
        }

        .finance-action {
            width: 100%;
            padding: .55rem .5rem;
            font-size: .69rem;
        }

        .kpi-card {
            min-height: 130px;
        }

        .kpi-inner {
            padding: .9rem;
        }

        .kpi-value {
            font-size: 1.12rem;
        }

        .kpi-icon-box {
            width: 40px;
            height: 40px;
            min-width: 40px;
        }

        .finance-card {
            border-radius: 14px;
        }

        .card-title-row {
            align-items: flex-start;
        }

        .card-title {
            font-size: .86rem;
        }

        .chart-card {
            min-height: 360px;
        }

        .chart-container {
            height: 260px;
        }

        .chart-switch {
            display: none;
        }

        .money-tooltip::after {
            display: none;
        }

        .money-tooltip::before {
            display: none;
        }
    }

    @@media (max-width: 479.98px) {
        .finance-actions {
            grid-template-columns: 1fr;
        }

        .page-title {
            font-size: 1.18rem;
        }

        .page-subtitle {
            font-size: .76rem;
        }

        .kpi-value {
            font-size: 1.02rem;
        }

        .chart-container {
            height: 235px;
        }
    }

    /* =========================
           REDUCED MOTION
           ========================= */

    @@media (prefers-reduced-motion: reduce) {
        *,
        *::before,
        *::after {
            animation-duration: .01ms !important;
            animation-iteration-count: 1 !important;
            transition-duration: .01ms !important;
            scroll-behavior: auto !important;
        }
    }
</style>

<div class="finance-wrapper finance-page">

    <div class="container-fluid px-3 px-xl-4">

        <!-- =========================
             HEADER
             ========================= -->

        <div class="finance-header animate-section">

            <div class="header-content">

                <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">

                    <div>

                        <div class="module-label">
                            Financial Control Suite
                        </div>

                        <h1 class="page-title">
                            CFO Executive Dashboard
                        </h1>

                        <p class="page-subtitle">
                            Monitor liquidity, receivables, payables, profitability and financial operations from one place.
                        </p>

                    </div>

                    <div class="finance-actions">

                        <a asp-action="Receivables"
                           class="btn btn-outline-primary finance-action">
                            <i class="fa-solid fa-arrow-down-long"></i>
                            Receivables
                        </a>

                        <a asp-action="Payables"
                           class="btn btn-outline-warning finance-action">
                            <i class="fa-solid fa-arrow-up-long"></i>
                            Payables
                        </a>

                        <a asp-action="Ledger"
                           class="btn btn-outline-secondary finance-action">
                            <i class="fa-solid fa-book-open"></i>
                            Ledger
                        </a>

                        <a asp-action="BankRecon"
                           class="btn btn-outline-success finance-action">
                            <i class="fa-solid fa-building-columns"></i>
                            Bank Recon
                        </a>

                        <a asp-action="FixedAssets"
                           class="btn btn-outline-dark finance-action">
                            <i class="fa-solid fa-laptop-file"></i>
                            Fixed Assets
                        </a>

                        <a asp-action="Taxation"
                           class="btn btn-outline-info finance-action">
                            <i class="fa-solid fa-percent"></i>
                            Taxation
                        </a>

                        <a asp-action="Reports"
                           class="btn btn-primary finance-action">
                            <i class="fa-solid fa-file-invoice-dollar"></i>
                            Reports
                        </a>

                    </div>

                </div>

            </div>

        </div>

        <!-- =========================
             KPI CARDS
             ========================= -->

        <div class="row g-3 mb-4">

            <!-- Liquidity -->

            <div class="col-xl-3 col-md-6 animate-section delay-1">

                <div class="finance-card kpi-card kpi-liquidity h-100">

                    <div class="kpi-inner">

                        <div class="d-flex align-items-center justify-content-between gap-3">

                            <div class="flex-grow-1 min-w-0">

                                <span class="kpi-label">
                                    Cash & Bank Liquidity
                                </span>

                                <div class="kpi-value glow-emerald money-tooltip"
                                     data-money-value="@Convert.ToString(Model.TotalLiquidCash, System.Globalization.CultureInfo.InvariantCulture)">
                                </div>

                                <span class="kpi-subtitle text-success">
                                    <i class="fa-solid fa-circle-check me-1"></i>
                                    Available Balance
                                </span>

                            </div>

                            <div class="kpi-icon-box kpi-icon-emerald">
                                <i class="fa-solid fa-building-columns"></i>
                            </div>

                        </div>

                    </div>

                </div>

            </div>

            <!-- Receivable -->

            <div class="col-xl-3 col-md-6 animate-section delay-1">

                <div class="finance-card kpi-card kpi-receivable h-100">

                    <div class="kpi-inner">

                        <div class="d-flex align-items-center justify-content-between gap-3">

                            <div class="flex-grow-1 min-w-0">

                                <span class="kpi-label">
                                    Accounts Receivable (AR)
                                </span>

                                <div class="kpi-value glow-blue money-tooltip"
                                     data-money-value="@Convert.ToString(Model.AccountsReceivableTotal, System.Globalization.CultureInfo.InvariantCulture)">
                                </div>

                                <span class="kpi-subtitle text-danger money-tooltip"
                                      data-money-value="1410000">
                                    <i class="fa-solid fa-clock-rotate-left me-1"></i>
                                    Overdue: <span class="compact-money"></span>
                                </span>

                            </div>

                            <div class="kpi-icon-box kpi-icon-blue">
                                <i class="fa-solid fa-money-bill-trend-up"></i>
                            </div>

                        </div>

                    </div>

                </div>

            </div>

            <!-- Payable -->

            <div class="col-xl-3 col-md-6 animate-section delay-2">

                <div class="finance-card kpi-card kpi-payable h-100">

                    <div class="kpi-inner">

                        <div class="d-flex align-items-center justify-content-between gap-3">

                            <div class="flex-grow-1 min-w-0">

                                <span class="kpi-label">
                                    Accounts Payable (AP)
                                </span>

                                <div class="kpi-value glow-amber money-tooltip"
                                     data-money-value="@Convert.ToString(Model.AccountsPayableTotal, System.Globalization.CultureInfo.InvariantCulture)">
                                </div>

                                <span class="kpi-subtitle text-warning money-tooltip"
                                      data-money-value="1200000">
                                    <i class="fa-solid fa-calendar-day me-1"></i>
                                    Due this week: <span class="compact-money"></span>
                                </span>

                            </div>

                            <div class="kpi-icon-box kpi-icon-amber">
                                <i class="fa-solid fa-receipt"></i>
                            </div>

                        </div>

                    </div>

                </div>

            </div>

            <!-- Profit -->

            <div class="col-xl-3 col-md-6 animate-section delay-2">

                <div class="finance-card kpi-card kpi-margin h-100">

                    <div class="kpi-inner">

                        <div class="d-flex align-items-center justify-content-between gap-3">

                            <div class="flex-grow-1 min-w-0">

                                <span class="kpi-label">
                                    EBITDA & Profit Margin
                                </span>

                                <div class="kpi-value glow-purple">
                                    @Model.NetProfitMargin.ToString("F1")%
                                </div>

                                <span class="kpi-subtitle text-success">
                                    <i class="fa-solid fa-arrow-trend-up me-1"></i>
                                    +2.1% YoY Growth
                                </span>

                            </div>

                            <div class="kpi-icon-box kpi-icon-purple">
                                <i class="fa-solid fa-chart-line"></i>
                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>

        <!-- =========================
             ANALYTICS
             ========================= -->

        <div class="row g-4 mb-4">

            <!-- Cash Flow -->

            <div class="col-lg-8 animate-section delay-2">

                <div class="finance-card chart-card p-4">

                    <div class="card-title-row">

                        <h5 class="card-title">
                            <i class="fa-solid fa-scale-balanced"></i>
                            Cash Flow & Revenue Analytics
                        </h5>

                        <div class="chart-switch">

                            <button type="button"
                                    class="btn btn-outline-secondary active">
                                6 Months
                            </button>

                            <button type="button"
                                    class="btn btn-outline-secondary">
                                12 Months
                            </button>

                        </div>

                    </div>

                    <div class="chart-container">

                        <canvas id="cashFlowChart"></canvas>

                    </div>

                </div>

            </div>

            <!-- Budget -->

            <div class="col-lg-4 animate-section delay-3">

                <div class="finance-card p-4 h-100">

                    <div class="card-title-row">

                        <h5 class="card-title">

                            <i class="fa-solid fa-chart-pie"></i>

                            Budget Allocation

                        </h5>

                    </div>

                    <div class="d-flex flex-column gap-2">

                        @foreach (var budget in Model.DepartmentBudgets)
                        {
                            var burnRate = budget.BurnRatePercentage;

                            var colorClass = burnRate > 90
                            ? "bg-danger"
                            : (burnRate > 75 ? "bg-warning" : "bg-success");

                            <div class="budget-item">

                                <div class="d-flex justify-content-between align-items-center gap-2 mb-2">

                                    <span class="budget-label text-truncate">
                                        @budget.DepartmentName
                                    </span>

                                    <span class="budget-value text-end money-tooltip"
                                          data-money-value="@Convert.ToString(budget.Utilized, System.Globalization.CultureInfo.InvariantCulture)">
                                    </span>

                                    <span class="budget-value text-end">
                                        /
                                    </span>

                                    <span class="budget-value text-end money-tooltip"
                                          data-money-value="@Convert.ToString(budget.Allocated, System.Globalization.CultureInfo.InvariantCulture)">
                                    </span>

                                </div>

                                <div class="progress budget-progress">

                                    <div class="progress-bar @colorClass"
                                         role="progressbar"
                                         style="width: @burnRate%"
                                         aria-valuenow="@burnRate"
                                         aria-valuemin="0"
                                         aria-valuemax="100">
                                    </div>

                                </div>

                                <div class="text-end mt-1">

                                    <small class="text-muted fw-semibold">
                                        @burnRate.ToString("F0")% consumed
                                    </small>

                                </div>

                            </div>
                        }

                    </div>

                </div>

            </div>

        </div>

        <!-- =====================================================
             BOTTOM SECTION 1 - FULL WIDTH VENDOR APPROVALS
             ===================================================== -->

        <div class="row g-4 mb-4">

            <div class="col-12 animate-section delay-3">

                <div class="finance-card p-4">

                    <div class="card-title-row">

                        <h5 class="card-title">

                            <i class="fa-solid fa-user-shield"
                               style="background:rgba(239,68,68,.09);color:#ef4444;"></i>

                            High-Value Vendor Sign-offs

                            <span class="text-muted fw-semibold"
                                  style="font-size:.7rem;">
                                (&gt; ₹50,000)
                            </span>

                        </h5>

                        <span class="badge rounded-pill bg-danger-subtle text-danger border border-danger-subtle px-3 py-2">

                            <i class="fa-solid fa-shield-halved me-1"></i>

                            Approval Required

                        </span>

                    </div>

                    <div class="finance-table-wrapper">

                        <table class="table finance-table table-hover align-middle">

                            <thead>

                                <tr>
                                    <th>Bill No</th>
                                    <th>Vendor</th>
                                    <th>Amount</th>
                                    <th>Due Date</th>
                                    <th class="text-center">Action</th>
                                </tr>

                            </thead>

                            <tbody>

                                @if (Model.PendingPaymentAuthorizations != null && Model.PendingPaymentAuthorizations.Any())
                                {
                                    @foreach (var bill in Model.PendingPaymentAuthorizations)
                                    {
                                        <tr id="bill-row-@bill.BillId">

                                            <td>

                                                <span class="bill-number">
                                                    @bill.BillNo
                                                </span>

                                            </td>

                                            <td>

                                                <span class="fw-semibold text-dark">
                                                    @bill.VendorName
                                                </span>

                                            </td>

                                            <td class="amount-cell money-tooltip"
                                                data-money-value="@Convert.ToString(bill.Amount, System.Globalization.CultureInfo.InvariantCulture)">
                                            </td>

                                            <td>

                                                <span class="text-secondary">

                                                    <i class="fa-regular fa-calendar me-1"></i>

                                                    @bill.DueDate.ToString("dd-MMM-yyyy")

                                                </span>

                                            </td>

                                            <td class="text-center">

                                                <div class="d-flex justify-content-center flex-wrap gap-2">

                                                    <button type="button"
                                                            class="btn btn-success btn-action"
                                                            onclick="approveBill(@bill.BillId)">

                                                        <i class="fa-solid fa-check"></i>

                                                        Approve

                                                    </button>

                                                    <button type="button"
                                                            class="btn btn-outline-danger btn-action">

                                                        <i class="fa-solid fa-xmark"></i>

                                                        Reject

                                                    </button>

                                                </div>

                                            </td>

                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>

                                        <td colspan="5"
                                            class="empty-state">

                                            <i class="fa-solid fa-circle-check"></i>

                                            No pending high-value bills found.

                                        </td>

                                    </tr>
                                }

                            </tbody>

                        </table>

                    </div>

                </div>

            </div>

        </div>

        <!-- =====================================================
             BOTTOM SECTION 2 - FULL WIDTH TREASURY / JV
             ===================================================== -->

        <div class="row g-4">

            <div class="col-12 animate-section delay-4">

                <div class="finance-card p-4">

                    <div class="card-title-row">

                        <h5 class="card-title">

                            <i class="fa-solid fa-clock-rotate-left"
                               style="background:rgba(100,116,139,.09);color:#64748b;"></i>

                            Recent Treasury & JV Activity

                        </h5>

                        <a asp-action="Ledger"
                           class="btn btn-outline-secondary btn-action">

                            View Full Ledger

                            <i class="fa-solid fa-arrow-right"></i>

                        </a>

                    </div>

                    <div class="finance-table-wrapper">

                        <table class="table finance-table table-hover align-middle">

                            <thead>

                                <tr>
                                    <th>JV No</th>
                                    <th>Reference</th>
                                    <th>Description</th>
                                    <th>Debit</th>
                                    <th>Credit</th>
                                </tr>

                            </thead>

                            <tbody>

                                @foreach (var jv in Model.RecentTransactions)
                                {
                                    <tr>

                                        <td>

                                            <span class="fw-bold text-secondary">
                                                @jv.JournalNo
                                            </span>

                                        </td>

                                        <td>

                                            <span class="badge rounded-pill bg-light text-dark border px-3 py-2">
                                                @jv.Reference
                                            </span>

                                        </td>

                                        <td>

                                            <span class="description-cell d-block text-muted"
                                                  title="@jv.Description">

                                                @jv.Description

                                            </span>

                                        </td>

                                        <td>

                                            @if (jv.Debit > 0)
                                            {
                                                <span class="fw-bold text-success money-tooltip"
                                                      data-money-value="@Convert.ToString(jv.Debit, System.Globalization.CultureInfo.InvariantCulture)">
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="text-muted">
                                                    -
                                                </span>
                                            }

                                        </td>

                                        <td>

                                            @if (jv.Credit > 0)
                                            {
                                                <span class="fw-bold text-danger money-tooltip"
                                                      data-money-value="@Convert.ToString(jv.Credit, System.Globalization.CultureInfo.InvariantCulture)">
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="text-muted">
                                                    -
                                                </span>
                                            }

                                        </td>

                                    </tr>
                                }

                            </tbody>

                        </table>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>

@section Scripts {

    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <script>

        /* =====================================================
           INDIAN COMPACT MONEY FORMAT

           1,000       => ₹1K
           1,00,000    => ₹1L
           1,00,00,000 => ₹1Cr

           Hover:
           ₹1,00,000.00
           ===================================================== */

        function formatIndianCompact(value) {

            const number = Number(value);

            if (!Number.isFinite(number)) {
                return "₹0";
            }

            const absolute = Math.abs(number);
            const sign = number < 0 ? "-" : "";

            function cleanDecimal(num) {

                return num
                    .toFixed(2)
                    .replace(/\.00$/, "")
                    .replace(/(\.\d)0$/, "$1");

            }

            if (absolute >= 10000000) {

                return sign + "₹" + cleanDecimal(absolute / 10000000) + "Cr";

            }

            if (absolute >= 100000) {

                return sign + "₹" + cleanDecimal(absolute / 100000) + "L";

            }

            if (absolute >= 1000) {

                return sign + "₹" + cleanDecimal(absolute / 1000) + "K";

            }

            return sign + "₹" + absolute.toLocaleString("en-IN", {
                maximumFractionDigits: 2
            });

        }


        /* =====================================================
           FULL INDIAN NUMBER

           Example:
           100000 => ₹1,00,000.00
           ===================================================== */

        function formatIndianFull(value) {

            const number = Number(value);

            if (!Number.isFinite(number)) {
                return "₹0.00";
            }

            return "₹" + number.toLocaleString("en-IN", {
                minimumFractionDigits: 2,
                maximumFractionDigits: 2
            });

        }


        /* =====================================================
           APPLY COMPACT MONEY TO ALL MONEY ELEMENTS
           ===================================================== */

        document.querySelectorAll("[data-money-value]").forEach(function (element) {

            const value = element.getAttribute("data-money-value");

            const compactValue = formatIndianCompact(value);
            const fullValue = formatIndianFull(value);

            /*
             * If the element contains another element such as
             * the overdue/due-this-week icon and span,
             * only update the compact-money child.
             */

            const compactChild = element.querySelector(".compact-money");

            if (compactChild) {

                compactChild.textContent = compactValue;

            }
            else {

                element.textContent = compactValue;

            }

            element.setAttribute("data-full-value", fullValue);
            element.setAttribute("title", fullValue);
            element.setAttribute("aria-label", fullValue);

            element.classList.add("money-tooltip");

        });


        /* =====================================================
           CASH FLOW CHART
           Existing data source and functionality preserved
           ===================================================== */

        const chartElement = document.getElementById("cashFlowChart");

        if (chartElement) {

            const ctx = chartElement.getContext("2d");

            const labels = @Json.Serialize(Model.CashFlowTrend.Select(t => t.Month));
            const inflows = @Json.Serialize(Model.CashFlowTrend.Select(t => t.Inflow));
            const outflows = @Json.Serialize(Model.CashFlowTrend.Select(t => t.Outflow));


            new Chart(ctx, {

                type: "line",

                data: {

                    labels: labels,

                    datasets: [

                        {
                            label: "Cash Collections (Inflow)",

                            data: inflows,

                            borderColor: "#10b981",

                            backgroundColor: "rgba(16, 185, 129, 0.09)",

                            fill: true,

                            tension: 0.4,

                            borderWidth: 2.5,

                            pointRadius: 3,

                            pointHoverRadius: 6
                        },

                        {
                            label: "Cash Disbursements (Outflow)",

                            data: outflows,

                            borderColor: "#f59e0b",

                            backgroundColor: "rgba(245, 158, 11, 0.08)",

                            fill: true,

                            tension: 0.4,

                            borderWidth: 2.5,

                            pointRadius: 3,

                            pointHoverRadius: 6
                        }

                    ]

                },

                options: {

                    responsive: true,

                    maintainAspectRatio: false,

                    animation: {
                        duration: 1200,
                        easing: "easeOutQuart"
                    },

                    interaction: {
                        intersect: false,
                        mode: "index"
                    },

                    plugins: {

                        legend: {

                            position: "top",

                            align: "start",

                            labels: {

                                usePointStyle: true,

                                pointStyle: "circle",

                                padding: 18,

                                font: {
                                    size: 11,
                                    weight: "600"
                                }

                            }

                        },

                        tooltip: {

                            backgroundColor: "#0f172a",

                            titleColor: "#ffffff",

                            bodyColor: "#e2e8f0",

                            padding: 12,

                            cornerRadius: 10,

                            displayColors: true,

                            callbacks: {

                                label: function (context) {

                                    const value = context.raw;

                                    return context.dataset.label + ": " + formatIndianFull(value);

                                }

                            }

                        }

                    },

                    scales: {

                        x: {

                            grid: {
                                display: false
                            },

                            ticks: {

                                color: "#64748b",

                                font: {
                                    size: 10
                                }

                            }

                        },

                        y: {

                            beginAtZero: true,

                            grid: {
                                color: "rgba(148, 163, 184, .12)"
                            },

                            ticks: {

                                color: "#64748b",

                                font: {
                                    size: 10
                                },

                                callback: function (value) {

                                    return formatIndianCompact(value);

                                }

                            }

                        }

                    }

                }

            });

        }


        /* =====================================================
           AJAX APPROVE BILL
           Existing functionality preserved
           ===================================================== */

        function approveBill(billId) {

            if (confirm("Are you sure you want to authorize payment release for this bill?")) {

                $.post(

                    '@Url.Action("ApprovePaymentRelease", "Finance")',

                    {
                        billId: billId
                    },

                    function (res) {

                        if (res.success) {

                            alert(res.message);

                            $("#bill-row-" + billId).fadeOut(500, function () {

                                $(this).remove();

                            });

                        }
                        else {

                            alert("Error: " + res.message);

                        }

                    }

                );

            }

        }

    </script>

}
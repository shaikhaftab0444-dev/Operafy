        padding: 0 18px;
        border-radius: 10px;
        font-size: .73rem;
        font-weight: 700;
    }

    .ft-submit-btn {
        min-height: 40px;
        padding: 0 18px;
        border: 0;
        border-radius: 10px;
        background: linear-gradient(135deg, #2563eb, #4f46e5);

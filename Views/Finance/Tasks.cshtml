        }

        .ft-assignee-name {
            max-width: 115px;
        }

        .ft-modal-body {
            padding: 18px;
        }

        .ft-modal-footer {
            padding: 13px 18px;
        }
    }

    @@media (max-width: 479.98px) {
        .ft-page-header {
            padding: 15px;
        }

        .ft-title-row {
            gap: 9px;
        }

        .ft-title-icon {
            width: 38px;
            height: 38px;
            flex-basis: 38px;
            border-radius: 10px;
        }

        .ft-title {

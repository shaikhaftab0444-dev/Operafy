</style>

<div class="container-fluid py-4 text-start finance-task-page">

    <!-- =====================================================
         PREMIUM HEADER
         ===================================================== -->
    <div class="ft-page-header">
        <div class="ft-header-content">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">

                <div>
                    <div class="ft-title-row">
                        <div class="ft-title-icon">
                            <i class="fa-solid fa-list-check"></i>
                        </div>

                        <div>
                            <h4 class="ft-title">
                                Finance Team Tasks & Delegation
                            </h4>

                            <div class="ft-subtitle">
                                Delegate, monitor and manage operational finance activities
                            </div>
                        </div>
                    </div>

                    <div class="ft-breadcrumb">
                        <nav aria-label="breadcrumb">
                            <ol class="breadcrumb small">
                                <li class="breadcrumb-item">
                                    <a href="/Finance" class="text-decoration-none">
                                        Finance & Treasury
                                    </a>
                                </li>
                                <li class="breadcrumb-item active" aria-current="page">
                                    Task Delegation
                                </li>
                            </ol>
                        </nav>
                    </div>
                </div>

                <div class="d-flex align-items-center gap-2 ft-header-actions">
                    <span class="ft-live-status">
                        <span class="ft-live-dot"></span>
                        Task Center Active
                    </span>

                    <button type="button"
                            class="btn btn-primary ft-assign-btn"
                            data-bs-toggle="modal"
                            data-bs-target="#assignTaskModal">
                        <i class="fa-solid fa-plus me-2"></i>
                        Assign Task
                    </button>
                </div>

            </div>
        </div>
    </div>

    <!-- =====================================================
         KPI SUMMARY
         ===================================================== -->
    <div class="row g-3 mb-4">

        <div class="col-xl col-lg-4 col-md-6 col-sm-6">
            <div class="ft-kpi-card ft-kpi-primary">
                <div class="ft-kpi-inner">
                    <div>
                        <span class="ft-kpi-label">Total Tasks</span>
                        <h3 class="ft-kpi-value">@Model.TotalTasksCount</h3>
                    </div>

                    <div class="ft-kpi-icon">
                        <i class="fa-solid fa-layer-group"></i>
                    </div>
                </div>

                <div class="ft-kpi-bottom">
                    <i class="fa-solid fa-chart-simple"></i>
                    <span>Delegated workload</span>
                </div>
            </div>
        </div>

        <div class="col-xl col-lg-4 col-md-6 col-sm-6">
            <div class="ft-kpi-card ft-kpi-progress">
                <div class="ft-kpi-inner">
                    <div>
                        <span class="ft-kpi-label">In Progress</span>
                        <h3 class="ft-kpi-value text-primary">@Model.InProgressCount</h3>
                    </div>

                    <div class="ft-kpi-icon">
                        <i class="fa-solid fa-spinner"></i>
                    </div>
                </div>

                <div class="ft-kpi-bottom">
                    <i class="fa-solid fa-arrow-trend-up"></i>
                    <span>Currently active</span>
                </div>
            </div>
        </div>

        <div class="col-xl col-lg-4 col-md-6 col-sm-6">
            <div class="ft-kpi-card ft-kpi-review">
                <div class="ft-kpi-inner">
                    <div>
                        <span class="ft-kpi-label">In Review</span>
                        <h3 class="ft-kpi-value text-warning">@Model.InReviewCount</h3>
                    </div>

                    <div class="ft-kpi-icon">
                        <i class="fa-solid fa-magnifying-glass-chart"></i>
                    </div>
                </div>

                <div class="ft-kpi-bottom">
                    <i class="fa-solid fa-eye"></i>
                    <span>Awaiting verification</span>
                </div>
            </div>
        </div>

        <div class="col-xl col-lg-4 col-md-6 col-sm-6">
            <div class="ft-kpi-card ft-kpi-delayed">
                <div class="ft-kpi-inner">
                    <div>
                        <span class="ft-kpi-label">Delayed</span>
                        <h3 class="ft-kpi-value text-danger">@Model.DelayedCount</h3>
                    </div>

                    <div class="ft-kpi-icon">
                        <i class="fa-solid fa-triangle-exclamation"></i>
                    </div>
                </div>

                <div class="ft-kpi-bottom">
                    <i class="fa-solid fa-clock"></i>
                    <span>Requires attention</span>
                </div>
            </div>
        </div>

        <div class="col-xl col-lg-4 col-md-6 col-sm-6">
            <div class="ft-kpi-card ft-kpi-completed">
                <div class="ft-kpi-inner">
                    <div>
                        <span class="ft-kpi-label">Completed</span>
                        <h3 class="ft-kpi-value text-success">@Model.CompletedCount</h3>
                    </div>

                    <div class="ft-kpi-icon">
                        <i class="fa-solid fa-circle-check"></i>
                    </div>
                </div>

                <div class="ft-kpi-bottom">
                    <i class="fa-solid fa-check-double"></i>
                    <span>Successfully closed</span>
                </div>
            </div>
        </div>

    </div>

    <!-- =====================================================
         FILTER / SEARCH PANEL
         ===================================================== -->
    <div class="ft-filter-panel">

        <form method="get" action="/Finance/Tasks">

            <div class="ft-filter-layout">

                <div class="d-flex align-items-center gap-2 flex-wrap">

                    <div class="ft-filter-title">
                        <span class="ft-filter-title-icon">
                            <i class="fa-solid fa-sliders"></i>
                        </span>
                        <span>Task Status</span>
                    </div>

                    <div class="ft-status-tabs">

                        <a href="/Finance/Tasks?statusFilter=All"
                           class="ft-status-tab @(ViewBag.ActiveStatus == "All" || string.IsNullOrEmpty(ViewBag.ActiveStatus) ? "active" : "")">
                            <i class="fa-solid fa-border-all"></i>
                            All
                        </a>

                        <a href="/Finance/Tasks?statusFilter=In Progress"
                           class="ft-status-tab @(ViewBag.ActiveStatus == "In Progress" ? "active" : "")">
                            <i class="fa-solid fa-spinner"></i>
                            In Progress
                        </a>

                        <a href="/Finance/Tasks?statusFilter=Review"
                           class="ft-status-tab @(ViewBag.ActiveStatus == "Review" ? "active" : "")">
                            <i class="fa-solid fa-eye"></i>
                            Review
                        </a>

                        <a href="/Finance/Tasks?statusFilter=Delayed"
                           class="ft-status-tab @(ViewBag.ActiveStatus == "Delayed" ? "active" : "")">
                            <i class="fa-solid fa-triangle-exclamation"></i>
                            Delayed
                        </a>

                        <a href="/Finance/Tasks?statusFilter=Completed"
                           class="ft-status-tab @(ViewBag.ActiveStatus == "Completed" ? "active" : "")">
                            <i class="fa-solid fa-check"></i>
                            Completed
                        </a>

                    </div>

                </div>

                <div class="ft-search-box">
                    <div class="input-group input-group-sm">

                        <span class="input-group-text">
                            <i class="fa-solid fa-magnifying-glass"></i>
                        </span>

                        <input type="text"
                               name="search"
                               class="form-control"
                               placeholder="Search tasks or assignee..."
                               value="@ViewBag.SearchQuery" />

                        <button type="submit"
                                class="btn btn-primary ft-search-btn">
                            Search
                        </button>

                    </div>
                </div>

            </div>

        </form>

    </div>

    <!-- =====================================================
         TASK SECTION
         ===================================================== -->
    <div class="ft-task-section">

        <div class="ft-task-section-header">

            <div class="ft-section-heading">

                <span class="ft-section-icon">
                    <i class="fa-solid fa-clipboard-list"></i>
                </span>

                <div>
                    <h6 class="ft-section-title">
                        Delegated Finance Tasks
                    </h6>

                    <p class="ft-section-caption">
                        Monitor workload, progress and team execution
                    </p>
                </div>

            </div>

            @if (Model.Tasks != null && Model.Tasks.Any())
            {
                <span class="ft-task-count">
                    <i class="fa-solid fa-list"></i>
                    @Model.Tasks.Count() Tasks
                </span>
            }

        </div>

        <!-- =================================================
             TASK GRID
             ================================================= -->
        <div class="row g-3" id="tasksContainer">

            @if (Model.Tasks != null && Model.Tasks.Any())
            {
                foreach (var task in Model.Tasks)
                {
                    var priorityClass = "priority-badge-" + task.Priority;
                    var statusClass = "status-badge-" + task.Status.Replace(" ", "");

                    <div class="col-xl-4 col-lg-4 col-md-6 ft-task-column"
                         id="task-card-@task.TaskId">

                        <div class="ft-task-card d-flex flex-column">

                            <!-- Task Header -->
                            <div class="ft-task-top">

                                <span class="ft-priority-badge @priorityClass">
                                    <i class="fa-solid fa-flag"></i>
                                    @task.Priority Priority
                                </span>

                                <span class="ft-status-badge @statusClass">
                                    @if (task.Status == "Completed")
                                    {
                                        <i class="fa-solid fa-circle-check"></i>
                                    }
                                    else if (task.Status == "Delayed")
                                    {
                                        <i class="fa-solid fa-triangle-exclamation"></i>
                                    }
                                    else if (task.Status == "Review" || task.Status == "In Review")
                                    {
                                        <i class="fa-solid fa-eye"></i>
                                    }
                                    else
                                    {
                                        <i class="fa-solid fa-spinner"></i>
                                    }

                                    @task.Status
                                </span>

                            </div>

                            <!-- Task Information -->
                            <div>

                                <h6 class="ft-task-title">
                                    @task.Title
                                </h6>

                                <p class="ft-task-description">
                                    @(string.IsNullOrEmpty(task.Description)
                                        ? "No detailed notes provided."
                                        : task.Description)
                                </p>

                                <!-- Progress -->
                                <div class="ft-progress-wrap">

                                    <div class="ft-progress-meta">
                                        <span>
                                            <i class="fa-solid fa-chart-line me-1"></i>
                                            Progress
                                        </span>

                                        <span class="ft-progress-percent"
                                              id="progress-text-@task.TaskId">
                                            @task.ProgressPercentage%
                                        </span>
                                    </div>

                                    <div class="ft-progress-track">
                                        <div class="ft-progress-bar"
                                             id="progress-bar-@task.TaskId"
                                             role="progressbar"
                                             style="width: @task.ProgressPercentage%;"
                                             aria-valuenow="@task.ProgressPercentage"
                                             aria-valuemin="0"
                                             aria-valuemax="100">
                                        </div>
                                    </div>

                                </div>

                            </div>

                            <!-- Task Footer -->
                            <div class="ft-task-footer">

                                <div class="d-flex justify-content-between align-items-center gap-2">

                                    <div class="ft-assignee">

                                        <div class="ft-assignee-avatar">
                                            <i class="fa-solid fa-user"></i>
                                        </div>

                                        <div>
                                            <div class="ft-assignee-label">
                                                Assigned To
                                            </div>

                                            <span class="ft-assignee-name"
                                                  title="@task.AssignedToName">
                                                @task.AssignedToName
                                            </span>
                                        </div>

                                    </div>

                                    <div class="ft-due-date">

                                        <div class="mb-1">
                                            <i class="fa-solid fa-calendar-day me-1"></i>
                                            Due Date
                                        </div>

                                        <strong class="text-dark">
                                            @task.DueDate.ToString("dd MMM yyyy")
                                        </strong>

                                    </div>

                                </div>

                                <!-- Task Controls -->
                                <div class="ft-task-actions">

                                    <select class="form-select ft-status-select"
                                            onchange="updateTaskStatus(@task.TaskId, this.value)">

                                        <option value="In Progress"
                                                selected="@(task.Status == "In Progress")">
                                            In Progress
                                        </option>

                                        <option value="Review"
                                                selected="@(task.Status == "Review" || task.Status == "In Review")">
                                            In Review
                                        </option>

                                        <option value="Delayed"
                                                selected="@(task.Status == "Delayed")">
                                            Delayed
                                        </option>

                                        <option value="Completed"
                                                selected="@(task.Status == "Completed")">
                                            Completed
                                        </option>

                                    </select>

                                    <button type="button"
                                            class="btn ft-delete-btn"
                                            onclick="deleteTask(@task.TaskId)"
                                            title="Remove Task"
                                            aria-label="Remove Task">

                                        <i class="fa-solid fa-trash-can"></i>

                                    </button>

                                </div>

                            </div>

                        </div>

                    </div>
                }
            }
            else
            {
                <!-- Empty State -->
                <div class="col-12">

                    <div class="ft-empty-state">

                        <div class="ft-empty-icon">
                            <i class="fa-solid fa-clipboard-check"></i>
                        </div>

                        <h5 class="ft-empty-title">
                            No Tasks Assigned Yet
                        </h5>

                        <p class="ft-empty-text">
                            Delegate operational accounting and treasury tasks
                            to your team members and monitor their progress from
                            this finance task center.
                        </p>

                        <button type="button"
                                class="btn btn-primary ft-assign-btn"
                                data-bs-toggle="modal"
                                data-bs-target="#assignTaskModal">

                            <i class="fa-solid fa-plus me-2"></i>
                            Assign First Task

                        </button>

                    </div>

                </div>
            }

        </div>

    </div>

</div>

<!-- =========================================================
     ASSIGN TASK MODAL
     ========================================================= -->
<div class="modal fade ft-modal"
     id="assignTaskModal"
     tabindex="-1"
     aria-labelledby="assignTaskModalLabel"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content">

            <!-- Modal Header -->
            <div class="modal-header ft-modal-header border-0">

                <div class="ft-modal-heading">

                    <div class="ft-modal-icon">
                        <i class="fa-solid fa-user-plus"></i>
                    </div>

                    <div>
                        <h5 class="ft-modal-title"
                            id="assignTaskModalLabel">
                            Delegate Task to Subordinate
                        </h5>

                        <p class="ft-modal-subtitle">
                            Assign a finance activity to a reporting team member
                        </p>
                    </div>

                </div>

                <button type="button"
                        class="btn-close ms-auto"
                        data-bs-dismiss="modal"
                        aria-label="Close">
                </button>

            </div>

            <!-- Modal Form -->
            <form id="assignTaskForm"
                  onsubmit="submitAssignTask(event)">

                @Html.AntiForgeryToken()

                <div class="ft-modal-body">

                    <!-- Task Title -->
                    <div class="ft-field">

                        <label class="ft-field-label">
                            <i class="fa-solid fa-heading text-primary"></i>
                            Task Title
                            <span class="ft-required">*</span>
                        </label>

                        <input type="text"
                               name="Title"
                               class="form-control ft-form-control"
                               placeholder="e.g. Audit Bank Reconciliation Statements"
                               required />

                    </div>

                    <!-- Assignee -->
                    <div class="ft-field">

                        <label class="ft-field-label">
                            <i class="fa-solid fa-user-check text-primary"></i>
                            Assign To Subordinate
                            <span class="ft-required">*</span>
                        </label>

                        <select name="AssignedToEmail"
                                class="form-select ft-form-control"
                                id="teamMemberSelect"
                                required
                                onchange="setAssigneeName(this)">

                            <option value="">
                                -- Select Reporting Team Member --
                            </option>

                            @if (Model.TeamMembers != null && Model.TeamMembers.Any())
                            {
                                foreach (var member in Model.TeamMembers)
                                {
                                    <option value="@member.Email"
                                            data-name="@member.Name">
                                        @member.Name (@member.Email)
                                    </option>
                                }
                            }

                        </select>

                        <input type="hidden"
                               name="AssignedToName"
                               id="assignedToNameInput" />

                    </div>

                    <!-- Priority / Due Date -->
                    <div class="row g-3">

                        <div class="col-md-6">

                            <div class="ft-field">

                                <label class="ft-field-label">
                                    <i class="fa-solid fa-flag text-primary"></i>
                                    Priority
                                </label>

                                <select name="Priority"
                                        class="form-select ft-form-control">

                                    <option value="Low">
                                        Low
                                    </option>

                                    <option value="Medium" selected>
                                        Medium
                                    </option>

                                    <option value="High">
                                        High
                                    </option>

                                    <option value="Urgent">
                                        Urgent
                                    </option>

                                </select>

                            </div>

                        </div>

                        <div class="col-md-6">

                            <div class="ft-field">

                                <label class="ft-field-label">
                                    <i class="fa-solid fa-calendar-days text-primary"></i>
                                    Due Date
                                    <span class="ft-required">*</span>
                                </label>

                                <input type="date"
                                       name="DueDate"
                                       class="form-control ft-form-control"
                                       value="@DateTime.Today.AddDays(3).ToString("yyyy-MM-dd")"
                                       required />

                            </div>

                        </div>

                    </div>

                    <!-- Description -->
                    <div class="ft-field mb-0">

                        <label class="ft-field-label">
                            <i class="fa-solid fa-align-left text-primary"></i>
                            Task Instructions & Description
                        </label>

                        <textarea name="Description"
                                  class="form-control ft-form-control"
                                  rows="3"
                                  placeholder="Provide context, required spreadsheets, or deliverables..."></textarea>

                    </div>

                </div>

                <!-- Modal Footer -->
                <div class="modal-footer ft-modal-footer border-0">

                    <button type="button"
                            class="btn btn-light border ft-cancel-btn"
                            data-bs-dismiss="modal">
                        Cancel
                    </button>

                    <button type="submit"
                            class="btn btn-primary ft-submit-btn"
                            id="btnSubmitTask">

                        <i class="fa-solid fa-paper-plane me-2"></i>
                        Assign Task

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>

<!-- =========================================================
     JAVASCRIPT
     ========================================================= -->
<script>

    /* =========================================================
       ASSIGNEE NAME
       ========================================================= */

    function setAssigneeName(select) {

        var selectedOption = select.options[select.selectedIndex];

        var name = selectedOption.getAttribute('data-name');

        document.getElementById('assignedToNameInput').value = name || '';
    }


    /* =========================================================
       ASSIGN TASK
       ========================================================= */

    function submitAssignTask(e) {

        e.preventDefault();

        var form = document.getElementById('assignTaskForm');

        var formData = new FormData(form);

        var btn = document.getElementById('btnSubmitTask');

        btn.disabled = true;

        btn.innerHTML =
            '<i class="fa-solid fa-spinner fa-spin me-2"></i> Assigning...';


        fetch('/Finance/AssignTask', {
            method: 'POST',
            body: formData
        })

        .then(res => res.json())

        .then(data => {

            btn.disabled = false;

            btn.innerHTML =
                '<i class="fa-solid fa-paper-plane me-2"></i> Assign Task';


            if (data.success) {

                var modal =
                    bootstrap.Modal.getInstance(
                        document.getElementById('assignTaskModal')
                    );

                if (modal) {
                    modal.hide();
                }


                Swal.fire({
                    icon: 'success',
                    title: 'Task Assigned!',
                    text: data.message,
                    timer: 1500,
                    showConfirmButton: false
                })

                .then(() => {

                    window.location.reload();

                });

            }
            else {

                Swal.fire(
                    'Error',
                    data.message || 'Failed to assign task.',
                    'error'
                );

            }

        })

        .catch(err => {

            btn.disabled = false;

            btn.innerHTML =
                '<i class="fa-solid fa-paper-plane me-2"></i> Assign Task';


            Swal.fire(
                'Error',
                'An unexpected error occurred.',
                'error'
            );

        });

    }


    /* =========================================================
       UPDATE TASK STATUS
       ========================================================= */

    function updateTaskStatus(taskId, status) {

        var progress =
            status === 'Completed'
                ? 100
                : (
                    status === 'Review'
                        ? 90
                        : (
                            status === 'Delayed'
                                ? 40
                                : 50
                        )
                );


        var formData = new FormData();

        formData.append('id', taskId);
        formData.append('progress', progress);
        formData.append('status', status);


        fetch('/Finance/UpdateTaskProgress', {
            method: 'POST',
            body: formData
        })

        .then(res => res.json())

        .then(data => {

            if (data.success) {

                toastr.success(
                    data.message,
                    "Status Updated"
                );


                var bar =
                    document.getElementById(
                        'progress-bar-' + taskId
                    );

                var text =
                    document.getElementById(
                        'progress-text-' + taskId
                    );


                if (bar) {

                    bar.style.width = progress + '%';

                    bar.setAttribute(
                        'aria-valuenow',
                        progress
                    );

                }


                if (text) {

                    text.innerText =
                        progress + '%';

                }

            }
            else {

                toastr.error(
                    data.message || 'Could not update status'
                );

            }

        })

        .catch(err => {

            toastr.error(
                'Network request failed'
            );

        });

    }


    /* =========================================================
       DELETE TASK
       ========================================================= */

    function deleteTask(taskId) {

        Swal.fire({

            title: 'Delete Task?',

            text: 'Are you sure you want to remove this delegated task?',

            icon: 'warning',

            showCancelButton: true,

            confirmButtonColor: '#dc2626',

            cancelButtonColor: '#6b7280',

            confirmButtonText: 'Yes, Delete',

            cancelButtonText: 'Cancel',

            reverseButtons: true

        })

        .then((result) => {

            if (result.isConfirmed) {

                var formData = new FormData();

                formData.append('id', taskId);


                fetch('/Finance/DeleteTask', {

                    method: 'POST',

                    body: formData

                })

                .then(res => res.json())

                .then(data => {

                    if (data.success) {

                        var card =
                            document.getElementById(
                                'task-card-' + taskId
                            );


                        if (card) {

                            card.style.transition =
                                'opacity .3s ease, transform .3s ease';

                            card.style.opacity = '0';

                            card.style.transform =
                                'translateY(-8px) scale(.98)';


                            setTimeout(() => {

                                card.remove();

                            }, 300);

                        }


                        toastr.success(
                            data.message
                        );

                    }
                    else {

                        toastr.error(
                            data.message
                        );

                    }

                });

            }

        });

    }

</script>
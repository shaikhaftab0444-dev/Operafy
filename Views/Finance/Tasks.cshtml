@model ERP_System.Models.TaskDelegationViewModel

@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Finance Team Tasks & Delegation";
}

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" />
<script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script />

<style>
    /* =========================================================
       FINANCE TASK DELEGATION - PREMIUM ERP UI
       ========================================================= */

    .finance-task-page {
        --ft-primary: #2563eb;
        --ft-primary-dark: #1d4ed8;
        --ft-primary-soft: #eff6ff;
        --ft-success: #16a34a;
        --ft-warning: #d97706;
        --ft-danger: #dc2626;
        --ft-info: #0284c7;
        --ft-text: #172033;
        --ft-muted: #64748b;
        --ft-border: #e5e7eb;
        --ft-surface: #ffffff;
        --ft-bg: #f6f8fc;
        --ft-shadow: 0 10px 30px rgba(15, 23, 42, 0.06);
        animation: ftPageEnter .55s ease both;
    }

    @@keyframes ftPageEnter {
        from {
            opacity: 0;
            transform: translateY(12px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@keyframes ftFadeUp {
        from {
            opacity: 0;
            transform: translateY(14px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@keyframes ftPulse {
        0%, 100% {
            transform: scale(1);
            opacity: .85;
        }

        50% {
            transform: scale(1.18);
            opacity: 1;
        }
    }

    @@keyframes ftShimmer {
        0% {
            transform: translateX(-120%);
        }

        100% {
            transform: translateX(120%);
        }
    }

    /* =========================================================
       HEADER
       ========================================================= */

    .ft-page-header {
        position: relative;
        overflow: hidden;
        border-radius: 20px;
        padding: 22px 24px;
        margin-bottom: 22px;
        background:
            linear-gradient(135deg, #ffffff 0%, #f8fbff 58%, #eef5ff 100%);
        border: 1px solid rgba(226, 232, 240, .9);
        box-shadow: var(--ft-shadow);
    }

    .ft-page-header::before {
        content: "";
        position: absolute;
        width: 230px;
        height: 230px;
        border-radius: 50%;
        right: -80px;
        top: -120px;
        background: rgba(37, 99, 235, .08);
        pointer-events: none;
    }

    .ft-page-header::after {
        content: "";
        position: absolute;
        width: 160px;
        height: 160px;
        border-radius: 50%;
        right: 90px;
        bottom: -125px;
        background: rgba(14, 165, 233, .055);
        pointer-events: none;
    }

    .ft-header-content {
        position: relative;
        z-index: 2;
    }

    .ft-title-row {
        display: flex;
        align-items: center;
        gap: 13px;
    }

    .ft-title-icon {
        width: 48px;
        height: 48px;
        flex: 0 0 48px;
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #fff;
        background: linear-gradient(135deg, #2563eb, #4f46e5);
        box-shadow: 0 9px 20px rgba(37, 99, 235, .23);
        font-size: 20px;
        transition: transform .3s ease, box-shadow .3s ease;
    }

    .ft-title-row:hover .ft-title-icon {
        transform: translateY(-2px) rotate(-3deg);
        box-shadow: 0 12px 25px rgba(37, 99, 235, .30);
    }

    .ft-title {
        color: var(--ft-text);
        font-size: 1.25rem;
        font-weight: 800;
        letter-spacing: -.3px;
        margin: 0;
    }

    .ft-subtitle {
        color: var(--ft-muted);
        font-size: .82rem;
        margin-top: 3px;
    }

    .ft-breadcrumb {
        margin-top: 10px;
    }

    .ft-breadcrumb .breadcrumb {
        margin-bottom: 0;
    }

    .ft-breadcrumb a {
        color: var(--ft-primary);
        font-weight: 600;
    }

    .ft-live-status {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 8px 12px;
        border-radius: 999px;
        background: #f0fdf4;
        border: 1px solid #dcfce7;
        color: #15803d;
        font-size: .75rem;
        font-weight: 700;
    }

    .ft-live-dot {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: #22c55e;
        animation: ftPulse 1.8s ease-in-out infinite;
    }

    .ft-assign-btn {
        position: relative;
        overflow: hidden;
        border: 0;
        min-height: 44px;
        padding: 0 20px;
        border-radius: 12px;
        background: linear-gradient(135deg, #2563eb, #4f46e5);
        box-shadow: 0 9px 20px rgba(37, 99, 235, .22);
        font-weight: 700;
        transition: transform .25s ease, box-shadow .25s ease;
    }

    .ft-assign-btn::after {
        content: "";
        position: absolute;
        width: 80px;
        height: 150%;
        left: -100px;
        top: -20%;
        background: rgba(255,255,255,.18);
        transform: rotate(18deg);
        transition: none;
    }

    .ft-assign-btn:hover {
        transform: translateY(-2px);
        box-shadow: 0 13px 28px rgba(37, 99, 235, .28);
    }

    .ft-assign-btn:hover::after {
        animation: ftShimmer .7s ease;
    }

    /* =========================================================
       KPI CARDS
       ========================================================= */

    .ft-kpi-card {
        position: relative;
        overflow: hidden;
        height: 100%;
        border: 1px solid rgba(226, 232, 240, .95);
        border-radius: 17px;
        background: var(--ft-surface);
        box-shadow: var(--ft-shadow);
        padding: 18px;
        transition: transform .3s ease, box-shadow .3s ease, border-color .3s ease;
        animation: ftFadeUp .5s ease both;
    }

    .ft-kpi-card:nth-child(1) {
        animation-delay: .04s;
    }

    .ft-kpi-card:nth-child(2) {
        animation-delay: .08s;
    }

    .ft-kpi-card:nth-child(3) {
        animation-delay: .12s;
    }

    .ft-kpi-card:nth-child(4) {
        animation-delay: .16s;
    }

    .ft-kpi-card:nth-child(5) {
        animation-delay: .20s;
    }

    .ft-kpi-card::before {
        content: "";
        position: absolute;
        width: 90px;
        height: 90px;
        border-radius: 50%;
        right: -40px;
        top: -45px;
        background: rgba(37, 99, 235, .045);
    }

    .ft-kpi-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 17px 35px rgba(15, 23, 42, .09);
        border-color: #d7e3f8;
    }

    .ft-kpi-inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        position: relative;
        z-index: 2;
    }

    .ft-kpi-label {
        display: block;
        color: #64748b;
        font-size: .68rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: .7px;
        margin-bottom: 6px;
    }

    .ft-kpi-value {
        margin: 0;
        color: var(--ft-text);
        font-size: 1.65rem;
        line-height: 1;
        font-weight: 800;
        letter-spacing: -.5px;
    }

    .ft-kpi-icon {
        width: 46px;
        height: 46px;
        flex: 0 0 46px;
        border-radius: 13px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 17px;
        transition: transform .3s ease;
    }

    .ft-kpi-card:hover .ft-kpi-icon {
        transform: scale(1.08) rotate(4deg);
    }

    .ft-kpi-primary .ft-kpi-icon {
        color: #2563eb;
        background: #eff6ff;
    }

    .ft-kpi-progress .ft-kpi-icon {
        color: #0284c7;
        background: #ecfeff;
    }

    .ft-kpi-review .ft-kpi-icon {
        color: #d97706;
        background: #fffbeb;
    }

    .ft-kpi-delayed .ft-kpi-icon {
        color: #dc2626;
        background: #fef2f2;
    }

    .ft-kpi-completed .ft-kpi-icon {
        color: #16a34a;
        background: #f0fdf4;
    }

    .ft-kpi-bottom {
        display: flex;
        align-items: center;
        gap: 6px;
        margin-top: 12px;
        color: #94a3b8;
        font-size: .69rem;
    }

    .ft-kpi-bottom i {
        font-size: .65rem;
    }

    /* =========================================================
       FILTER PANEL
       ========================================================= */

    .ft-filter-panel {
        position: relative;
        border: 1px solid var(--ft-border);
        border-radius: 17px;
        background: #fff;
        box-shadow: var(--ft-shadow);
        padding: 15px;
        margin-bottom: 22px;
        animation: ftFadeUp .55s ease .12s both;
    }

    .ft-filter-layout {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 14px;
    }

    .ft-filter-title {
        display: flex;
        align-items: center;
        gap: 9px;
        color: var(--ft-text);
        font-size: .78rem;
        font-weight: 800;
        margin-right: 5px;
        white-space: nowrap;
    }

    .ft-filter-title-icon {
        width: 32px;
        height: 32px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 9px;
        background: #f1f5f9;
        color: #475569;
    }

    .ft-status-tabs {
        display: flex;
        align-items: center;
        gap: 7px;
        flex-wrap: wrap;
    }

    .ft-status-tab {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        min-height: 34px;
        padding: 0 13px;
        border-radius: 9px !important;
        border: 1px solid #e2e8f0 !important;
        background: #fff !important;
        color: #64748b !important;
        font-size: .73rem;
        font-weight: 700;
        text-decoration: none !important;
        transition: all .22s ease;
    }

    .ft-status-tab:hover {
        color: var(--ft-primary) !important;
        background: #f8fbff !important;
        border-color: #bfdbfe !important;
        transform: translateY(-1px);
    }

    .ft-status-tab.active {
        color: #fff !important;
        background: linear-gradient(135deg, #2563eb, #4f46e5) !important;
        border-color: transparent !important;
        box-shadow: 0 5px 13px rgba(37, 99, 235, .18);
    }

    .ft-search-box {
        min-width: 290px;
        max-width: 340px;
    }

    .ft-search-box .input-group {
        height: 38px;
    }

    .ft-search-box .input-group-text {
        border-color: #e2e8f0;
        background: #f8fafc;
        color: #94a3b8;
    }

    .ft-search-box .form-control {
        border-color: #e2e8f0;
        font-size: .76rem;
    }

    .ft-search-box .form-control:focus {
        border-color: #93c5fd;
        box-shadow: 0 0 0 3px rgba(37, 99, 235, .08);
    }

    .ft-search-btn {
        border-radius: 0 9px 9px 0 !important;
        font-size: .72rem;
        font-weight: 700;
        padding-left: 14px;
        padding-right: 14px;
    }

    /* =========================================================
       TASK SECTION
       ========================================================= */

    .ft-task-section {
        margin-top: 4px;
    }

    .ft-task-section-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 13px;
        gap: 12px;
    }

    .ft-section-heading {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .ft-section-icon {
        width: 36px;
        height: 36px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 10px;
        background: #eff6ff;
        color: var(--ft-primary);
        font-size: 14px;
    }

    .ft-section-title {
        margin: 0;
        color: var(--ft-text);
        font-size: .93rem;
        font-weight: 800;
    }

    .ft-section-caption {
        margin: 2px 0 0;
        color: #94a3b8;
        font-size: .69rem;
    }

    .ft-task-count {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 6px 10px;
        border-radius: 999px;
        color: #475569;
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        font-size: .69rem;
        font-weight: 700;
    }

    /* =========================================================
       TASK CARDS
       ========================================================= */

    .ft-task-column {
        animation: ftFadeUp .5s ease both;
    }

    .ft-task-column:nth-child(1) { animation-delay: .04s; }
    .ft-task-column:nth-child(2) { animation-delay: .08s; }
    .ft-task-column:nth-child(3) { animation-delay: .12s; }
    .ft-task-column:nth-child(4) { animation-delay: .16s; }
    .ft-task-column:nth-child(5) { animation-delay: .20s; }
    .ft-task-column:nth-child(6) { animation-delay: .24s; }

    .ft-task-card {
        position: relative;
        overflow: hidden;
        min-height: 270px;
        border: 1px solid #e2e8f0;
        border-radius: 17px;
        background: #fff;
        box-shadow: 0 7px 23px rgba(15, 23, 42, .045);
        padding: 17px;
        transition: transform .3s ease, box-shadow .3s ease, border-color .3s ease;
    }

    .ft-task-card::before {
        content: "";
        position: absolute;
        left: 0;
        right: 0;
        top: 0;
        height: 3px;
        background: linear-gradient(90deg, #2563eb, #6366f1);
        opacity: .75;
        transform: scaleX(0);
        transform-origin: left;
        transition: transform .3s ease;
    }

    .ft-task-card:hover {
        transform: translateY(-5px);
        border-color: #cbd5e1;
        box-shadow: 0 17px 36px rgba(15, 23, 42, .085);
    }

    .ft-task-card:hover::before {
        transform: scaleX(1);
    }

    .ft-task-top {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 8px;
        margin-bottom: 13px;
    }

    .ft-priority-badge,
    .ft-status-badge {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        border-radius: 999px;
        padding: 6px 9px;
        font-size: .64rem;
        font-weight: 800;
        letter-spacing: .1px;
        white-space: nowrap;
    }

    .priority-badge-Urgent {
        background: #fef2f2;
        color: #dc2626;
        border: 1px solid #fecaca;
    }

    .priority-badge-High {
        background: #fff7ed;
        color: #ea580c;
        border: 1px solid #fed7aa;
    }

    .priority-badge-Medium {
        background: #eff6ff;
        color: #0284c7;
        border: 1px solid #bae6fd;
    }

    .priority-badge-Low {
        background: #f8fafc;
        color: #475569;
        border: 1px solid #e2e8f0;
    }

    .status-badge-InProgress {
        background: #eff6ff;
        color: #2563eb;
        border: 1px solid #dbeafe;
    }

    .status-badge-Review {
        background: #fffbeb;
        color: #d97706;
        border: 1px solid #fef3c7;
    }

    .status-badge-Delayed {
        background: #fef2f2;
        color: #dc2626;
        border: 1px solid #fecaca;
    }

    .status-badge-Completed {
        background: #f0fdf4;
        color: #16a34a;
        border: 1px solid #dcfce7;
    }

    .ft-task-title {
        color: #172033;
        font-size: .92rem;
        line-height: 1.4;
        font-weight: 800;
        margin: 0 0 6px;
    }

    .ft-task-description {
        color: #64748b;
        font-size: .73rem;
        line-height: 1.55;
        margin: 0 0 15px;
        min-height: 38px;
    }

    /* =========================================================
       PROGRESS
       ========================================================= */

    .ft-progress-wrap {
        margin-bottom: 16px;
    }

    .ft-progress-meta {
        display: flex;
        justify-content: space-between;
        align-items: center;
        color: #94a3b8;
        font-size: .66rem;
        font-weight: 700;
        margin-bottom: 7px;
    }

    .ft-progress-percent {
        color: #334155;
        font-weight: 800;
    }

    .ft-progress-track {
        height: 7px;
        overflow: hidden;
        border-radius: 999px;
        background: #eef2f7;
    }

    .ft-progress-bar {
        height: 100%;
        border-radius: inherit;
        background: linear-gradient(90deg, #2563eb, #6366f1);
        box-shadow: 0 2px 8px rgba(37, 99, 235, .18);
        transition: width .45s ease;
    }

    /* =========================================================
       TASK FOOTER
       ========================================================= */

    .ft-task-footer {
        border-top: 1px solid #eef2f7;
        padding-top: 13px;
        margin-top: auto;
    }

    .ft-assignee {
        display: flex;
        align-items: center;
        gap: 8px;
        min-width: 0;
    }

    .ft-assignee-avatar {
        width: 31px;
        height: 31px;
        flex: 0 0 31px;
        border-radius: 9px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #2563eb;
        background: #eff6ff;
        font-size: 12px;
        transition: transform .25s ease;
    }

    .ft-task-card:hover .ft-assignee-avatar {
        transform: scale(1.08);
    }

    .ft-assignee-label {
        color: #94a3b8;
        font-size: .59rem;
        text-transform: uppercase;
        font-weight: 800;
        letter-spacing: .4px;
        line-height: 1;
        margin-bottom: 3px;
    }

    .ft-assignee-name {
        display: block;
        max-width: 130px;
        overflow: hidden;
        color: #334155;
        font-size: .7rem;
        font-weight: 750;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .ft-due-date {
        text-align: right;
        color: #64748b;
        font-size: .65rem;
        white-space: nowrap;
    }

    .ft-due-date i {
        color: #94a3b8;
    }

    .ft-task-actions {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-top: 12px;
    }

    .ft-status-select {
        min-height: 36px;
        flex: 1;
        border-radius: 9px;
        border-color: #e2e8f0;
        color: #475569;
        font-size: .69rem;
        font-weight: 700;
        box-shadow: none !important;
        cursor: pointer;
    }

    .ft-status-select:focus {
        border-color: #93c5fd;
        box-shadow: 0 0 0 3px rgba(37, 99, 235, .08) !important;
    }

    .ft-delete-btn {
        width: 36px;
        height: 36px;
        flex: 0 0 36px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 9px !important;
        border: 1px solid #fecaca !important;
        color: #dc2626;
        background: #fff !important;
        transition: all .22s ease;
    }

    .ft-delete-btn:hover {
        color: #fff;
        background: #dc2626 !important;
        border-color: #dc2626 !important;
        transform: translateY(-1px);
    }

    /* =========================================================
       EMPTY STATE
       ========================================================= */

    .ft-empty-state {
        position: relative;
        overflow: hidden;
        border: 1px solid #e2e8f0;
        border-radius: 18px;
        background: #fff;
        box-shadow: var(--ft-shadow);
        padding: 55px 25px;
        text-align: center;
        animation: ftFadeUp .5s ease both;
    }

    .ft-empty-icon {
        width: 72px;
        height: 72px;
        margin: 0 auto 16px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 20px;
        background: #f1f5f9;
        color: #94a3b8;
        font-size: 28px;
    }

    .ft-empty-title {
        color: #172033;
        font-weight: 800;
        margin-bottom: 6px;
    }

    .ft-empty-text {
        max-width: 470px;
        margin: 0 auto 18px;
        color: #64748b;
        font-size: .78rem;
        line-height: 1.6;
    }

    /* =========================================================
       MODAL
       ========================================================= */

    .ft-modal .modal-dialog {
        max-width: 590px;
    }

    .ft-modal .modal-content {
        overflow: hidden;
        border: 1px solid rgba(226, 232, 240, .9);
        border-radius: 20px;
        box-shadow: 0 25px 70px rgba(15, 23, 42, .20);
    }

    .ft-modal-header {
        position: relative;
        overflow: hidden;
        padding: 20px 22px;
        background: linear-gradient(135deg, #f8fbff, #eef5ff);
        border-bottom: 1px solid #e2e8f0;
    }

    .ft-modal-header::after {
        content: "";
        position: absolute;
        width: 150px;
        height: 150px;
        right: -65px;
        top: -85px;
        border-radius: 50%;
        background: rgba(37, 99, 235, .08);
    }

    .ft-modal-heading {
        position: relative;
        z-index: 2;
        display: flex;
        align-items: center;
        gap: 11px;
    }

    .ft-modal-icon {
        width: 40px;
        height: 40px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 11px;
        color: #2563eb;
        background: #fff;
        box-shadow: 0 5px 13px rgba(37, 99, 235, .10);
    }

    .ft-modal-title {
        margin: 0;
        color: #172033;
        font-size: .98rem;
        font-weight: 800;
    }

    .ft-modal-subtitle {
        margin: 2px 0 0;
        color: #94a3b8;
        font-size: .68rem;
    }

    .ft-modal-body {
        padding: 22px;
    }

    .ft-field {
        margin-bottom: 17px;
    }

    .ft-field-label {
        display: flex;
        align-items: center;
        gap: 5px;
        color: #334155;
        font-size: .71rem;
        font-weight: 800;
        margin-bottom: 7px;
    }

    .ft-required {
        color: #dc2626;
    }

    .ft-form-control {
        min-height: 42px;
        border: 1px solid #e2e8f0;
        border-radius: 10px;
        color: #334155;
        background: #fff;

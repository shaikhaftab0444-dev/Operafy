@model ERP_System.Models.TaskDelegationViewModel

@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Finance Team Tasks & Delegation";
}

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" />
<script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>

<style>
    .task-page {
        animation: fadeIn 0.4s ease-in-out;
    }

    @@keyframes fadeIn {
        from { opacity: 0; transform: translateY(6px); }
        to { opacity: 1; transform: translateY(0); }
    }

    .kpi-card {
        border-radius: 14px;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

    .kpi-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.08) !important;
    }

    .task-card {
        border-radius: 14px;
        transition: all 0.2s ease;
        border: 1px solid #e2e8f0;
    }

    .task-card:hover {
        transform: translateY(-3px);
        box-shadow: 0 10px 25px rgba(0,0,0,0.06) !important;
        border-color: #cbd5e1;
    }

    .priority-badge-Urgent { background-color: #fee2e2; color: #dc2626; border: 1px solid #fecaca; }
    .priority-badge-High { background-color: #ffedd5; color: #ea580c; border: 1px solid #fed7aa; }
    .priority-badge-Medium { background-color: #e0f2fe; color: #0284c7; border: 1px solid #bae6fd; }
    .priority-badge-Low { background-color: #f1f5f9; color: #475569; border: 1px solid #e2e8f0; }

    .status-badge-InProgress { background-color: #dbeafe; color: #2563eb; }
    .status-badge-Review { background-color: #fef3c7; color: #d97706; }
    .status-badge-Delayed { background-color: #fee2e2; color: #dc2626; }
    .status-badge-Completed { background-color: #dcfce7; color: #16a34a; }
</style>

<div class="container-fluid py-4 text-start task-page">
    <!-- Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
        <div>
            <h4 class="fw-bold mb-1 text-dark">
                <i class="fa-solid fa-list-check text-primary me-2"></i>Finance Team Tasks & Delegation
            </h4>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0 small">
                    <li class="breadcrumb-item"><a href="/Finance" class="text-decoration-none">Finance & Treasury</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Task Delegation</li>
                </ol>
            </nav>
        </div>

        <div>
            <button type="button" class="btn btn-primary rounded-pill px-4 shadow-sm" data-bs-toggle="modal" data-bs-target="#assignTaskModal">
                <i class="fa-solid fa-plus me-1.5"></i> Assign Task
            </button>
        </div>
    </div>

    <!-- KPI Summary Row -->
    <div class="row g-3 mb-4">
        <div class="col-md-2 col-sm-4 col-6">
            <div class="card kpi-card border-0 shadow-sm p-3 bg-white text-center">
                <span class="text-muted small fw-semibold text-uppercase">Total Tasks</span>
                <h3 class="fw-bold text-dark mb-0 mt-1">@Model.TotalTasksCount</h3>
            </div>
        </div>
        <div class="col-md-2 col-sm-4 col-6">
            <div class="card kpi-card border-0 shadow-sm p-3 bg-white text-center">
                <span class="text-muted small fw-semibold text-uppercase">In Progress</span>
                <h3 class="fw-bold text-primary mb-0 mt-1">@Model.InProgressCount</h3>
            </div>
        </div>
        <div class="col-md-2 col-sm-4 col-6">
            <div class="card kpi-card border-0 shadow-sm p-3 bg-white text-center">
                <span class="text-muted small fw-semibold text-uppercase">In Review</span>
                <h3 class="fw-bold text-warning mb-0 mt-1">@Model.InReviewCount</h3>
            </div>
        </div>
        <div class="col-md-3 col-sm-6 col-6">
            <div class="card kpi-card border-0 shadow-sm p-3 bg-white text-center">
                <span class="text-muted small fw-semibold text-uppercase">Delayed</span>
                <h3 class="fw-bold text-danger mb-0 mt-1">@Model.DelayedCount</h3>
            </div>
        </div>
        <div class="col-md-3 col-sm-6 col-12">
            <div class="card kpi-card border-0 shadow-sm p-3 bg-white text-center">
                <span class="text-muted small fw-semibold text-uppercase">Completed</span>
                <h3 class="fw-bold text-success mb-0 mt-1">@Model.CompletedCount</h3>
            </div>
        </div>
    </div>

    <!-- Filter Bar -->
    <div class="card border-0 shadow-sm bg-white p-3 mb-4 rounded-3">
        <form method="get" action="/Finance/Tasks" class="d-flex flex-wrap align-items-center justify-content-between gap-3">
            <div class="d-flex align-items-center gap-2 flex-wrap">
                <a href="/Finance/Tasks?statusFilter=All" class="btn btn-sm @(ViewBag.ActiveStatus == "All" || string.IsNullOrEmpty(ViewBag.ActiveStatus) ? "btn-primary" : "btn-light border") rounded-pill px-3">All</a>
                <a href="/Finance/Tasks?statusFilter=In Progress" class="btn btn-sm @(ViewBag.ActiveStatus == "In Progress" ? "btn-primary" : "btn-light border") rounded-pill px-3">In Progress</a>
                <a href="/Finance/Tasks?statusFilter=Review" class="btn btn-sm @(ViewBag.ActiveStatus == "Review" ? "btn-primary" : "btn-light border") rounded-pill px-3">Review</a>
                <a href="/Finance/Tasks?statusFilter=Delayed" class="btn btn-sm @(ViewBag.ActiveStatus == "Delayed" ? "btn-primary" : "btn-light border") rounded-pill px-3">Delayed</a>
                <a href="/Finance/Tasks?statusFilter=Completed" class="btn btn-sm @(ViewBag.ActiveStatus == "Completed" ? "btn-primary" : "btn-light border") rounded-pill px-3">Completed</a>
            </div>

            <div class="input-group input-group-sm" style="width: 260px;">
                <span class="input-group-text bg-light border-secondary-subtle"><i class="fa-solid fa-magnifying-glass text-muted"></i></span>
                <input type="text" name="search" class="form-control border-secondary-subtle" placeholder="Search tasks or assignee..." value="@ViewBag.SearchQuery" />
                <button type="submit" class="btn btn-outline-secondary">Search</button>
            </div>
        </form>
    </div>

    <!-- Tasks List / Grid -->
    <div class="row g-3" id="tasksContainer">
        @if (Model.Tasks != null && Model.Tasks.Any())
        {
            foreach (var task in Model.Tasks)
            {
                var priorityClass = "priority-badge-" + task.Priority;
                var statusClass = "status-badge-" + task.Status.Replace(" ", "");

                <div class="col-lg-4 col-md-6" id="task-card-@task.TaskId">
                    <div class="card task-card bg-white p-3 shadow-sm h-100 d-flex flex-column justify-content-between">
                        <div>
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="badge rounded-pill px-2.5 py-1 text-xs fw-semibold @priorityClass">
                                    <i class="fa-solid fa-flag me-1 small"></i>@task.Priority Priority
                                </span>
                                <span class="badge rounded-pill px-2.5 py-1 text-xs fw-semibold @statusClass">
                                    @task.Status
                                </span>
                            </div>

                            <h6 class="fw-bold text-dark mb-1">@task.Title</h6>
                            <p class="text-muted small mb-3" style="min-height: 38px;">
                                @(string.IsNullOrEmpty(task.Description) ? "No detailed notes provided." : task.Description)
                            </p>

                            <!-- Progress Bar -->
                            <div class="mb-3">
                                <div class="d-flex justify-content-between align-items-center text-xs text-muted mb-1">
                                    <span>Progress</span>
                                    <span class="fw-bold text-dark" id="progress-text-@task.TaskId">@task.ProgressPercentage%</span>
                                </div>
                                <div class="progress" style="height: 6px;">
                                    <div class="progress-bar bg-primary" id="progress-bar-@task.TaskId" role="progressbar" 
                                         style="width: @task.ProgressPercentage%;" aria-valuenow="@task.ProgressPercentage" aria-valuemin="0" aria-valuemax="100"></div>
                                </div>
                            </div>
                        </div>

                        <!-- Card Footer Info -->
                        <div class="border-top pt-2.5 mt-2">
                            <div class="d-flex justify-content-between align-items-center mb-2 small">
                                <div class="d-flex align-items-center gap-1.5 text-muted">
                                    <i class="fa-solid fa-user-circle text-primary"></i>
                                    <span class="text-dark fw-semibold">@task.AssignedToName</span>
                                </div>
                                <div class="text-muted text-xs">
                                    <i class="fa-solid fa-calendar-day me-1"></i>Due: @task.DueDate.ToString("dd MMM yyyy")
                                </div>
                            </div>

                            <div class="d-flex justify-content-between align-items-center gap-2 pt-1">
                                <select class="form-select form-select-sm border-secondary-subtle text-xs" style="width: 140px;" onchange="updateTaskStatus(@task.TaskId, this.value)">
                                    <option value="In Progress" selected="@(task.Status == "In Progress")">In Progress</option>
                                    <option value="Review" selected="@(task.Status == "Review" || task.Status == "In Review")">In Review</option>
                                    <option value="Delayed" selected="@(task.Status == "Delayed")">Delayed</option>
                                    <option value="Completed" selected="@(task.Status == "Completed")">Completed</option>
                                </select>

                                <div class="d-flex align-items-center gap-1">
                                    <button type="button" class="btn btn-sm btn-outline-danger px-2.5 rounded-3" onclick="deleteTask(@task.TaskId)" title="Remove Task">
                                        <i class="fa-solid fa-trash-can"></i>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12">
                <div class="card border-0 shadow-sm bg-white p-5 text-center text-muted">
                    <i class="fa-solid fa-tasks fs-1 text-secondary mb-3 d-block"></i>
                    <h5 class="fw-bold text-dark">No Tasks Assigned Yet</h5>
                    <p class="small mb-3">Delegate operational accounting and treasury tasks to your team members.</p>
                    <div>
                        <button type="button" class="btn btn-primary rounded-pill px-4 shadow-sm" data-bs-toggle="modal" data-bs-target="#assignTaskModal">
                            <i class="fa-solid fa-plus me-1"></i> Assign First Task
                        </button>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<!-- Modal: Assign Task -->
<div class="modal fade" id="assignTaskModal" tabindex="-1" aria-labelledby="assignTaskModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4">
            <div class="modal-header border-bottom px-4 py-3 bg-light">
                <h5 class="modal-title fw-bold text-dark" id="assignTaskModalLabel">
                    <i class="fa-solid fa-user-plus text-primary me-2"></i>Delegate Task to Subordinate
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="assignTaskForm" onsubmit="submitAssignTask(event)">
                @Html.AntiForgeryToken()
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label fw-semibold small text-dark">Task Title <span class="text-danger">*</span></label>
                        <input type="text" name="Title" class="form-control rounded-3" placeholder="e.g. Audit Bank Reconciliation Statements" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold small text-dark">Assign To Subordinate <span class="text-danger">*</span></label>
                        <select name="AssignedToEmail" class="form-select rounded-3" id="teamMemberSelect" required onchange="setAssigneeName(this)">
                            <option value="">-- Select Reporting Team Member --</option>
                            @if (Model.TeamMembers != null && Model.TeamMembers.Any())
                            {
                                foreach (var member in Model.TeamMembers)
                                {
                                    <option value="@member.Email" data-name="@member.Name">@member.Name (@member.Email)</option>
                                }
                            }
                        </select>
                        <input type="hidden" name="AssignedToName" id="assignedToNameInput" />
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-6">
                            <label class="form-label fw-semibold small text-dark">Priority</label>
                            <select name="Priority" class="form-select rounded-3">
                                <option value="Low">Low</option>
                                <option value="Medium" selected>Medium</option>
                                <option value="High">High</option>
                                <option value="Urgent">Urgent</option>
                            </select>
                        </div>
                        <div class="col-6">
                            <label class="form-label fw-semibold small text-dark">Due Date <span class="text-danger">*</span></label>
                            <input type="date" name="DueDate" class="form-control rounded-3" value="@DateTime.Today.AddDays(3).ToString("yyyy-MM-dd")" required />
                        </div>
                    </div>

                    <div class="mb-2">
                        <label class="form-label fw-semibold small text-dark">Task Instructions & Description</label>
                        <textarea name="Description" class="form-control rounded-3" rows="3" placeholder="Provide context, required spreadsheets, or deliverables..."></textarea>
                    </div>
                </div>

                <div class="modal-footer border-top px-4 py-3 bg-light">
                    <button type="button" class="btn btn-light rounded-pill px-4 border" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary rounded-pill px-4 shadow-sm" id="btnSubmitTask">
                        <i class="fa-solid fa-paper-plane me-1"></i> Assign Task
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    function setAssigneeName(select) {
        var selectedOption = select.options[select.selectedIndex];
        var name = selectedOption.getAttribute('data-name');
        document.getElementById('assignedToNameInput').value = name || '';
    }

    function submitAssignTask(e) {
        e.preventDefault();
        var form = document.getElementById('assignTaskForm');
        var formData = new FormData(form);

        var btn = document.getElementById('btnSubmitTask');
        btn.disabled = true;
        btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin me-1"></i> Assigning...';

        fetch('/Finance/AssignTask', {
            method: 'POST',
            body: formData
        })
        .then(res => res.json())
        .then(data => {
            btn.disabled = false;
            btn.innerHTML = '<i class="fa-solid fa-paper-plane me-1"></i> Assign Task';
            if (data.success) {
                var modal = bootstrap.Modal.getInstance(document.getElementById('assignTaskModal'));
                if (modal) modal.hide();
                Swal.fire({
                    icon: 'success',
                    title: 'Task Assigned!',
                    text: data.message,
                    timer: 1500,
                    showConfirmButton: false
                }).then(() => {
                    window.location.reload();
                });
            } else {
                Swal.fire('Error', data.message || 'Failed to assign task.', 'error');
            }
        })
        .catch(err => {
            btn.disabled = false;
            btn.innerHTML = '<i class="fa-solid fa-paper-plane me-1"></i> Assign Task';
            Swal.fire('Error', 'An unexpected error occurred.', 'error');
        });
    }

    function updateTaskStatus(taskId, status) {
        var progress = status === 'Completed' ? 100 : (status === 'Review' ? 90 : (status === 'Delayed' ? 40 : 50));
        
        var formData = new FormData();
        formData.append('id', taskId);
        formData.append('progress', progress);
        formData.append('status', status);

        fetch('/Finance/UpdateTaskProgress', {
            method: 'POST',
            body: formData
        })
        .then(res => res.json())
        .then(data => {
            if (data.success) {
                toastr.success(data.message, "Status Updated");
                var bar = document.getElementById('progress-bar-' + taskId);
                var text = document.getElementById('progress-text-' + taskId);
                if (bar) bar.style.width = progress + '%';
                if (text) text.innerText = progress + '%';
            } else {
                toastr.error(data.message || 'Could not update status');
            }
        })
        .catch(err => {
            toastr.error('Network request failed');
        });
    }

    function deleteTask(taskId) {
        Swal.fire({
            title: 'Delete Task?',
            text: 'Are you sure you want to remove this delegated task?',
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#dc2626',
            cancelButtonColor: '#6b7280',
            confirmButtonText: 'Yes, Delete'
        }).then((result) => {
            if (result.isConfirmed) {
                var formData = new FormData();
                formData.append('id', taskId);

                fetch('/Finance/DeleteTask', {
                    method: 'POST',
                    body: formData
                })
                .then(res => res.json())
                .then(data => {
                    if (data.success) {
                        var card = document.getElementById('task-card-' + taskId);
                        if (card) card.remove();
                        toastr.success(data.message);
                    } else {
                        toastr.error(data.message);
                    }
                });
            }
        });
    }
</script>

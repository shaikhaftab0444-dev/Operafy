@model ERP_System.Models.BankReconciliationViewModel
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Bank & Cash Reconciliation";
    string currentFilter = ViewBag.CurrentFilter as string ?? "All";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

<style>
    :root {
        --recon-primary: #2563eb;
        --recon-primary-dark: #1d4ed8;
        --recon-success: #059669;
        --recon-warning: #d97706;
        --recon-danger: #dc2626;
        --recon-purple: #7c3aed;
        --recon-text: #0f172a;
        --recon-muted: #64748b;
        --recon-border: #e2e8f0;
        --recon-soft: #f8fafc;
        --recon-white: #ffffff;
        --recon-shadow: 0 8px 30px rgba(15, 23, 42, 0.055);
        --recon-shadow-hover: 0 14px 38px rgba(15, 23, 42, 0.10);
    }

    .recon-wrapper {
        min-height: 100vh;
        padding: 12px 0 35px;
        font-family: "Segoe UI", system-ui, -apple-system, BlinkMacSystemFont, sans-serif;
        color: var(--recon-text);
    }

    .recon-container {
        max-width: 1750px;
        margin: 0 auto;
    }

    /* =========================================
           PAGE HEADER
           ========================================= */

    .recon-page-header {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 20px;
        margin-bottom: 25px;
    }

    .recon-header-left {
        min-width: 0;
    }

    .recon-breadcrumb {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 8px;
        margin-bottom: 8px;
        color: #94a3b8;
        font-size: 11px;
        font-weight: 700;
    }

        .recon-breadcrumb a {
            color: #64748b;
            text-decoration: none;
            transition: color 0.2s ease;
        }

            .recon-breadcrumb a:hover {
                color: var(--recon-primary);
            }

        .recon-breadcrumb .separator {
            color: #cbd5e1;
        }

    .recon-eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        color: var(--recon-primary);
        font-size: 10px;
        font-weight: 850;
        letter-spacing: 0.13em;
        text-transform: uppercase;
        margin-bottom: 6px;
    }

        .recon-eyebrow::before {
            content: "";
            width: 27px;
            height: 2px;
            border-radius: 20px;
            background: var(--recon-primary);
        }

    .recon-title {
        margin: 0;
        color: #0f172a;
        font-size: clamp(23px, 2.2vw, 32px);
        font-weight: 850;
        line-height: 1.15;
        letter-spacing: -0.035em;
    }

    .recon-subtitle {
        margin: 8px 0 0;
        max-width: 720px;
        color: var(--recon-muted);
        font-size: 13px;
        line-height: 1.6;
    }

    .recon-header-actions {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: flex-end;
        gap: 9px;
        flex-shrink: 0;
    }

    .recon-action-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        min-height: 40px;
        padding: 0 14px;
        border-radius: 9px;
        font-size: 12px;
        font-weight: 750;
        text-decoration: none;
        transition: all 0.22s ease;
        white-space: nowrap;
    }

        .recon-action-btn:hover {
            transform: translateY(-1px);
        }

    .recon-btn-outline {
        border: 1px solid var(--recon-border);
        background: #fff;
        color: #475569;
    }

        .recon-btn-outline:hover {
            border-color: #93c5fd;
            background: #eff6ff;
            color: var(--recon-primary);
        }

    .recon-btn-success {
        border: 1px solid #a7f3d0;
        background: #ecfdf5;
        color: #047857;
    }

        .recon-btn-success:hover {
            background: #d1fae5;
            color: #047857;
        }

    .recon-btn-primary {
        border: 1px solid var(--recon-primary);
        background: var(--recon-primary);
        color: #fff;
    }

        .recon-btn-primary:hover {
            background: var(--recon-primary-dark);
            border-color: var(--recon-primary-dark);
            color: #fff;
        }

    /* =========================================
           ALERT
           ========================================= */

    .recon-alert {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 13px 15px;
        margin-bottom: 20px;
        border: 1px solid #a7f3d0;
        border-radius: 11px;
        background: #ecfdf5;
        color: #047857;
        font-size: 12px;
        font-weight: 650;
    }

        .recon-alert .btn-close {
            margin-left: auto;
        }

    /* =========================================
           COMMON CARD
           ========================================= */

    .recon-card {
        background: var(--recon-white);
        border: 1px solid var(--recon-border);
        border-radius: 17px;
        box-shadow: var(--recon-shadow);
        transition: box-shadow 0.25s ease, transform 0.25s ease;
    }

    /* =========================================
           ACCOUNT SELECTOR
           ========================================= */

    .recon-control-card {
        padding: 19px 21px;
        margin-bottom: 20px;
    }

    .recon-control-grid {
        display: grid;
        grid-template-columns: minmax(280px, 1.35fr) minmax(210px, 0.8fr) minmax(280px, 1fr);
        gap: 18px;
        align-items: end;
    }

    .recon-field label {
        display: block;
        margin-bottom: 7px;
        color: #64748b;
        font-size: 10px;
        font-weight: 800;
        letter-spacing: 0.04em;
        text-transform: uppercase;
    }

    .recon-input-group {
        display: flex;
        min-width: 0;
    }

    .recon-input-icon {
        width: 42px;
        min-width: 42px;
        display: flex;
        align-items: center;
        justify-content: center;
        border: 1px solid var(--recon-border);
        border-right: 0;
        border-radius: 9px 0 0 9px;
        background: #f8fafc;
        color: var(--recon-primary);
        font-size: 13px;
    }

    .recon-control {
        width: 100%;
        height: 42px;
        border: 1px solid var(--recon-border);
        border-radius: 9px;
        background: #fff;
        color: #334155;
        font-size: 12px;
        font-weight: 650;
        outline: none;
        transition: border-color 0.2s ease, box-shadow 0.2s ease;
    }

    .recon-input-group .recon-control {
        border-radius: 0 9px 9px 0;
        border-left: 0;
    }

    .recon-control:focus {
        border-color: #93c5fd;
        box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.08);
    }

    .recon-state {
        min-height: 42px;
        display: flex;
        align-items: center;
        justify-content: flex-end;
    }

    .recon-state-label {
        margin-right: 10px;
        color: #94a3b8;
        font-size: 10px;
        font-weight: 750;
        white-space: nowrap;
    }

    .recon-state-badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        min-height: 36px;
        padding: 0 12px;
        border-radius: 999px;
        font-size: 10px;
        font-weight: 800;
        white-space: nowrap;
    }

        .recon-state-badge.balanced {
            border: 1px solid #a7f3d0;
            background: #ecfdf5;
            color: #047857;
        }

        .recon-state-badge.warning {
            border: 1px solid #fde68a;
            background: #fffbeb;
            color: #b45309;
        }

    /* =========================================
           KPI CARDS
           ========================================= */

    .recon-kpi-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 16px;
        margin-bottom: 20px;
    }

    .recon-kpi {
        position: relative;
        overflow: hidden;
        min-width: 0;
        padding: 19px;
        border-left: 4px solid transparent;
        transition: transform 0.25s ease, box-shadow 0.25s ease;
    }

        .recon-kpi:hover {
            transform: translateY(-3px);
            box-shadow: var(--recon-shadow-hover);
        }

        .recon-kpi::after {
            content: "";
            position: absolute;
            width: 105px;
            height: 105px;
            right: -48px;
            bottom: -52px;
            border-radius: 50%;
            opacity: 0.06;
        }

    .recon-kpi-bank {
        border-left-color: #3b82f6;
    }

        .recon-kpi-bank::after {
            background: #3b82f6;
        }

    .recon-kpi-erp {
        border-left-color: #10b981;
    }

        .recon-kpi-erp::after {
            background: #10b981;
        }

    .recon-kpi-transit {
        border-left-color: #f59e0b;
    }

        .recon-kpi-transit::after {
            background: #f59e0b;
        }

    .recon-kpi-diff {
        border-left-color: #8b5cf6;
    }

        .recon-kpi-diff::after {
            background: #8b5cf6;
        }

    .recon-kpi-content {
        position: relative;
        z-index: 1;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 14px;
    }

    .recon-kpi-text {
        min-width: 0;
        flex: 1;
    }

    .recon-kpi-label {
        display: block;
        margin-bottom: 6px;
        overflow: hidden;
        color: #64748b;
        font-size: 10px;
        font-weight: 800;
        letter-spacing: 0.045em;
        text-overflow: ellipsis;
        text-transform: uppercase;
        white-space: nowrap;
    }

    .recon-kpi-value {
        margin: 0 0 5px;
        overflow: hidden;
        color: #1e293b;
        font-size: 20px;
        font-weight: 850;
        letter-spacing: -0.025em;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .recon-kpi-note {
        display: block;
        overflow: hidden;
        font-size: 10px;
        font-weight: 700;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

        .recon-kpi-note.blue {
            color: #2563eb;
        }

        .recon-kpi-note.green {
            color: #059669;
        }

        .recon-kpi-note.amber {
            color: #d97706;
        }

        .recon-kpi-note.success {
            color: #059669;
        }

        .recon-kpi-note.danger {
            color: #dc2626;
        }

    .recon-kpi-icon {
        width: 45px;
        height: 45px;
        min-width: 45px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 12px;
        font-size: 16px;
    }

        .recon-kpi-icon.blue {
            background: #eff6ff;
            color: #3b82f6;
        }

        .recon-kpi-icon.green {
            background: #ecfdf5;
            color: #10b981;
        }

        .recon-kpi-icon.amber {
            background: #fffbeb;
            color: #f59e0b;
        }

        .recon-kpi-icon.purple {
            background: #f5f3ff;
            color: #8b5cf6;
        }

    /* =========================================
           TRANSACTION CARD
           ========================================= */

    .recon-table-card {
        overflow: hidden;
    }

    .recon-table-header {
        padding: 18px 20px;
        border-bottom: 1px solid #edf2f7;
    }

    .recon-table-header-top {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        margin-bottom: 15px;
    }

    .recon-section-title {
        display: flex;
        align-items: center;
        gap: 11px;
    }

    .recon-section-icon {
        width: 38px;
        height: 38px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 10px;
        background: #eff6ff;
        color: var(--recon-primary);
        font-size: 14px;
    }

    .recon-section-title h2 {
        margin: 0;
        color: #0f172a;
        font-size: 15px;
        font-weight: 800;
    }

    .recon-section-title p {
        margin: 3px 0 0;
        color: #94a3b8;
        font-size: 10px;
    }

    .recon-count {
        color: #64748b;
        font-size: 11px;
        font-weight: 600;
        white-space: nowrap;
    }

        .recon-count strong {
            color: #1e293b;
            font-weight: 800;
        }

    /* =========================================
           FILTER TABS
           ========================================= */

    .recon-filters {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
    }

    .recon-filter-tabs {
        display: flex;
        flex-wrap: wrap;
        gap: 7px;
    }

    .recon-filter {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 34px;
        padding: 0 11px;
        border: 1px solid var(--recon-border);
        border-radius: 8px;
        background: #fff;
        color: #64748b;
        font-size: 10px;
        font-weight: 750;
        text-decoration: none;
        transition: all 0.2s ease;
        white-space: nowrap;
    }

        .recon-filter:hover {
            border-color: #cbd5e1;
            background: #f8fafc;
            color: #334155;
        }

        .recon-filter.active-all {
            border-color: var(--recon-primary);
            background: var(--recon-primary);
            color: #fff;
        }

        .recon-filter.active-unmatched {
            border-color: #dc2626;
            background: #dc2626;
            color: #fff;
        }

        .recon-filter.active-matched {
            border-color: #059669;
            background: #059669;
            color: #fff;
        }

        .recon-filter.active-uncleared {
            border-color: #d97706;
            background: #d97706;
            color: #fff;
        }

    /* =========================================
           TABLE
           ========================================= */

    .recon-table-wrap {
        width: 100%;
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
    }

    .recon-table {
        width: 100%;
        min-width: 1120px;
        border-collapse: separate;
        border-spacing: 0;
        margin: 0;
    }

        .recon-table thead th {
            padding: 12px 15px;
            background: #f8fafc;
            border-bottom: 1px solid var(--recon-border);
            color: #64748b;
            font-size: 9px;
            font-weight: 850;
            letter-spacing: 0.07em;
            text-transform: uppercase;
            white-space: nowrap;
        }

        .recon-table tbody td {
            padding: 14px 15px;
            border-bottom: 1px solid #f1f5f9;
            color: #475569;
            font-size: 11px;
            vertical-align: middle;
            background: #fff;
        }

        .recon-table tbody tr {
            transition: background 0.18s ease;
        }

            .recon-table tbody tr:hover td {
                background: #f8fbff;
            }

            .recon-table tbody tr:last-child td {
                border-bottom: 0;
            }

    .recon-status {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 5px 8px;
        border-radius: 999px;
        font-size: 9px;
        font-weight: 800;
        white-space: nowrap;
    }

        .recon-status.matched {
            border: 1px solid #a7f3d0;
            background: #ecfdf5;
            color: #047857;
        }

        .recon-status.unmatched {
            border: 1px solid #fecaca;
            background: #fef2f2;
            color: #dc2626;
        }

        .recon-status.uncleared {
            border: 1px solid #fde68a;
            background: #fffbeb;
            color: #b45309;
        }

        .recon-status i {
            font-size: 6px;
        }

    .recon-date {
        color: #64748b;
        font-weight: 650;
        white-space: nowrap;
    }

    .recon-reference {
        display: inline-flex;
        align-items: center;
        padding: 4px 7px;
        border: 1px solid #e2e8f0;
        border-radius: 6px;
        background: #f8fafc;
        color: #475569;
        font-family: "SFMono-Regular", Consolas, monospace;
        font-size: 9px;
        font-weight: 700;
        white-space: nowrap;
    }

    .recon-description {
        max-width: 220px;
        overflow: hidden;
        color: #1e293b;
        font-weight: 700;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .recon-category {
        display: inline-flex;
        align-items: center;
        padding: 5px 8px;
        border: 1px solid #e2e8f0;
        border-radius: 7px;
        background: #f8fafc;
        color: #475569;
        font-size: 9px;
        font-weight: 700;
        white-space: nowrap;
    }

    .recon-amount {
        font-size: 11px;
        font-weight: 800;
        white-space: nowrap;
    }

        .recon-amount.debit {
            color: #dc2626;
        }

        .recon-amount.credit {
            color: #059669;
        }

        .recon-amount.empty {
            color: #94a3b8;
            font-weight: 600;
        }

    .recon-match-ref {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        max-width: 170px;
        padding: 5px 8px;
        overflow: hidden;
        border: 1px solid #bfdbfe;
        border-radius: 7px;
        background: #eff6ff;
        color: #2563eb;
        font-size: 9px;
        font-weight: 750;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .recon-pending {
        color: #94a3b8;
        font-size: 10px;
        font-style: italic;
        white-space: nowrap;
    }

    .recon-row-action {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 5px;
        min-height: 30px;
        padding: 0 9px;
        border-radius: 7px;
        font-size: 9px;
        font-weight: 750;
        transition: all 0.2s ease;
        white-space: nowrap;
    }

        .recon-row-action:hover {
            transform: translateY(-1px);
        }

        .recon-row-action.match {
            border: 1px solid #a7f3d0;
            background: #fff;
            color: #059669;
        }

            .recon-row-action.match:hover {
                background: #ecfdf5;
            }

        .recon-row-action.unmatch {
            border: 1px solid #fecaca;
            background: #fff;
            color: #dc2626;
        }

            .recon-row-action.unmatch:hover {
                background: #fef2f2;
            }

    /* =========================================
           EMPTY TABLE
           ========================================= */

    .recon-empty {
        padding: 55px 20px !important;
        text-align: center;
    }

    .recon-empty-icon {
        width: 55px;
        height: 55px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 12px;
        border-radius: 15px;
        background: #f8fafc;
        color: #94a3b8;
        font-size: 20px;
    }

    .recon-empty-title {
        margin: 0;
        color: #334155;
        font-size: 14px;
        font-weight: 800;
    }

    .recon-empty-text {
        margin: 5px 0 0;
        color: #94a3b8;
        font-size: 11px;
    }

    /* =========================================
           MODAL
           ========================================= */

    .recon-modal .modal-content {
        overflow: hidden;
        border: 1px solid var(--recon-border);
        border-radius: 17px;
        box-shadow: 0 25px 70px rgba(15, 23, 42, 0.18);
    }

    .recon-modal-header {
        padding: 17px 20px;
        border: 0;
        background: linear-gradient(135deg, #2563eb, #1d4ed8);
        color: #fff;
    }

    .recon-modal-title {
        display: flex;
        align-items: center;
        gap: 10px;
        margin: 0;
        font-size: 16px;
        font-weight: 800;
    }

    .recon-modal-title-icon {
        width: 34px;
        height: 34px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 9px;
        background: rgba(255, 255, 255, 0.15);
        font-size: 13px;
    }

    .recon-modal-body {
        padding: 22px;
        background: #fff;
    }

    .recon-modal-field {
        margin-bottom: 17px;
    }

        .recon-modal-field:last-child {
            margin-bottom: 0;
        }

        .recon-modal-field label {
            display: block;
            margin-bottom: 7px;
            color: #334155;
            font-size: 11px;
            font-weight: 750;
        }

    .recon-modal-control {
        width: 100%;
        min-height: 40px;
        padding: 8px 11px;
        border: 1px solid #dbe3ec;
        border-radius: 9px;
        background: #fff;
        color: #334155;
        font-size: 12px;
        outline: none;
        transition: border-color 0.2s ease, box-shadow 0.2s ease;
    }

        .recon-modal-control:focus {
            border-color: #93c5fd;
            box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.08);
        }

    .recon-modal-help {
        margin-top: 6px;
        color: #94a3b8;
        font-size: 10px;
        line-height: 1.5;
    }

    .recon-modal-footer {
        display: flex;
        justify-content: flex-end;
        gap: 8px;
        padding: 14px 20px;
        border-top: 1px solid #edf2f7;
        background: #f8fafc;
    }

    .recon-modal-btn {
        min-height: 36px;
        padding: 0 13px;
        border-radius: 8px;
        font-size: 11px;
        font-weight: 750;
    }

    /* =========================================
           ANIMATIONS
           ========================================= */

    .recon-animate {
        animation: reconFadeUp 0.45s ease both;
    }

    .recon-delay-1 {
        animation-delay: 0.05s;
    }

    .recon-delay-2 {
        animation-delay: 0.10s;
    }

    .recon-delay-3 {
        animation-delay: 0.15s;
    }

    .recon-delay-4 {
        animation-delay: 0.20s;
    }

    @@keyframes reconFadeUp {
        from

    {
        opacity: 0;
        transform: translateY(9px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }

    }

    /* =========================================
           RESPONSIVE
           ========================================= */

    @@media (max-width: 1250px) {
        .recon-kpi-grid

    {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .recon-control-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .recon-state {
        justify-content: flex-start;
    }

    }

    @@media (max-width: 992px) {
        .recon-page-header

    {
        align-items: flex-start;
        flex-direction: column;
    }

    .recon-header-actions {
        width: 100%;
        justify-content: flex-start;
    }

    .recon-control-grid {
        grid-template-columns: 1fr;
    }

    .recon-state {
        align-items: flex-start;
        flex-direction: column;
        gap: 7px;
    }

    .recon-state-label {
        margin-right: 0;
    }

    }

    @@media (max-width: 768px) {
        .recon-wrapper

    {
        padding-top: 7px;
    }

    .recon-container {
        padding-left: 12px !important;
        padding-right: 12px !important;
    }

    .recon-title {
        font-size: 24px;
    }

    .recon-header-actions {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .recon-action-btn {
        width: 100%;
    }

    .recon-kpi-grid {
        grid-template-columns: 1fr;
    }

    .recon-table-header-top {
        align-items: flex-start;
        flex-direction: column;
    }

    .recon-filters {
        align-items: flex-start;
        flex-direction: column;
    }

    .recon-filter-tabs {
        width: 100%;
    }

    .recon-filter {
        flex: 1;
    }

    .recon-count {
        align-self: flex-start;
    }

    .recon-control-card {
        padding: 16px;
    }

    }

    @@media (max-width: 576px) {
        .recon-title

    {
        font-size: 21px;
    }

    .recon-subtitle {
        font-size: 12px;
    }

    .recon-header-actions {
        grid-template-columns: 1fr;
    }

    .recon-action-btn {
        min-height: 42px;
    }

    .recon-kpi {
        padding: 16px;
    }

    .recon-kpi-value {
        font-size: 18px;
    }

    .recon-kpi-icon {
        width: 41px;
        height: 41px;
        min-width: 41px;
    }

    .recon-filter-tabs {
        display: grid;
        grid-template-columns: 1fr 1fr;
    }

    .recon-filter {
        width: 100%;
    }

    .recon-table-header {
        padding: 16px;
    }

    .recon-modal-body {
        padding: 17px;
    }

    .recon-modal-footer {
        padding: 12px 17px;
    }

    }

    /* =========================================
           ACCESSIBILITY
           ========================================= */

    button:focus-visible,
    a:focus-visible,
    select:focus-visible,
    input:focus-visible {
        outline: 3px solid rgba(37, 99, 235, 0.18);
        outline-offset: 2px;
    }

    /* =========================================
           PRINT
           ========================================= */

    @@media print {
        body

    {
        background: #fff !important;
    }

    .recon-wrapper {
        padding: 0;
    }

    .recon-header-actions,
    .recon-filter-tabs,
    .recon-row-action,
    .recon-modal,
    .recon-alert .btn-close {
        display: none !important;
    }

    .recon-card,
    .recon-kpi {
        box-shadow: none !important;
        break-inside: avoid;
    }

    .recon-table-wrap {
        overflow: visible;
    }

    .recon-table {
        min-width: 0;
    }

        .recon-table tbody tr:hover td {
            background: transparent !important;
        }

    }

    @@media (prefers-reduced-motion: reduce) {
        *, *::before, *::after

    {
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.01ms !important;
    }

    }</style>

<div class="recon-wrapper">
    <div class="container-fluid px-3 px-xl-4 recon-container">

        <!-- =========================================
             PAGE HEADER
             ========================================= -->
        <div class="recon-page-header recon-animate">

            <div class="recon-header-left">

                <div class="recon-breadcrumb">
                    <a asp-action="Index">Finance Suite</a>
                    <span class="separator">/</span>
                    <span>Treasury &amp; Banking</span>
                </div>

                <div class="recon-eyebrow">
                    Treasury &amp; Banking
                </div>

                <h1 class="recon-title">
                    Bank &amp; Cash Reconciliation Studio
                </h1>

                <p class="recon-subtitle">
                    Match bank statement activity with ERP ledger entries, identify discrepancies,
                    and maintain an accurate reconciliation position.
                </p>

            </div>

            <div class="recon-header-actions">

                <button type="button"
                        class="recon-action-btn recon-btn-outline"
                        data-bs-toggle="modal"
                        data-bs-target="#uploadStatementModal">
                    <i class="fa-solid fa-cloud-arrow-up"></i>
                    <span>Upload Statement</span>
                </button>

                <button type="button"
                        class="recon-action-btn recon-btn-success"
                        onclick="autoMatchAll()">
                    <i class="fa-solid fa-wand-magic-sparkles"></i>
                    <span>Auto-Match</span>
                </button>

                <a asp-action="Ledger"
                   class="recon-action-btn recon-btn-primary">
                    <i class="fa-solid fa-file-invoice"></i>
                    <span>Post Recon JV</span>
                </a>

            </div>
        </div>

        <!-- =========================================
             SUCCESS MESSAGE
             ========================================= -->
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="recon-alert recon-animate" role="alert">
                <i class="fa-solid fa-circle-check"></i>
                <span>@TempData["SuccessMessage"]</span>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="alert"
                        aria-label="Close">
                </button>
            </div>
        }

        <!-- =========================================
             ACCOUNT SELECTOR
             ========================================= -->
        <div class="recon-card recon-control-card recon-animate recon-delay-1">

            <div class="recon-control-grid">

                <!-- BANK ACCOUNT -->
                <div class="recon-field">

                    <label>
                        Select Bank / Cash Ledger Account
                    </label>

                    <div class="recon-input-group">

                        <span class="recon-input-icon">
                            <i class="fa-solid fa-building-columns"></i>
                        </span>

                        <select class="recon-control"
                                onchange="location.href='@Url.Action("BankRecon")?bankAccount=' + this.value;">

                            <option selected>
                                HDFC Corporate Current A/c (50200084924829)
                            </option>

                            <option>
                                ICICI Operating A/c (004905012490)
                            </option>

                            <option>
                                SBI Treasury Reserve A/c (33091244810)
                            </option>

                            <option>
                                Main Office Cash Ledger (AC-1001)
                            </option>

                        </select>

                    </div>
                </div>

                <!-- STATEMENT DATE -->
                <div class="recon-field">

                    <label>
                        Statement As Of Date
                    </label>

                    <div class="recon-input-group">

                        <span class="recon-input-icon" style="color:#64748b;">
                            <i class="fa-regular fa-calendar"></i>
                        </span>

                        <input type="text"
                               class="recon-control"
                               value="@Model.StatementDate.ToString("dd MMM yyyy")"
                               readonly />

                    </div>
                </div>

                <!-- RECONCILIATION STATE -->
                <div class="recon-field">

                    <label>
                        Current Reconciliation State
                    </label>

                    <div class="recon-state">

                        @if (Model.IsBalanced)
                        {
                            <span class="recon-state-badge balanced">
                                <i class="fa-solid fa-circle-check"></i>
                                Perfect Match
                                <span>₹ 0.00 Variance</span>
                            </span>
                        }
                        else
                        {
                            <span class="recon-state-badge warning">
                                <i class="fa-solid fa-triangle-exclamation"></i>
                                Variance:
                                ₹ @Math.Abs(Model.UnreconciledDifference).ToString("N2")
                            </span>
                        }

                    </div>
                </div>

            </div>
        </div>

        <!-- =========================================
             KPI SUMMARY
             ========================================= -->
        <div class="recon-kpi-grid">

            <!-- BANK BALANCE -->
            <div class="recon-card recon-kpi recon-kpi-bank recon-animate recon-delay-1">

                <div class="recon-kpi-content">

                    <div class="recon-kpi-text">

                        <span class="recon-kpi-label">
                            Bank Statement Balance
                        </span>

                        <div class="recon-kpi-value">
                            ₹ @Model.StatementEndingBalance.ToString("N2")
                        </div>

                        <span class="recon-kpi-note blue">
                            <i class="fa-solid fa-building-columns me-1"></i>
                            Per Bank File
                        </span>

                    </div>

                    <div class="recon-kpi-icon blue">
                        <i class="fa-solid fa-file-invoice-dollar"></i>
                    </div>

                </div>
            </div>

            <!-- ERP BALANCE -->
            <div class="recon-card recon-kpi recon-kpi-erp recon-animate recon-delay-2">

                <div class="recon-kpi-content">

                    <div class="recon-kpi-text">

                        <span class="recon-kpi-label">
                            ERP Ledger Book Balance
                        </span>

                        <div class="recon-kpi-value">
                            ₹ @Model.LedgerBookBalance.ToString("N2")
                        </div>

                        <span class="recon-kpi-note green">
                            <i class="fa-solid fa-book me-1"></i>
                            General Ledger
                        </span>

                    </div>

                    <div class="recon-kpi-icon green">
                        <i class="fa-solid fa-scale-balanced"></i>
                    </div>

                </div>
            </div>

            <!-- UNCLEARED -->
            <div class="recon-card recon-kpi recon-kpi-transit recon-animate recon-delay-3">

                <div class="recon-kpi-content">

                    <div class="recon-kpi-text">

                        <span class="recon-kpi-label">
                            Uncleared / Transit Items
                        </span>

                        <div class="recon-kpi-value">
                            ₹ @Model.UnclearedPaymentsTotal.ToString("N2")
                        </div>

                        <span class="recon-kpi-note amber">
                            <i class="fa-solid fa-clock-rotate-left me-1"></i>
                            Unpresented Cheques
                        </span>

                    </div>

                    <div class="recon-kpi-icon amber">
                        <i class="fa-solid fa-money-bill-transfer"></i>
                    </div>

                </div>
            </div>

            <!-- VARIANCE -->
            <div class="recon-card recon-kpi recon-kpi-diff recon-animate recon-delay-4">

                <div class="recon-kpi-content">

                    <div class="recon-kpi-text">

                        <span class="recon-kpi-label">
                            Reconciliation Variance
                        </span>

                        <div class="recon-kpi-value @(Model.IsBalanced ? "text-success" : "text-danger")">
                            ₹ @Math.Abs(Model.UnreconciledDifference).ToString("N2")
                        </div>

                        @if (Model.IsBalanced)
                        {
                            <span class="recon-kpi-note success">
                                <i class="fa-solid fa-circle-check me-1"></i>
                                100% Balanced
                            </span>
                        }
                        else
                        {
                            <span class="recon-kpi-note danger">
                                <i class="fa-solid fa-circle-exclamation me-1"></i>
                                Difference Pending Action
                            </span>
                        }

                    </div>

                    <div class="recon-kpi-icon purple">
                        <i class="fa-solid fa-calculator"></i>
                    </div>

                </div>
            </div>

        </div>

        <!-- =========================================
             RECONCILIATION TRANSACTIONS
             ========================================= -->
        <div class="recon-card recon-table-card recon-animate">

            <!-- TABLE HEADER -->
            <div class="recon-table-header">

                <div class="recon-table-header-top">

                    <div class="recon-section-title">

                        <span class="recon-section-icon">
                            <i class="fa-solid fa-list-check"></i>
                        </span>

                        <div>
                            <h2>Bank Reconciliation Ledger</h2>
                            <p>
                                Review statement events and their ERP voucher matching status
                            </p>
                        </div>

                    </div>

                    <div class="recon-count">
                        Showing
                        <strong>@Model.Transactions.Count</strong>
                        recorded banking events
                    </div>

                </div>

                <!-- FILTERS -->
                <div class="recon-filters">

                    <div class="recon-filter-tabs">

                        <a asp-action="BankRecon"
                           asp-route-filter="All"
                           class="recon-filter @(currentFilter == "All" ? "active-all" : "")">
                            All Statement Items (@Model.Transactions.Count)
                        </a>

                        <a asp-action="BankRecon"
                           asp-route-filter="Unmatched"
                           class="recon-filter @(currentFilter == "Unmatched" ? "active-unmatched" : "")">
                            Unmatched Discrepancies
                        </a>

                        <a asp-action="BankRecon"
                           asp-route-filter="Matched"
                           class="recon-filter @(currentFilter == "Matched" ? "active-matched" : "")">
                            Matched / Verified
                        </a>

                        <a asp-action="BankRecon"
                           asp-route-filter="Uncleared"
                           class="recon-filter @(currentFilter == "Uncleared" ? "active-uncleared" : "")">
                            Uncleared Cheques
                        </a>

                    </div>

                </div>

            </div>

            <!-- TABLE -->
            <div class="recon-table-wrap">

                <table class="recon-table">

                    <thead>
                        <tr>
                            <th style="width:110px;">Status</th>
                            <th>Date</th>
                            <th>Reference / Cheque</th>
                            <th>Description / Payee</th>
                            <th>Category</th>
                            <th class="text-end">Withdrawal (Dr)</th>
                            <th class="text-end">Deposit (Cr)</th>
                            <th>ERP Matched Voucher</th>
                            <th class="text-center" style="width:125px;">Action</th>
                        </tr>
                    </thead>

                    <tbody>

                        @if (Model.Transactions != null && Model.Transactions.Any())
                        {
                            @foreach (var item in Model.Transactions)
                            {
                                <tr id="row-@item.Id">

                                    <!-- STATUS -->
                                    <td>
                                        @if (item.IsMatched)
                                        {
                                            <span class="recon-status matched">
                                                <i class="fa-solid fa-circle"></i>
                                                Matched
                                            </span>
                                        }
                                        else if (item.Category == "Vendor Payout")
                                        {
                                            <span class="recon-status uncleared">
                                                <i class="fa-solid fa-circle"></i>
                                                Uncleared
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="recon-status unmatched">
                                                <i class="fa-solid fa-circle"></i>
                                                Unmatched
                                            </span>
                                        }
                                    </td>

                                    <!-- DATE -->
                                    <td>
                                        <span class="recon-date">
                                            @item.Date.ToString("dd MMM yyyy")
                                        </span>
                                    </td>

                                    <!-- REFERENCE -->
                                    <td>
                                        <span class="recon-reference">
                                            @item.ReferenceNo
                                        </span>
                                    </td>

                                    <!-- DESCRIPTION -->
                                    <td>
                                        <div class="recon-description"
                                             title="@item.Description">
                                            @item.Description
                                        </div>
                                    </td>

                                    <!-- CATEGORY -->
                                    <td>
                                        <span class="recon-category">
                                            @item.Category
                                        </span>
                                    </td>

                                    <!-- WITHDRAWAL -->
                                    <td class="text-end">
                                        @if (item.Withdrawal > 0)
                                        {
                                            <span class="recon-amount debit">
                                                ₹ @item.Withdrawal.ToString("N2")
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="recon-amount empty">-</span>
                                        }
                                    </td>

                                    <!-- DEPOSIT -->
                                    <td class="text-end">
                                        @if (item.Deposit > 0)
                                        {
                                            <span class="recon-amount credit">
                                                ₹ @item.Deposit.ToString("N2")
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="recon-amount empty">-</span>
                                        }
                                    </td>

                                    <!-- ERP MATCH -->
                                    <td>
                                        @if (!string.IsNullOrEmpty(item.ErpMatchRef))
                                        {
                                            <span class="recon-match-ref"
                                                  title="@item.ErpMatchRef">
                                                <i class="fa-solid fa-link"></i>
                                                @item.ErpMatchRef
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="recon-pending">
                                                Pending link
                                            </span>
                                        }
                                    </td>

                                    <!-- ACTION -->
                                    <td class="text-center">

                                        @if (item.IsMatched)
                                        {
                                            <button type="button"
                                                    class="recon-row-action unmatch"
                                                    onclick="toggleMatch(@item.Id, false)"
                                                    title="Unmatch entry">

                                                <i class="fa-solid fa-link-slash"></i>
                                                Unmatch

                                            </button>
                                        }
                                        else
                                        {
                                            <button type="button"
                                                    class="recon-row-action match"
                                                    onclick="toggleMatch(@item.Id, true)"
                                                    title="Match with ERP Voucher">

                                                <i class="fa-solid fa-link"></i>
                                                Match

                                            </button>
                                        }

                                    </td>

                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="9" class="recon-empty">

                                    <div class="recon-empty-icon">
                                        <i class="fa-solid fa-building-columns"></i>
                                    </div>

                                    <p class="recon-empty-title">
                                        No reconciliation transactions found
                                    </p>

                                    <p class="recon-empty-text">
                                        There are no banking events available for the selected filter.
                                    </p>

                                </td>
                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        </div>

    </div>
</div>

<!-- =========================================
     UPLOAD STATEMENT MODAL
     ========================================= -->
<div class="modal fade recon-modal"
     id="uploadStatementModal"
     tabindex="-1"
     aria-labelledby="uploadStatementModalLabel"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content">

            <form asp-action="UploadStatement"
                  method="post"
                  enctype="multipart/form-data">

                <!-- MODAL HEADER -->
                <div class="modal-header recon-modal-header">

                    <h5 class="recon-modal-title"
                        id="uploadStatementModalLabel">

                        <span class="recon-modal-title-icon">
                            <i class="fa-solid fa-cloud-arrow-up"></i>
                        </span>

                        Upload Bank Statement

                    </h5>

                    <button type="button"
                            class="btn-close btn-close-white"
                            data-bs-dismiss="modal"
                            aria-label="Close">
                    </button>

                </div>

                <!-- MODAL BODY -->
                <div class="recon-modal-body">

                    <!-- BANK ACCOUNT -->
                    <div class="recon-modal-field">

                        <label>
                            Bank Account
                        </label>

                        <select class="recon-modal-control"
                                name="bankAccount"
                                required>

                            <option value="HDFC">
                                HDFC Corporate Current A/c - 50200084924829
                            </option>

                            <option value="ICICI">
                                ICICI Operating A/c - 004905012490
                            </option>

                            <option value="SBI">
                                SBI Treasury Reserve A/c - 33091244810
                            </option>

                        </select>

                    </div>

                    <!-- CLOSING DATE -->
                    <div class="recon-modal-field">

                        <label>
                            Statement Closing Date
                        </label>

                        <input type="date"
                               class="recon-modal-control"
                               name="closingDate"
                               value="@DateTime.Today.ToString("yyyy-MM-dd")"
                               required />

                    </div>

                    <!-- BALANCE -->
                    <div class="recon-modal-field">

                        <label>
                            Statement Closing Balance (₹)
                        </label>

                        <input type="number"
                               step="0.01"
                               class="recon-modal-control"
                               name="statementBalance"
                               value="42500000.00"
                               required />

                    </div>

                    <!-- FILE -->
                    <div class="recon-modal-field">

                        <label>
                            Bank Statement File
                        </label>

                        <input type="file"
                               class="recon-modal-control"
                               name="statementFile"
                               accept=".csv,.xlsx,.xls,.ofx" />

                        <div class="recon-modal-help">
                            Supports standard MT940, CSV and Excel exports from HDFC,
                            ICICI, SBI and Axis Bank.
                        </div>

                    </div>

                </div>

                <!-- MODAL FOOTER -->
                <div class="recon-modal-footer">

                    <button type="button"
                            class="btn btn-secondary recon-modal-btn"
                            data-bs-dismiss="modal">
                        Cancel
                    </button>

                    <button type="submit"
                            class="btn btn-primary recon-modal-btn px-3">

                        <i class="fa-solid fa-file-import me-1"></i>
                        Process &amp; Reconcile

                    </button>

                </div>

            </form>

        </div>
    </div>
</div>

<script>
    function toggleMatch(id, matched) {
        fetch('@Url.Action("ToggleReconMatch", "Finance")', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/x-www-form-urlencoded',
            },
            body: `id=${id}&matched=${matched}`
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                location.reload();
            }
        })
        .catch(err => console.error(err));
    }

    function autoMatchAll() {
        alert('Auto-matching engine completed: 3 unlinked bank statement items reconciled with matching ERP Payment Vouchers based on Reference numbers and Amount parity.');
        location.reload();
    }
</script>
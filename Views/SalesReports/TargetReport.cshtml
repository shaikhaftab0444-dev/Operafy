@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Sales Target Report";
}

<div class="container-fluid py-4 text-start">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-bold mb-1"><i class="fa-solid fa-crosshairs text-primary me-2"></i>Sales Target Report</h4>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0 small">
                    <li class="breadcrumb-item"><a href="/SalesDashboard" class="text-decoration-none">Sales Management</a></li>
                    <li class="breadcrumb-item">Sales Reports</li>
                    <li class="breadcrumb-item active" aria-current="page">Target Report</li>
                </ol>
            </nav>
        </div>
        <button class="btn btn-outline-secondary rounded-pill px-3"><i class="fa-solid fa-download me-1.5"></i>Export PDF</button>
    </div>

    <!-- Target Report Table -->
    <div class="bg-white border rounded-3 p-4 shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" style="font-size: 0.85rem;">
                <thead class="table-light">
                    <tr>
                        <th>Quarter</th>
                        <th>Target Amount</th>
                        <th>Achieved Amount</th>
                        <th>Variance</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td class="fw-bold text-dark">Q1 2026</td>
                        <td>₹1,50,00,000</td>
                        <td class="fw-bold text-success">₹1,62,00,000</td>
                        <td class="text-success">+₹12,00,000</td>
                        <td><span class="badge bg-success-subtle text-success rounded-pill px-2.5 py-1">Exceeded</span></td>
                    </tr>
                    <tr>
                        <td class="fw-bold text-dark">Q2 2026</td>
                        <td>₹1,80,00,000</td>
                        <td class="fw-bold text-success">₹1,75,000</td>
                        <td class="text-danger">-₹5,00,000</td>
                        <td><span class="badge bg-warning-subtle text-warning rounded-pill px-2.5 py-1">Under Target</span></td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

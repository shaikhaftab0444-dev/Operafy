```cshtml
@model ERP_System.Models.TargetReportsListViewModel
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Sales Target Report";
    var inCulture = new System.Globalization.CultureInfo("en-IN");
}

<style>
    .target-report-page {
        --tr-primary: #2563eb;
        --tr-primary-dark: #1d4ed8;
        --tr-success: #16a34a;
        --tr-warning: #d97706;
        --tr-danger: #dc2626;
        --tr-text: #172033;
        --tr-muted: #64748b;
        --tr-border: #e2e8f0;
        --tr-soft: #f8fafc;
        --tr-radius: 16px;
    }

        /* =========================
           PAGE HEADER
           ========================= */

        .target-report-page .report-header {
            background: linear-gradient(135deg, #ffffff 0%, #f8fafc 100%);
            border: 1px solid var(--tr-border);
            border-radius: var(--tr-radius);
            padding: 22px 24px;
            box-shadow: 0 4px 18px rgba(15, 23, 42, 0.045);
        }

        .target-report-page .title-icon {
            width: 46px;
            height: 46px;
            border-radius: 13px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            background: #eff6ff;
            color: var(--tr-primary);
            font-size: 1.15rem;
            flex-shrink: 0;
        }

        .target-report-page .page-title {
            color: var(--tr-text);
            letter-spacing: -0.02em;
        }

        .target-report-page .breadcrumb {
            margin-top: 5px;
        }

        .target-report-page .breadcrumb-item + .breadcrumb-item::before {
            color: #94a3b8;
        }

        .target-report-page .filter-control {
            min-height: 41px;
            min-width: 145px;
            border-radius: 10px;
            border: 1px solid #dbe3ed;
            color: #334155;
            font-size: 0.8rem;
            font-weight: 650;
            background-color: #fff;
            box-shadow: 0 2px 8px rgba(15, 23, 42, 0.035);
        }

            .target-report-page .filter-control:focus {
                border-color: #93c5fd;
                box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.10);
            }

        .target-report-page .export-btn {
            min-height: 41px;
            border-radius: 10px;
            padding: 0 17px;
            font-weight: 650;
            transition: all 0.18s ease;
        }

            .target-report-page .export-btn:hover {
                transform: translateY(-1px);
                box-shadow: 0 6px 15px rgba(15, 23, 42, 0.09);
            }

        /* =========================
           KPI CARDS
           ========================= */

        .target-report-page .kpi-card {
            position: relative;
            overflow: hidden;
            min-height: 148px;
            background: #ffffff;
            border: 1px solid var(--tr-border);
            border-radius: var(--tr-radius);
            padding: 19px;
            box-shadow: 0 4px 16px rgba(15, 23, 42, 0.045);
            transition: transform 0.18s ease, box-shadow 0.18s ease, border-color 0.18s ease;
        }

            .target-report-page .kpi-card::after {
                content: "";
                position: absolute;
                width: 100px;
                height: 100px;
                right: -42px;
                bottom: -42px;
                border-radius: 50%;
                background: rgba(37, 99, 235, 0.035);
                pointer-events: none;
            }

            .target-report-page .kpi-card:hover {
                transform: translateY(-3px);
                border-color: #d5deeb;
                box-shadow: 0 10px 26px rgba(15, 23, 42, 0.075);
            }

        .target-report-page .kpi-label {
            color: var(--tr-muted);
            font-size: 0.77rem;
            font-weight: 750;
            letter-spacing: 0.01em;
        }

        .target-report-page .kpi-icon {
            width: 42px;
            height: 42px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border-radius: 12px;
            font-size: 0.95rem;
            flex-shrink: 0;
        }

        .target-report-page .kpi-value {
            font-size: 1.52rem;
            line-height: 1.2;
            letter-spacing: -0.025em;
        }

        .target-report-page .kpi-caption {
            color: #94a3b8;
            font-size: 0.73rem;
        }

        /* =========================
           CATEGORY BREAKDOWN
           ========================= */

        .target-report-page .category-card {
            background: #ffffff;
            border: 1px solid var(--tr-border);
            border-radius: var(--tr-radius);
            padding: 21px 22px;
            box-shadow: 0 5px 20px rgba(15, 23, 42, 0.045);
        }

        .target-report-page .section-heading {
            color: var(--tr-text);
            font-size: 0.98rem;
            font-weight: 750;
        }

        .target-report-page .section-subtitle {
            color: var(--tr-muted);
            font-size: 0.76rem;
        }

        .target-report-page .section-icon {
            width: 39px;
            height: 39px;
            border-radius: 10px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            background: #eff6ff;
            color: var(--tr-primary);
            flex-shrink: 0;
        }

        .target-report-page .category-item {
            height: 100%;
            background: #f8fafc;
            border: 1px solid #e5eaf0;
            border-radius: 13px;
            padding: 16px;
            transition: all 0.18s ease;
        }

            .target-report-page .category-item:hover {
                background: #ffffff;
                border-color: #d6e0ec;
                box-shadow: 0 7px 18px rgba(15, 23, 42, 0.055);
                transform: translateY(-2px);
            }

        .target-report-page .category-name {
            color: var(--tr-text);
            font-size: 0.84rem;
            font-weight: 750;
        }

        .target-report-page .category-stat {
            color: #64748b;
            font-size: 0.73rem;
        }

        .target-report-page .category-achieved {
            color: var(--tr-success);
            font-weight: 700;
        }

        .target-report-page .category-progress {
            height: 7px;
            background: #e9eef5;
            border-radius: 999px;
            overflow: hidden;
        }

            .target-report-page .category-progress .progress-bar {
                border-radius: 999px;
            }

        /* =========================
           REPORT CARD
           ========================= */

        .target-report-page .report-card {
            background: #ffffff;
            border: 1px solid var(--tr-border);
            border-radius: var(--tr-radius);
            box-shadow: 0 5px 20px rgba(15, 23, 42, 0.045);
            overflow: hidden;
        }

        .target-report-page .report-card-header {
            padding: 20px 22px;
            border-bottom: 1px solid var(--tr-border);
            background: linear-gradient(180deg, #ffffff 0%, #fbfdff 100%);
        }

        .target-report-page .table-wrapper {
            overflow-x: auto;
        }

        .target-report-page .target-table {
            min-width: 1020px;
            margin-bottom: 0;
        }

            .target-report-page .target-table thead th {
                background: #f8fafc;
                color: #64748b;
                border-top: 0;
                border-bottom: 1px solid #e2e8f0;
                padding: 13px 15px;
                font-size: 0.71rem;
                font-weight: 750;
                letter-spacing: 0.025em;
                text-transform: uppercase;
                white-space: nowrap;
            }

            .target-report-page .target-table tbody td {
                padding: 15px;
                border-color: #eef2f7;
                vertical-align: middle;
                color: #334155;
            }

            .target-report-page .target-table tbody tr {
                transition: background-color 0.15s ease;
            }

                .target-report-page .target-table tbody tr:hover {
                    background: #f8fbff;
                }

            .target-report-page .target-table tfoot td {
                padding: 15px;
                border-top: 1px solid #dbe3ed;
            }

        /* =========================
           QUARTER CELL
           ========================= */

        .target-report-page .quarter-icon {
            width: 34px;
            height: 34px;
            border-radius: 9px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            background: #eff6ff;
            color: var(--tr-primary);
            border: 1px solid #dbeafe;
            flex-shrink: 0;
        }

        .target-report-page .quarter-name {
            color: var(--tr-text);
            font-size: 0.84rem;
            font-weight: 750;
        }

        .target-report-page .amount-target {
            color: #475569;
            font-weight: 650;
        }

        .target-report-page .amount-achieved {
            color: var(--tr-success);
            font-weight: 750;
        }

        /* =========================
           VARIANCE
           ========================= */

        .target-report-page .variance-value {
            font-weight: 750;
            white-space: nowrap;
        }

        /* =========================
           ACHIEVEMENT BAR
           ========================= */

        .target-report-page .achievement-wrapper {
            min-width: 180px;
        }

        .target-report-page .achievement-bar {
            height: 7px;
            background: #edf2f7;
            border-radius: 999px;
            overflow: hidden;
        }

            .target-report-page .achievement-bar .progress-bar {
                border-radius: 999px;
            }

        .target-report-page .achievement-value {
            min-width: 50px;
            text-align: right;
            color: #334155;
            font-size: 0.74rem;
            font-weight: 750;
        }

        /* =========================
           STATUS BADGES
           ========================= */

        .target-report-page .status-badge {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 5px;
            min-width: 115px;
            border-radius: 999px;
            padding: 7px 11px;
            font-size: 0.71rem;
            font-weight: 750;
            white-space: nowrap;
        }

        /* =========================
           EMPTY STATE
           ========================= */

        .target-report-page .empty-state {
            padding: 55px 20px;
        }

        .target-report-page .empty-icon {
            width: 58px;
            height: 58px;
            border-radius: 16px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            background: #f1f5f9;
            color: #94a3b8;
            font-size: 1.3rem;
            margin-bottom: 14px;
        }

        .target-report-page .total-label {
            color: var(--tr-text);
            font-weight: 750;
        }

        .target-report-page .report-note {
            padding: 13px 18px;
            border-top: 1px solid #e2e8f0;
            background: #f8fafc;
            color: #64748b;
            font-size: 0.73rem;
        }

    /* =========================
           RESPONSIVE
           ========================= */

    @@media (max-width: 991.98px) {
        .target-report-page .report-header {
            padding: 18px;
        }

        .target-report-page .kpi-card {
            min-height: 138px;
        }
    }

    @@media (max-width: 575.98px) {
        .target-report-page {
            padding-left: 2px;
            padding-right: 2px;
        }

            .target-report-page .report-header {
                padding: 16px;
            }

            .target-report-page .title-icon {
                width: 40px;
                height: 40px;
                border-radius: 11px;
            }

            .target-report-page .page-title {
                font-size: 1.05rem;
            }

            .target-report-page .header-actions {
                width: 100%;
            }

            .target-report-page .filter-form,
            .target-report-page .filter-control,
            .target-report-page .export-btn {
                width: 100%;
            }

            .target-report-page .kpi-card {
                padding: 16px;
            }

            .target-report-page .kpi-value {
                font-size: 1.34rem;
            }

            .target-report-page .category-card {
                padding: 17px;
            }

            .target-report-page .report-card-header {
                padding: 17px;
            }
    }

    /* =========================
           PRINT
           ========================= */

    .target-report-page .print-only-header {
        display: none;
    }

    @@media print {
        #sidebar,
        .sidebar,
        .topbar,
        .navbar,
        .btn,
        .breadcrumb,
        nav,
        footer,
        .no-print,
        select {
            display: none !important;
        }

        body,
        .container-fluid,
        .main-content {
            padding: 0 !important;
            margin: 0 !important;
            background: #fff !important;
            width: 100% !important;
        }

        .target-report-page .print-only-header {
            display: block !important;
            border-bottom: 2px solid #0f172a;
            margin-bottom: 20px;
            padding-bottom: 10px;
        }

        .target-report-page .report-header {
            display: none !important;
        }

        .target-report-page .kpi-card,
        .target-report-page .category-card,
        .target-report-page .report-card {
            box-shadow: none !important;
            border: 1px solid #cbd5e1 !important;
        }

        .target-report-page .category-item {
            box-shadow: none !important;
            background: #fff !important;
        }

        .target-report-page .target-table {
            min-width: 0 !important;
        }

        .target-report-page .report-card-header {
            background: #fff !important;
        }

        .target-report-page .report-note {
            display: none !important;
        }
    }
</style>

<div class="container-fluid py-4 text-start target-report-page">

    <!-- Print-only Brand Header -->
    <div class="print-only-header">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <h3 class="fw-bold mb-0 text-dark">
                    OPERAFY ENTERPRISE ERP
                </h3>

                <p class="text-muted small mb-0">
                    Fiscal Target Realization & Variance Analysis
                </p>
            </div>

            <div class="text-end small text-muted">
                <div>
                    <strong>Generated:</strong>
                    @DateTime.Now.ToString("dd MMM yyyy HH:mm")
                </div>

                <div>
                    <strong>Filter:</strong>
                    @Model.SelectedQuarter
                </div>
            </div>
        </div>
    </div>

    <!-- Page Header -->
    <div class="report-header mb-4 no-print">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">

            <div class="d-flex align-items-center gap-3">

                <div class="title-icon">
                    <i class="fa-solid fa-crosshairs"></i>
                </div>

                <div>
                    <h4 class="page-title fw-bold mb-1">
                        Sales Target Report
                    </h4>

                    <nav aria-label="breadcrumb">
                        <ol class="breadcrumb mb-0 small">

                            <li class="breadcrumb-item">
                                <a href="/SalesDashboard"
                                   class="text-decoration-none text-muted">
                                    Sales Management
                                </a>
                            </li>

                            <li class="breadcrumb-item text-muted">
                                Sales Reports
                            </li>

                            <li class="breadcrumb-item active fw-semibold"
                                aria-current="page">
                                Target Report
                            </li>

                        </ol>
                    </nav>
                </div>

            </div>

            <div class="d-flex align-items-center gap-2 header-actions">

                <!-- Quarter Filter -->
                <form method="get"
                      asp-action="TargetReport"
                      class="d-flex align-items-center filter-form">

                    <select name="quarter"
                            class="form-select filter-control"
                            onchange="this.form.submit()">

                        <option value="All"
                                selected="@(Model.SelectedQuarter == "All")">
                            All Quarters
                        </option>

                        <option value="Q1 2026"
                                selected="@(Model.SelectedQuarter == "Q1 2026")">
                            Q1 2026
                        </option>

                        <option value="Q2 2026"
                                selected="@(Model.SelectedQuarter == "Q2 2026")">
                            Q2 2026
                        </option>

                        <option value="Q3 2026"
                                selected="@(Model.SelectedQuarter == "Q3 2026")">
                            Q3 2026
                        </option>

                        <option value="Q4 2026"
                                selected="@(Model.SelectedQuarter == "Q4 2026")">
                            Q4 2026
                        </option>

                    </select>

                </form>

                <!-- Print -->
                <button type="button"
                        onclick="window.print()"
                        class="btn btn-outline-secondary export-btn shadow-sm">

                    <i class="fa-solid fa-print me-2"></i>
                    Export PDF

                </button>

            </div>

        </div>
    </div>

    <!-- KPI Summary -->
    <div class="row g-3 mb-4">

        <!-- Target Quota -->
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="kpi-card">

                <div class="d-flex align-items-center justify-content-between mb-3">

                    <span class="kpi-label">
                        Target Quota
                    </span>

                    <span class="kpi-icon bg-primary-subtle text-primary">
                        <i class="fa-solid fa-bullseye"></i>
                    </span>

                </div>

                <h3 class="kpi-value fw-bold text-dark mb-2">
                    @Model.TotalTarget.ToString("C0", inCulture)
                </h3>

                <span class="kpi-caption">
                    Assigned quarterly quota
                </span>

            </div>
        </div>

        <!-- Achieved Sales -->
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="kpi-card">

                <div class="d-flex align-items-center justify-content-between mb-3">

                    <span class="kpi-label">
                        Achieved Sales
                    </span>

                    <span class="kpi-icon bg-success-subtle text-success">
                        <i class="fa-solid fa-check-double"></i>
                    </span>

                </div>

                <h3 class="kpi-value fw-bold text-success mb-2">
                    @Model.TotalAchieved.ToString("C0", inCulture)
                </h3>

                <span class="kpi-caption">
                    Actual realized collections
                </span>

            </div>
        </div>

        <!-- Net Variance -->
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="kpi-card">

                <div class="d-flex align-items-center justify-content-between mb-3">

                    <span class="kpi-label">
                        Net Variance
                    </span>

                    <span class="kpi-icon @(Model.TotalVariance >= 0 ? "bg-success-subtle text-success" : "bg-danger-subtle text-danger")">
                        <i class="fa-solid @(Model.TotalVariance >= 0 ? "fa-arrow-trend-up" : "fa-arrow-trend-down")"></i>
                    </span>

                </div>

                <h3 class="kpi-value fw-bold @(Model.TotalVariance >= 0 ? "text-success" : "text-danger") mb-2">

                    @(Model.TotalVariance >= 0 ? "+" : "")@Model.TotalVariance.ToString("C0", inCulture)

                </h3>

                <span class="kpi-caption">
                    @(Model.TotalVariance >= 0
                                        ? "Surplus over target"
                                        : "Deficit to quota")
                </span>

            </div>
        </div>

        <!-- Realization Rate -->
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="kpi-card">

                <div class="d-flex align-items-center justify-content-between mb-3">

                    <span class="kpi-label">
                        Realization Rate
                    </span>

                    <span class="kpi-icon bg-info-subtle text-info">
                        <i class="fa-solid fa-percent"></i>
                    </span>

                </div>

                <h3 class="kpi-value fw-bold @(Model.OverallAchievementPercentage >= 100 ? "text-success" : "text-primary") mb-2">
                    @Model.OverallAchievementPercentage%
                </h3>

                <span class="kpi-caption">
                    Fiscal achievement pace
                </span>

            </div>
        </div>

    </div>

    <!-- Category Target Distribution -->
    @if (Model.CategoryBreakdowns.Any())
    {
        <div class="category-card mb-4">

            <div class="d-flex align-items-center gap-3 mb-3">

                <div class="section-icon">
                    <i class="fa-solid fa-chart-pie"></i>
                </div>

                <div>
                    <h6 class="section-heading mb-1">
                        Performance by Target Stream
                    </h6>

                    <p class="section-subtitle mb-0">
                        Target allocation and achievement across available performance categories.
                    </p>
                </div>

            </div>

            <div class="row g-3">

                @foreach (var cat in Model.CategoryBreakdowns)
                {
                    <div class="col-12 col-md-4">

                        <div class="category-item">

                            <div class="d-flex justify-content-between align-items-center mb-2">

                                <span class="category-name">
                                    @cat.Category
                                </span>

                                <span class="badge bg-white border text-dark fw-bold rounded-pill px-2 py-1">
                                    @cat.AchievementPercentage%
                                </span>

                            </div>

                            <div class="d-flex justify-content-between align-items-center category-stat mb-2">

                                <span>
                                    Target:
                                    @cat.TargetAmount.ToString("C0", inCulture)
                                </span>

                                <span class="category-achieved">
                                    Achieved:
                                    @cat.AchievedAmount.ToString("C0", inCulture)
                                </span>

                            </div>

                            <div class="progress category-progress">

                                <div class="progress-bar @(cat.AchievementPercentage >= 100
                                                                         ? "bg-success"
                                                                         : cat.AchievementPercentage >= 75
                                                                             ? "bg-primary"
                                                                             : "bg-warning")"
                             role="progressbar"
                             style="width: @Math.Min(100, Math.Max(5, cat.AchievementPercentage))%;">
                        </div>

                            </div>

                        </div>

                    </div>
                        }

            </div>

        </div>
    }

    <!-- Quarterly Target Ledger -->
    <div class="report-card">

        <!-- Report Header -->
        <div class="report-card-header">

            <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">

                <div class="d-flex align-items-center gap-3">

                    <div class="section-icon">
                        <i class="fa-solid fa-list-check"></i>
                    </div>

                    <div>
                        <h6 class="section-heading mb-1">
                            Quarterly Target Ledger
                        </h6>

                        <p class="section-subtitle mb-0">
                            Variance analysis comparing assigned quotas vs verified revenue.
                        </p>
                    </div>

                </div>

                <span class="badge bg-light text-secondary border rounded-pill px-3 py-2">

                    <i class="fa-solid fa-calendar-days me-1"></i>

                    Showing @Model.Quarters.Count Fiscal Quarters

                </span>

            </div>

        </div>

        <!-- Target Table -->
        <div class="table-wrapper">

            <table class="table table-hover align-middle target-table">

                <thead>

                    <tr>

                        <th>
                            Fiscal Quarter
                        </th>

                        <th class="text-end">
                            Target Amount
                        </th>

                        <th class="text-end">
                            Achieved Amount
                        </th>

                        <th class="text-end">
                            Variance (+ / -)
                        </th>

                        <th style="min-width: 190px;">
                            Achievement %
                        </th>

                        <th class="text-center">
                            Status
                        </th>

                    </tr>

                </thead>

                <tbody>

                    @if (Model.Quarters.Any())
                    {
                        @foreach (var q in Model.Quarters)
                        {
                            <tr>

                                <!-- Quarter -->
                                <td>

                                    <div class="d-flex align-items-center gap-3">

                                        <div class="quarter-icon">
                                            <i class="fa-solid fa-calendar-check"></i>
                                        </div>

                                        <div class="quarter-name">
                                            @q.Quarter
                                        </div>

                                    </div>

                                </td>

                                <!-- Target -->
                                <td class="text-end">

                                    <span class="amount-target">
                                        @q.TargetAmount.ToString("C2", inCulture)
                                    </span>

                                </td>

                                <!-- Achieved -->
                                <td class="text-end">

                                    <span class="amount-achieved">
                                        @q.AchievedAmount.ToString("C2", inCulture)
                                    </span>

                                </td>

                                <!-- Variance -->
                                <td class="text-end">

                                    <span class="variance-value @(q.Variance >= 0
                                                                                  ? "text-success"
                                                                                  : "text-danger")">

                                @(q.Variance >= 0 ? "+" : "")@q.Variance.ToString("C2", inCulture)

                                    </span>

                                </td>

                                <!-- Achievement -->
                                <td>

                                    <div class="achievement-wrapper">

                                        <div class="d-flex align-items-center gap-2">

                                            <div class="progress achievement-bar flex-grow-1">

                                                <div class="progress-bar @(q.AchievementPercentage >= 100
                                                                                                 ? "bg-success"
                                                                                                 : "bg-warning")"
                                             role="progressbar"
                                             style="width: @Math.Min(100, Math.Max(5, q.AchievementPercentage))%;">
                                        </div>

                                            </div>

                                            <span class="achievement-value">
                                                @q.AchievementPercentage%
                                            </span>

                                        </div>

                                    </div>

                                </td>

                                <!-- Status -->
                                <td class="text-center">

                            @if (q.Status == "Exceeded")
                                    {
                                        <span class="status-badge bg-success-subtle text-success border border-success-subtle">

                                            <i class="fa-solid fa-circle-arrow-up"></i>

                                            Exceeded

                                        </span>
                                    }
                                    else
                                    {
                                        <span class="status-badge bg-warning-subtle text-warning border border-warning-subtle">

                                            <i class="fa-solid fa-circle-arrow-down"></i>

                                            Under Target

                                        </span>
                                    }

                                </td>

                            </tr>
                        }
                    }
                    else
                    {
                        <tr>

                            <td colspan="6">

                                <div class="empty-state text-center">

                                    <div class="empty-icon">
                                        <i class="fa-solid fa-chart-column"></i>
                                    </div>

                                    <h6 class="fw-bold text-dark mb-1">
                                        No Quarterly Target Data
                                    </h6>

                                    <p class="text-muted small mb-0">
                                        No quarterly target information is available for the selected filter.
                                    </p>

                                </div>

                            </td>

                        </tr>
                    }

                </tbody>

                <!-- Total -->
                <tfoot class="table-light fw-bold">

                    <tr>

                        <td>
                            <span class="total-label">
                                Total
                            </span>
                        </td>

                        <td class="text-end text-muted">
                            @Model.TotalTarget.ToString("C2", inCulture)
                        </td>

                        <td class="text-end text-success">
                            @Model.TotalAchieved.ToString("C2", inCulture)
                        </td>

                        <td class="text-end @(Model.TotalVariance >= 0 ? "text-success" : "text-danger")">

                            @(Model.TotalVariance >= 0 ? "+" : "")@Model.TotalVariance.ToString("C2", inCulture)

                        </td>

                        <td>

                            <span class="fw-bold text-dark">
                                @Model.OverallAchievementPercentage% Pace
                            </span>

                        </td>

                        <td class="text-center">
                            -
                        </td>

                    </tr>

                </tfoot>

            </table>

        </div>

        <!-- Report Note -->
        <div class="report-note">

            <i class="fa-solid fa-circle-info me-1"></i>

            Target performance is displayed using the quota, achievement, variance, and category values available in the current report dataset.

        </div>

    </div>

</div>
```

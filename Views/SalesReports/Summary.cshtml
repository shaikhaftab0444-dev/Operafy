@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Sales Summary Report";
}

<div class="container-fluid py-4 text-start">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-bold mb-1"><i class="fa-solid fa-chart-line text-primary me-2"></i>Sales Summary</h4>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0 small">
                    <li class="breadcrumb-item"><a href="/SalesDashboard" class="text-decoration-none">Sales Management</a></li>
                    <li class="breadcrumb-item">Sales Reports</li>
                    <li class="breadcrumb-item active" aria-current="page">Summary</li>
                </ol>
            </nav>
        </div>
        <button class="btn btn-outline-secondary rounded-pill px-3"><i class="fa-solid fa-download me-1.5"></i>Export PDF</button>
    </div>

    <!-- Summary Chart Panel -->
    <div class="bg-white border rounded-3 p-4 shadow-sm mb-4">
        <h6 class="fw-bold text-dark mb-4">Monthly Revenue Summary (Last 6 Months)</h6>
        <div style="height: 300px; display: flex; align-items: flex-end; gap: 20px; padding: 20px 40px; border-bottom: 2px solid #e2e8f0;">
            <!-- Simulating charts visually with styled div bars -->
            <div style="flex-grow: 1; display: flex; flex-direction: column; align-items: center; gap: 10px;">
                <div style="height: 120px; width: 40px; background-color: #3b82f6; border-radius: 4px 4px 0 0;"></div>
                <span class="small font-semibold">Mar 2026</span>
            </div>
            <div style="flex-grow: 1; display: flex; flex-direction: column; align-items: center; gap: 10px;">
                <div style="height: 150px; width: 40px; background-color: #3b82f6; border-radius: 4px 4px 0 0;"></div>
                <span class="small font-semibold">Apr 2026</span>
            </div>
            <div style="flex-grow: 1; display: flex; flex-direction: column; align-items: center; gap: 10px;">
                <div style="height: 180px; width: 40px; background-color: #3b82f6; border-radius: 4px 4px 0 0;"></div>
                <span class="small font-semibold">May 2026</span>
            </div>
            <div style="flex-grow: 1; display: flex; flex-direction: column; align-items: center; gap: 10px;">
                <div style="height: 160px; width: 40px; background-color: #3b82f6; border-radius: 4px 4px 0 0;"></div>
                <span class="small font-semibold">Jun 2026</span>
            </div>
            <div style="flex-grow: 1; display: flex; flex-direction: column; align-items: center; gap: 10px;">
                <div style="height: 220px; width: 40px; background-color: #3b82f6; border-radius: 4px 4px 0 0;"></div>
                <span class="small font-semibold">Jul 2026</span>
            </div>
            <div style="flex-grow: 1; display: flex; flex-direction: column; align-items: center; gap: 10px;">
                <div style="height: 240px; width: 40px; background-color: #0d9488; border-radius: 4px 4px 0 0;"></div>
                <span class="small font-semibold fw-bold text-success">Aug 2026</span>
            </div>
        </div>
    </div>
</div>

@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Sales By Salesperson";
}

<div class="container-fluid py-4 text-start">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-bold mb-1"><i class="fa-solid fa-person-running text-primary me-2"></i>Sales by Salesperson</h4>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0 small">
                    <li class="breadcrumb-item"><a href="/SalesDashboard" class="text-decoration-none">Sales Management</a></li>
                    <li class="breadcrumb-item">Sales Reports</li>
                    <li class="breadcrumb-item active" aria-current="page">Sales by Salesperson</li>
                </ol>
            </nav>
        </div>
        <button class="btn btn-outline-secondary rounded-pill px-3"><i class="fa-solid fa-download me-1.5"></i>Export PDF</button>
    </div>

    <!-- Sales By Salesperson Table -->
    <div class="bg-white border rounded-3 p-4 shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" style="font-size: 0.85rem;">
                <thead class="table-light">
                    <tr>
                        <th>Salesperson Name</th>
                        <th>Region</th>
                        <th>Target (Month)</th>
                        <th>Sales Achieved</th>
                        <th>Achievement %</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td class="fw-bold text-dark">Amit Verma</td>
                        <td>North India</td>
                        <td>₹15,00,000</td>
                        <td class="fw-bold text-success">₹12,45,000</td>
                        <td>83%</td>
                    </tr>
                    <tr>
                        <td class="fw-bold text-dark">Neha Sharma</td>
                        <td>West India</td>
                        <td>₹12,00,000</td>
                        <td class="fw-bold text-success">₹10,50,000</td>
                        <td>87.5%</td>
                    </tr>
                    <tr>
                        <td class="fw-bold text-dark">Rohan Das</td>
                        <td>South India</td>
                        <td>₹10,00,000</td>
                        <td class="fw-bold text-success">₹8,20,000</td>
                        <td>82%</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

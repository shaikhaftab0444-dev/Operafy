```cshtml
@model ERP_System.Models.SalespersonReportsListViewModel
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Sales By Salesperson";
    var inCulture = new System.Globalization.CultureInfo("en-IN");
}

<style>
    .salesperson-report-page {
        --sp-primary: #2563eb;
        --sp-primary-dark: #1d4ed8;
        --sp-success: #16a34a;
        --sp-warning: #d97706;
        --sp-danger: #dc2626;
        --sp-text: #172033;
        --sp-muted: #64748b;
        --sp-border: #e2e8f0;
        --sp-soft: #f8fafc;
        --sp-radius: 16px;
    }

        /* =========================
           PAGE HEADER
           ========================= */

        .salesperson-report-page .report-header {
            background: linear-gradient(135deg, #ffffff 0%, #f8fafc 100%);
            border: 1px solid var(--sp-border);
            border-radius: var(--sp-radius);
            padding: 22px 24px;
            box-shadow: 0 4px 18px rgba(15, 23, 42, 0.045);
        }

        .salesperson-report-page .title-icon {
            width: 46px;
            height: 46px;
            border-radius: 13px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            background: #eff6ff;
            color: var(--sp-primary);
            font-size: 1.15rem;
            flex-shrink: 0;
        }

        .salesperson-report-page .page-title {
            color: var(--sp-text);
            letter-spacing: -0.02em;
        }

        .salesperson-report-page .breadcrumb {
            margin-top: 5px;
        }

        .salesperson-report-page .breadcrumb-item + .breadcrumb-item::before {
            color: #94a3b8;
        }

        .salesperson-report-page .export-btn {
            min-height: 41px;
            border-radius: 10px;
            padding: 0 17px;
            font-weight: 650;
            transition: all 0.18s ease;
        }

            .salesperson-report-page .export-btn:hover {
                transform: translateY(-1px);
                box-shadow: 0 6px 15px rgba(15, 23, 42, 0.09);
            }

        /* =========================
           KPI CARDS
           ========================= */

        .salesperson-report-page .kpi-card {
            position: relative;
            overflow: hidden;
            min-height: 148px;
            background: #ffffff;
            border: 1px solid var(--sp-border);
            border-radius: var(--sp-radius);
            padding: 19px;
            box-shadow: 0 4px 16px rgba(15, 23, 42, 0.045);
            transition: transform 0.18s ease, box-shadow 0.18s ease, border-color 0.18s ease;
        }

            .salesperson-report-page .kpi-card::after {
                content: "";
                position: absolute;
                width: 100px;
                height: 100px;
                right: -42px;
                bottom: -42px;
                border-radius: 50%;
                background: rgba(37, 99, 235, 0.035);
            }

            .salesperson-report-page .kpi-card:hover {
                transform: translateY(-3px);
                border-color: #d5deeb;
                box-shadow: 0 10px 26px rgba(15, 23, 42, 0.075);
            }

        .salesperson-report-page .kpi-label {
            color: var(--sp-muted);
            font-size: 0.77rem;
            font-weight: 750;
            letter-spacing: 0.01em;
        }

        .salesperson-report-page .kpi-icon {
            width: 42px;
            height: 42px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border-radius: 12px;
            font-size: 0.95rem;
            flex-shrink: 0;
        }

        .salesperson-report-page .kpi-value {
            font-size: 1.52rem;
            line-height: 1.2;
            letter-spacing: -0.025em;
        }

        .salesperson-report-page .kpi-caption {
            color: #94a3b8;
            font-size: 0.73rem;
        }

        /* =========================
           REPORT CARD
           ========================= */

        .salesperson-report-page .report-card {
            background: #ffffff;
            border: 1px solid var(--sp-border);
            border-radius: var(--sp-radius);
            box-shadow: 0 5px 20px rgba(15, 23, 42, 0.045);
            overflow: hidden;
        }

        .salesperson-report-page .report-card-header {
            padding: 20px 22px;
            border-bottom: 1px solid var(--sp-border);
            background: linear-gradient(180deg, #ffffff 0%, #fbfdff 100%);
        }

        .salesperson-report-page .section-icon {
            width: 39px;
            height: 39px;
            border-radius: 10px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            background: #eff6ff;
            color: var(--sp-primary);
            flex-shrink: 0;
        }

        .salesperson-report-page .section-title {
            color: var(--sp-text);
            font-size: 0.98rem;
            font-weight: 750;
        }

        .salesperson-report-page .section-subtitle {
            color: var(--sp-muted);
            font-size: 0.76rem;
        }

        /* =========================
           TABLE
           ========================= */

        .salesperson-report-page .table-wrapper {
            overflow-x: auto;
        }

        .salesperson-report-page .performance-table {
            min-width: 1050px;
            margin-bottom: 0;
        }

            .salesperson-report-page .performance-table thead th {
                background: #f8fafc;
                color: #64748b;
                border-top: 0;
                border-bottom: 1px solid #e2e8f0;
                padding: 13px 15px;
                font-size: 0.71rem;
                font-weight: 750;
                letter-spacing: 0.025em;
                text-transform: uppercase;
                white-space: nowrap;
            }

            .salesperson-report-page .performance-table tbody td {
                padding: 15px;
                border-color: #eef2f7;
                vertical-align: middle;
                color: #334155;
            }

            .salesperson-report-page .performance-table tbody tr {
                transition: background-color 0.15s ease;
            }

                .salesperson-report-page .performance-table tbody tr:hover {
                    background: #f8fbff;
                }

            .salesperson-report-page .performance-table tfoot td {
                padding: 15px;
                border-top: 1px solid #dbe3ed;
            }

        /* =========================
           SALESPERSON CELL
           ========================= */

        .salesperson-report-page .salesperson-avatar {
            width: 42px;
            height: 42px;
            border-radius: 12px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            background: #eff6ff;
            color: var(--sp-primary);
            border: 1px solid #dbeafe;
            font-size: 0.74rem;
            font-weight: 800;
            flex-shrink: 0;
        }

        .salesperson-report-page .salesperson-name {
            color: #172033;
            font-size: 0.86rem;
            font-weight: 750;
        }

        .salesperson-report-page .salesperson-meta {
            color: #94a3b8;
            font-size: 0.69rem;
            margin-top: 3px;
        }

        /* =========================
           BADGES
           ========================= */

        .salesperson-report-page .region-badge {
            display: inline-flex;
            align-items: center;
            gap: 4px;
            border-radius: 999px;
            padding: 6px 10px;
            font-size: 0.72rem;
            font-weight: 650;
            white-space: nowrap;
        }

        .salesperson-report-page .amount-target {
            color: #475569;
            font-weight: 650;
        }

        .salesperson-report-page .amount-achieved {
            color: var(--sp-success);
            font-weight: 750;
        }

        /* =========================
           ACHIEVEMENT BAR
           ========================= */

        .salesperson-report-page .achievement-wrapper {
            min-width: 170px;
        }

        .salesperson-report-page .achievement-bar {
            height: 7px;
            background: #edf2f7;
            border-radius: 999px;
            overflow: hidden;
        }

            .salesperson-report-page .achievement-bar .progress-bar {
                border-radius: 999px;
            }

        .salesperson-report-page .achievement-value {
            min-width: 48px;
            text-align: right;
            color: #334155;
            font-size: 0.74rem;
            font-weight: 750;
        }

        /* =========================
           STATUS BADGES
           ========================= */

        .salesperson-report-page .status-badge {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 5px;
            min-width: 105px;
            border-radius: 999px;
            padding: 7px 11px;
            font-size: 0.71rem;
            font-weight: 750;
            white-space: nowrap;
        }

        /* =========================
           EMPTY STATE
           ========================= */

        .salesperson-report-page .empty-state {
            padding: 55px 20px;
        }

        .salesperson-report-page .empty-icon {
            width: 58px;
            height: 58px;
            border-radius: 16px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            background: #f1f5f9;
            color: #94a3b8;
            font-size: 1.3rem;
            margin-bottom: 14px;
        }

        .salesperson-report-page .total-label {
            color: #172033;
            font-weight: 750;
        }

        .salesperson-report-page .report-note {
            padding: 13px 18px;
            border-top: 1px solid #e2e8f0;
            background: #f8fafc;
            color: #64748b;
            font-size: 0.73rem;
        }

    /* =========================
           RESPONSIVE
           ========================= */

    @@media (max-width: 991.98px) {
        .salesperson-report-page .report-header {
            padding: 18px;
        }

        .salesperson-report-page .kpi-card {
            min-height: 138px;
        }
    }

    @@media (max-width: 575.98px) {
        .salesperson-report-page {
            padding-left: 2px;
            padding-right: 2px;
        }

            .salesperson-report-page .report-header {
                padding: 16px;
            }

            .salesperson-report-page .title-icon {
                width: 40px;
                height: 40px;
                border-radius: 11px;
            }

            .salesperson-report-page .page-title {
                font-size: 1.05rem;
            }

            .salesperson-report-page .export-btn {
                width: 100%;
            }

            .salesperson-report-page .kpi-card {
                padding: 16px;
            }

            .salesperson-report-page .kpi-value {
                font-size: 1.34rem;
            }

            .salesperson-report-page .report-card-header {
                padding: 17px;
            }
    }

    /* =========================
           PRINT
           ========================= */

    .salesperson-report-page .print-only-header {
        display: none;
    }

    @@media print {
        #sidebar,
        .sidebar,
        .topbar,
        .navbar,
        .btn,
        .breadcrumb,
        nav,
        footer,
        .no-print {
            display: none !important;
        }

        body,
        .container-fluid,
        .main-content {
            padding: 0 !important;
            margin: 0 !important;
            background: #fff !important;
            width: 100% !important;
        }

        .salesperson-report-page .print-only-header {
            display: block !important;
            border-bottom: 2px solid #0f172a;
            margin-bottom: 20px;
            padding-bottom: 10px;
        }

        .salesperson-report-page .report-header {
            display: none !important;
        }

        .salesperson-report-page .kpi-card,
        .salesperson-report-page .report-card {
            box-shadow: none !important;
            border: 1px solid #cbd5e1 !important;
        }

        .salesperson-report-page .performance-table {
            min-width: 0 !important;
        }

        .salesperson-report-page .report-card-header {
            background: #fff !important;
        }

        .salesperson-report-page .report-note {
            display: none !important;
        }
    }
</style>

<div class="container-fluid py-4 text-start salesperson-report-page">

    <!-- Print-only Brand Header -->
    <div class="print-only-header">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <h3 class="fw-bold mb-0 text-dark">
                    OPERAFY ENTERPRISE ERP
                </h3>
                <p class="text-muted small mb-0">
                    Sales Representative Quota Realization & Pacing Audit
                </p>
            </div>

            <div class="text-end small text-muted">
                <div>
                    <strong>Generated:</strong>
                    @DateTime.Now.ToString("dd MMM yyyy HH:mm")
                </div>
                <div>
                    <strong>Reps Audited:</strong>
                    @Model.Salespeople.Count
                </div>
            </div>
        </div>
    </div>

    <!-- Page Header -->
    <div class="report-header mb-4 no-print">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">

            <div class="d-flex align-items-center gap-3">

                <div class="title-icon">
                    <i class="fa-solid fa-person-running"></i>
                </div>

                <div>
                    <h4 class="page-title fw-bold mb-1">
                        Sales by Salesperson
                    </h4>

                    <nav aria-label="breadcrumb">
                        <ol class="breadcrumb mb-0 small">
                            <li class="breadcrumb-item">
                                <a href="/SalesDashboard"
                                   class="text-decoration-none text-muted">
                                    Sales Management
                                </a>
                            </li>

                            <li class="breadcrumb-item text-muted">
                                Sales Reports
                            </li>

                            <li class="breadcrumb-item active fw-semibold"
                                aria-current="page">
                                Sales by Salesperson
                            </li>
                        </ol>
                    </nav>
                </div>

            </div>

            <button type="button"
                    onclick="window.print()"
                    class="btn btn-outline-secondary export-btn shadow-sm">
                <i class="fa-solid fa-print me-2"></i>
                Export PDF
            </button>

        </div>
    </div>

    <!-- KPI Summary -->
    <div class="row g-3 mb-4">

        <!-- Team Target -->
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="kpi-card">

                <div class="d-flex align-items-center justify-content-between mb-3">
                    <span class="kpi-label">
                        Team Cumulative Target
                    </span>

                    <span class="kpi-icon bg-primary-subtle text-primary">
                        <i class="fa-solid fa-bullseye"></i>
                    </span>
                </div>

                <h3 class="kpi-value fw-bold text-dark mb-2">
                    @Model.TotalTeamTarget.ToString("C0", inCulture)
                </h3>

                <span class="kpi-caption">
                    Monthly team quota allocation
                </span>

            </div>
        </div>

        <!-- Team Achieved -->
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="kpi-card">

                <div class="d-flex align-items-center justify-content-between mb-3">
                    <span class="kpi-label">
                        Team Sales Achieved
                    </span>

                    <span class="kpi-icon bg-success-subtle text-success">
                        <i class="fa-solid fa-circle-check"></i>
                    </span>
                </div>

                <h3 class="kpi-value fw-bold text-success mb-2">
                    @Model.TotalTeamAchieved.ToString("C0", inCulture)
                </h3>

                <span class="kpi-caption">
                    Paid & approved billings
                </span>

            </div>
        </div>

        <!-- Overall Pacing -->
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="kpi-card">

                <div class="d-flex align-items-center justify-content-between mb-3">
                    <span class="kpi-label">
                        Overall Quota Pacing
                    </span>

                    <span class="kpi-icon bg-info-subtle text-info">
                        <i class="fa-solid fa-gauge-high"></i>
                    </span>
                </div>

                <h3 class="kpi-value fw-bold @(Model.TeamAchievementPercentage >= 75 ? "text-primary" : "text-warning") mb-2">
                    @Model.TeamAchievementPercentage%
                </h3>

                <span class="kpi-caption">
                    Pacing towards monthly goal
                </span>

            </div>
        </div>

        <!-- Top Performer -->
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="kpi-card">

                <div class="d-flex align-items-center justify-content-between mb-3">
                    <span class="kpi-label">
                        Leading Field Executive
                    </span>

                    <span class="kpi-icon bg-warning-subtle text-warning">
                        <i class="fa-solid fa-medal"></i>
                    </span>
                </div>

                <h3 class="kpi-value fw-bold text-dark text-truncate mb-2"
                    style="font-size: 1.22rem;"
                    title="@Model.TopPerformerName">
                    @Model.TopPerformerName
                </h3>

                <span class="text-success small fw-bold">
                    @Model.TopPerformerRevenue.ToString("C0", inCulture) achieved
                </span>

            </div>
        </div>

    </div>

    <!-- Executive Quota Realization -->
    <div class="report-card">

        <!-- Report Header -->
        <div class="report-card-header">

            <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">

                <div class="d-flex align-items-center gap-3">

                    <div class="section-icon">
                        <i class="fa-solid fa-user-check"></i>
                    </div>

                    <div>
                        <h6 class="section-title mb-1">
                            Executive Quota Realization
                        </h6>

                        <p class="section-subtitle mb-0">
                            Real-time tracking of individual sales quotas vs executed invoices.
                        </p>
                    </div>

                </div>

                <span class="badge bg-light text-secondary border rounded-pill px-3 py-2">
                    <i class="fa-solid fa-users me-1"></i>
                    @Model.Salespeople.Count Field Executives
                </span>

            </div>

        </div>

        <!-- Performance Table -->
        <div class="table-wrapper">

            <table class="table table-hover align-middle performance-table">

                <thead>
                    <tr>
                        <th>Salesperson Name & ID</th>
                        <th>Assigned Region</th>
                        <th class="text-end">Target (Month)</th>
                        <th class="text-end">Sales Achieved</th>
                        <th style="min-width: 190px;">Achievement %</th>
                        <th class="text-center">Pacing Status</th>
                    </tr>
                </thead>

                <tbody>

                    @if (Model.Salespeople.Any())
                    {
                        @foreach (var s in Model.Salespeople)
                        {
                            <tr>

                                <!-- Salesperson -->
                                <td>
                                    <div class="d-flex align-items-center gap-3">

                                        <div class="salesperson-avatar">
                                            @(s.SalespersonName.Length > 1
                                                                                ? s.SalespersonName.Substring(0, 2).ToUpper()
                                                                                : "EX")
                                </div>

                                        <div>
                                            <div class="salesperson-name">
                                                @s.SalespersonName
                                            </div>

                                            <div class="salesperson-meta">
                                                @s.ExecCode
                                        @if (!string.IsNullOrEmpty(s.MobileNumber))
                                                {
                                                    <span class="mx-1">•</span>
                                                    @s.MobileNumber
                                                }
                                            </div>
                                        </div>

                                    </div>
                                </td>

                                <!-- Region -->
                                <td>
                                    <span class="badge bg-light text-dark border region-badge">
                                        <i class="fa-solid fa-location-dot text-primary"></i>
                                        @s.Region
                                    </span>
                                </td>

                                <!-- Target -->
                                <td class="text-end">
                                    <span class="amount-target">
                                        @s.TargetMonth.ToString("C2", inCulture)
                                    </span>
                                </td>

                                <!-- Achieved -->
                                <td class="text-end">
                                    <span class="amount-achieved">
                                        @s.SalesAchieved.ToString("C2", inCulture)
                                    </span>
                                </td>

                                <!-- Achievement -->
                                <td>

                                    <div class="achievement-wrapper">

                                        <div class="d-flex align-items-center gap-2">

                                            <div class="progress achievement-bar flex-grow-1">
                                                <div class="progress-bar @(s.AchievementPercentage >= 100 ? "bg-success" : s.AchievementPercentage >= 75 ? "bg-primary" : "bg-warning")"
                                                     role="progressbar"
                                                     style="width: @Math.Min(100, Math.Max(5, s.AchievementPercentage))%;">
                                                </div>
                                            </div>

                                            <span class="achievement-value">
                                                @s.AchievementPercentage%
                                            </span>

                                        </div>

                                    </div>

                                </td>

                                <!-- Pacing Status -->
                                <td class="text-center">

                                    @if (s.PacingStatus == "Ahead")
                                    {
                                        <span class="status-badge bg-success-subtle text-success border border-success-subtle">
                                            <i class="fa-solid fa-bolt"></i>
                                            Ahead
                                        </span>
                                    }
                                    else if (s.PacingStatus == "On Track")
                                    {
                                        <span class="status-badge bg-primary-subtle text-primary border border-primary-subtle">
                                            <i class="fa-solid fa-check"></i>
                                            On Track
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="status-badge bg-warning-subtle text-warning border border-warning-subtle">
                                            <i class="fa-solid fa-clock-rotate-left"></i>
                                            Lagging Target
                                        </span>
                                    }

                                </td>

                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6">

                                <div class="empty-state text-center">

                                    <div class="empty-icon">
                                        <i class="fa-solid fa-user-slash"></i>
                                    </div>

                                    <h6 class="fw-bold text-dark mb-1">
                                        No Sales Executive Profiles
                                    </h6>

                                    <p class="text-muted small mb-0">
                                        No sales executive profiles were found for this report.
                                    </p>

                                </div>

                            </td>
                        </tr>
                    }

                </tbody>

                <!-- Team Total -->
                <tfoot class="table-light fw-bold">

                    <tr>

                        <td>
                            <span class="total-label">
                                Total Team
                            </span>
                        </td>

                        <td>
                            -
                        </td>

                        <td class="text-end text-muted">
                            @Model.TotalTeamTarget.ToString("C2", inCulture)
                        </td>

                        <td class="text-end text-success">
                            @Model.TotalTeamAchieved.ToString("C2", inCulture)
                        </td>

                        <td>
                            <span class="fw-bold text-dark">
                                @Model.TeamAchievementPercentage% Pacing
                            </span>
                        </td>

                        <td class="text-center">
                            -
                        </td>

                    </tr>

                </tfoot>

            </table>

        </div>

        <!-- Report Note -->
        <div class="report-note">
            <i class="fa-solid fa-circle-info me-1"></i>
            Salesperson performance is displayed using the quota and achievement values available in the current report dataset.
        </div>

    </div>

</div>
```

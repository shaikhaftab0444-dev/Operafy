@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Sales By Product";
}

<div class="container-fluid py-4 text-start">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-bold mb-1"><i class="fa-solid fa-box text-primary me-2"></i>Sales by Product</h4>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0 small">
                    <li class="breadcrumb-item"><a href="/SalesDashboard" class="text-decoration-none">Sales Management</a></li>
                    <li class="breadcrumb-item">Sales Reports</li>
                    <li class="breadcrumb-item active" aria-current="page">Sales by Product</li>
                </ol>
            </nav>
        </div>
        <button class="btn btn-outline-secondary rounded-pill px-3"><i class="fa-solid fa-download me-1.5"></i>Export PDF</button>
    </div>

    <!-- Sales By Product Table -->
    <div class="bg-white border rounded-3 p-4 shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" style="font-size: 0.85rem;">
                <thead class="table-light">
                    <tr>
                        <th>Product Name</th>
                        <th>Category</th>
                        <th>Units Sold</th>
                        <th>Total Product Sales</th>
                        <th>Contribution</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td class="fw-bold text-dark">Dell XPS Laptop 15</td>
                        <td>Electronics</td>
                        <td>24 Units</td>
                        <td class="fw-bold text-primary">₹15,60,000</td>
                        <td><span class="badge bg-success-subtle text-success rounded-pill px-2.5 py-1">62.8%</span></td>
                    </tr>
                    <tr>
                        <td class="fw-bold text-dark">Logitech MX Master 3 Mouse</td>
                        <td>Office Supplies</td>
                        <td>80 Units</td>
                        <td class="fw-bold text-primary">₹64,000</td>
                        <td><span class="badge bg-info-subtle text-info rounded-pill px-2.5 py-1">3.2%</span></td>
                    </tr>
                    <tr>
                        <td class="fw-bold text-dark">HP Backlit Keyboard</td>
                        <td>Office Supplies</td>
                        <td>45 Units</td>
                        <td class="fw-bold text-primary">₹67,500</td>
                        <td><span class="badge bg-info-subtle text-info rounded-pill px-2.5 py-1">3.6%</span></td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

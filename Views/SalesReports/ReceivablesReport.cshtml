@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Receivables Report";
}

<div class="container-fluid py-4 text-start">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-bold mb-1"><i class="fa-solid fa-calendar-check text-primary me-2"></i>Receivables Report</h4>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0 small">
                    <li class="breadcrumb-item"><a href="/SalesDashboard" class="text-decoration-none">Sales Management</a></li>
                    <li class="breadcrumb-item">Sales Reports</li>
                    <li class="breadcrumb-item active" aria-current="page">Receivables Report</li>
                </ol>
            </nav>
        </div>
        <button class="btn btn-outline-secondary rounded-pill px-3"><i class="fa-solid fa-download me-1.5"></i>Export PDF</button>
    </div>

    <!-- Receivables Ageing Report Table -->
    <div class="bg-white border rounded-3 p-4 shadow-sm">

<script>
    function loadCustomerInvoices(customerId, customerName) {

        // Set selected customer name
        document.getElementById('modalCustomerName').textContent = customerName;

        // Reset modal state
        document.getElementById('modalLoadingSpinner').classList.remove('d-none');
        document.getElementById('modalInvoicesContainer').classList.add('d-none');
        document.getElementById('modalNoInvoicesAlert').classList.add('d-none');

        // Clear old invoice rows
        document.getElementById('modalInvoicesTableBody').innerHTML = '';

        // Reset totals
        document.getElementById('modalTaxableSum').textContent = '₹0.00';
        document.getElementById('modalGstSum').textContent = '₹0.00';
        document.getElementById('modalTotalSum').textContent = '₹0.00';

        // Open modal
        var myModal = new bootstrap.Modal(
            document.getElementById('customerInvoicesModal')
        );

        myModal.show();

        // Existing backend endpoint preserved
        const url = `/SalesReports/GetCustomerInvoices?customerId=${customerId}&customerName=${encodeURIComponent(customerName)}`;

        fetch(url)
            .then(res => res.json())
            .then(data => {

                document.getElementById('modalLoadingSpinner')
                    .classList.add('d-none');

                // No records
                if (!data || data.length === 0) {

                    document.getElementById('modalNoInvoicesAlert')
                        .classList.remove('d-none');

                    return;
                }

                // Show invoice table
                document.getElementById('modalInvoicesContainer')
                    .classList.remove('d-none');

                const tbody = document.getElementById(
                    'modalInvoicesTableBody'
                );

                tbody.innerHTML = '';

                let sumTaxable = 0;
                let sumGst = 0;
                let sumTotal = 0;

                data.forEach(inv => {

                    sumTaxable += (inv.taxableValue || 0);
                    sumGst += (inv.gstAmount || 0);
                    sumTotal += (inv.totalAmount || 0);

                    const statusClass =
                        inv.status === 'Paid'
                            ? 'bg-success-subtle text-success border-success'
                            : inv.status === 'Overdue'
                                ? 'bg-danger-subtle text-danger border-danger'
                                : inv.status === 'Partially Paid'
                                    ? 'bg-warning-subtle text-warning border-warning'
                                    : 'bg-info-subtle text-info border-info';

                    const row = `
                        <tr>
                            <td class="fw-bold text-dark">
                                <i class="fa-solid fa-file-invoice text-primary me-1"></i>
                                ${inv.invoiceNumber}
                            </td>

                            <td>
                                <span class="badge bg-light text-secondary border">
                                    ${inv.linkedOrder}
                                </span>
                            </td>

                            <td>
                                ${inv.invoiceDate}
                            </td>

                            <td>
                                ${inv.dueDate}
                            </td>

                            <td class="text-end">
                                ₹${Number(inv.taxableValue).toLocaleString('en-IN', {
                                    minimumFractionDigits: 2
                                })}
                            </td>

                            <td class="text-end text-muted">
                                ₹${Number(inv.gstAmount).toLocaleString('en-IN', {
                                    minimumFractionDigits: 2
                                })}
                            </td>

                            <td class="text-end fw-bold text-primary">
                                ₹${Number(inv.totalAmount).toLocaleString('en-IN', {
                                    minimumFractionDigits: 2
                                })}
                            </td>

                            <td class="text-center">
                                <span class="badge ${statusClass} modal-status rounded-pill px-3 py-2">
                                    ${inv.status}
                                </span>
                            </td>
                        </tr>
                    `;

                    tbody.insertAdjacentHTML(
                        'beforeend',
                        row
                    );
                });

                // Update totals
                document.getElementById('modalTaxableSum').textContent =
                    '₹' + sumTaxable.toLocaleString('en-IN', {
                        minimumFractionDigits: 2
                    });

                document.getElementById('modalGstSum').textContent =
                    '₹' + sumGst.toLocaleString('en-IN', {
                        minimumFractionDigits: 2
                    });

                document.getElementById('modalTotalSum').textContent =
                    '₹' + sumTotal.toLocaleString('en-IN', {
                        minimumFractionDigits: 2
                    });
            })
            .catch(err => {

                document.getElementById('modalLoadingSpinner')
                    .classList.add('d-none');

                const alertBox =
                    document.getElementById('modalNoInvoicesAlert');

                alertBox.innerHTML =
                    '<i class="fa-solid fa-triangle-exclamation me-2"></i>' +
                    'Failed to load invoices: ' +
                    err;

                alertBox.classList.remove('d-none');
            });
    }
</script>

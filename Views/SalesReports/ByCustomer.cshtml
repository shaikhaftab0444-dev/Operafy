@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Sales By Customer";
}

<div class="container-fluid py-4 text-start">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-bold mb-1"><i class="fa-solid fa-users-line text-primary me-2"></i>Sales by Customer</h4>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0 small">
                    <li class="breadcrumb-item"><a href="/SalesDashboard" class="text-decoration-none">Sales Management</a></li>
                    <li class="breadcrumb-item">Sales Reports</li>
                    <li class="breadcrumb-item active" aria-current="page">Sales by Customer</li>
                </ol>
            </nav>
        </div>
        <button class="btn btn-outline-secondary rounded-pill px-3"><i class="fa-solid fa-download me-1.5"></i>Export PDF</button>
    </div>

    <!-- Sales By Customer Table -->
    <div class="bg-white border rounded-3 p-4 shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" style="font-size: 0.85rem;">
                <thead class="table-light">
                    <tr>
                        <th>Customer Name</th>
                        <th>Email Address</th>
                        <th>Invoices Issued</th>
                        <th>Gross Revenue Generated</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td class="fw-bold text-dark">Rahul Enterprises</td>
                        <td>rahul@enterprises.com</td>
                        <td>12 Invoices</td>
                        <td class="fw-bold text-primary">₹5,40,000</td>
                        <td><span class="badge bg-success-subtle text-success rounded-pill px-2.5 py-1">Active</span></td>
                    </tr>
                    <tr>
                        <td class="fw-bold text-dark">Mehta Logistics</td>
                        <td>contact@mehta.com</td>
                        <td>8 Invoices</td>
                        <td class="fw-bold text-primary">₹3,20,000</td>
                        <td><span class="badge bg-success-subtle text-success rounded-pill px-2.5 py-1">Active</span></td>
                    </tr>
                    <tr>
                        <td class="fw-bold text-dark">Rajesh Corp Ltd</td>
                        <td>rajesh@corp.in</td>
                        <td>6 Invoices</td>
                        <td class="fw-bold text-primary">₹1,50,000</td>
                        <td><span class="badge bg-success-subtle text-success rounded-pill px-2.5 py-1">Active</span></td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

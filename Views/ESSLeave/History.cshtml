@model IEnumerable<ERP_System.Models.ESSLeaveApplication>
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Leave Application History";
}

<div class="container-fluid py-4 text-start">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-bold mb-1"><i class="fa-solid fa-clock-rotate-left text-primary me-2"></i>Leave Application History</h4>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0 small">
                    <li class="breadcrumb-item"><a href="/EmployeeDashboard" class="text-decoration-none">ESS</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Leave History</li>
                </ol>
            </nav>
        </div>
        <a href="/ESSLeave/Apply" class="btn btn-primary rounded-pill px-3 btn-sm shadow-sm">
            <i class="fa-solid fa-plus me-1.5"></i>Apply for Leave
        </a>
    </div>

    <!-- History Grid -->
    <div class="bg-white border rounded-3 p-4 shadow-sm">
        <h5 class="fw-bold mb-3">All Leave Applications</h5>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" style="font-size: 0.85rem;">
                <thead class="table-light">
                    <tr>
                        <th>Leave Type</th>
                        <th>Start Date</th>
                        <th>End Date</th>
                        <th>Total Days</th>
                        <th>Reason</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var l in Model)
                        {
                            <tr>
                                <td class="fw-bold text-dark">@l.LeaveType</td>
                                <td>@l.StartDate.ToString("dd MMM yyyy")</td>
                                <td>@l.EndDate.ToString("dd MMM yyyy")</td>
                                <td>@l.TotalDays Days</td>
                                <td class="text-muted text-truncate" style="max-width: 250px;">@l.Reason</td>
                                <td>
                                    @if (l.Status == "Approved")
                                    {
                                        <span class="badge bg-success-subtle text-success rounded-pill px-2.5 py-1">Approved</span>
                                    }
                                    else if (l.Status == "Rejected")
                                    {
                                        <span class="badge bg-danger-subtle text-danger rounded-pill px-2.5 py-1">Rejected</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning-subtle text-warning rounded-pill px-2.5 py-1">Pending</span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center py-4 text-muted">No leave applications found.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

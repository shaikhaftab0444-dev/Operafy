@model IEnumerable<ERP_System.Models.ESSLeaveApplication>
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Leave Application History";
}

<style>
    /* =========================================================
           LEAVE HISTORY - PREMIUM ERP UI
           ========================================================= */

    .leave-history-page {
        animation: pageFadeIn 0.55s ease-out both;
    }

    @@keyframes pageFadeIn {
        from {
            opacity: 0;
            transform: translateY(12px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* Header */
    .leave-page-header {
        background: linear-gradient(135deg, #ffffff 0%, #f8fbff 100%);
        border: 1px solid rgba(13, 110, 253, 0.08);
        border-radius: 18px;
        padding: 1.35rem 1.5rem;
        margin-bottom: 1.5rem;
        box-shadow: 0 8px 25px rgba(15, 23, 42, 0.045);
        position: relative;
        overflow: hidden;
    }

        .leave-page-header::before {
            content: "";
            position: absolute;
            width: 180px;
            height: 180px;
            border-radius: 50%;
            background: rgba(13, 110, 253, 0.035);
            right: -70px;
            top: -95px;
            pointer-events: none;
        }

    .leave-title-icon {
        width: 46px;
        height: 46px;
        border-radius: 13px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(135deg, rgba(13, 110, 253, 0.12), rgba(13, 110, 253, 0.04));
        color: #0d6efd;
        font-size: 1.15rem;
        margin-right: 10px;
        vertical-align: middle;
    }

    .leave-page-title {
        color: #172033;
        font-size: 1.35rem;
        letter-spacing: -0.02em;
    }

    .leave-breadcrumb {
        margin-top: 5px;
    }

        .leave-breadcrumb .breadcrumb-item {
            font-size: 0.76rem;
        }

        .leave-breadcrumb a {
            color: #64748b;
            transition: color 0.2s ease;
        }

            .leave-breadcrumb a:hover {
                color: #0d6efd;
            }

    /* Main Card */
    .leave-history-card {
        background: #ffffff;
        border: 1px solid #e9eef5;
        border-radius: 18px;
        overflow: hidden;
        box-shadow: 0 10px 35px rgba(15, 23, 42, 0.055);
        animation: cardSlideUp 0.65s ease-out both;
        animation-delay: 0.08s;
    }

    @@keyframes cardSlideUp {
        from {
            opacity: 0;
            transform: translateY(18px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .leave-card-header {
        padding: 1.25rem 1.4rem;
        border-bottom: 1px solid #edf1f6;
        background: linear-gradient(180deg, #ffffff 0%, #fbfcfe 100%);
    }

    .leave-card-heading {
        color: #172033;
        font-size: 1rem;
        margin-bottom: 3px;
    }

    .leave-card-subtitle {
        color: #8a94a6;
        font-size: 0.76rem;
        margin: 0;
    }

    .history-icon {
        width: 38px;
        height: 38px;
        border-radius: 11px;
        background: #f1f6ff;
        color: #0d6efd;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        margin-right: 10px;
        flex-shrink: 0;
    }

    /* Apply Button */
    .btn-apply-leave {
        border: 0;
        background: linear-gradient(135deg, #0d6efd, #2563eb);
        color: #ffffff !important;
        font-weight: 600;
        box-shadow: 0 6px 16px rgba(13, 110, 253, 0.20);
        transition: all 0.25s ease;
        position: relative;
        z-index: 2;
    }

        .btn-apply-leave:hover {
            transform: translateY(-2px);
            box-shadow: 0 9px 22px rgba(13, 110, 253, 0.28);
            color: #ffffff !important;
        }

        .btn-apply-leave:active {
            transform: translateY(0);
        }

    /* Table */
    .leave-table-wrapper {
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
    }

    .leave-history-table {
        min-width: 850px;
        margin-bottom: 0 !important;
        border-collapse: separate;
        border-spacing: 0;
    }

        .leave-history-table thead th {
            background: #f8fafc !important;
            color: #697386;
            border-top: 0 !important;
            border-bottom: 1px solid #e8edf3 !important;
            padding: 0.9rem 1rem;
            font-size: 0.68rem;
            font-weight: 750;
            text-transform: uppercase;
            letter-spacing: 0.055em;
            white-space: nowrap;
        }

        .leave-history-table tbody td {
            padding: 1rem;
            border-bottom: 1px solid #eef2f6;
            color: #475569;
            font-size: 0.82rem;
            vertical-align: middle;
            background: #ffffff;
            transition: background 0.22s ease;
        }

        .leave-history-table tbody tr {
            animation: rowFadeIn 0.5s ease both;
        }

            .leave-history-table tbody tr:nth-child(1) {
                animation-delay: 0.12s;
            }

            .leave-history-table tbody tr:nth-child(2) {
                animation-delay: 0.17s;
            }

            .leave-history-table tbody tr:nth-child(3) {
                animation-delay: 0.22s;
            }

            .leave-history-table tbody tr:nth-child(4) {
                animation-delay: 0.27s;
            }

            .leave-history-table tbody tr:nth-child(5) {
                animation-delay: 0.32s;
            }

    @@keyframes rowFadeIn {
        from {
            opacity: 0;
            transform: translateY(7px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .leave-history-table tbody tr:hover td {
        background: #f8fbff;
    }

    .leave-history-table tbody tr:last-child td {
        border-bottom: 0;
    }

    .leave-type-cell {
        display: flex;
        align-items: center;
        gap: 10px;
        min-width: 150px;
    }

    .leave-type-icon {
        width: 34px;
        height: 34px;
        border-radius: 9px;
        background: #f1f6ff;
        color: #0d6efd;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 0.78rem;
        flex-shrink: 0;
        transition: all 0.25s ease;
    }

    .leave-history-table tbody tr:hover .leave-type-icon {
        transform: scale(1.08);
        background: #e7f0ff;
    }

    .leave-type-name {
        font-weight: 700;
        color: #1e293b;
    }

    .date-cell {
        white-space: nowrap;
        color: #475569;
        font-weight: 500;
    }

    .date-icon {
        color: #94a3b8;
        margin-right: 5px;
    }

    .days-pill {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 62px;
        padding: 5px 9px;
        border-radius: 999px;
        background: #f1f5f9;
        color: #334155;
        font-size: 0.73rem;
        font-weight: 700;
        border: 1px solid #e7ebf0;
    }

    .reason-text {
        display: block;
        max-width: 250px;
        color: #64748b;
        line-height: 1.5;
    }

    /* Status Badges */
    .leave-status {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        border-radius: 999px;
        padding: 6px 11px;
        font-size: 0.69rem;
        font-weight: 700;
        white-space: nowrap;
        border: 1px solid transparent;
    }

    .leave-status-approved {
        background: rgba(25, 135, 84, 0.09);
        color: #198754;
        border-color: rgba(25, 135, 84, 0.14);
    }

    .leave-status-rejected {
        background: rgba(220, 53, 69, 0.09);
        color: #dc3545;
        border-color: rgba(220, 53, 69, 0.14);
    }

    .leave-status-pending {
        background: rgba(255, 193, 7, 0.12);
        color: #a66b00;
        border-color: rgba(255, 193, 7, 0.18);
    }

    .status-dot {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        display: inline-block;
    }

    .approved-dot {
        background: #198754;
        box-shadow: 0 0 0 3px rgba(25, 135, 84, 0.10);
    }

    .rejected-dot {
        background: #dc3545;
        box-shadow: 0 0 0 3px rgba(220, 53, 69, 0.10);
    }

    .pending-dot {
        background: #f0ad00;
        box-shadow: 0 0 0 3px rgba(255, 193, 7, 0.12);
    }

    /* Empty State */
    .leave-empty-state {
        padding: 3.5rem 1.5rem !important;
    }

    .empty-icon {
        width: 64px;
        height: 64px;
        margin: 0 auto 1rem;
        border-radius: 18px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #f4f7fb;
        color: #94a3b8;
        font-size: 1.45rem;
        animation: emptyFloat 3s ease-in-out infinite;
    }

    @@keyframes emptyFloat {
        0%, 100% {
            transform: translateY(0);
        }

        50% {
            transform: translateY(-5px);
        }
    }

    .empty-title {
        color: #334155;
        font-weight: 700;
        font-size: 0.9rem;
        margin-bottom: 4px;
    }

    .empty-description {
        color: #94a3b8;
        font-size: 0.77rem;
        margin: 0;
    }

    /* Responsive */
    @@media (max-width: 991.98px) {
        .leave-page-header {
            padding: 1.15rem;
        }

        .leave-page-title {
            font-size: 1.18rem;
        }

        .leave-history-card {
            border-radius: 15px;
        }
    }

    @@media (max-width: 767.98px) {
        .leave-page-header {
            padding: 1rem;
        }

            .leave-page-header .d-flex {
                align-items: flex-start !important;
                flex-direction: column;
                gap: 1rem !important;
            }

            .leave-page-header .btn-apply-leave {
                width: 100%;
            }

        .leave-title-icon {
            width: 40px;
            height: 40px;
            font-size: 1rem;
            border-radius: 11px;
        }

        .leave-page-title {
            font-size: 1.05rem;
        }

        .leave-card-header {
            padding: 1rem;
        }

        .history-icon {
            width: 34px;
            height: 34px;
        }

        .leave-table-wrapper {
            margin: 0;
        }

        .leave-history-table {
            min-width: 820px;
        }
    }

    @@media (max-width: 480px) {
        .leave-page-header {
            border-radius: 14px;
        }

        .leave-history-card {
            border-radius: 14px;
        }

        .leave-card-heading {
            font-size: 0.92rem;
        }

        .leave-card-subtitle {
            font-size: 0.7rem;
        }

        .breadcrumb {
            font-size: 0.7rem;
        }
    }

    /* Reduced Motion Accessibility */
    @@media (prefers-reduced-motion: reduce) {
        .leave-history-page,
        .leave-history-card,
        .leave-history-table tbody tr,
        .empty-icon {
            animation: none !important;
        }

        .btn-apply-leave,
        .leave-history-table tbody td,
        .leave-type-icon {
            transition: none !important;
        }
    }
</style>

<div class="container-fluid py-4 text-start leave-history-page">

    <!-- ============================
         PAGE HEADER
         ============================ -->
    <div class="leave-page-header">
        <div class="d-flex justify-content-between align-items-center">

            <div>
                <div class="d-flex align-items-center">
                    <span class="leave-title-icon">
                        <i class="fa-solid fa-clock-rotate-left"></i>
                    </span>

                    <div>
                        <h4 class="fw-bold mb-0 leave-page-title">
                            Leave Application History
                        </h4>

                        <nav aria-label="breadcrumb" class="leave-breadcrumb">
                            <ol class="breadcrumb mb-0">
                                <li class="breadcrumb-item">
                                    <a href="/EmployeeDashboard" class="text-decoration-none">
                                        <i class="fa-solid fa-house me-1"></i>ESS
                                    </a>
                                </li>

                                <li class="breadcrumb-item active" aria-current="page">
                                    Leave History
                                </li>
                            </ol>
                        </nav>
                    </div>
                </div>
            </div>

            <a href="/ESSLeave/Apply"
               class="btn btn-apply-leave rounded-pill px-3 btn-sm">
                <i class="fa-solid fa-plus me-1"></i>
                Apply for Leave
            </a>

        </div>
    </div>


    <!-- ============================
         HISTORY CARD
         ============================ -->
    <div class="leave-history-card">

        <!-- Card Header -->
        <div class="leave-card-header">
            <div class="d-flex align-items-center">

                <span class="history-icon">
                    <i class="fa-solid fa-list-check"></i>
                </span>

                <div>
                    <h5 class="fw-bold leave-card-heading">
                        All Leave Applications
                    </h5>

                    <p class="leave-card-subtitle">
                        Review your submitted leave requests and their current status.
                    </p>
                </div>

            </div>
        </div>


        <!-- ============================
             TABLE
             ============================ -->
        <div class="leave-table-wrapper">

            <table class="table table-hover align-middle leave-history-table">

                <thead>
                    <tr>
                        <th>Leave Type</th>
                        <th>Start Date</th>
                        <th>End Date</th>
                        <th>Total Days</th>
                        <th>Reason</th>
                        <th>Status</th>
                    </tr>
                </thead>

                <tbody>

                    @if (Model != null && Model.Any())
                    {
                        @foreach (var l in Model)
                        {
                            <tr>

                                <!-- Leave Type -->
                                <td>
                                    <div class="leave-type-cell">

                                        <span class="leave-type-icon">
                                            @if (l.LeaveType == "Sick Leave")
                                            {
                                                <i class="fa-solid fa-heart-pulse"></i>
                                            }
                                            else if (l.LeaveType == "Earned Leave")
                                            {
                                                <i class="fa-solid fa-award"></i>
                                            }
                                            else
                                            {
                                                <i class="fa-solid fa-calendar-check"></i>
                                            }
                                        </span>

                                        <span class="leave-type-name">
                                            @l.LeaveType
                                        </span>

                                    </div>
                                </td>


                                <!-- Start Date -->
                                <td>
                                    <span class="date-cell">
                                        <i class="fa-regular fa-calendar date-icon"></i>
                                        @l.StartDate.ToString("dd MMM yyyy")
                                    </span>
                                </td>


                                <!-- End Date -->
                                <td>
                                    <span class="date-cell">
                                        <i class="fa-regular fa-calendar date-icon"></i>
                                        @l.EndDate.ToString("dd MMM yyyy")
                                    </span>
                                </td>


                                <!-- Total Days -->
                                <td>
                                    <span class="days-pill">
                                        <i class="fa-regular fa-clock me-1"></i>
                                        @l.TotalDays Days
                                    </span>
                                </td>


                                <!-- Reason -->
                                <td>
                                    <span class="reason-text text-truncate">
                                        @l.Reason
                                    </span>
                                </td>


                                <!-- Status -->
                                <td>

                                    @if (l.Status == "Approved")
                                    {
                                        <span class="leave-status leave-status-approved">
                                            <span class="status-dot approved-dot"></span>
                                            Approved
                                        </span>
                                    }
                                    else if (l.Status == "Rejected")
                                    {
                                        <span class="leave-status leave-status-rejected">
                                            <span class="status-dot rejected-dot"></span>
                                            Rejected
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="leave-status leave-status-pending">
                                            <span class="status-dot pending-dot"></span>
                                            Pending
                                        </span>
                                    }

                                </td>

                            </tr>
                        }
                    }
                    else
                    {
                        <!-- Empty State -->
                        <tr>
                            <td colspan="6" class="text-center leave-empty-state">

                                <div class="empty-icon">
                                    <i class="fa-solid fa-calendar-xmark"></i>
                                </div>

                                <div class="empty-title">
                                    No Leave Applications Found
                                </div>

                                <p class="empty-description">
                                    You haven't submitted any leave applications yet.
                                </p>

                            </td>
                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>
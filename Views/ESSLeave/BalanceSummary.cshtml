<div class="container-fluid py-4 text-start leave-balance-page">

    <!-- =========================================================
         PAGE HEADER
         ========================================================= -->

    <div class="balance-header">

        <div class="balance-header-content">

            <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">

                <div class="d-flex align-items-center gap-3">

                    <div class="header-icon">
                        <i class="fa-solid fa-scale-balanced"></i>
                    </div>

                    <div>

                        <h4 class="balance-title mb-1">
                            Leave Balance Summary
                        </h4>

                        <p class="balance-subtitle mb-1">
                            Track your available leave balance and usage.
                        </p>

                        <nav aria-label="breadcrumb">

                            <ol class="breadcrumb mb-0">

                                <li class="breadcrumb-item">
                                    <a href="/EmployeeDashboard" class="text-decoration-none">
                                        ESS
                                    </a>
                                </li>

                                <li class="breadcrumb-item active" aria-current="page">
                                    Leave Balance
                                </li>

                            </ol>

                        </nav>

                    </div>

                </div>

                <a href="/ESSLeave/Apply"
                   class="btn btn-primary apply-leave-btn">

                    <i class="fa-solid fa-plus me-2"></i>
                    Apply for Leave

                </a>

            </div>

        </div>

    </div>


    <!-- =========================================================
         LEAVE OVERVIEW
         ========================================================= -->

    <div class="leave-overview">

        <div class="row align-items-center g-3">

            <div class="col-md-4">

                <div class="overview-item">

                    <div class="overview-icon">
                        <i class="fa-solid fa-calendar-check"></i>
                    </div>

                    <div>

                        <div class="overview-label">
                            Total Available
                        </div>

                        <div class="overview-value">
                            @totalRemaining Days
                        </div>

                    </div>

                </div>

            </div>

            <div class="col-md-4">

                <div class="overview-item">

                    <div class="overview-icon">
                        <i class="fa-solid fa-calendar-minus"></i>
                    </div>

                    <div>

                        <div class="overview-label">
                            Total Taken
                        </div>

                        <div class="overview-value">
                            @totalTaken Days
                        </div>

                    </div>

                </div>

            </div>

            <div class="col-md-4">

                <div class="overview-item">

                    <div class="overview-icon">
                        <i class="fa-solid fa-calendar-days"></i>
                    </div>

                    <div>

                        <div class="overview-label">
                            Annual Allocation
                        </div>

                        <div class="overview-value">
                            @totalLeave Days
                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- =========================================================
         BALANCE CARDS
         ========================================================= -->

    <div class="row g-4 mb-4">

        <!-- Casual Leave -->

        <div class="col-md-4">

            <div class="balance-card casual-card">

                <div class="balance-card-content">

                    <div class="leave-type-row">

                        <div class="leave-type-info">

                            <div class="leave-type-icon casual-icon">
                                <i class="fa-solid fa-umbrella-beach"></i>
                            </div>

                            <div>

                                <div class="leave-name">
                                    Casual Leave
                                </div>

                                <div class="leave-code">
                                    CL • Annual Allocation
                                </div>

                            </div>

                        </div>

                        <span class="remaining-label">
                            Available
                        </span>

                    </div>

                    <div class="balance-number">

                        <strong>
                            @casualRemaining
                        </strong>

                        <span>
                            / @casualTotal days
                        </span>

                    </div>

                    <div class="progress-wrapper">

                        <div class="progress">

                            <div class="balance-progress casual-progress"
                                 role="progressbar"
                                 aria-valuenow="@casualPercentage"
                                 aria-valuemin="0"
                                 aria-valuemax="100"
                                 style="--progress-width: @casualPercentage%;">
                            </div>

                        </div>

                    </div>

                    <div class="balance-footer">

                        <span class="taken-text">
                            @casualTaken days taken
                        </span>

                        <span class="percentage-text">
                            @casualPercentage% remaining
                        </span>

                    </div>

                </div>

            </div>

        </div>


        <!-- Sick Leave -->

        <div class="col-md-4">

            <div class="balance-card sick-card">

                <div class="balance-card-content">

                    <div class="leave-type-row">

                        <div class="leave-type-info">

                            <div class="leave-type-icon sick-icon">
                                <i class="fa-solid fa-heart-pulse"></i>
                            </div>

                            <div>

                                <div class="leave-name">
                                    Sick Leave
                                </div>

                                <div class="leave-code">
                                    SL • Annual Allocation
                                </div>

                            </div>

                        </div>

                        <span class="remaining-label">
                            Available
                        </span>

                    </div>

                    <div class="balance-number">

                        <strong>
                            @sickRemaining
                        </strong>

                        <span>
                            / @sickTotal days
                        </span>

                    </div>

                    <div class="progress-wrapper">

                        <div class="progress">

                            <div class="balance-progress sick-progress"
                                 role="progressbar"
                                 aria-valuenow="@sickPercentage"
                                 aria-valuemin="0"
                                 aria-valuemax="100"
                                 style="--progress-width: @sickPercentage%;">
                            </div>

                        </div>

                    </div>

                    <div class="balance-footer">

                        <span class="taken-text">
                            @sickTaken days taken
                        </span>

                        <span class="percentage-text">
                            @sickPercentage% remaining
                        </span>

                    </div>

                </div>

            </div>

        </div>


        <!-- Earned Leave -->

        <div class="col-md-4">

            <div class="balance-card earned-card">

                <div class="balance-card-content">

                    <div class="leave-type-row">

                        <div class="leave-type-info">

                            <div class="leave-type-icon earned-icon">
                                <i class="fa-solid fa-award"></i>
                            </div>

                            <div>

                                <div class="leave-name">
                                    Earned Leave
                                </div>

                                <div class="leave-code">
                                    EL • Annual Allocation
                                </div>

                            </div>

                        </div>

                        <span class="remaining-label">
                            Available
                        </span>

                    </div>

                    <div class="balance-number">

                        <strong>
                            @earnedRemaining
                        </strong>

                        <span>
                            / @earnedTotal days
                        </span>

                    </div>

                    <div class="progress-wrapper">

                        <div class="progress">

                            <div class="balance-progress earned-progress"
                                 role="progressbar"
                                 aria-valuenow="@earnedPercentage"
                                 aria-valuemin="0"
                                 aria-valuemax="100"
                                 style="--progress-width: @earnedPercentage%;">
                            </div>

                        </div>

                    </div>

                    <div class="balance-footer">

                        <span class="taken-text">
                            @earnedTaken days taken
                        </span>

                        <span class="percentage-text">
                            @earnedPercentage% remaining
                        </span>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- =========================================================
         LEAVE LEDGER
         ========================================================= -->

    <div class="ledger-card">

        <div class="ledger-header">

            <div class="ledger-title-wrapper">

                <div class="ledger-icon">
                    <i class="fa-solid fa-table-list"></i>
                </div>

                <div>

                    <h5 class="ledger-title">
                        Leave Ledger Summary
                    </h5>

                    <p class="ledger-subtitle">
                        Detailed breakdown of your annual leave balance
                    </p>

                </div>

            </div>

            <span class="ledger-badge">
                Current Leave Year
            </span>

        </div>


        <div class="table-responsive">

            <table class="table ledger-table align-middle mb-0">

                <thead>

                    <tr>

                        <th>
                            Leave Type
                        </th>

                        <th>
                            Opening Balance
                        </th>

                        <th>
                            Leaves Taken
                        </th>

                        <th>
                            Closing Balance
                        </th>

                    </tr>

                </thead>

                <tbody>

                    <!-- Casual Leave -->

                    <tr>

                        <td>

                            <div class="ledger-leave-name">

                                <span class="ledger-dot casual-dot"></span>

                                Casual Leave

                            </div>

                        </td>

                        <td>
                            <span class="days-value">
                                @casualTotal Days
                            </span>
                        </td>

                        <td>
                            <span class="taken-value">
                                @casualTaken Days
                            </span>
                        </td>

                        <td>
                            <span class="closing-value">
                                @casualRemaining Days
                            </span>
                        </td>

                    </tr>


                    <!-- Sick Leave -->

                    <tr>

                        <td>

                            <div class="ledger-leave-name">

                                <span class="ledger-dot sick-dot"></span>

                                Sick Leave

                            </div>

                        </td>

                        <td>
                            <span class="days-value">
                                @sickTotal Days
                            </span>
                        </td>

                        <td>
                            <span class="taken-value">
                                @sickTaken Days
                            </span>
                        </td>

                        <td>
                            <span class="closing-value">
                                @sickRemaining Days
                            </span>
                        </td>

                    </tr>


                    <!-- Earned Leave -->

                    <tr>

                        <td>

                            <div class="ledger-leave-name">

                                <span class="ledger-dot earned-dot"></span>

                                Earned Leave

                            </div>

                        </td>

                        <td>
                            <span class="days-value">
                                @earnedTotal Days
                            </span>
                        </td>

                        <td>
                            <span class="taken-value">
                                @earnedTaken Days
                            </span>
                        </td>

                        <td>
                            <span class="closing-value">
                                @earnedRemaining Days
                            </span>
                        </td>

                    </tr>

                </tbody>

            </table>

        </div>

    </div>

</div>
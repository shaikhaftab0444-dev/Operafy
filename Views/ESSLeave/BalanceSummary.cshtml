@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Leave Balance Summary";
    int casualTaken = ViewBag.CasualTaken ?? 0;
    int sickTaken = ViewBag.SickTaken ?? 0;
    int earnedTaken = ViewBag.EarnedTaken ?? 0;

    int casualTotal = 12;
    int sickTotal = 8;
    int earnedTotal = 15;

    int casualRemaining = Math.Max(0, casualTotal - casualTaken);
    int sickRemaining = Math.Max(0, sickTotal - sickTaken);
    int earnedRemaining = Math.Max(0, earnedTotal - earnedTaken);
}

<div class="container-fluid py-4 text-start">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-bold mb-1"><i class="fa-solid fa-scale-balanced text-primary me-2"></i>Leave Balance Summary</h4>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0 small">
                    <li class="breadcrumb-item"><a href="/EmployeeDashboard" class="text-decoration-none">ESS</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Leave Balance</li>
                </ol>
            </nav>
        </div>
        <a href="/ESSLeave/Apply" class="btn btn-primary rounded-pill px-3 btn-sm shadow-sm">
            <i class="fa-solid fa-plus me-1.5"></i>Apply for Leave
        </a>
    </div>

    <!-- Balance cards -->
    <div class="row g-4 mb-4">
        <div class="col-md-4">
            <div class="bg-white border rounded-3 p-4 shadow-sm border-start border-4 border-primary">
                <h6 class="fw-bold text-muted text-uppercase mb-2">Casual Leave (CL)</h6>
                <div class="d-flex justify-content-between align-items-baseline">
                    <h3 class="fw-bold text-dark mb-0">@casualRemaining / @casualTotal</h3>
                    <span class="text-muted small">@casualTaken taken</span>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="bg-white border rounded-3 p-4 shadow-sm border-start border-4 border-success">
                <h6 class="fw-bold text-muted text-uppercase mb-2">Sick Leave (SL)</h6>
                <div class="d-flex justify-content-between align-items-baseline">
                    <h3 class="fw-bold text-dark mb-0">@sickRemaining / @sickTotal</h3>
                    <span class="text-muted small">@sickTaken taken</span>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="bg-white border rounded-3 p-4 shadow-sm border-start border-4 border-info">
                <h6 class="fw-bold text-muted text-uppercase mb-2">Earned Leave (EL)</h6>
                <div class="d-flex justify-content-between align-items-baseline">
                    <h3 class="fw-bold text-dark mb-0">@earnedRemaining / @earnedTotal</h3>
                    <span class="text-muted small">@earnedTaken taken</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Detailed Ledger -->
    <div class="bg-white border rounded-3 p-4 shadow-sm">
        <h5 class="fw-bold mb-3">Leave Ledger Summary</h5>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" style="font-size: 0.85rem;">
                <thead class="table-light">
                    <tr>
                        <th>Leave Type</th>
                        <th>Opening Balance</th>
                        <th>Leaves Taken</th>
                        <th>Closing Balance</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td class="fw-bold text-dark">Casual Leave</td>
                        <td>@casualTotal Days</td>
                        <td>@casualTaken Days</td>
                        <td>@casualRemaining Days</td>
                    </tr>
                    <tr>
                        <td class="fw-bold text-dark">Sick Leave</td>
                        <td>@sickTotal Days</td>
                        <td>@sickTaken Days</td>
                        <td>@sickRemaining Days</td>
                    </tr>
                    <tr>
                        <td class="fw-bold text-dark">Earned Leave</td>
                        <td>@earnedTotal Days</td>
                        <td>@earnedTaken Days</td>
                        <td>@earnedRemaining Days</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Leave Balance Summary";

    int casualTaken = ViewBag.CasualTaken ?? 0;
    int sickTaken = ViewBag.SickTaken ?? 0;
    int earnedTaken = ViewBag.EarnedTaken ?? 0;

    int casualTotal = 12;
    int sickTotal = 8;
    int earnedTotal = 15;

    int casualRemaining = Math.Max(0, casualTotal - casualTaken);
    int sickRemaining = Math.Max(0, sickTotal - sickTaken);
    int earnedRemaining = Math.Max(0, earnedTotal - earnedTaken);

    int totalLeave = casualTotal + sickTotal + earnedTotal;
    int totalTaken = casualTaken + sickTaken + earnedTaken;
    int totalRemaining = casualRemaining + sickRemaining + earnedRemaining;

    int casualPercentage = casualTotal > 0
        ? Math.Min(100, Math.Max(0, (casualRemaining * 100) / casualTotal))
        : 0;

    int sickPercentage = sickTotal > 0
        ? Math.Min(100, Math.Max(0, (sickRemaining * 100) / sickTotal))
        : 0;

    int earnedPercentage = earnedTotal > 0
        ? Math.Min(100, Math.Max(0, (earnedRemaining * 100) / earnedTotal))
        : 0;
}

<style>
    /* =========================================================
           LEAVE BALANCE - PREMIUM ESS DESIGN
           ========================================================= */

    .leave-balance-page {
        animation: pageReveal 0.55s ease both;
    }

    @@keyframes pageReveal {
        from

    {
        opacity: 0;

@model ERP_System.Models.ESSLeaveApplication

@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Apply for Leave";
}

<style>
    /* =========================================================
           APPLY FOR LEAVE - PREMIUM ESS DESIGN
           ========================================================= */

    .leave-page {
        animation: pageFadeIn 0.55s ease both;
    }

    @@keyframes pageFadeIn {
        from

    {
        opacity: 0;
        transform: translateY(12px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }

    }

    /* =========================================================
           PAGE HEADER
           ========================================================= */

    .leave-header {
        position: relative;
        overflow: hidden;
        background: linear-gradient(135deg, #ffffff 0%, #f7faff 100%);
        border: 1px solid #e7ecf3;
        border-radius: 18px;
        padding: 20px 24px;
        margin-bottom: 22px;
        box-shadow: 0 8px 28px rgba(15, 23, 42, 0.045);
        animation: headerSlide 0.65s ease both;
    }

    @@keyframes headerSlide {
        from

    {
        opacity: 0;
        transform: translateY(-8px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }

    }

    .leave-header::before {
        content: "";
        position: absolute;
        width: 220px;
        height: 220px;
        border-radius: 50%;
        background: rgba(13, 110, 253, 0.045);
        right: -85px;
        top: -135px;
        pointer-events: none;
    }

    .leave-header-content {
        position: relative;
        z-index: 2;
    }

    .header-icon {
        width: 46px;
        height: 46px;
        min-width: 46px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 13px;
        background: #eef5ff;
        color: #0d6efd;
        font-size: 1.05rem;
        box-shadow: inset 0 0 0 1px rgba(13, 110, 253, 0.06);
        animation: iconFloat 3s ease-in-out infinite;
    }

    @@keyframes iconFloat {
        0%, 100%

    {
        transform: translateY(0);
    }

    50% {
        transform: translateY(-4px);
    }

    }

    .leave-title {
        color: #1d2738;
        font-size: 1.25rem;
        font-weight: 750;
        letter-spacing: -0.025em;
    }

    .leave-subtitle {
        color: #8792a3;
        font-size: 0.73rem;
    }

    .breadcrumb {
        --bs-breadcrumb-divider: "/";
    }

    .breadcrumb-item {
        font-size: 0.7rem;
    }

        .breadcrumb-item a {
            color: #0d6efd;
            font-weight: 600;
        }

        .breadcrumb-item.active {
            color: #8a94a5;
        }

    /* =========================================================
           MAIN FORM WRAPPER
           ========================================================= */

    .leave-form-wrapper {
        max-width: 760px;
        animation: formRise 0.7s ease 0.08s both;
    }

    @@keyframes formRise {
        from

    {
        opacity: 0;
        transform: translateY(15px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }

    }

    .leave-card {
        background: #ffffff;
        border: 1px solid #e7ebf1;
        border-radius: 20px;
        overflow: hidden;
        box-shadow: 0 12px 38px rgba(15, 23, 42, 0.065);
        transition: box-shadow 0.25s ease, transform 0.25s ease;
    }

        .leave-card:hover {
            box-shadow: 0 17px 45px rgba(15, 23, 42, 0.085);
        }

    /* =========================================================
           FORM CARD HEADER
           ========================================================= */

    .form-card-header {
        padding: 22px 24px;
        background: linear-gradient(180deg, #ffffff 0%, #fafcff 100%);
        border-bottom: 1px solid #edf0f4;
    }

    .form-header-icon {
        width: 40px;
        height: 40px;
        min-width: 40px;
        border-radius: 11px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #edf5ff;
        color: #0d6efd;
        font-size: 0.9rem;
    }

    .form-card-title {
        color: #202938;
        font-size: 0.96rem;
        font-weight: 750;
        margin: 0;
    }

    .form-card-description {
        color: #929bab;
        font-size: 0.69rem;
        margin: 3px 0 0;
    }

    /* =========================================================
           FORM BODY
           ========================================================= */

    .form-card-body {
        padding: 26px;
    }

    .form-section {
        margin-bottom: 24px;
    }

        .form-section:last-child {
            margin-bottom: 0;
        }

    .form-section-title {
        display: flex;
        align-items: center;
        gap: 8px;
        color: #344054;
        font-size: 0.72rem;
        font-weight: 750;
        text-transform: uppercase;
        letter-spacing: 0.045em;
        margin-bottom: 14px;
    }

        .form-section-title span {
            width: 24px;
            height: 24px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border-radius: 7px;
            background: #f1f6ff;
            color: #0d6efd;
            font-size: 0.65rem;
        }

    /* =========================================================
           LABELS
           ========================================================= */

    .leave-form-label {
        display: block;
        color: #4a5568;
        font-size: 0.72rem;
        font-weight: 700;
        margin-bottom: 7px;
    }

    .required-star {
        color: #dc3545;
        margin-left: 2px;
    }

    /* =========================================================
           FORM CONTROLS
           ========================================================= */

    .leave-form-control {
        width: 100%;
        min-height: 43px;
        border: 1px solid #dfe5ec;
        border-radius: 10px;
        background: #ffffff;
        color: #273244;
        font-size: 0.78rem;
        padding: 10px 12px;
        outline: none;
        box-shadow: none;
        transition: border-color 0.22s ease, box-shadow 0.22s ease, background 0.22s ease, transform 0.22s ease;
    }

        .leave-form-control:hover {
            border-color: #c8d1dd;
            background: #fcfdff;
        }

        .leave-form-control:focus {
            border-color: #80b4ff;
            background: #ffffff;
            box-shadow: 0 0 0 4px rgba(13, 110, 253, 0.09);
        }

    select.leave-form-control {
        cursor: pointer;
    }

    textarea.leave-form-control {
        min-height: 120px;
        resize: vertical;
        line-height: 1.55;
    }

    .date-row {
        position: relative;
    }

    .date-helper {
        display: block;
        color: #9aa3b1;
        font-size: 0.64rem;
        margin-top: 6px;
    }

    /* =========================================================
           FIELD ICONS
           ========================================================= */

    .input-with-icon {
        position: relative;
    }

        .input-with-icon .field-icon {
            position: absolute;
            left: 13px;
            top: 50%;
            transform: translateY(-50%);
            color: #8d98a8;
            font-size: 0.76rem;
            pointer-events: none;
            z-index: 2;
        }

        .input-with-icon .leave-form-control {
            padding-left: 37px;
        }

        .input-with-icon textarea.leave-form-control {
            padding-left: 37px;
            padding-top: 12px;
        }

    .textarea-icon {
        position: absolute;
        left: 13px;
        top: 14px;
        color: #8d98a8;
        font-size: 0.76rem;
        pointer-events: none;
        z-index: 2;
    }

    /* =========================================================
           ACTION FOOTER
           ========================================================= */

    .form-card-footer {
        display: flex;
        justify-content: flex-end;
        align-items: center;
        gap: 9px;
        padding: 17px 24px;
        background: #fafbfc;
        border-top: 1px solid #edf0f4;
    }

    .leave-btn {
        min-height: 39px;
        border-radius: 9px;
        padding: 8px 17px;
        font-size: 0.72rem;
        font-weight: 700;
        transition: all 0.22s ease;
    }

    .leave-btn-primary {
        border: 0;
        color: #ffffff;
        background: linear-gradient(135deg, #0d6efd, #3d8bfd);
        box-shadow: 0 7px 18px rgba(13, 110, 253, 0.18);
    }

        .leave-btn-primary:hover {
            color: #ffffff;
            transform: translateY(-2px);
            box-shadow: 0 10px 23px rgba(13, 110, 253, 0.25);
        }

        .leave-btn-primary:active {
            transform: translateY(0);
        }

    .leave-btn-secondary {
        background: #ffffff;
        border: 1px solid #dce2e9;
        color: #667085;
    }

        .leave-btn-secondary:hover {
            background: #f7f9fb;
            border-color: #cbd4df;
            color: #344054;
            transform: translateY(-1px);
        }

    /* =========================================================
           INFO NOTE
           ========================================================= */

    .leave-info {
        display: flex;
        align-items: flex-start;
        gap: 10px;
        margin-top: 20px;
        padding: 13px 14px;
        border: 1px solid #e1ecfb;
        background: #f7faff;
        border-radius: 11px;
        color: #718096;
        font-size: 0.68rem;
        line-height: 1.5;
    }

        .leave-info i {
            color: #0d6efd;
            margin-top: 2px;
        }

    /* =========================================================
           RESPONSIVE
           ========================================================= */

    @@media (max-width: 767.98px) {
        .container-fluid.py-4

    {
        padding-top: 16px !important;
    }

    .leave-header {
        padding: 17px;
        border-radius: 15px;
        margin-bottom: 16px;
    }

    .header-icon {
        width: 40px;
        height: 40px;
        min-width: 40px;
        border-radius: 11px;
        font-size: 0.9rem;
    }

    .leave-title {
        font-size: 1.03rem;
    }

    .leave-subtitle {
        font-size: 0.67rem;
    }

    .form-card-header {
        padding: 18px;
    }

    .form-card-body {
        padding: 20px 18px;
    }

    .form-card-footer {
        padding: 15px 18px;
        justify-content: stretch;
        flex-direction: column-reverse;
    }

    .leave-btn {
        width: 100%;
        justify-content: center;
    }

    .leave-btn-secondary {
        margin-left: 0 !important;
    }

    .leave-info {
        margin-top: 16px;
    }

    }

    @@media (max-width: 575.98px) {
        .leave-header-content

    {
        align-items: flex-start !important;
    }

    .breadcrumb {
        margin-top: 2px;
    }

    .form-card-title {
        font-size: 0.88rem;
    }

    .form-card-description {
        font-size: 0.64rem;
    }

    .form-section {
        margin-bottom: 20px;
    }

    .leave-form-control {
        min-height: 42px;
    }

    textarea.leave-form-control {
        min-height: 110px;
    }

    .row.g-3 {
        --bs-gutter-y: 14px;
    }

    }

    /* =========================================================
           ACCESSIBILITY / REDUCED MOTION
           ========================================================= */

    @@media (prefers-reduced-motion: reduce) {
        .leave-page, .leave-header, .leave-form-wrapper, .header-icon

    {
        animation: none !important;
    }

    .leave-card,
    .leave-form-control,
    .leave-btn {
        transition: none !important;
    }

    }
</style>


<div class="container-fluid py-4 text-start leave-page">

    <!-- =========================================================
         PAGE HEADER
         ========================================================= -->

    <div class="leave-header">

        <div class="leave-header-content d-flex align-items-center gap-3">

            <div class="header-icon">
                <i class="fa-solid fa-file-circle-plus"></i>
            </div>

            <div>

                <h4 class="leave-title mb-1">
                    Apply for Leave
                </h4>

                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb mb-0">

                        <li class="breadcrumb-item">
                            <a href="/EmployeeDashboard" class="text-decoration-none">
                                ESS
                            </a>
                        </li>

                        <li class="breadcrumb-item active" aria-current="page">
                            Apply for Leave
                        </li>

                    </ol>
                </nav>

            </div>

        </div>

    </div>


    <!-- =========================================================
         LEAVE APPLICATION FORM
         ========================================================= -->

    <div class="leave-form-wrapper">

        <div class="leave-card">

            <!-- Card Header -->

            <div class="form-card-header">

                <div class="d-flex align-items-center gap-3">

                    <div class="form-header-icon">
                        <i class="fa-solid fa-calendar-plus"></i>
                    </div>

                    <div>

                        <h5 class="form-card-title">
                            Leave Application
                        </h5>

                        <p class="form-card-description">
                            Submit your leave request for HR review and approval.
                        </p>

                    </div>

                </div>

            </div>


            <!-- Form -->

            <form action="/ESSLeave/SubmitLeave" method="post">

                @Html.AntiForgeryToken()

                <!-- Form Body -->

                <div class="form-card-body">

                    <!-- =================================================
                         LEAVE TYPE
                         ================================================= -->

                    <div class="form-section">

                        <div class="form-section-title">
                            <span>
                                <i class="fa-solid fa-layer-group"></i>
                            </span>
                            Leave Details
                        </div>

                        <div>

                            <label class="leave-form-label">
                                Leave Type
                                <span class="required-star">*</span>
                            </label>

                            <div class="input-with-icon">

                                <i class="fa-solid fa-list field-icon"></i>

                                <select name="LeaveType"
                                        class="leave-form-control"
                                        required>

                                    <option value="Casual Leave">
                                        Casual Leave
                                    </option>

                                    <option value="Sick Leave">
                                        Sick Leave
                                    </option>

                                    <option value="Earned Leave">
                                        Earned Leave
                                    </option>

                                </select>

                            </div>

                        </div>

                    </div>


                    <!-- =================================================
                         DATE SECTION
                         ================================================= -->

                    <div class="form-section">

                        <div class="form-section-title">
                            <span>
                                <i class="fa-solid fa-calendar-days"></i>
                            </span>
                            Leave Period
                        </div>

                        <div class="row g-3">

                            <!-- Start Date -->

                            <div class="col-md-6">

                                <label class="leave-form-label">
                                    Start Date
                                    <span class="required-star">*</span>
                                </label>

                                <div class="input-with-icon date-row">

                                    <i class="fa-solid fa-calendar-day field-icon"></i>

                                    <input type="date"
                                           name="StartDate"
                                           class="leave-form-control"
                                           value="@DateTime.Today.ToString("yyyy-MM-dd")"
                                           required />

                                </div>

                                <span class="date-helper">
                                    First day of your leave
                                </span>

                            </div>


                            <!-- End Date -->

                            <div class="col-md-6">

                                <label class="leave-form-label">
                                    End Date
                                    <span class="required-star">*</span>
                                </label>

                                <div class="input-with-icon date-row">

                                    <i class="fa-solid fa-calendar-check field-icon"></i>

                                    <input type="date"
                                           name="EndDate"
                                           class="leave-form-control"
                                           value="@DateTime.Today.ToString("yyyy-MM-dd")"
                                           required />

                                </div>

                                <span class="date-helper">
                                    Last day of your leave
                                </span>

                            </div>

                        </div>

                    </div>


                    <!-- =================================================
                         REASON
                         ================================================= -->

                    <div class="form-section">

                        <div class="form-section-title">
                            <span>
                                <i class="fa-solid fa-message"></i>
                            </span>
                            Application Reason
                        </div>

                        <div>

                            <label class="leave-form-label">
                                Reason for Leave
                                <span class="required-star">*</span>
                            </label>

                            <div class="input-with-icon">

                                <i class="fa-solid fa-pen textarea-icon"></i>

                                <textarea name="Reason"
                                          class="leave-form-control"
                                          rows="4"
                                          placeholder="Describe the reason for your leave request..."
                                          required></textarea>

                            </div>

                        </div>

                    </div>


                    <!-- =================================================
                         INFORMATION NOTE
                         ================================================= -->

                    <div class="leave-info">

                        <i class="fa-solid fa-circle-info"></i>

                        <div>
                            Please make sure the selected dates and reason are correct before submitting.
                            Your request will be forwarded to the appropriate HR/manager for review.
                        </div>

                    </div>

                </div>


                <!-- =====================================================
                     FORM FOOTER
                     ===================================================== -->

                <div class="form-card-footer">

                    <a href="/ESSLeave/History"
                       class="btn leave-btn leave-btn-secondary px-4">

                        <i class="fa-solid fa-arrow-left me-2"></i>
                        Cancel

                    </a>

                    <button type="submit"
                            class="btn leave-btn leave-btn-primary px-4">

                        <i class="fa-solid fa-paper-plane me-2"></i>
                        Submit Application

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>
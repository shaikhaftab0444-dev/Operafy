@model IEnumerable<ERP_System.Models.AdminLoginAudit>
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Login Audit Report";
}

<div class="container-fluid py-4 text-start">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-bold mb-1"><i class="fa-solid fa-user-shield text-primary me-2"></i>Login Audit Report</h4>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0 small">
                    <li class="breadcrumb-item"><a href="/Dashboard" class="text-decoration-none">Admin Dashboard</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Login Audits</li>
                </ol>
            </nav>
        </div>
    </div>

    <!-- Login Audits Table -->
    <div class="bg-white border rounded-3 p-4 shadow-sm" style="max-width: 800px;">
        <h5 class="fw-bold mb-3">Authentication History Log</h5>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" style="font-size: 0.85rem;">
                <thead class="table-light">
                    <tr>
                        <th>Username / Email</th>
                        <th>IP Address</th>
                        <th>Login Date & Time</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var audit in Model)
                        {
                            <tr>
                                <td class="fw-bold text-dark">@audit.Username</td>
                                <td><code>@audit.IpAddress</code></td>
                                <td class="text-muted">@audit.LoginTime.ToString("dd MMM yyyy hh:mm tt")</td>
                                <td>
                                    @if (audit.Status == "Success")
                                    {
                                        <span class="badge bg-success-subtle text-success rounded-pill px-2.5">Success</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger-subtle text-danger rounded-pill px-2.5">Failed</span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4" class="text-center py-4 text-muted">No login logs tracked.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

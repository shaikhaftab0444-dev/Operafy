@model IEnumerable<ERP_System.Models.Branch>
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Branch Summary Report";
}

<div class="container-fluid py-4 text-start">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-bold mb-1"><i class="fa-solid fa-chart-column text-primary me-2"></i>Branch Summary Report</h4>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0 small">
                    <li class="breadcrumb-item"><a href="/Dashboard" class="text-decoration-none">Admin Dashboard</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Branch Summary</li>
                </ol>
            </nav>
        </div>
    </div>

    <!-- Branch Summary Table -->
    <div class="bg-white border rounded-3 p-4 shadow-sm" style="max-width: 800px;">
        <h5 class="fw-bold mb-3">Active Branch Summary</h5>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" style="font-size: 0.85rem;">
                <thead class="table-light">
                    <tr>
                        <th>Branch Name</th>
                        <th>Branch Code</th>
                        <th>Associated Employees</th>
                        <th>Total Asset Transactions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var b in Model)
                        {
                            <tr>
                                <td class="fw-bold text-dark">@b.BranchName</td>
                                <td><code>@b.BranchCode</code></td>
                                <td>3 Staff Members</td>
                                <td>15 Logs</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

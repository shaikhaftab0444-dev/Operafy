@model IEnumerable<ERP_System.Models.User>
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Super Admin Impersonation";
}

<div class="container-fluid py-4 text-start">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-bold mb-1"><i class="fa-solid fa-user-secret text-primary me-2"></i>Super Admin Impersonation</h4>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0 small">
                    <li class="breadcrumb-item"><a href="/SuperAdminDashboard" class="text-decoration-none">Dashboard</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Impersonation</li>
                </ol>
            </nav>
        </div>
    </div>

    <!-- Impersonation Table -->
    <div class="bg-white border rounded-3 p-4 shadow-sm" style="max-width: 800px;">
        <h5 class="fw-bold mb-3"><i class="fa-solid fa-circle-info text-primary me-2"></i>Login as Any User</h5>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" style="font-size: 0.85rem;">
                <thead class="table-light">
                    <tr>
                        <th>User Name</th>
                        <th>Role</th>
                        <th>Email</th>
                        <th class="text-center">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var u in Model)
                        {
                            <tr>
                                <td class="fw-bold text-dark">@u.FullName</td>
                                <td>@(u.Role != null ? u.Role.RoleName : "General Staff")</td>
                                <td>@u.Email</td>
                                <td class="text-center">
                                    <form action="/SuperAdminAccess/ImpersonateUser" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@u.UserId" />
                                        <button type="submit" class="btn btn-sm btn-outline-primary px-3 rounded-pill py-1"><i class="fa-solid fa-sign-in me-1"></i> Impersonate</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

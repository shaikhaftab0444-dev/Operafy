@model IEnumerable<ERP_System.Models.RolePermission>
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Module & Action Permissions";
}

<div class="container-fluid py-4 text-start">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-bold mb-1"><i class="fa-solid fa-user-shield text-primary me-2"></i>Module & Action Permissions</h4>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0 small">
                    <li class="breadcrumb-item"><a href="/SuperAdminDashboard" class="text-decoration-none">Dashboard</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Permissions</li>
                </ol>
            </nav>
        </div>
    </div>

    <!-- Permissions Matrix -->
    <div class="bg-white border rounded-3 p-4 shadow-sm">
        <h5 class="fw-bold mb-3">RBAC Authorization Matrix</h5>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" style="font-size: 0.85rem;">
                <thead class="table-light">
                    <tr>
                        <th>Role Name</th>
                        <th>Module / Resource</th>
                        <th class="text-center">Access State</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var perm in Model)
                        {
                            <tr>
                                <td class="fw-bold text-dark">@(perm.Role != null ? perm.Role.RoleName : "General Role")</td>
                                <td><code>@perm.ModuleName</code></td>
                                <td class="text-center">
                                    @if (perm.IsAllowed)
                                    {
                                        <span class="badge bg-success-subtle text-success rounded-pill px-2.5">Allowed</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger-subtle text-danger rounded-pill px-2.5">Denied</span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

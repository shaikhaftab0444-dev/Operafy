@model IEnumerable<ERP_System.Models.User>
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "User-Role Mapping";
}

<div class="container-fluid py-4 text-start">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-bold mb-1"><i class="fa-solid fa-users-gear text-primary me-2"></i>User-Role Mapping & Branch Assignments</h4>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0 small">
                    <li class="breadcrumb-item"><a href="/SuperAdminDashboard" class="text-decoration-none">Dashboard</a></li>
                    <li class="breadcrumb-item active" aria-current="page">User Role Mappings</li>
                </ol>
            </nav>
        </div>
    </div>

    <!-- Mappings Table -->
    <div class="bg-white border rounded-3 p-4 shadow-sm">
        <h5 class="fw-bold mb-3">User Authorization Assignments</h5>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" style="font-size: 0.85rem;">
                <thead class="table-light">
                    <tr>
                        <th>Employee Full Name</th>
                        <th>Username</th>
                        <th>Email</th>
                        <th>Assigned Role</th>
                        <th>Assigned Branch</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var u in Model)
                        {
                            <tr>
                                <td class="fw-bold text-dark">@u.FullName</td>
                                <td>@@@u.UserName</td>
                                <td>@u.Email</td>
                                <td>
                                    <span class="badge bg-primary-subtle text-primary rounded-pill px-2.5">
                                        @(u.Role != null ? u.Role.RoleName : "General Staff")
                                    </span>
                                </td>
                                <td>@(u.Branch != null ? u.Branch.BranchName : "Head Office")</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

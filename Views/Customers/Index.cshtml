@model IEnumerable<ERP_System.Models.Customer>
@{
    ViewData["Title"] = "Customer Registry";
    Layout = "_DashboardLayout";
}

<style>
    .card-cust {
        background: #ffffff;
        border: 1px solid var(--border-warm);
        border-radius: 12px;
        padding: 1.25rem;
        box-shadow: 0 1px 3px rgba(45,37,30,0.03);
        display: flex;
        align-items: center;
        gap: 15px;
        height: 100%;
        text-align: left;
    }

    .cust-icon-wrap {
        width: 48px;
        height: 48px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.25rem;
    }

    .cust-icon-total {
        background-color: rgba(79, 70, 229, 0.08);
        color: var(--primary-warm);
    }

    .cust-icon-active {
        background-color: rgba(16, 185, 129, 0.08);
        color: #10b981;
    }

    .cust-info {
        flex-grow: 1;
    }

    .cust-label {
        font-size: 0.75rem;
        color: var(--sidebar-color);
        font-weight: 700;
        margin-bottom: 2px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .cust-val {
        font-size: 1.4rem;
        font-weight: 700;
        color: var(--text-color);
    }

    .panel-cust {
        background: #ffffff;
        border: 1px solid var(--border-warm);
        border-radius: 12px;
        padding: 1.5rem;
        box-shadow: 0 1px 3px rgba(45,37,30,0.03);
    }

    .table-cust th {
        background-color: #fcfbfa !important;
        font-size: 0.75rem;
        text-transform: uppercase;
        font-weight: 700;
        color: #7c7267;
        border-bottom: 1px solid var(--border-warm);
        padding: 0.85rem 1rem;
        white-space: nowrap;
    }

    .table-cust td {
        font-size: 0.85rem;
        color: var(--text-color);
        border-bottom: 1px solid var(--border-warm);
        padding: 0.85rem 1rem;
        vertical-align: middle;
    }

    .badge-active {
        background-color: rgba(16, 185, 129, 0.08);
        color: #10b981;
        font-weight: 600;
        border: 1px solid rgba(16, 185, 129, 0.2);
    }

    .badge-inactive {
        background-color: rgba(239, 68, 68, 0.08);
        color: #ef4444;
        font-weight: 600;
        border: 1px solid rgba(239, 68, 68, 0.2);
    }

    .btn-add-customer {
        background: var(--primary-warm);
        color: #fff;
        border: none;
        border-radius: 8px;
        padding: 0.65rem 1rem;
        font-weight: 600;
        font-size: 0.85rem;
        white-space: nowrap;
        transition: 0.2s ease;
        box-shadow: 0 3px 10px rgba(79, 70, 229, 0.12);
    }

    .btn-add-customer:hover {
        color: #fff;
        transform: translateY(-1px);
        opacity: 0.92;
    }

    .action-menu {
        border: 1px solid var(--border-warm);
        border-radius: 8px;
        background: #fff;
        color: #7c7267;
        padding: 0.35rem 0.6rem;
    }

    .dropdown-menu {
        border: 1px solid var(--border-warm);
        border-radius: 10px;
        padding: 0.45rem;
        box-shadow: 0 8px 25px rgba(45,37,30,0.12);
    }

    .dropdown-item {
        border-radius: 7px;
        padding: 0.55rem 0.75rem;
        font-size: 0.83rem;
    }

    .dropdown-item:hover {
        background: #faf6f0;
    }

    .customer-avatar {
        width: 30px;
        height: 30px;
        min-width: 30px;
        border-radius: 50%;
        background-color: #faf6f0;
        color: var(--primary-warm);
        border: 1.5px solid var(--primary-warm);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.75rem;
        font-weight: 700;
    }
</style>

<!-- Header -->
<div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-3 mb-4 text-start">
    <div>
        <h4 class="fw-bold mb-1" style="color: var(--text-color);">Customer Registry</h4>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0 small">
                <li class="breadcrumb-item">
                    <a href="/Dashboard" class="text-decoration-none">Dashboard</a>
                </li>
                <li class="breadcrumb-item active">Customers</li>
            </ol>
        </nav>
    </div>

    <a asp-action="Create" class="btn-add-customer text-decoration-none">
        <i class="fa-solid fa-user-plus me-2"></i>Add New Customer
    </a>
</div>

<!-- Success Alert -->
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success border-0 shadow-sm alert-dismissible fade show mb-4 small text-start"
         role="alert"
         style="background-color: #f0fdf4; color: #15803d; border-left: 4px solid #16a34a !important;">
        <i class="fa-solid fa-circle-check me-2"></i>
        @TempData["SuccessMessage"]

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert"
                aria-label="Close">
        </button>
    </div>
}

<!-- KPI Cards -->
<div class="row g-4 mb-4">
    <div class="col-md-6">
        <div class="card-cust">
            <div class="cust-icon-wrap cust-icon-total">
                <i class="fa-solid fa-handshake"></i>
            </div>

            <div class="cust-info">
                <div class="cust-label">Total Customers</div>
                <div class="cust-val">@ViewBag.TotalCustomers</div>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card-cust">
            <div class="cust-icon-wrap cust-icon-active">
                <i class="fa-solid fa-circle-check"></i>
            </div>

            <div class="cust-info">
                <div class="cust-label">Active Customers</div>
                <div class="cust-val">@ViewBag.ActiveCustomers</div>
            </div>
        </div>
    </div>
</div>

<!-- Filters -->
<div class="panel-cust mb-4">
    <form method="get" asp-action="Index" class="row g-3 align-items-center text-start">
        <div class="col-md-6">
            <label class="small fw-bold text-secondary mb-1">
                Search Customers
            </label>

            <input type="text"
                   name="searchTerm"
                   value="@ViewBag.SearchTerm"
                   class="form-control"
                   placeholder="Search by name, email, or phone number..."
                   style="padding: 0.5rem 1rem;" />
        </div>

        <div class="col-md-3">
            <label class="small fw-bold text-secondary mb-1">
                Status Filter
            </label>

            <select name="statusFilter"
                    class="form-select"
                    style="padding: 0.5rem 1rem;">

                @if (ViewBag.StatusFilter == "All")
                {
                    <option value="All" selected>All Customers</option>
                }
                else
                {
                    <option value="All">All Customers</option>
                }

                @if (ViewBag.StatusFilter == "Active")
                {
                    <option value="Active" selected>Active Only</option>
                }
                else
                {
                    <option value="Active">Active Only</option>
                }

                @if (ViewBag.StatusFilter == "Inactive")
                {
                    <option value="Inactive" selected>Inactive Only</option>
                }
                else
                {
                    <option value="Inactive">Inactive Only</option>
                }
            </select>
        </div>

        <div class="col-md-3 align-self-end d-flex gap-2">
            <button type="submit"
                    class="btn btn-primary-warm w-100 py-2 fw-bold">
                <i class="fa-solid fa-filter me-1"></i> Filter
            </button>

            <a asp-action="Index"
               class="btn btn-outline-secondary py-2 fw-bold">
                Reset
            </a>
        </div>
    </form>
</div>

<!-- Customers Table -->
<div class="panel-cust p-0 overflow-hidden">
    <div class="table-responsive">
        <table class="table table-hover table-cust mb-0 border-0 text-start">
            <thead>
                <tr>
                    <th class="ps-3 border-0">Customer ID</th>
                    <th class="border-0">Customer Name</th>
                    <th class="border-0">Email</th>
                    <th class="border-0">Phone</th>
                    <th class="border-0">Date of Birth</th>
                    <th class="border-0">Joined Date</th>
                    <th class="border-0 text-center">Status</th>
                    <th class="border-0 text-center">Actions</th>
                </tr>
            </thead>

            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var customer in Model)
                    {
                        <tr>
                            <td class="ps-3 fw-bold text-secondary">
                                CUST#@customer.Id.ToString("D4")
                            </td>

                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <div class="customer-avatar">
                                        @customer.FirstName.Substring(0, 1).ToUpper()
                                    </div>

                                    <span class="fw-bold text-dark">
                                        @customer.CustomerName
                                    </span>
                                </div>
                            </td>

                            <td>@customer.Email</td>
                            <td>@customer.PhoneNumber</td>
                            <td>@customer.DateOfBirth.ToString("dd MMM yyyy")</td>
                            <td>
                                @(customer.JoinedDate?.ToString("dd MMM yyyy") ?? "-")
                            </td>

                            <td class="text-center">
                                @if (customer.IsActive)
                                {
                                    <span class="badge rounded-pill px-2 py-1 badge-active">
                                        Active
                                    </span>
                                }
                                else
                                {
                                    <span class="badge rounded-pill px-2 py-1 badge-inactive">
                                        Inactive
                                    </span>
                                }
                            </td>

                            <td class="text-center">
                                <div class="dropdown">
                                    <button class="action-menu"
                                            type="button"
                                            data-bs-toggle="dropdown"
                                            aria-expanded="false">
                                        <i class="fa-solid fa-ellipsis"></i>
                                    </button>

                                    <ul class="dropdown-menu dropdown-menu-end">
                                        <li>
                                            <a class="dropdown-item"
                                               asp-action="Details"
                                               asp-route-id="@customer.Id">
                                                <i class="fa-regular fa-eye me-2 text-primary"></i>
                                                View Profile
                                            </a>
                                        </li>

                                        <li>
                                            <a class="dropdown-item"
                                               asp-action="Edit"
                                               asp-route-id="@customer.Id">
                                                <i class="fa-solid fa-pen-to-square me-2 text-warning"></i>
                                                Edit Customer
                                            </a>
                                        </li>

                                        <li><hr class="dropdown-divider"></li>

                                        <li>
                                            <button type="button"
                                                    class="dropdown-item text-danger"
                                                    data-bs-toggle="modal"
                                                    data-bs-target="#deleteModal"
                                                    data-customer-id="@customer.Id"
                                                    data-customer-name="@customer.CustomerName">
                                                <i class="fa-solid fa-trash me-2"></i>
                                                Delete Customer
                                            </button>
                                        </li>
                                    </ul>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="8"
                            class="text-center text-muted py-5">
                            <i class="fa-solid fa-users-slash d-block mb-2 fs-4"></i>
                            No customer records found.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade"
     id="deleteModal"
     tabindex="-1"
     aria-labelledby="deleteModalLabel"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">

            <div class="modal-header border-bottom-0 pb-0">
                <h5 class="modal-title fw-bold" id="deleteModalLabel">
                    Delete Customer
                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal">
                </button>
            </div>

            <div class="modal-body py-4">
                <div class="d-flex align-items-start gap-3">
                    <div class="rounded-circle bg-danger-subtle text-danger d-flex align-items-center justify-content-center"
                         style="width:45px;height:45px;min-width:45px;">
                        <i class="fa-solid fa-trash"></i>
                    </div>

                    <div>
                        <p class="mb-1">
                            Are you sure you want to delete
                            <strong id="deleteCustomerName"></strong>?
                        </p>

                        <small class="text-muted">
                            This action cannot be undone.
                        </small>
                    </div>
                </div>
            </div>

            <div class="modal-footer border-top-0">
                <button type="button"
                        class="btn btn-light"
                        data-bs-dismiss="modal">
                    Cancel
                </button>

                <form asp-action="Delete"
                      method="post">

                    @Html.AntiForgeryToken()

                    <input type="hidden"
                           id="deleteCustomerId"
                           name="id" />

                    <button type="submit"
                            class="btn btn-danger">
                        <i class="fa-solid fa-trash me-1"></i>
                        Delete Customer
                    </button>
                </form>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <script>
        const deleteModal = document.getElementById('deleteModal');

        deleteModal.addEventListener('show.bs.modal', function (event) {
            const button = event.relatedTarget;

            const customerId = button.getAttribute('data-customer-id');
            const customerName = button.getAttribute('data-customer-name');

            document.getElementById('deleteCustomerId').value = customerId;
            document.getElementById('deleteCustomerName').textContent = customerName;
        });
    </script>
}
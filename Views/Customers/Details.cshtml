@model ERP_System.Models.Customer

@{
    ViewData["Title"] = "Customer Profile";
    Layout = "_DashboardLayout";
}

<style>
    .customer-page-header {
        margin-bottom: 1.75rem;
    }

    .customer-profile-card {
        background: #ffffff;
        border: 1px solid var(--border-warm);
        border-radius: 14px;
        box-shadow: 0 3px 14px rgba(45, 37, 30, 0.05);
        overflow: hidden;
    }

    .profile-header {
        padding: 1.75rem;
        background: #fcfbfa;
        border-bottom: 1px solid var(--border-warm);
    }

    .profile-avatar {
        width: 72px;
        height: 72px;
        border-radius: 16px;
        background: rgba(79, 70, 229, 0.08);
        color: var(--primary-warm);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.7rem;
        font-weight: 700;
    }

    .profile-name {
        font-size: 1.25rem;
        font-weight: 700;
        color: var(--text-color);
    }

    .profile-email {
        color: #7c7267;
        font-size: 0.85rem;
    }

    .status-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        padding: 0.35rem 0.7rem;
        border-radius: 20px;
        font-size: 0.75rem;
        font-weight: 700;
    }

    .status-active {
        background: #ecfdf3;
        color: #15803d;
    }

    .status-inactive {
        background: #fef2f2;
        color: #dc2626;
    }

    .profile-body {
        padding: 1.75rem;
    }

    .profile-section {
        border-bottom: 1px solid var(--border-warm);
        padding-bottom: 1.5rem;
        margin-bottom: 1.5rem;
    }

        .profile-section:last-child {
            border-bottom: 0;
            margin-bottom: 0;
            padding-bottom: 0;
        }

    .section-icon {
        width: 38px;
        height: 38px;
        border-radius: 10px;
        background: rgba(79, 70, 229, 0.08);
        color: var(--primary-warm);
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .section-title {
        font-size: 0.95rem;
        font-weight: 700;
        color: var(--text-color);
        margin-bottom: 0.1rem;
    }

    .section-subtitle {
        font-size: 0.78rem;
        color: #7c7267;
    }

    .detail-item {
        background: #fcfbfa;
        border: 1px solid var(--border-warm);
        border-radius: 10px;
        padding: 0.9rem 1rem;
        height: 100%;
    }

    .detail-label {
        font-size: 0.72rem;
        font-weight: 700;
        color: #7c7267;
        text-transform: uppercase;
        letter-spacing: 0.03em;
        margin-bottom: 0.3rem;
    }

    .detail-value {
        font-size: 0.9rem;
        font-weight: 600;
        color: var(--text-color);
        word-break: break-word;
    }

    .customer-id {
        color: var(--primary-warm);
        font-weight: 700;
    }

    .profile-actions {
        padding: 1.25rem 1.75rem;
        border-top: 1px solid var(--border-warm);
        background: #fcfbfa;
    }

    .btn-profile {
        padding: 0.65rem 1.15rem;
        border-radius: 8px;
        font-size: 0.86rem;
        font-weight: 700;
    }

    .empty-value {
        color: #aaa29a;
        font-weight: 500;
    }
</style>


<!-- Page Header -->
<div class="customer-page-header d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-3 text-start">

    <div>

        <h4 class="fw-bold mb-1" style="color: var(--text-color);">
            Customer Profile
        </h4>

        <nav aria-label="breadcrumb">

            <ol class="breadcrumb mb-0 small">

                <li class="breadcrumb-item">
                    <a asp-controller="Dashboard"
                       asp-action="Index"
                       class="text-decoration-none">
                        Dashboard
                    </a>
                </li>

                <li class="breadcrumb-item">
                    <a asp-action="Index"
                       class="text-decoration-none">
                        Customers
                    </a>
                </li>

                <li class="breadcrumb-item active">
                    Customer Profile
                </li>

            </ol>

        </nav>

    </div>


    <a asp-action="Index"
       class="btn btn-outline-secondary btn-profile">

        <i class="fa-solid fa-arrow-left me-2"></i>

        Back to Customers

    </a>

</div>


<!-- Customer Profile -->
<div class="customer-profile-card">

    <!-- Profile Header -->
    <div class="profile-header">

        <div class="d-flex flex-column flex-sm-row align-items-start align-items-sm-center gap-3">

            <!-- Avatar -->
            <div class="profile-avatar">

                @if (!string.IsNullOrWhiteSpace(Model.FirstName))
                {
                    @Model.FirstName.Substring(0, 1).ToUpper()
                }
                else
                {
                    <i class="fa-solid fa-user"></i>
                }

            </div>


            <!-- Customer Basic Info -->
            <div class="flex-grow-1">

                <div class="profile-name">
                    @Model.CustomerName
                </div>

                <div class="profile-email">
                    <i class="fa-solid fa-envelope me-1"></i>
                    @Model.Email
                </div>

            </div>


            <!-- Status -->
            <div>

                @if (Model.IsActive)
                {
                    <span class="status-badge status-active">

                        <i class="fa-solid fa-circle"
                           style="font-size: 7px;">
                        </i>

                        Active

                    </span>
                }
                else
                {
                    <span class="status-badge status-inactive">

                        <i class="fa-solid fa-circle"
                           style="font-size: 7px;">
                        </i>

                        Inactive

                    </span>
                }

            </div>

        </div>

    </div>


    <!-- Profile Body -->
    <div class="profile-body">


        <!-- Personal Information -->
        <div class="profile-section">

            <div class="d-flex align-items-center gap-3 mb-4">

                <div class="section-icon">

                    <i class="fa-solid fa-user"></i>

                </div>

                <div>

                    <div class="section-title">
                        Personal Information
                    </div>

                    <div class="section-subtitle">
                        Basic information about the customer.
                    </div>

                </div>

            </div>


            <div class="row g-3">

                <!-- Customer ID -->
                <div class="col-md-6 col-lg-3">

                    <div class="detail-item">

                        <div class="detail-label">
                            Customer ID
                        </div>

                        <div class="detail-value customer-id">
                            #@Model.Id
                        </div>

                    </div>

                </div>


                <!-- First Name -->
                <div class="col-md-6 col-lg-3">

                    <div class="detail-item">

                        <div class="detail-label">
                            First Name
                        </div>

                        <div class="detail-value">
                            @Model.FirstName
                        </div>

                    </div>

                </div>


                <!-- Last Name -->
                <div class="col-md-6 col-lg-3">

                    <div class="detail-item">

                        <div class="detail-label">
                            Last Name
                        </div>

                        <div class="detail-value">
                            @Model.LastName
                        </div>

                    </div>

                </div>


                <!-- Date of Birth -->
                <div class="col-md-6 col-lg-3">

                    <div class="detail-item">

                        <div class="detail-label">
                            Date of Birth
                        </div>

                        <div class="detail-value">
                            @Model.DateOfBirth.ToString("dd MMM yyyy")
                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- Contact Information -->
        <div class="profile-section">

            <div class="d-flex align-items-center gap-3 mb-4">

                <div class="section-icon">

                    <i class="fa-solid fa-address-card"></i>

                </div>

                <div>

                    <div class="section-title">
                        Contact Information
                    </div>

                    <div class="section-subtitle">
                        Customer communication details.
                    </div>

                </div>

            </div>


            <div class="row g-3">

                <!-- Email -->
                <div class="col-md-6">

                    <div class="detail-item">

                        <div class="detail-label">
                            Email Address
                        </div>

                        <div class="detail-value">

                            <i class="fa-solid fa-envelope me-2"
                               style="color: var(--primary-warm);">
                            </i>

                            @Model.Email

                        </div>

                    </div>

                </div>


                <!-- Phone -->
                <div class="col-md-6">

                    <div class="detail-item">

                        <div class="detail-label">
                            Phone Number
                        </div>

                        <div class="detail-value">

                            <i class="fa-solid fa-phone me-2"
                               style="color: var(--primary-warm);">
                            </i>

                            @Model.PhoneNumber

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- Account Information -->
        <div class="profile-section">

            <div class="d-flex align-items-center gap-3 mb-4">

                <div class="section-icon">

                    <i class="fa-solid fa-shield-halved"></i>

                </div>

                <div>

                    <div class="section-title">
                        Account Information
                    </div>

                    <div class="section-subtitle">
                        Customer account and registration information.
                    </div>

                </div>

            </div>


            <div class="row g-3">

                <!-- Account Status -->
                <div class="col-md-6 col-lg-4">

                    <div class="detail-item">

                        <div class="detail-label">
                            Account Status
                        </div>

                        <div class="detail-value">

                            @if (Model.IsActive)
                            {
                                <span class="status-badge status-active">
                                    <i class="fa-solid fa-circle"
                                       style="font-size: 7px;">
                                    </i>
                                    Active
                                </span>
                            }
                            else
                            {
                                <span class="status-badge status-inactive">
                                    <i class="fa-solid fa-circle"
                                       style="font-size: 7px;">
                                    </i>
                                    Inactive
                                </span>
                            }

                        </div>

                    </div>

                </div>


                <!-- Joined Date -->
                <div class="col-md-6 col-lg-4">

                    <div class="detail-item">

                        <div class="detail-label">
                            Joined Date
                        </div>

                        <div class="detail-value">

                            @if (Model.JoinedDate.HasValue)
                            {
                                @Model.JoinedDate.Value.ToString("dd MMM yyyy, hh:mm tt")
                            }
                            else
                            {
                                <span class="empty-value">
                                    Not available
                                </span>
                            }

                        </div>

                    </div>

                </div>


                <!-- Account Type -->
                <div class="col-md-6 col-lg-4">

                    <div class="detail-item">

                        <div class="detail-label">
                            Account Type
                        </div>

                        <div class="detail-value">

                            <i class="fa-solid fa-user-tag me-2"
                               style="color: var(--primary-warm);">
                            </i>

                            Customer

                        </div>

                    </div>

                </div>

            </div>

        </div>


    </div>


    <!-- Profile Actions -->
    <div class="profile-actions d-flex flex-column flex-sm-row justify-content-end gap-2">

        <a asp-action="Index"
           class="btn btn-light border btn-profile">

            <i class="fa-solid fa-list me-2"></i>

            Customer List

        </a>


        <a asp-action="Edit"
           asp-route-id="@Model.Id"
           class="btn btn-profile"
           style="background: var(--primary-warm); color: #fff;">

            <i class="fa-solid fa-user-pen me-2"></i>

            Edit Customer

        </a>

    </div>

</div>
@model ERP_System.Models.Customer

@{
    ViewData["Title"] = "Add New Customer";
    Layout = "_DashboardLayout";
}

<style>
    .customer-page-header {
        margin-bottom: 1.75rem;
    }

    .customer-form-card {
        background: #ffffff;
        border: 1px solid var(--border-warm);
        border-radius: 14px;
        box-shadow: 0 3px 14px rgba(45, 37, 30, 0.05);
        overflow: hidden;
    }

    .customer-form-header {
        padding: 1.5rem 1.75rem;
        border-bottom: 1px solid var(--border-warm);
        background: #fcfbfa;
    }

    .customer-form-body {
        padding: 1.75rem;
    }

    .form-section {
        border-bottom: 1px solid var(--border-warm);
        padding-bottom: 1.5rem;
        margin-bottom: 1.5rem;
    }

        .form-section:last-child {
            border-bottom: 0;
            margin-bottom: 0;
            padding-bottom: 0;
        }

    .section-icon {
        width: 38px;
        height: 38px;
        border-radius: 10px;
        background: rgba(79, 70, 229, 0.08);
        color: var(--primary-warm);
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .section-title {
        font-size: 0.95rem;
        font-weight: 700;
        color: var(--text-color);
        margin-bottom: 0.1rem;
    }

    .section-subtitle {
        font-size: 0.78rem;
        color: #7c7267;
    }

    .form-label {
        font-size: 0.8rem;
        font-weight: 700;
        color: var(--text-color);
        margin-bottom: 0.45rem;
    }

    .form-control,
    .form-select {
        border-color: var(--border-warm);
        padding: 0.65rem 0.85rem;
        border-radius: 8px;
        font-size: 0.88rem;
    }

        .form-control:focus,
        .form-select:focus {
            border-color: var(--primary-warm);
            box-shadow: 0 0 0 0.2rem rgba(79, 70, 229, 0.08);
        }

    .required-mark {
        color: #dc2626;
    }

    .status-card {
        background: #fcfbfa;
        border: 1px solid var(--border-warm);
        border-radius: 10px;
        padding: 1rem;
    }

    .form-actions {
        padding: 1.25rem 1.75rem;
        border-top: 1px solid var(--border-warm);
        background: #fcfbfa;
    }

    .btn-save-customer {
        background: var(--primary-warm);
        border: none;
        color: #fff;
        padding: 0.65rem 1.25rem;
        border-radius: 8px;
        font-size: 0.88rem;
        font-weight: 700;
    }

        .btn-save-customer:hover {
            color: #fff;
            opacity: 0.92;
        }

    .btn-cancel {
        padding: 0.65rem 1.25rem;
        border-radius: 8px;
        font-size: 0.88rem;
        font-weight: 700;
    }

    .validation-summary-errors {
        font-size: 0.85rem;
    }
</style>

<!-- Page Header -->
<div class="customer-page-header d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-3 text-start">
    <div>
        <h4 class="fw-bold mb-1" style="color: var(--text-color);">
            Add New Customer
        </h4>

        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0 small">
                <li class="breadcrumb-item">
                    <a asp-controller="Dashboard"
                       asp-action="Index"
                       class="text-decoration-none">
                        Dashboard
                    </a>
                </li>

                <li class="breadcrumb-item">
                    <a asp-action="Index"
                       class="text-decoration-none">
                        Customers
                    </a>
                </li>

                <li class="breadcrumb-item active">
                    Add New Customer
                </li>
            </ol>
        </nav>
    </div>

    <a asp-action="Index"
       class="btn btn-outline-secondary btn-cancel">
        <i class="fa-solid fa-arrow-left me-2"></i>
        Back to Customers
    </a>
</div>

<!-- Customer Registration Form -->
<form asp-action="Create" method="post">

    @Html.AntiForgeryToken()

    <div class="customer-form-card">

        <!-- Form Header -->
        <div class="customer-form-header text-start">
            <div class="d-flex align-items-center gap-3">
                <div class="section-icon">
                    <i class="fa-solid fa-user-plus"></i>
                </div>

                <div>
                    <div class="section-title">
                        Customer Registration
                    </div>

                    <div class="section-subtitle">
                        Enter the customer information to create a new customer account.
                    </div>
                </div>
            </div>
        </div>

        <div class="customer-form-body text-start">

            <!-- Validation Summary -->
            <div asp-validation-summary="ModelOnly"
                 class="text-danger validation-summary-errors mb-4">
            </div>

            <!-- Personal Information -->
            <div class="form-section">

                <div class="d-flex align-items-center gap-3 mb-4">
                    <div class="section-icon">
                        <i class="fa-solid fa-user"></i>
                    </div>

                    <div>
                        <div class="section-title">
                            Personal Information
                        </div>

                        <div class="section-subtitle">
                            Basic details of the customer.
                        </div>
                    </div>
                </div>

                <div class="row g-4">

                    <div class="col-md-6">
                        <label asp-for="FirstName" class="form-label">
                            First Name
                            <span class="required-mark">*</span>
                        </label>

                        <input asp-for="FirstName"
                               class="form-control"
                               placeholder="Enter first name" />

                        <span asp-validation-for="FirstName"
                              class="text-danger small">
                        </span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="LastName" class="form-label">
                            Last Name
                            <span class="required-mark">*</span>
                        </label>

                        <input asp-for="LastName"
                               class="form-control"
                               placeholder="Enter last name" />

                        <span asp-validation-for="LastName"
                              class="text-danger small">
                        </span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="DateOfBirth" class="form-label">
                            Date of Birth
                            <span class="required-mark">*</span>
                        </label>

                        <input asp-for="DateOfBirth"
                               type="date"
                               class="form-control"
                               value="@Model.DateOfBirth.ToString("yyyy-MM-dd")" />

                        <span asp-validation-for="DateOfBirth"
                              class="text-danger small">
                        </span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="IsActive" class="form-label">
                            Customer Status
                        </label>

                        <select asp-for="IsActive"
                                class="form-select">
                            <option value="true">Active</option>
                            <option value="false">Inactive</option>
                        </select>

                        <span asp-validation-for="IsActive"
                              class="text-danger small">
                        </span>
                    </div>

                </div>
            </div>

            <!-- Contact Information -->
            <div class="form-section">

                <div class="d-flex align-items-center gap-3 mb-4">
                    <div class="section-icon">
                        <i class="fa-solid fa-address-card"></i>
                    </div>

                    <div>
                        <div class="section-title">
                            Contact Information
                        </div>

                        <div class="section-subtitle">
                            Customer communication details.
                        </div>
                    </div>
                </div>

                <div class="row g-4">

                    <div class="col-md-6">
                        <label asp-for="Email" class="form-label">
                            Email Address
                            <span class="required-mark">*</span>
                        </label>

                        <input asp-for="Email"
                               type="email"
                               class="form-control"
                               placeholder="customer@example.com" />

                        <span asp-validation-for="Email"
                              class="text-danger small">
                        </span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="PhoneNumber" class="form-label">
                            Phone Number
                            <span class="required-mark">*</span>
                        </label>

                        <input asp-for="PhoneNumber"
                               type="tel"
                               class="form-control"
                               placeholder="+91 XXXXX XXXXX" />

                        <span asp-validation-for="PhoneNumber"
                              class="text-danger small">
                        </span>
                    </div>

                </div>
            </div>

            <!-- Account Information -->
            <div class="form-section">

                <div class="d-flex align-items-center gap-3 mb-4">
                    <div class="section-icon">
                        <i class="fa-solid fa-shield-halved"></i>
                    </div>

                    <div>
                        <div class="section-title">
                            Account Information
                        </div>

                        <div class="section-subtitle">
                            Set up the customer account and access information.
                        </div>
                    </div>
                </div>

                <div class="row g-4">

                    <div class="col-md-6">
                        <label asp-for="Password" class="form-label">
                            Account Password
                            <span class="required-mark">*</span>
                        </label>

                        <input asp-for="Password"
                               type="password"
                               class="form-control"
                               placeholder="Enter account password" />

                        <span asp-validation-for="Password"
                              class="text-danger small">
                        </span>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">
                            Customer ID
                        </label>

                        <div class="status-card">
                            <i class="fa-solid fa-circle-info me-2"
                               style="color: var(--primary-warm);"></i>

                            <span class="small text-muted">
                                The customer ID will be generated automatically after registration.
                            </span>
                        </div>
                    </div>

                </div>
            </div>

        </div>

        <!-- Form Actions -->
        <div class="form-actions d-flex flex-column flex-sm-row justify-content-end gap-2">

            <a asp-action="Index"
               class="btn btn-light border btn-cancel">
                Cancel
            </a>

            <button type="submit"
                    class="btn-save-customer">
                <i class="fa-solid fa-user-plus me-2"></i>
                Register Customer
            </button>

        </div>

    </div>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
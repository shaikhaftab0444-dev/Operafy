@model IEnumerable<ERP_System.Models.AdminAnnouncement>
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Internal Announcements";
}

<div class="container-fluid py-4 text-start">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-bold mb-1"><i class="fa-solid fa-bullhorn text-primary me-2"></i>Internal Announcements</h4>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0 small">
                    <li class="breadcrumb-item"><a href="/Dashboard" class="text-decoration-none">Admin Dashboard</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Announcements</li>
                </ol>
            </nav>
        </div>
        <button class="btn btn-primary rounded-pill px-3 btn-sm shadow-sm" data-bs-toggle="modal" data-bs-target="#announcementModal">
            <i class="fa-solid fa-plus me-1.5"></i>Post Announcement
        </button>
    </div>

    <!-- Announcements Timeline -->
    <div class="row">
        <div class="col-lg-8">
            @if (Model != null && Model.Any())
            {
                @foreach (var a in Model)
                {
                    <div class="bg-white border rounded-3 p-4 shadow-sm mb-3">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <h5 class="fw-bold text-dark mb-0">@a.Title</h5>
                            <span class="text-muted small"><i class="fa-solid fa-clock me-1"></i>@a.CreatedAt.ToString("dd MMM yyyy hh:mm tt")</span>
                        </div>
                        <p class="text-muted mb-3" style="font-size: 0.9rem; line-height: 1.5;">@a.Content</p>
                        <div class="d-flex align-items-center">
                            <div class="bg-light rounded-circle p-2 d-flex align-items-center justify-content-center me-2" style="width: 32px; height: 32px;">
                                <i class="fa-solid fa-user-shield text-primary" style="font-size: 0.8rem;"></i>
                            </div>
                            <span class="small fw-semibold text-secondary">Posted by @a.PostedBy</span>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="bg-white border rounded-3 p-5 text-center text-muted shadow-sm">
                    <i class="fa-solid fa-bullhorn fa-2x mb-3 text-secondary opacity-50"></i>
                    <p class="mb-0">No announcements posted yet.</p>
                </div>
            }
        </div>
    </div>
</div>

<!-- Announcement Modal -->
<div class="modal fade text-start" id="announcementModal" tabindex="-1" aria-labelledby="announcementModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form action="/AdminAnnouncements/CreateAnnouncement" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title fw-bold" id="announcementModalLabel">Post Internal Announcement</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Title</label>
                        <input type="text" name="Title" class="form-control" placeholder="e.g. Server Maintenance" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Content / Body</label>
                        <textarea name="Content" class="form-control" rows="5" placeholder="Write announcement details here..." required></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary rounded-pill px-3 btn-sm" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary rounded-pill px-3 btn-sm">Publish Announcement</button>
                </div>
            </form>
        </div>
    </div>
</div>

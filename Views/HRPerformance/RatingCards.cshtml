@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Employee Rating Cards";
}

<div class="container-fluid py-4 text-start">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-bold mb-1"><i class="fa-solid fa-id-card-clip text-primary me-2"></i>Employee Rating Cards</h4>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0 small">
                    <li class="breadcrumb-item"><a href="/HR" class="text-decoration-none">HR Dashboard</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Rating Cards</li>
                </ol>
            </nav>
        </div>
    </div>

    <!-- Rating Cards Grid -->
    <div class="bg-white border rounded-3 p-4 shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" style="font-size: 0.85rem;">
                <thead class="table-light">
                    <tr>
                        <th>Employee</th>
                        <th>Department</th>
                        <th>Designation</th>
                        <th>Rating (Last Cycle)</th>
                        <th>Rating Band</th>
                        <th>Review Summary Feedback</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td class="fw-bold text-dark">Numan Sales Man</td>
                        <td>Sales & Marketing</td>
                        <td>Sales Manager</td>
                        <td>4.5 / 5.0</td>
                        <td><span class="badge bg-success text-white">Exceeds Expectations (A)</span></td>
                        <td>Consistently achieves targets and leads the sales pipeline expansion successfully.</td>
                    </tr>
                    <tr>
                        <td class="fw-bold text-dark">Aftab Shaik</td>
                        <td>Human Resources</td>
                        <td>HR Executive</td>
                        <td>4.0 / 5.0</td>
                        <td><span class="badge bg-primary text-white">Meets Expectations (B)</span></td>
                        <td>Successfully handles recruitment pipelines and onboarding checklists.</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

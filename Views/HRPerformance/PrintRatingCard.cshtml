@model ERP_System.Models.EmployeeAppraisal
@{
    Layout = null;
    var emp = Model.Employee;
    var cycle = Model.AppraisalCycle;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Employee Rating Card - @emp?.FullName - @cycle?.CycleName</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        body { font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; background-color: #f8f9fa; color: #212529; }
        .card-container { background: #fff; border-radius: 12px; box-shadow: 0 4px 16px rgba(0,0,0,0.1); max-width: 850px; margin: 40px auto; padding: 40px; border-top: 5px solid #0d6efd; }
        .header-logo { color: #0d6efd; font-weight: 800; letter-spacing: 0.5px; }
        .score-circle { width: 90px; height: 90px; border-radius: 50%; background: #e7f1ff; color: #0d6efd; display: flex; flex-direction: column; align-items: center; justify-content: center; margin: 0 auto; border: 3px solid #0d6efd; }
        @@media print {
            .no-print { display: none !important; }
            body { background: #fff; }
            .card-container { box-shadow: none; margin: 0; max-width: 100%; padding: 0; border: none; }
        }
    </style>
</head>
<body>

<div class="container">
    <div class="text-end no-print pt-3 max-width-850 mx-auto" style="max-width: 850px;">
        <button onclick="window.print()" class="btn btn-primary rounded-pill px-4 shadow-sm"><i class="fa-solid fa-print me-2"></i>Print / Download Rating Card</button>
        <button onclick="window.close()" class="btn btn-outline-secondary rounded-pill px-3 ms-2">Close</button>
    </div>

    <div class="card-container">
        <div class="d-flex justify-content-between align-items-center border-bottom pb-3 mb-4">
            <div>
                <h4 class="header-logo mb-0"><i class="fa-solid fa-layer-group me-2"></i>AIT TECHNOLOGIES PVT LTD</h4>
                <div class="text-muted small">Employee Performance & Appraisal Rating Scorecard</div>
            </div>
            <div class="text-end">
                <span class="badge bg-primary px-3 py-2 fs-6">@cycle?.CycleName</span>
                <div class="text-muted small mt-1">Review Period: @cycle?.ReviewType</div>
            </div>
        </div>

        <div class="row align-items-center mb-4 p-3 bg-light rounded-3">
            <div class="col-md-8">
                <h4 class="fw-bold mb-1 text-dark">@emp?.FullName</h4>
                <div class="text-muted small mb-1">Employee Code: <strong>@emp?.UserCode</strong> | Email: <strong>@emp?.Email</strong></div>
                <div class="text-muted small">Designation: <strong>@(emp?.Role?.RoleName ?? "Employee")</strong></div>
            </div>
            <div class="col-md-4 text-center">
                <div class="score-circle">
                    <div class="fs-4 fw-bold">@(Model.FinalScore.HasValue ? $"{Model.FinalScore.Value:N1}" : "N/A")</div>
                    <div class="small fw-semibold" style="font-size: 0.65rem;">OUT OF 5.0</div>
                </div>
                <div class="mt-2 fw-bold text-primary">@Model.FinalRatingBand</div>
            </div>
        </div>

        <h5 class="fw-bold mb-3 text-dark"><i class="fa-solid fa-chart-pie me-2 text-primary"></i>Scorecard Summary Breakdown</h5>
        <table class="table table-bordered mb-4">
            <thead class="table-light small">
                <tr>
                    <th>Evaluation Criteria</th>
                    <th>Weightage</th>
                    <th>Score / Rating</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody class="small">
                <tr>
                    <td class="fw-semibold">Employee Self Rating</td>
                    <td>30% Weight</td>
                    <td class="fw-bold text-dark">@(Model.SelfRating.HasValue ? $"{Model.SelfRating.Value:N1} / 5.0" : "N/A")</td>
                    <td><span class="badge bg-success-subtle text-success">Submitted</span></td>
                </tr>
                <tr>
                    <td class="fw-semibold">Reporting Manager Rating</td>
                    <td>40% Weight</td>
                    <td class="fw-bold text-primary">@(Model.ManagerRating.HasValue ? $"{Model.ManagerRating.Value:N1} / 5.0" : "N/A")</td>
                    <td><span class="badge bg-primary-subtle text-primary">Evaluated</span></td>
                </tr>
                <tr>
                    <td class="fw-semibold">OKR Goals & KPI Achievements</td>
                    <td>30% Weight</td>
                    <td class="fw-bold text-dark">@(Model.GoalScore.HasValue ? $"{Model.GoalScore.Value:N1} / 5.0" : "N/A")</td>
                    <td><span class="badge bg-info-subtle text-info">Calculated</span></td>
                </tr>
                <tr class="table-light fw-bold">
                    <td>Weighted Final Performance Score</td>
                    <td>100%</td>
                    <td class="text-success fs-6">@(Model.FinalScore.HasValue ? $"{Model.FinalScore.Value:N2} / 5.0" : "N/A")</td>
                    <td><span class="badge bg-success">@Model.FinalRatingBand</span></td>
                </tr>
            </tbody>
        </table>

        <div class="mb-4">
            <h6 class="fw-bold text-dark">Employee Self Feedback:</h6>
            <div class="p-3 bg-light border rounded small">
                @(string.IsNullOrEmpty(Model.SelfComments) ? "No self comments recorded." : Model.SelfComments)
            </div>
        </div>

        <div class="mb-4">
            <h6 class="fw-bold text-dark">Reporting Manager Evaluation Feedback:</h6>
            <div class="p-3 bg-light border rounded small">
                @(string.IsNullOrEmpty(Model.ManagerComments) ? "No manager comments recorded." : Model.ManagerComments)
            </div>
        </div>

        @if (!string.IsNullOrEmpty(Model.HRComments))
        {
            <div class="mb-4">
                <h6 class="fw-bold text-dark">HR Remarks / Reward Recommendation:</h6>
                <div class="p-3 bg-light border rounded small">
                    @Model.HRComments
                </div>
            </div>
        }

        <div class="row mt-5 pt-4">
            <div class="col-4">
                <div class="fw-bold border-top pt-2 small">Employee Signature</div>
                <div class="text-muted small">@emp?.FullName</div>
            </div>
            <div class="col-4 text-center">
                <div class="fw-bold border-top pt-2 small">Reporting Manager Signature</div>
                <div class="text-muted small">@(Model.Manager?.FullName ?? "Reporting Lead")</div>
            </div>
            <div class="col-4 text-end">
                <div class="fw-bold border-top pt-2 small">HR Department Authorization</div>
                <div class="text-muted small">AIT Technologies Pvt Ltd</div>
            </div>
        </div>
    </div>
</div>

</body>
</html>

@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "OKR & KPI Setup";
}

<div class="container-fluid py-4 text-start">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-bold mb-1"><i class="fa-solid fa-bullseye text-primary me-2"></i>OKR & KPI Setup</h4>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0 small">
                    <li class="breadcrumb-item"><a href="/HR" class="text-decoration-none">HR Dashboard</a></li>
                    <li class="breadcrumb-item active" aria-current="page">OKR & KPI</li>
                </ol>
            </nav>
        </div>
        <button class="btn btn-primary rounded-pill px-3 btn-sm shadow-sm"><i class="fa-solid fa-plus me-1.5"></i>Create OKR Goal</button>
    </div>

    <!-- Goals Grid -->
    <div class="bg-white border rounded-3 p-4 shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" style="font-size: 0.85rem;">
                <thead class="table-light">
                    <tr>
                        <th>Department</th>
                        <th>Objective</th>
                        <th>Key Result (KPI Target)</th>
                        <th>Target Completion Date</th>
                        <th>Progress</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td class="fw-bold text-dark">Sales & Marketing</td>
                        <td>Boost Q3 sales pipeline expansion</td>
                        <td>Achieve total sales of ₹15,00,000 in Q3</td>
                        <td>30 Sep 2026</td>
                        <td>
                            <div class="d-flex align-items-center">
                                <div class="progress flex-grow-1 me-2" style="height: 6px; width: 100px;">
                                    <div class="progress-bar bg-success" role="progressbar" style="width: 75%;" aria-valuenow="75" aria-valuemin="0" aria-valuemax="100"></div>
                                </div>
                                <span class="small fw-semibold">75%</span>
                            </div>
                        </td>
                        <td><span class="badge bg-success-subtle text-success">On Track</span></td>
                    </tr>
                    <tr>
                        <td class="fw-bold text-dark">Software Engineering</td>
                        <td>Improve core ERP module loading performance</td>
                        <td>Reduce sidebar load response times to < 200ms</td>
                        <td>15 Sep 2026</td>
                        <td>
                            <div class="d-flex align-items-center">
                                <div class="progress flex-grow-1 me-2" style="height: 6px; width: 100px;">
                                    <div class="progress-bar bg-warning" role="progressbar" style="width: 40%;" aria-valuenow="40" aria-valuemin="0" aria-valuemax="100"></div>
                                </div>
                                <span class="small fw-semibold">40%</span>
                            </div>
                        </td>
                        <td><span class="badge bg-warning-subtle text-warning">Behind Schedule</span></td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

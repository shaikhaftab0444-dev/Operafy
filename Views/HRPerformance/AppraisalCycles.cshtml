@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Appraisal Cycles";
}

<div class="container-fluid py-4 text-start">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-bold mb-1"><i class="fa-solid fa-arrows-spin text-primary me-2"></i>Appraisal Cycles</h4>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0 small">
                    <li class="breadcrumb-item"><a href="/HR" class="text-decoration-none">HR Dashboard</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Appraisal Cycles</li>
                </ol>
            </nav>
        </div>
        <button class="btn btn-primary rounded-pill px-3 btn-sm shadow-sm"><i class="fa-solid fa-plus me-1.5"></i>Start Cycle</button>
    </div>

    <!-- Cycles Table -->
    <div class="bg-white border rounded-3 p-4 shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" style="font-size: 0.85rem;">
                <thead class="table-light">
                    <tr>
                        <th>Cycle Name</th>
                        <th>Start Date</th>
                        <th>End Date</th>
                        <th>Self Evaluation Deadline</th>
                        <th>Manager Review Deadline</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td class="fw-bold text-dark">Mid-Year Review 2026</td>
                        <td>01 Jun 2026</td>
                        <td>30 Jun 2026</td>
                        <td>15 Jun 2026</td>
                        <td>25 Jun 2026</td>
                        <td><span class="badge bg-secondary-subtle text-secondary">Closed</span></td>
                    </tr>
                    <tr>
                        <td class="fw-bold text-dark">Annual Appraisal Cycle 2026</td>
                        <td>01 Dec 2026</td>
                        <td>31 Dec 2026</td>
                        <td>15 Dec 2026</td>
                        <td>25 Dec 2026</td>
                        <td><span class="badge bg-warning-subtle text-warning">Upcoming (Planning Stage)</span></td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

@model IEnumerable<ERP_System.Models.AppraisalCycle>
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Appraisal Cycles";
    var activeEmployees = ViewBag.ActiveEmployees as List<ERP_System.Models.User> ?? new List<ERP_System.Models.User>();
    int currentUserId = ViewBag.CurrentUserId ?? 1;
}

<style>
    .appraisal-page {
        --app-primary: #2563eb;
        --app-primary-dark: #1d4ed8;
        --app-primary-light: #eff6ff;
        --app-success: #16a34a;
        --app-warning: #d97706;
        --app-danger: #dc2626;
        --app-text: #172033;
        --app-muted: #6b7280;
        --app-border: #e8edf5;
        --app-bg: #f7f9fc;
    }

    .appraisal-page {
        color: var(--app-text);
    }

    /* Header */
    .appraisal-hero {
        position: relative;
        overflow: hidden;
        border: 1px solid var(--app-border);
        border-radius: 22px;
        padding: 1.5rem 1.75rem;
        margin-bottom: 1.25rem;
        background: linear-gradient(135deg, #ffffff 0%, #f7faff 55%, #edf4ff 100%);
        box-shadow: 0 10px 30px rgba(31, 41, 55, .06);
    }

        .appraisal-hero::before {
            content: "";
            position: absolute;
            width: 180px;
            height: 180px;
            right: -65px;
            top: -95px;
            border-radius: 50%;
            background: rgba(37, 99, 235, .07);
        }

        .appraisal-hero::after {
            content: "";
            position: absolute;
            width: 110px;
            height: 110px;
            right: 90px;
            bottom: -70px;
            border-radius: 50%;
            background: rgba(59, 130, 246, .05);
        }

    .appraisal-hero-content {
        position: relative;
        z-index: 1;
    }

    .appraisal-title-wrap {
        display: flex;
        align-items: center;
        gap: 1rem;
    }

    .appraisal-title-icon {
        width: 52px;
        height: 52px;
        min-width: 52px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 16px;
        color: #fff;
        background: linear-gradient(135deg, #2563eb, #4f46e5);
        box-shadow: 0 10px 22px rgba(37, 99, 235, .22);
        font-size: 1.25rem;
    }

    .appraisal-page-title {
        font-size: 1.35rem;
        font-weight: 800;
        margin: 0;
        letter-spacing: -.02em;
        color: var(--app-text);
    }

    .appraisal-page-subtitle {
        margin: .2rem 0 0;
        color: var(--app-muted);
        font-size: .84rem;
    }

    .breadcrumb {
        margin-bottom: 0;
    }

    .breadcrumb-item,
    .breadcrumb-item a {
        font-size: .78rem;
    }

        .breadcrumb-item a {
            color: var(--app-primary);
            font-weight: 600;
        }

    /* Buttons */
    .btn-app-primary {
        border: 0;
        color: #fff;
        background: linear-gradient(135deg, #2563eb, #4f46e5);
        box-shadow: 0 8px 18px rgba(37, 99, 235, .18);
        transition: all .2s ease;
    }

        .btn-app-primary:hover,
        .btn-app-primary:focus {
            color: #fff;
            transform: translateY(-1px);
            background: linear-gradient(135deg, #1d4ed8, #4338ca);
            box-shadow: 0 12px 22px rgba(37, 99, 235, .25);
        }

    .btn-soft-primary {
        border: 1px solid #cfe0ff;
        background: #f5f9ff;
        color: var(--app-primary);
        transition: all .2s ease;
    }

        .btn-soft-primary:hover {
            color: #fff;
            background: var(--app-primary);
            border-color: var(--app-primary);
        }

    /* Filter Card */
    .appraisal-filter-card {
        border: 1px solid var(--app-border);
        border-radius: 20px;
        background: #fff;
        padding: 1rem;
        margin-bottom: 1.25rem;
        box-shadow: 0 8px 25px rgba(31, 41, 55, .04);
    }

    .filter-label {
        display: flex;
        align-items: center;
        gap: .45rem;
        font-size: .78rem;
        font-weight: 700;
        color: #4b5563;
        margin-bottom: .4rem;
    }

        .filter-label i {
            color: var(--app-primary);
            font-size: .75rem;
        }

    .appraisal-page .form-control,
    .appraisal-page .form-select,
    .modal .form-control,
    .modal .form-select {
        border-color: #dfe6f0;
        border-radius: 10px;
        min-height: 36px;
        transition: border-color .2s ease, box-shadow .2s ease;
    }

        .appraisal-page .form-control:focus,
        .appraisal-page .form-select:focus,
        .modal .form-control:focus,
        .modal .form-select:focus {
            border-color: #8ab4ff;
            box-shadow: 0 0 0 .2rem rgba(37, 99, 235, .09);
        }

    .search-box .input-group-text {
        border-color: #dfe6f0;
        border-right: 0;
        border-radius: 10px 0 0 10px;
        background: #f8fafc;
    }

    .search-box .form-control {
        border-left: 0;
        border-radius: 0 10px 10px 0;
    }

    /* Table Card */
    .cycles-card {
        overflow: hidden;
        border: 1px solid var(--app-border);
        border-radius: 22px;
        background: #fff;
        box-shadow: 0 12px 32px rgba(31, 41, 55, .05);
    }

    .cycles-card-header {
        padding: 1rem 1.25rem;
        border-bottom: 1px solid var(--app-border);
        background: linear-gradient(180deg, #ffffff, #fbfcfe);
    }

    .cycles-card-title {
        display: flex;
        align-items: center;
        gap: .7rem;
    }

    .cycles-card-title-icon {
        width: 34px;
        height: 34px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 10px;
        color: var(--app-primary);
        background: var(--app-primary-light);
    }

    .cycles-card-title h6 {
        margin: 0;
        font-weight: 800;
        color: var(--app-text);
    }

    .cycles-card-title small {
        display: block;
        color: var(--app-muted);
        margin-top: 2px;
    }

    .cycle-count {
        border: 1px solid #dce8fb;
        background: #f6f9ff;
        color: var(--app-primary);
        border-radius: 999px;
        padding: .35rem .75rem;
        font-size: .75rem;
        font-weight: 700;
    }

    .appraisal-table {
        margin: 0;
        font-size: .84rem;
    }

        .appraisal-table thead th {
            background: #f8fafc;
            color: #64748b;
            border-bottom: 1px solid var(--app-border);
            border-top: 0;
            font-size: .69rem;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: .045em;
            white-space: nowrap;
            padding: .9rem .85rem;
        }

        .appraisal-table tbody td {
            padding: 1rem .85rem;
            border-color: #eef2f7;
            vertical-align: middle;
        }

        .appraisal-table tbody tr {
            transition: background .2s ease, transform .2s ease;
        }

            .appraisal-table tbody tr:hover {
                background: #fbfdff;
            }

    .cycle-name {
        display: flex;
        align-items: flex-start;
        gap: .7rem;
        min-width: 220px;
    }

    .cycle-avatar {
        width: 38px;
        height: 38px;
        min-width: 38px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 11px;
        color: var(--app-primary);
        background: var(--app-primary-light);
    }

    .cycle-name-title {
        color: var(--app-text);
        font-weight: 750;
        line-height: 1.35;
    }

    .cycle-description {
        color: var(--app-muted);
        font-size: .74rem;
        line-height: 1.45;
        margin-top: .18rem;
        max-width: 250px;
    }

    .date-cell {
        white-space: nowrap;
    }

    .date-label {
        color: var(--app-muted);
        font-size: .68rem;
        display: block;
        margin-bottom: .18rem;
    }

    .date-value {
        color: #374151;
        font-size: .8rem;
        font-weight: 650;
    }

    .review-type-badge,
    .status-badge,
    .staff-badge,
    .submitted-badge {
        display: inline-flex;
        align-items: center;
        gap: .35rem;
        border-radius: 999px;
        font-weight: 700;
        white-space: nowrap;
    }

    .review-type-badge {
        padding: .35rem .65rem;
        font-size: .71rem;
        color: var(--app-primary);
        background: #eff6ff;
        border: 1px solid #dce9ff;
    }

    .status-badge {
        padding: .35rem .65rem;
        font-size: .71rem;
    }

    .staff-badge {
        padding: .38rem .68rem;
        font-size: .72rem;
        color: #374151;
        background: #f8fafc;
        border: 1px solid #e5e7eb;
    }

    .submitted-badge {
        padding: .42rem .72rem;
        font-size: .7rem;
    }

    .action-group {
        display: inline-flex;
        align-items: center;
        justify-content: flex-end;
        gap: .35rem;
    }

    .btn-action {
        border-radius: 9px;
        font-size: .74rem;
        font-weight: 700;
        padding: .38rem .65rem;
    }

    .action-menu-btn {
        width: 34px;
        height: 34px;
        padding: 0;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 9px;
    }

    .dropdown-menu {
        border: 1px solid #e8edf4;
        border-radius: 12px;
        padding: .4rem;
        box-shadow: 0 15px 35px rgba(15, 23, 42, .12) !important;
    }

    .dropdown-item {
        border-radius: 8px;
        padding: .55rem .7rem;
    }

        .dropdown-item:hover {
            background: #f5f8fc;
        }

    /* Empty State */
    .empty-state {
        padding: 3.5rem 1rem !important;
    }

    .empty-state-icon {
        width: 62px;
        height: 62px;
        margin: 0 auto 1rem;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 18px;
        background: #f3f6fb;
        color: #94a3b8;
        font-size: 1.45rem;
    }

    .empty-state-title {
        color: #374151;
        font-weight: 750;
        margin-bottom: .3rem;
    }

    .empty-state-text {
        color: var(--app-muted);
        font-size: .8rem;
    }

    /* Modal */
    .appraisal-modal .modal-content {
        border: 0;
        border-radius: 20px;
        overflow: hidden;
        box-shadow: 0 20px 60px rgba(15, 23, 42, .18);
    }

    .appraisal-modal .modal-header {
        padding: 1rem 1.25rem;
        border-bottom: 1px solid #edf1f6;
        background: linear-gradient(180deg, #ffffff, #f9fbfd);
    }

    .appraisal-modal .modal-title {
        font-weight: 800;
        color: var(--app-text);
    }

    .appraisal-modal .modal-body {
        padding: 1.4rem;
    }

    .appraisal-modal .modal-footer {
        padding: .9rem 1.25rem;
        border-top: 1px solid #edf1f6;
        background: #fbfcfe;
    }

    .modal-section-title {
        display: flex;
        align-items: center;
        gap: .55rem;
        margin-bottom: 1rem;
        padding-bottom: .65rem;
        border-bottom: 1px solid #eef2f6;
        font-size: .82rem;
        font-weight: 800;
        color: #374151;
    }

        .modal-section-title i {
            color: var(--app-primary);
        }

    .appraisal-modal .form-label {
        color: #475569;
        margin-bottom: .38rem;
        font-size: .76rem;
    }

    .form-switch .form-check-input {
        width: 2.5em;
        cursor: pointer;
    }

    /* Alert */
    .appraisal-page .alert {
        border: 0;
        border-radius: 14px;
        box-shadow: 0 8px 22px rgba(22, 163, 74, .08);
    }

    /* Mobile Responsive */
    @@media (max-width: 991.98px) {
        .appraisal-table

    {
        min-width: 1050px;
    }

    .appraisal-hero {
        padding: 1.25rem;
    }

    }

    @@media (max-width: 767.98px) {
        .appraisal-page

    {
        padding-top: 1rem !important;
        padding-bottom: 1rem !important;
    }

    .appraisal-hero {
        border-radius: 18px;
        padding: 1.1rem;
    }

    .appraisal-title-wrap {
        align-items: flex-start;
    }

    .appraisal-title-icon {
        width: 46px;
        height: 46px;
        min-width: 46px;
        border-radius: 14px;
    }

    .appraisal-page-title {
        font-size: 1.15rem;
    }

    .appraisal-page-subtitle {
        font-size: .76rem;
    }

    .appraisal-filter-card {
        border-radius: 16px;
        padding: .9rem;
    }

    .filter-actions {
        display: flex;
        gap: .5rem;
    }

        .filter-actions .btn,
        .filter-actions a {
            flex: 1;
        }

    .cycles-card {
        border-radius: 17px;
    }

    .cycles-card-header {
        padding: .9rem 1rem;
    }

        .cycles-card-header > div {
            align-items: flex-start !important;
            flex-direction: column;
            gap: .75rem;
        }

    .cycle-count {
        align-self: flex-start;
    }

    .appraisal-modal .modal-body {
        padding: 1.1rem;
    }

    .appraisal-modal .modal-footer {
        padding: .8rem 1rem;
    }

        .appraisal-modal .modal-footer .btn {
            flex: 1;
        }

    }

    @@media (max-width: 575.98px) {
        .appraisal-title-wrap

    {
        gap: .75rem;
    }

    .appraisal-title-icon {
        width: 42px;
        height: 42px;
        min-width: 42px;
        font-size: 1rem;
    }

    .appraisal-hero .btn {
        width: 100%;
        justify-content: center;
    }

    .cycles-card-title h6 {
        font-size: .9rem;
    }

    .cycles-card-title small {
        font-size: .7rem;
    }

    }</style>

<div class="container-fluid py-4 text-start appraisal-page">

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
            <i class="fa-solid fa-circle-check me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Premium Header Section -->
    <div class="appraisal-hero">
        <div class="appraisal-hero-content d-flex justify-content-between align-items-center flex-wrap gap-3">
            <div>
                <div class="appraisal-title-wrap">
                    <div class="appraisal-title-icon">
                        <i class="fa-solid fa-arrows-spin"></i>
                    </div>
                    <div>
                        <h4 class="appraisal-page-title">Appraisal Cycles</h4>
                        <p class="appraisal-page-subtitle">Manage performance review cycles, employee evaluations and appraisal progress.</p>
                    </div>
                </div>

                <nav aria-label="breadcrumb" class="mt-3">
                    <ol class="breadcrumb">
                        <li class="breadcrumb-item">
                            <a href="/HR" class="text-decoration-none">HR Dashboard</a>
                        </li>
                        <li class="breadcrumb-item active" aria-current="page">Appraisal Cycles</li>
                    </ol>
                </nav>
            </div>

            <button class="btn btn-app-primary rounded-pill px-4 btn-sm d-inline-flex align-items-center gap-2"
                    data-bs-toggle="modal"
                    data-bs-target="#createCycleModal">
                <i class="fa-solid fa-plus"></i>
                <span>Start Cycle</span>
            </button>
        </div>
    </div>

    <!-- Filters -->
    <div class="appraisal-filter-card">
        <form method="get" action="/HRPerformance/AppraisalCycles" class="row g-3 align-items-end">

            <div class="col-lg-5 col-md-6">
                <label class="filter-label">
                    <i class="fa-solid fa-magnifying-glass"></i>
                    Search Appraisal Cycle
                </label>
                <div class="input-group input-group-sm search-box">
                    <span class="input-group-text">
                        <i class="fa-solid fa-magnifying-glass text-muted"></i>
                    </span>
                    <input type="text"
                           name="search"
                           class="form-control"
                           placeholder="Search cycle name..."
                           value="@ViewBag.Search" />
                </div>
            </div>

            <div class="col-lg-4 col-md-6">
                <label class="filter-label">
                    <i class="fa-solid fa-filter"></i>
                    Cycle Status
                </label>
                <select name="status" class="form-select form-select-sm" onchange="this.form.submit()">
                    <option value="All">All Cycle Statuses</option>
                    <option value="Active" selected="@(ViewBag.SelectedStatus == "Active" ? "selected" : null)">Active (In Review)</option>
                    <option value="Completed" selected="@(ViewBag.SelectedStatus == "Completed" ? "selected" : null)">Completed / Closed</option>
                    <option value="Draft" selected="@(ViewBag.SelectedStatus == "Draft" ? "selected" : null)">Draft</option>
                </select>
            </div>

            <div class="col-lg-3 col-md-12">
                <div class="filter-actions d-flex justify-content-lg-end gap-2">
                    <button type="submit" class="btn btn-soft-primary btn-sm px-3 rounded-pill">
                        <i class="fa-solid fa-filter me-1"></i>Filter
                    </button>
                    <a href="/HRPerformance/AppraisalCycles" class="btn btn-outline-secondary btn-sm px-3 rounded-pill">
                        <i class="fa-solid fa-rotate-left me-1"></i>Reset
                    </a>
                </div>
            </div>

        </form>
    </div>

    <!-- Appraisal Cycles -->
    <div class="cycles-card">

        <div class="cycles-card-header">
            <div class="d-flex justify-content-between align-items-center">
                <div class="cycles-card-title">
                    <div class="cycles-card-title-icon">
                        <i class="fa-solid fa-calendar-check"></i>
                    </div>
                    <div>
                        <h6>Performance Review Cycles</h6>
                        <small>Track cycle timelines, review deadlines and employee appraisals.</small>
                    </div>
                </div>

                <span class="cycle-count">
                    <i class="fa-solid fa-layer-group me-1"></i>
                    @(Model?.Count() ?? 0) Cycle(s)
                </span>
            </div>
        </div>

        <div class="table-responsive">
            <table class="table appraisal-table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>Cycle Details</th>
                        <th>Review Type</th>
                        <th>Cycle Period</th>
                        <th>Self Review</th>
                        <th>Manager Review</th>
                        <th>Appraisals</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>

                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var cycle in Model)
                        {
                            int appraisalCount = cycle.Appraisals?.Count ?? 0;
                            var myAppraisal = cycle.Appraisals?.FirstOrDefault(a => a.EmployeeId == currentUserId);

                            string badgeClass = cycle.Status switch
                            {
                                "Active" => "bg-success-subtle text-success",
                                "Completed" or "Closed" => "bg-secondary-subtle text-secondary",
                                "Draft" => "bg-warning-subtle text-warning",
                                _ => "bg-light text-dark"
                            };

                            <tr>
                                <td>
                                    <div class="cycle-name">
                                        <div class="cycle-avatar">
                                            <i class="fa-solid fa-arrows-spin"></i>
                                        </div>
                                        <div>
                                            <div class="cycle-name-title">@cycle.CycleName</div>
                                            @if (!string.IsNullOrWhiteSpace(cycle.Description))
                                            {
                                                <div class="cycle-description">@cycle.Description</div>
                                            }
                                        </div>
                                    </div>
                                </td>

                                <td>
                                    <span class="review-type-badge">
                                        <i class="fa-solid fa-clipboard-list"></i>
                                        @cycle.ReviewType
                                    </span>
                                </td>

                                <td class="date-cell">
                                    <span class="date-label">Start → End</span>
                                    <span class="date-value">
                                        @cycle.StartDate.ToString("dd MMM yyyy")
                                        <br />
                                        <span class="text-muted">to</span>
                                        @cycle.EndDate.ToString("dd MMM yyyy")
                                    </span>
                                </td>

                                <td class="date-cell">
                                    <span class="date-label">Deadline</span>
                                    <span class="date-value">
                                        <i class="fa-solid fa-user-pen text-primary me-1"></i>
                                        @cycle.SelfReviewDeadline.ToString("dd MMM yyyy")
                                    </span>
                                </td>

                                <td class="date-cell">
                                    <span class="date-label">Deadline</span>
                                    <span class="date-value">
                                        <i class="fa-solid fa-user-tie text-primary me-1"></i>
                                        @cycle.ManagerReviewDeadline.ToString("dd MMM yyyy")
                                    </span>
                                </td>

                                <td>
                                    <span class="staff-badge">
                                        <i class="fa-solid fa-users"></i>
                                        @appraisalCount Staff
                                    </span>
                                </td>

                                <td>
                                    <span class="status-badge @badgeClass">
                                        @if (cycle.Status == "Active")
                                        {
                                            <i class="fa-solid fa-circle-play"></i>
                                        }
                                        else if (cycle.Status == "Completed" || cycle.Status == "Closed")
                                        {
                                            <i class="fa-solid fa-circle-check"></i>
                                        }
                                        else if (cycle.Status == "Draft")
                                        {
                                            <i class="fa-solid fa-file-pen"></i>
                                        }
                                        else
                                        {
                                            <i class="fa-solid fa-circle"></i>
                                        }
                                        @cycle.Status
                                    </span>
                                </td>

                                <td class="text-end">
                                    <div class="action-group">
                                        @if (myAppraisal != null)
                                        {
                                            if (!myAppraisal.SelfReviewSubmitted)
                                            {
                                                <button class="btn btn-outline-success btn-action"
                                                        data-bs-toggle="modal"
                                                        data-bs-target="#selfReviewModal_@myAppraisal.AppraisalId">
                                                    <i class="fa-solid fa-pen-to-square me-1"></i>
                                                    Self Review
                                                </button>
                                            }
                                            else
                                            {
                                                <span class="submitted-badge bg-success-subtle text-success">
                                                    <i class="fa-solid fa-check"></i>
                                                    Submitted
                                                </span>
                                            }
                                        }

                                        <div class="dropdown">
                                            <button class="btn btn-light border action-menu-btn dropdown-toggle"
                                                    type="button"
                                                    data-bs-toggle="dropdown"
                                                    aria-expanded="false">
                                            </button>

                                            <ul class="dropdown-menu dropdown-menu-end">
                                                <li>
                                                    <form method="post" action="/HRPerformance/LaunchCycle">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="cycleId" value="@cycle.CycleId" />
                                                        <button type="submit" class="dropdown-item small">
                                                            <i class="fa-solid fa-paper-plane me-2 text-primary"></i>
                                                            Launch / Sync Staff Appraisals
                                                        </button>
                                                    </form>
                                                </li>
                                                <li>
                                                    <a class="dropdown-item small" href="/HRPerformance/RatingCards?cycleId=@cycle.CycleId">
                                                        <i class="fa-solid fa-id-card-clip me-2 text-info"></i>
                                                        View Employee Rating Cards
                                                    </a>
                                                </li>
                                            </ul>
                                        </div>
                                    </div>
                                </td>
                            </tr>

                            <!-- Modal: Self Review for current logged in user -->
                            @if (myAppraisal != null)
                            {
                                <div class="modal fade appraisal-modal"
                                     id="selfReviewModal_@myAppraisal.AppraisalId"
                                     tabindex="-1"
                                     aria-hidden="true">

                                    <div class="modal-dialog modal-dialog-centered">
                                        <div class="modal-content">

                                            <div class="modal-header">
                                                <h6 class="modal-title">
                                                    <i class="fa-solid fa-user-pen text-primary me-2"></i>
                                                    Employee Self Review
                                                </h6>
                                                <button type="button"
                                                        class="btn-close"
                                                        data-bs-dismiss="modal"
                                                        aria-label="Close"></button>
                                            </div>

                                            <form method="post" action="/HRPerformance/SubmitSelfReview">
                                                @Html.AntiForgeryToken()

                                                <input type="hidden"
                                                       name="appraisalId"
                                                       value="@myAppraisal.AppraisalId" />

                                                <div class="modal-body text-start">

                                                    <div class="p-3 rounded-3 bg-light border mb-4">
                                                        <div class="small text-muted mb-1">Current Appraisal Cycle</div>
                                                        <div class="fw-bold text-dark">@cycle.CycleName</div>
                                                    </div>

                                                    <div class="modal-section-title">
                                                        <i class="fa-solid fa-star"></i>
                                                        Your Performance Assessment
                                                    </div>

                                                    <div class="mb-3">
                                                        <label class="form-label fw-semibold">
                                                            Self Rating (1.0 to 5.0)
                                                        </label>

                                                        <select name="selfRating"
                                                                class="form-select form-select-sm"
                                                                required>
                                                            <option value="5.0">5.0 - Outstanding</option>
                                                            <option value="4.5">4.5 - Exceeds Expectations (High)</option>
                                                            <option value="4.0" selected>4.0 - Exceeds Expectations</option>
                                                            <option value="3.5">3.5 - Meets Expectations (High)</option>
                                                            <option value="3.0">3.0 - Meets Expectations</option>
                                                            <option value="2.0">2.0 - Needs Improvement</option>
                                                        </select>
                                                    </div>

                                                    <div class="mb-0">
                                                        <label class="form-label fw-semibold">
                                                            Self Review Remarks & Achievements
                                                        </label>

                                                        <textarea name="selfComments"
                                                      class="form-control form-control-sm"
                                                      rows="5"
                                                      required
                                                      placeholder="Summarize your key achievements, deliverables completed, strengths, and goal contributions during this appraisal cycle..."></textarea>

                                                        <div class="form-text small">
                                                            Provide a clear summary of your contributions and achievements.
                                                        </div>
                                                    </div>

                                                </div>

                                                <div class="modal-footer">
                                                    <button type="button"
                                                            class="btn btn-light border btn-sm rounded-pill px-3"
                                                            data-bs-dismiss="modal">
                                                        Cancel
                                                    </button>

                                                    <button type="submit"
                                                            class="btn btn-success btn-sm rounded-pill px-4">
                                                        <i class="fa-solid fa-check me-1"></i>
                                                        Submit Self Review
                                                    </button>
                                                </div>
                                            </form>

                                        </div>
                                    </div>
                                </div>
                            }
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="text-center empty-state">
                                <div class="empty-state-icon">
                                    <i class="fa-solid fa-arrows-spin"></i>
                                </div>
                                <div class="empty-state-title">No Appraisal Cycles Found</div>
                                <div class="empty-state-text">
                                    There are currently no appraisal cycles matching your selected filters.
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal: Start Appraisal Cycle -->
<div class="modal fade appraisal-modal" id="createCycleModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">
                    <i class="fa-solid fa-plus-circle text-primary me-2"></i>
                    Start New Appraisal Cycle
                </h5>
                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Close"></button>
            </div>

            <form method="post" action="/HRPerformance/CreateCycle">
                @Html.AntiForgeryToken()

                <div class="modal-body text-start">

                    <div class="modal-section-title">
                        <i class="fa-solid fa-circle-info"></i>
                        Cycle Information
                    </div>

                    <div class="row g-3">

                        <div class="col-md-12">
                            <label class="form-label fw-semibold small">
                                Cycle Name <span class="text-danger">*</span>
                            </label>

                            <input type="text"
                                   name="CycleName"
                                   class="form-control form-control-sm"
                                   required
                                   placeholder="e.g. Annual Appraisal Cycle 2026" />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-semibold small">Review Type</label>

                            <select name="ReviewType" class="form-select form-select-sm">
                                <option value="Monthly">Monthly Review</option>
                                <option value="Quarterly">Quarterly Review</option>
                                <option value="Half-Yearly">Half-Yearly Review</option>
                                <option value="Annual" selected>Annual Appraisal</option>
                                <option value="Probation">Probation Review</option>
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-semibold small">Applicable Scope</label>

                            <input type="text"
                                   name="ApplicableDepartmentIds"
                                   class="form-control form-control-sm"
                                   value="All"
                                   placeholder="All / Department IDs" />
                        </div>

                    </div>

                    <div class="modal-section-title mt-4">
                        <i class="fa-solid fa-calendar-days"></i>
                        Review Timeline
                    </div>

                    <div class="row g-3">

                        <div class="col-md-6">
                            <label class="form-label fw-semibold small">Start Date</label>

                            <input type="date"
                                   name="StartDate"
                                   class="form-control form-control-sm"
                                   value="@DateTime.Now.ToString("yyyy-MM-dd")"
                                   required />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-semibold small">End Date</label>

                            <input type="date"
                                   name="EndDate"
                                   class="form-control form-control-sm"
                                   value="@DateTime.Now.AddMonths(1).ToString("yyyy-MM-dd")"
                                   required />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-semibold small">Self Review Deadline</label>

                            <input type="date"
                                   name="SelfReviewDeadline"
                                   class="form-control form-control-sm"
                                   value="@DateTime.Now.AddDays(15).ToString("yyyy-MM-dd")"
                                   required />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-semibold small">Manager Review Deadline</label>

                            <input type="date"
                                   name="ManagerReviewDeadline"
                                   class="form-control form-control-sm"
                                   value="@DateTime.Now.AddDays(25).ToString("yyyy-MM-dd")"
                                   required />
                        </div>

                    </div>

                    <div class="mt-4 p-3 rounded-3 border bg-light">
                        <div class="form-check form-switch mb-0">
                            <input class="form-check-input"
                                   type="checkbox"
                                   name="autoLaunch"
                                   value="true"
                                   id="autoLaunchCheck"
                                   checked />

                            <label class="form-check-label fw-semibold text-dark small"
                                   for="autoLaunchCheck">
                                Automatically launch and assign appraisals to all active staff
                            </label>

                            <div class="text-muted small mt-1">
                                Staff appraisal records will be synchronized automatically when the cycle is created.
                            </div>
                        </div>
                    </div>

                </div>

                <div class="modal-footer">
                    <button type="button"
                            class="btn btn-light border btn-sm rounded-pill px-3"
                            data-bs-dismiss="modal">
                        Cancel
                    </button>

                    <button type="submit"
                            class="btn btn-app-primary btn-sm rounded-pill px-4">
                        <i class="fa-solid fa-play me-1"></i>
                        Start Cycle
                    </button>
                </div>
            </form>

        </div>
    </div>
</div>
@model IEnumerable<ERP_System.Models.ESSSupportTicket>
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Raise HR / IT Support Ticket";
}

<div class="container-fluid py-4 text-start">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-bold mb-1"><i class="fa-solid fa-circle-question text-primary me-2"></i>Raise HR / IT Support Ticket</h4>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0 small">
                    <li class="breadcrumb-item"><a href="/EmployeeDashboard" class="text-decoration-none">ESS</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Support Helpdesk</li>
                </ol>
            </nav>
        </div>
        <button class="btn btn-primary rounded-pill px-3 btn-sm shadow-sm" data-bs-toggle="modal" data-bs-target="#ticketModal">
            <i class="fa-solid fa-plus me-1.5"></i>Raise Ticket
        </button>
    </div>

    <!-- Ticket History -->
    <div class="bg-white border rounded-3 p-4 shadow-sm">
        <h5 class="fw-bold mb-3">Ticket Submission History</h5>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" style="font-size: 0.85rem;">
                <thead class="table-light">
                    <tr>
                        <th>Date Raised</th>
                        <th>Category / Dept</th>
                        <th>Subject</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var t in Model)
                        {
                            <tr>
                                <td class="text-muted">@t.CreatedAt.ToString("dd MMM yyyy")</td>
                                <td class="fw-bold text-dark">@t.Department</td>
                                <td>@t.Subject</td>
                                <td>
                                    @if (t.Status == "Resolved")
                                    {
                                        <span class="badge bg-success-subtle text-success rounded-pill px-2.5 py-1">Resolved</span>
                                    }
                                    else if (t.Status == "In Progress")
                                    {
                                        <span class="badge bg-info-subtle text-info rounded-pill px-2.5 py-1">In Progress</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning-subtle text-warning rounded-pill px-2.5 py-1">Open</span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4" class="text-center py-4 text-muted">No tickets raised.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Ticket Modal -->
<div class="modal fade text-start" id="ticketModal" tabindex="-1" aria-labelledby="ticketModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form action="/ESSHelpdesk/SubmitTicket" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title fw-bold" id="ticketModalLabel">Raise Support Ticket</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Target Department</label>
                        <select name="Department" class="form-select" required>
                            <option value="IT Support">IT Infrastructure & Hardware</option>
                            <option value="HR Support">Human Resources Support</option>
                            <option value="Facilities">Facilities & Office Admin</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Subject / Title</label>
                        <input type="text" name="Subject" class="form-control" placeholder="Brief summary of the issue..." required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Detailed Description</label>
                        <textarea name="Description" class="form-control" rows="4" placeholder="Provide full details or steps to reproduce..." required></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary rounded-pill px-3 btn-sm" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary rounded-pill px-3 btn-sm">Raise Ticket</button>
                </div>
            </form>
        </div>
    </div>
</div>

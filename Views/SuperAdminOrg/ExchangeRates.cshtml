@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Multi-Currency Exchange Rates";
}

<div class="container-fluid py-4 text-start">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-bold mb-1"><i class="fa-solid fa-money-bill-trend-up text-primary me-2"></i>Multi-Currency Exchange Rates</h4>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0 small">
                    <li class="breadcrumb-item"><a href="/SuperAdminDashboard" class="text-decoration-none">Dashboard</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Exchange Rates</li>
                </ol>
            </nav>
        </div>
    </div>

    <!-- Currency Master -->
    <div class="bg-white border rounded-3 p-4 shadow-sm" style="max-width: 600px;">
        <h5 class="fw-bold mb-3">Global Conversion Rates</h5>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" style="font-size: 0.85rem;">
                <thead class="table-light">
                    <tr>
                        <th>ISO Currency Code</th>
                        <th>Symbol</th>
                        <th>Exchange Rate (Base INR)</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td class="fw-bold text-dark">INR</td>
                        <td>₹</td>
                        <td>1.00 (Base)</td>
                    </tr>
                    <tr>
                        <td class="fw-bold text-dark">USD</td>
                        <td>$</td>
                        <td>83.45 INR</td>
                    </tr>
                    <tr>
                        <td class="fw-bold text-dark">EUR</td>
                        <td>€</td>
                        <td>90.20 INR</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

@model IEnumerable<ERP_System.Models.Company>
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Company Master";
}

<div class="container-fluid py-4 text-start">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-bold mb-1"><i class="fa-solid fa-building text-primary me-2"></i>Company Master</h4>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0 small">
                    <li class="breadcrumb-item"><a href="/SuperAdminDashboard" class="text-decoration-none">Dashboard</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Companies</li>
                </ol>
            </nav>
        </div>
        <button class="btn btn-primary rounded-pill px-3 btn-sm shadow-sm" data-bs-toggle="modal" data-bs-target="#companyModal">
            <i class="fa-solid fa-plus me-1.5"></i>Add Company
        </button>
    </div>

    <!-- Companies Grid -->
    <div class="bg-white border rounded-3 p-4 shadow-sm">
        <h5 class="fw-bold mb-3">Operating Entities</h5>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" style="font-size: 0.85rem;">
                <thead class="table-light">
                    <tr>
                        <th>Company Name</th>
                        <th>Reg No</th>
                        <th>Address</th>
                        <th>Active Status</th>
                        <th class="text-center">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var c in Model)
                        {
                            <tr>
                                <td class="fw-bold text-dark">@c.CompanyName</td>
                                <td><code>@c.CompanyCode</code></td>
                                <td class="text-muted">@c.AddressLine1</td>
                                <td>
                                    @if (c.IsActive)
                                    {
                                        <span class="badge bg-success-subtle text-success rounded-pill px-2.5">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger-subtle text-danger rounded-pill px-2.5">Deactivated</span>
                                    }
                                </td>
                                <td class="text-center">
                                    <form action="/SuperAdminOrg/ToggleCompanyActive" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@c.CompanyId" />
                                        @if (c.IsActive)
                                        {
                                            <button type="submit" class="btn btn-sm btn-outline-danger px-3 rounded-pill py-1">Deactivate</button>
                                        }
                                        else
                                        {
                                            <button type="submit" class="btn btn-sm btn-outline-success px-3 rounded-pill py-1">Activate</button>
                                        }
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Company Modal -->
<div class="modal fade text-start" id="companyModal" tabindex="-1" aria-labelledby="companyModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form action="/SuperAdminOrg/CreateCompany" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title fw-bold" id="companyModalLabel">Add Corporate Entity</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Company Name</label>
                        <input type="text" name="CompanyName" class="form-control" placeholder="e.g. AIT Technologies Pvt Ltd" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Company Code</label>
                        <input type="text" name="CompanyCode" class="form-control" placeholder="e.g. COMP-AIT" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Address Line 1</label>
                        <textarea name="AddressLine1" class="form-control" rows="3" placeholder="e.g. Hyderabad, Sector 5" required></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary rounded-pill px-3 btn-sm" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary rounded-pill px-3 btn-sm">Save Company</button>
                </div>
            </form>
        </div>
    </div>
</div>

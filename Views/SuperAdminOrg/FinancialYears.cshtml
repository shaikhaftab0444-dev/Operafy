@model IEnumerable<ERP_System.Models.FinancialYear>
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Financial Years Master";
}

<div class="container-fluid py-4 text-start">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-bold mb-1"><i class="fa-solid fa-calendar-check text-primary me-2"></i>Financial Years Master</h4>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0 small">
                    <li class="breadcrumb-item"><a href="/SuperAdminDashboard" class="text-decoration-none">Dashboard</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Financial Years</li>
                </ol>
            </nav>
        </div>
        <button class="btn btn-primary rounded-pill px-3 btn-sm shadow-sm" data-bs-toggle="modal" data-bs-target="#yearModal">
            <i class="fa-solid fa-plus me-1.5"></i>Add Year
        </button>
    </div>

    <!-- Years Grid -->
    <div class="bg-white border rounded-3 p-4 shadow-sm" style="max-width: 800px;">
        <h5 class="fw-bold mb-3">Calendar Periods</h5>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" style="font-size: 0.85rem;">
                <thead class="table-light">
                    <tr>
                        <th>Year Name</th>
                        <th>Start Date</th>
                        <th>End Date</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var y in Model)
                        {
                            <tr>
                                <td class="fw-bold text-dark">@y.YearName</td>
                                <td>@y.StartDate.ToString("dd MMM yyyy")</td>
                                <td>@y.EndDate.ToString("dd MMM yyyy")</td>
                                <td>
                                    @if (y.IsActive)
                                    {
                                        <span class="badge bg-success-subtle text-success rounded-pill px-2.5">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger-subtle text-danger rounded-pill px-2.5">Inactive</span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Year Modal -->
<div class="modal fade text-start" id="yearModal" tabindex="-1" aria-labelledby="yearModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form action="/SuperAdminOrg/CreateFinancialYear" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title fw-bold" id="yearModalLabel">Add Financial Year</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Year Name (e.g. FY 2026-27)</label>
                        <input type="text" name="YearName" class="form-control" placeholder="e.g. FY 2026-27" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Start Date</label>
                        <input type="date" name="StartDate" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">End Date</label>
                        <input type="date" name="EndDate" class="form-control" required />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary rounded-pill px-3 btn-sm" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary rounded-pill px-3 btn-sm">Save Year</button>
                </div>
            </form>
        </div>
    </div>
</div>

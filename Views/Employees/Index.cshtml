@model IEnumerable<ERP_System.Models.User>
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Employee Directory Registry";
    var roles = (IEnumerable<ERP_System.Models.Role>)ViewBag.Roles;
}

<style>
    .panel-employees {
        background: #ffffff;
        border: 1px solid var(--border-warm);
        border-radius: 12px;
        box-shadow: 0 1px 3px rgba(45,37,30,0.03);
    }
    
    .table-employees th {
        background-color: #fcfbfa !important;
        font-size: 0.75rem;
        text-transform: uppercase;
        font-weight: 700;
        color: #7c7267;
        border-bottom: 1px solid var(--border-warm);
        padding: 1rem 1.25rem;
    }
    
    .table-employees td {
        font-size: 0.875rem;
        color: var(--text-color);
        border-bottom: 1px solid var(--border-warm);
        padding: 1rem 1.25rem;
        vertical-align: middle;
    }

    .badge-active {
        background-color: rgba(16, 185, 129, 0.08);
        color: #10b981;
        font-weight: 600;
        border: 1px solid rgba(16, 185, 129, 0.2);
    }
    .badge-inactive {
        background-color: rgba(239, 68, 68, 0.08);
        color: #ef4444;
        font-weight: 600;
        border: 1px solid rgba(239, 68, 68, 0.2);
    }

    .select-role-warm {
        font-size: 0.8rem;
        font-weight: 600;
        border: 1px solid var(--border-warm);
        border-radius: 6px;
        padding: 0.35rem 0.5rem;
        background-color: #faf8f5;
        color: var(--text-color);
        cursor: pointer;
    }

    .btn-action-warm {
        border: 1px solid var(--border-warm);
        background-color: #ffffff;
        color: var(--text-color);
        font-size: 0.8rem;
        font-weight: 600;
        transition: all 0.2s;
    }
    .btn-action-warm:hover {
        background-color: #faf8f5;
        border-color: #cbd5e1;
        color: var(--primary-warm);
    }
</style>

<!-- Top Breadcrumbs & Page Header -->
<div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-3 mb-4">
    <div>
        <h4 class="fw-bold mb-1" style="color: var(--text-color);">Employee Management</h4>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0 small">
                <li class="breadcrumb-item"><a href="/Dashboard" class="text-decoration-none">Dashboard</a></li>
                <li class="breadcrumb-item active" aria-current="page">Employee Directory</li>
            </ol>
        </nav>
    </div>
    
    <a href="/Users/Create" class="btn btn-primary-warm px-4 py-2">
        <i class="fa-solid fa-user-plus me-2"></i> Register New Staff
    </a>
</div>

<!-- Alerts -->
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success border-0 shadow-sm alert-dismissible fade show mb-4 small text-start" role="alert" style="background-color: #f0fdf4; color: #15803d; border-left: 4px solid #16a34a !important;">
        <i class="fa-solid fa-circle-check me-2"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger border-0 shadow-sm alert-dismissible fade show mb-4 small text-start" role="alert" style="background-color: #fef2f2; color: #b91c1c; border-left: 4px solid #dc2626 !important;">
        <i class="fa-solid fa-circle-xmark me-2"></i> @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Employees Directory -->
<div class="panel-employees overflow-hidden">
    <div class="table-responsive">
        <table class="table table-hover table-employees mb-0 border-0 text-start">
            <thead>
                <tr>
                    <th class="border-0">Code</th>
                    <th class="border-0">Staff Name</th>
                    <th class="border-0">Email</th>
                    <th class="border-0">Mobile</th>
                    <th class="border-0">Authority Role</th>
                    <th class="border-0 text-center">Status</th>
                    <th class="border-0 text-center">Action</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var emp in Model)
                    {
                        var isRootAdmin = emp.UserId == 1;
                        <tr>
                            <td class="fw-bold text-secondary">@emp.UserCode</td>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <div class="avatar-sm rounded-circle d-flex align-items-center justify-content-center fw-bold" style="width: 28px; height: 28px; background-color: #faf6f0; color: var(--primary-warm); font-size: 0.75rem; border: 1.5px solid var(--primary-warm);">
                                        @emp.FullName.Substring(0,1).ToUpper()
                                    </div>
                                    <span class="fw-bold text-dark">@emp.FullName</span>
                                </div>
                            </td>
                            <td>@emp.Email</td>
                            <td>@(string.IsNullOrEmpty(emp.MobileNumber) ? "N/A" : emp.MobileNumber)</td>
                            <td>
                                @if (!isRootAdmin)
                                {
                                    <form asp-action="UpdateRole" method="post" style="display:inline-flex; align-items:center; gap:8px;">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="userId" value="@emp.UserId" />
                                        <select name="roleId" class="select-role-warm" onchange="this.form.submit()">
                                            @foreach (var role in roles)
                                            {
                                                <!option value="@role.RoleId" @(emp.RoleId == role.RoleId ? "selected" : "")>@role.RoleName</!option>
                                            }
                                        </select>
                                    </form>
                                }
                                else
                                {
                                    <span class="badge bg-light text-dark border px-2 py-1fw-bold" style="font-size:0.75rem;">Root Super Admin</span>
                                }
                            </td>
                            <td class="text-center">
                                @if (emp.IsActive)
                                {
                                    <span class="badge rounded-pill px-2.5 py-1.5 badge-active" style="font-size: 0.75rem;">Active</span>
                                }
                                else
                                {
                                    <span class="badge rounded-pill px-2.5 py-1.5 badge-inactive" style="font-size: 0.75rem;">Inactive</span>
                                }
                            </td>
                            <td class="text-center">
                                @if (!isRootAdmin)
                                {
                                    <form asp-action="ToggleActive" asp-route-id="@emp.UserId" method="post" style="display:inline;">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-action-warm px-3 py-1 rounded">
                                            @if (emp.IsActive)
                                            {
                                                <i class="fa-solid fa-user-xmark me-1"></i><span>Deactivate</span>
                                            }
                                            else
                                            {
                                                <i class="fa-solid fa-user-check me-1"></i><span>Activate</span>
                                            }
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <span class="text-muted small italic">Protected</span>
                                }
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="text-center text-muted py-5">No staff records found in system.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@model ERP_System.Models.ManagerDashboardViewModel
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Team Directory - Operations Hub";
}

<style>
    .glass-panel {
        background: rgba(255, 255, 255, 0.85);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border: 1px solid rgba(226, 232, 240, 0.8);
        border-radius: 16px;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.025);
    }
    .member-card {
        background: #ffffff;
        border: 1px solid rgba(226, 232, 240, 0.8);
        border-radius: 16px;
        transition: all 0.3s ease;
    }
    .member-card:hover {
        transform: translateY(-3px);
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.04);
    }
    .avatar-large {
        width: 56px;
        height: 56px;
        border-radius: 50%;
        background-color: #f1f5f9;
        color: #475569;
        font-size: 1.25rem;
        font-weight: 700;
        display: flex;
        align-items: center;
        justify-content: center;
        border: 2px solid #e2e8f0;
    }
</style>

<div class="container-fluid py-4 text-start">
    
    <!-- Top Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1">
                    <li class="breadcrumb-item"><a href="/Manager" class="text-decoration-none">Manager Portal</a></li>
                    <li class="breadcrumb-item text-secondary">Team</li>
                    <li class="breadcrumb-item active" aria-current="page">Directory</li>
                </ol>
            </nav>
            <h4 class="fw-bold mb-1 text-dark"><i class="fa-solid fa-address-book text-primary me-2"></i>Team Directory</h4>
            <p class="text-secondary small mb-0">Monitor active member attendance shifts, assigned roles, and daily login punch details.</p>
        </div>
    </div>

    <!-- Team Members Grid Layout -->
    <div class="row g-3">
        @foreach (var m in Model.TeamAttendance)
        {
            var badgeClass = m.Status == "Present" ? "bg-success-subtle text-success" : (m.Status == "Late" ? "bg-warning-subtle text-warning" : "bg-danger-subtle text-danger");
            
            <div class="col-md-4">
                <div class="member-card p-4 shadow-sm text-center">
                    <div class="d-flex justify-content-center mb-3">
                        <div class="avatar-large font-monospace">
                            @m.Avatar
                        </div>
                    </div>
                    
                    <h5 class="fw-bold text-dark mb-1">@m.Name</h5>
                    <p class="text-secondary small mb-2">@m.Role</p>
                    
                    <div class="d-flex justify-content-center gap-2 mb-3">
                        <span class="badge @badgeClass border px-2.5 py-1" style="font-size: 0.75rem;">@m.Status</span>
                    </div>

                    <hr class="my-3">

                    <div class="row g-2 small text-secondary">
                        <div class="col-6 text-start">Clock In Time:</div>
                        <div class="col-6 text-end fw-bold text-dark">@m.ClockInTime</div>
                        
                        <div class="col-6 text-start">Department Tasks:</div>
                        <div class="col-6 text-end fw-bold text-primary">@Model.TeamTasks.Count(t => t.AssignedTo == m.Name) Active</div>
                    </div>
                </div>
            </div>
        }
    </div>

</div>

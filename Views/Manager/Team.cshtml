@model ERP_System.Models.ManagerDashboardViewModel
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Team Directory - Operations Hub";
}

<style>
    /* =========================================
           TEAM DIRECTORY - PREMIUM ERP DESIGN
        ========================================= */

    .team-directory-page {
        position: relative;
        overflow: hidden;
        padding-bottom: 2rem;
    }

    /* ---------- Page Animation ---------- */
    .team-animate-up {
        opacity: 0;
        animation: teamFadeUp .7s ease forwards;
    }

    .team-delay-1 {
        animation-delay: .1s;
    }

    .team-delay-2 {
        animation-delay: .2s;
    }

    .team-delay-3 {
        animation-delay: .3s;
    }

    @@keyframes teamFadeUp {
        from {
            opacity: 0;
            transform: translateY(22px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* ---------- Hero Section ---------- */
    .team-directory-hero {
        position: relative;
        overflow: hidden;
        padding: 1.8rem 2rem;
        border-radius: 22px;
        background: linear-gradient(135deg, #ffffff 0%, #f7f9ff 55%, #eef3ff 100%);
        border: 1px solid #e6eaf2;
        box-shadow: 0 12px 35px rgba(15, 23, 42, .06);
    }

        .team-directory-hero::before {
            content: "";
            position: absolute;
            width: 240px;
            height: 240px;
            border-radius: 50%;
            background: rgba(13, 110, 253, .07);
            top: -130px;
            right: -70px;
            animation: heroFloat 7s ease-in-out infinite;
        }

        .team-directory-hero::after {
            content: "";
            position: absolute;
            width: 150px;
            height: 150px;
            border-radius: 50%;
            background: rgba(13, 110, 253, .04);
            bottom: -85px;
            left: 35%;
            animation: heroFloat 9s ease-in-out infinite reverse;
        }

    @@keyframes heroFloat {
        0%, 100% {
            transform: translateY(0) scale(1);
        }

        50% {
            transform: translateY(-12px) scale(1.04);
        }
    }

    .team-directory-content {
        position: relative;
        z-index: 2;
    }

    .team-breadcrumb {
        margin-bottom: .75rem;
    }

        .team-breadcrumb .breadcrumb {
            margin-bottom: 0;
        }

        .team-breadcrumb .breadcrumb-item {
            font-size: .8rem;
            color: #64748b;
        }

            .team-breadcrumb .breadcrumb-item a {
                color: #64748b;
                transition: color .2s ease;
            }

                .team-breadcrumb .breadcrumb-item a:hover {
                    color: #0d6efd;
                }

    .team-title-row {
        display: flex;
        align-items: center;
        gap: 1rem;
    }

    .team-title-icon {
        width: 52px;
        height: 52px;
        min-width: 52px;
        border-radius: 16px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.25rem;
        color: #fff;
        background: linear-gradient(135deg, #0d6efd, #4f8cff);
        box-shadow: 0 8px 20px rgba(13, 110, 253, .2);
        animation: iconPulse 3s ease-in-out infinite;
    }

    @@keyframes iconPulse {
        0%, 100% {
            transform: scale(1);
        }

        50% {
            transform: scale(1.05);
        }
    }

    .team-directory-title {
        font-size: 1.55rem;
        font-weight: 800;
        color: #1e293b;
        margin-bottom: .3rem;
        letter-spacing: -.02em;
    }

    .team-directory-subtitle {
        margin-bottom: 0;
        color: #64748b;
        font-size: .88rem;
        max-width: 700px;
        line-height: 1.6;
    }

    /* ---------- Team Count ---------- */
    .team-member-counter {
        min-width: 145px;
        padding: 1rem 1.15rem;
        text-align: center;
        border-radius: 16px;
        background: rgba(255, 255, 255, .85);
        border: 1px solid #e7edf5;
        box-shadow: 0 8px 20px rgba(15, 23, 42, .04);
    }

        .team-member-counter .counter-number {
            display: block;
            font-size: 1.6rem;
            font-weight: 800;
            color: #0d6efd;
            line-height: 1.1;
        }

        .team-member-counter .counter-label {
            display: block;
            margin-top: .25rem;
            font-size: .72rem;
            font-weight: 700;
            color: #64748b;
            text-transform: uppercase;
            letter-spacing: .05em;
        }

    /* ---------- Summary Bar ---------- */
    .team-summary-bar {
        display: flex;
        flex-wrap: wrap;
        gap: .75rem;
        padding: .85rem 1rem;
        background: #ffffff;
        border: 1px solid #e8edf4;
        border-radius: 16px;
        box-shadow: 0 6px 22px rgba(15, 23, 42, .035);
    }

    .team-summary-item {
        display: flex;
        align-items: center;
        gap: .6rem;
        padding: .55rem .85rem;
        border-radius: 12px;
        background: #f8fafc;
        border: 1px solid #eef2f6;
        font-size: .78rem;
        color: #64748b;
        transition: all .25s ease;
    }

        .team-summary-item:hover {
            transform: translateY(-2px);
            background: #fff;
            box-shadow: 0 6px 15px rgba(15, 23, 42, .06);
        }

    .team-summary-icon {
        width: 34px;
        height: 34px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

        .team-summary-icon.total {
            color: #0d6efd;
            background: rgba(13, 110, 253, .1);
        }

        .team-summary-icon.present {
            color: #198754;
            background: rgba(25, 135, 84, .1);
        }

        .team-summary-icon.late {
            color: #d39e00;
            background: rgba(255, 193, 7, .13);
        }

        .team-summary-icon.absent {
            color: #dc3545;
            background: rgba(220, 53, 69, .1);
        }

    .team-summary-value {
        font-weight: 800;
        color: #1e293b;
        font-size: .92rem;
    }

    .team-summary-text {
        font-size: .72rem;
        color: #64748b;
    }

    /* =========================================
           TEAM MEMBER CARD
        ========================================= */

    .team-member-card {
        position: relative;
        height: 100%;
        overflow: hidden;
        padding: 1.45rem;
        background: #fff;
        border: 1px solid #e7edf4;
        border-radius: 20px;
        box-shadow: 0 8px 28px rgba(15, 23, 42, .045);
        transition: transform .35s ease, box-shadow .35s ease, border-color .35s ease;
    }

        .team-member-card::before {
            content: "";
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 3px;
            background: linear-gradient(90deg, #0d6efd, #7aa7ff);
            transform: scaleX(0);
            transform-origin: left;
            transition: transform .35s ease;
        }

        .team-member-card:hover {
            transform: translateY(-7px);
            border-color: rgba(13, 110, 253, .22);
            box-shadow: 0 18px 38px rgba(15, 23, 42, .1);
        }

            .team-member-card:hover::before {
                transform: scaleX(1);
            }

            .team-member-card:hover .team-avatar {
                transform: scale(1.06) rotate(3deg);
                box-shadow: 0 10px 25px rgba(13, 110, 253, .2);
            }

    /* ---------- Member Header ---------- */

    .team-card-top {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: .75rem;
        margin-bottom: 1.2rem;
    }

    .team-avatar-wrapper {
        position: relative;
        display: inline-flex;
    }

    .team-avatar {
        width: 58px;
        height: 58px;
        border-radius: 18px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(135deg, #e8f0ff, #f7f9ff);
        border: 1px solid #dbe7ff;
        color: #0d6efd;
        font-size: 1.2rem;
        font-weight: 800;
        transition: all .35s ease;
    }

    .team-avatar-online-dot {
        position: absolute;
        right: -2px;
        bottom: -2px;
        width: 15px;
        height: 15px;
        border-radius: 50%;
        background: #198754;
        border: 3px solid #fff;
        box-shadow: 0 0 0 2px rgba(25, 135, 84, .1);
    }

    .team-member-info {
        flex: 1;
        min-width: 0;
    }

    .team-member-name {
        margin: 0 0 .2rem;
        color: #1e293b;
        font-size: 1rem;
        font-weight: 800;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .team-member-role {
        margin: 0;
        color: #64748b;
        font-size: .76rem;
        font-weight: 600;
    }

    /* ---------- Status ---------- */

    .team-status {
        display: inline-flex;
        align-items: center;
        gap: .35rem;
        padding: .38rem .7rem;
        border-radius: 50px;
        font-size: .7rem;
        font-weight: 700;
        white-space: nowrap;
    }

    .team-status-present {
        color: #198754;
        background: rgba(25, 135, 84, .1);
        border: 1px solid rgba(25, 135, 84, .16);
    }

    .team-status-late {
        color: #b77900;
        background: rgba(255, 193, 7, .13);
        border: 1px solid rgba(255, 193, 7, .2);
    }

    .team-status-absent {
        color: #dc3545;
        background: rgba(220, 53, 69, .09);
        border: 1px solid rgba(220, 53, 69, .15);
    }

    .team-status-default {
        color: #64748b;
        background: #f1f5f9;
        border: 1px solid #e2e8f0;
    }

    .team-status-dot {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: currentColor;
        animation: statusBlink 2s infinite;
    }

    @@keyframes statusBlink {
        0%, 100% {
            opacity: 1;
        }

        50% {
            opacity: .45;
        }
    }

    /* ---------- Divider ---------- */

    .team-card-divider {
        height: 1px;
        margin: 1rem 0;
        background: linear-gradient(90deg, transparent, #e5eaf1, transparent);
    }

    /* ---------- Information Cards ---------- */

    .team-info-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: .65rem;
    }

    .team-info-box {
        padding: .8rem;
        border-radius: 13px;
        background: #f8fafc;
        border: 1px solid #eef2f6;
        transition: all .25s ease;
    }

        .team-info-box:hover {
            background: #fff;
            border-color: #e1e9f4;
        }

    .team-info-label {
        display: flex;
        align-items: center;
        gap: .35rem;
        margin-bottom: .35rem;
        color: #94a3b8;
        font-size: .66rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .035em;
    }

        .team-info-label i {
            color: #0d6efd;
        }

    .team-info-value {
        color: #1e293b;
        font-size: .78rem;
        font-weight: 800;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .team-task-value {
        color: #0d6efd;
    }

    /* ---------- Card Footer ---------- */

    .team-card-footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: .5rem;
        margin-top: 1rem;
        padding-top: .9rem;
        border-top: 1px dashed #e5eaf1;
    }

    .team-footer-text {
        color: #94a3b8;
        font-size: .68rem;
        font-weight: 600;
    }

    .team-member-tag {
        display: inline-flex;
        align-items: center;
        gap: .35rem;
        color: #64748b;
        font-size: .68rem;
        font-weight: 700;
    }

        .team-member-tag i {
            color: #0d6efd;
        }

    /* =========================================
           EMPTY STATE
        ========================================= */

    .team-empty-state {
        padding: 4rem 1.5rem;
        text-align: center;
        background: #fff;
        border: 1px dashed #d8e0eb;
        border-radius: 20px;
        box-shadow: 0 8px 25px rgba(15, 23, 42, .035);
    }

    .team-empty-icon {
        width: 76px;
        height: 76px;
        margin: 0 auto 1rem;
        border-radius: 22px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #0d6efd;
        background: #f0f5ff;
        font-size: 1.8rem;
    }

    .team-empty-state h5 {
        color: #1e293b;
        font-weight: 800;
    }

    .team-empty-state p {
        color: #64748b;
        font-size: .85rem;
        margin-bottom: 0;
    }

    /* =========================================
           RESPONSIVE
        ========================================= */

    @@media (max-width: 991.98px) {
        .team-directory-hero {
            padding: 1.5rem;
        }

        .team-directory-title {
            font-size: 1.35rem;
        }

        .team-member-counter {
            margin-top: 1rem;
        }
    }

    @@media (max-width: 767.98px) {
        .team-directory-page {
            padding-top: .5rem;
        }

        .team-directory-hero {
            padding: 1.25rem;
            border-radius: 18px;
        }

        .team-title-row {
            align-items: flex-start;
        }

        .team-title-icon {
            width: 46px;
            height: 46px;
            min-width: 46px;
            border-radius: 14px;
        }

        .team-directory-title {
            font-size: 1.2rem;
        }

        .team-directory-subtitle {
            font-size: .8rem;
        }

        .team-member-counter {
            width: 100%;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: .5rem;
        }

            .team-member-counter .counter-number,
            .team-member-counter .counter-label {
                display: inline;
                margin: 0;
            }

        .team-summary-bar {
            gap: .5rem;
        }

        .team-summary-item {
            flex: 1 1 calc(50% - .5rem);
            min-width: 135px;
        }

        .team-member-card {
            padding: 1.2rem;
            border-radius: 17px;
        }
    }

    @@media (max-width: 575.98px) {
        .team-directory-hero {
            padding: 1rem;
        }

        .team-title-icon {
            width: 42px;
            height: 42px;
            min-width: 42px;
            font-size: 1rem;
        }

        .team-directory-title {
            font-size: 1.08rem;
        }

        .team-summary-item {
            flex: 1 1 100%;
        }

        .team-info-grid {
            gap: .5rem;
        }

        .team-card-top {
            align-items: center;
        }

        .team-avatar {
            width: 52px;
            height: 52px;
            border-radius: 16px;
        }

        .team-status {
            padding: .32rem .55rem;
            font-size: .65rem;
        }
    }

    /* =========================================
           PRINT
        ========================================= */

    @@media print {
        .team-directory-page {
            padding: 0 !important;
        }

        .team-directory-hero {
            box-shadow: none;
            border: 1px solid #ddd;
        }

        .team-member-card {
            box-shadow: none;
            break-inside: avoid;
        }

            .team-member-card:hover {
                transform: none;
            }
    }
</style>

<div class="container-fluid py-4 text-start team-directory-page">

    ```
    <!-- =========================================
         HEADER
    ========================================= -->
    <div class="team-directory-hero team-animate-up">

        <div class="team-directory-content">

            <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3">

                <div>

                    <div class="team-breadcrumb">
                        <nav aria-label="breadcrumb">
                            <ol class="breadcrumb">
                                <li class="breadcrumb-item">
                                    <a href="/Manager" class="text-decoration-none">
                                        <i class="fa-solid fa-gauge-high me-1"></i>Manager Portal
                                    </a>
                                </li>
                                <li class="breadcrumb-item text-secondary">Team</li>
                                <li class="breadcrumb-item active" aria-current="page">Directory</li>
                            </ol>
                        </nav>
                    </div>

                    <div class="team-title-row">

                        <div class="team-title-icon">
                            <i class="fa-solid fa-address-book"></i>
                        </div>

                        <div>
                            <h4 class="team-directory-title">Team Directory</h4>

                            <p class="team-directory-subtitle">
                                Monitor your team members, attendance status, assigned roles, clock-in activity,
                                and current department workload from one centralized workspace.
                            </p>
                        </div>

                    </div>

                </div>

                <div class="team-member-counter">
                    <span class="counter-number">@Model.TeamAttendance.Count()</span>
                    <span class="counter-label">Team Members</span>
                </div>

            </div>

        </div>

    </div>

    <!-- =========================================
         TEAM SUMMARY
    ========================================= -->
    <div class="team-summary-bar mt-4 team-animate-up team-delay-1">

        <div class="team-summary-item">

            <div class="team-summary-icon total">
                <i class="fa-solid fa-users"></i>
            </div>

            <div>
                <div class="team-summary-value">@Model.TeamAttendance.Count()</div>
                <div class="team-summary-text">Total Members</div>
            </div>

        </div>

        <div class="team-summary-item">

            <div class="team-summary-icon present">
                <i class="fa-solid fa-user-check"></i>
            </div>

            <div>
                <div class="team-summary-value">@Model.TeamAttendance.Count(x => x.Status == "Present")</div>
                <div class="team-summary-text">Present Today</div>
            </div>

        </div>

        <div class="team-summary-item">

            <div class="team-summary-icon late">
                <i class="fa-solid fa-clock"></i>
            </div>

            <div>
                <div class="team-summary-value">@Model.TeamAttendance.Count(x => x.Status == "Late")</div>
                <div class="team-summary-text">Late Check-ins</div>
            </div>

        </div>

        <div class="team-summary-item">

            <div class="team-summary-icon absent">
                <i class="fa-solid fa-user-xmark"></i>
            </div>

            <div>
                <div class="team-summary-value">@Model.TeamAttendance.Count(x => x.Status != "Present" && x.Status != "Late")</div>
                <div class="team-summary-text">Unavailable</div>
            </div>

        </div>

    </div>

    <!-- =========================================
         TEAM MEMBERS
    ========================================= -->
    <div class="row g-4 mt-1">

        @if (Model.TeamAttendance != null && Model.TeamAttendance.Any())
        {
            var cardIndex = 0;

            @foreach (var m in Model.TeamAttendance)
            {
                cardIndex++;

                string statusClass = m.Status switch
                {
                    "Present" => "team-status-present",
                    "Late" => "team-status-late",
                    "Absent" => "team-status-absent",
                    _ => "team-status-default"
                };

                var activeTasks = Model.TeamTasks.Count(t => t.AssignedTo == m.Name);

                <div class="col-xl-4 col-lg-4 col-md-6 team-animate-up"
                     style="animation-delay:@(Math.Min(cardIndex * 0.07, 0.6))s">

                    <div class="team-member-card">

                        <!-- Member Header -->
                        <div class="team-card-top">

                            <div class="d-flex align-items-center gap-3 flex-grow-1">

                                <div class="team-avatar-wrapper">

                                    <div class="team-avatar">
                                        @m.Avatar
                                    </div>

                                    @if (m.Status == "Present" || m.Status == "Late")
                                    {
                                        <span class="team-avatar-online-dot"></span>
                                    }

                                </div>

                                <div class="team-member-info">
                                    <h5 class="team-member-name" title="@m.Name">@m.Name</h5>
                                    <p class="team-member-role">@m.Role @(!string.IsNullOrWhiteSpace(m.Department) ? $"• {m.Department}" : "")</p>
                                </div>

                            </div>

                            <span class="team-status @statusClass">
                                <span class="team-status-dot"></span>
                                @m.Status
                            </span>

                        </div>

                        <div class="team-card-divider"></div>

                        <!-- Member Information -->
                        <div class="team-info-grid">

                            <div class="team-info-box">

                                <div class="team-info-label">
                                    <i class="fa-solid fa-right-to-bracket"></i>
                                    Clock In
                                </div>

                                <div class="team-info-value">
                                    @m.ClockInTime
                                </div>

                            </div>

                            <div class="team-info-box">

                                <div class="team-info-label">
                                    <i class="fa-solid fa-list-check"></i>
                                    Active Tasks
                                </div>

                                <div class="team-info-value team-task-value">
                                    @activeTasks Task@(activeTasks == 1 ? "" : "s")
                                </div>

                            </div>

                        </div>

                        <!-- Footer -->
                        <div class="team-card-footer">

                            <div class="team-member-tag">
                                <i class="fa-solid fa-user-shield"></i>
                                Team Member
                            </div>

                            <div class="team-footer-text">
                                <i class="fa-solid fa-chart-line me-1"></i>
                                Operations Hub
                            </div>

                        </div>

                    </div>

                </div>
            }
        }
        else
        {
            <div class="col-12">

                <div class="team-empty-state team-animate-up">

                    <div class="team-empty-icon">
                        <i class="fa-solid fa-users"></i>
                    </div>

                    <h5>No Team Members Found</h5>

                    <p>
                        There are currently no team attendance records available in your directory.
                    </p>

                </div>

            </div>
        }

    </div>
   

</div>
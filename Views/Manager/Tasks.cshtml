@model ERP_System.Models.TaskDelegationViewModel

@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Sprint Board & Task Delegation";
}

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" />
<script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>

<style>
    .sprint-page {
        --sprint-primary: #2563eb;
        --sprint-primary-dark: #1d4ed8;
        --sprint-dark: #172554;
        --sprint-text: #1e293b;
        --sprint-muted: #64748b;
        --sprint-border: #e2e8f0;
        --sprint-success: #16a34a;
        --sprint-warning: #f59e0b;
        --sprint-danger: #dc2626;
        color: var(--sprint-text);
    }

        .sprint-page * {
            box-sizing: border-box;
        }

    /* =========================
           PREMIUM HERO HEADER
        ========================= */

    .sprint-hero {
        position: relative;
        overflow: hidden;
        padding: 28px 30px;
        margin-bottom: 24px;
        border: 1px solid rgba(255, 255, 255, .65);
        border-radius: 22px;
        background: linear-gradient(135deg, rgba(255,255,255,.98), rgba(244,248,255,.98) 55%, rgba(238,244,255,.98)), radial-gradient(circle at top right, rgba(37,99,235,.08), transparent 45%);
        box-shadow: 0 10px 35px rgba(37, 99, 235, .08);
        animation: heroEntrance .7s ease both;
    }

        .sprint-hero::before,
        .sprint-hero::after {
            content: "";
            position: absolute;
            border-radius: 50%;
            pointer-events: none;
        }

        .sprint-hero::before {
            width: 220px;
            height: 220px;
            right: -80px;
            top: -120px;
            background: rgba(37, 99, 235, .08);
            animation: floatOrb 7s ease-in-out infinite;
        }

        .sprint-hero::after {
            width: 120px;
            height: 120px;
            right: 120px;
            bottom: -70px;
            background: rgba(96, 165, 250, .10);
            animation: floatOrb 8s ease-in-out infinite reverse;
        }

    .sprint-hero-content {
        position: relative;
        z-index: 2;
    }

    .hero-breadcrumb .breadcrumb {
        margin-bottom: 10px;
    }

    .hero-breadcrumb .breadcrumb-item,
    .hero-breadcrumb .breadcrumb-item a {
        font-size: .78rem;
    }

        .hero-breadcrumb .breadcrumb-item a {
            color: var(--sprint-primary);
            font-weight: 700;
        }

    .sprint-title-row {
        display: flex;
        align-items: center;
        gap: 16px;
    }

    .sprint-title-icon {
        width: 58px;
        height: 58px;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 18px;
        color: #fff;
        background: linear-gradient(135deg, #2563eb, #3b82f6);
        box-shadow: 0 10px 24px rgba(37, 99, 235, .25);
        font-size: 1.4rem;
        animation: iconPulse 3s ease-in-out infinite;
    }

    .sprint-title {
        margin: 0 0 4px;
        color: #172554;
        font-size: 1.55rem;
        font-weight: 800;
        letter-spacing: -.03em;
    }

    .sprint-subtitle {
        margin: 0;
        color: var(--sprint-muted);
        font-size: .88rem;
        line-height: 1.6;
        max-width: 720px;
    }

    .assign-task-btn {
        position: relative;
        z-index: 5;
        min-height: 48px;
        border: 0;
        border-radius: 14px;
        padding: 12px 22px;
        font-weight: 700;
        color: #fff;
        background: linear-gradient(135deg, #2563eb, #1d4ed8);
        box-shadow: 0 10px 20px rgba(37, 99, 235, .22);
        transition: all .25s ease;
        white-space: nowrap;
    }

        .assign-task-btn:hover {
            color: #fff;
            transform: translateY(-3px);
            box-shadow: 0 15px 28px rgba(37, 99, 235, .32);
        }

        .assign-task-btn:active {
            transform: translateY(-1px);
        }

    /* =========================
           STATISTICS
        ========================= */

    .stats-grid {
        margin-bottom: 24px;
    }

    .stat-card {
        position: relative;
        height: 100%;
        overflow: hidden;
        padding: 18px;
        border: 1px solid var(--sprint-border);
        border-radius: 18px;
        background: #fff;
        box-shadow: 0 5px 20px rgba(15, 23, 42, .035);
        transition: all .25s ease;
        animation: cardEntrance .65s ease both;
    }

        .stat-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 14px 28px rgba(15, 23, 42, .09);
        }

        .stat-card::after {
            content: "";
            position: absolute;
            left: 0;
            bottom: 0;
            width: 100%;
            height: 3px;
            opacity: .9;
        }

        .stat-card.all::after {
            background: #2563eb;
        }

        .stat-card.progress::after {
            background: #0ea5e9;
        }

        .stat-card.review::after {
            background: #f59e0b;
        }

        .stat-card.delayed::after {
            background: #ef4444;
        }

        .stat-card.completed::after {
            background: #16a34a;
        }

        .stat-card:nth-child(1) {
            animation-delay: .05s;
        }

        .stat-card:nth-child(2) {
            animation-delay: .10s;
        }

        .stat-card:nth-child(3) {
            animation-delay: .15s;
        }

        .stat-card:nth-child(4) {
            animation-delay: .20s;
        }

        .stat-card:nth-child(5) {
            animation-delay: .25s;
        }

    .stat-top {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
    }

    .stat-label {
        color: var(--sprint-muted);
        font-size: .76rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .04em;
    }

    .stat-number {
        margin-top: 8px;
        color: #172554;
        font-size: 1.55rem;
        font-weight: 800;
        line-height: 1;
    }

    .stat-icon {
        width: 42px;
        height: 42px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 13px;
        font-size: 1rem;
    }

        .stat-icon.all {
            background: #eff6ff;
            color: #2563eb;
        }

        .stat-icon.progress {
            background: #f0f9ff;
            color: #0284c7;
        }

        .stat-icon.review {
            background: #fffbeb;
            color: #d97706;
        }

        .stat-icon.delayed {
            background: #fef2f2;
            color: #dc2626;
        }

        .stat-icon.completed {
            background: #f0fdf4;
            color: #16a34a;
        }

    /* =========================
           PANELS
        ========================= */

    .sprint-panel {
        border: 1px solid var(--sprint-border);
        border-radius: 20px;
        background: #fff;
        box-shadow: 0 6px 25px rgba(15, 23, 42, .045);
        animation: fadeUp .7s ease both;
    }

    .filter-panel {
        padding: 18px;
        margin-bottom: 24px;
    }

    /* =========================
           SEARCH
        ========================= */

    .search-wrapper {
        position: relative;
    }

        .search-wrapper i {
            position: absolute;
            top: 50%;
            left: 16px;
            z-index: 2;
            color: #94a3b8;
            transform: translateY(-50%);
        }

    .task-search {
        height: 46px;
        padding-left: 44px;
        border: 1px solid #dbe4f0;
        border-radius: 14px;
        font-size: .85rem;
        background: #f8fafc;
        transition: all .25s ease;
    }

        .task-search:focus {
            border-color: #93c5fd;
            background: #fff;
            box-shadow: 0 0 0 .22rem rgba(37, 99, 235, .10);
        }

    /* =========================
           FILTER PILLS
        ========================= */

    .filter-pills {
        display: flex;
        flex-wrap: wrap;
        justify-content: flex-end;
        gap: 8px;
    }

    .filter-pill {
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 10px 14px;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        background: #fff;
        color: #64748b;
        font-size: .75rem;
        font-weight: 700;
        transition: all .2s ease;
        white-space: nowrap;
    }

        .filter-pill:hover {
            border-color: #93c5fd;
            color: #2563eb;
            transform: translateY(-2px);
            box-shadow: 0 7px 16px rgba(37, 99, 235, .08);
        }

        .filter-pill.active {
            border-color: #2563eb;
            color: #fff;
            background: linear-gradient(135deg, #2563eb, #1d4ed8);
            box-shadow: 0 8px 16px rgba(37, 99, 235, .20);
        }

    .filter-count {
        min-width: 20px;
        padding: 2px 7px;
        border-radius: 20px;
        text-align: center;
        background: rgba(148, 163, 184, .14);
        font-size: .68rem;
    }

    .filter-pill.active .filter-count {
        background: rgba(255, 255, 255, .18);
    }

    /* =========================
           TABLE
        ========================= */

    .table-panel {
        overflow: hidden;
    }

    .table-panel-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 15px;
        padding: 22px 24px;
        border-bottom: 1px solid #edf2f7;
    }

    .table-panel-title {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .table-panel-icon {
        width: 42px;
        height: 42px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 13px;
        color: #2563eb;
        background: #eff6ff;
    }

    .table-panel-title h6 {
        margin: 0;
        color: #172554;
        font-weight: 800;
    }

    .table-panel-title span {
        display: block;
        margin-top: 2px;
        color: #94a3b8;
        font-size: .74rem;
    }

    .live-indicator {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 8px 12px;
        border-radius: 30px;
        color: #16a34a;
        background: #f0fdf4;
        font-size: .72rem;
        font-weight: 700;
        white-space: nowrap;
    }

    .live-dot {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: #22c55e;
        animation: blink 1.8s infinite;
    }

    .sprint-table {
        width: 100%;
        margin: 0;
        font-size: .83rem;
    }

        .sprint-table thead th {
            padding: 15px 16px;
            border-bottom: 1px solid #e8eef5;
            color: #64748b;
            background: #f8fafc;
            font-size: .70rem;
            font-weight: 800;
            letter-spacing: .035em;
            text-transform: uppercase;
            white-space: nowrap;
        }

        .sprint-table tbody td {
            padding: 16px;
            vertical-align: middle;
            border-color: #edf2f7;
        }

        .sprint-table tbody tr {
            transition: all .2s ease;
            animation: rowEntrance .45s ease both;
        }

            .sprint-table tbody tr:hover {
                background: #fafcff;
                box-shadow: inset 3px 0 0 #2563eb;
            }

    .task-title {
        color: #1e293b;
        font-weight: 800;
        line-height: 1.35;
    }

    .task-description {
        max-width: 300px;
        margin-top: 4px;
        overflow: hidden;
        color: #94a3b8;
        font-size: .75rem;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .avatar-wrapper {
        width: 38px;
        height: 38px;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 13px;
        color: #fff;
        background: linear-gradient(135deg, #64748b, #475569);
        box-shadow: 0 6px 12px rgba(71, 85, 105, .15);
        font-size: .72rem;
        font-weight: 800;
    }

    .member-name {
        color: #1e293b;
        font-size: .82rem;
        font-weight: 800;
    }

    .member-email {
        display: block;
        max-width: 170px;
        margin-top: 2px;
        overflow: hidden;
        color: #94a3b8;
        font-size: .68rem;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .due-date {
        color: #475569;
        font-size: .79rem;
        font-weight: 700;
        white-space: nowrap;
    }

        .due-date i {
            color: #2563eb;
        }

    .priority-badge,
    .status-badge {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 7px 10px;
        border-radius: 9px;
        font-size: .68rem;
        font-weight: 800;
        white-space: nowrap;
    }

    .priority-urgent {
        color: #b91c1c;
        background: #fef2f2;
    }

    .priority-high {
        color: #b45309;
        background: #fffbeb;
    }

    .priority-medium {
        color: #0369a1;
        background: #f0f9ff;
    }

    .priority-low {
        color: #475569;
        background: #f1f5f9;
    }

    .status-progress {
        color: #0369a1;
        background: #f0f9ff;
    }

    .status-review {
        color: #a16207;
        background: #fffbeb;
    }

    .status-delayed {
        color: #b91c1c;
        background: #fef2f2;
    }

    .status-completed {
        color: #15803d;
        background: #f0fdf4;
    }

    .progress-cell {
        min-width: 145px;
    }

    .progress-top {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 7px;
    }

    .progress-label {
        color: #64748b;
        font-size: .69rem;
        font-weight: 700;
    }

    .progress-value {
        color: #2563eb;
        font-size: .72rem;
        font-weight: 800;
    }

    .progress {
        height: 7px !important;
        overflow: hidden;
        border-radius: 10px;
        background: #e8eef7;
    }

    .progress-bar {
        border-radius: 10px;
        background: linear-gradient(90deg, #2563eb, #60a5fa);
    }

    /* =========================
           ACTION BUTTONS
        ========================= */

    .action-btn {
        width: 34px;
        height: 34px;
        padding: 0;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 10px;
        transition: all .2s ease;
    }

        .action-btn.edit {
            border-color: #bfdbfe;
            color: #2563eb;
            background: #fff;
        }

            .action-btn.edit:hover {
                border-color: #2563eb;
                color: #fff;
                background: #2563eb;
                transform: translateY(-2px);
            }

        .action-btn.delete {
            border-color: #fecaca;
            color: #dc2626;
            background: #fff;
        }

            .action-btn.delete:hover {
                border-color: #dc2626;
                color: #fff;
                background: #dc2626;
                transform: translateY(-2px);
            }

    /* =========================
           EMPTY STATE
        ========================= */

    .empty-state {
        padding: 65px 20px !important;
    }

    .empty-state-icon {
        width: 75px;
        height: 75px;
        margin: 0 auto 16px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 24px;
        color: #2563eb;
        background: #eff6ff;
        font-size: 1.7rem;
    }

    .empty-state h6 {
        color: #334155;
        font-weight: 800;
    }

    .empty-state p {
        margin: 0;
        color: #94a3b8;
        font-size: .82rem;
    }

    /* =========================
           MODALS
        ========================= */

    .sprint-modal .modal-content {
        overflow: hidden;
        border: 0;
        border-radius: 22px;
        box-shadow: 0 25px 60px rgba(15, 23, 42, .20);
    }

    .sprint-modal-header {
        position: relative;
        padding: 24px 24px 18px;
        border-bottom: 1px solid #eef2f7;
        background: linear-gradient(135deg, #ffffff, #f8fbff);
    }

    .modal-title-wrap {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .modal-title-icon {
        width: 43px;
        height: 43px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 13px;
        color: #fff;
        background: linear-gradient(135deg, #2563eb, #3b82f6);
    }

    .modal-title-wrap h5,
    .modal-title-wrap h6 {
        margin: 0;
        color: #172554;
        font-weight: 800;
    }

    .modal-title-wrap span {
        display: block;
        margin-top: 2px;
        color: #94a3b8;
        font-size: .72rem;
    }

    .sprint-modal .modal-body {
        padding: 22px 24px;
    }

    .sprint-modal .form-label {
        margin-bottom: 7px;
        color: #475569;
        font-size: .75rem;
        font-weight: 800;
    }

    .sprint-modal .form-control,
    .sprint-modal .form-select {
        min-height: 45px;
        border: 1px solid #dbe4f0;
        border-radius: 12px;
        color: #334155;
        font-size: .84rem;
        background: #f8fafc;
        transition: all .2s ease;
    }

    .sprint-modal textarea.form-control {
        min-height: 100px;
        resize: vertical;
    }

    .sprint-modal .form-control:focus,
    .sprint-modal .form-select:focus {
        border-color: #93c5fd;
        background: #fff;
        box-shadow: 0 0 0 .22rem rgba(37, 99, 235, .10);
    }

    .sprint-modal .modal-footer {
        padding: 16px 24px 24px;
        border: 0;
    }

    .modal-submit-btn {
        border: 0;
        border-radius: 11px;
        padding: 10px 18px;
        font-weight: 700;
        color: #fff;
        background: linear-gradient(135deg, #2563eb, #1d4ed8);
        box-shadow: 0 8px 16px rgba(37, 99, 235, .20);
    }

        .modal-submit-btn:hover {
            color: #fff;
        }

    .progress-number {
        padding: 5px 10px;
        border-radius: 9px;
        color: #2563eb;
        background: #eff6ff;
        font-size: .78rem;
        font-weight: 800;
    }

    .form-range::-webkit-slider-thumb {
        background: #2563eb;
    }

    .form-range::-moz-range-thumb {
        background: #2563eb;
    }

    .task-row-new {
        animation: newTaskGlow 1.5s ease;
    }

    .task-row-removing {
        animation: removeTask .45s ease forwards;
    }

    /* =========================
           ANIMATIONS
        ========================= */

    @@keyframes heroEntrance {
        from {
            opacity: 0;
            transform: translateY(-12px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@keyframes cardEntrance {
        from {
            opacity: 0;
            transform: translateY(16px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@keyframes fadeUp {
        from {
            opacity: 0;
            transform: translateY(12px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@keyframes rowEntrance {
        from {
            opacity: 0;
            transform: translateX(-8px);
        }

        to {
            opacity: 1;
            transform: translateX(0);
        }
    }

    @@keyframes floatOrb {
        0%, 100% {
            transform: translate(0, 0);
        }

        50% {
            transform: translate(-14px, 18px);
        }
    }

    @@keyframes iconPulse {
        0%, 100% {
            transform: scale(1);
        }

        50% {
            transform: scale(1.04);
        }
    }

    @@keyframes blink {
        0%, 100% {
            opacity: 1;
            box-shadow: 0 0 0 0 rgba(34, 197, 94, .4);
        }

        50% {
            opacity: .5;
            box-shadow: 0 0 0 5px rgba(34, 197, 94, 0);
        }
    }

    @@keyframes newTaskGlow {
        0% {
            background: #dbeafe;
            transform: translateY(-5px);
        }

        100% {
            background: transparent;
            transform: translateY(0);
        }
    }

    @@keyframes removeTask {
        to {
            opacity: 0;
            transform: translateX(40px);
        }
    }

    /* =========================
           RESPONSIVE
        ========================= */

    @@media (max-width: 1199.98px) {
        .filter-pills {
            justify-content: flex-start;
            margin-top: 4px;
        }
    }

    @@media (max-width: 767.98px) {
        .sprint-page {
            padding-left: 0;
            padding-right: 0;
        }

        .sprint-hero {
            padding: 22px 18px;
            border-radius: 18px;
        }

        .sprint-title-row {
            align-items: flex-start;
        }

        .sprint-title-icon {
            width: 50px;
            height: 50px;
            border-radius: 15px;
            font-size: 1.2rem;
        }

        .sprint-title {
            font-size: 1.22rem;
        }

        .sprint-subtitle {
            font-size: .82rem;
        }

        .hero-action {
            width: 100%;
            margin-top: 18px;
        }

        .assign-task-btn {
            width: 100%;
        }

        .filter-panel {
            padding: 14px;
        }

        .filter-pill {
            padding: 8px 10px;
            font-size: .68rem;
        }

        .table-panel-header {
            align-items: flex-start;
            flex-direction: column;
            padding: 18px;
        }

        .live-indicator {
            align-self: flex-start;
        }

        .sprint-table {
            min-width: 1050px;
        }

        .task-description {
            max-width: 240px;
        }

        .stat-number {
            font-size: 1.35rem;
        }

        .sprint-modal .modal-body,
        .sprint-modal-header,
        .sprint-modal .modal-footer {
            padding-left: 18px;
            padding-right: 18px;
        }
    }

    @@media (max-width: 575.98px) {
        .sprint-title-row {
            gap: 12px;
        }

        .sprint-title-icon {
            width: 46px;
            height: 46px;
            min-width: 46px;
        }

        .sprint-title {
            font-size: 1.1rem;
        }

        .table-panel-title span {
            max-width: 250px;
        }
    }

    @@media (prefers-reduced-motion: reduce) {
        .sprint-page *,
        .sprint-page *::before,
        .sprint-page *::after {
            animation-duration: .01ms !important;
            animation-iteration-count: 1 !important;
            transition-duration: .01ms !important;
        }
    }
</style>

<div class="container-fluid py-4 text-start sprint-page">

@Html.AntiForgeryToken()

    <!-- Premium Header -->
    <div class="sprint-hero">
        <div class="sprint-hero-content">
            <div class="row align-items-center g-3">

                <div class="col-lg-8">
                    <div class="hero-breadcrumb">
                        <nav aria-label="breadcrumb">
                            <ol class="breadcrumb mb-1">
                                <li class="breadcrumb-item">
                                    <a href="/Manager" class="text-decoration-none">
                                        Manager Portal
                                    </a>
                                </li>
                                <li class="breadcrumb-item text-secondary">Tasks</li>
                                <li class="breadcrumb-item active" aria-current="page">
                                    Sprint Board
                                </li>
                            </ol>
                        </nav>
                    </div>

                    <div class="sprint-title-row">
                        <div class="sprint-title-icon">
                            <i class="fa-solid fa-list-check"></i>
                        </div>

                        <div>
                            <h4 class="sprint-title">
                                Task Delegation & Sprint Board
                            </h4>

                            <p class="sprint-subtitle">
                                Assign deliverables, monitor team progress, manage priorities and keep every sprint moving forward.
                            </p>
                        </div>
                    </div>
                </div>

                <div class="col-lg-4 text-lg-end hero-action">
                    <button type="button"
                            class="btn assign-task-btn"
                            data-bs-toggle="modal"
                            data-bs-target="#assignTaskModal">
                        <i class="fa-solid fa-plus me-2"></i>
                        Assign New Task
                    </button>
                </div>

            </div>
        </div>
    </div>

    <!-- Statistics Cards -->
    <div class="row g-3 stats-grid">

        <div class="col-xl col-lg-4 col-md-6">
            <div class="stat-card all">
                <div class="stat-top">
                    <div>
                        <div class="stat-label">Total Tasks</div>
                        <div class="stat-number" id="stat-total">
                            @Model.TotalTasksCount
                        </div>
                    </div>

                    <div class="stat-icon all">
                        <i class="fa-solid fa-list-check"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl col-lg-4 col-md-6">
            <div class="stat-card progress">
                <div class="stat-top">
                    <div>
                        <div class="stat-label">In Progress</div>
                        <div class="stat-number" id="stat-progress">
                            @Model.InProgressCount
                        </div>
                    </div>

                    <div class="stat-icon progress">
                        <i class="fa-solid fa-spinner"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl col-lg-4 col-md-6">
            <div class="stat-card review">
                <div class="stat-top">
                    <div>
                        <div class="stat-label">In Review</div>
                        <div class="stat-number" id="stat-review">
                            @Model.InReviewCount
                        </div>
                    </div>

                    <div class="stat-icon review">
                        <i class="fa-solid fa-magnifying-glass-chart"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl col-lg-6 col-md-6">
            <div class="stat-card delayed">
                <div class="stat-top">
                    <div>
                        <div class="stat-label">Delayed</div>
                        <div class="stat-number" id="stat-delayed">
                            @Model.DelayedCount
                        </div>
                    </div>

                    <div class="stat-icon delayed">
                        <i class="fa-solid fa-clock-rotate-left"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl col-lg-6 col-md-6">
            <div class="stat-card completed">
                <div class="stat-top">
                    <div>
                        <div class="stat-label">Completed</div>
                        <div class="stat-number" id="stat-completed">
                            @Model.CompletedCount
                        </div>
                    </div>

                    <div class="stat-icon completed">
                        <i class="fa-solid fa-circle-check"></i>
                    </div>
                </div>
            </div>
        </div>

    </div>

    <!-- Search & Filter Panel -->
    <div class="row g-3 my-3">
        <div class="col-12">
            <div class="card border-0 shadow-sm rounded-4 filter-panel bg-white">
                <div class="row g-3 align-items-center">
                    <div class="col-lg-5">
                        <div class="search-wrapper">
                            <i class="fa-solid fa-magnifying-glass"></i>
                            <input type="text" id="taskSearchInput" class="form-control task-search" placeholder="Search tasks by title, description or manager..." onkeyup="filterTasks()" />
                        </div>
                    </div>
                    <div class="col-lg-7">
                        <div class="filter-pills">
                            <div class="filter-pill active" data-filter="All" onclick="setStatusFilter('All', this)">
                                <span>All Tasks</span>
                                <span class="filter-count">@Model.TotalTasksCount</span>
                            </div>
                            <div class="filter-pill" data-filter="In Progress" onclick="setStatusFilter('In Progress', this)">
                                <span>In Progress</span>
                                <span class="filter-count">@Model.InProgressCount</span>
                            </div>
                            <div class="filter-pill" data-filter="Review" onclick="setStatusFilter('Review', this)">
                                <span>In Review</span>
                                <span class="filter-count">@Model.InReviewCount</span>
                            </div>
                            <div class="filter-pill" data-filter="Delayed" onclick="setStatusFilter('Delayed', this)">
                                <span>Delayed</span>
                                <span class="filter-count">@Model.DelayedCount</span>
                            </div>
                            <div class="filter-pill" data-filter="Completed" onclick="setStatusFilter('Completed', this)">
                                <span>Completed</span>
                                <span class="filter-count">@Model.CompletedCount</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Sprint Table Panel -->
    <div class="card border-0 shadow-sm rounded-4 table-panel bg-white mb-4">
        <div class="table-panel-header">
            <div class="table-panel-title">
                <div class="table-panel-icon">
                    <i class="fa-solid fa-diagram-project"></i>
                </div>
                <div>
                    <h6>Executive Deliverables & Sprint Delegations</h6>
                    <span>Active directives assigned to department managers</span>
                </div>
            </div>
            <div class="live-indicator">
                <span class="live-dot"></span>
                <span>Sprint Board</span>
            </div>
        </div>

        <div class="table-responsive">
            <table class="table sprint-table align-middle" id="tasksTable">
                <thead>
                    <tr>
                        <th style="width: 28%;">Task & Objective</th>
                        <th style="width: 20%;">Assigned Manager</th>
                        <th style="width: 12%;">Priority</th>
                        <th style="width: 14%;">Due Date</th>
                        <th style="width: 12%;">Status</th>
                        <th style="width: 14%;">Progress</th>
                        <th style="width: 10%;" class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody id="tasksTableBody">
                    @{
                        var taskList = Model.HierarchicalTasks ?? new List<ERP_System.Models.HierarchicalTask>();
                    }
                    @if (!taskList.Any())
                    {
                        <tr id="emptyTasksRow">
                            <td colspan="7" class="text-center empty-state">
                                <div class="empty-state-icon">
                                    <i class="fa-solid fa-list-check"></i>
                                </div>
                                <h6>No sprint tasks found</h6>
                                <p>You have not delegated any tasks to your subordinate managers yet.</p>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var task in taskList)
                        {
                            var priClass = task.Priority == "Urgent" ? "priority-urgent" : (task.Priority == "High" ? "priority-high" : (task.Priority == "Medium" ? "priority-medium" : "priority-low"));
                            var stClass = task.Status == "Completed" ? "status-completed" : (task.Status == "Delayed" ? "status-delayed" : ((task.Status == "Review" || task.Status == "In Review") ? "status-review" : "status-progress"));
                            var assignedName = task.AssignedTo?.FullName ?? "Department Manager";
                            var assignedDept = task.AssignedTo?.Department?.DepartmentName ?? task.AssignedTo?.DepartmentName ?? "Operations";
                            var initials = string.IsNullOrEmpty(assignedName) ? "MG" : (assignedName.Length >= 2 ? assignedName.Substring(0, 2).ToUpper() : assignedName.ToUpper());

                            <tr class="task-row" data-id="@task.Id" data-status="@task.Status" data-title="@(task.Title?.ToLower())" data-assigned="@assignedName.ToLower()">
                                <td>
                                    <div class="task-title">@task.Title</div>
                                    <div class="task-description">@task.Description</div>
                                </td>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="avatar-wrapper">@initials</div>
                                        <div>
                                            <span class="member-name">@assignedName</span>
                                            <span class="member-email">@assignedDept Head</span>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <span class="priority-badge @priClass">
                                        <i class="fa-solid fa-flag"></i> @task.Priority
                                    </span>
                                </td>
                                <td>
                                    <span class="due-date">
                                        <i class="fa-regular fa-calendar me-1"></i>
                                        @(task.DueDate.HasValue ? task.DueDate.Value.ToString("dd MMM yyyy") : "No Due Date")
                                    </span>
                                </td>
                                <td>
                                    <span class="status-badge @stClass" id="status-badge-@task.Id">
                                        <i class="fa-solid fa-circle-dot"></i> @task.Status
                                    </span>
                                </td>
                                <td>
                                    <div class="progress-cell">
                                        <div class="progress-top">
                                            <span class="progress-label">Completion</span>
                                            <span class="progress-value" id="progress-val-@task.Id">@task.ProgressPercentage%</span>
                                        </div>
                                        <div class="progress">
                                            <div class="progress-bar" id="progress-bar-@task.Id" style="width: @task.ProgressPercentage%;"></div>
                                        </div>
                                    </div>
                                </td>
                                <td class="text-end">
                                    <div class="d-inline-flex gap-1">
                                        <button type="button" class="btn action-btn edit" onclick="openEditModal(@task.Id, @task.ProgressPercentage, '@task.Status')" title="Update Progress">
                                            <i class="fa-solid fa-pen-to-square"></i>
                                        </button>
                                        <button type="button" class="btn action-btn delete" onclick="deleteTask(@task.Id)" title="Delete Task">
                                            <i class="fa-solid fa-trash-can"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

</div>

<!-- Assign New Task Modal -->
<div class="modal fade sprint-modal" id="assignTaskModal" tabindex="-1" aria-labelledby="assignTaskModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="sprint-modal-header">
                <div class="d-flex align-items-center justify-content-between">
                    <div class="modal-title-wrap">
                        <div class="modal-title-icon">
                            <i class="fa-solid fa-plus"></i>
                        </div>
                        <div>
                            <h5 id="assignTaskModalLabel">Delegate Task to Department Manager</h5>
                            <span>Assign executive directives and operational deliverables</span>
                        </div>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
            </div>

            <form id="assignTaskForm" onsubmit="submitAssignTask(event)">
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-12">
                            <label class="form-label">Task Title <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" name="title" id="newTaskTitle" placeholder="e.g., Complete Quarterly Audit Review" required />
                        </div>

                        <div class="col-12">
                            <label class="form-label">Description & Strategic Objectives</label>
                            <textarea class="form-control" name="description" id="newTaskDescription" rows="3" placeholder="Provide operational expectations, KPIs, or deliverables..."></textarea>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">Assign To Manager <span class="text-danger">*</span></label>
                            <select class="form-select" name="assignedToUserId" id="newTaskAssignedTo" required>
                                <option value="">-- Select Subordinate Manager --</option>
                                @{
                                    var subManagers = ViewBag.SubordinateManagers as IEnumerable<ERP_System.Models.User> ?? Enumerable.Empty<ERP_System.Models.User>();
                                }
                                @foreach (var sm in subManagers)
                                {
                                    var smDept = sm.Department?.DepartmentName ?? sm.DepartmentName ?? "Operations";
                                    <option value="@sm.UserId">@sm.FullName (@smDept Head)</option>
                                }
                            </select>
                        </div>

                        <div class="col-md-3">
                            <label class="form-label">Priority</label>
                            <select class="form-select" name="priority" id="newTaskPriority">
                                <option value="Low">Low</option>
                                <option value="Medium" selected>Medium</option>
                                <option value="High">High</option>
                                <option value="Urgent">Urgent</option>
                            </select>
                        </div>

                        <div class="col-md-3">
                            <label class="form-label">Due Date <span class="text-danger">*</span></label>
                            <input type="date" class="form-control" name="dueDate" id="newTaskDueDate" value="@DateTime.Today.AddDays(7).ToString("yyyy-MM-dd")" required />
                        </div>
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn modal-submit-btn" id="btnSubmitTask">
                        <i class="fa-solid fa-paper-plane me-1"></i> Delegate Task
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Edit Task Progress Modal -->
<div class="modal fade sprint-modal" id="editProgressModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="sprint-modal-header">
                <div class="d-flex align-items-center justify-content-between">
                    <div class="modal-title-wrap">
                        <div class="modal-title-icon" style="background: linear-gradient(135deg, #10b981, #059669);">
                            <i class="fa-solid fa-sliders"></i>
                        </div>
                        <div>
                            <h5>Update Task Progress</h5>
                            <span>Adjust completion percentage and current milestone status</span>
                        </div>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
            </div>

            <form id="editProgressForm" onsubmit="submitProgressUpdate(event)">
                <input type="hidden" id="editTaskId" />
                <div class="modal-body">
                    <div class="mb-4">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <label class="form-label mb-0">Progress Percentage</label>
                            <span class="progress-number" id="progressSliderVal">50%</span>
                        </div>
                        <input type="range" class="form-range" id="progressRangeInput" min="0" max="100" step="5" value="50" oninput="document.getElementById('progressSliderVal').textContent = this.value + '%'" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Task Status</label>
                        <select class="form-select" id="editTaskStatus">
                            <option value="In Progress">In Progress</option>
                            <option value="Review">In Review</option>
                            <option value="Delayed">Delayed</option>
                            <option value="Completed">Completed</option>
                        </select>
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn modal-submit-btn">Save Changes</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    let currentStatusFilter = 'All';

    function setStatusFilter(status, elem) {
        currentStatusFilter = status;
        document.querySelectorAll('.filter-pill').forEach(p => p.classList.remove('active'));
        if (elem) elem.classList.add('active');
        filterTasks();
    }

    function filterTasks() {
        const query = (document.getElementById('taskSearchInput')?.value || '').trim().toLowerCase();
        const rows = document.querySelectorAll('#tasksTableBody tr.task-row');
        let visibleCount = 0;

        rows.forEach(row => {
            const rowStatus = row.getAttribute('data-status') || '';
            const rowTitle = row.getAttribute('data-title') || '';
            const rowAssigned = row.getAttribute('data-assigned') || '';

            const matchesStatus = (currentStatusFilter === 'All') ||
                (currentStatusFilter === 'Review' && (rowStatus === 'Review' || rowStatus === 'In Review')) ||
                (rowStatus.toLowerCase() === currentStatusFilter.toLowerCase());

            const matchesSearch = query === '' || rowTitle.includes(query) || rowAssigned.includes(query);

            if (matchesStatus && matchesSearch) {
                row.style.display = '';
                visibleCount++;
            } else {
                row.style.display = 'none';
            }
        });

        const emptyRow = document.getElementById('emptyTasksRow');
        if (emptyRow) {
            emptyRow.style.display = visibleCount === 0 ? '' : 'none';
        }
    }

    function submitAssignTask(e) {
        e.preventDefault();
        const form = document.getElementById('assignTaskForm');
        const submitBtn = document.getElementById('btnSubmitTask');
        submitBtn.disabled = true;

        const data = {
            title: document.getElementById('newTaskTitle').value,
            description: document.getElementById('newTaskDescription').value,
            assignedToUserId: document.getElementById('newTaskAssignedTo').value,
            priority: document.getElementById('newTaskPriority').value,
            dueDate: document.getElementById('newTaskDueDate').value
        };

        $.ajax({
            url: '/Manager/AssignTask',
            type: 'POST',
            data: data,
            success: function (res) {
                submitBtn.disabled = false;
                if (res.success) {
                    if (typeof toastr !== 'undefined') toastr.success(res.message);
                    const modal = bootstrap.Modal.getInstance(document.getElementById('assignTaskModal'));
                    if (modal) modal.hide();
                    setTimeout(() => location.reload(), 600);
                } else {
                    if (typeof toastr !== 'undefined') toastr.error(res.message);
                }
            },
            error: function () {
                submitBtn.disabled = false;
                if (typeof toastr !== 'undefined') toastr.error('Failed to delegate task.');
            }
        });
    }

    function openEditModal(taskId, progress, status) {
        document.getElementById('editTaskId').value = taskId;
        document.getElementById('progressRangeInput').value = progress;
        document.getElementById('progressSliderVal').textContent = progress + '%';
        document.getElementById('editTaskStatus').value = (status === 'In Review') ? 'Review' : status;
        const modal = new bootstrap.Modal(document.getElementById('editProgressModal'));
        modal.show();
    }

    function submitProgressUpdate(e) {
        e.preventDefault();
        const taskId = document.getElementById('editTaskId').value;
        const progress = document.getElementById('progressRangeInput').value;
        const status = document.getElementById('editTaskStatus').value;

        $.ajax({
            url: '/Manager/UpdateTaskProgress',
            type: 'POST',
            data: { id: taskId, progress: progress, status: status },
            success: function (res) {
                if (res.success) {
                    if (typeof toastr !== 'undefined') toastr.success(res.message);
                    const modal = bootstrap.Modal.getInstance(document.getElementById('editProgressModal'));
                    if (modal) modal.hide();
                    setTimeout(() => location.reload(), 600);
                } else {
                    if (typeof toastr !== 'undefined') toastr.error(res.message);
                }
            },
            error: function () {
                if (typeof toastr !== 'undefined') toastr.error('Error updating task progress.');
            }
        });
    }

    function deleteTask(taskId) {
        if (typeof Swal !== 'undefined') {
            Swal.fire({
                title: 'Delete Task?',
                text: 'Are you sure you want to remove this delegated task?',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#dc2626',
                cancelButtonColor: '#64748b',
                confirmButtonText: 'Yes, Delete'
            }).then((result) => {
                if (result.isConfirmed) {
                    executeDeleteTask(taskId);
                }
            });
        } else {
            if (confirm('Delete this task?')) {
                executeDeleteTask(taskId);
            }
        }
    }

    function executeDeleteTask(taskId) {
        $.ajax({
            url: '/Manager/DeleteTask',
            type: 'POST',
            data: { id: taskId },
            success: function (res) {
                if (res.success) {
                    if (typeof toastr !== 'undefined') toastr.success(res.message);
                    const row = document.querySelector(`tr[data-id="${taskId}"]`);
                    if (row) {
                        row.classList.add('task-row-removing');
                        setTimeout(() => row.remove(), 450);
                    }
                } else {
                    if (typeof toastr !== 'undefined') toastr.error(res.message);
                }
            },
            error: function () {
                if (typeof toastr !== 'undefined') toastr.error('Failed to delete task.');
            }
        });
    }
</script>

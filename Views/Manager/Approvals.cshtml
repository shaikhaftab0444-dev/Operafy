@model IEnumerable<ERP_System.Models.LeaveRequest>
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Unified Approval Center";
    var activeCategory = ViewBag.ActiveCategory ?? "All";
}

<style>
    :root {
        --approval-primary: #2563eb;
        --approval-primary-dark: #1d4ed8;
        --approval-primary-soft: #eff6ff;
        --approval-success: #16a34a;
        --approval-success-soft: #f0fdf4;
        --approval-danger: #dc2626;
        --approval-danger-soft: #fef2f2;
        --approval-warning: #f59e0b;
        --approval-warning-soft: #fffbeb;
        --approval-dark: #172033;
        --approval-heading: #1e293b;
        --approval-text: #475569;
        --approval-muted: #94a3b8;
        --approval-border: #e2e8f0;
        --approval-border-soft: #eef2f7;
        --approval-bg: #f6f8fc;
        --approval-white: #ffffff;
        --approval-shadow: 0 12px 35px rgba(15, 23, 42, 0.055);
        --approval-shadow-hover: 0 18px 42px rgba(15, 23, 42, 0.09);
    }

    /* =========================================================
           PAGE
        ========================================================= */

    .approval-page {
        position: relative;
        min-height: calc(100vh - 80px);
        padding-top: 22px;
        padding-bottom: 40px;
        overflow: hidden;
        background: radial-gradient(circle at 96% 3%, rgba(37, 99, 235, 0.055), transparent 260px), radial-gradient(circle at 3% 82%, rgba(79, 70, 229, 0.035), transparent 250px);
    }

        .approval-page::before,
        .approval-page::after {
            content: "";
            position: absolute;
            border-radius: 50%;
            pointer-events: none;
            z-index: 0;
        }

        .approval-page::before {
            width: 330px;
            height: 330px;
            top: -180px;
            right: -130px;
            background: radial-gradient(circle, rgba(37, 99, 235, 0.09), transparent 70%);
            animation: approvalFloat 9s ease-in-out infinite;
        }

        .approval-page::after {
            width: 280px;
            height: 280px;
            bottom: -150px;
            left: -130px;
            background: radial-gradient(circle, rgba(79, 70, 229, 0.065), transparent 70%);
            animation: approvalFloat 11s ease-in-out infinite reverse;
        }

    .approval-page-content {
        position: relative;
        z-index: 1;
        max-width: 1700px;
        margin: 0 auto;
    }

    /* =========================================================
           HERO
        ========================================================= */

    .approval-hero {
        position: relative;
        overflow: hidden;
        margin-bottom: 20px;
        padding: 24px 28px;
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 24px;
        color: #fff;
        background: linear-gradient(135deg, #0f172a 0%, #172554 42%, #1d4ed8 76%, #2563eb 100%);
        box-shadow: 0 20px 50px rgba(15, 23, 42, 0.18), inset 0 1px 0 rgba(255, 255, 255, 0.08);
        animation: approvalSlideDown .65s ease both;
    }

        .approval-hero::before {
            content: "";
            position: absolute;
            width: 320px;
            height: 320px;
            top: -180px;
            right: 3%;
            border-radius: 50%;
            background: radial-gradient( circle, rgba(255,255,255,.12) 0%, rgba(255,255,255,.035) 48%, transparent 72% );
            animation: heroOrb 7s ease-in-out infinite;
        }

        .approval-hero::after {
            content: "";
            position: absolute;
            width: 180px;
            height: 180px;
            bottom: -125px;
            right: 30%;
            border-radius: 50%;
            background: rgba(96,165,250,.12);
            filter: blur(2px);
        }

    .approval-hero-grid {
        position: relative;
        z-index: 2;
    }

    .approval-breadcrumb {
        margin-bottom: 12px;
    }

        .approval-breadcrumb .breadcrumb {
            margin: 0;
        }

        .approval-breadcrumb .breadcrumb-item,
        .approval-breadcrumb .breadcrumb-item a {
            color: rgba(255,255,255,.62);
            font-size: .73rem;
            font-weight: 600;
        }

            .approval-breadcrumb .breadcrumb-item a {
                transition: color .2s ease;
            }

                .approval-breadcrumb .breadcrumb-item a:hover {
                    color: #fff;
                }

            .approval-breadcrumb .breadcrumb-item.active {
                color: rgba(255,255,255,.95);
            }

            .approval-breadcrumb .breadcrumb-item + .breadcrumb-item::before {
                color: rgba(255,255,255,.38);
            }

    .approval-title-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 24px;
    }

    .approval-title-left {
        display: flex;
        align-items: flex-start;
        gap: 15px;
        min-width: 0;
    }

    .approval-title-icon {
        width: 58px;
        height: 58px;
        flex: 0 0 58px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border: 1px solid rgba(255,255,255,.16);
        border-radius: 18px;
        color: #fff;
        background: rgba(255,255,255,.12);
        box-shadow: 0 10px 25px rgba(0,0,0,.16), inset 0 1px 0 rgba(255,255,255,.1);
        backdrop-filter: blur(10px);
        -webkit-backdrop-filter: blur(10px);
        font-size: 1.45rem;
        animation: iconFloat 4s ease-in-out infinite;
    }

    .approval-heading-wrap {
        min-width: 0;
    }

    .approval-heading-line {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 9px;
        margin-bottom: 5px;
    }

    .approval-title {
        margin: 0;
        color: #fff;
        font-size: 1.48rem;
        line-height: 1.25;
        font-weight: 800;
        letter-spacing: -.025em;
    }

    .approval-subtitle {
        max-width: 850px;
        margin: 0;
        color: rgba(255,255,255,.68);
        font-size: .81rem;
        line-height: 1.6;
    }

    .approval-pending-pill {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        min-height: 29px;
        padding: 4px 7px 4px 10px;
        border: 1px solid rgba(255,255,255,.1);
        border-radius: 999px;
        color: #fff;
        background: rgba(220,38,38,.92);
        box-shadow: 0 7px 18px rgba(220,38,38,.22);
        font-size: .68rem;
        font-weight: 800;
        white-space: nowrap;
    }

    .pending-count {
        min-width: 20px;
        height: 20px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 0 5px;
        border-radius: 50%;
        color: #dc2626;
        background: #fff;
        font-size: .69rem;
        font-weight: 900;
    }

    .approval-hero-actions {
        flex-shrink: 0;
    }

    .bulk-approve-btn {
        position: relative;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 9px;
        min-height: 45px;
        padding: 0 18px;
        border: 1px solid rgba(255,255,255,.24);
        border-radius: 14px;
        color: #fff;
        background: rgba(255,255,255,.11);
        box-shadow: inset 0 1px 0 rgba(255,255,255,.08);
        backdrop-filter: blur(10px);
        -webkit-backdrop-filter: blur(10px);
        font-size: .76rem;
        font-weight: 800;
        transition: all .25s ease;
        overflow: hidden;
    }

        .bulk-approve-btn::before {
            content: "";
            position: absolute;
            inset: 0;
            transform: translateX(-110%);
            background: linear-gradient( 90deg, transparent, rgba(255,255,255,.13), transparent );
            transition: transform .55s ease;
        }

        .bulk-approve-btn:hover {
            color: #fff;
            transform: translateY(-2px);
            border-color: rgba(255,255,255,.36);
            background: rgba(255,255,255,.18);
            box-shadow: 0 12px 26px rgba(0,0,0,.18);
        }

            .bulk-approve-btn:hover::before {
                transform: translateX(110%);
            }

        .bulk-approve-btn i {
            font-size: .88rem;
        }

    /* =========================================================
           TOOLBAR
        ========================================================= */

    .approval-toolbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 18px;
        padding: 13px;
        margin-bottom: 20px;
        border: 1px solid var(--approval-border);
        border-radius: 18px;
        background: rgba(255,255,255,.92);
        box-shadow: var(--approval-shadow);
        backdrop-filter: blur(14px);
        -webkit-backdrop-filter: blur(14px);
        animation: approvalFadeUp .65s .1s ease both;
    }

    .approval-tabs {
        display: flex;
        align-items: center;
        gap: 5px;
        max-width: 100%;
        padding: 4px;
        overflow-x: auto;
        border: 1px solid #edf1f6;
        border-radius: 13px;
        background: #f8fafc;
        scrollbar-width: none;
    }

        .approval-tabs::-webkit-scrollbar {
            display: none;
        }

    .approval-tab {
        position: relative;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        min-height: 37px;
        padding: 0 14px;
        border-radius: 10px;
        color: #64748b;
        text-decoration: none;
        font-size: .72rem;
        font-weight: 800;
        white-space: nowrap;
        transition: all .22s ease;
    }

        .approval-tab i {
            font-size: .74rem;
            transition: transform .22s ease;
        }

        .approval-tab:hover {
            color: var(--approval-primary);
            background: #fff;
        }

            .approval-tab:hover i {
                transform: translateY(-1px);
            }

        .approval-tab.active {
            color: var(--approval-primary);
            background: #fff;
            box-shadow: 0 4px 14px rgba(15,23,42,.075);
        }

            .approval-tab.active::after {
                content: "";
                position: absolute;
                left: 16px;
                right: 16px;
                bottom: -1px;
                height: 2px;
                border-radius: 99px;
                background: var(--approval-primary);
            }

    .approval-search {
        position: relative;
        flex: 0 0 300px;
    }

        .approval-search i {
            position: absolute;
            left: 14px;
            top: 50%;
            z-index: 2;
            color: #94a3b8;
            font-size: .75rem;
            transform: translateY(-50%);
            transition: color .2s ease;
        }

        .approval-search .form-control {
            height: 41px;
            padding: 0 13px 0 38px;
            border: 1px solid var(--approval-border);
            border-radius: 12px;
            color: var(--approval-heading);
            background: #fff;
            box-shadow: none;
            font-size: .76rem;
            transition: all .25s ease;
        }

            .approval-search .form-control::placeholder {
                color: #a3adbb;
            }

            .approval-search .form-control:focus {
                border-color: #93c5fd;
                box-shadow: 0 0 0 4px rgba(37,99,235,.08);
            }

        .approval-search:focus-within i {
            color: var(--approval-primary);
        }

    /* =========================================================
           MAIN CARD
        ========================================================= */

    .approval-table-card {
        overflow: hidden;
        border: 1px solid var(--approval-border);
        border-radius: 21px;
        background: rgba(255,255,255,.97);
        box-shadow: var(--approval-shadow);
        animation: approvalFadeUp .7s .2s ease both;
        transition: box-shadow .3s ease;
    }

        .approval-table-card:hover {
            box-shadow: var(--approval-shadow-hover);
        }

    .approval-table-top {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 15px;
        padding: 18px 21px;
        border-bottom: 1px solid var(--approval-border-soft);
        background: linear-gradient(180deg,#fff,#fcfdff);
    }

    .table-section-title {
        display: flex;
        align-items: center;
        gap: 11px;
    }

    .table-section-icon {
        width: 40px;
        height: 40px;
        flex: 0 0 40px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border: 1px solid #dbeafe;
        border-radius: 12px;
        color: var(--approval-primary);
        background: var(--approval-primary-soft);
        font-size: .9rem;
        box-shadow: 0 5px 14px rgba(37,99,235,.07);
    }

    .table-section-title h6 {
        margin: 0;
        color: var(--approval-heading);
        font-size: .88rem;
        font-weight: 800;
    }

    .table-section-title span {
        display: block;
        margin-top: 3px;
        color: var(--approval-muted);
        font-size: .68rem;
    }

    .table-live-status {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        min-height: 30px;
        padding: 5px 10px;
        border: 1px solid #dcfce7;
        border-radius: 999px;
        color: #16a34a;
        background: #f0fdf4;
        font-size: .66rem;
        font-weight: 800;
        white-space: nowrap;
    }

    .live-dot {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: #22c55e;
        box-shadow: 0 0 0 4px rgba(34,197,94,.11);
        animation: livePulse 2s infinite;
    }

    /* =========================================================
           TABLE
        ========================================================= */

    .approval-table-wrapper {
        position: relative;
    }

    .approval-table {
        min-width: 1100px;
        margin-bottom: 0;
        font-size: .79rem;
    }

        .approval-table thead th {
            padding: 13px 13px;
            border-bottom: 1px solid #e8edf4;
            color: #64748b;
            background: #f8fafc;
            font-size: .64rem;
            font-weight: 900;
            letter-spacing: .045em;
            text-transform: uppercase;
            white-space: nowrap;
        }

        .approval-table tbody tr {
            border-color: #edf1f5;
            transition: background .25s ease, transform .25s ease, box-shadow .25s ease;
        }

            .approval-table tbody tr:hover {
                position: relative;
                background: #fbfdff;
                box-shadow: inset 3px 0 0 var(--approval-primary);
            }

        .approval-table tbody td {
            padding: 14px 13px;
            vertical-align: middle;
            border-color: #edf1f5;
        }

    .approval-checkbox {
        width: 17px;
        height: 17px;
        margin-top: 0;
        cursor: pointer;
        border: 1px solid #cbd5e1;
        border-radius: 5px;
        box-shadow: none !important;
        transition: all .2s ease;
    }

        .approval-checkbox:hover {
            border-color: #93c5fd;
            transform: scale(1.05);
        }

        .approval-checkbox:checked {
            border-color: var(--approval-primary);
            background-color: var(--approval-primary);
        }

    /* =========================================================
           EMPLOYEE
        ========================================================= */

    .employee-cell {
        display: flex;
        align-items: center;
        gap: 11px;
        min-width: 190px;
    }

    .employee-avatar {
        position: relative;
        width: 42px;
        height: 42px;
        flex: 0 0 42px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border: 2px solid #fff;
        border-radius: 13px;
        color: #fff;
        background: linear-gradient(135deg,#2563eb,#4f46e5);
        box-shadow: 0 7px 16px rgba(37,99,235,.18);
        font-size: .73rem;
        font-weight: 900;
        transition: all .25s ease;
    }

        .employee-avatar::after {
            content: "";
            position: absolute;
            right: -2px;
            bottom: -2px;
            width: 10px;
            height: 10px;
            border: 2px solid #fff;
            border-radius: 50%;
            background: #22c55e;
        }

    .approval-table tbody tr:hover .employee-avatar {
        transform: translateY(-2px) rotate(-3deg) scale(1.04);
        box-shadow: 0 10px 20px rgba(37,99,235,.22);
    }

    .employee-name {
        display: block;
        max-width: 180px;
        overflow: hidden;
        color: var(--approval-heading);
        font-size: .77rem;
        font-weight: 800;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .employee-role {
        display: block;
        margin-top: 3px;
        color: var(--approval-muted);
        font-size: .66rem;
        font-weight: 600;
    }

    /* =========================================================
           CATEGORY
        ========================================================= */

    .category-badge {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        min-height: 30px;
        padding: 5px 9px;
        border: 1px solid #e5e7eb;
        border-radius: 9px;
        color: #475569;
        background: #f8fafc;
        font-size: .66rem;
        font-weight: 800;
        white-space: nowrap;
        transition: all .2s ease;
    }

        .category-badge i {
            color: var(--approval-primary) !important;
        }

    .approval-table tbody tr:hover .category-badge {
        border-color: #dbeafe;
        color: #1d4ed8;
        background: #eff6ff;
    }

    /* =========================================================
           DURATION
        ========================================================= */

    .duration-text {
        display: block;
        color: #334155;
        font-size: .74rem;
        font-weight: 800;
        line-height: 1.45;
    }

    .submitted-text {
        display: block;
        margin-top: 4px;
        color: #94a3b8;
        font-size: .63rem;
        font-weight: 600;
    }

        .submitted-text i {
            color: #a5afbd;
        }

    /* =========================================================
           REASON
        ========================================================= */

    .reason-text {
        max-width: 290px;
        color: #64748b;
        font-size: .7rem;
        line-height: 1.55;
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    /* =========================================================
           ATTACHMENT
        ========================================================= */

    .receipt-link {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        min-height: 30px;
        padding: 5px 9px;
        border: 1px solid #fee2e2;
        border-radius: 9px;
        color: #dc2626;
        background: #fffafa;
        font-size: .65rem;
        font-weight: 800;
        text-decoration: none;
        transition: all .22s ease;
    }

        .receipt-link i {
            font-size: .7rem;
        }

        .receipt-link:hover {
            color: #fff;
            border-color: #dc2626;
            background: #dc2626;
            transform: translateY(-2px);
            box-shadow: 0 7px 15px rgba(220,38,38,.16);
        }

    .no-attachment {
        display: inline-flex;
        align-items: center;
        color: #a3adbb;
        font-size: .66rem;
        font-weight: 700;
    }

    /* =========================================================
           ACTIONS
        ========================================================= */

    .approval-actions {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        white-space: nowrap;
    }

    .approve-btn,
    .reject-btn {
        min-height: 33px;
        padding: 0 10px;
        border-radius: 9px;
        font-size: .65rem;
        font-weight: 900;
        transition: all .22s ease;
    }

    .approve-btn {
        color: #fff;
        border: 1px solid #16a34a;
        background: linear-gradient(135deg,#22c55e,#16a34a);
        box-shadow: 0 5px 12px rgba(22,163,74,.13);
    }

        .approve-btn:hover {
            color: #fff;
            transform: translateY(-2px);
            border-color: #15803d;
            box-shadow: 0 9px 18px rgba(22,163,74,.2);
        }

        .approve-btn:active {
            transform: translateY(0);
        }

    .reject-btn {
        color: #dc2626;
        border: 1px solid #fecaca;
        background: #fff;
    }

        .reject-btn:hover {
            color: #fff;
            border-color: #dc2626;
            background: #dc2626;
            transform: translateY(-2px);
            box-shadow: 0 8px 18px rgba(220,38,38,.15);
        }

        .reject-btn:active {
            transform: translateY(0);
        }

        .approve-btn:disabled,
        .reject-btn:disabled {
            opacity: .7;
            cursor: not-allowed;
            transform: none;
        }

    /* =========================================================
           EMPTY STATE
        ========================================================= */

    .empty-state {
        padding: 72px 20px !important;
        border-bottom: 0 !important;
    }

    .empty-state-icon {
        position: relative;
        width: 78px;
        height: 78px;
        margin: 0 auto 17px;
        display: flex;
        align-items: center;
        justify-content: center;
        border: 1px solid #e2e8f0;
        border-radius: 24px;
        color: #64748b;
        background: linear-gradient(145deg,#f8fafc,#eef2f7);
        box-shadow: 0 10px 25px rgba(15,23,42,.06);
        font-size: 1.65rem;
        animation: emptyFloat 3.5s ease-in-out infinite;
    }

        .empty-state-icon::before {
            content: "";
            position: absolute;
            inset: -7px;
            border: 1px dashed #dbe3ed;
            border-radius: 28px;
            opacity: .65;
        }

    .empty-state h6 {
        margin-bottom: 6px;
        color: #475569;
        font-size: .87rem;
        font-weight: 900;
    }

    .empty-state p {
        margin: 0;
        color: #94a3b8;
        font-size: .72rem;
    }

    /* =========================================================
           LOADING / SPINNER
        ========================================================= */

    .approval-table .spinner-border {
        width: .75rem;
        height: .75rem;
        border-width: 2px;
    }

    /* =========================================================
           ROW ANIMATIONS
        ========================================================= */

    .approval-data-row {
        animation: tableRowIn .45s ease both;
    }

        .approval-data-row:nth-child(2) {
            animation-delay: .035s;
        }

        .approval-data-row:nth-child(3) {
            animation-delay: .07s;
        }

        .approval-data-row:nth-child(4) {
            animation-delay: .105s;
        }

        .approval-data-row:nth-child(5) {
            animation-delay: .14s;
        }

        .approval-data-row:nth-child(6) {
            animation-delay: .175s;
        }

        .approval-data-row:nth-child(7) {
            animation-delay: .21s;
        }

        .approval-data-row:nth-child(8) {
            animation-delay: .245s;
        }

        .approval-data-row:nth-child(9) {
            animation-delay: .28s;
        }

        .approval-data-row:nth-child(10) {
            animation-delay: .315s;
        }

    .fade-out-row {
        opacity: 0 !important;
        transform: translateX(45px) !important;
        filter: blur(2px);
        transition: all .5s ease !important;
    }

    /* =========================================================
           KEYFRAMES
        ========================================================= */

    @@keyframes approvalSlideDown {
        from {
            opacity: 0;
            transform: translateY(-20px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@keyframes approvalFadeUp {
        from {
            opacity: 0;
            transform: translateY(18px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@keyframes tableRowIn {
        from {
            opacity: 0;
            transform: translateX(-12px);
        }

        to {
            opacity: 1;
            transform: translateX(0);
        }
    }

    @@keyframes approvalFloat {
        0%, 100% {
            transform: translate3d(0,0,0);
        }

        50% {
            transform: translate3d(18px,15px,0);
        }
    }

    @@keyframes heroOrb {
        0%, 100% {
            transform: scale(1);
            opacity: .72;
        }

        50% {
            transform: scale(1.13);
            opacity: 1;
        }
    }

    @@keyframes iconFloat {
        0%, 100% {
            transform: translateY(0) rotate(0deg);
        }

        50% {
            transform: translateY(-3px) rotate(-2deg);
        }
    }

    @@keyframes livePulse {
        0% {
            box-shadow: 0 0 0 0 rgba(34,197,94,.32);
        }

        70% {
            box-shadow: 0 0 0 7px rgba(34,197,94,0);
        }

        100% {
            box-shadow: 0 0 0 0 rgba(34,197,94,0);
        }
    }

    @@keyframes emptyFloat {
        0%, 100% {
            transform: translateY(0);
        }

        50% {
            transform: translateY(-5px);
        }
    }

    /* =========================================================
           RESPONSIVE - LARGE TABLET
        ========================================================= */


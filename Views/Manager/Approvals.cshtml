@model IEnumerable<ERP_System.Models.ApprovalItemViewModel>
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Unified Approval Center";
    var activeCategory = ViewBag.ActiveCategory ?? "All";
}

<!-- CDN References -->

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" />
<script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>

<style>
    :root {
        --approval-primary: #2563eb;
        --approval-primary-dark: #1d4ed8;
        --approval-primary-light: #eff6ff;
        --approval-success: #16a34a;
        --approval-success-light: #f0fdf4;
        --approval-danger: #dc2626;
        --approval-danger-light: #fef2f2;
        --approval-warning: #f59e0b;
        --approval-warning-light: #fffbeb;
        --approval-dark: #172033;
        --approval-text: #475569;
        --approval-muted: #94a3b8;
        --approval-border: #e2e8f0;
        --approval-bg: #f7f9fc;
        --approval-white: #ffffff;
    }

    .approval-page {
        position: relative;
        overflow: hidden;
    }

        .approval-page::before,
        .approval-page::after {
            content: "";
            position: absolute;
            border-radius: 50%;
            pointer-events: none;
            z-index: 0;
        }

        .approval-page::before {
            width: 260px;
            height: 260px;
            top: 0;
            right: -100px;
            background: radial-gradient(circle, rgba(37, 99, 235, 0.08), transparent 70%);
            animation: approvalFloat 8s ease-in-out infinite;
        }

        .approval-page::after {
            width: 220px;
            height: 220px;
            bottom: 50px;
            left: -100px;
            background: radial-gradient(circle, rgba(59, 130, 246, 0.06), transparent 70%);
            animation: approvalFloat 10s ease-in-out infinite reverse;
        }

    .approval-page-content {
        position: relative;
        z-index: 1;
    }

    /* =====================================================
           HEADER
        ===================================================== */

    .approval-hero {
        position: relative;
        overflow: hidden;
        padding: 26px 30px;
        margin-bottom: 24px;
        border-radius: 24px;
        color: #ffffff;
        background: linear-gradient(135deg, #0f172a 0%, #1e3a8a 58%, #2563eb 100%);
        box-shadow: 0 18px 45px rgba(30, 58, 138, 0.18);
        animation: approvalSlideDown 0.65s ease both;
    }

        .approval-hero::before {
            content: "";
            position: absolute;
            width: 230px;
            height: 230px;
            top: -120px;
            right: 6%;
            border-radius: 50%;
            background: rgba(255, 255, 255, 0.07);
            animation: heroPulse 6s ease-in-out infinite;
        }

        .approval-hero::after {
            content: "";
            position: absolute;
            width: 150px;
            height: 150px;
            bottom: -90px;
            right: 25%;
            border-radius: 50%;
            background: rgba(96, 165, 250, 0.18);
        }

    .approval-breadcrumb {
        position: relative;
        z-index: 2;
    }

        .approval-breadcrumb .breadcrumb {
            margin-bottom: 9px;
        }

        .approval-breadcrumb .breadcrumb-item,
        .approval-breadcrumb .breadcrumb-item a {
            color: rgba(255, 255, 255, 0.7);
            font-size: 0.76rem;
        }

            .approval-breadcrumb .breadcrumb-item.active {
                color: rgba(255, 255, 255, 0.95);
            }

            .approval-breadcrumb .breadcrumb-item + .breadcrumb-item::before {
                color: rgba(255, 255, 255, 0.45);
            }

    .approval-title-row {
        position: relative;
        z-index: 2;
    }

    .approval-title-icon {
        width: 54px;
        height: 54px;
        flex-shrink: 0;
        border-radius: 17px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 1.4rem;
        background: rgba(255, 255, 255, 0.14);
        border: 1px solid rgba(255, 255, 255, 0.18);
        box-shadow: 0 8px 20px rgba(0, 0, 0, 0.12);
        animation: iconPulse 3s ease-in-out infinite;
    }

    .approval-title {
        font-size: 1.55rem;
        font-weight: 800;
        letter-spacing: -0.025em;
        margin-bottom: 4px;
    }

    .approval-subtitle {
        color: rgba(255, 255, 255, 0.72);
        font-size: 0.84rem;
        margin-bottom: 0;
    }

    .approval-pending-pill {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 7px 12px;
        border-radius: 999px;
        color: #ffffff;
        font-size: 0.76rem;
        font-weight: 700;
        background: rgba(220, 38, 38, 0.95);
        box-shadow: 0 6px 16px rgba(220, 38, 38, 0.25);
        white-space: nowrap;
    }

    .pending-count {
        min-width: 20px;
        height: 20px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 0 5px;
        border-radius: 50%;
        background: #ffffff;
        color: #dc2626;
        font-size: 0.72rem;
    }

    .bulk-approve-btn {
        position: relative;
        z-index: 2;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        min-height: 43px;
        padding: 0 18px;
        border: 1px solid rgba(255, 255, 255, 0.3);
        border-radius: 14px;
        color: #ffffff;
        font-size: 0.82rem;
        font-weight: 700;
        background: rgba(255, 255, 255, 0.13);
        backdrop-filter: blur(8px);
        -webkit-backdrop-filter: blur(8px);
        transition: all 0.25s ease;
    }

        .bulk-approve-btn:hover {
            color: #ffffff;
            transform: translateY(-2px);
            background: rgba(255, 255, 255, 0.22);
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.16);
        }

    /* =====================================================
           CATEGORY & SEARCH BAR
        ===================================================== */

    .approval-toolbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 18px;
        padding: 15px 18px;
        margin-bottom: 24px;
        border: 1px solid var(--approval-border);
        border-radius: 18px;
        background: rgba(255, 255, 255, 0.92);
        box-shadow: 0 8px 30px rgba(15, 23, 42, 0.04);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        animation: approvalFadeUp 0.65s 0.1s ease both;
    }

    .approval-tabs {
        display: flex;
        align-items: center;
        gap: 6px;
        padding: 5px;
        overflow-x: auto;
        background: #f8fafc;
        border: 1px solid #edf1f6;
        border-radius: 14px;
        scrollbar-width: none;
    }

        .approval-tabs::-webkit-scrollbar {
            display: none;
        }

    .approval-tab {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        min-height: 36px;
        padding: 0 15px;
        border-radius: 10px;
        color: #64748b;
        font-size: 0.77rem;
        font-weight: 700;
        text-decoration: none;
        white-space: nowrap;
        transition: all 0.25s ease;
    }

        .approval-tab:hover {
            color: var(--approval-primary);
            background: #ffffff;
        }

        .approval-tab.active {
            color: var(--approval-primary);
            background: #ffffff;
            box-shadow: 0 3px 12px rgba(15, 23, 42, 0.07);
        }

    .approval-search {
        position: relative;
        width: 100%;
        max-width: 300px;
    }

        .approval-search i {
            position: absolute;
            top: 50%;
            left: 14px;
            z-index: 2;
            color: #94a3b8;
            font-size: 0.78rem;
            transform: translateY(-50%);
            transition: color 0.2s ease;
        }

        .approval-search .form-control {
            height: 42px;
            padding-left: 38px;
            border: 1px solid var(--approval-border);
            border-radius: 12px;
            background: #ffffff;
            font-size: 0.8rem;
            box-shadow: none;
            transition: all 0.25s ease;
        }

            .approval-search .form-control:focus {
                border-color: #93c5fd;
                box-shadow: 0 0 0 4px rgba(37, 99, 235, 0.08);
            }

        .approval-search:focus-within i {
            color: var(--approval-primary);
        }

    /* =====================================================
           MAIN TABLE CARD
        ===================================================== */

    .approval-table-card {
        overflow: hidden;
        border: 1px solid var(--approval-border);
        border-radius: 20px;
        background: rgba(255, 255, 255, 0.96);
        box-shadow: 0 14px 38px rgba(15, 23, 42, 0.055);
        animation: approvalFadeUp 0.7s 0.2s ease both;
    }

    .approval-table-top {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        padding: 20px 22px 17px;
        border-bottom: 1px solid #eef2f7;
    }

    .table-section-title {
        display: flex;
        align-items: center;
        gap: 11px;
    }

    .table-section-icon {
        width: 38px;
        height: 38px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 12px;
        color: var(--approval-primary);
        background: var(--approval-primary-light);
    }

    .table-section-title h6 {
        margin: 0;
        color: var(--approval-dark);
        font-size: 0.92rem;
        font-weight: 800;
    }

    .table-section-title span {
        display: block;
        margin-top: 2px;
        color: var(--approval-muted);
        font-size: 0.72rem;
    }

    .table-live-status {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 7px 11px;
        border-radius: 999px;
        color: #16a34a;
        background: #f0fdf4;
        border: 1px solid #dcfce7;
        font-size: 0.7rem;
        font-weight: 700;
    }

    .live-dot {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: #22c55e;
        box-shadow: 0 0 0 4px rgba(34, 197, 94, 0.12);
        animation: livePulse 2s infinite;
    }

    .approval-table {
        margin-bottom: 0;
        min-width: 1050px;
        font-size: 0.82rem;
    }

        .approval-table thead th {
            padding: 15px 14px;
            border-bottom: 1px solid #e9eef5;
            color: #64748b;
            background: #f8fafc;
            font-size: 0.68rem;
            font-weight: 800;
            letter-spacing: 0.04em;
            text-transform: uppercase;
            white-space: nowrap;
        }

        .approval-table tbody tr {
            border-color: #edf1f5;
            transition: all 0.25s ease;
        }

            .approval-table tbody tr:hover {
                background: #fafcff;
                transform: scale(1.001);
            }

        .approval-table tbody td {
            padding: 16px 14px;
            vertical-align: middle;
            border-color: #edf1f5;
        }

    .approval-checkbox {
        width: 18px;
        height: 18px;
        cursor: pointer;
        border-color: #cbd5e1;
        box-shadow: none !important;
    }

        .approval-checkbox:checked {
            background-color: var(--approval-primary);
            border-color: var(--approval-primary);
        }

    /* =====================================================
           EMPLOYEE
        ===================================================== */

    .employee-cell {
        display: flex;
        align-items: center;
        gap: 11px;
        min-width: 175px;
    }

    .employee-avatar {
        width: 42px;
        height: 42px;
        flex-shrink: 0;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 14px;
        color: #ffffff;
        background: linear-gradient(135deg, #2563eb, #4f46e5);
        font-size: 0.76rem;
        font-weight: 800;
        box-shadow: 0 6px 14px rgba(37, 99, 235, 0.18);
        transition: transform 0.25s ease;
    }

    .approval-table tbody tr:hover .employee-avatar {
        transform: rotate(-4deg) scale(1.05);
    }

    .employee-name {
        display: block;
        color: var(--approval-dark);
        font-size: 0.83rem;
        font-weight: 800;
    }

    .employee-role {
        display: block;
        margin-top: 3px;
        color: var(--approval-muted);
        font-size: 0.71rem;
    }

    /* =====================================================
           BADGES & CONTENT
        ===================================================== */

    .category-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 7px 10px;
        border: 1px solid #e5e7eb;
        border-radius: 9px;
        color: #475569;
        background: #f8fafc;
        font-size: 0.71rem;
        font-weight: 700;
        white-space: nowrap;
    }

    .duration-text {
        display: block;
        color: #334155;
        font-size: 0.78rem;
        font-weight: 700;
    }

    .submitted-text {
        display: block;
        margin-top: 4px;
        color: #94a3b8;
        font-size: 0.68rem;
    }

    .reason-text {
        max-width: 270px;
        color: #64748b;
        font-size: 0.76rem;
        line-height: 1.55;
    }

    .receipt-link {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 7px 10px;
        border: 1px solid #fee2e2;
        border-radius: 9px;
        color: #dc2626;
        background: #fffafa;
        font-size: 0.71rem;
        font-weight: 700;
        text-decoration: none;
        transition: all 0.2s ease;
    }

        .receipt-link:hover {
            color: #b91c1c;
            transform: translateY(-1px);
            background: #fff1f2;
        }

    .no-attachment {
        color: #94a3b8;
        font-size: 0.72rem;
    }

    /* =====================================================
           ACTION BUTTONS
        ===================================================== */

    .approval-actions {
        display: flex;
        justify-content: center;
        gap: 7px;
        white-space: nowrap;
    }

    .approve-btn,
    .reject-btn {
        min-height: 34px;
        padding: 0 11px;
        border-radius: 10px;
        font-size: 0.72rem;
        font-weight: 800;
        transition: all 0.22s ease;
    }

    .approve-btn {
        color: #ffffff;
        border: 1px solid #16a34a;
        background: linear-gradient(135deg, #22c55e, #16a34a);
        box-shadow: 0 5px 12px rgba(22, 163, 74, 0.14);
    }

        .approve-btn:hover {
            color: #ffffff;
            transform: translateY(-2px);
            box-shadow: 0 9px 18px rgba(22, 163, 74, 0.22);
        }

    .reject-btn {
        color: #dc2626;
        border: 1px solid #fecaca;
        background: #ffffff;
    }

        .reject-btn:hover {
            color: #ffffff;
            border-color: #dc2626;
            background: #dc2626;
            transform: translateY(-2px);
            box-shadow: 0 8px 18px rgba(220, 38, 38, 0.15);
        }

    /* =====================================================
           EMPTY STATE
        ===================================================== */

    .empty-state {
        padding: 65px 20px !important;
    }

    .empty-state-icon {
        width: 74px;
        height: 74px;
        margin: 0 auto 15px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 24px;
        color: #94a3b8;
        background: #f8fafc;
        font-size: 1.7rem;
    }

    .empty-state h6 {
        color: #475569;
        font-weight: 800;
        margin-bottom: 6px;
    }

    .empty-state p {
        margin-bottom: 0;
        color: #94a3b8;
        font-size: 0.78rem;
    }

    /* =====================================================
           ANIMATIONS
        ===================================================== */

    .approval-data-row {
        animation: tableRowIn 0.45s ease both;
    }

        .approval-data-row:nth-child(2) {
            animation-delay: 0.04s;
        }

        .approval-data-row:nth-child(3) {
            animation-delay: 0.08s;
        }

        .approval-data-row:nth-child(4) {
            animation-delay: 0.12s;
        }

        .approval-data-row:nth-child(5) {
            animation-delay: 0.16s;
        }

        .approval-data-row:nth-child(6) {
            animation-delay: 0.20s;
        }

        .approval-data-row:nth-child(7) {
            animation-delay: 0.24s;
        }

        .approval-data-row:nth-child(8) {
            animation-delay: 0.28s;
        }

    .fade-out-row {
        opacity: 0 !important;
        transform: translateX(40px) !important;
        transition: all 0.5s ease !important;
    }

    @@keyframes approvalSlideDown {
        from {
            opacity: 0;
            transform: translateY(-20px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@keyframes approvalFadeUp {
        from {
            opacity: 0;
            transform: translateY(18px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@keyframes tableRowIn {
        from {
            opacity: 0;
            transform: translateX(-14px);
        }

        to {
            opacity: 1;
            transform: translateX(0);
        }
    }

    @@keyframes approvalFloat {
        0%, 100% {
            transform: translate(0, 0);
        }

        50% {
            transform: translate(18px, 18px);
        }
    }

    @@keyframes iconPulse {
        0%, 100% {
            transform: scale(1);
        }

        50% {
            transform: scale(1.05);
        }
    }

    @@keyframes heroPulse {
        0%, 100% {
            transform: scale(1);
            opacity: 0.7;
        }

        50% {
            transform: scale(1.14);
            opacity: 1;
        }
    }

    @@keyframes livePulse {
        0% {
            box-shadow: 0 0 0 0 rgba(34, 197, 94, 0.3);
        }

        70% {
            box-shadow: 0 0 0 7px rgba(34, 197, 94, 0);
        }

        100% {
            box-shadow: 0 0 0 0 rgba(34, 197, 94, 0);
        }
    }

    /* =====================================================
           RESPONSIVE
        ===================================================== */

    @@media (max-width: 991.98px) {
        .approval-hero {
            padding: 24px;
        }

        .approval-toolbar {
            align-items: stretch;
            flex-direction: column;
        }

        .approval-search {
            max-width: none;
        }
    }

    @@media (max-width: 767.98px) {
        .approval-page {
            padding-left: 0;
            padding-right: 0;
        }

        .approval-hero {
            padding: 21px 18px;
            border-radius: 18px;
        }

        .approval-title-row {
            align-items: flex-start !important;
            flex-direction: column;
        }

        .approval-title {
            font-size: 1.28rem;
        }

        .approval-hero-actions {
            width: 100%;
        }

        .bulk-approve-btn {
            width: 100%;
        }

        .approval-pending-pill {
            margin-top: 3px;
        }

        .approval-toolbar {
            padding: 12px;
            border-radius: 15px;
        }

        .approval-tabs {
            width: 100%;
        }

        .approval-table-card {
            border-radius: 16px;
        }

        .approval-table-top {
            align-items: flex-start;
            flex-direction: column;
            padding: 17px;
        }

        .approval-table {
            font-size: 0.76rem;
        }
    }

    @@media (max-width: 575.98px) {
        .approval-title-icon {
            width: 48px;
            height: 48px;
        }

        .approval-title {
            font-size: 1.15rem;
        }

        .approval-subtitle {
            font-size: 0.76rem;
        }

        .approval-tab {
            padding: 0 12px;
            font-size: 0.7rem;
        }

        .table-live-status {
            display: none;
        }
    }

    @@media print {
        .approval-toolbar,
        .bulk-approve-btn,
        .approval-actions,
        .approval-search,
        .approval-page::before,
        .approval-page::after {
            display: none !important;
        }

        .approval-hero {
            color: #000 !important;
            background: #fff !important;
            box-shadow: none !important;
            border: 1px solid #ddd;
        }

            .approval-hero *,
            .approval-breadcrumb .breadcrumb-item,
            .approval-breadcrumb .breadcrumb-item a,
            .approval-subtitle {
                color: #000 !important;
            }
    }
</style>

<div class="container-fluid py-4 text-start approval-page">
    <div class="approval-page-content">

        <div style="display:none;">@Html.AntiForgeryToken()</div>

        <!-- =====================================================
             PREMIUM HEADER
        ====================================================== -->
        <div class="approval-hero">

            <div class="approval-breadcrumb">
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb">
                        <li class="breadcrumb-item">
                            <a href="/Manager" class="text-decoration-none">Manager Portal</a>
                        </li>
                        <li class="breadcrumb-item">Approvals</li>
                        <li class="breadcrumb-item active" aria-current="page">Approval Center</li>
                    </ol>
                </nav>
            </div>

            <div class="d-flex justify-content-between gap-4 approval-title-row">
                <div class="d-flex align-items-start gap-3">
                    <div class="approval-title-icon">
                        <i class="fa-solid fa-clipboard-check"></i>
                    </div>

                    <div>
                        <div class="d-flex align-items-center flex-wrap gap-2 mb-1">
                            <h4 class="approval-title">Unified Approval Center</h4>

                            <div class="approval-pending-pill">
                                <i class="fa-solid fa-clock"></i>
                                Pending
                                <span class="pending-count" id="pending-approvals-badge">@Model.Count()</span>
                            </div>
                        </div>

                        <p class="approval-subtitle">
                            Review and manage employee leave, regularization, expense and approval requests from one centralized workspace.
                        </p>
                    </div>
                </div>

                <div class="approval-hero-actions">
                    <button type="button" class="bulk-approve-btn" onclick="triggerBulkApproval()">
                        <i class="fa-solid fa-check-double"></i>
                        <span>Bulk Approve Selected</span>
                    </button>
                </div>
            </div>
        </div>

        <!-- =====================================================
             CATEGORY FILTERS + SEARCH
        ====================================================== -->
        <div class="approval-toolbar">

            <div class="approval-tabs">
                <a href="/Manager/Approvals?category=All"
                   class="approval-tab @(activeCategory == "All" ? "active" : "")">
                    <i class="fa-solid fa-layer-group"></i>
                    All Requests
                </a>

                <a href="/Manager/Approvals?category=Leave"
                   class="approval-tab @(activeCategory == "Leave" ? "active" : "")">
                    <i class="fa-solid fa-calendar-check"></i>
                    Leaves
                </a>

                <a href="/Manager/Approvals?category=Regularization"
                   class="approval-tab @(activeCategory == "Regularization" ? "active" : "")">
                    <i class="fa-solid fa-clock-rotate-left"></i>
                    Regularization
                </a>

                <a href="/Manager/Approvals?category=Expense"
                   class="approval-tab @(activeCategory == "Expense" ? "active" : "")">
                    <i class="fa-solid fa-receipt"></i>
                    Expenses
                </a>
            </div>

            <div class="approval-search">
                <i class="fa-solid fa-magnifying-glass"></i>
                <input type="text"
                       id="approvalsFilterSearch"
                       class="form-control"
                       placeholder="Search employee or request..."
                       onkeyup="localSearchApprovals()" />
            </div>
        </div>

        <!-- =====================================================
             APPROVAL TABLE
        ====================================================== -->
        <div class="approval-table-card">

            <div class="approval-table-top">
                <div class="table-section-title">
                    <div class="table-section-icon">
                        <i class="fa-solid fa-list-check"></i>
                    </div>

                    <div>
                        <h6>Pending Approval Requests</h6>
                        <span>Review employee requests and take the required action.</span>
                    </div>
                </div>

                <div class="table-live-status">
                    <span class="live-dot"></span>
                    Live Approval Queue
                </div>
            </div>

            <div class="table-responsive">
                <table class="table table-hover align-middle approval-table" id="approvalsDataTable">

                    <thead>
                        <tr>
                            <th style="width: 4%;" class="text-center">
                                <input type="checkbox"
                                       class="form-check-input approval-checkbox"
                                       id="selectAllCheckbox"
                                       onclick="toggleSelectAll(this)"
                                       title="Select All" />
                            </th>

                            <th style="width: 20%;">Employee Details</th>
                            <th style="width: 15%;">Request Type</th>
                            <th style="width: 18%;">Duration / Dates</th>
                            <th>Reason / Purpose</th>
                            <th style="width: 10%;">Attachment</th>
                            <th style="width: 17%;" class="text-center">Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="7" class="text-center empty-state">
                                    <div class="empty-state-icon">
                                        <i class="fa-solid fa-clipboard-check"></i>
                                    </div>

                                    <h6>All caught up!</h6>
                                    <p>No pending approval requests were found in this category.</p>
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var request in Model)
                            {
                                <tr id="approval-tr-row-@request.Id" class="approval-data-row">

                                    <td class="text-center">
                                        <input type="checkbox"
                                               class="form-check-input approval-checkbox row-selection-checkbox"
                                               data-id="@request.Id"
                                               data-category="@request.CategoryKey" />
                                    </td>

                                    <!-- Employee -->
                                    <td>
                                        <div class="employee-cell">
                                            <div class="employee-avatar text-uppercase">
                                                @request.Avatar
                                            </div>

                                            <div>
                                                <span class="employee-name">@request.EmployeeName</span>
                                                <span class="employee-role">@request.Role</span>
                                            </div>
                                        </div>
                                    </td>

                                    <!-- Category -->
                                    <td>
                                        <span class="category-badge">
                                            <i class="fa-solid fa-tag text-primary"></i>
                                            @request.ClaimCategory
                                        </span>
                                    </td>

                                    <!-- Duration -->
                                    <td>
                                        <span class="duration-text">@request.Duration</span>
                                        <span class="submitted-text">
                                            <i class="fa-regular fa-clock me-1"></i>
                                            Submitted: @request.SubmittedDate
                                        </span>
                                    </td>

                                    <!-- Reason -->
                                    <td>
                                        <div class="reason-text">
                                            @request.Reason
                                        </div>
                                    </td>

                                    <!-- Attachment -->
                                    <td>
                                        @if (request.HasAttachment)
                                        {
                                            <a href="/Manager/DownloadReceipt?filename=@request.AttachmentName"
                                               target="_blank"
                                               class="receipt-link">
                                                <i class="fa-solid fa-file-pdf"></i>
                                                Receipt
                                            </a>
                                        }
                                        else
                                        {
                                            <span class="no-attachment">
                                                <i class="fa-solid fa-minus me-1"></i>N/A
                                            </span>
                                        }
                                    </td>

                                    <!-- Actions -->
                                    <td class="text-center">
                                        <div class="approval-actions">

                                            <a href="javascript:void(0);" class="btn approve-btn d-inline-flex align-items-center justify-content-center"
                                               onclick="handleApproval(@request.Id, '@request.CategoryKey', 'Approved')">
                                                <i class="fa-solid fa-check me-1"></i>
                                                Approve
                                            </a>

                                            <a href="javascript:void(0);" class="btn reject-btn d-inline-flex align-items-center justify-content-center"
                                               onclick="handleApproval(@request.Id, '@request.CategoryKey', 'Rejected')">
                                                <i class="fa-solid fa-xmark me-1"></i>
                                                Reject
                                            </a>

                                        </div>
                                    </td>

                                </tr>
                            }
                        }
                    </tbody>

                </table>
            </div>
        </div>

    </div>

</div>

<script>
    // =========================================================
    // TOAST CONFIGURATION
    // =========================================================
    if (typeof toastr !== 'undefined') {
        toastr.options = {
            "closeButton": true,
            "progressBar": true,
            "positionClass": "toast-top-right",
            "timeOut": "3500",
            "extendedTimeOut": "1200"
        };
    }

    // =========================================================
    // SEARCH FILTER
    // =========================================================
    function localSearchApprovals() {
        const query = document.getElementById("approvalsFilterSearch").value.toLowerCase();
        const rows = document.querySelectorAll(".approval-data-row");

        rows.forEach(row => {
            const name = row.cells[1].innerText.toLowerCase();
            const reason = row.cells[4].innerText.toLowerCase();

            if (name.includes(query) || reason.includes(query)) {
                row.style.display = "";
            } else {
                row.style.display = "none";
            }
        });
    }

    // =========================================================
    // TOGGLE SELECT ALL
    // =========================================================
    function toggleSelectAll(master) {
        document.querySelectorAll(".row-selection-checkbox").forEach(chk => {
            chk.checked = master.checked;
        });
    }

    // =========================================================
    // SINGLE APPROVAL ACTION
    // =========================================================
    function handleApproval(id, category, actionType) {

        if (actionType === "Rejected") {

            if (typeof Swal !== 'undefined') {

                Swal.fire({
                    title: 'Reject Request?',
                    text: 'Provide remarks or comments for rejection:',
                    input: 'text',
                    inputPlaceholder: 'Insufficient documentation / mismatch dates...',
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#dc2626',
                    cancelButtonColor: '#64748b',
                    confirmButtonText: 'Yes, reject request',

                    preConfirm: (value) => {
                        if (!value) {
                            Swal.showValidationMessage('Please write a rejection reason.');
                        }

                        return value;
                    }

                }).then((result) => {

                    if (result.isConfirmed) {
                        sendApprovalAjax(id, category, 'Rejected', result.value);
                    }

                });

            } else {

                const remarks = prompt("Provide remarks or comments for rejection:");

                if (remarks !== null) {

                    if (remarks.trim() === "") {
                        alert("Rejection reason is required.");
                    } else {
                        sendApprovalAjax(id, category, 'Rejected', remarks);
                    }

                }
            }

        } else {
            sendApprovalAjax(id, category, 'Approved');
        }
    }

    // =========================================================
    // SEND SINGLE AJAX APPROVAL
    // =========================================================
    function sendApprovalAjax(id, category, actionType, remarks = "") {

        if (typeof toastr !== 'undefined') {
            toastr.info(`Sending ${actionType.toLowerCase()} request...`);
        }

        const formData = new FormData();

        formData.append("id", id);
        formData.append("category", category);
        formData.append("actionType", actionType);
        formData.append("remarks", remarks);

        // Retrieve Anti Forgery Token
        const tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');

        if (tokenInput) {
            formData.append("__RequestVerificationToken", tokenInput.value);
        }

        fetch("/Manager/ProcessApproval", {
            method: "POST",
            body: formData
        })

        .then(res => {

            if (!res.ok) {
                throw new Error("HTTP " + res.status + " " + res.statusText);
            }

            return res.json();
        })

        .then(data => {

            if (data.success) {

                if (typeof toastr !== 'undefined') {
                    toastr.success(data.message);
                } else {
                    alert(data.message);
                }

                // Row removal animation
                const row = document.getElementById(`approval-tr-row-${id}`);

                if (row) {

                    row.classList.add("fade-out-row");

                    setTimeout(() => {
                        row.remove();
                        checkEmptyTable();
                    }, 500);
                }

                // Decrement pending badge
                const badge = document.getElementById("pending-approvals-badge");

                if (badge) {

                    let count = parseInt(badge.innerText);

                    if (!isNaN(count) && count > 0) {
                        badge.innerText = count - 1;
                    }
                }

            } else {

                if (typeof toastr !== 'undefined') {
                    toastr.error(data.message);
                } else {
                    alert("Error: " + data.message);
                }
            }

        })

        .catch(err => {

            console.error("AJAX Error details: ", err);

            if (typeof Swal !== 'undefined') {
                Swal.fire("Action Failed", err.message, "error");
            } else {
                alert("Action Failed: " + err.message);
            }

        });
    }

    // =========================================================
    // BULK APPROVAL TRIGGER
    // =========================================================
    function triggerBulkApproval() {

        const selectedCheckboxes = document.querySelectorAll(".row-selection-checkbox:checked");

        if (selectedCheckboxes.length === 0) {

            if (typeof Swal !== 'undefined') {

                Swal.fire({
                    title: 'No Requests Selected',
                    text: 'Please select one or more requests before using bulk approval.',
                    icon: 'info',
                    confirmButtonColor: '#2563eb'
                });

            } else {

                alert('No Requests Selected. Please check the box next to requests to approve them in bulk.');
            }

            return;
        }

        const items = Array.from(selectedCheckboxes).map(chk => ({
            id: parseInt(chk.getAttribute("data-id")),
            category: chk.getAttribute("data-category")
        }));

        if (typeof Swal !== 'undefined') {

            Swal.fire({
                title: 'Bulk Approve Requests?',
                html: `You are about to approve <strong>${items.length}</strong> selected request(s) at once.`,
                icon: 'question',
                showCancelButton: true,
                confirmButtonColor: '#2563eb',
                cancelButtonColor: '#64748b',
                confirmButtonText: 'Yes, approve all'

            }).then((result) => {

                if (result.isConfirmed) {
                    sendBulkApprovalAjax(items);
                }

            });

        } else {

            if (confirm(`You are about to approve ${items.length} selected requests at once. Proceed?`)) {
                sendBulkApprovalAjax(items);
            }
        }
    }

    // =========================================================
    // SEND BULK APPROVAL AJAX
    // =========================================================
    function sendBulkApprovalAjax(items) {

        if (typeof toastr !== 'undefined') {
            toastr.info("Processing bulk approval...");
        }

        const headers = {
            "Content-Type": "application/json"
        };

        const tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');

        if (tokenInput) {
            headers["RequestVerificationToken"] = tokenInput.value;
        }

        fetch("/Manager/BulkApprove", {
            method: "POST",
            headers: headers,
            body: JSON.stringify(items)
        })

        .then(res => {

            if (!res.ok) {
                throw new Error("HTTP " + res.status + " " + res.statusText);
            }

            return res.json();
        })

        .then(data => {

            if (data.success) {

                if (typeof toastr !== 'undefined') {
                    toastr.success(data.message);
                } else {
                    alert(data.message);
                }

                // Remove approved rows with animation
                items.forEach(item => {

                    const row = document.getElementById(`approval-tr-row-${item.id}`);

                    if (row) {

                        row.classList.add("fade-out-row");

                        setTimeout(() => {
                            row.remove();
                            checkEmptyTable();
                        }, 500);
                    }

                });

                const selectAllCheckbox = document.getElementById("selectAllCheckbox");

                if (selectAllCheckbox) {
                    selectAllCheckbox.checked = false;
                }

                // Decrement pending count
                const badge = document.getElementById("pending-approvals-badge");

                if (badge) {

                    let count = parseInt(badge.innerText);

                    if (!isNaN(count)) {
                        badge.innerText = Math.max(0, count - (data.count || items.length));
                    }
                }

            } else {

                if (typeof toastr !== 'undefined') {
                    toastr.error(data.message);
                } else {
                    alert("Error: " + data.message);
                }
            }

        })

        .catch(err => {

            console.error("Bulk AJAX Error details: ", err);

            if (typeof Swal !== 'undefined') {
                Swal.fire("Bulk Action Failed", err.message, "error");
            } else {
                alert("Bulk Action Failed: " + err.message);
            }

        });
    }

    // =========================================================
    // CHECK EMPTY TABLE
    // =========================================================
    function checkEmptyTable() {

        const tbody = document.querySelector("#approvalsDataTable tbody");

        if (!tbody) return;

        const remainingRows = tbody.querySelectorAll(".approval-data-row");

        if (remainingRows.length === 0) {

            tbody.innerHTML = `
                <tr>
                    <td colspan="7" class="text-center empty-state">
                        <div class="empty-state-icon">
                            <i class="fa-solid fa-check-double"></i>
                        </div>
                        <h6>All requests have been processed!</h6>
                        <p>Your approval queue is currently empty.</p>
                    </td>
                </tr>`;
        }
    }

    // =========================================================
    // VIEW RECEIPT FILE
    // =========================================================
    function viewReceiptFile(filename) {

        Swal.fire({
            title: 'Attachment Receipt',
            text: `Viewing document: ${filename}`,
            icon: 'info',
            footer: '<span class="small text-secondary">PDF stream verification is active in ERP document system</span>'
        });
    }
</script>
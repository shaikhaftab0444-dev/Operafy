<div class="container-fluid text-start approval-page">

    <div class="approval-page-content">

        <div style="display:none;">
            @Html.AntiForgeryToken()
        </div>

        <!-- =====================================================
             PREMIUM HERO
        ====================================================== -->

        <div class="approval-hero">

            <div class="approval-hero-grid">

                <div class="approval-breadcrumb">

                    <nav aria-label="breadcrumb">

                        <ol class="breadcrumb">

                            @if (User.IsInRole("Finance Manager"))
                            {
                                <li class="breadcrumb-item">
                                    <a href="@Url.Action("Index", "Finance")"
                                       class="text-decoration-none">
                                        <i class="fa-solid fa-wallet me-1"></i>
                                        Finance Portal
                                    </a>
                                </li>

                                <li class="breadcrumb-item">
                                    Team Operations
                                </li>

                                <li class="breadcrumb-item active"
                                    aria-current="page">
                                    Team Approvals
                                </li>
                            }
                            else if (User.IsInRole("Sales Manager"))
                            {
                                <li class="breadcrumb-item">
                                    <a href="@Url.Action("Index", "SalesManagerDashboard")"
                                       class="text-decoration-none">
                                        <i class="fa-solid fa-chart-line me-1"></i>
                                        Sales Portal
                                    </a>
                                </li>

                                <li class="breadcrumb-item">
                                    Team Operations
                                </li>

                                <li class="breadcrumb-item active"
                                    aria-current="page">
                                    Team Approvals
                                </li>
                            }
                            else if (User.IsInRole("Inventory Manager"))
                            {
                                <li class="breadcrumb-item">
                                    <a href="@Url.Action("Index", "InventoryDashboard")"
                                       class="text-decoration-none">
                                        <i class="fa-solid fa-boxes-stacked me-1"></i>
                                        Inventory Portal
                                    </a>
                                </li>

                                <li class="breadcrumb-item">
                                    Team Operations
                                </li>

                                <li class="breadcrumb-item active"
                                    aria-current="page">
                                    Team Approvals
                                </li>
                            }
                            else
                            {
                                <li class="breadcrumb-item">
                                    <a href="@Url.Action("Index", "Manager")"
                                       class="text-decoration-none">
                                        <i class="fa-solid fa-user-tie me-1"></i>
                                        Manager Portal
                                    </a>
                                </li>

                                <li class="breadcrumb-item">
                                    Approvals
                                </li>

                                <li class="breadcrumb-item active"
                                    aria-current="page">
                                    Approval Center
                                </li>
                            }

                        </ol>

                    </nav>

                </div>

                <div class="approval-title-row">

                    <div class="approval-title-left">

                        <div class="approval-title-icon">
                            <i class="fa-solid fa-clipboard-check"></i>
                        </div>

                        <div class="approval-heading-wrap">

                            <div class="approval-heading-line">

                                <h4 class="approval-title">
                                    Unified Approval Center
                                </h4>

                                <div class="approval-pending-pill">
                                    <i class="fa-solid fa-clock"></i>
                                    <span>Pending</span>

                                    <span class="pending-count"
                                          id="pending-approvals-badge">
                                        @Model.Count()
                                    </span>
                                </div>

                            </div>

                            <p class="approval-subtitle">
                                Review and manage employee leave, regularization,
                                expense and approval requests from one centralized
                                workspace.
                            </p>

                        </div>

                    </div>

                    <div class="approval-hero-actions">

                        <button type="button"
                                class="bulk-approve-btn"
                                onclick="triggerBulkApproval()">

                            <i class="fa-solid fa-check-double"></i>

                            <span>
                                Bulk Approve Selected
                            </span>

                        </button>

                    </div>

                </div>

            </div>

        </div>


        <!-- =====================================================
             CATEGORY FILTERS + SEARCH
        ====================================================== -->

        <div class="approval-toolbar">

            <div class="approval-tabs">

                <a href="/Manager/Approvals?category=All"
                   class="approval-tab @(activeCategory == "All" ? "active" : "")">

                    <i class="fa-solid fa-layer-group"></i>

                    <span>All Requests</span>

                </a>


                <a href="/Manager/Approvals?category=Leave"
                   class="approval-tab @(activeCategory == "Leave" ? "active" : "")">

                    <i class="fa-solid fa-calendar-check"></i>

                    <span>Leaves</span>

                </a>


                <a href="/Manager/Approvals?category=Regularization"
                   class="approval-tab @(activeCategory == "Regularization" ? "active" : "")">

                    <i class="fa-solid fa-clock-rotate-left"></i>

                    <span>Regularization</span>

                </a>


                <a href="/Manager/Approvals?category=Expense"
                   class="approval-tab @(activeCategory == "Expense" ? "active" : "")">

                    <i class="fa-solid fa-receipt"></i>

                    <span>Expenses</span>

                </a>

            </div>
            <div class="approval-search">

                <i class="fa-solid fa-magnifying-glass"></i>

                <input type="text"
                       id="approvalsFilterSearch"
                       class="form-control"
                       placeholder="Search employee or request..."
                       onkeyup="localSearchApprovals()" />

            </div>

        </div>


        <!-- =====================================================
             APPROVAL TABLE
        ====================================================== -->

        <div class="approval-table-card">

            <div class="approval-table-top">

                <div class="table-section-title">

                    <div class="table-section-icon">
                        <i class="fa-solid fa-list-check"></i>
                    </div>

                    <div>

                        <h6>
                            Pending Approval Requests
                        </h6>

                        <span>
                            Review employee requests and take the required action.
                        </span>

                    </div>

                </div>


                <div class="table-live-status">

                    <span class="live-dot"></span>

                    Live Approval Queue

                </div>

            </div>


            <div class="table-responsive approval-table-wrapper">

                <table class="table table-hover align-middle approval-table"
                       id="approvalsDataTable">

                    <thead>

                        <tr>

                            <th style="width:4%;"
                                class="text-center">

                                <input type="checkbox"
                                       class="form-check-input approval-checkbox"
                                       id="selectAllCheckbox"
                                       onclick="toggleSelectAll(this)"
                                       title="Select All" />

                            </th>

                            <th style="width:22%;">
                                MANAGER & DEPARTMENT
                            </th>

                            <th style="width:15%;">
                                Request Type
                            </th>

                            <th style="width:18%;">
                                Duration / Dates
                            </th>

                            <th>
                                Reason / Purpose
                            </th>

                            <th style="width:10%;">
                                Attachment
                            </th>

                            <th style="width:17%;"
                                class="text-center">
                                Actions
                            </th>

                        </tr>

                    </thead>


                    <tbody>

                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="7"
                                    class="text-center empty-state">
                                    <div class="empty-state-icon">
                                        <i class="fa-solid fa-clipboard-check"></i>
                                    </div>
                                    <h6>
                                        All caught up!
                                    </h6>
                                    <p>
                                        No pending approval requests were found from your subordinate managers.
                                    </p>
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var req in Model)
                            {
                                var initials = string.IsNullOrEmpty(req.User?.FullName) ? "MG" : (req.User.FullName.Length >= 2 ? req.User.FullName.Substring(0, 2).ToUpper() : req.User.FullName.ToUpper());
                                <tr id="approval-tr-row-@req.Id"
                                    class="approval-data-row">

                                    <!-- SELECT -->
                                    <td class="text-center">
                                        <input type="checkbox"
                                               class="form-check-input approval-checkbox row-selection-checkbox"
                                               data-id="@req.Id"
                                               data-category="Leave" />
                                    </td>

                                    <!-- MANAGER & DEPARTMENT -->
                                    <td>
                                        <div class="employee-cell">
                                            <div class="employee-avatar text-uppercase">
                                                @initials
                                            </div>
                                            <div>
                                                <span class="employee-name">
                                                    @(req.User?.FullName ?? "Department Manager")
                                                </span>
                                                <span class="employee-role">
                                                    @(req.User?.Department?.DepartmentName ?? req.User?.DepartmentName ?? "Operations") Head
                                                </span>
                                            </div>
                                        </div>
                                    </td>

                                    <!-- CATEGORY / REQUEST TYPE -->
                                    <td>
                                        <span class="category-badge">
                                            <i class="fa-solid fa-tag"></i>
                                            @req.RequestType
                                        </span>
                                    </td>

                                    <!-- DURATION -->
                                    <td>
                                        <span class="duration-text">
                                            @req.StartDate.ToString("dd MMM") – @req.EndDate.ToString("dd MMM yyyy") (@req.TotalDays Days)
                                        </span>
                                        <span class="submitted-text">
                                            <i class="fa-regular fa-clock me-1"></i>
                                            Submitted:
                                            @req.CreatedAt.ToString("dd MMM yyyy")
                                        </span>
                                    </td>

                                    <!-- REASON -->
                                    <td>
                                        <div class="reason-text">
                                            @req.Reason
                                        </div>
                                    </td>

                                    <!-- ATTACHMENT -->
                                    <td>
                                        <span class="no-attachment">
                                            <i class="fa-solid fa-minus me-1"></i>
                                            N/A
                                        </span>
                                    </td>

                                    <!-- ACTIONS -->
                                    <td class="text-center">
                                        <div class="approval-actions">
                                            <button type="button"
                                                    class="btn approve-btn d-inline-flex align-items-center justify-content-center"
                                                    onclick="approveRequest(@req.Id)">
                                                <i class="fa-solid fa-check me-1"></i>
                                                Approve
                                            </button>

                                            <button type="button"
                                                    class="btn reject-btn d-inline-flex align-items-center justify-content-center"
                                                    onclick="handleApproval(@req.Id, 'Leave', 'Rejected')">
                                                <i class="fa-solid fa-xmark me-1"></i>
                                                Reject
                                            </button>
                                        </div>
                                    </td>

                                </tr>
                            }
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>


<script>

    // =========================================================
    // TOAST CONFIGURATION
    // =========================================================

    if (typeof toastr !== 'undefined') {

        toastr.options = {
            "closeButton": true,
            "progressBar": true,
            "positionClass": "toast-top-right",
            "timeOut": "3500",
            "extendedTimeOut": "1200"
        };

    }


    // =========================================================
    // SEARCH FILTER
    // =========================================================

    function localSearchApprovals() {

        const searchInput =
            document.getElementById("approvalsFilterSearch");

        if (!searchInput) return;

        const query =
            searchInput.value.toLowerCase().trim();

        const rows =
            document.querySelectorAll(".approval-data-row");

        rows.forEach(row => {

            const name =
                row.cells[1]
                    ? row.cells[1].innerText.toLowerCase()
                    : "";

            const reason =
                row.cells[4]
                    ? row.cells[4].innerText.toLowerCase()
                    : "";

            const category =
                row.cells[2]
                    ? row.cells[2].innerText.toLowerCase()
                    : "";

            if (
                name.includes(query) ||
                reason.includes(query) ||
                category.includes(query)
            ) {

                row.style.display = "";

            } else {

                row.style.display = "none";

            }

        });

    }


    // =========================================================
    // TOGGLE SELECT ALL
    // =========================================================

    function toggleSelectAll(master) {

        document
            .querySelectorAll(".row-selection-checkbox")
            .forEach(chk => {

                if (chk.closest("tr")?.style.display !== "none") {
                    chk.checked = master.checked;
                }

            });

    }


    // =========================================================
    // ROBUST SELF-CONTAINED APPROVAL HANDLER
    // =========================================================

    window.processApprovalAction = async function (
        id,
        type,
        decision,
        btnElement
    ) {

        if (!confirm(
            `Are you sure you want to mark this request as ${decision}?`
        )) {
            return;
        }


        let originalHtml = "";


        if (btnElement) {

            btnElement.disabled = true;

            originalHtml =
                btnElement.innerHTML;

            btnElement.innerHTML =
                '<span class="spinner-border spinner-border-sm me-1"></span> Processing...';

        }


        try {

            const token =
                document.querySelector(
                    'input[name="__RequestVerificationToken"]'
                )?.value || '';


            const params =
                new URLSearchParams();

            params.append('id', id);
            params.append('type', type);
            params.append('decision', decision);


            const response =
                await fetch(
                    '/Manager/ProcessSingleApproval',
                    {
                        method: 'POST',

                        headers: {
                            'Content-Type':
                                'application/x-www-form-urlencoded',

                            'RequestVerificationToken':
                                token
                        },

                        body: params.toString()
                    }
                );


            const data =
                await response.json();


            if (data.success) {

                const row =
                    (
                        btnElement
                            ? (
                                btnElement.closest('tr') ||
                                btnElement.closest('.approval-data-row')
                            )
                            : null
                    )
                    ||
                    document.getElementById(
                        `approval-tr-row-${id}`
                    );


                if (row) {

                    row.classList.add("fade-out-row");

                    setTimeout(() => {

                        row.remove();

                        checkEmptyTable();

                    }, 400);

                }


                if (typeof toastr !== 'undefined') {

                    toastr.success(
                        data.message ||
                        'Status updated successfully!'
                    );

                } else {

                    alert(
                        data.message ||
                        'Status updated successfully!'
                    );

                }


                const badge =
                    document.getElementById(
                        "pending-approvals-badge"
                    );


                if (badge) {

                    let count =
                        parseInt(badge.innerText);

                    if (
                        !isNaN(count) &&
                        count > 0
                    ) {

                        badge.innerText =
                            count - 1;

                    }

                }

            }
            else {

                if (typeof toastr !== 'undefined') {

                    toastr.error(
                        data.message ||
                        'Error occurred.'
                    );

                } else {

                    alert(
                        data.message ||
                        'Error occurred.'
                    );

                }


                if (btnElement) {

                    btnElement.disabled = false;

                    btnElement.innerHTML =
                        originalHtml;

                }

            }

        }
        catch (e) {

            console.error(
                "Action execution error:",
                e
            );


            if (typeof toastr !== 'undefined') {

                toastr.error(
                    "Operation failed. See console for details."
                );

            } else {

                alert(
                    "Operation failed. See console for details."
                );

            }


            if (btnElement) {

                btnElement.disabled = false;

                btnElement.innerHTML =
                    originalHtml;

            }

        }

    };


    // =========================================================
    // JOURNAL MANAGER DIRECT APPROVAL
    // =========================================================

    function approveRequest(id) {
        if (typeof Swal !== 'undefined') {
            Swal.fire({
                title: 'Approve Leave Request?',
                text: 'Confirm approval for this subordinate manager request?',
                icon: 'question',
                showCancelButton: true,
                confirmButtonColor: '#16a34a',
                cancelButtonColor: '#64748b',
                confirmButtonText: 'Yes, Approve'
            }).then((result) => {
                if (result.isConfirmed) {
                    executeApproveRequest(id);
                }
            });
        } else {
            if (confirm('Approve this leave request?')) {
                executeApproveRequest(id);
            }
        }
    }

    function executeApproveRequest(id) {
        $.ajax({
            url: '/Manager/ApproveRequest',
            type: 'POST',
            data: { id: id },
            success: function (res) {
                if (res.success) {
                    if (typeof toastr !== 'undefined') toastr.success(res.message);
                    const row = document.getElementById('approval-tr-row-' + id);
                    if (row) {
                        row.style.transition = 'all 0.4s ease';
                        row.style.opacity = '0';
                        setTimeout(() => row.remove(), 400);
                    }
                } else {
                    if (typeof toastr !== 'undefined') toastr.error(res.message);
                }
            },
            error: function () {
                sendApprovalAjax(id, 'Leave', 'Approved');
            }
        });
    }

    // =========================================================
    // SINGLE APPROVAL ACTION
    // =========================================================

    function handleApproval(
        id,
        category,
        actionType
    ) {

        if (actionType === "Rejected") {

            if (typeof Swal !== 'undefined') {

                Swal.fire({

                    title: 'Reject Request?',

                    text:
                        'Provide remarks or comments for rejection:',

                    input: 'text',

                    inputPlaceholder:
                        'Insufficient documentation / mismatch dates...',

                    icon: 'warning',

                    showCancelButton: true,

                    confirmButtonColor: '#dc2626',

                    cancelButtonColor: '#64748b',

                    confirmButtonText:
                        'Yes, reject request',

                    preConfirm: (value) => {

                        if (!value) {

                            Swal.showValidationMessage(
                                'Please write a rejection reason.'
                            );

                        }

                        return value;

                    }

                }).then((result) => {

                    if (result.isConfirmed) {

                        sendApprovalAjax(
                            id,
                            category,
                            'Rejected',
                            result.value
                        );

                    }

                });

            }
            else {

                const remarks =
                    prompt(
                        "Provide remarks or comments for rejection:"
                    );


                if (remarks !== null) {

                    if (remarks.trim() === "") {

                        alert(
                            "Rejection reason is required."
                        );

                    }
                    else {

                        sendApprovalAjax(
                            id,
                            category,
                            'Rejected',
                            remarks
                        );

                    }

                }

            }

        }
        else {

            sendApprovalAjax(
                id,
                category,
                'Approved'
            );

        }

    }


    // =========================================================
    // SEND SINGLE AJAX APPROVAL
    // =========================================================

    function sendApprovalAjax(
        id,
        category,
        actionType,
        remarks = ""
    ) {

        if (typeof toastr !== 'undefined') {

            toastr.info(
                `Sending ${actionType.toLowerCase()} request...`
            );

        }


        const formData =
            new FormData();


        formData.append(
            "id",
            id
        );

        formData.append(
            "category",
            category
        );

        formData.append(
            "actionType",
            actionType
        );

        formData.append(
            "remarks",
            remarks
        );


        const tokenInput =
            document.querySelector(
                'input[name="__RequestVerificationToken"]'
            );


        if (tokenInput) {

            formData.append(
                "__RequestVerificationToken",
                tokenInput.value
            );

        }


        fetch(
            "/Manager/ProcessApproval",
            {
                method: "POST",
                body: formData
            }
        )

        .then(res => {

            if (!res.ok) {

                throw new Error(
                    "HTTP " +
                    res.status +
                    " " +
                    res.statusText
                );

            }

            return res.json();

        })

        .then(data => {

            if (data.success) {

                if (typeof toastr !== 'undefined') {

                    toastr.success(
                        data.message
                    );

                } else {

                    alert(
                        data.message
                    );

                }


                const row =
                    document.getElementById(
                        `approval-tr-row-${id}`
                    );


                if (row) {

                    row.classList.add(
                        "fade-out-row"
                    );


                    setTimeout(() => {

                        row.remove();

                        checkEmptyTable();

                    }, 500);

                }


                const badge =
                    document.getElementById(
                        "pending-approvals-badge"
                    );


                if (badge) {

                    let count =
                        parseInt(
                            badge.innerText
                        );


                    if (
                        !isNaN(count) &&
                        count > 0
                    ) {

                        badge.innerText =
                            count - 1;

                    }

                }

            }
            else {

                if (typeof toastr !== 'undefined') {

                    toastr.error(
                        data.message
                    );

                } else {

                    alert(
                        "Error: " +
                        data.message
                    );

                }

            }

        })

        .catch(err => {

            console.error(
                "AJAX Error details: ",
                err
            );


            if (typeof Swal !== 'undefined') {

                Swal.fire(
                    "Action Failed",
                    err.message,
                    "error"
                );

            } else {

                alert(
                    "Action Failed: " +
                    err.message
                );

            }

        });

    }


    // =========================================================
    // BULK APPROVAL TRIGGER
    // =========================================================

    function triggerBulkApproval() {

        const selectedCheckboxes =
            document.querySelectorAll(
                ".row-selection-checkbox:checked"
            );


        if (selectedCheckboxes.length === 0) {

            if (typeof Swal !== 'undefined') {

                Swal.fire({

                    title:
                        'No Requests Selected',

                    text:
                        'Please select one or more requests before using bulk approval.',

                    icon:
                        'info',

                    confirmButtonColor:
                        '#2563eb'

                });

            }
            else {

                alert(
                    'No Requests Selected. Please check the box next to requests to approve them in bulk.'
                );

            }

            return;

        }


        const items =
            Array.from(selectedCheckboxes)
                .map(chk => ({

                    id:
                        parseInt(
                            chk.getAttribute(
                                "data-id"
                            )
                        ),

                    category:
                        chk.getAttribute(
                            "data-category"
                        )

                }));


        if (typeof Swal !== 'undefined') {

            Swal.fire({

                title:
                    'Bulk Approve Requests?',

                html:
                    `You are about to approve <strong>${items.length}</strong> selected request(s) at once.`,

                icon:
                    'question',

                showCancelButton:
                    true,

                confirmButtonColor:
                    '#2563eb',

                cancelButtonColor:
                    '#64748b',

                confirmButtonText:
                    'Yes, approve all'

            }).then((result) => {

                if (result.isConfirmed) {

                    sendBulkApprovalAjax(
                        items
                    );

                }

            });

        }
        else {

            if (
                confirm(
                    `You are about to approve ${items.length} selected requests at once. Proceed?`
                )
            ) {

                sendBulkApprovalAjax(
                    items
                );

            }

        }

    }


    // =========================================================
    // SEND BULK APPROVAL AJAX
    // =========================================================

    function sendBulkApprovalAjax(items) {

        if (typeof toastr !== 'undefined') {

            toastr.info(
                "Processing bulk approval..."
            );

        }


        const headers = {

            "Content-Type":
                "application/json"

        };


        const tokenInput =
            document.querySelector(
                'input[name="__RequestVerificationToken"]'
            );


        if (tokenInput) {

            headers["RequestVerificationToken"] =
                tokenInput.value;

        }


        fetch(
            "/Manager/BulkApprove",
            {
                method: "POST",

                headers: headers,

                body:
                    JSON.stringify(items)
            }
        )

        .then(res => {

            if (!res.ok) {

                throw new Error(
                    "HTTP " +
                    res.status +
                    " " +
                    res.statusText
                );

            }

            return res.json();

        })

        .then(data => {

            if (data.success) {

                if (typeof toastr !== 'undefined') {

                    toastr.success(
                        data.message
                    );

                } else {

                    alert(
                        data.message
                    );

                }


                items.forEach(item => {

                    const row =
                        document.getElementById(
                            `approval-tr-row-${item.id}`
                        );


                    if (row) {

                        row.classList.add(
                            "fade-out-row"
                        );


                        setTimeout(() => {

                            row.remove();

                            checkEmptyTable();

                        }, 500);

                    }

                });


                const selectAllCheckbox =
                    document.getElementById(
                        "selectAllCheckbox"
                    );


                if (selectAllCheckbox) {

                    selectAllCheckbox.checked =
                        false;

                }


                const badge =
                    document.getElementById(
                        "pending-approvals-badge"
                    );


                if (badge) {

                    let count =
                        parseInt(
                            badge.innerText
                        );


                    if (!isNaN(count)) {

                        badge.innerText =
                            Math.max(
                                0,
                                count -
                                (
                                    data.count ||
                                    items.length
                                )
                            );

                    }

                }

            }
            else {

                if (typeof toastr !== 'undefined') {

                    toastr.error(
                        data.message
                    );

                } else {

                    alert(
                        "Error: " +
                        data.message
                    );

                }

            }

        })

        .catch(err => {

            console.error(
                "Bulk AJAX Error details: ",
                err
            );


            if (typeof Swal !== 'undefined') {

                Swal.fire(
                    "Bulk Action Failed",
                    err.message,
                    "error"
                );

            } else {

                alert(
                    "Bulk Action Failed: " +
                    err.message
                );

            }

        });

    }


    // =========================================================
    // CHECK EMPTY TABLE
    // =========================================================

    function checkEmptyTable() {

        const tbody =
            document.querySelector(
                "#approvalsDataTable tbody"
            );


        if (!tbody) return;


        const remainingRows =
            tbody.querySelectorAll(
                ".approval-data-row"
            );


        if (remainingRows.length === 0) {

            tbody.innerHTML = `

                <tr>

                    <td colspan="7"
                        class="text-center empty-state">

                        <div class="empty-state-icon">

                            <i class="fa-solid fa-check-double"></i>

                        </div>

                        <h6>
                            All requests have been processed!
                        </h6>

                        <p>
                            Your approval queue is currently empty.
                        </p>

                    </td>

                </tr>

            `;

        }

    }


    // =========================================================
    // VIEW RECEIPT FILE
    // =========================================================

    function viewReceiptFile(filename) {

        Swal.fire({

            title:
                'Attachment Receipt',

            text:
                `Viewing document: ${filename}`,

            icon:
                'info',

            footer:
                '<span class="small text-secondary">PDF stream verification is active in ERP document system</span>'

        });

    }

</script>
@model IEnumerable<ERP_System.Models.ApprovalItemViewModel>
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Unified Approval Center";
    var activeCategory = ViewBag.ActiveCategory ?? "All";
}

<!-- CDN References -->
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" />
<script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>

<style>
    .glass-panel {
        background: rgba(255, 255, 255, 0.85);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border: 1px solid rgba(226, 232, 240, 0.8);
        border-radius: 16px;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.025);
    }
    .avatar-wrapper {
        width: 36px;
        height: 36px;
        border-radius: 50%;
        background-color: #64748b;
        color: #ffffff;
        font-weight: 700;
        font-size: 0.8rem;
    }
    .btn-group-glass {
        background: rgba(241, 245, 249, 0.8);
        border: 1px solid rgba(226, 232, 240, 0.8);
        border-radius: 30px;
        padding: 4px;
    }
    .btn-group-glass .btn-filter {
        border: none;
        background: transparent;
        color: #64748b;
        font-size: 0.775rem;
        font-weight: 600;
        padding: 8px 16px;
        border-radius: 20px;
        transition: all 0.2s ease;
        text-decoration: none;
    }
    .btn-group-glass .btn-filter.active {
        background: #ffffff;
        color: #2563eb;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
    }
    .fade-out-row {
        opacity: 0;
        transform: translateX(30px);
        transition: all 0.5s ease;
    }
    .hover-lift {
        transition: all 0.2s ease;
    }
    .hover-lift:hover {
        transform: translateY(-1px);
        box-shadow: 0 4px 12px rgba(37, 99, 235, 0.15);
    }
</style>

<div class="container-fluid py-4 text-start">
    <div style="display:none;">@Html.AntiForgeryToken()</div>
    
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1">
                    <li class="breadcrumb-item"><a href="/Manager" class="text-decoration-none">Manager Portal</a></li>
                    <li class="breadcrumb-item text-secondary">Approvals</li>
                    <li class="breadcrumb-item active" aria-current="page">Approval Center</li>
                </ol>
            </nav>
            <h4 class="fw-bold mb-1 text-dark"><i class="fa-solid fa-clipboard-check text-primary me-2"></i>Unified Approval Center</h4>
            <p class="text-secondary small mb-0">Approve or reject timecard regularizations, expense receipts, and vacation requests.</p>
        </div>
        <div>
            <button type="button" class="btn btn-outline-primary px-3.5 py-2 rounded-pill fw-bold hover-lift" onclick="triggerBulkApproval()">
                <i class="fa-solid fa-check-double me-1.5"></i>Bulk Approve Selected
            </button>
        </div>
    </div>

    <!-- Category Filters Tab Bar -->
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
        <div class="btn-group-glass d-flex">
            <a href="/Manager/Approvals?category=All" class="btn-filter @(activeCategory == "All" ? "active" : "")">📝 All Requests</a>
            <a href="/Manager/Approvals?category=Leave" class="btn-filter @(activeCategory == "Leave" ? "active" : "")">🏖️ Leaves</a>
            <a href="/Manager/Approvals?category=Regularization" class="btn-filter @(activeCategory == "Regularization" ? "active" : "")">⏱️ Regularization</a>
            <a href="/Manager/Approvals?category=Expense" class="btn-filter @(activeCategory == "Expense" ? "active" : "")">💵 Expenses</a>
        </div>
        
        <div class="d-flex align-items-center gap-2">
            <div class="input-group" style="max-width: 300px;">
                <span class="input-group-text bg-white border-end-0 text-muted" style="border-radius: 20px 0 0 20px;"><i class="fa-solid fa-magnifying-glass"></i></span>
                <input type="text" id="approvalsFilterSearch" class="form-control border-start-0" placeholder="Filter by employee name..." onkeyup="localSearchApprovals()" style="border-radius: 0 20px 20px 0; height: 38px; font-size: 0.85rem;" />
            </div>
        </div>
    </div>

    <!-- Approvals list table card -->
    <div class="glass-panel p-4">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0 text-start" style="font-size: 0.85rem;" id="approvalsDataTable">
                <thead class="table-light">
                    <tr>
                        <th style="width: 4%;" class="text-center">
                            <input type="checkbox" class="form-check-input" id="selectAllCheckbox" onclick="toggleSelectAll(this)" />
                        </th>
                        <th style="width: 22%;">Employee details</th>
                        <th style="width: 18%;">Claim Category</th>
                        <th style="width: 20%;">Duration / Dates</th>
                        <th>Reason / Purpose</th>
                        <th style="width: 10%;">Attachment</th>
                        <th style="width: 16%;" class="text-center">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center py-5 text-muted">No pending approvals logged in this category.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var request in Model)
                        {
                            <tr id="approval-tr-row-@request.Id" class="approval-data-row">
                                <td class="text-center">
                                    <input type="checkbox" class="form-check-input row-selection-checkbox" data-id="@request.Id" />
                                </td>
                                <td>
                                    <div class="d-flex align-items-center">
                                        <div class="avatar-wrapper d-flex align-items-center justify-content-center me-2.5 font-monospace text-uppercase">
                                            @request.Avatar
                                        </div>
                                        <div>
                                            <span class="fw-bold text-dark d-block">@request.EmployeeName</span>
                                            <span class="text-muted small" style="font-size: 0.725rem;">@request.Role</span>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <span class="badge bg-light text-secondary border px-2 py-1">@request.ClaimCategory</span>
                                </td>
                                <td class="fw-semibold text-secondary">
                                    @request.Duration
                                    <span class="text-muted small d-block" style="font-size: 0.7rem; font-weight: normal;">Submitted: @request.SubmittedDate</span>
                                </td>
                                <td class="text-muted small">@request.Reason</td>
                                <td>
                                    @if (request.HasAttachment)
                                    {
                                        <a href="/Manager/DownloadReceipt?filename=@request.AttachmentName" target="_blank" class="text-primary text-decoration-none fw-semibold small">
                                            <i class="fa-solid fa-file-pdf text-danger me-1"></i>Receipt
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="text-secondary small">N/A</span>
                                    }
                                </td>
                                <td class="text-center">
                                    <button class="btn btn-sm btn-success px-2.5 py-1 rounded-pill me-1 text-white fw-semibold" onclick="processApprovalAction(@request.Id, 'Approve')">
                                        <i class="fa-solid fa-check me-0.5"></i>Approve
                                    </button>
                                    <button class="btn btn-sm btn-outline-danger px-2.5 py-1 rounded-pill fw-semibold" onclick="processApprovalAction(@request.Id, 'Reject')">
                                        <i class="fa-solid fa-xmark me-0.5"></i>Reject
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

</div>

<script>
    // Search filter local
    function localSearchApprovals() {
        const query = document.getElementById("approvalsFilterSearch").value.toLowerCase();
        const rows = document.querySelectorAll(".approval-data-row");

        rows.forEach(row => {
            const name = row.cells[1].innerText.toLowerCase();
            const reason = row.cells[4].innerText.toLowerCase();
            if (name.includes(query) || reason.includes(query)) {
                row.style.display = "";
            } else {
                row.style.display = "none";
            }
        });
    }

    // Toggle Select All checkboxes
    function toggleSelectAll(master) {
        document.querySelectorAll(".row-selection-checkbox").forEach(chk => {
            chk.checked = master.checked;
        });
    }

    // Action single approval
    function processApprovalAction(id, actionType) {
        if (actionType === "Reject") {
            if (typeof Swal !== 'undefined') {
                // Rejection reason prompt using SweetAlert
                Swal.fire({
                    title: 'Reject Request?',
                    text: 'Provide remarks or comments for rejection:',
                    input: 'text',
                    inputPlaceholder: 'Insufficient documentation / mismatch dates...',
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#dc2626',
                    cancelButtonColor: '#64748b',
                    confirmButtonText: 'Yes, reject request',
                    preConfirm: (value) => {
                        if (!value) {
                            Swal.showValidationMessage('Please write a rejection reason.');
                        }
                        return value;
                    }
                }).then((result) => {
                    if (result.isConfirmed) {
                        sendApprovalAjax(id, 'Reject', result.value);
                    }
                });
            } else {
                // Standard prompt fallback
                const remarks = prompt("Provide remarks or comments for rejection:");
                if (remarks !== null) {
                    if (remarks.trim() === "") {
                        alert("Rejection reason is required.");
                    } else {
                        sendApprovalAjax(id, 'Reject', remarks);
                    }
                }
            }
        } else {
            sendApprovalAjax(id, 'Approve');
        }
    }

    // Send single AJAX approval
    function sendApprovalAjax(id, actionType, remarks = "") {
        if (typeof toastr !== 'undefined') {
            toastr.info(`Sending ${actionType.toLowerCase()} request...`);
        }

        const formData = new FormData();
        formData.append("id", id);
        formData.append("actionType", actionType);
        formData.append("remarks", remarks);

        // Retrieve token
        const tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
        if (tokenInput) {
            formData.append("__RequestVerificationToken", tokenInput.value);
        }

        fetch("/Manager/ProcessApproval", {
            method: "POST",
            body: formData
        })
        .then(res => {
            if (!res.ok) {
                throw new Error("HTTP " + res.status + " " + res.statusText);
            }
            return res.json();
        })
        .then(data => {
            if (data.success) {
                if (typeof toastr !== 'undefined') {
                    toastr.success(data.message);
                } else {
                    alert(data.message);
                }
                
                // Row removal animation
                const row = document.getElementById(`approval-tr-row-${id}`);
                if (row) {
                    row.classList.add("fade-out-row");
                    setTimeout(() => {
                        row.remove();
                        checkEmptyTable();
                    }, 500);
                }
            } else {
                if (typeof toastr !== 'undefined') {
                    toastr.error(data.message);
                } else {
                    alert("Error: " + data.message);
                }
            }
        })
        .catch(err => {
            console.error("AJAX Error details: ", err);
            if (typeof Swal !== 'undefined') {
                Swal.fire("Action Failed", err.message, "error");
            } else {
                alert("Action Failed: " + err.message);
            }
        });
    }

    // Bulk Approval Trigger
    function triggerBulkApproval() {
        const selectedCheckboxes = document.querySelectorAll(".row-selection-checkbox:checked");
        if (selectedCheckboxes.length === 0) {
            if (typeof Swal !== 'undefined') {
                Swal.fire('No Requests Selected', 'Please check the box next to requests to approve them in bulk.', 'info');
            } else {
                alert('No Requests Selected. Please check the box next to requests to approve them in bulk.');
            }
            return;
        }

        const ids = Array.from(selectedCheckboxes).map(chk => parseInt(chk.getAttribute("data-id")));

        if (typeof Swal !== 'undefined') {
            Swal.fire({
                title: 'Bulk Approve Requests?',
                text: `You are about to approve ${ids.length} selected requests at once.`,
                icon: 'question',
                showCancelButton: true,
                confirmButtonColor: '#2563eb',
                cancelButtonColor: '#64748b',
                confirmButtonText: 'Yes, approve all'
            }).then((result) => {
                if (result.isConfirmed) {
                    sendBulkApprovalAjax(ids);
                }
            });
        } else {
            if (confirm(`You are about to approve ${ids.length} selected requests at once. Proceed?`)) {
                sendBulkApprovalAjax(ids);
            }
        }
    }

    function sendBulkApprovalAjax(ids) {
        if (typeof toastr !== 'undefined') {
            toastr.info("Processing bulk approval...");
        }

        const headers = {
            "Content-Type": "application/json"
        };
        const tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
        if (tokenInput) {
            headers["RequestVerificationToken"] = tokenInput.value;
        }

        fetch("/Manager/BulkApprove", {
            method: "POST",
            headers: headers,
            body: JSON.stringify(ids)
        })
        .then(res => {
            if (!res.ok) {
                throw new Error("HTTP " + res.status + " " + res.statusText);
            }
            return res.json();
        })
        .then(data => {
            if (data.success) {
                if (typeof toastr !== 'undefined') {
                    toastr.success(data.message);
                } else {
                    alert(data.message);
                }
                
                // Remove all approved rows with fade out
                ids.forEach(id => {
                    const row = document.getElementById(`approval-tr-row-${id}`);
                    if (row) {
                        row.classList.add("fade-out-row");
                        setTimeout(() => {
                            row.remove();
                            checkEmptyTable();
                        }, 500);
                    }
                });
                document.getElementById("selectAllCheckbox").checked = false;
            } else {
                if (typeof toastr !== 'undefined') {
                    toastr.error(data.message);
                } else {
                    alert("Error: " + data.message);
                }
            }
        })
        .catch(err => {
            console.error("Bulk AJAX Error details: ", err);
            if (typeof Swal !== 'undefined') {
                Swal.fire("Bulk Action Failed", err.message, "error");
            } else {
                alert("Bulk Action Failed: " + err.message);
            }
        });
    }

    function checkEmptyTable() {
        const tbody = document.querySelector("#approvalsDataTable tbody");
        const remainingRows = tbody.querySelectorAll(".approval-data-row");
        if (remainingRows.length === 0) {
            tbody.innerHTML = '<tr><td colspan="7" class="text-center py-5 text-muted">No pending approvals logged in this category.</td></tr>';
        }
    }

    function viewReceiptFile(filename) {
        Swal.fire({
            title: 'Attachment Receipt',
            text: `Viewing document: ${filename}`,
            icon: 'info',
            footer: '<span class="small text-secondary">PDF stream verification is active in ERP document system</span>'
        });
    }
</script>

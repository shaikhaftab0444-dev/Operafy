@model ERP_System.Models.ManagerDashboardViewModel
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Manager Dashboard - Operations Hub";
}

<!-- Notification CDN libraries & Chart.js -->
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" />
<script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<style>
    .glass-panel {
        background: rgba(255, 255, 255, 0.85);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border: 1px solid rgba(226, 232, 240, 0.8);
        border-radius: 16px;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.025);
    }
    .metric-card {
        background: #ffffff;
        border: 1px solid rgba(226, 232, 240, 0.8);
        border-radius: 16px;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }
    .metric-card:hover {
        transform: translateY(-3px);
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.04);
    }
    .pulse-dot {
        width: 8px;
        height: 8px;
        background-color: #10b981;
        border-radius: 50%;
        display: inline-block;
        animation: pulse 1.5s infinite;
    }
    @@keyframes pulse {
        0% { transform: scale(0.9); box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.7); }
        70% { transform: scale(1); box-shadow: 0 0 0 6px rgba(16, 185, 129, 0); }
        100% { transform: scale(0.9); box-shadow: 0 0 0 0 rgba(16, 185, 129, 0); }
    }
    .avatar-wrapper {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        font-weight: 700;
        font-size: 0.75rem;
    }
</style>

<div class="container-fluid py-4 text-start">
    
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1">
                    <li class="breadcrumb-item"><a href="/Manager" class="text-decoration-none">Manager Portal</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Dashboard</li>
                </ol>
            </nav>
            <h4 class="fw-bold mb-1 text-dark"><i class="fa-solid fa-gauge-high text-primary me-2"></i>Manager Dashboard</h4>
            <p class="text-secondary small mb-0">Overview of active sprint status, live attendance rosters, and daily approvals.</p>
        </div>
        <div>
            <button type="button" class="btn btn-primary px-4 py-2 shadow-sm rounded-pill fw-bold" data-bs-toggle="modal" data-bs-target="#assignTaskModal">
                <i class="fa-solid fa-plus me-1.5"></i>Assign New Task
            </button>
        </div>
    </div>

    <!-- Top KPI cards row -->
    <div class="row g-3 mb-4">
        <!-- Card 1 -->
        <div class="col-md-3">
            <div class="metric-card p-3.5 shadow-sm d-flex align-items-center gap-3">
                <div class="bg-primary-subtle text-primary rounded-circle d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                    <i class="fa-solid fa-users fs-5"></i>
                </div>
                <div>
                    <span class="text-secondary small d-block">Direct Team Headcount</span>
                    <h5 class="fw-bold mb-0 text-dark">
                        @Model.TotalTeamCount Staff 
                        <span class="small text-muted font-normal ms-1">• @Model.PresentTodayCount Active <span class="pulse-dot ms-0.5"></span></span>
                    </h5>
                </div>
            </div>
        </div>

        <!-- Card 2 -->
        <div class="col-md-3">
            <div class="metric-card p-3.5 shadow-sm d-flex align-items-center gap-3">
                <div class="bg-warning-subtle text-warning rounded-circle d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                    <i class="fa-solid fa-clock-rotate-left fs-5"></i>
                </div>
                <div>
                    <span class="text-secondary small d-block">Pending Action Items</span>
                    <h5 class="fw-bold mb-0 text-dark" id="pendingApprovalsKpi">@Model.PendingApprovalsCount Waiting</h5>
                </div>
            </div>
        </div>

        <!-- Card 3 -->
        <div class="col-md-3">
            <div class="metric-card p-3.5 shadow-sm d-flex align-items-center gap-3">
                <div class="bg-info-subtle text-info rounded-circle d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                    <i class="fa-solid fa-list-check fs-5"></i>
                </div>
                <div>
                    <span class="text-secondary small d-block">Active Department Tasks</span>
                    <h5 class="fw-bold mb-0 text-dark">@Model.ActiveTasksCount In Progress <span class="small text-danger font-normal ms-1">• @Model.DelayedTasksCount Delayed</span></h5>
                </div>
            </div>
        </div>

        <!-- Card 4 -->
        <div class="col-md-3">
            <div class="metric-card p-3.5 shadow-sm d-flex align-items-center gap-3">
                <div class="bg-success-subtle text-success rounded-circle d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                    <i class="fa-solid fa-chart-line fs-5"></i>
                </div>
                <div>
                    <span class="text-secondary small d-block">Productivity Rate</span>
                    <h5 class="fw-bold mb-0 text-dark">@Model.ProductivityRate <span class="small text-success font-normal ms-1"><i class="fa-solid fa-arrow-trend-up"></i> Target</span></h5>
                </div>
            </div>
        </div>
    </div>

    <!-- Middle Row: Analytics + Live Attendance -->
    <div class="row g-4 mb-4">
        <div class="col-lg-8">
            <div class="glass-panel p-4 h-100">
                <h5 class="fw-bold text-dark mb-4 border-bottom pb-2">
                    <i class="fa-solid fa-chart-simple text-primary me-2"></i>Team Workload & Sprint Progress
                </h5>
                <div style="height: 280px; position: relative;">
                    <canvas id="teamWorkloadChart"></canvas>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="glass-panel p-4 h-100">
                <h5 class="fw-bold text-dark mb-4 border-bottom pb-2">
                    <i class="fa-solid fa-business-time text-primary me-2"></i>Today's Attendance Status
                </h5>
                <div class="d-flex flex-column gap-3">
                    @foreach (var m in Model.TeamAttendance)
                    {
                        var badgeClass = m.Status == "Present" ? "bg-success-subtle text-success" : (m.Status == "Late" ? "bg-warning-subtle text-warning" : "bg-danger-subtle text-danger");
                        <div class="d-flex align-items-center justify-content-between p-2.5 bg-light rounded-3 border">
                            <div class="d-flex align-items-center">
                                <div class="bg-secondary text-white avatar-wrapper d-flex align-items-center justify-content-center me-2.5 font-monospace">
                                    @m.Avatar
                                </div>
                                <div>
                                    <span class="fw-bold text-dark d-block" style="font-size: 0.85rem;">@m.Name</span>
                                    <span class="text-muted small" style="font-size: 0.7rem;">@m.Role</span>
                                </div>
                            </div>
                            <div class="text-end">
                                <span class="badge @badgeClass border px-2.5 py-1" style="font-size: 0.7rem;">@m.Status</span>
                                <span class="text-muted small d-block mt-0.5" style="font-size: 0.65rem;">In: @m.ClockInTime</span>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Bottom Row: Quick Approvals + Active Tasks -->
    <div class="row g-4">
        <!-- Quick Approvals -->
        <div class="col-lg-6">
            <div class="glass-panel p-4 h-100">
                <h5 class="fw-bold text-dark mb-4 border-bottom pb-2">
                    <i class="fa-solid fa-clipboard-check text-warning me-2"></i>Quick Approvals Inbox
                </h5>
                <div class="table-responsive">
                    <table class="table align-middle table-hover text-start" style="font-size: 0.825rem;">
                        <thead class="table-light">
                            <tr>
                                <th>Employee & Type</th>
                                <th>Details / Duration</th>
                                <th class="text-center" style="width: 32%;">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!Model.PendingApprovals.Any())
                            {
                                <tr>
                                    <td colspan="3" class="text-center py-4 text-muted">No pending approvals waiting.</td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var approval in Model.PendingApprovals)
                                {
                                    <tr id="approval-row-@approval.Id">
                                        <td>
                                            <span class="fw-bold text-dark d-block">@approval.EmployeeName</span>
                                            <span class="text-secondary small">@approval.Type</span>
                                        </td>
                                        <td>
                                            <span class="d-block text-secondary" style="font-size: 0.75rem;">@approval.Dates</span>
                                            <span class="text-muted small" style="font-size: 0.7rem;">Reason: @approval.Reason</span>
                                        </td>
                                        <td class="text-center">
                                            <button class="btn btn-sm btn-success px-2.5 rounded-pill me-1" onclick="submitApproval(@approval.Id, 'Approve')"><i class="fa-solid fa-check"></i> Approve</button>
                                            <button class="btn btn-sm btn-outline-danger px-2.5 rounded-pill" onclick="submitApproval(@approval.Id, 'Reject')"><i class="fa-solid fa-xmark"></i> Reject</button>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Team Tasks Grid -->
        <div class="col-lg-6">
            <div class="glass-panel p-4 h-100">
                <h5 class="fw-bold text-dark mb-4 border-bottom pb-2">
                    <i class="fa-solid fa-list-check text-primary me-2"></i>Active Team Tasks Board
                </h5>
                <div class="table-responsive">
                    <table class="table align-middle table-hover text-start" style="font-size: 0.825rem;" id="teamTasksTable">
                        <thead class="table-light">
                            <tr>
                                <th>Task Title</th>
                                <th>Assigned To</th>
                                <th>Progress</th>
                                <th>Priority</th>
                            </tr>
                        </thead>
                        <tbody id="teamTasksBody">
                            @foreach (var task in Model.TeamTasks)
                            {
                                var priorityClass = task.Priority == "Urgent" ? "bg-danger-subtle text-danger" : (task.Priority == "High" ? "bg-warning-subtle text-warning" : "bg-success-subtle text-success");
                                <tr>
                                    <td class="fw-bold text-dark">@task.Title</td>
                                    <td class="text-secondary">@task.AssignedTo</td>
                                    <td>
                                        <div class="d-flex align-items-center gap-2" style="width: 100px;">
                                            <div class="progress flex-fill" style="height: 5px;">
                                                <div class="progress-bar bg-primary" role="progressbar" style="width: @task.Progress%"></div>
                                            </div>
                                            <span class="small font-monospace">@task.Progress%</span>
                                        </div>
                                    </td>
                                    <td><span class="badge @priorityClass border px-2 py-1">@task.Priority</span></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

</div>

<!-- Assign New Task Modal -->
<div class="modal fade" id="assignTaskModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content glass-panel border shadow-lg text-start">
            <div class="modal-header border-bottom-0 pb-0">
                <h5 class="fw-bold text-dark"><i class="fa-solid fa-list-check text-primary me-2"></i>Delegate New Deliverable</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="assignTaskForm" onsubmit="submitNewTask(event)">
                @Html.AntiForgeryToken()
                <div class="modal-body py-3">
                    <div class="mb-3">
                        <label class="form-label small fw-bold text-secondary">Deliverable Title</label>
                        <input type="text" class="form-control" name="title" placeholder="Forecast sales Q3 metrics..." required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-bold text-secondary">Assigned Team Member</label>
                        <select class="form-select" name="assignedTo" required>
                            <option value="">Select Employee...</option>
                            @foreach (var m in Model.TeamAttendance)
                            {
                                <option value="@m.Name">@m.Name (@m.Role)</option>
                            }
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-bold text-secondary">Task Priority</label>
                        <select class="form-select" name="priority" required>
                            <option value="Low">Low Priority</option>
                            <option value="Medium" selected>Medium Priority</option>
                            <option value="High">High Priority</option>
                            <option value="Urgent">Urgent Priority</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-bold text-secondary">Target Due Date</label>
                        <input type="date" class="form-control" name="dueDate" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-bold text-secondary">Detailed Description</label>
                        <textarea class="form-control" name="description" rows="3" placeholder="Provide instructions..."></textarea>
                    </div>
                </div>
                <div class="modal-footer border-top-0 pt-0">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary fw-bold px-4">Delegate Task</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    const assignModal = new bootstrap.Modal(document.getElementById("assignTaskModal"));

    // Render Sprint workload chart
    document.addEventListener("DOMContentLoaded", function() {
        const ctx = document.getElementById("teamWorkloadChart").getContext("2d");
        
        // Dynamic labels and datasets mapped to TeamAttendance tasks
        const labels = ['Numan Khan', 'Aftab Shaik', 'Sneha Patil', 'Rohan Sharma', 'Zoya Malik', 'Sameer Verma'];
        const completedData = [3, 4, 1, 2, 2, 3];
        const activeData = [2, 1, 0, 1, 1, 1];

        new Chart(ctx, {
            type: 'bar',
            data: {
                labels: labels,
                datasets: [
                    {
                        label: 'Completed Tasks',
                        data: completedData,
                        backgroundColor: '#10b981',
                        borderRadius: 6
                    },
                    {
                        label: 'Active Tasks',
                        data: activeData,
                        backgroundColor: '#2563eb',
                        borderRadius: 6
                    }
                ]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                scales: {
                    y: {
                        beginAtZero: true,
                        grid: { color: '#f1f5f9' }
                    },
                    x: {
                        grid: { display: false }
                    }
                },
                plugins: {
                    legend: { position: 'top' }
                }
            }
        });
    });

    // Submit Approval / Rejection via AJAX
    function submitApproval(id, actionType) {
        toastr.info("Processing approval transaction...");

        fetch(`/Manager/ApproveLeave?id=${id}&actionType=${actionType}`, {
            method: "POST"
        })
        .then(res => res.json())
        .then(data => {
            if (data.success) {
                toastr.success(data.message);
                document.getElementById(`approval-row-${id}`).remove();
                decrementKpiCounter();
            } else {
                toastr.error(data.message);
            }
        });
    }

    // Submit New Task Allocation via AJAX
    function submitNewTask(e) {
        e.preventDefault();
        const form = document.getElementById("assignTaskForm");
        const formData = new FormData(form);

        toastr.info("Assigning deliverable task...");

        fetch("/Manager/AssignTask", {
            method: "POST",
            body: formData
        })
        .then(res => res.json())
        .then(data => {
            if (data.success) {
                toastr.success(data.message);
                assignModal.hide();
                form.reset();

                // Append new task to UI active task grid
                const tbody = document.getElementById("teamTasksBody");
                const priorityClass = data.task.priority === "Urgent" ? "bg-danger-subtle text-danger" : (data.task.priority === "High" ? "bg-warning-subtle text-warning" : "bg-success-subtle text-success");

                const newRow = `
                    <tr>
                        <td class="fw-bold text-dark">${data.task.title}</td>
                        <td class="text-secondary">${data.task.assignedTo}</td>
                        <td>
                            <div class="d-flex align-items-center gap-2" style="width: 100px;">
                                <div class="progress flex-fill" style="height: 5px;">
                                    <div class="progress-bar bg-primary" role="progressbar" style="width: 20%"></div>
                                </div>
                                <span class="small font-monospace">20%</span>
                            </div>
                        </td>
                        <td><span class="badge ${priorityClass} border px-2 py-1">${data.task.priority}</span></td>
                    </tr>`;
                
                tbody.insertAdjacentHTML("afterbegin", newRow);
            } else {
                toastr.error(data.message);
            }
        });
    }

    function decrementKpiCounter() {
        const kpi = document.getElementById("pendingApprovalsKpi");
        if (kpi) {
            let count = parseInt(kpi.innerText.split(" ")[0]);
            if (count > 0) {
                count--;
                kpi.innerText = `${count} Waiting`;
            }
        }
    }
</script>

@model IEnumerable<ERP_System.Models.Supplier>
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Supplier Directory";
}

<style>
    .panel-suppliers {
        background: #ffffff;
        border: 1px solid var(--border-warm);
        border-radius: 12px;
        box-shadow: 0 1px 3px rgba(45,37,30,0.03);
    }
    
    .table-suppliers th {
        background-color: #fcfbfa !important;
        font-size: 0.75rem;
        text-transform: uppercase;
        font-weight: 700;
        color: #7c7267;
        border-bottom: 1px solid var(--border-warm);
        padding: 1rem 1.25rem;
    }
    
    .table-suppliers td {
        font-size: 0.85rem;
        color: var(--text-color);
        border-bottom: 1px solid var(--border-warm);
        padding: 1rem 1.25rem;
        vertical-align: middle;
    }

    .badge-sup-active {
        background-color: rgba(16, 185, 129, 0.08);
        color: #10b981;
        font-weight: 600;
        border: 1px solid rgba(16, 185, 129, 0.2);
    }
    .badge-sup-inactive {
        background-color: rgba(239, 68, 68, 0.08);
        color: #ef4444;
        font-weight: 600;
        border: 1px solid rgba(239, 68, 68, 0.2);
    }
</style>

<!-- Top Breadcrumbs & Page Header -->
<div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-3 mb-4 text-start">
    <div>
        <h4 class="fw-bold mb-1" style="color: var(--text-color);">Supplier Management</h4>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0 small">
                <li class="breadcrumb-item"><a href="/Dashboard" class="text-decoration-none">Dashboard</a></li>
                <li class="breadcrumb-item active" aria-current="page">Suppliers</li>
            </ol>
        </nav>
    </div>
    
    <a href="/Suppliers/Create" class="btn btn-primary-warm px-4 py-2">
        <i class="fa-solid fa-plus me-2"></i> Register Supplier
    </a>
</div>

<!-- Alerts -->
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success border-0 shadow-sm alert-dismissible fade show mb-4 small text-start" role="alert" style="background-color: #f0fdf4; color: #15803d; border-left: 4px solid #16a34a !important;">
        <i class="fa-solid fa-circle-check me-2"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Search Input -->
<div class="row g-3 mb-4 text-start">
    <div class="col-md-6">
        <div class="input-group-warm" style="border: 1px solid #d4cbbd; border-radius: 8px; background-color: #ffffff; display: flex; align-items: center; padding: 2px;">
            <span style="padding: 0.6rem 0.5rem 0.6rem 1rem; color: #7c7267;"><i class="fa-solid fa-magnifying-glass"></i></span>
            <input type="text" id="searchSupplier" class="form-control" style="border: none !important; box-shadow: none !important; background: transparent; font-size: 0.9rem; padding: 0.6rem 1rem 0.6rem 0;" placeholder="Search suppliers by name, code, or city..." />
        </div>
    </div>
</div>

<!-- Suppliers Table -->
<div class="panel-suppliers overflow-hidden">
    <div class="table-responsive">
        <table class="table table-hover table-suppliers mb-0 border-0 text-start" id="suppliersTable">
            <thead>
                <tr>
                    <th class="border-0">Code</th>
                    <th class="border-0">Supplier Name</th>
                    <th class="border-0">Contact Details</th>
                    <th class="border-0">Location</th>
                    <th class="border-0">Tax IDs</th>
                    <th class="border-0 text-center">Status</th>
                    <th class="border-0 text-center">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var sup in Model)
                    {
                        <tr>
                            <td class="fw-bold text-secondary">@sup.SupplierCode</td>
                            <td class="fw-bold text-dark">
                                <div>@sup.SupplierName</div>
                                <div class="text-secondary font-weight-normal small" style="font-size:0.75rem;">@sup.ContactPerson (@sup.Designation)</div>
                            </td>
                            <td>
                                <div style="font-size:0.8rem;"><i class="fa-regular fa-envelope me-1 text-muted"></i>@sup.Email</div>
                                <div class="text-secondary" style="font-size:0.75rem;"><i class="fa-solid fa-mobile-screen-button me-1 text-muted"></i>@sup.Mobile</div>
                            </td>
                            <td>
                                <div>@sup.AddressLine1</div>
                                <div class="text-secondary small" style="font-size:0.75rem;">@sup.City, @sup.State - @sup.Country</div>
                            </td>
                            <td>
                                <div class="small" style="font-size:0.75rem;">GSTIN: <strong class="text-secondary">@(string.IsNullOrEmpty(sup.GSTIN) ? "N/A" : sup.GSTIN)</strong></div>
                                <div class="small" style="font-size:0.75rem;">PAN: <strong class="text-secondary">@(string.IsNullOrEmpty(sup.PANNumber) ? "N/A" : sup.PANNumber)</strong></div>
                            </td>
                            <td class="text-center">
                                @if (sup.IsActive)
                                {
                                    <span class="badge rounded-pill px-2.5 py-1.5 badge-sup-active" style="font-size: 0.75rem;">Active</span>
                                }
                                else
                                {
                                    <span class="badge rounded-pill px-2.5 py-1.5 badge-sup-inactive" style="font-size: 0.75rem;">Inactive</span>
                                }
                            </td>
                            <td class="text-center">
                                <div class="d-flex justify-content-center gap-2">
                                    <a href="/Suppliers/Edit/@sup.SupplierId" class="btn btn-sm btn-outline-secondary btn-sm-custom px-3 py-1">
                                        <i class="fa-regular fa-pen-to-square me-1"></i> Edit
                                    </a>
                                    
                                    <form asp-action="ToggleStatus" asp-route-id="@sup.SupplierId" method="post" style="display:inline;">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-sm-custom px-3 py-1 @(sup.IsActive ? "btn-outline-danger" : "btn-outline-success")">
                                            <i class="fa-solid @(sup.IsActive ? "fa-ban" : "fa-circle-check") me-1"></i>
                                            @(sup.IsActive ? "Deactivate" : "Activate")
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="text-center text-muted py-5">No supplier records registered in database directory.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", () => {
            const searchInput = document.getElementById("searchSupplier");
            const tableRows = document.querySelectorAll("#suppliersTable tbody tr");

            searchInput.addEventListener("input", () => {
                const query = searchInput.value.toLowerCase().trim();

                tableRows.forEach(row => {
                    if (row.cells.length < 6) return;

                    const code = row.cells[0].innerText.toLowerCase();
                    const name = row.cells[1].innerText.toLowerCase();
                    const location = row.cells[3].innerText.toLowerCase();

                    const matches = code.includes(query) || name.includes(query) || location.includes(query);

                    if (matches) {
                        row.style.display = "";
                    } else {
                        row.style.display = "none";
                    }
                });
            });
        });
    </script>
}

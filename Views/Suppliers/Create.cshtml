@model ERP_System.Models.Supplier
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Add Supplier Profile";
}

<style>
    .panel-form {
        background: #ffffff;
        border: 1px solid var(--border-warm);
        border-radius: 12px;
        box-shadow: 0 1px 3px rgba(45,37,30,0.03);
        padding: 2.5rem;
        max-width: 900px;
        margin: 0 auto;
    }

    .form-label-warm {
        font-size: 0.8rem;
        font-weight: 700;
        color: var(--text-color);
        margin-bottom: 6px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .input-group-warm {
        border: 1px solid #d4cbbd;
        border-radius: 8px;
        background-color: #fcfbfa;
        transition: all 0.2s ease-in-out;
        overflow: hidden;
        display: flex;
        align-items: center;
        width: 100%;
    }
    .input-group-warm:focus-within {
        border-color: var(--primary-warm);
        box-shadow: 0 0 0 4px rgba(79, 70, 229, 0.08);
        background-color: #ffffff;
    }

    .input-icon-warm {
        padding: 0.75rem 0.25rem 0.75rem 1rem;
        color: var(--sidebar-color);
        font-size: 0.95rem;
        display: flex;
        align-items: center;
    }

    .form-control-warm {
        border: none !important;
        box-shadow: none !important;
        background: transparent !important;
        color: var(--text-color) !important;
        font-size: 0.9rem !important;
        padding: 0.75rem 1rem !important;
        width: 100%;
    }
    
    .section-title-warm {
        font-size: 0.9rem;
        font-weight: 700;
        color: var(--primary-warm);
        text-transform: uppercase;
        letter-spacing: 0.5px;
        border-bottom: 1.5px solid var(--border-warm);
        padding-bottom: 6px;
        margin-bottom: 15px;
        margin-top: 10px;
    }
</style>

<!-- Breadcrumbs & Header -->
<div class="mb-4 text-center">
    <h4 class="fw-bold mb-1" style="color: var(--text-color);">Register Vendor Supplier</h4>
    <p class="text-muted small">Configure contact channels, tax IDs, bank accounts, and addresses for new suppliers.</p>
    <nav aria-label="breadcrumb" class="d-inline-block">
        <ol class="breadcrumb mb-0 small">
            <li class="breadcrumb-item"><a href="/Dashboard" class="text-decoration-none">Dashboard</a></li>
            <li class="breadcrumb-item"><a href="/Suppliers" class="text-decoration-none">Suppliers</a></li>
            <li class="breadcrumb-item active" aria-current="page">New Supplier</li>
        </ol>
    </nav>
</div>

<!-- Form Card -->
<div class="panel-form">
    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()

        <div class="row g-3 text-start">
            
            <!-- Section 1: General Details -->
            <div class="col-12"><div class="section-title-warm">General Details</div></div>

            <div class="col-md-4">
                <label asp-for="SupplierCode" class="form-label-warm">Supplier Code</label>
                <div class="input-group-warm">
                    <span class="input-icon-warm"><i class="fa-solid fa-barcode"></i></span>
                    <input asp-for="SupplierCode" class="form-control-warm" required />
                </div>
            </div>
            
            <div class="col-md-8">
                <label asp-for="SupplierName" class="form-label-warm">Supplier / Business Name</label>
                <div class="input-group-warm">
                    <span class="input-icon-warm"><i class="fa-solid fa-truck"></i></span>
                    <input asp-for="SupplierName" class="form-control-warm" placeholder="Company Name" required />
                </div>
            </div>

            <div class="col-md-6">
                <label asp-for="ContactPerson" class="form-label-warm">Contact Representative</label>
                <div class="input-group-warm">
                    <span class="input-icon-warm"><i class="fa-regular fa-user"></i></span>
                    <input asp-for="ContactPerson" class="form-control-warm" placeholder="Full Name" />
                </div>
            </div>

            <div class="col-md-6">
                <label asp-for="Designation" class="form-label-warm">Representative Designation</label>
                <div class="input-group-warm">
                    <span class="input-icon-warm"><i class="fa-solid fa-user-tie"></i></span>
                    <input asp-for="Designation" class="form-control-warm" placeholder="e.g. Sales Manager" />
                </div>
            </div>

            <!-- Section 2: Contact Information -->
            <div class="col-12"><div class="section-title-warm">Contact Channels</div></div>

            <div class="col-md-4">
                <label asp-for="Email" class="form-label-warm">Business Email</label>
                <div class="input-group-warm">
                    <span class="input-icon-warm"><i class="fa-regular fa-envelope"></i></span>
                    <input asp-for="Email" type="email" class="form-control-warm" placeholder="vendor@example.com" />
                </div>
            </div>

            <div class="col-md-4">
                <label asp-for="Mobile" class="form-label-warm">Mobile Number</label>
                <div class="input-group-warm">
                    <span class="input-icon-warm"><i class="fa-solid fa-mobile-screen-button"></i></span>
                    <input asp-for="Mobile" class="form-control-warm" placeholder="Primary Contact" required />
                </div>
            </div>

            <div class="col-md-4">
                <label asp-for="Phone" class="form-label-warm">Telephone / Landline</label>
                <div class="input-group-warm">
                    <span class="input-icon-warm"><i class="fa-solid fa-phone"></i></span>
                    <input asp-for="Phone" class="form-control-warm" placeholder="Support desk number" />
                </div>
            </div>

            <!-- Section 3: Billing Address -->
            <div class="col-12"><div class="section-title-warm">Billing Address</div></div>

            <div class="col-12">
                <label asp-for="AddressLine1" class="form-label-warm">Address Line 1</label>
                <div class="input-group-warm">
                    <span class="input-icon-warm"><i class="fa-solid fa-location-dot"></i></span>
                    <input asp-for="AddressLine1" class="form-control-warm" placeholder="Unit, building number, street..." required />
                </div>
            </div>

            <div class="col-md-3">
                <label asp-for="City" class="form-label-warm">City</label>
                <input asp-for="City" class="form-control form-control-warm border" style="border: 1px solid #d4cbbd !important; border-radius: 8px !important;" placeholder="City" required />
            </div>
            <div class="col-md-3">
                <label asp-for="State" class="form-label-warm">State</label>
                <input asp-for="State" class="form-control form-control-warm border" style="border: 1px solid #d4cbbd !important; border-radius: 8px !important;" placeholder="State" required />
            </div>
            <div class="col-md-3">
                <label asp-for="Country" class="form-label-warm">Country</label>
                <input asp-for="Country" class="form-control form-control-warm border" style="border: 1px solid #d4cbbd !important; border-radius: 8px !important;" placeholder="Country" required />
            </div>
            <div class="col-md-3">
                <label asp-for="PostalCode" class="form-label-warm">Postal / ZIP Code</label>
                <input asp-for="PostalCode" class="form-control form-control-warm border" style="border: 1px solid #d4cbbd !important; border-radius: 8px !important;" placeholder="ZIP" />
            </div>

            <!-- Section 4: Taxation & Billing Settings -->
            <div class="col-12"><div class="section-title-warm">Tax & Commercial details</div></div>

            <div class="col-md-4">
                <label asp-for="GSTIN" class="form-label-warm">GSTIN Number</label>
                <input asp-for="GSTIN" class="form-control form-control-warm border" style="border: 1px solid #d4cbbd !important; border-radius: 8px !important;" placeholder="GST Tax Registration ID" />
            </div>
            <div class="col-md-4">
                <label asp-for="PANNumber" class="form-label-warm">PAN Number</label>
                <input asp-for="PANNumber" class="form-control form-control-warm border" style="border: 1px solid #d4cbbd !important; border-radius: 8px !important;" placeholder="Tax Account ID" />
            </div>
            <div class="col-md-4">
                <label asp-for="CreditLimit" class="form-label-warm">Credit Limit (INR)</label>
                <input asp-for="CreditLimit" type="number" min="0" step="0.01" class="form-control form-control-warm border" style="border: 1px solid #d4cbbd !important; border-radius: 8px !important;" placeholder="e.g. 50000.00" />
            </div>

            <!-- Section 5: Banking details -->
            <div class="col-12"><div class="section-title-warm">Bank Settlements</div></div>

            <div class="col-md-6">
                <label asp-for="BankName" class="form-label-warm">Bank Name</label>
                <input asp-for="BankName" class="form-control form-control-warm border" style="border: 1px solid #d4cbbd !important; border-radius: 8px !important;" placeholder="Settlement bank" />
            </div>
            <div class="col-md-6">
                <label asp-for="AccountNumber" class="form-label-warm">Bank Account Number</label>
                <input asp-for="AccountNumber" class="form-control form-control-warm border" style="border: 1px solid #d4cbbd !important; border-radius: 8px !important;" placeholder="Acc Number" />
            </div>
            <div class="col-md-6">
                <label asp-for="IFSCCode" class="form-label-warm">IFSC Code / Routing</label>
                <input asp-for="IFSCCode" class="form-control form-control-warm border" style="border: 1px solid #d4cbbd !important; border-radius: 8px !important;" placeholder="IFSC Code" />
            </div>
            <div class="col-md-6">
                <label asp-for="UPIId" class="form-label-warm">UPI ID / VPA</label>
                <input asp-for="UPIId" class="form-control form-control-warm border" style="border: 1px solid #d4cbbd !important; border-radius: 8px !important;" placeholder="UPI address" />
            </div>
        </div>

        <!-- Form Buttons -->
        <div class="d-flex justify-content-end gap-3 mt-4">
            <a href="/Suppliers" class="btn btn-secondary-warm" style="border: 1px solid var(--border-warm); background-color: #ffffff; color: var(--text-color); padding: 0.75rem 2rem; border-radius: 8px; font-weight: 600; font-size: 0.9rem; text-decoration: none;">Cancel</a>
            <button type="submit" class="btn btn-primary-warm" style="background: linear-gradient(135deg, var(--primary-warm) 0%, #6366f1 100%); color: #ffffff; border: none; padding: 0.75rem 2rem; border-radius: 8px; font-weight: 600; font-size: 0.9rem; box-shadow: 0 4px 10px rgba(79, 70, 229, 0.2);">Register Vendor</button>
        </div>
    </form>
</div>

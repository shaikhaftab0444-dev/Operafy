@model IEnumerable<ERP_System.Models.AdminAnnouncement>
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "System Broadcast Announcements";
}

<div class="container-fluid py-4 text-start">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-bold mb-1"><i class="fa-solid fa-bullhorn text-primary me-2"></i>System Broadcasts Noticeboard</h4>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0 small">
                    <li class="breadcrumb-item"><a href="/SuperAdminDashboard" class="text-decoration-none">Dashboard</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Broadcasts</li>
                </ol>
            </nav>
        </div>
        <button class="btn btn-primary rounded-pill px-3 btn-sm shadow-sm" data-bs-toggle="modal" data-bs-target="#announceModal">
            <i class="fa-solid fa-plus me-1.5"></i>Create Announcement
        </button>
    </div>

    <!-- Announcement Feeds -->
    <div class="row">
        <div class="col-lg-8">
            @if (Model != null && Model.Any())
            {
                @foreach (var a in Model)
                {
                    <div class="bg-white border rounded-3 p-4 shadow-sm mb-3">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <h5 class="fw-bold text-dark mb-0">@a.Title</h5>
                            <span class="text-muted small"><i class="fa-solid fa-clock me-1"></i>@a.CreatedAt.ToString("dd MMM yyyy hh:mm tt")</span>
                        </div>
                        <p class="text-muted mb-3" style="font-size: 0.9rem;">@a.Content</p>
                        <span class="small fw-semibold text-secondary">Published by @a.PostedBy</span>
                    </div>
                }
            }
        </div>
    </div>
</div>

<!-- Broadcast Modal -->
<div class="modal fade text-start" id="announceModal" tabindex="-1" aria-labelledby="announceModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form action="/SuperAdminBroadcasts/CreateAnnouncement" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title fw-bold" id="announceModalLabel">Broadcast System Announcement</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Announcement Title</label>
                        <input type="text" name="Title" class="form-control" placeholder="e.g. Critical Update" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Message Body</label>
                        <textarea name="Content" class="form-control" rows="4" placeholder="Enter message here..." required></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary rounded-pill px-3 btn-sm" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary rounded-pill px-3 btn-sm">Broadcast Notice</button>
                </div>
            </form>
        </div>
    </div>
</div>

@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Statutory Tax & Compliance Packages";
}

<div class="container-fluid py-4 text-start">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-bold mb-1"><i class="fa-solid fa-file-shield text-primary me-2"></i>Statutory Tax & Compliance Packages</h4>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0 small">
                    <li class="breadcrumb-item"><a href="/SuperAdminDashboard" class="text-decoration-none">Dashboard</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Compliance Packages</li>
                </ol>
            </nav>
        </div>
    </div>

    <!-- Compliance Packages Table -->
    <div class="bg-white border rounded-3 p-4 shadow-sm" style="max-width: 600px;">
        <h5 class="fw-bold mb-3">Audit Packages</h5>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" style="font-size: 0.85rem;">
                <thead class="table-light">
                    <tr>
                        <th>Tax Package Title</th>
                        <th>Fiscal Year</th>
                        <th class="text-center">Download Action</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td class="fw-bold text-dark">GST Consolidated Inward/Outward Audit</td>
                        <td>FY 2026-27</td>
                        <td class="text-center">
                            <button class="btn btn-sm btn-outline-primary px-3 rounded-pill" onclick="alert('Downloading GST consolidated audit package...')"><i class="fa-solid fa-download me-1"></i> ZIP</button>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

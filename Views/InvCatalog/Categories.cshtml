@model IEnumerable<ERP_System.Models.Product>

@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Product Categories";

    var categories = Model != null
        ? Model
            .Where(p => !string.IsNullOrWhiteSpace(p.Category))
            .Select(p => p.Category)
            .Distinct()
            .OrderBy(c => c)
            .ToList()
        : new List<string>();
}

<div class="container-fluid px-3 px-md-4 py-4 product-category-page">

    <!-- Page Header -->
    <div class="page-header-card mb-4">
        <div class="d-flex flex-column flex-lg-row justify-content-between align-items-start align-items-lg-center gap-4">

            <div class="d-flex align-items-start gap-3">
                <div class="page-icon">
                    <i class="fa-solid fa-tags"></i>
                </div>

                <div>
                    <nav aria-label="breadcrumb" class="mb-2">
                        <ol class="breadcrumb custom-breadcrumb mb-0">
                            <li class="breadcrumb-item">
                                <a href="/InventoryDashboard">
                                    <i class="fa-solid fa-arrow-left me-1"></i>
                                    Inventory Dashboard
                                </a>
                            </li>
                            <li class="breadcrumb-item active" aria-current="page">
                                Categories
                            </li>
                        </ol>
                    </nav>

                    <h2 class="page-title mb-2">Product Categories</h2>

                    <p class="page-subtitle mb-0">
                        Organize and monitor product categories across your inventory.
                    </p>
                </div>
            </div>

            <a href="/InventoryDashboard" class="btn btn-dashboard">
                <i class="fa-solid fa-chart-pie me-2"></i>
                Dashboard
            </a>

        </div>
    </div>

    <!-- Summary Cards -->
    <div class="row g-3 mb-4">

        <div class="col-12 col-md-4">
            <div class="summary-card">
                <div class="summary-content">
                    <span class="summary-label">TOTAL CATEGORIES</span>
                    <h3 class="summary-value">@categories.Count</h3>
                    <span class="summary-description">
                        Registered product categories
                    </span>
                </div>

                <div class="summary-icon summary-icon-blue">
                    <i class="fa-solid fa-layer-group"></i>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-4">
            <div class="summary-card">
                <div class="summary-content">
                    <span class="summary-label">ACTIVE CATEGORIES</span>
                    <h3 class="summary-value text-success">@categories.Count</h3>
                    <span class="summary-description">
                        Categories currently available
                    </span>
                </div>

                <div class="summary-icon summary-icon-green">
                    <i class="fa-solid fa-circle-check"></i>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-4">
            <div class="summary-card">
                <div class="summary-content">
                    <span class="summary-label">PRODUCT RECORDS</span>
                    <h3 class="summary-value">@(Model?.Count() ?? 0)</h3>
                    <span class="summary-description">
                        Products linked to categories
                    </span>
                </div>

                <div class="summary-icon summary-icon-purple">
                    <i class="fa-solid fa-boxes-stacked"></i>
                </div>
            </div>
        </div>

    </div>

    <!-- Category Master Section -->
    <div class="content-card">

        <div class="content-card-header">
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3">

                <div class="d-flex align-items-center gap-3">
                    <div class="section-icon">
                        <i class="fa-solid fa-list"></i>
                    </div>

                    <div>
                        <h5 class="section-title mb-1">Category Master</h5>
                        <p class="section-subtitle mb-0">
                            View all product categories registered in the system.
                        </p>
                    </div>
                </div>

                <div class="record-count">
                    <i class="fa-solid fa-database me-1"></i>
                    Showing @categories.Count categories
                </div>

            </div>
        </div>

        <div class="content-card-body">

            @if (categories.Any())
            {
                <div class="table-responsive">
                    <table class="table category-table align-middle mb-0">

                        <thead>
                            <tr>
                                <th class="category-number-column">#</th>
                                <th>Category Name</th>
                                <th>Sub-Categories Count</th>
                                <th>Status</th>
                            </tr>
                        </thead>

                        <tbody>
                            @{
                                var categoryIndex = 1;
                            }

                            @foreach (var cat in categories)
                            {
                                <tr>
                                    <td>
                                        <span class="category-number">
                                            @categoryIndex
                                        </span>
                                    </td>

                                    <td>
                                        <div class="category-name-wrapper">
                                            <div class="category-avatar">
                                                <i class="fa-solid fa-tag"></i>
                                            </div>

                                            <div>
                                                <div class="category-name">
                                                    @cat
                                                </div>

                                                <div class="category-description">
                                                    Product classification
                                                </div>
                                            </div>
                                        </div>
                                    </td>

                                    <td>
                                        <span class="sub-category-badge">
                                            <i class="fa-solid fa-layer-group me-1"></i>
                                            2 Sub-Categories
                                        </span>
                                    </td>

                                    <td>
                                        <span class="status-badge">
                                            <span class="status-dot"></span>
                                            Active
                                        </span>
                                    </td>
                                </tr>

                                categoryIndex++;
                            }
                        </tbody>

                    </table>
                </div>
            }
            else
            {
                <div class="empty-state">
                    <div class="empty-state-icon">
                        <i class="fa-solid fa-tags"></i>
                    </div>

                    <h5 class="empty-state-title">No Categories Found</h5>

                    <p class="empty-state-description mb-0">
                        No product categories were found in the database.
                    </p>
                </div>
            }

        </div>

        <div class="content-card-footer">
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-2">
                <span>
                    <i class="fa-solid fa-circle-info me-1"></i>
                    Category information is based on registered product records.
                </span>

                <span>
                    Total: <strong>@categories.Count</strong>
                </span>
            </div>
        </div>

    </div>

</div>

<style>
    .product-category-page {
        background: #f4f7fb;
        min-height: calc(100vh - 80px);
    }

    .page-header-card {
        position: relative;
        overflow: hidden;
        padding: 30px;
        background: #ffffff;
        border: 1px solid #e5eaf1;
        border-radius: 22px;
        box-shadow: 0 8px 25px rgba(31, 45, 61, 0.04);
    }

        .page-header-card::before {
            content: "";
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 4px;
            background: linear-gradient(90deg, #1677ff, #635bff);
        }

    .page-icon {
        width: 58px;
        height: 58px;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #ffffff;
        background: linear-gradient(135deg, #2878f0, #4f46e5);
        border-radius: 16px;
        font-size: 23px;
        box-shadow: 0 10px 22px rgba(37, 99, 235, 0.2);
    }

    .custom-breadcrumb {
        font-size: 13px;
        color: #8a9ab3;
    }

        .custom-breadcrumb a {
            color: #71819a;
            text-decoration: none;
            transition: color 0.2s ease;
        }

            .custom-breadcrumb a:hover {
                color: #2563eb;
            }

        .custom-breadcrumb .breadcrumb-item + .breadcrumb-item::before {
            color: #b5c0cf;
            content: "/";
        }

        .custom-breadcrumb .active {
            color: #2563eb;
            font-weight: 600;
        }

    .page-title {
        color: #17233c;
        font-size: clamp(24px, 3vw, 34px);
        font-weight: 750;
        letter-spacing: -1.2px;
    }

    .page-subtitle {
        color: #8291a8;
        font-size: 14px;
        line-height: 1.6;
    }

    .btn-dashboard {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 42px;
        padding: 10px 18px;
        color: #526177;
        background: #ffffff;
        border: 1px solid #dce4ee;
        border-radius: 11px;
        font-size: 13px;
        font-weight: 650;
        transition: all 0.2s ease;
    }

        .btn-dashboard:hover {
            color: #2563eb;
            background: #f5f8ff;
            border-color: #b9cdf5;
            transform: translateY(-1px);
        }

    .summary-card {
        position: relative;
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        min-height: 145px;
        padding: 25px 20px;
        overflow: hidden;
        background: #ffffff;
        border: 1px solid #e4e9f0;
        border-radius: 18px;
        box-shadow: 0 7px 20px rgba(31, 45, 61, 0.035);
    }

        .summary-card::after {
            content: "";
            position: absolute;
            top: -35px;
            right: -35px;
            width: 105px;
            height: 105px;
            background: #f7f9fc;
            border-radius: 50%;
            z-index: 0;
        }

    .summary-content,
    .summary-icon {
        position: relative;
        z-index: 1;
    }

    .summary-label {
        display: block;
        margin-bottom: 12px;
        color: #6b7d97;
        font-size: 11px;
        font-weight: 750;
        letter-spacing: 0.7px;
    }

    .summary-value {
        margin-bottom: 6px;
        color: #1d2940;
        font-size: 26px;
        font-weight: 750;
        letter-spacing: -0.8px;
    }

    .summary-description {
        color: #9aa9bd;
        font-size: 12px;
    }

    .summary-icon {
        width: 43px;
        height: 43px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 13px;
        font-size: 17px;
    }

    .summary-icon-blue {
        color: #2563eb;
        background: #edf4ff;
    }

    .summary-icon-green {
        color: #16a05d;
        background: #eafaf1;
    }

    .summary-icon-purple {
        color: #7c3aed;
        background: #f3edff;
    }

    .content-card {
        overflow: hidden;
        background: #ffffff;
        border: 1px solid #e3e8ef;
        border-radius: 20px;
        box-shadow: 0 8px 25px rgba(31, 45, 61, 0.035);
    }

    .content-card-header {
        padding: 23px 25px;
        border-bottom: 1px solid #edf0f5;
    }

    .section-icon {
        width: 42px;
        height: 42px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #1685d9;
        background: #eaf7ff;
        border-radius: 12px;
        font-size: 17px;
    }

    .section-title {
        color: #1c2940;
        font-size: 17px;
        font-weight: 750;
        letter-spacing: -0.3px;
    }

    .section-subtitle {
        color: #9aa9bd;
        font-size: 12px;
    }

    .record-count {
        color: #8291a8;
        font-size: 12px;
        font-weight: 600;
    }

    .content-card-body {
        padding: 0;
    }

    .category-table {
        min-width: 650px;
        color: #344258;
        font-size: 13px;
    }

        .category-table thead th {
            padding: 17px 25px;
            color: #687b96;
            background: #f8fafc;
            border-bottom: 1px solid #e5eaf1;
            font-size: 11px;
            font-weight: 750;
            letter-spacing: 0.55px;
            text-transform: uppercase;
            white-space: nowrap;
        }

        .category-table tbody td {
            padding: 18px 25px;
            border-bottom: 1px solid #edf1f5;
            vertical-align: middle;
        }

        .category-table tbody tr:last-child td {
            border-bottom: none;
        }

        .category-table tbody tr {
            transition: background 0.2s ease;
        }

            .category-table tbody tr:hover {
                background: #f8fbff;
            }

    .category-number-column {
        width: 70px;
    }

    .category-number {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 28px;
        height: 28px;
        color: #6d7f98;
        background: #f1f5f9;
        border-radius: 8px;
        font-size: 12px;
        font-weight: 700;
    }

    .category-name-wrapper {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .category-avatar {
        width: 39px;
        height: 39px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        color: #2563eb;
        background: #edf4ff;
        border-radius: 11px;
        font-size: 15px;
    }

    .category-name {
        color: #202d43;
        font-size: 13px;
        font-weight: 700;
    }

    .category-description {
        margin-top: 3px;
        color: #9aa9bd;
        font-size: 11px;
    }

    .sub-category-badge {
        display: inline-flex;
        align-items: center;
        padding: 7px 11px;
        color: #62738b;
        background: #f7f9fc;
        border: 1px solid #e3e9f1;
        border-radius: 9px;
        font-size: 12px;
        white-space: nowrap;
    }

    .status-badge {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 7px 12px;
        color: #16864e;
        background: #edfbf3;
        border: 1px solid #c8f1d9;
        border-radius: 999px;
        font-size: 12px;
        font-weight: 650;
    }

    .status-dot {
        width: 6px;
        height: 6px;
        background: #18a957;
        border-radius: 50%;
    }

    .content-card-footer {
        padding: 15px 25px;
        color: #99a8bb;
        background: #fbfcfe;
        border-top: 1px solid #edf1f5;
        font-size: 11px;
    }

        .content-card-footer strong {
            color: #65758d;
        }

    .empty-state {
        padding: 65px 20px;
        text-align: center;
    }

    .empty-state-icon {
        width: 72px;
        height: 72px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 18px;
        color: #91a1b6;
        background: #f2f5f9;
        border-radius: 20px;
        font-size: 28px;
    }

    .empty-state-title {
        color: #26344b;
        font-size: 17px;
        font-weight: 750;
    }

    .empty-state-description {
        color: #98a7ba;
        font-size: 13px;
    }

    @@media (max-width: 767.98px) {
        .product-category-page

    {
        padding-top: 20px !important;
    }

    .page-header-card {
        padding: 22px 18px;
        border-radius: 17px;
    }

    .page-icon {
        width: 48px;
        height: 48px;
        border-radius: 13px;
        font-size: 19px;
    }

    .page-title {
        font-size: 25px;
    }

    .page-subtitle {
        font-size: 13px;
    }

    .btn-dashboard {
        width: 100%;
    }

    .summary-card {
        min-height: 125px;
        padding: 20px;
    }

    .summary-value {
        font-size: 24px;
    }

    .content-card-header {
        padding: 20px 18px;
    }

    .category-table thead th,
    .category-table tbody td {
        padding-left: 18px;
        padding-right: 18px;
    }

    .content-card-footer {
        padding: 14px 18px;
    }

    }
</style>
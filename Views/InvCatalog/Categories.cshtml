@model IEnumerable<ERP_System.Models.Product>
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Product Categories";
    var categories = Model != null ? Model.Select(p => p.Category).Distinct().ToList() : new List<string>();
}

<div class="container-fluid py-4 text-start">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-bold mb-1"><i class="fa-solid fa-tags text-primary me-2"></i>Product Categories</h4>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0 small">
                    <li class="breadcrumb-item"><a href="/InventoryDashboard" class="text-decoration-none">Inventory Dashboard</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Categories</li>
                </ol>
            </nav>
        </div>
    </div>

    <!-- Categories Table -->
    <div class="bg-white border rounded-3 p-4 shadow-sm" style="max-width: 600px;">
        <h5 class="fw-bold mb-3">Category Master</h5>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" style="font-size: 0.85rem;">
                <thead class="table-light">
                    <tr>
                        <th>Category Name</th>
                        <th>Sub-Categories Count</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @if (categories.Any())
                    {
                        @foreach (var cat in categories)
                        {
                            <tr>
                                <td class="fw-bold text-dark">@cat</td>
                                <td>2 Sub-Categories</td>
                                <td><span class="badge bg-success-subtle text-success">Active</span></td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="3" class="text-center py-4 text-muted">No categories found in database.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

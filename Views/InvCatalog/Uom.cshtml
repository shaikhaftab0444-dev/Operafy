@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Units of Measure (UOM)";
}

<div class="container-fluid py-4 text-start">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-bold mb-1"><i class="fa-solid fa-weight-hanging text-primary me-2"></i>Units of Measure (UOM)</h4>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0 small">
                    <li class="breadcrumb-item"><a href="/InventoryDashboard" class="text-decoration-none">Inventory Dashboard</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Units of Measure</li>
                </ol>
            </nav>
        </div>
    </div>

    <!-- UOM Master Table -->
    <div class="bg-white border rounded-3 p-4 shadow-sm" style="max-width: 600px;">
        <h5 class="fw-bold mb-3">UOM Catalog</h5>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" style="font-size: 0.85rem;">
                <thead class="table-light">
                    <tr>
                        <th>UOM Code</th>
                        <th>Description</th>
                        <th>Base Unit</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td class="fw-bold text-dark">PCS</td>
                        <td>Pieces</td>
                        <td>Yes</td>
                    </tr>
                    <tr>
                        <td class="fw-bold text-dark">KG</td>
                        <td>Kilograms</td>
                        <td>Yes</td>
                    </tr>
                    <tr>
                        <td class="fw-bold text-dark">BOX</td>
                        <td>Box of 10 Pieces</td>
                        <td>No (10 PCS)</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

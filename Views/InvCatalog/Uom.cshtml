@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Units of Measure (UOM)";
}

<div class="container-fluid py-4 px-3 px-md-4 uom-page">

    <!-- Page Header -->
    <div class="uom-header-card mb-4">
        <div class="d-flex flex-column flex-lg-row justify-content-between align-items-start align-items-lg-center gap-4">

            <div class="d-flex align-items-start gap-3">
                <div class="uom-page-icon">
                    <i class="fa-solid fa-weight-hanging"></i>
                </div>

                <div>
                    <nav aria-label="breadcrumb" class="mb-2">
                        <ol class="breadcrumb uom-breadcrumb mb-0">
                            <li class="breadcrumb-item">
                                <a href="/InventoryDashboard">
                                    <i class="fa-solid fa-arrow-left me-1"></i>
                                    Inventory Dashboard
                                </a>
                            </li>
                            <li class="breadcrumb-item active" aria-current="page">
                                Units of Measure
                            </li>
                        </ol>
                    </nav>

                    <h2 class="uom-page-title mb-2">Units of Measure (UOM)</h2>

                    <p class="uom-page-subtitle mb-0">
                        Manage standard measurement units used across your inventory and purchasing operations.
                    </p>
                </div>
            </div>

            <a href="/InventoryDashboard" class="btn uom-dashboard-btn">
                <i class="fa-solid fa-chart-pie me-2"></i>
                Dashboard
            </a>

        </div>
    </div>

    <!-- Summary Cards -->
    <div class="row g-3 mb-4">

        <div class="col-12 col-md-4">
            <div class="uom-summary-card">
                <div>
                    <span class="uom-summary-label">TOTAL UOM CODES</span>
                    <h3 class="uom-summary-value">3</h3>
                    <span class="uom-summary-description">
                        Measurement units in catalog
                    </span>
                </div>

                <div class="uom-summary-icon uom-icon-blue">
                    <i class="fa-solid fa-ruler-combined"></i>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-4">
            <div class="uom-summary-card">
                <div>
                    <span class="uom-summary-label">BASE UNITS</span>
                    <h3 class="uom-summary-value text-success">2</h3>
                    <span class="uom-summary-description">
                        Primary measurement units
                    </span>
                </div>

                <div class="uom-summary-icon uom-icon-green">
                    <i class="fa-solid fa-circle-check"></i>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-4">
            <div class="uom-summary-card">
                <div>
                    <span class="uom-summary-label">CONVERSION UNITS</span>
                    <h3 class="uom-summary-value text-purple">1</h3>
                    <span class="uom-summary-description">
                        Units linked to base quantities
                    </span>
                </div>

                <div class="uom-summary-icon uom-icon-purple">
                    <i class="fa-solid fa-arrows-rotate"></i>
                </div>
            </div>
        </div>

    </div>

    <!-- UOM Catalog -->
    <div class="uom-content-card">

        <div class="uom-content-header">
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3">

                <div class="d-flex align-items-center gap-3">
                    <div class="uom-section-icon">
                        <i class="fa-solid fa-list"></i>
                    </div>

                    <div>
                        <h5 class="uom-section-title mb-1">UOM Catalog</h5>
                        <p class="uom-section-subtitle mb-0">
                            Standard units available for product and stock management.
                        </p>
                    </div>
                </div>

                <div class="uom-record-count">
                    <i class="fa-solid fa-database me-1"></i>
                    3 Measurement Units
                </div>

            </div>
        </div>

        <div class="uom-content-body">

            <div class="table-responsive">
                <table class="table uom-table align-middle mb-0">

                    <thead>
                        <tr>
                            <th class="uom-number-column">#</th>
                            <th>UOM Code</th>
                            <th>Description</th>
                            <th>Base Unit</th>
                        </tr>
                    </thead>

                    <tbody>
                        <tr>
                            <td>
                                <span class="uom-number">01</span>
                            </td>

                            <td>
                                <div class="uom-code-wrapper">
                                    <div class="uom-code-icon">
                                        <i class="fa-solid fa-cubes"></i>
                                    </div>

                                    <div>
                                        <div class="uom-code">PCS</div>
                                        <div class="uom-code-subtitle">Unit code</div>
                                    </div>
                                </div>
                            </td>

                            <td>
                                <div class="uom-description">Pieces</div>
                                <div class="uom-description-subtitle">
                                    Individual item quantity
                                </div>
                            </td>

                            <td>
                                <span class="uom-base-badge">
                                    <span class="uom-status-dot"></span>
                                    Yes
                                </span>
                            </td>
                        </tr>

                        <tr>
                            <td>
                                <span class="uom-number">02</span>
                            </td>

                            <td>
                                <div class="uom-code-wrapper">
                                    <div class="uom-code-icon">
                                        <i class="fa-solid fa-weight-scale"></i>
                                    </div>

                                    <div>
                                        <div class="uom-code">KG</div>
                                        <div class="uom-code-subtitle">Unit code</div>
                                    </div>
                                </div>
                            </td>

                            <td>
                                <div class="uom-description">Kilograms</div>
                                <div class="uom-description-subtitle">
                                    Weight measurement
                                </div>
                            </td>

                            <td>
                                <span class="uom-base-badge">
                                    <span class="uom-status-dot"></span>
                                    Yes
                                </span>
                            </td>
                        </tr>

                        <tr>
                            <td>
                                <span class="uom-number">03</span>
                            </td>

                            <td>
                                <div class="uom-code-wrapper">
                                    <div class="uom-code-icon uom-code-icon-orange">
                                        <i class="fa-solid fa-box"></i>
                                    </div>

                                    <div>
                                        <div class="uom-code">BOX</div>
                                        <div class="uom-code-subtitle">Unit code</div>
                                    </div>
                                </div>
                            </td>

                            <td>
                                <div class="uom-description">Box of 10 Pieces</div>
                                <div class="uom-description-subtitle">
                                    Packaged quantity
                                </div>
                            </td>

                            <td>
                                <span class="uom-conversion-badge">
                                    <i class="fa-solid fa-arrows-rotate me-1"></i>
                                    No (10 PCS)
                                </span>
                            </td>
                        </tr>
                    </tbody>

                </table>
            </div>

        </div>

        <div class="uom-content-footer">
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-2">
                <span>
                    <i class="fa-solid fa-circle-info me-1"></i>
                    Base units are used as the primary measurement reference.
                </span>

                <span>
                    Total: <strong>3 UOM Codes</strong>
                </span>
            </div>
        </div>

    </div>

</div>

<style>
    .uom-page {
        background: #f4f7fb;
        min-height: calc(100vh - 80px);
    }

    .uom-header-card {
        position: relative;
        overflow: hidden;
        padding: 30px;
        background: #ffffff;
        border: 1px solid #e3e8ef;
        border-radius: 22px;
        box-shadow: 0 8px 25px rgba(31, 45, 61, 0.04);
    }

        .uom-header-card::before {
            content: "";
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 4px;
            background: linear-gradient(90deg, #1677ff, #635bff);
        }

    .uom-page-icon {
        width: 58px;
        height: 58px;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #ffffff;
        background: linear-gradient(135deg, #2878f0, #4f46e5);
        border-radius: 16px;
        font-size: 23px;
        box-shadow: 0 10px 22px rgba(37, 99, 235, 0.2);
    }

    .uom-breadcrumb {
        font-size: 13px;
        color: #8a9ab3;
    }

        .uom-breadcrumb a {
            color: #71819a;
            text-decoration: none;
            transition: color 0.2s ease;
        }

            .uom-breadcrumb a:hover {
                color: #2563eb;
            }

        .uom-breadcrumb .breadcrumb-item + .breadcrumb-item::before {
            color: #b5c0cf;
            content: "/";
        }

        .uom-breadcrumb .active {
            color: #2563eb;
            font-weight: 600;
        }

    .uom-page-title {
        color: #17233c;
        font-size: clamp(24px, 3vw, 34px);
        font-weight: 750;
        letter-spacing: -1.2px;
    }

    .uom-page-subtitle {
        color: #8291a8;
        font-size: 14px;
        line-height: 1.6;
    }

    .uom-dashboard-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 42px;
        padding: 10px 18px;
        color: #526177;
        background: #ffffff;
        border: 1px solid #dce4ee;
        border-radius: 11px;
        font-size: 13px;
        font-weight: 650;
        transition: all 0.2s ease;
    }

        .uom-dashboard-btn:hover {
            color: #2563eb;
            background: #f5f8ff;
            border-color: #b9cdf5;
            transform: translateY(-1px);
        }

    .uom-summary-card {
        position: relative;
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        min-height: 145px;
        padding: 25px 20px;
        overflow: hidden;
        background: #ffffff;
        border: 1px solid #e4e9f0;
        border-radius: 18px;
        box-shadow: 0 7px 20px rgba(31, 45, 61, 0.035);
    }

        .uom-summary-card::after {
            content: "";
            position: absolute;
            top: -35px;
            right: -35px;
            width: 105px;
            height: 105px;
            background: #f7f9fc;
            border-radius: 50%;
        }

        .uom-summary-card > div {
            position: relative;
            z-index: 1;
        }

    .uom-summary-label {
        display: block;
        margin-bottom: 12px;
        color: #6b7d97;
        font-size: 11px;
        font-weight: 750;
        letter-spacing: 0.7px;
    }

    .uom-summary-value {
        margin-bottom: 6px;
        color: #1d2940;
        font-size: 26px;
        font-weight: 750;
        letter-spacing: -0.8px;
    }

    .uom-summary-description {
        color: #9aa9bd;
        font-size: 12px;
    }

    .uom-summary-icon {
        width: 43px;
        height: 43px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 13px;
        font-size: 17px;
    }

    .uom-icon-blue {
        color: #2563eb;
        background: #edf4ff;
    }

    .uom-icon-green {
        color: #16a05d;
        background: #eafaf1;
    }

    .uom-icon-purple {
        color: #7c3aed;
        background: #f3edff;
    }

    .text-purple {
        color: #7c3aed !important;
    }

    .uom-content-card {
        overflow: hidden;
        background: #ffffff;
        border: 1px solid #e3e8ef;
        border-radius: 20px;
        box-shadow: 0 8px 25px rgba(31, 45, 61, 0.035);
    }

    .uom-content-header {
        padding: 23px 25px;
        border-bottom: 1px solid #edf0f5;
    }

    .uom-section-icon {
        width: 42px;
        height: 42px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #1685d9;
        background: #eaf7ff;
        border-radius: 12px;
        font-size: 17px;
    }

    .uom-section-title {
        color: #1c2940;
        font-size: 17px;
        font-weight: 750;
        letter-spacing: -0.3px;
    }

    .uom-section-subtitle {
        color: #9aa9bd;
        font-size: 12px;
    }

    .uom-record-count {
        color: #8291a8;
        font-size: 12px;
        font-weight: 600;
    }

    .uom-content-body {
        padding: 0;
    }

    .uom-table {
        min-width: 700px;
        color: #344258;
        font-size: 13px;
    }

        .uom-table thead th {
            padding: 17px 25px;
            color: #687b96;
            background: #f8fafc;
            border-bottom: 1px solid #e5eaf1;
            font-size: 11px;
            font-weight: 750;
            letter-spacing: 0.55px;
            text-transform: uppercase;
            white-space: nowrap;
        }

        .uom-table tbody td {
            padding: 18px 25px;
            border-bottom: 1px solid #edf1f5;
            vertical-align: middle;
        }

        .uom-table tbody tr:last-child td {
            border-bottom: none;
        }

        .uom-table tbody tr {
            transition: background 0.2s ease;
        }

            .uom-table tbody tr:hover {
                background: #f8fbff;
            }

    .uom-number-column {
        width: 70px;
    }

    .uom-number {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 30px;
        height: 30px;
        color: #6d7f98;
        background: #f1f5f9;
        border-radius: 8px;
        font-size: 11px;
        font-weight: 700;
    }

    .uom-code-wrapper {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .uom-code-icon {
        width: 40px;
        height: 40px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        color: #2563eb;
        background: #edf4ff;
        border-radius: 11px;
        font-size: 16px;
    }

    .uom-code-icon-orange {
        color: #d97706;
        background: #fff6e5;
    }

    .uom-code {
        color: #202d43;
        font-size: 14px;
        font-weight: 750;
        letter-spacing: 0.3px;
    }

    .uom-code-subtitle,
    .uom-description-subtitle {
        margin-top: 3px;
        color: #9aa9bd;
        font-size: 11px;
    }

    .uom-description {
        color: #344258;
        font-size: 13px;
        font-weight: 600;
    }

    .uom-base-badge,
    .uom-conversion-badge {
        display: inline-flex;
        align-items: center;
        padding: 7px 12px;
        border-radius: 999px;
        font-size: 12px;
        font-weight: 650;
        white-space: nowrap;
    }

    .uom-base-badge {
        gap: 7px;
        color: #16864e;
        background: #edfbf3;
        border: 1px solid #c8f1d9;
    }

    .uom-status-dot {
        width: 6px;
        height: 6px;
        background: #18a957;
        border-radius: 50%;
    }

    .uom-conversion-badge {
        color: #7c5a13;
        background: #fff8e8;
        border: 1px solid #f5dfaa;
    }

    .uom-content-footer {
        padding: 15px 25px;
        color: #99a8bb;
        background: #fbfcfe;
        border-top: 1px solid #edf1f5;
        font-size: 11px;
    }

        .uom-content-footer strong {
            color: #65758d;
        }

    @@media (max-width: 767.98px) {
        .uom-page

    {
        padding-top: 20px !important;
    }

    .uom-header-card {
        padding: 22px 18px;
        border-radius: 17px;
    }

    .uom-page-icon {
        width: 48px;
        height: 48px;
        border-radius: 13px;
        font-size: 19px;
    }

    .uom-page-title {
        font-size: 25px;
    }

    .uom-page-subtitle {
        font-size: 13px;
    }

    .uom-dashboard-btn {
        width: 100%;
    }

    .uom-summary-card {
        min-height: 125px;
        padding: 20px;
    }

    .uom-summary-value {
        font-size: 24px;
    }

    .uom-content-header {
        padding: 20px 18px;
    }

    .uom-table thead th,
    .uom-table tbody td {
        padding-left: 18px;
        padding-right: 18px;
    }

    .uom-content-footer {
        padding: 14px 18px;
    }

    }
</style>
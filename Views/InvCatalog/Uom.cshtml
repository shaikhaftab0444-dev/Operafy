@model ERP_System.Models.UomPageViewModel
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Units of Measure (UOM) & Conversions";
}

@Html.AntiForgeryToken()

<div class="container-fluid py-4 px-3 px-md-4 uom-page text-start">

    <!-- Page Header -->
    <div class="uom-header-card mb-4">
        <div class="d-flex flex-column flex-lg-row justify-content-between align-items-start align-items-lg-center gap-4">

            <div class="d-flex align-items-start gap-3">
                <div class="uom-page-icon">
                    <i class="fa-solid fa-weight-hanging"></i>
                </div>

                <div>
                    <nav aria-label="breadcrumb" class="mb-2">
                        <ol class="breadcrumb uom-breadcrumb mb-0">
                            <li class="breadcrumb-item">
                                <a href="/InventoryDashboard">
                                    <i class="fa-solid fa-arrow-left me-1"></i>
                                    Inventory Dashboard
                                </a>
                            </li>
                            <li class="breadcrumb-item"><a href="/InvCatalog/Items">Catalog</a></li>
                            <li class="breadcrumb-item active" aria-current="page">
                                Units of Measure &amp; Conversions
                            </li>
                        </ol>
                    </nav>

                    <h2 class="uom-page-title mb-2">Units of Measure (UOM) &amp; Conversions</h2>

                    <p class="uom-page-subtitle mb-0">
                        Configure physical measurement standards, decimal precision flags, and operational packing conversion factors.
                    </p>
                </div>
            </div>

            <!-- Top Actions -->
            <div class="d-flex flex-wrap gap-2">
                <button type="button" class="btn btn-primary px-3 py-2 fw-bold rounded-3 shadow-sm" onclick="openAddUomModal()">
                    <i class="fa-solid fa-plus-circle me-1"></i> Add New UOM
                </button>

                <button type="button" class="btn btn-outline-primary px-3 py-2 fw-bold rounded-3 bg-white shadow-sm" onclick="openConversionModal()">
                    <i class="fa-solid fa-arrows-rotate me-1"></i> Define Unit Conversion
                </button>

                <a href="/InventoryDashboard" class="btn uom-dashboard-btn">
                    <i class="fa-solid fa-chart-pie me-2"></i> Dashboard
                </a>
            </div>

        </div>
    </div>

    <!-- Summary Cards -->
    <div class="row g-3 mb-4">
        <div class="col-12 col-md-4">
            <div class="uom-summary-card">
                <div>
                    <span class="uom-summary-label">TOTAL UOM CODES</span>
                    <h3 class="uom-summary-value">@Model.TotalUomCount</h3>
                    <span class="uom-summary-description">Standard measurement units in catalog</span>
                </div>
                <div class="uom-summary-icon uom-icon-blue">
                    <i class="fa-solid fa-ruler-combined"></i>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-4">
            <div class="uom-summary-card">
                <div>
                    <span class="uom-summary-label">BASE UNITS</span>
                    <h3 class="uom-summary-value text-success">@Model.BaseUnitsCount</h3>
                    <span class="uom-summary-description">Primary single inventory references</span>
                </div>
                <div class="uom-summary-icon uom-icon-green">
                    <i class="fa-solid fa-circle-check"></i>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-4">
            <div class="uom-summary-card">
                <div>
                    <span class="uom-summary-label">ACTIVE CONVERSIONS</span>
                    <h3 class="uom-summary-value text-purple">@Model.Conversions.Count</h3>
                    <span class="uom-summary-description">Secondary packaging multipliers</span>
                </div>
                <div class="uom-summary-icon uom-icon-purple">
                    <i class="fa-solid fa-arrows-rotate"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- Enhanced UOM Master Table -->
    <div class="uom-content-card mb-4">
        <div class="uom-content-header">
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3">
                <div class="d-flex align-items-center gap-3">
                    <div class="uom-section-icon">
                        <i class="fa-solid fa-scale-balanced"></i>
                    </div>
                    <div>
                        <h5 class="uom-section-title mb-1">Standard Units of Measure</h5>
                        <p class="uom-section-subtitle mb-0">
                            Predefined units with GST tax code mappings and decimal precision enforcement.
                        </p>
                    </div>
                </div>

                <div class="uom-record-count">
                    <i class="fa-solid fa-database me-1"></i>
                    @Model.TotalUomCount Measurement Units Active
                </div>
            </div>
        </div>

        <div class="uom-content-body">
            @if (Model.UnitsOfMeasure != null && Model.UnitsOfMeasure.Any())
            {
                <div class="table-responsive">
                    <table class="table uom-table align-middle mb-0">
                        <thead>
                            <tr>
                                <th class="uom-number-column">#</th>
                                <th>UOM Code</th>
                                <th>Description / Unit Name</th>
                                <th>Unit Type</th>
                                <th>Decimal Precision</th>
                                <th>Official GST / EDI Code</th>
                                <th>Status</th>
                                <th class="text-end" style="width: 140px;">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                var uIndex = 1;
                            }
                            @foreach (var u in Model.UnitsOfMeasure)
                            {
                                <tr>
                                    <td>
                                        <span class="uom-number">@uIndex.ToString("D2")</span>
                                    </td>
                                    <td>
                                        <div class="uom-code-wrapper">
                                            <div class="uom-code-icon @(!u.IsBaseUnit ? "uom-code-icon-orange" : "")">
                                                <i class="fa-solid @(u.AllowDecimals ? "fa-weight-scale" : u.IsBaseUnit ? "fa-cubes" : "fa-box")"></i>
                                            </div>
                                            <div>
                                                <div class="uom-code">@u.Code</div>
                                                <div class="uom-code-subtitle">ISO Standard</div>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="uom-description">@u.Description</div>
                                    </td>
                                    <td>
                                        @if (u.IsBaseUnit)
                                        {
                                            <span class="uom-base-badge">
                                                <span class="uom-status-dot"></span> Base Unit
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="uom-conversion-badge">
                                                <i class="fa-solid fa-arrows-split-up-and-left me-1"></i> Derived Unit
                                            </span>
                                        }
                                    </td>
                                    <td>
                                        @if (u.AllowDecimals)
                                        {
                                            <span class="badge bg-info-subtle text-info border border-info-subtle px-2 py-1">
                                                <i class="fa-solid fa-chart-pie me-1"></i> Decimals Allowed
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-light text-secondary border px-2 py-1">
                                                <i class="fa-solid fa-hashtag me-1"></i> No Decimals (Integers)
                                            </span>
                                        }
                                    </td>
                                    <td>
                                        <span class="badge bg-secondary-subtle text-dark font-monospace px-2 py-1">
                                            @(string.IsNullOrWhiteSpace(u.OfficialGstUomCode) ? "—" : u.OfficialGstUomCode)
                                        </span>
                                    </td>
                                    <td>
                                        @if (u.IsActive)
                                        {
                                            <span class="badge bg-success-subtle text-success px-2 py-1">Active</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger-subtle text-danger px-2 py-1">Inactive</span>
                                        }
                                    </td>
                                    <td class="text-end">
                                        <div class="btn-group">
                                            <button type="button" class="btn btn-sm btn-outline-secondary"
                                                    title="Edit Unit"
                                                    onclick="openEditUomModal(@u.Id, '@u.Code', '@u.Description', @(u.IsBaseUnit ? "true" : "false"), @(u.AllowDecimals ? "true" : "false"), '@(u.OfficialGstUomCode ?? "")', @(u.IsActive ? "true" : "false"))">
                                                <i class="fa-solid fa-pen"></i>
                                            </button>
                                            <button type="button" class="btn btn-sm btn-outline-primary"
                                                    title="Define conversion"
                                                    onclick="openConversionModalWithUnit(@u.Id)">
                                                <i class="fa-solid fa-shuffle"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                                uIndex++;
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5 text-muted">
                    No Units of Measure found in the database.
                </div>
            }
        </div>

        <div class="uom-content-footer d-flex justify-content-between align-items-center">
            <span>
                <i class="fa-solid fa-circle-info me-1"></i>
                Base units serve as the primary accounting atomic standard.
            </span>
            <span>Total: <strong>@Model.TotalUomCount UOM Codes</strong></span>
        </div>
    </div>

    <!-- Defined Conversions Matrix Section -->
    <div class="uom-content-card">
        <div class="uom-content-header">
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3">
                <div class="d-flex align-items-center gap-3">
                    <div class="uom-section-icon" style="color: #7c3aed; background: #f3edff;">
                        <i class="fa-solid fa-arrows-rotate"></i>
                    </div>
                    <div>
                        <h5 class="uom-section-title mb-1">Operational Unit Conversion Matrix</h5>
                        <p class="uom-section-subtitle mb-0">
                            Multipliers used when purchasing in cartons/cases and issuing as single pieces.
                        </p>
                    </div>
                </div>

                <button type="button" class="btn btn-sm btn-primary" onclick="openConversionModal()">
                    <i class="fa-solid fa-plus me-1"></i> Add Conversion Rule
                </button>
            </div>
        </div>

        <div class="uom-content-body">
            @if (Model.Conversions != null && Model.Conversions.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0" style="font-size: 0.85rem;">
                        <thead class="table-light">
                            <tr>
                                <th style="width: 50px;">#</th>
                                <th>Secondary Packaging Unit</th>
                                <th class="text-center" style="width: 150px;">Equals Factor</th>
                                <th>Base Inventory Unit</th>
                                <th>Operational Formula Preview</th>
                                <th class="text-end" style="width: 120px;">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                var cIndex = 1;
                            }
                            @foreach (var c in Model.Conversions)
                            {
                                <tr>
                                    <td><span class="uom-number">@cIndex</span></td>
                                    <td>
                                        <div class="fw-bold text-dark">
                                            <i class="fa-solid fa-box text-warning me-1"></i>
                                            @c.FromUom?.Code (@c.FromUom?.Description)
                                        </div>
                                    </td>
                                    <td class="text-center">
                                        <span class="badge bg-primary-subtle text-primary fs-6 px-3 py-1 fw-bold font-monospace">
                                            &times; @c.ConversionFactor.ToString("0.####")
                                        </span>
                                    </td>
                                    <td>
                                        <div class="fw-bold text-dark">
                                            <i class="fa-solid fa-cubes text-success me-1"></i>
                                            @c.ToUom?.Code (@c.ToUom?.Description)
                                        </div>
                                    </td>
                                    <td>
                                        <div class="p-2 bg-light rounded-3 font-monospace small fw-bold text-secondary border d-inline-block">
                                            1 @c.FromUom?.Code = @c.ConversionFactor.ToString("0.####") @c.ToUom?.Code
                                        </div>
                                    </td>
                                    <td class="text-end">
                                        <button type="button" class="btn btn-xs btn-outline-danger"
                                                onclick="deleteConversionRule(@c.Id, '@c.FromUom?.Code', '@c.ToUom?.Code')">
                                            <i class="fa-solid fa-trash me-1"></i> Delete
                                        </button>
                                    </td>
                                </tr>
                                cIndex++;
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-4 text-muted small">
                    No conversion rules configured. Click "Add Conversion Rule" to map secondary units to base quantities (e.g. 1 BOX = 10 PCS).
                </div>
            }
        </div>
    </div>
</div>

<!-- =========================================================================
     MODAL 1: ADD / EDIT UOM
     ========================================================================= -->
<div class="modal fade" id="uomModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title fw-bold" id="uomModalTitle">
                    <i class="fa-solid fa-ruler-combined text-primary me-2"></i> Add Unit of Measure
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <form id="uomForm" onsubmit="saveUomForm(event)">
                <div class="modal-body">
                    <input type="hidden" id="uomId" name="Id" value="0" />

                    <div class="row g-3">
                        <div class="col-sm-6">
                            <label class="form-label">UOM Code (e.g. PCS, KG, BOX) <span class="text-danger">*</span></label>
                            <input type="text" id="uomCode" name="Code" class="form-control text-uppercase font-monospace" placeholder="PCS" maxlength="15" required />
                        </div>

                        <div class="col-sm-6">
                            <label class="form-label">Official GST / EDI Code</label>
                            <input type="text" id="uomGstCode" name="OfficialGstUomCode" class="form-control text-uppercase font-monospace" placeholder="NOS" maxlength="15" />
                        </div>

                        <div class="col-12">
                            <label class="form-label">Description / Full Name <span class="text-danger">*</span></label>
                            <input type="text" id="uomDesc" name="Description" class="form-control" placeholder="e.g. Pieces / Individual Units" required />
                        </div>

                        <div class="col-sm-6">
                            <div class="form-check form-switch mt-2">
                                <input class="form-check-input" type="checkbox" id="uomIsBase" name="IsBaseUnit" value="true" checked />
                                <label class="form-check-label fw-bold" for="uomIsBase">Is Base Unit</label>
                                <div class="small text-muted">Primary atomic reference</div>
                            </div>
                        </div>

                        <div class="col-sm-6">
                            <div class="form-check form-switch mt-2">
                                <input class="form-check-input" type="checkbox" id="uomAllowDecimals" name="AllowDecimals" value="true" />
                                <label class="form-check-label fw-bold" for="uomAllowDecimals">Allow Decimals</label>
                                <div class="small text-muted">e.g. 1.5 KG, 2.75 LTR</div>
                            </div>
                        </div>

                        <div class="col-12">
                            <div class="form-check form-switch mt-2">
                                <input class="form-check-input" type="checkbox" id="uomIsActive" name="IsActive" value="true" checked />
                                <label class="form-check-label fw-bold" for="uomIsActive">Active Status</label>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary px-4" id="btnSaveUom">
                        <i class="fa-solid fa-floppy-disk me-1"></i> Save UOM
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- =========================================================================
     MODAL 2: UNIT CONVERSION MATRIX MODAL
     ========================================================================= -->
<div class="modal fade" id="conversionModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title fw-bold">
                    <i class="fa-solid fa-arrows-rotate text-purple me-2"></i> Define Operational Unit Conversion
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <form id="conversionForm" onsubmit="saveConversionForm(event)">
                <div class="modal-body">
                    <input type="hidden" id="convId" name="Id" value="0" />

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label">Secondary / Packaging Unit <span class="text-danger">*</span></label>
                            <select id="convFromUom" name="FromUomId" class="form-select" onchange="updateFormulaPreview()" required>
                                <option value="">-- Choose Unit --</option>
                                @foreach (var u in Model.UnitsOfMeasure)
                                {
                                    <option value="@u.Id" data-code="@u.Code">@u.Code (@u.Description)</option>
                                }
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">Equals Factor (Multiplier) <span class="text-danger">*</span></label>
                            <input type="number" step="0.0001" id="convFactor" name="ConversionFactor" class="form-control" value="10" min="0.0001" oninput="updateFormulaPreview()" required />
                        </div>

                        <div class="col-12">
                            <label class="form-label">Base Single Unit <span class="text-danger">*</span></label>
                            <select id="convToUom" name="ToUomId" class="form-select" onchange="updateFormulaPreview()" required>
                                <option value="">-- Choose Base Unit --</option>
                                @foreach (var u in Model.UnitsOfMeasure)
                                {
                                    <option value="@u.Id" data-code="@u.Code">@u.Code (@u.Description)</option>
                                }
                            </select>
                        </div>

                        <!-- Live Formula Preview -->
                        <div class="col-12 mt-3">
                            <label class="form-label text-muted small">Live Conversion Rule Preview</label>
                            <div class="p-3 bg-light rounded-3 text-center border">
                                <span class="fs-5 fw-bold text-primary font-monospace" id="formulaPreview">
                                    1 UNIT = 10 BASE
                                </span>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary px-4" id="btnSaveConv">
                        <i class="fa-solid fa-check me-1"></i> Save Conversion Rule
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<style>
    .uom-page { background: #f4f7fb; min-height: calc(100vh - 80px); }
    .uom-header-card { position: relative; overflow: hidden; padding: 26px 30px; background: #ffffff; border: 1px solid #e3e8ef; border-radius: 22px; box-shadow: 0 8px 25px rgba(31, 45, 61, 0.04); }
    .uom-header-card::before { content: ""; position: absolute; top: 0; left: 0; right: 0; height: 4px; background: linear-gradient(90deg, #1677ff, #635bff); }
    .uom-page-icon { width: 56px; height: 56px; display: flex; align-items: center; justify-content: center; color: #ffffff; background: linear-gradient(135deg, #2878f0, #4f46e5); border-radius: 16px; font-size: 22px; }
    .uom-breadcrumb { font-size: 13px; }
    .uom-page-title { color: #17233c; font-size: 1.6rem; font-weight: 750; }
    .uom-page-subtitle { color: #8291a8; font-size: 14px; }
    .uom-dashboard-btn { display: inline-flex; align-items: center; padding: 9px 16px; color: #526177; background: #ffffff; border: 1px solid #dce4ee; border-radius: 11px; font-size: 13px; font-weight: 650; }
    .uom-dashboard-btn:hover { color: #2563eb; background: #f5f8ff; }
    .uom-summary-card { position: relative; display: flex; justify-content: space-between; align-items: flex-start; min-height: 130px; padding: 22px 20px; background: #ffffff; border: 1px solid #e4e9f0; border-radius: 18px; }
    .uom-summary-label { display: block; margin-bottom: 8px; color: #6b7d97; font-size: 11px; font-weight: 750; letter-spacing: 0.7px; }
    .uom-summary-value { margin-bottom: 4px; color: #1d2940; font-size: 24px; font-weight: 750; }
    .uom-summary-description { color: #9aa9bd; font-size: 12px; }
    .uom-summary-icon { width: 42px; height: 42px; display: flex; align-items: center; justify-content: center; border-radius: 13px; font-size: 17px; }
    .uom-icon-blue { color: #2563eb; background: #edf4ff; }
    .uom-icon-green { color: #16a05d; background: #eafaf1; }
    .uom-icon-purple { color: #7c3aed; background: #f3edff; }
    .text-purple { color: #7c3aed !important; }
    .uom-content-card { overflow: hidden; background: #ffffff; border: 1px solid #e3e8ef; border-radius: 20px; box-shadow: 0 8px 25px rgba(31, 45, 61, 0.035); }
    .uom-content-header { padding: 20px 25px; border-bottom: 1px solid #edf0f5; }
    .uom-section-icon { width: 42px; height: 42px; display: flex; align-items: center; justify-content: center; color: #1685d9; background: #eaf7ff; border-radius: 12px; font-size: 17px; }
    .uom-section-title { color: #1c2940; font-size: 17px; font-weight: 750; }
    .uom-section-subtitle { color: #9aa9bd; font-size: 12px; }
    .uom-record-count { color: #8291a8; font-size: 12px; font-weight: 600; }
    .uom-table { min-width: 850px; font-size: 13px; }
    .uom-table thead th { padding: 15px 20px; color: #687b96; background: #f8fafc; border-bottom: 1px solid #e5eaf1; font-size: 11px; font-weight: 750; text-transform: uppercase; white-space: nowrap; }
    .uom-table tbody td { padding: 16px 20px; border-bottom: 1px solid #edf1f5; vertical-align: middle; }
    .uom-table tbody tr:hover { background: #f8fbff; }
    .uom-number-column { width: 60px; }
    .uom-number { display: inline-flex; align-items: center; justify-content: center; width: 28px; height: 28px; color: #6d7f98; background: #f1f5f9; border-radius: 8px; font-size: 11px; font-weight: 700; }
    .uom-code-wrapper { display: flex; align-items: center; gap: 12px; }
    .uom-code-icon { width: 38px; height: 38px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; color: #2563eb; background: #edf4ff; border-radius: 11px; font-size: 15px; }
    .uom-code-icon-orange { color: #d97706; background: #fff6e5; }
    .uom-code { color: #202d43; font-size: 14px; font-weight: 750; }
    .uom-code-subtitle { margin-top: 2px; color: #9aa9bd; font-size: 11px; }
    .uom-description { color: #344258; font-size: 13px; font-weight: 600; }
    .uom-base-badge, .uom-conversion-badge { display: inline-flex; align-items: center; padding: 5px 11px; border-radius: 999px; font-size: 12px; font-weight: 650; white-space: nowrap; }
    .uom-base-badge { gap: 6px; color: #16864e; background: #edfbf3; border: 1px solid #c8f1d9; }
    .uom-status-dot { width: 6px; height: 6px; background: #18a957; border-radius: 50%; }
    .uom-conversion-badge { color: #7c5a13; background: #fff8e8; border: 1px solid #f5dfaa; }
    .uom-content-footer { padding: 14px 25px; color: #99a8bb; background: #fbfcfe; border-top: 1px solid #edf1f5; font-size: 12px; }
    .btn-xs { padding: 0.28rem 0.65rem; font-size: 0.74rem; border-radius: 7px; }
</style>

<script>
    function getCsrfToken() {
        const tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
        return tokenInput ? tokenInput.value : '';
    }

    let uomModalInstance = null;
    let conversionModalInstance = null;

    document.addEventListener('DOMContentLoaded', () => {
        const uModalEl = document.getElementById('uomModal');
        if (uModalEl) uomModalInstance = new bootstrap.Modal(uModalEl);

        const cModalEl = document.getElementById('conversionModal');
        if (cModalEl) conversionModalInstance = new bootstrap.Modal(cModalEl);

        updateFormulaPreview();
    });

    function updateFormulaPreview() {
        const fromSelect = document.getElementById('convFromUom');
        const toSelect = document.getElementById('convToUom');
        const factor = document.getElementById('convFactor').value || '1';

        const fromCode = fromSelect.selectedIndex > 0 ? fromSelect.options[fromSelect.selectedIndex].getAttribute('data-code') : 'BOX';
        const toCode = toSelect.selectedIndex > 0 ? toSelect.options[toSelect.selectedIndex].getAttribute('data-code') : 'PCS';

        document.getElementById('formulaPreview').innerText = `1 ${fromCode} = ${factor} ${toCode}`;
    }

    function openAddUomModal() {
        document.getElementById('uomForm').reset();
        document.getElementById('uomId').value = "0";
        document.getElementById('uomModalTitle').innerHTML = '<i class="fa-solid fa-ruler-combined text-primary me-2"></i> Add Unit of Measure';
        document.getElementById('uomIsBase').checked = true;
        document.getElementById('uomAllowDecimals').checked = false;
        document.getElementById('uomIsActive').checked = true;
        if (uomModalInstance) uomModalInstance.show();
    }

    function openEditUomModal(id, code, desc, isBase, allowDec, gstCode, isActive) {
        document.getElementById('uomId').value = id;
        document.getElementById('uomCode').value = code;
        document.getElementById('uomDesc').value = desc;
        document.getElementById('uomIsBase').checked = isBase;
        document.getElementById('uomAllowDecimals').checked = allowDec;
        document.getElementById('uomGstCode').value = gstCode;
        document.getElementById('uomIsActive').checked = isActive;
        document.getElementById('uomModalTitle').innerHTML = `<i class="fa-solid fa-pen-to-square text-primary me-2"></i> Edit UOM: ${code}`;
        if (uomModalInstance) uomModalInstance.show();
    }

    async function saveUomForm(e) {
        e.preventDefault();
        const btn = document.getElementById('btnSaveUom');
        btn.disabled = true;
        btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Saving...';

        const formData = new FormData(document.getElementById('uomForm'));

        try {
            const res = await fetch('/InvCatalog/SaveUom', {
                method: 'POST',
                headers: { 'RequestVerificationToken': getCsrfToken() },
                body: formData
            });
            const data = await res.json();
            if (data.success) {
                alert(data.message || "UOM saved successfully!");
                if (uomModalInstance) uomModalInstance.hide();
                location.reload();
            } else {
                alert(data.message || "Failed to save UOM.");
                btn.disabled = false;
                btn.innerHTML = '<i class="fa-solid fa-floppy-disk me-1"></i> Save UOM';
            }
        } catch (err) {
            console.error(err);
            alert("Error saving UOM.");
            btn.disabled = false;
            btn.innerHTML = '<i class="fa-solid fa-floppy-disk me-1"></i> Save UOM';
        }
    }

    function openConversionModal() {
        document.getElementById('conversionForm').reset();
        document.getElementById('convId').value = "0";
        document.getElementById('convFactor').value = "10";
        updateFormulaPreview();
        if (conversionModalInstance) conversionModalInstance.show();
    }

    function openConversionModalWithUnit(uomId) {
        openConversionModal();
        document.getElementById('convFromUom').value = uomId;
        updateFormulaPreview();
    }

    async function saveConversionForm(e) {
        e.preventDefault();
        const btn = document.getElementById('btnSaveConv');
        btn.disabled = true;
        btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Saving...';

        const formData = new FormData(document.getElementById('conversionForm'));

        try {
            const res = await fetch('/InvCatalog/SaveConversion', {
                method: 'POST',
                headers: { 'RequestVerificationToken': getCsrfToken() },
                body: formData
            });
            const data = await res.json();
            if (data.success) {
                alert(data.message || "Conversion rule saved!");
                if (conversionModalInstance) conversionModalInstance.hide();
                location.reload();
            } else {
                alert(data.message || "Failed to save conversion.");
                btn.disabled = false;
                btn.innerHTML = '<i class="fa-solid fa-check me-1"></i> Save Conversion Rule';
            }
        } catch (err) {
            console.error(err);
            alert("Error saving conversion.");
            btn.disabled = false;
            btn.innerHTML = '<i class="fa-solid fa-check me-1"></i> Save Conversion Rule';
        }
    }

    async function deleteConversionRule(id, fromCode, toCode) {
        if (!confirm(`Delete conversion rule 1 ${fromCode} -> ${toCode}?`)) {
            return;
        }

        const formData = new URLSearchParams();
        formData.append('id', id);

        try {
            const res = await fetch('/InvCatalog/DeleteConversion', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                    'RequestVerificationToken': getCsrfToken()
                },
                body: formData
            });
            const data = await res.json();
            if (data.success) {
                alert(data.message || "Rule deleted.");
                location.reload();
            } else {
                alert(data.message || "Failed to delete rule.");
            }
        } catch (err) {
            console.error(err);
            alert("Error deleting conversion rule.");
        }
    }
</script>
@model IEnumerable<ERP_System.Models.Product>
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Barcode & QR Code Management";
}

<div class="container-fluid py-4 text-start">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-bold mb-1"><i class="fa-solid fa-barcode text-primary me-2"></i>Barcode / QR Code Management</h4>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0 small">
                    <li class="breadcrumb-item"><a href="/InventoryDashboard" class="text-decoration-none">Inventory Dashboard</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Barcode / QR Codes</li>
                </ol>
            </nav>
        </div>
    </div>

    <!-- Barcode Listing -->
    <div class="bg-white border rounded-3 p-4 shadow-sm">
        <h5 class="fw-bold mb-3">Item Barcodes</h5>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" style="font-size: 0.85rem;">
                <thead class="table-light">
                    <tr>
                        <th>Item Name</th>
                        <th>UPC / EAN Code</th>
                        <th>Barcode Preview</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var p in Model)
                        {
                            <tr>
                                <td class="fw-bold text-dark">@p.ProductName</td>
                                <td><code>890123456@(p.ProductId.ToString("D3"))</code></td>
                                <td>
                                    <div class="bg-light border p-2 text-center rounded d-inline-block" style="font-family: monospace; letter-spacing: 3px; font-size: 1.1rem; color: #000;">
                                        ||||| | || |||
                                    </div>
                                </td>
                                <td>
                                    <button class="btn btn-outline-primary btn-xs rounded-pill px-3"><i class="fa-solid fa-print me-1.5"></i>Print Label</button>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4" class="text-center py-4 text-muted">No items found.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Serial Number Tracking";
}

<div class="container-fluid py-4 text-start">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-bold mb-1"><i class="fa-solid fa-list-ol text-primary me-2"></i>Serial Number Tracking</h4>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0 small">
                    <li class="breadcrumb-item"><a href="/InventoryDashboard" class="text-decoration-none">Inventory Dashboard</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Serial Numbers</li>
                </ol>
            </nav>
        </div>
    </div>

    <!-- Serial Numbers Table -->
    <div class="bg-white border rounded-3 p-4 shadow-sm">
        <h5 class="fw-bold mb-3">Item Serial Masters</h5>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" style="font-size: 0.85rem;">
                <thead class="table-light">
                    <tr>
                        <th>Serial Number</th>
                        <th>Item Name</th>
                        <th>Warehouse</th>
                        <th>Warranty Expiry</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td class="fw-bold text-dark">SN-DELL-KB-90412</td>
                        <td>Dell Wired Keyboard</td>
                        <td>Main Central Warehouse</td>
                        <td>10 Jan 2027</td>
                        <td><span class="badge bg-success-subtle text-success">Available</span></td>
                    </tr>
                    <tr>
                        <td class="fw-bold text-dark">SN-DELL-KB-90413</td>
                        <td>Dell Wired Keyboard</td>
                        <td>Main Central Warehouse</td>
                        <td>10 Jan 2027</td>
                        <td><span class="badge bg-danger-subtle text-danger">Sold</span></td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

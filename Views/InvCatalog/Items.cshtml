@model IEnumerable<ERP_System.Models.Product>

@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Items & SKUs Master";
}

<div class="container-fluid py-4 px-3 px-md-4">

    <!-- Page Header -->
    <div class="d-flex flex-column flex-lg-row justify-content-between align-items-start align-items-lg-center gap-3 mb-4">
        <div>
            <div class="d-flex align-items-center gap-2 mb-2">
                <span class="text-primary">
                    <i class="fa-solid fa-box-open"></i>
                </span>

                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb mb-0 small">
                        <li class="breadcrumb-item">
                            <a href="/InventoryDashboard" class="text-decoration-none text-muted">
                                Inventory Dashboard
                            </a>
                        </li>
                        <li class="breadcrumb-item active text-dark" aria-current="page">
                            Items & SKUs
                        </li>
                    </ol>
                </nav>
            </div>

            <h3 class="fw-bold text-dark mb-1">Items & SKUs Master</h3>
            <p class="text-muted mb-0">
                Manage and monitor product items, stock levels, sales, and branch allocation.
            </p>
        </div>

        <a href="/InventoryDashboard"
           class="btn btn-light border rounded-3 px-3 py-2">
            <i class="fa-solid fa-arrow-left me-2"></i>
            Back to Dashboard
        </a>
    </div>

    <!-- Summary Cards -->
    <div class="row g-3 mb-4">

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <p class="text-muted small mb-2">Total Items</p>
                            <h4 class="fw-bold text-dark mb-0">
                                @(Model?.Count() ?? 0)
                            </h4>
                        </div>

                        <div class="rounded-3 bg-primary-subtle text-primary d-flex align-items-center justify-content-center"
                             style="width: 46px; height: 46px;">
                            <i class="fa-solid fa-boxes-stacked fs-5"></i>
                        </div>
                    </div>

                    <div class="mt-3">
                        <span class="small text-muted">
                            Products available in the system
                        </span>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <p class="text-muted small mb-2">In Stock</p>
                            <h4 class="fw-bold text-success mb-0">
                                @(Model?.Count(p => p.Status == "In Stock") ?? 0)
                            </h4>
                        </div>

                        <div class="rounded-3 bg-success-subtle text-success d-flex align-items-center justify-content-center"
                             style="width: 46px; height: 46px;">
                            <i class="fa-solid fa-circle-check fs-5"></i>
                        </div>
                    </div>

                    <div class="mt-3">
                        <span class="small text-muted">
                            Items currently available
                        </span>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <p class="text-muted small mb-2">Low Stock</p>
                            <h4 class="fw-bold text-warning mb-0">
                                @(Model?.Count(p => p.Status == "Low Stock") ?? 0)
                            </h4>
                        </div>

                        <div class="rounded-3 bg-warning-subtle text-warning d-flex align-items-center justify-content-center"
                             style="width: 46px; height: 46px;">
                            <i class="fa-solid fa-triangle-exclamation fs-5"></i>
                        </div>
                    </div>

                    <div class="mt-3">
                        <span class="small text-muted">
                            Items requiring attention
                        </span>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <p class="text-muted small mb-2">Out of Stock</p>
                            <h4 class="fw-bold text-danger mb-0">
                                @(Model?.Count(p => p.Status != "In Stock" && p.Status != "Low Stock") ?? 0)
                            </h4>
                        </div>

                        <div class="rounded-3 bg-danger-subtle text-danger d-flex align-items-center justify-content-center"
                             style="width: 46px; height: 46px;">
                            <i class="fa-solid fa-box-open fs-5"></i>
                        </div>
                    </div>

                    <div class="mt-3">
                        <span class="small text-muted">
                            Items unavailable for sale
                        </span>
                    </div>
                </div>
            </div>
        </div>

    </div>

    <!-- Main Content Card -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">

        <!-- Card Header -->
        <div class="card-header bg-white border-bottom px-3 px-md-4 py-4">
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3">

                <div>
                    <h5 class="fw-bold text-dark mb-1">
                        <i class="fa-solid fa-list-check text-primary me-2"></i>
                        Product Items
                    </h5>

                    <p class="text-muted small mb-0">
                        View all registered products and their current inventory details.
                    </p>
                </div>

                <div class="d-flex flex-wrap gap-2">
                    <span class="badge rounded-pill bg-primary-subtle text-primary px-3 py-2">
                        <i class="fa-solid fa-database me-1"></i>
                        @(Model?.Count() ?? 0) Records
                    </span>
                </div>

            </div>
        </div>

        <!-- Table -->
        <div class="card-body p-0">

            @if (Model != null && Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">

                        <thead class="bg-light">
                            <tr>
                                <th class="px-3 px-md-4 py-3 text-uppercase small fw-semibold text-muted">
                                    Product Name
                                </th>

                                <th class="py-3 text-uppercase small fw-semibold text-muted">
                                    Category
                                </th>

                                <th class="py-3 text-uppercase small fw-semibold text-muted">
                                    Sold Qty
                                </th>

                                <th class="py-3 text-uppercase small fw-semibold text-muted">
                                    Revenue
                                </th>

                                <th class="py-3 text-uppercase small fw-semibold text-muted">
                                    Stock Qty
                                </th>

                                <th class="py-3 text-uppercase small fw-semibold text-muted">
                                    Branch
                                </th>

                                <th class="pe-3 pe-md-4 py-3 text-uppercase small fw-semibold text-muted">
                                    Status
                                </th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var p in Model)
                            {
                                <tr>
                                    <td class="px-3 px-md-4 py-3">
                                        <div class="d-flex align-items-center gap-3">
                                            <div class="rounded-3 bg-primary-subtle text-primary d-flex align-items-center justify-content-center flex-shrink-0"
                                                 style="width: 40px; height: 40px;">
                                                <i class="fa-solid fa-box"></i>
                                            </div>

                                            <div>
                                                <div class="fw-semibold text-dark">
                                                    @p.ProductName
                                                </div>

                                                <div class="small text-muted">
                                                    Product item
                                                </div>
                                            </div>
                                        </div>
                                    </td>

                                    <td class="py-3">
                                        <span class="text-dark">
                                            @(string.IsNullOrWhiteSpace(p.Category) ? "—" : p.Category)
                                        </span>
                                    </td>

                                    <td class="py-3">
                                        <span class="fw-semibold text-dark">
                                            @p.SoldQty
                                        </span>
                                        <span class="small text-muted">Items</span>
                                    </td>

                                    <td class="py-3">
                                        <span class="fw-semibold text-dark">
                                            ₹@p.Revenue.ToString("N2")
                                        </span>
                                    </td>

                                    <td class="py-3">
                                        <span class="fw-semibold text-dark">
                                            @p.StockQty
                                        </span>
                                        <span class="small text-muted">Units</span>
                                    </td>

                                    <td class="py-3">
                                        <div class="d-flex align-items-center gap-2">
                                            <i class="fa-solid fa-location-dot text-muted"></i>
                                            <span class="text-dark">
                                                @(p.Branch != null ? p.Branch.BranchName : "Head Office")
                                            </span>
                                        </div>
                                    </td>

                                    <td class="pe-3 pe-md-4 py-3">
                                        @if (p.Status == "In Stock")
                                        {
                                            <span class="badge rounded-pill bg-success-subtle text-success px-3 py-2">
                                                <i class="fa-solid fa-circle-check me-1"></i>
                                                In Stock
                                            </span>
                                        }
                                        else if (p.Status == "Low Stock")
                                        {
                                            <span class="badge rounded-pill bg-warning-subtle text-warning px-3 py-2">
                                                <i class="fa-solid fa-triangle-exclamation me-1"></i>
                                                Low Stock
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge rounded-pill bg-danger-subtle text-danger px-3 py-2">
                                                <i class="fa-solid fa-circle-xmark me-1"></i>
                                                Out of Stock
                                            </span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>

                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5 px-3">
                    <div class="rounded-circle bg-light text-muted d-flex align-items-center justify-content-center mx-auto mb-3"
                         style="width: 70px; height: 70px;">
                        <i class="fa-solid fa-box-open fs-3"></i>
                    </div>

                    <h5 class="fw-bold text-dark mb-2">
                        No Items Found
                    </h5>

                    <p class="text-muted mb-0">
                        No product items were found in the database.
                    </p>
                </div>
            }

        </div>

        <!-- Card Footer -->
        <div class="card-footer bg-white border-top px-3 px-md-4 py-3">
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-2">
                <span class="small text-muted">
                    Showing @(Model?.Count() ?? 0) product records
                </span>

                <span class="small text-muted">
                    <i class="fa-solid fa-shield-halved me-1"></i>
                    Inventory data overview
                </span>
            </div>
        </div>

    </div>

</div>

<style>
    .card {
        transition: all 0.2s ease-in-out;
    }

        .card:hover {
            transform: translateY(-2px);
        }

    .table > :not(caption) > * > * {
        border-bottom-color: #edf0f4;
    }

    .table-hover tbody tr:hover {
        background-color: #f8faff;
    }

    .table thead th {
        white-space: nowrap;
        letter-spacing: 0.03em;
    }

    .badge {
        font-weight: 600;
        letter-spacing: 0.01em;
    }

    @@media (max-width: 767.98px) {
        .card-body

    {
        padding: 1rem !important;
    }

    .table {
        min-width: 950px;
    }

    .table-responsive {
        border-radius: 0;
    }

    }
</style>
@model IEnumerable<ERP_System.Models.Product>

@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Items & SKUs Master";
}

<style>
    .items-page {
        background: #f7f9fc;
        min-height: calc(100vh - 70px);
        padding: 28px 0;
    }

    .items-header-card,
    .items-summary-card,
    .items-content-card {
        background: #ffffff;
        border: 1px solid #e9eef5;
        border-radius: 18px;
        box-shadow: 0 8px 24px rgba(30, 55, 90, 0.05);
    }

    .items-header-card {
        padding: 26px 28px;
    }

    .items-icon-box {
        width: 52px;
        height: 52px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 14px;
        background: #eaf2ff;
        color: #2563eb;
        font-size: 22px;
        flex-shrink: 0;
    }

    .items-page-title {
        color: #172b4d;
        font-size: 1.45rem;
        font-weight: 700;
        margin-bottom: 6px;
    }

    .items-page-subtitle {
        color: #7b8798;
        font-size: 0.88rem;
        margin-bottom: 0;
    }

    .items-breadcrumb {
        margin-bottom: 0;
        padding: 0;
        background: transparent;
    }

        .items-breadcrumb .breadcrumb-item {
            color: #8a94a6;
            font-size: 0.78rem;
        }

            .items-breadcrumb .breadcrumb-item a {
                color: #2563eb;
                text-decoration: none;
                font-weight: 500;
            }

            .items-breadcrumb .breadcrumb-item.active {
                color: #8a94a6;
            }

    .items-back-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        border: 1px solid #dfe5ec;
        background: #ffffff;
        color: #667085;
        border-radius: 10px;
        padding: 11px 17px;
        font-size: 0.82rem;
        font-weight: 600;
        text-decoration: none;
        transition: all 0.2s ease;
    }

        .items-back-btn:hover {
            background: #f8fafc;
            border-color: #cbd5e1;
            color: #344054;
            transform: translateY(-1px);
        }

    .items-summary-card {
        height: 100%;
        padding: 20px;
    }

    .items-summary-icon {
        width: 44px;
        height: 44px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 12px;
        font-size: 18px;
        flex-shrink: 0;
    }

        .items-summary-icon.blue {
            background: #eaf2ff;
            color: #2563eb;
        }

        .items-summary-icon.green {
            background: #e9f8ef;
            color: #16a34a;
        }

        .items-summary-icon.orange {
            background: #fff4df;
            color: #d97706;
        }

        .items-summary-icon.red {
            background: #ffeded;
            color: #dc2626;
        }

    .items-summary-label {
        color: #8a94a6;
        font-size: 0.78rem;
        font-weight: 500;
        margin-bottom: 5px;
    }

    .items-summary-value {
        color: #172b4d;
        font-size: 1.45rem;
        font-weight: 700;
        margin-bottom: 0;
    }

    .items-summary-description {
        color: #98a2b3;
        font-size: 0.76rem;
        margin-top: 14px;
        margin-bottom: 0;
    }

    .items-content-card {
        overflow: hidden;
    }

    .items-card-header {
        padding: 24px 28px;
        border-bottom: 1px solid #edf0f5;
    }

    .items-section-title {
        color: #172b4d;
        font-size: 1.05rem;
        font-weight: 700;
        margin-bottom: 5px;
    }

    .items-section-subtitle {
        color: #8a94a6;
        font-size: 0.8rem;
        margin-bottom: 0;
    }

    .items-record-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: #eaf2ff;
        color: #2563eb;
        border-radius: 30px;
        padding: 8px 13px;
        font-size: 0.74rem;
        font-weight: 600;
        white-space: nowrap;
    }

    .items-table-wrapper {
        border: 1px solid #edf0f5;
        border-radius: 14px;
        overflow: hidden;
    }

    .items-table {
        min-width: 950px;
        margin-bottom: 0;
    }

        .items-table thead th {
            background: #f8fafc;
            color: #667085;
            border-bottom: 1px solid #e8edf3;
            font-size: 0.74rem;
            font-weight: 700;
            letter-spacing: 0.03em;
            padding: 15px 16px;
            white-space: nowrap;
            text-transform: uppercase;
        }

        .items-table tbody td {
            color: #475467;
            border-bottom: 1px solid #f0f2f6;
            font-size: 0.82rem;
            padding: 16px;
            vertical-align: middle;
        }

        .items-table tbody tr:last-child td {
            border-bottom: none;
        }

        .items-table tbody tr:hover {
            background: #fbfdff;
        }

    .items-product-wrapper {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .items-product-icon {
        width: 40px;
        height: 40px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 11px;
        background: #eaf2ff;
        color: #2563eb;
        flex-shrink: 0;
    }

    .items-product-name {
        color: #172b4d;
        font-weight: 700;
        margin-bottom: 3px;
    }

    .items-product-type {
        color: #98a2b3;
        font-size: 0.74rem;
    }

    .items-value {
        color: #344054;
        font-weight: 600;
    }

    .items-secondary-text {
        color: #98a2b3;
        font-size: 0.75rem;
        margin-left: 3px;
    }

    .items-branch {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        color: #475467;
    }

        .items-branch i {
            color: #98a2b3;
        }

    .items-status {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        border-radius: 30px;
        padding: 7px 11px;
        font-size: 0.72rem;
        font-weight: 600;
        white-space: nowrap;
    }

        .items-status::before {
            content: "";
            width: 6px;
            height: 6px;
            border-radius: 50%;
            display: inline-block;
        }

        .items-status.in-stock {
            background: #eaf8ef;
            color: #16803c;
        }

            .items-status.in-stock::before {
                background: #22c55e;
            }

        .items-status.low-stock {
            background: #fff4df;
            color: #b76b00;
        }

            .items-status.low-stock::before {
                background: #f59e0b;
            }

        .items-status.out-of-stock {
            background: #ffeded;
            color: #c62828;
        }

            .items-status.out-of-stock::before {
                background: #ef4444;
            }

    .items-empty-state {
        padding: 54px 20px !important;
        text-align: center;
    }

    .items-empty-icon {
        width: 70px;
        height: 70px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        background: #f1f5f9;
        color: #94a3b8;
        font-size: 28px;
        margin-bottom: 16px;
    }

    .items-empty-title {
        color: #172b4d;
        font-size: 1rem;
        font-weight: 700;
        margin-bottom: 7px;
    }

    .items-empty-description {
        color: #8a94a6;
        font-size: 0.82rem;
        margin-bottom: 0;
    }

    .items-card-footer {
        padding: 16px 28px;
        border-top: 1px solid #edf0f5;
        background: #ffffff;
    }

    .items-footer-text {
        color: #98a2b3;
        font-size: 0.76rem;
    }

    @@media (max-width: 991.98px) {
        .items-header-actions

    {
        width: 100%;
    }

    .items-back-btn {
        width: 100%;
    }

    }

    @@media (max-width: 767.98px) {
        .items-page

    {
        padding: 18px 0;
    }

    .items-header-card {
        padding: 20px;
    }

    .items-card-header {
        padding: 20px;
    }

    .items-card-footer {
        padding: 15px 20px;
    }

    .items-page-title {
        font-size: 1.2rem;
    }

    .items-summary-card {
        padding: 16px;
    }

    .items-table-wrapper {
        border-radius: 12px;
    }

    }
</style>

<div class="container-fluid items-page text-start">
    <div class="container-fluid px-0">

        <!-- Page Header -->
        <div class="items-header-card mb-4">
            <div class="row align-items-center g-3">
                <div class="col-lg-8">
                    <div class="d-flex align-items-center">
                        <div class="items-icon-box me-3">
                            <i class="fa-solid fa-box-open"></i>
                        </div>

                        <div>
                            <h3 class="items-page-title">
                                Items &amp; SKUs Master
                            </h3>

                            <p class="items-page-subtitle">
                                Manage and monitor product items, stock levels, sales, and branch allocation.
                            </p>

                            <nav aria-label="breadcrumb" class="mt-2">
                                <ol class="breadcrumb items-breadcrumb">
                                    <li class="breadcrumb-item">
                                        <a href="/InventoryDashboard">
                                            Inventory Dashboard
                                        </a>
                                    </li>

                                    <li class="breadcrumb-item active" aria-current="page">
                                        Items &amp; SKUs
                                    </li>
                                </ol>
                            </nav>
                        </div>
                    </div>
                </div>

                <div class="col-lg-4">
                    <div class="d-flex justify-content-lg-end items-header-actions">
                        <a href="/InventoryDashboard" class="items-back-btn">
                            <i class="fa-solid fa-arrow-left"></i>
                            Back to Dashboard
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Summary Cards -->
        <div class="row g-4 mb-4">

            <div class="col-12 col-sm-6 col-xl-3">
                <div class="items-summary-card">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <p class="items-summary-label">Total Items</p>

                            <h4 class="items-summary-value">
                                @(Model?.Count() ?? 0)
                            </h4>
                        </div>

                        <div class="items-summary-icon blue">
                            <i class="fa-solid fa-boxes-stacked"></i>
                        </div>
                    </div>

                    <p class="items-summary-description">
                        Products available in the system
                    </p>
                </div>
            </div>

            <div class="col-12 col-sm-6 col-xl-3">
                <div class="items-summary-card">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <p class="items-summary-label">In Stock</p>

                            <h4 class="items-summary-value text-success">
                                @(Model?.Count(p => p.Status == "In Stock") ?? 0)
                            </h4>
                        </div>

                        <div class="items-summary-icon green">
                            <i class="fa-solid fa-circle-check"></i>
                        </div>
                    </div>

                    <p class="items-summary-description">
                        Items currently available
                    </p>
                </div>
            </div>

            <div class="col-12 col-sm-6 col-xl-3">
                <div class="items-summary-card">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <p class="items-summary-label">Low Stock</p>

                            <h4 class="items-summary-value text-warning">
                                @(Model?.Count(p => p.Status == "Low Stock") ?? 0)
                            </h4>
                        </div>

                        <div class="items-summary-icon orange">
                            <i class="fa-solid fa-triangle-exclamation"></i>
                        </div>
                    </div>

                    <p class="items-summary-description">
                        Items requiring attention
                    </p>
                </div>
            </div>

            <div class="col-12 col-sm-6 col-xl-3">
                <div class="items-summary-card">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <p class="items-summary-label">Out of Stock</p>

                            <h4 class="items-summary-value text-danger">
                                @(Model?.Count(p => p.Status != "In Stock" && p.Status != "Low Stock") ?? 0)
                            </h4>
                        </div>

                        <div class="items-summary-icon red">
                            <i class="fa-solid fa-box-open"></i>
                        </div>
                    </div>

                    <p class="items-summary-description">
                        Items unavailable for sale
                    </p>
                </div>
            </div>

        </div>

        <!-- Main Content Card -->
        <div class="items-content-card">

            <!-- Card Header -->
            <div class="items-card-header">
                <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3">
                    <div>
                        <h5 class="items-section-title">
                            <i class="fa-solid fa-list-check text-primary me-2"></i>
                            Product Items
                        </h5>

                        <p class="items-section-subtitle">
                            View all registered products and their current inventory details.
                        </p>
                    </div>

                    <div>
                        <span class="items-record-badge">
                            <i class="fa-solid fa-database"></i>
                            @(Model?.Count() ?? 0) Records
                        </span>
                    </div>
                </div>
            </div>

            <!-- Table -->
            <div class="p-3 p-md-4">
                @if (Model != null && Model.Any())
                {
                    <div class="table-responsive items-table-wrapper">
                        <table class="table table-hover align-middle items-table">
                            <thead>
                                <tr>
                                    <th>Product Name</th>
                                    <th>Category</th>
                                    <th>Sold Qty</th>
                                    <th>Revenue</th>
                                    <th>Stock Qty</th>
                                    <th>Branch</th>
                                    <th>Status</th>
                                </tr>
                            </thead>

                            <tbody>
                                @foreach (var p in Model)
                                {
                                    <tr>
                                        <td>
                                            <div class="items-product-wrapper">
                                                <div class="items-product-icon">
                                                    <i class="fa-solid fa-box"></i>
                                                </div>

                                                <div>
                                                    <div class="items-product-name">
                                                        @p.ProductName
                                                    </div>

                                                    <div class="items-product-type">
                                                        Product item
                                                    </div>
                                                </div>
                                            </div>
                                        </td>

                                        <td>
                                            <span class="items-value">
                                                @(string.IsNullOrWhiteSpace(p.Category) ? "—" : p.Category)
                                            </span>
                                        </td>

                                        <td>
                                            <span class="items-value">
                                                @p.SoldQty
                                            </span>

                                            <span class="items-secondary-text">
                                                Items
                                            </span>
                                        </td>

                                        <td>
                                            <span class="items-value">
                                                ₹@p.Revenue.ToString("N2")
                                            </span>
                                        </td>

                                        <td>
                                            <span class="items-value">
                                                @p.StockQty
                                            </span>

                                            <span class="items-secondary-text">
                                                Units
                                            </span>
                                        </td>

                                        <td>
                                            <div class="items-branch">
                                                <i class="fa-solid fa-location-dot"></i>

                                                <span>
                                                    @(p.Branch != null ? p.Branch.BranchName : "Head Office")
                                                </span>
                                            </div>
                                        </td>

                                        <td>
                                            @if (p.Status == "In Stock")
                                            {
                                                <span class="items-status in-stock">
                                                    In Stock
                                                </span>
                                            }
                                            else if (p.Status == "Low Stock")
                                            {
                                                <span class="items-status low-stock">
                                                    Low Stock
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="items-status out-of-stock">
                                                    Out of Stock
                                                </span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="items-empty-state">
                        <div class="items-empty-icon">
                            <i class="fa-solid fa-box-open"></i>
                        </div>

                        <h5 class="items-empty-title">
                            No Items Found
                        </h5>

                        <p class="items-empty-description">
                            No product items were found in the database.
                        </p>
                    </div>
                }
            </div>

            <!-- Card Footer -->
            <div class="items-card-footer">
                <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-2">
                    <span class="items-footer-text">
                        Showing @(Model?.Count() ?? 0) product records
                    </span>

                    <span class="items-footer-text">
                        <i class="fa-solid fa-shield-halved me-1"></i>
                        Inventory data overview
                    </span>
                </div>
            </div>

        </div>

    </div>
</div>
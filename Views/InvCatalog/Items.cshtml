@model IEnumerable<ERP_System.Models.Product>
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Items & SKUs Master";
}

<div class="container-fluid py-4 text-start">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-bold mb-1"><i class="fa-solid fa-box-open text-primary me-2"></i>Items & SKUs Master</h4>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0 small">
                    <li class="breadcrumb-item"><a href="/InventoryDashboard" class="text-decoration-none">Inventory Dashboard</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Items & SKUs</li>
                </ol>
            </nav>
        </div>
    </div>

    <!-- Items Grid -->
    <div class="bg-white border rounded-3 p-4 shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" style="font-size: 0.85rem;">
                <thead class="table-light">
                    <tr>
                        <th>Product Name</th>
                        <th>Category</th>
                        <th>Sold Qty</th>
                        <th>Revenue</th>
                        <th>Stock Qty</th>
                        <th>Branch</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var p in Model)
                        {
                            <tr>
                                <td class="fw-bold text-dark">@p.ProductName</td>
                                <td>@p.Category</td>
                                <td>@p.SoldQty Items</td>
                                <td>₹@p.Revenue.ToString("N2")</td>
                                <td>@p.StockQty Units</td>
                                <td>@(p.Branch != null ? p.Branch.BranchName : "Head Office")</td>
                                <td>
                                    @if (p.Status == "In Stock")
                                    {
                                        <span class="badge bg-success-subtle text-success rounded-pill px-2.5 py-1">In Stock</span>
                                    }
                                    else if (p.Status == "Low Stock")
                                    {
                                        <span class="badge bg-warning-subtle text-warning rounded-pill px-2.5 py-1">Low Stock</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger-subtle text-danger rounded-pill px-2.5 py-1">Out of Stock</span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center py-4 text-muted">No items found in database.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

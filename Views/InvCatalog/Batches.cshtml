@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Batch & Expiry Management";
}

<div class="container-fluid py-4 text-start">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-bold mb-1"><i class="fa-solid fa-hourglass-half text-primary me-2"></i>Batch & Expiry Management</h4>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0 small">
                    <li class="breadcrumb-item"><a href="/InventoryDashboard" class="text-decoration-none">Inventory Dashboard</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Batch Management</li>
                </ol>
            </nav>
        </div>
    </div>

    <!-- Batch Management Table -->
    <div class="bg-white border rounded-3 p-4 shadow-sm">
        <h5 class="fw-bold mb-3">Active Batches</h5>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" style="font-size: 0.85rem;">
                <thead class="table-light">
                    <tr>
                        <th>Batch Code</th>
                        <th>Item Name</th>
                        <th>Manufacture Date</th>
                        <th>Expiry Date</th>
                        <th>Stock Available</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td class="fw-bold text-dark">BAT-2026-A1</td>
                        <td>Dell Wired Keyboard</td>
                        <td>10 Jan 2026</td>
                        <td>10 Jan 2029</td>
                        <td>120 Units</td>
                        <td><span class="badge bg-success-subtle text-success">Active</span></td>
                    </tr>
                    <tr>
                        <td class="fw-bold text-dark">BAT-2026-B2</td>
                        <td>Logitech Wireless Mouse</td>
                        <td>15 Feb 2026</td>
                        <td>15 Feb 2029</td>
                        <td>85 Units</td>
                        <td><span class="badge bg-success-subtle text-success">Active</span></td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

        }

        .sales-delegation-page .empty-title {
            color: var(--sd-text);
            font-size: 0.92rem;
            font-weight: 700;
            margin-bottom: 4px;
        }

        .sales-delegation-page .empty-text {
            color: var(--sd-muted);

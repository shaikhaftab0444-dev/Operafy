        }

        /* Modal */
        .sales-delegation-page + .modal,
        #assignTargetModal {
            --modal-radius: 18px;
        }

            #assignTargetModal .modal-dialog {
                max-width: 600px;
            }

            #assignTargetModal .modal-content {
                border: 0;
                border-radius: 18px;
                overflow: hidden;
                box-shadow: 0 24px 70px rgba(15, 23, 42, 0.2);
            }

            #assignTargetModal .modal-header {
                position: relative;
                padding: 19px 21px;
                border: 0;
                background: linear-gradient(135deg, #2563eb 0%, #1d4ed8 100%);
            }

                #assignTargetModal .modal-header::after {
                    content: "";
                    position: absolute;
                    width: 150px;
                    height: 150px;
                    right: -60px;
                    top: -85px;
                    border-radius: 50%;
                    background: rgba(255, 255, 255, 0.07);
                }

            #assignTargetModal .modal-title {
                position: relative;
                z-index: 1;

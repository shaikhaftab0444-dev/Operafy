            }

            #assignTargetModal .form-label {
                color: #475569 !important;
                font-size: 0.75rem;
                font-weight: 700 !important;
                margin-bottom: 7px;
            }

            #assignTargetModal .form-control,
            #assignTargetModal .form-select {
                min-height: 43px;
                border-radius: 10px;
                border: 1px solid #dbe2ea;
                color: #1e293b;
                font-size: 0.82rem;
                background-color: #fff;

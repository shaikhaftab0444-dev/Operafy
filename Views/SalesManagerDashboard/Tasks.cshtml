        }

        .sales-delegation-page .priority-badge,
        .sales-delegation-page .status-badge {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            border-radius: 999px;
            padding: 6px 9px;
            font-size: 0.69rem;
            font-weight: 700;
            white-space: nowrap;
        }

        .sales-delegation-page .priority-high {
            color: var(--sd-danger);
            background: var(--sd-danger-soft);
            border: 1px solid #fecaca;
        }

        .sales-delegation-page .priority-medium {
            color: var(--sd-warning);
            background: var(--sd-warning-soft);
            border: 1px solid #fde68a;
        }

        .sales-delegation-page .priority-low {
            color: var(--sd-info);
            background: var(--sd-info-soft);
            border: 1px solid #a5f3fc;
        }

        .sales-delegation-page .status-completed {
            color: #fff;
            background: var(--sd-success);
            border: 1px solid var(--sd-success);
        }

        .sales-delegation-page .status-active {
            color: var(--sd-primary);
            background: var(--sd-primary-soft);
            border: 1px solid #bfdbfe;
        }

        .sales-delegation-page .date-cell {
            display: inline-flex;
            align-items: center;
            gap: 7px;
            color: #475569;
            font-size: 0.77rem;
            white-space: nowrap;
        }

            .sales-delegation-page .date-cell i {
                color: #94a3b8;
            }

        .sales-delegation-page .created-date {
            color: #64748b;
            font-size: 0.76rem;
            white-space: nowrap;
        }

        /* Empty state */
        .sales-delegation-page .empty-state {
            padding: 65px 20px !important;
            text-align: center;
        }

        .sales-delegation-page .empty-icon {
            width: 62px;
            height: 62px;
            margin: 0 auto 14px;
            border-radius: 17px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: #f1f5f9;
            color: #94a3b8;

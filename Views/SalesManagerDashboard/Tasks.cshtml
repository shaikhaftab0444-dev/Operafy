<div class="sales-delegation-page">
    <div class="container-fluid py-3 px-3 px-md-4 page-shell">

        <!-- Header -->
        <div class="page-header d-flex flex-wrap justify-content-between align-items-center gap-3">
            <div class="header-content">
                <div class="breadcrumb-line">
                    <a href="@Url.Action("Index", "SalesManagerDashboard")">
                        <i class="fa-solid fa-chart-line me-1"></i> Sales Manager Portal
                    </a>
                    <span class="breadcrumb-separator">/</span>
                    <span>Team Operations</span>
                </div>

                <div class="d-flex align-items-center">
                    <span class="header-icon">
                        <i class="fa-solid fa-list-check"></i>
                    </span>

                    <div>
                        <h4 class="page-title">Sales Target & Task Delegation</h4>
                        <p class="page-subtitle">Assign, monitor and manage operational targets across your sales team.</p>
                    </div>
                </div>
            </div>

            <div class="header-action">
                <button type="button"
                        class="btn btn-assign"
                        data-bs-toggle="modal"
                        data-bs-target="#assignTargetModal">
                    <i class="fa-solid fa-plus me-2"></i>
                    Assign Target / Task
                </button>
            </div>
        </div>

        <!-- Alerts -->
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show shadow-sm border-0 status-alert" role="alert">
                <i class="fa-solid fa-circle-check me-2"></i>
                @TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show shadow-sm border-0 status-alert" role="alert">
                <i class="fa-solid fa-circle-exclamation me-2"></i>
                @TempData["ErrorMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <!-- Summary -->
        <div class="summary-grid">

            <div class="summary-card">
                <div class="summary-icon primary">
                    <i class="fa-solid fa-layer-group"></i>
                </div>
                <div class="summary-label">Active Delegations</div>
                <div class="summary-value">@Model.Count</div>
            </div>

            <div class="summary-card warning">
                <div class="summary-icon warning">
                    <i class="fa-solid fa-hourglass-half"></i>
                </div>
                <div class="summary-label">Pending / Assigned</div>
                <div class="summary-value">
                    @Model.Count(t => t.Status == "Pending" || t.Status == "Assigned")
                </div>
            </div>

            <div class="summary-card success">
                <div class="summary-icon success">
                    <i class="fa-solid fa-circle-check"></i>
                </div>
                <div class="summary-label">Completed</div>
                <div class="summary-value">
                    @Model.Count(t => t.Status == "Completed")
                </div>
            </div>

        </div>

        <!-- Delegation Table -->
        <div class="delegation-card">

            <div class="card-toolbar d-flex flex-wrap justify-content-between align-items-center gap-3">

                <div>
                    <div class="d-flex align-items-center gap-2">
                        <span class="toolbar-title">Team Delegations</span>
                        <span class="count-badge">@Model.Count</span>
                    </div>
                    <div class="toolbar-subtitle">
                        Current targets and operational tasks assigned to sales executives.
                    </div>
                </div>

                <div class="toolbar-status">
                    <span class="status-summary pending">
                        <i class="fa-solid fa-clock"></i>
                        Pending: @Model.Count(t => t.Status == "Pending" || t.Status == "Assigned")
                    </span>

                    <span class="status-summary completed">
                        <i class="fa-solid fa-check"></i>
                        Completed: @Model.Count(t => t.Status == "Completed")
                    </span>
                </div>

            </div>

            <div class="table-wrapper">
                <table class="table delegation-table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Target / Task Title</th>
                            <th>Assigned Sales Executive</th>
                            <th>Priority</th>
                            <th>Due Date</th>
                            <th>Delegated On</th>
                            <th class="text-end">Status</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="6" class="empty-state">
                                    <div class="empty-icon">
                                        <i class="fa-solid fa-list-check"></i>
                                    </div>

                                    <div class="empty-title">
                                        No operational targets or tasks yet
                                    </div>

                                    <p class="empty-text">
                                        Use the Assign Target / Task button to create the first team delegation.
                                    </p>
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var task in Model)
                            {
                                var exec = teamMembers.FirstOrDefault(t => t.UserId.ToString() == task.AssignedToUserId || t.UserName == task.AssignedToUserId || t.FullName == task.AssignedToUserId);
                                var execName = exec?.FullName ?? (!string.IsNullOrEmpty(task.AssignedToUserId) ? task.AssignedToUserId : "All Team");
                                var priorityBadge = task.Priority == "High" ? "priority-high" : (task.Priority == "Medium" ? "priority-medium" : "priority-low");
                                var statusBadge = task.Status == "Completed" ? "status-completed" : "status-active";

                                <tr>
                                    <td>
                                        <div class="task-title">
                                            @task.Title
                                        </div>

                                        @if (!string.IsNullOrEmpty(task.Description))
                                        {
                                            <div class="task-description">
                                                @task.Description
                                            </div>
                                        }
                                    </td>

                                    <td>
                                        <span class="executive-cell">
                                            <span class="executive-avatar">
                                                <i class="fa-regular fa-user"></i>
                                            </span>
                                            <span>@execName</span>
                                        </span>
                                    </td>

                                    <td>
                                        <span class="priority-badge @priorityBadge">
                                            @if (task.Priority == "High")
                                            {
                                                <i class="fa-solid fa-arrow-up"></i>
                                            }
                                            else if (task.Priority == "Medium")
                                            {
                                                <i class="fa-solid fa-minus"></i>
                                            }
                                            else
                                            {
                                                <i class="fa-solid fa-arrow-down"></i>
                                            }

                                            @task.Priority
                                        </span>
                                    </td>

                                    <td>
                                        <span class="date-cell">
                                            <i class="fa-regular fa-calendar"></i>
                                            @(task.DueDate?.ToString("dd MMM yyyy") ?? "N/A")
                                        </span>
                                    </td>

                                    <td>
                                        <span class="created-date">
                                            @(task.CreatedAt?.ToString("dd MMM yyyy") ?? "N/A")
                                        </span>
                                    </td>

                                    <td class="text-end">
                                        <span class="status-badge @statusBadge">
                                            @if (task.Status == "Completed")
                                            {
                                                <i class="fa-solid fa-check"></i>
                                            }
                                            else
                                            {
                                                <i class="fa-solid fa-clock"></i>
                                            }

                                            @task.Status
                                        </span>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>

    </div>
</div>

<!-- Modal: Assign New Target / Task -->
<div class="modal fade"
     id="assignTargetModal"
     tabindex="-1"
     aria-labelledby="assignTargetModalLabel"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content">

            <div class="modal-header text-white">

                <h5 class="modal-title fw-bold" id="assignTargetModalLabel">
                    <i class="fa-solid fa-bullseye me-2"></i>
                    Assign Sales Target / Task
                </h5>

                <button type="button"
                        class="btn-close btn-close-white"
                        data-bs-dismiss="modal"
                        aria-label="Close"></button>

            </div>

            <form asp-action="AssignTask"
                  asp-controller="SalesManagerDashboard"
                  method="post">

                @Html.AntiForgeryToken()

                <div class="modal-body">

                    <div class="mb-3">
                        <label class="form-label">
                            Assign To Sales Executive
                            <span class="text-danger">*</span>
                        </label>

                        <select name="assignedToUserId"
                                class="form-select"
                                required>

                            <option value="">-- Choose Sales Executive --</option>

                            @foreach (var user in teamMembers)
                            {
                                <option value="@user.UserId">
                                    @user.FullName (@user.Email)
                                </option>
                            }

                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">
                            Target / Task Title
                            <span class="text-danger">*</span>
                        </label>

                        <input type="text"
                               name="title"
                               class="form-control"
                               placeholder="e.g. Q3 Healthcare Sector Lead Conversion"
                               required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">
                            Description / Operational Objective
                        </label>

                        <textarea name="description"
                                  class="form-control"
                                  rows="3"
                                  placeholder="Specify KPIs, expected revenue, or deliverable details..."></textarea>
                    </div>

                    <div class="row g-3 mb-1">

                        <div class="col-md-6">
                            <label class="form-label">
                                Priority
                            </label>

                            <select name="priority"
                                    class="form-select">

                                <option value="High">High</option>
                                <option value="Medium" selected>Medium</option>
                                <option value="Low">Low</option>

                            </select>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">
                                Due Date
                                <span class="text-danger">*</span>
                            </label>

                            <input type="date"
                                   name="dueDate"
                                   class="form-control"
                                   value="@DateTime.Today.AddDays(7).ToString("yyyy-MM-dd")"
                                   required />
                        </div>

                    </div>

                </div>

                <div class="modal-footer">

                    <button type="button"
                            class="btn btn-secondary"
                            data-bs-dismiss="modal">
                        Cancel
                    </button>

                    <button type="submit"
                            class="btn btn-primary px-4">
                        <i class="fa-solid fa-paper-plane me-2"></i>
                        Assign Target
                    </button>

                </div>

            </form>

        </div>

    </div>
</div>

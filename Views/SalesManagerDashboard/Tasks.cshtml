@model List<ERP_System.Models.HierarchicalTask>
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Sales Target & Task Delegation";
    var teamMembers = ViewBag.TeamMembers as List<ERP_System.Models.User> ?? new List<ERP_System.Models.User>();
}

<style>
    /* =========================================================
           SALES TARGET & TASK DELEGATION
           Scoped UI styles - backend/Razor logic unchanged
           ========================================================= */

    .sales-delegation-page {
        --sd-primary: #2563eb;
        --sd-primary-dark: #1d4ed8;
        --sd-primary-soft: #eff6ff;
        --sd-success: #16a34a;
        --sd-success-soft: #f0fdf4;
        --sd-warning: #d97706;
        --sd-warning-soft: #fffbeb;
        --sd-danger: #dc2626;
        --sd-danger-soft: #fef2f2;
        --sd-info: #0891b2;
        --sd-info-soft: #ecfeff;
        --sd-text: #172033;
        --sd-muted: #64748b;
        --sd-border: #e5eaf1;
        --sd-bg: #f6f8fc;
        --sd-white: #ffffff;
        --sd-radius: 16px;
        --sd-shadow: 0 8px 24px rgba(15, 23, 42, 0.055);
        --sd-shadow-hover: 0 14px 32px rgba(15, 23, 42, 0.09);
    }

    .sales-delegation-page {
        min-height: calc(100vh - 70px);
        background: radial-gradient(circle at top right, rgba(37, 99, 235, 0.045), transparent 30%), linear-gradient(180deg, #f8faff 0%, #f6f8fc 100%);
        padding-bottom: 32px;
    }

        .sales-delegation-page .page-shell {
            max-width: 1600px;
            margin: 0 auto;
        }

        /* Header */
        .sales-delegation-page .page-header {
            padding: 6px 0 20px;
        }

        .sales-delegation-page .breadcrumb-line {
            display: flex;
            align-items: center;
            flex-wrap: wrap;
            gap: 7px;
            margin-bottom: 8px;
            color: var(--sd-muted);
            font-size: 0.78rem;
        }

            .sales-delegation-page .breadcrumb-line a {
                color: var(--sd-muted);
                text-decoration: none;
                transition: color 0.2s ease;
            }

                .sales-delegation-page .breadcrumb-line a:hover {
                    color: var(--sd-primary);
                }

        .sales-delegation-page .breadcrumb-separator {
            color: #cbd5e1;
        }

        .sales-delegation-page .page-title {
            color: var(--sd-text);
            font-size: clamp(1.35rem, 2vw, 1.75rem);
            font-weight: 750;
            letter-spacing: -0.025em;
            margin: 0;
        }

        .sales-delegation-page .page-subtitle {
            color: var(--sd-muted);
            font-size: 0.86rem;
            margin: 5px 0 0;
        }

        .sales-delegation-page .header-icon {
            width: 42px;
            height: 42px;
            border-radius: 12px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            background: var(--sd-primary-soft);
            color: var(--sd-primary);
            margin-right: 10px;
            box-shadow: inset 0 0 0 1px rgba(37, 99, 235, 0.08);
        }

        /* Main button */
        .sales-delegation-page .btn-assign {
            border: 0;
            border-radius: 11px;
            padding: 10px 17px;
            background: linear-gradient(135deg, #2563eb, #1d4ed8);
            color: #fff;
            font-weight: 650;
            font-size: 0.84rem;
            box-shadow: 0 7px 16px rgba(37, 99, 235, 0.18);
            transition: all 0.2s ease;
        }

            .sales-delegation-page .btn-assign:hover {
                color: #fff;
                transform: translateY(-1px);
                box-shadow: 0 10px 22px rgba(37, 99, 235, 0.24);
            }

            .sales-delegation-page .btn-assign:active {
                transform: translateY(0);
            }

        /* Alerts */
        .sales-delegation-page .status-alert {
            border-radius: 12px;
            padding: 12px 15px;
            font-size: 0.84rem;
            margin-bottom: 18px;
        }

        /* KPI cards */
        .sales-delegation-page .summary-grid {
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 15px;
            margin-bottom: 20px;
        }

        .sales-delegation-page .summary-card {
            position: relative;
            overflow: hidden;
            background: rgba(255, 255, 255, 0.92);
            border: 1px solid var(--sd-border);
            border-radius: var(--sd-radius);
            padding: 17px 18px;
            box-shadow: var(--sd-shadow);
            transition: all 0.22s ease;
        }

            .sales-delegation-page .summary-card:hover {
                transform: translateY(-2px);
                box-shadow: var(--sd-shadow-hover);
            }

            .sales-delegation-page .summary-card::after {
                content: "";
                position: absolute;
                width: 80px;
                height: 80px;
                border-radius: 50%;
                right: -30px;
                top: -30px;
                background: rgba(37, 99, 235, 0.035);
            }

            .sales-delegation-page .summary-card.warning::after {
                background: rgba(217, 119, 6, 0.045);
            }

            .sales-delegation-page .summary-card.success::after {
                background: rgba(22, 163, 74, 0.045);
            }

        .sales-delegation-page .summary-icon {
            width: 40px;
            height: 40px;
            border-radius: 11px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 12px;
            font-size: 0.95rem;
        }

            .sales-delegation-page .summary-icon.primary {
                background: var(--sd-primary-soft);
                color: var(--sd-primary);
            }

            .sales-delegation-page .summary-icon.warning {
                background: var(--sd-warning-soft);
                color: var(--sd-warning);
            }

            .sales-delegation-page .summary-icon.success {
                background: var(--sd-success-soft);
                color: var(--sd-success);
            }

        .sales-delegation-page .summary-label {
            color: var(--sd-muted);
            font-size: 0.75rem;
            font-weight: 650;
            text-transform: uppercase;
            letter-spacing: 0.055em;
            margin-bottom: 3px;
        }

        .sales-delegation-page .summary-value {
            color: var(--sd-text);
            font-size: 1.35rem;
            line-height: 1.2;
            font-weight: 750;
        }

        /* Main table card */
        .sales-delegation-page .delegation-card {
            background: var(--sd-white);
            border: 1px solid var(--sd-border);
            border-radius: 17px;
            box-shadow: var(--sd-shadow);
            overflow: hidden;
        }

        .sales-delegation-page .card-toolbar {
            padding: 17px 19px;
            border-bottom: 1px solid var(--sd-border);
            background: linear-gradient(180deg, #ffffff 0%, #fbfcfe 100%);
        }

        .sales-delegation-page .toolbar-title {
            color: var(--sd-text);
            font-size: 0.92rem;
            font-weight: 700;
        }

        .sales-delegation-page .toolbar-subtitle {
            color: var(--sd-muted);
            font-size: 0.76rem;
            margin-top: 2px;
        }

        .sales-delegation-page .count-badge {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-width: 28px;
            height: 24px;
            padding: 0 8px;
            border-radius: 999px;
            background: var(--sd-primary-soft);
            color: var(--sd-primary);
            font-size: 0.72rem;
            font-weight: 750;
        }

        .sales-delegation-page .toolbar-status {
            display: flex;
            align-items: center;
            flex-wrap: wrap;
            gap: 7px;
        }

        .sales-delegation-page .status-summary {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            border-radius: 999px;
            padding: 6px 10px;
            font-size: 0.72rem;
            font-weight: 650;
            border: 1px solid transparent;
        }

            .sales-delegation-page .status-summary.pending {
                color: var(--sd-warning);
                background: var(--sd-warning-soft);
                border-color: #fde68a;
            }

            .sales-delegation-page .status-summary.completed {
                color: var(--sd-success);
                background: var(--sd-success-soft);
                border-color: #bbf7d0;
            }

        /* Table */
        .sales-delegation-page .table-wrapper {
            overflow-x: auto;
        }

        .sales-delegation-page .delegation-table {
            min-width: 920px;
        }

            .sales-delegation-page .delegation-table thead th {
                background: #f8fafc;
                color: #64748b;
                border-bottom: 1px solid var(--sd-border);
                border-top: 0;

@model List<ERP_System.Models.HierarchicalTask>
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Sales Target & Task Delegation";
    var teamMembers = ViewBag.TeamMembers as List<ERP_System.Models.User> ?? new List<ERP_System.Models.User>();
}

<style>
    .sales-table-card {
        background: #ffffff;
        border-radius: 14px;
        border: 1px solid var(--border-warm, #e2e8f0);
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.04);
        overflow: hidden;
    }
</style>

<div class="container-fluid py-3 px-3 px-md-4">
    <!-- Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <div class="text-muted small mb-1">
                <a href="@Url.Action("Index", "SalesManagerDashboard")" class="text-decoration-none text-muted">Sales Manager Portal</a> / <span>Team Operations</span>
            </div>
            <h4 class="fw-bold mb-0 text-dark">
                <i class="fa-solid fa-list-check text-primary me-2"></i>Sales Target & Task Delegation
            </h4>
        </div>
        <button type="button" class="btn btn-primary px-3 shadow-sm" data-bs-toggle="modal" data-bs-target="#assignTargetModal">
            <i class="fa-solid fa-plus me-1.5"></i> Assign Target / Task
        </button>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm border-0 mb-3" role="alert">
            <i class="fa-solid fa-circle-check me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm border-0 mb-3" role="alert">
            <i class="fa-solid fa-circle-exclamation me-2"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Delegation Table Card -->
    <div class="sales-table-card">
        <div class="p-3 border-bottom d-flex flex-wrap justify-content-between align-items-center gap-3 bg-light-subtle">
            <div class="d-flex align-items-center gap-2">
                <span class="fw-bold small text-secondary">Active Sales Delegations:</span>
                <span class="badge bg-primary rounded-pill">@Model.Count</span>
            </div>
            <div class="d-flex gap-2">
                <span class="badge bg-warning-subtle text-warning px-2.5 py-1 rounded-pill small">
                    Pending: @Model.Count(t => t.Status == "Pending" || t.Status == "Assigned")
                </span>
                <span class="badge bg-success-subtle text-success px-2.5 py-1 rounded-pill small">
                    Completed: @Model.Count(t => t.Status == "Completed")
                </span>
            </div>
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr class="small text-uppercase text-muted">
                        <th>Target / Task Title</th>
                        <th>Assigned Sales Executive</th>
                        <th>Priority</th>
                        <th>Due Date</th>
                        <th>Delegated On</th>
                        <th class="text-end">Status</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5 text-muted">
                                <i class="fa-solid fa-tasks fs-2 d-block mb-2 text-secondary"></i>
                                No operational targets or tasks delegated yet.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var task in Model)
                        {
                            var exec = teamMembers.FirstOrDefault(t => t.UserId.ToString() == task.AssignedToUserId || t.UserName == task.AssignedToUserId || t.FullName == task.AssignedToUserId);
                            var execName = exec?.FullName ?? (!string.IsNullOrEmpty(task.AssignedToUserId) ? task.AssignedToUserId : "All Team");
                            var priorityBadge = task.Priority == "High" ? "bg-danger-subtle text-danger border border-danger" : (task.Priority == "Medium" ? "bg-warning-subtle text-warning border border-warning" : "bg-info-subtle text-info border border-info");
                            var statusBadge = task.Status == "Completed" ? "bg-success text-white" : "bg-primary-subtle text-primary border border-primary";

                            <tr>
                                <td>
                                    <div class="fw-bold text-dark">@task.Title</div>
                                    <div class="text-muted extra-small">@task.Description</div>
                                </td>
                                <td>
                                    <span class="small fw-semibold text-dark">
                                        <i class="fa-regular fa-user me-1.5 text-primary"></i>@execName
                                    </span>
                                </td>
                                <td>
                                    <span class="badge @priorityBadge px-2 py-1 rounded-pill small">@task.Priority</span>
                                </td>
                                <td>
                                    <span class="small font-monospace text-dark">
                                        <i class="fa-regular fa-calendar me-1 text-muted"></i>@(task.DueDate?.ToString("dd MMM yyyy") ?? "N/A")
                                    </span>
                                </td>
                                <td>
                                    <span class="text-muted small">@(task.CreatedAt?.ToString("dd MMM yyyy") ?? "N/A")</span>
                                </td>
                                <td class="text-end">
                                    <span class="badge @statusBadge px-2.5 py-1 rounded-pill small">@task.Status</span>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal: Assign New Target / Task -->
<div class="modal fade" id="assignTargetModal" tabindex="-1" aria-labelledby="assignTargetModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title fw-bold" id="assignTargetModalLabel">
                    <i class="fa-solid fa-bullseye me-2"></i>Assign Sales Target / Task
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="AssignTask" asp-controller="SalesManagerDashboard" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-muted">Assign To Sales Executive <span class="text-danger">*</span></label>
                        <select name="assignedToUserId" class="form-select" required>
                            <option value="">-- Choose Sales Executive --</option>
                            @foreach (var user in teamMembers)
                            {
                                <option value="@user.UserId">@user.FullName (@user.Email)</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-muted">Target / Task Title <span class="text-danger">*</span></label>
                        <input type="text" name="title" class="form-control" placeholder="e.g. Q3 Healthcare Sector Lead Conversion" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-muted">Description / Operational Objective</label>
                        <textarea name="description" class="form-control" rows="3" placeholder="Specify KPIs, expected revenue, or deliverable details..."></textarea>
                    </div>
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold text-muted">Priority</label>
                            <select name="priority" class="form-select">
                                <option value="High">High</option>
                                <option value="Medium" selected>Medium</option>
                                <option value="Low">Low</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold text-muted">Due Date <span class="text-danger">*</span></label>
                            <input type="date" name="dueDate" class="form-control" value="@DateTime.Today.AddDays(7).ToString("yyyy-MM-dd")" required />
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary px-3" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary px-4">
                        <i class="fa-solid fa-paper-plane me-1.5"></i> Assign Target
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

    }

    .sales-delegation-page .summary-icon {
        margin-bottom: 8px;
    }

    .sales-delegation-page .card-toolbar {
        align-items: flex-start !important;
        flex-direction: column;
    }

    .sales-delegation-page .toolbar-status {
        width: 100%;
    }


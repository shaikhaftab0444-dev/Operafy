            }

            .sales-delegation-page .delegation-table tbody td {
                padding: 15px 16px;
                border-color: #eef2f7;
                color: var(--sd-text);
                vertical-align: middle;
            }

            .sales-delegation-page .delegation-table tbody tr {
                transition: background-color 0.18s ease;
            }

                .sales-delegation-page .delegation-table tbody tr:hover {
                    background: #f8fbff;
                }

        .sales-delegation-page .task-title {
            color: var(--sd-text);
            font-size: 0.84rem;
            font-weight: 700;
            line-height: 1.4;
        }

        .sales-delegation-page .task-description {
            color: var(--sd-muted);
            font-size: 0.73rem;
            line-height: 1.45;
            max-width: 330px;
            margin-top: 3px;
        }

        .sales-delegation-page .executive-cell {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            font-size: 0.79rem;
            font-weight: 650;

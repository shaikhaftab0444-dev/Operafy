        margin: 10px;
    }

    #assignTargetModal .modal-body {
        padding: 18px;
    }

    }

    @@media (max-width: 480px) {
        .sales-delegation-page .page-title

    {
        font-size: 1.25rem;
    }

    .sales-delegation-page .header-icon {
        width: 37px;
        height: 37px;
        border-radius: 10px;
        margin-right: 7px;
    }

    .sales-delegation-page .toolbar-status {
        flex-direction: column;

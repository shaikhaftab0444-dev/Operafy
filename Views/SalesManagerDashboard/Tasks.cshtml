    }

    /* Print */
    @@media print {
        .sales-delegation-page

    {
        background: #fff !important;
    }

    .sales-delegation-page .page-header .header-action,
    .sales-delegation-page .summary-grid,
    #assignTargetModal {
        display: none !important;
    }

    .sales-delegation-page .delegation-card {

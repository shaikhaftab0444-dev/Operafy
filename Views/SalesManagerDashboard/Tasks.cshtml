    /* Responsive */
    @@media (max-width: 992px) {
        .sales-delegation-page .summary-grid

    {
        grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    }

    @@media (max-width: 768px) {
        .sales-delegation-page

    {
        padding-bottom: 20px;
    }

    .sales-delegation-page .page-header {
        padding-top: 2px;
    }

    .sales-delegation-page .header-content {
        width: 100%;
    }

    .sales-delegation-page .header-action {
        width: 100%;
    }

    .sales-delegation-page .btn-assign {
        width: 100%;
        justify-content: center;
    }

    .sales-delegation-page .summary-grid {
        grid-template-columns: 1fr;
        gap: 10px;

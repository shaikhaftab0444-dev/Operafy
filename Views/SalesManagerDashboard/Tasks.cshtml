            }

            #assignTargetModal .modal-footer {
                padding: 15px 21px;
                border-top: 1px solid #e8edf3;
                background: #f8fafc !important;
            }

                #assignTargetModal .modal-footer .btn {
                    border-radius: 9px;
                    font-size: 0.8rem;
                    font-weight: 650;
                    padding: 9px 15px;
                }

                #assignTargetModal .modal-footer .btn-primary {
                    border: 0;
                    background: linear-gradient(135deg, #2563eb, #1d4ed8);
                    box-shadow: 0 6px 15px rgba(37, 99, 235, 0.16);
                }

                #assignTargetModal .modal-footer .btn-secondary {
                    background: #fff;
                    color: #475569;
                    border: 1px solid #dbe2ea;

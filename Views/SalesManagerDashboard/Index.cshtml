@section Scripts {
    <script>
        // =========================================================
        // Review & Sign-Off Quotation Discount
        // Existing endpoint preserved
        // =========================================================
        async function submitQuoteReview(id, decision) {
            const remarks = prompt(
                `Enter remarks for ${decision.toLowerCase()} this quotation discount:`,
                decision === 'Approved'
                    ? 'Discount within permissible margin.'
                    : 'Discount exceeds acceptable threshold.'
            );

            if (remarks === null) return;

            const formData = new URLSearchParams();
            formData.append('quotationId', id);
            formData.append('decision', decision);
            formData.append('remarks', remarks);

            const res = await fetch('/SalesManagerDashboard/ReviewQuotation', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded'
                },
                body: formData.toString()
            });

            const data = await res.json();

            if (data.success) {
                alert(data.message);
                location.reload();
            } else {
                alert(data.message || 'Action failed.');
            }
        }

        // =========================================================
        // Rep Drilldown JSON Modal Trigger
        // Existing endpoint preserved
        // =========================================================
        async function openRepDrilldown(repId) {
            try {
                const res = await fetch(
                    `/SalesManagerDashboard/GetRepDetails?repId=${encodeURIComponent(repId)}`
                );

                const data = await res.json();

                if (data.success) {

                    document.getElementById('repModalName').innerText = data.name;

                    document.getElementById('repModalEmail').innerText =
                        data.email || 'N/A';

                    document.getElementById('repModalWon').innerText =
                        `${data.wonDeals} / ${data.totalDeals}`;

                    document.getElementById('repModalRevenue').innerText =
                        `₹ ${Number(data.totalRevenue).toLocaleString('en-IN')}`;

                    document.getElementById('repModalPipeline').innerText =
                        `₹ ${Number(data.activePipeline).toLocaleString('en-IN')}`;

                    new bootstrap.Modal(
                        document.getElementById('repDrilldownModal')
                    ).show();

                } else {
                    alert(
                        data.message ||
                        'Unable to retrieve representative data.'
                    );
                }

            } catch (err) {
                console.error(err);
                alert('Error connecting to drilldown service.');
            }
        }

        // =========================================================
        // Top Filter Bar Change
        // Existing route preserved
        // =========================================================
        function onDateRangeChange(val) {
            window.location.href =
                `/SalesManagerDashboard?dateRange=${encodeURIComponent(val)}`;
        }

        // =========================================================
        // Quick Action: Add Lead submission
        // Existing endpoint and field names preserved
        // =========================================================
        async function submitNewLead(e) {
            e.preventDefault();

            const form = e.target;
            const formData = new FormData(form);
            const searchParams = new URLSearchParams();

            for (const pair of formData) {
                searchParams.append(pair[0], pair[1]);
            }

            try {

                const res = await fetch('/SalesManagerDashboard/AddLead', {
                    method: 'POST',
                    headers: {
                        'Content-Type':
                            'application/x-www-form-urlencoded'
                    },
                    body: searchParams.toString()
                });

                const data = await res.json();

                if (data.success) {
                    alert(data.message);
                    location.reload();
                } else {
                    alert(
                        data.message ||
                        'Failed to create lead.'
                    );
                }

            } catch (err) {
                console.error(err);
                alert('Error creating lead.');
            }
        }

        // =========================================================
        // Quick Action: Assign Target submission
        // Existing endpoint and field names preserved
        // =========================================================
        async function submitAssignTarget(e) {
            e.preventDefault();

            const form = e.target;
            const formData = new FormData(form);
            const searchParams = new URLSearchParams();

            for (const pair of formData) {
                searchParams.append(pair[0], pair[1]);
            }

            try {

                const res = await fetch(
                    '/SalesManagerDashboard/AssignTarget',
                    {
                        method: 'POST',
                        headers: {
                            'Content-Type':
                                'application/x-www-form-urlencoded'
                        },
                        body: searchParams.toString()
                    }
                );

                const data = await res.json();

                if (data.success) {
                    alert(data.message);
                    location.reload();
                } else {
                    alert(
                        data.message ||
                        'Failed to assign target.'
                    );
                }

            } catch (err) {
                console.error(err);
                alert('Error assigning target.');
            }
        }
    </script>
}
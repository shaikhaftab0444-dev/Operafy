@model ERP_System.Models.SalesManagerDashboardViewModel
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Sales Manager Dashboard";

    var inCulture = new System.Globalization.CultureInfo("en-IN");
    var now = DateTime.Now;
    var activeMonthName = now.ToString("MMMM yyyy");

    decimal totalRevenue = ViewBag.TotalRevenue ?? Model?.TotalTeamSalesRevenue ?? 0m;
    int activeReps = ViewBag.ActiveReps ?? Model?.ActiveSalesRepsCount ?? 0;
    decimal avgSales = ViewBag.AvgSales ?? Model?.AverageSalesPerRep ?? 0m;
    decimal targetAchievedPct = ViewBag.TargetAchievedPct ?? Model?.TeamTargetAchievementPercent ?? 0m;
    decimal goalAmount = ViewBag.GoalAmount ?? Model?.GoalAmount ?? 15000000m;

    var pipelineStages = (Dictionary<string, (int Count, decimal Value)>?)ViewBag.PipelineStages
        ?? Model?.PipelineStages
        ?? new Dictionary<string, (int Count, decimal Value)>
        {
            { "New", (0, 0m) },
            { "Qualified", (0, 0m) },
            { "Quotation Sent", (0, 0m) },
            { "Negotiation", (0, 0m) },
            { "Closed Won", (0, 0m) }
        };

    var pendingApprovals = (IEnumerable<dynamic>?)ViewBag.PendingApprovals ?? Model?.PendingApprovals;
    var leaderboard = (IEnumerable<dynamic>?)ViewBag.Leaderboard ?? Model?.Leaderboard;
    var recentInvoices = (IEnumerable<dynamic>?)ViewBag.RecentInvoices ?? Model?.RecentInvoices;
    var repUsers = (IEnumerable<dynamic>?)ViewBag.RepUsers ?? Model?.RepUsers;

    string selectedDateRange = ViewBag.DateRange ?? Model?.DateRange ?? "Q3 2026";
}

<style>
    /* ============================================================
           SALES MANAGER DASHBOARD
           Scoped UI system
           ============================================================ */

    .sales-manager-dashboard {
        --sm-primary: #2563eb;
        --sm-primary-dark: #1d4ed8;
        --sm-primary-soft: #eff6ff;
        --sm-indigo: #4f46e5;
        --sm-indigo-soft: #eef2ff;
        --sm-success: #059669;
        --sm-success-soft: #ecfdf5;
        --sm-warning: #d97706;
        --sm-warning-soft: #fffbeb;
        --sm-danger: #dc2626;
        --sm-danger-soft: #fef2f2;
        --sm-purple: #7c3aed;
        --sm-purple-soft: #f5f3ff;
        --sm-cyan: #0891b2;
        --sm-cyan-soft: #ecfeff;
        --sm-text: #172033;
        --sm-muted: #64748b;
        --sm-border: #e5eaf1;
        --sm-surface: #ffffff;
        --sm-bg: #f6f8fb;
        --sm-shadow: 0 10px 30px rgba(15, 23, 42, 0.055);
        --sm-shadow-hover: 0 18px 40px rgba(15, 23, 42, 0.10);
        color: var(--sm-text);
        animation: smPageIn .55s ease both;
    }

        .sales-manager-dashboard *,
        .sales-manager-dashboard *::before,
        .sales-manager-dashboard *::after {
            box-sizing: border-box;
        }

        .sales-manager-dashboard .sm-page-shell {
            position: relative;
            padding: 4px 0 35px;
        }

            .sales-manager-dashboard .sm-page-shell::before {
                content: "";
                position: absolute;
                top: -40px;
                right: -80px;
                width: 280px;
                height: 280px;
                border-radius: 50%;
                background: radial-gradient(circle, rgba(37, 99, 235, .075), transparent 68%);
                pointer-events: none;
                z-index: 0;
            }

            .sales-manager-dashboard .sm-page-shell > * {
                position: relative;
                z-index: 1;
            }

        /* ------------------------------------------------------------
           Header
           ------------------------------------------------------------ */

        .sales-manager-dashboard .sm-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-end;
            gap: 20px;
            margin-bottom: 22px;
        }

        .sales-manager-dashboard .sm-title-area {
            min-width: 0;
        }

        .sales-manager-dashboard .sm-eyebrow {
            display: inline-flex;
            align-items: center;
            gap: 7px;
            color: var(--sm-primary);
            background: var(--sm-primary-soft);
            border: 1px solid rgba(37, 99, 235, .12);
            border-radius: 999px;
            padding: 5px 10px;
            font-size: .69rem;
            font-weight: 800;
            letter-spacing: .08em;
            text-transform: uppercase;
            margin-bottom: 9px;
        }

            .sales-manager-dashboard .sm-eyebrow i {
                font-size: .65rem;
            }

        .sales-manager-dashboard .sm-main-title {
            font-size: clamp(1.45rem, 2.4vw, 2rem);
            line-height: 1.15;
            font-weight: 800;
            letter-spacing: -.035em;
            margin: 0 0 7px;
            color: var(--sm-text);
        }

        .sales-manager-dashboard .sm-subtitle {
            margin: 0;
            color: var(--sm-muted);
            font-size: .82rem;
        }

        .sales-manager-dashboard .sm-breadcrumb {
            display: flex;
            align-items: center;
            gap: 7px;
            margin-top: 10px;
            font-size: .74rem;
            color: var(--sm-muted);
        }

            .sales-manager-dashboard .sm-breadcrumb a {
                color: var(--sm-primary);
                text-decoration: none;
                font-weight: 600;
            }

            .sales-manager-dashboard .sm-breadcrumb .separator {
                color: #a8b1bf;
            }

        .sales-manager-dashboard .sm-header-actions {
            display: flex;
            align-items: center;
            justify-content: flex-end;
            flex-wrap: wrap;
            gap: 8px;
        }

        .sales-manager-dashboard .sm-filter-control {
            height: 40px;
            display: flex;
            align-items: center;
            gap: 8px;
            background: var(--sm-surface);
            border: 1px solid var(--sm-border);
            border-radius: 11px;
            padding: 0 11px;
            box-shadow: 0 4px 14px rgba(15, 23, 42, .035);
            transition: .2s ease;
        }

            .sales-manager-dashboard .sm-filter-control:focus-within {
                border-color: rgba(37, 99, 235, .45);
                box-shadow: 0 0 0 3px rgba(37, 99, 235, .08);
            }

            .sales-manager-dashboard .sm-filter-control i {
                color: var(--sm-primary);
                font-size: .76rem;
            }

            .sales-manager-dashboard .sm-filter-control select {
                width: auto;
                min-width: 125px;
                height: 32px;
                padding: 0 25px 0 0;
                border: 0;
                box-shadow: none !important;
                outline: none !important;
                background-color: transparent;
                color: var(--sm-text);
                font-size: .76rem;
                font-weight: 700;
                cursor: pointer;
            }

        .sales-manager-dashboard .sm-action-btn {
            min-height: 40px;
            border-radius: 10px;
            padding: 0 13px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 7px;
            font-size: .76rem;
            font-weight: 700;
            transition: transform .2s ease, box-shadow .2s ease, background .2s ease;
        }

            .sales-manager-dashboard .sm-action-btn:hover {
                transform: translateY(-2px);
            }

        .sales-manager-dashboard .sm-action-primary {
            box-shadow: 0 7px 18px rgba(37, 99, 235, .17);
        }

        .sales-manager-dashboard .sm-role-card {
            min-height: 40px;
            background: var(--sm-surface);
            border: 1px solid var(--sm-border);
            border-radius: 10px;
            padding: 5px 11px;
            box-shadow: 0 4px 14px rgba(15, 23, 42, .035);
        }

        .sales-manager-dashboard .sm-role-label {
            display: block;
            font-size: .58rem;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: .06em;
            color: #94a3b8;
            line-height: 1;
            margin-bottom: 4px;
        }

        .sales-manager-dashboard .sm-role-value {
            display: block;
            font-size: .72rem;
            font-weight: 750;
            color: var(--sm-text);
            white-space: nowrap;
        }

        /* ------------------------------------------------------------
           KPI Cards
           ------------------------------------------------------------ */

        .sales-manager-dashboard .sm-kpi-grid {
            display: grid;
            grid-template-columns: repeat(4, minmax(0, 1fr));
            gap: 14px;
            margin-bottom: 20px;
        }

        .sales-manager-dashboard .sm-kpi {
            position: relative;
            overflow: hidden;
            min-height: 136px;
            border-radius: 16px;
            padding: 17px;
            color: #fff;
            isolation: isolate;
            box-shadow: 0 10px 24px rgba(15, 23, 42, .09);
            transition: transform .25s ease, box-shadow .25s ease;
            animation: smCardIn .55s ease both;
        }

            .sales-manager-dashboard .sm-kpi:nth-child(2) {
                animation-delay: .06s;
            }

            .sales-manager-dashboard .sm-kpi:nth-child(3) {
                animation-delay: .12s;
            }

            .sales-manager-dashboard .sm-kpi:nth-child(4) {
                animation-delay: .18s;
            }

            .sales-manager-dashboard .sm-kpi:hover {
                transform: translateY(-4px);
                box-shadow: var(--sm-shadow-hover);
            }

            .sales-manager-dashboard .sm-kpi::before {
                content: "";
                position: absolute;
                width: 125px;
                height: 125px;
                right: -45px;
                top: -55px;
                border: 1px solid rgba(255, 255, 255, .18);
                border-radius: 50%;
                z-index: -1;
            }

            .sales-manager-dashboard .sm-kpi::after {
                content: "";
                position: absolute;
                width: 180px;
                height: 180px;
                right: -100px;
                bottom: -115px;
                border: 1px solid rgba(255, 255, 255, .12);
                border-radius: 50%;
                z-index: -1;
            }

        .sales-manager-dashboard .sm-kpi-blue {
            background: linear-gradient(135deg, #2563eb 0%, #3b82f6 100%);
        }

        .sales-manager-dashboard .sm-kpi-indigo {
            background: linear-gradient(135deg, #4338ca 0%, #6366f1 100%);
        }

        .sales-manager-dashboard .sm-kpi-green {
            background: linear-gradient(135deg, #047857 0%, #10b981 100%);
        }

        .sales-manager-dashboard .sm-kpi-purple {
            background: linear-gradient(135deg, #6d28d9 0%, #8b5cf6 100%);
        }

        .sales-manager-dashboard .sm-kpi-top {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 10px;
            margin-bottom: 18px;
        }

        .sales-manager-dashboard .sm-kpi-label {
            display: flex;
            align-items: center;
            gap: 7px;
            font-size: .68rem;
            font-weight: 750;
            letter-spacing: .025em;
            text-transform: uppercase;
            opacity: .9;
        }

        .sales-manager-dashboard .sm-kpi-icon {
            width: 34px;
            height: 34px;
            border-radius: 10px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            background: rgba(255, 255, 255, .14);
            border: 1px solid rgba(255, 255, 255, .16);
            font-size: .92rem;
            backdrop-filter: blur(5px);
        }

        .sales-manager-dashboard .sm-kpi-period {
            font-size: .63rem;
            font-weight: 700;
            opacity: .78;
            white-space: nowrap;
        }

        .sales-manager-dashboard .sm-kpi-value {
            margin: 0;
            color: #fff;
            font-size: clamp(1.3rem, 2.2vw, 1.72rem);
            line-height: 1.1;
            font-weight: 850;
            letter-spacing: -.035em;
            white-space: nowrap;
        }

        .sales-manager-dashboard .sm-kpi-description {
            margin-top: 6px;
            font-size: .7rem;
            font-weight: 550;
            opacity: .82;
        }

        /* ------------------------------------------------------------
           Section Cards
           ------------------------------------------------------------ */

        .sales-manager-dashboard .sm-section {
            background: var(--sm-surface);
            border: 1px solid var(--sm-border);
            border-radius: 16px;
            box-shadow: var(--sm-shadow);
            margin-bottom: 20px;
            overflow: hidden;
            animation: smSectionIn .55s ease both;
        }

        .sales-manager-dashboard .sm-section-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 15px;
            padding: 18px 20px;
            border-bottom: 1px solid #eef1f5;
        }

        .sales-manager-dashboard .sm-section-heading {
            display: flex;
            align-items: center;
            gap: 11px;
            min-width: 0;
        }

        .sales-manager-dashboard .sm-section-icon {
            width: 38px;
            height: 38px;
            flex: 0 0 38px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border-radius: 11px;
            background: var(--sm-primary-soft);
            color: var(--sm-primary);
            font-size: .86rem;
        }

        .sales-manager-dashboard .sm-section-title {
            margin: 0;
            color: var(--sm-text);
            font-size: .91rem;
            font-weight: 800;
            letter-spacing: -.01em;
        }

        .sales-manager-dashboard .sm-section-description {
            margin: 3px 0 0;
            color: var(--sm-muted);
            font-size: .69rem;
        }

        .sales-manager-dashboard .sm-section-body {
            padding: 20px;
        }

        .sales-manager-dashboard .sm-section-badge {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            padding: 6px 10px;
            border-radius: 999px;
            font-size: .64rem;
            font-weight: 800;
            white-space: nowrap;
        }

        /* ------------------------------------------------------------
           Pipeline
           ------------------------------------------------------------ */

        .sales-manager-dashboard .sm-pipeline-grid {
            display: grid;
            grid-template-columns: repeat(5, minmax(0, 1fr));
            gap: 10px;
        }

        .sales-manager-dashboard .sm-stage {
            position: relative;
            overflow: hidden;
            min-height: 158px;
            padding: 15px;
            border: 1px solid var(--sm-border);
            border-radius: 13px;
            background: #fbfcfe;
            transition: transform .22s ease, box-shadow .22s ease, border-color .22s ease;
        }

            .sales-manager-dashboard .sm-stage:hover {
                transform: translateY(-3px);
                box-shadow: 0 12px 25px rgba(15, 23, 42, .07);
            }

            .sales-manager-dashboard .sm-stage::before {
                content: "";
                position: absolute;
                left: 0;
                right: 0;
                top: 0;
                height: 3px;
            }

        .sales-manager-dashboard .sm-stage-new::before {
            background: #3b82f6;
        }

        .sales-manager-dashboard .sm-stage-qualified::before {
            background: #06b6d4;
        }

        .sales-manager-dashboard .sm-stage-quotation::before {
            background: #f59e0b;
        }

        .sales-manager-dashboard .sm-stage-negotiation::before {
            background: #8b5cf6;
        }

        .sales-manager-dashboard .sm-stage-won::before {
            background: #10b981;
        }

        .sales-manager-dashboard .sm-stage-top {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 6px;
            margin-bottom: 18px;
        }

        .sales-manager-dashboard .sm-stage-number {
            font-size: .59rem;
            font-weight: 850;
            letter-spacing: .07em;
            padding: 4px 7px;
            border-radius: 6px;
            background: #f1f5f9;
            color: #64748b;
        }

        .sales-manager-dashboard .sm-stage-count {
            font-size: .67rem;
            color: #64748b;
            font-weight: 700;
        }

        .sales-manager-dashboard .sm-stage-name {
            margin: 0 0 5px;
            font-size: .79rem;
            font-weight: 800;
            color: var(--sm-text);
        }

        .sales-manager-dashboard .sm-stage-value {
            font-size: 1rem;
            line-height: 1.15;
            font-weight: 850;
            letter-spacing: -.025em;
        }

        .sales-manager-dashboard .sm-stage-meta {
            display: block;
            margin-top: 7px;
            color: #94a3b8;
            font-size: .64rem;
            font-weight: 600;
        }

        .sales-manager-dashboard .sm-stage-new .sm-stage-value {
            color: #2563eb;
        }

        .sales-manager-dashboard .sm-stage-qualified .sm-stage-value {
            color: #0891b2;
        }

        .sales-manager-dashboard .sm-stage-quotation .sm-stage-value {
            color: #d97706;
        }

        .sales-manager-dashboard .sm-stage-negotiation .sm-stage-value {
            color: #7c3aed;
        }

        .sales-manager-dashboard .sm-stage-won .sm-stage-value {
            color: #059669;
        }

        /* ------------------------------------------------------------
           Target Projection
           ------------------------------------------------------------ */

        .sales-manager-dashboard .sm-target-panel {
            padding: 18px 20px 20px;
        }

        .sales-manager-dashboard .sm-target-top {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 15px;
            margin-bottom: 12px;
        }

        .sales-manager-dashboard .sm-target-title {
            display: flex;
            align-items: center;
            gap: 9px;
            font-size: .82rem;
            font-weight: 800;
            color: var(--sm-text);
        }

            .sales-manager-dashboard .sm-target-title i {
                color: var(--sm-primary);
            }

        .sales-manager-dashboard .sm-goal {
            font-size: .7rem;
            font-weight: 750;
            color: var(--sm-muted);
            white-space: nowrap;
        }

        .sales-manager-dashboard .sm-progress {
            height: 12px;
            overflow: hidden;
            background: #eef2f7;
            border-radius: 999px;
        }

            .sales-manager-dashboard .sm-progress .progress-bar {
                position: relative;
                overflow: hidden;
                border-radius: 999px;
                background: linear-gradient(90deg, #059669, #10b981);
                transition: width 1s cubic-bezier(.22, .61, .36, 1);
            }

                .sales-manager-dashboard .sm-progress .progress-bar::after {
                    content: "";
                    position: absolute;
                    inset: 0;
                    background: linear-gradient(90deg, transparent, rgba(255,255,255,.28), transparent);
                    transform: translateX(-100%);
                    animation: smShimmer 2.4s infinite;
                }

        /* ------------------------------------------------------------
           Approval Panel
           ------------------------------------------------------------ */

        .sales-manager-dashboard .sm-approval {
            border-color: #f5d48b;
            box-shadow: 0 10px 28px rgba(217, 119, 6, .07);
        }

            .sales-manager-dashboard .sm-approval .sm-section-icon {
                background: var(--sm-warning-soft);
                color: var(--sm-warning);
            }

        .sales-manager-dashboard .sm-approval-count {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            padding: 6px 11px;
            background: #fef3c7;
            color: #92400e;
            border-radius: 999px;
            font-size: .64rem;
            font-weight: 850;
        }

        /* ------------------------------------------------------------
           Tables
           ------------------------------------------------------------ */

        .sales-manager-dashboard .sm-table-wrap {
            width: 100%;
            overflow-x: auto;
            -webkit-overflow-scrolling: touch;
        }

        .sales-manager-dashboard .sm-table {
            width: 100%;
            min-width: 690px;
            margin: 0;
            border-collapse: separate;
            border-spacing: 0;
            font-size: .74rem;
        }

            .sales-manager-dashboard .sm-table thead th {
                padding: 11px 14px;
                background: #f8fafc;
                border-bottom: 1px solid var(--sm-border);
                color: #64748b;
                font-size: .61rem;
                font-weight: 850;
                letter-spacing: .055em;
                text-transform: uppercase;
                white-space: nowrap;
            }

            .sales-manager-dashboard .sm-table tbody td {
                padding: 12px 14px;
                border-bottom: 1px solid #eef2f6;
                color: #475569;
                vertical-align: middle;
                background: #fff;
            }

            .sales-manager-dashboard .sm-table tbody tr:last-child td {
                border-bottom: 0;
            }

            .sales-manager-dashboard .sm-table tbody tr {
                transition: background .18s ease;
            }

                .sales-manager-dashboard .sm-table tbody tr:hover td {
                    background: #f8fbff;
                }

        .sales-manager-dashboard .sm-quote-number {
            color: var(--sm-primary);
            font-weight: 850;
        }

        .sales-manager-dashboard .sm-customer {
            color: var(--sm-text);
            font-weight: 700;
        }

        .sales-manager-dashboard .sm-amount {
            color: var(--sm-text);
            font-weight: 800;
            white-space: nowrap;
        }

        .sales-manager-dashboard .sm-person {
            display: flex;
            align-items: center;
            gap: 9px;
            min-width: 180px;
        }

        .sales-manager-dashboard .sm-avatar {
            width: 31px;
            height: 31px;
            flex: 0 0 31px;
            border-radius: 50%;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            background: var(--sm-primary-soft);
            color: var(--sm-primary);
            border: 1px solid #dbeafe;
            font-size: .68rem;
            font-weight: 850;
        }

        .sales-manager-dashboard .sm-person-name {
            color: var(--sm-text);
            font-weight: 750;
            font-size: .72rem;
        }

        .sales-manager-dashboard .sm-person-email {
            display: block;
            max-width: 170px;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
            color: #94a3b8;
            font-size: .61rem;
            margin-top: 2px;
        }

        .sales-manager-dashboard .sm-status {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            border-radius: 999px;
            padding: 5px 9px;
            font-size: .62rem;
            font-weight: 800;
            white-space: nowrap;
        }

            .sales-manager-dashboard .sm-status::before {
                content: "";
                width: 5px;
                height: 5px;
                border-radius: 50%;
                background: currentColor;
            }

        .sales-manager-dashboard .sm-status-paid,
        .sales-manager-dashboard .sm-status-active {
            color: #047857;
            background: #ecfdf5;
        }

        .sales-manager-dashboard .sm-status-pending {
            color: #b45309;
            background: #fffbeb;
        }

        .sales-manager-dashboard .sm-status-inactive {
            color: #64748b;
            background: #f1f5f9;
        }

        .sales-manager-dashboard .sm-discount {
            display: inline-flex;
            align-items: center;
            gap: 4px;
            padding: 5px 8px;
            border-radius: 7px;
            color: #b91c1c;
            background: #fef2f2;
            font-weight: 850;
            font-size: .62rem;
        }

        .sales-manager-dashboard .sm-action-group {
            display: flex;
            justify-content: flex-end;
            gap: 5px;
            white-space: nowrap;
        }

        .sales-manager-dashboard .sm-action-small {
            border-radius: 8px;
            padding: 5px 9px;
            font-size: .63rem;
            font-weight: 750;
            transition: transform .18s ease, box-shadow .18s ease;
        }

            .sales-manager-dashboard .sm-action-small:hover {
                transform: translateY(-1px);
            }

        /* ------------------------------------------------------------
           Lower Dashboard Cards
           ------------------------------------------------------------ */

        .sales-manager-dashboard .sm-lower-grid {
            display: grid;
            grid-template-columns: minmax(0, 1.35fr) minmax(0, .9fr);
            gap: 20px;
            margin-bottom: 28px;
        }

        .sales-manager-dashboard .sm-card {
            min-width: 0;
            background: var(--sm-surface);
            border: 1px solid var(--sm-border);
            border-radius: 16px;
            box-shadow: var(--sm-shadow);
            overflow: hidden;
        }

        .sales-manager-dashboard .sm-card-header {
            min-height: 70px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            padding: 14px 18px;
            border-bottom: 1px solid #eef1f5;
        }

        .sales-manager-dashboard .sm-card-title-wrap {
            display: flex;
            align-items: center;
            gap: 10px;
            min-width: 0;
        }

        .sales-manager-dashboard .sm-card-title-icon {
            width: 34px;
            height: 34px;
            flex: 0 0 34px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border-radius: 10px;
            background: #fff7ed;
            color: #ea580c;
            font-size: .8rem;
        }

        .sales-manager-dashboard .sm-card-title {
            margin: 0;
            color: var(--sm-text);
            font-size: .82rem;
            font-weight: 800;
        }

        .sales-manager-dashboard .sm-card-subtitle {
            margin: 2px 0 0;
            color: #94a3b8;
            font-size: .62rem;
        }

        .sales-manager-dashboard .sm-view-all {
            flex: 0 0 auto;
            border-radius: 999px;
            padding: 6px 11px;
            font-size: .62rem;
            font-weight: 800;
        }

        .sales-manager-dashboard .sm-leaderboard .sm-card-title-icon {
            background: #fef2f2;
            color: #dc2626;
        }

        .sales-manager-dashboard .sm-rep-row {
            cursor: pointer;
            transition: background .2s ease, transform .2s ease;
        }

            .sales-manager-dashboard .sm-rep-row:hover td {
                background: #f8fbff !important;
            }

        .sales-manager-dashboard .sm-rep-profile {
            display: flex;
            align-items: center;
            gap: 9px;
            min-width: 190px;
        }

        .sales-manager-dashboard .sm-rep-avatar {
            width: 35px;
            height: 35px;
            flex: 0 0 35px;
            border-radius: 50%;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            background: linear-gradient(135deg, #dbeafe, #eef2ff);
            color: var(--sm-primary);
            border: 1px solid #dbeafe;
            font-size: .72rem;
            font-weight: 850;
        }

        .sales-manager-dashboard .sm-rep-name {
            color: var(--sm-text);
            font-weight: 800;
            font-size: .72rem;
            text-decoration: none;
        }

        .sales-manager-dashboard .sm-rep-meta {
            margin-top: 2px;
            color: #94a3b8;
            font-size: .61rem;
        }

        .sales-manager-dashboard .sm-revenue {
            color: var(--sm-success);
            font-weight: 850;
            white-space: nowrap;
            font-size: .73rem;
        }

        /* ------------------------------------------------------------
           Empty States
           ------------------------------------------------------------ */

        .sales-manager-dashboard .sm-empty {
            padding: 34px 20px !important;
            text-align: center;
            color: #94a3b8 !important;
        }

        .sales-manager-dashboard .sm-empty-icon {
            width: 42px;
            height: 42px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 8px;
            border-radius: 12px;
            background: #f8fafc;
            color: #94a3b8;
        }

        /* ------------------------------------------------------------
           Buttons
           ------------------------------------------------------------ */

        .sales-manager-dashboard .sm-btn-primary {
            background: var(--sm-primary);
            border-color: var(--sm-primary);
            color: #fff;
        }

            .sales-manager-dashboard .sm-btn-primary:hover {
                background: var(--sm-primary-dark);
                border-color: var(--sm-primary-dark);
                color: #fff;
            }

        /* ------------------------------------------------------------
           Modals
           ------------------------------------------------------------ */

        .sales-manager-dashboard .modal-content {
            border: 1px solid rgba(226, 232, 240, .9) !important;
            border-radius: 18px !important;
            overflow: hidden;
            box-shadow: 0 25px 70px rgba(15, 23, 42, .20) !important;
        }

        .sales-manager-dashboard .modal-header {
            padding: 18px 20px;
            background: linear-gradient(180deg, #ffffff 0%, #f8fafc 100%);
            border-bottom: 1px solid #edf1f5;
        }

        .sales-manager-dashboard .modal-title {
            color: var(--sm-text);
            font-size: .95rem;
            font-weight: 800;
        }

        .sales-manager-dashboard .modal-body {
            padding: 20px;
        }

        .sales-manager-dashboard .modal-footer {
            padding: 14px 20px;
            background: #fafbfd;
            border-top: 1px solid #edf1f5;
        }

        .sales-manager-dashboard .modal .form-label {
            color: #475569 !important;
            font-size: .67rem !important;
            font-weight: 800 !important;
            margin-bottom: 6px;
        }

        .sales-manager-dashboard .modal .form-control,
        .sales-manager-dashboard .modal .form-select {
            min-height: 40px;
            border-color: #dfe5ed;
            border-radius: 9px;
            color: var(--sm-text);
            font-size: .74rem;
            box-shadow: none;
            transition: border-color .18s ease, box-shadow .18s ease;
        }

        .sales-manager-dashboard .modal textarea.form-control {
            min-height: 85px;
        }

        .sales-manager-dashboard .modal .form-control:focus,
        .sales-manager-dashboard .modal .form-select:focus {
            border-color: rgba(37, 99, 235, .55);
            box-shadow: 0 0 0 3px rgba(37, 99, 235, .09);
        }

        .sales-manager-dashboard .sm-rep-modal-strip {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 13px;
            border: 1px solid #e8edf3;
            background: #f8fafc;
            border-radius: 12px;
        }

        .sales-manager-dashboard .sm-rep-modal-icon {
            width: 48px;
            height: 48px;
            flex: 0 0 48px;
            border-radius: 50%;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            background: linear-gradient(135deg, #2563eb, #4f46e5);
            color: #fff;
            font-size: 1rem;
            box-shadow: 0 8px 18px rgba(37, 99, 235, .2);
        }

        .sales-manager-dashboard .sm-modal-metric {
            height: 100%;
            padding: 14px;
            border: 1px solid #e7ebf1;
            background: #fff;
            border-radius: 11px;
            transition: transform .2s ease, box-shadow .2s ease;
        }

            .sales-manager-dashboard .sm-modal-metric:hover {
                transform: translateY(-2px);
                box-shadow: 0 9px 22px rgba(15, 23, 42, .07);
            }

        .sales-manager-dashboard .sm-modal-metric-label {
            color: #94a3b8;
            font-size: .62rem;
            font-weight: 750;
        }

        .sales-manager-dashboard .sm-modal-metric-value {
            margin: 5px 0 0;
            color: var(--sm-text);
            font-size: 1rem;
            font-weight: 850;
        }

    /* ------------------------------------------------------------
           Mobile Table Cards / Responsive
           ------------------------------------------------------------ */

    @@media (max-width: 1200px) {
        .sales-manager-dashboard .sm-kpi-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .sales-manager-dashboard .sm-pipeline-grid {
            grid-template-columns: repeat(3, minmax(0, 1fr));
        }

        .sales-manager-dashboard .sm-header {
            align-items: flex-start;
            flex-direction: column;
        }

        .sales-manager-dashboard .sm-header-actions {
            width: 100%;
            justify-content: flex-start;
        }
    }

    @@media (max-width: 992px) {
        .sales-manager-dashboard .sm-lower-grid {
            grid-template-columns: 1fr;
        }

        .sales-manager-dashboard .sm-pipeline-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .sales-manager-dashboard .sm-role-card {
            display: none;
        }
    }

    @@media (max-width: 768px) {
        .sales-manager-dashboard .sm-page-shell {
            padding-top: 0;
        }

        .sales-manager-dashboard .sm-header {
            margin-bottom: 16px;
        }

        .sales-manager-dashboard .sm-main-title {
            font-size: 1.45rem;
        }

        .sales-manager-dashboard .sm-header-actions {
            display: grid;
            grid-template-columns: 1fr 1fr;
            width: 100%;
        }

        .sales-manager-dashboard .sm-filter-control {
            grid-column: 1 / -1;
            width: 100%;
        }

            .sales-manager-dashboard .sm-filter-control select {
                flex: 1;
                width: 100%;
            }

        .sales-manager-dashboard .sm-action-btn {
            width: 100%;
        }

        .sales-manager-dashboard .sm-kpi {
            min-height: 128px;
        }

        .sales-manager-dashboard .sm-section-header {
            align-items: flex-start;
        }

        .sales-manager-dashboard .sm-section-badge {
            display: none;
        }

        .sales-manager-dashboard .sm-target-top {
            align-items: flex-start;
            flex-direction: column;
            gap: 5px;
        }

        .sales-manager-dashboard .sm-card-header {
            align-items: flex-start;
        }

        .sales-manager-dashboard .sm-view-all {
            margin-top: 1px;
        }
    }

    @@media (max-width: 576px) {
        .sales-manager-dashboard .sm-kpi-grid {
            grid-template-columns: 1fr;
            gap: 10px;
        }

        .sales-manager-dashboard .sm-kpi {
            min-height: 120px;
        }

        .sales-manager-dashboard .sm-pipeline-grid {
            grid-template-columns: 1fr;
        }

        .sales-manager-dashboard .sm-section-header,
        .sales-manager-dashboard .sm-section-body,
        .sales-manager-dashboard .sm-target-panel {
            padding-left: 14px;
            padding-right: 14px;
        }

        .sales-manager-dashboard .sm-section-heading {
            align-items: flex-start;
        }

        .sales-manager-dashboard .sm-section-icon {
            width: 34px;
            height: 34px;
            flex-basis: 34px;
        }

        .sales-manager-dashboard .sm-section-title {
            font-size: .83rem;
        }

        .sales-manager-dashboard .sm-card-header {
            padding: 13px 14px;
        }

        .sales-manager-dashboard .sm-card-title {
            font-size: .76rem;
        }

        .sales-manager-dashboard .sm-view-all {
            padding: 5px 8px;
            font-size: .58rem;
        }

        .sales-manager-dashboard .sm-table {
            min-width: 650px;
        }

        .sales-manager-dashboard .sm-action-group {
            flex-direction: column;
            align-items: stretch;
        }

        .sales-manager-dashboard .sm-action-small {
            width: 100%;
        }

        .sales-manager-dashboard .modal-dialog {
            margin: .65rem;
        }

        .sales-manager-dashboard .modal-body {
            padding: 16px;
        }

        .sales-manager-dashboard .modal-header,
        .sales-manager-dashboard .modal-footer {
            padding-left: 16px;
            padding-right: 16px;
        }
    }

    @@media (max-width: 400px) {
        .sales-manager-dashboard .sm-header-actions {
            grid-template-columns: 1fr;
        }

        .sales-manager-dashboard .sm-filter-control {
            grid-column: auto;
        }

        .sales-manager-dashboard .sm-kpi-value {
            font-size: 1.25rem;
        }

        .sales-manager-dashboard .sm-kpi {
            padding: 14px;
        }
    }

    /* ------------------------------------------------------------
           Reduced Motion
           ------------------------------------------------------------ */

    @@media (prefers-reduced-motion: reduce) {
        .sales-manager-dashboard *,
        .sales-manager-dashboard *::before,
        .sales-manager-dashboard *::after {
            animation-duration: .01ms !important;
            animation-iteration-count: 1 !important;
            transition-duration: .01ms !important;
            scroll-behavior: auto !important;
        }
    }

    /* ------------------------------------------------------------
           Print
           ------------------------------------------------------------ */

    @@media print {
        .sales-manager-dashboard .sm-header-actions,
        .sales-manager-dashboard .sm-view-all,
        .sales-manager-dashboard .sm-action-group,
        .sales-manager-dashboard .modal {
            display: none !important;
        }

        .sales-manager-dashboard .sm-section,
        .sales-manager-dashboard .sm-card,
        .sales-manager-dashboard .sm-kpi {
            box-shadow: none !important;
            break-inside: avoid;
        }

        .sales-manager-dashboard .sm-page-shell::before {
            display: none;
        }
    }

    /* ------------------------------------------------------------
           Animations
           ------------------------------------------------------------ */

    @@keyframes smPageIn {
        from {
            opacity: 0;
            transform: translateY(8px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@keyframes smCardIn {
        from {
            opacity: 0;
            transform: translateY(13px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@keyframes smSectionIn {
        from {
            opacity: 0;
            transform: translateY(9px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@keyframes smShimmer {
        0% {
            transform: translateX(-100%);
        }

        55%,
        100% {
            transform: translateX(100%);
        }
    }
</style>

<div class="sales-manager-dashboard">
    <div class="sm-page-shell">

        <!-- =====================================================
             PAGE HEADER
             ===================================================== -->
        <div class="sm-header">
            <div class="sm-title-area">
                <span class="sm-eyebrow">
                    <i class="fa-solid fa-chart-line"></i>
                    Sales Management
                </span>

                <h1 class="sm-main-title">Sales Manager Dashboard</h1>

                <p class="sm-subtitle">
                    Monitor team revenue, pipeline movement, targets and sales operations from one place.
                </p>

                <div class="sm-breadcrumb">
                    <a href="#">Dashboard</a>
                    <span class="separator">
                        <i class="fa-solid fa-chevron-right"></i>
                    </span>
                    <span>Sales Manager</span>
                </div>
            </div>

            <div class="sm-header-actions">

                <!-- Date Filter -->
                <div class="sm-filter-control">
                    <i class="fa-solid fa-calendar-days"></i>

                    <select id="dateFilterSelect"
                            class="form-select form-select-sm"
                            onchange="onDateRangeChange(this.value)">
                        <option value="September 2026" selected="@(selectedDateRange == "September 2026")">
                            September 2026
                        </option>

                        <option value="Q3 2026" selected="@(selectedDateRange == "Q3 2026" || string.IsNullOrEmpty(selectedDateRange))">
                            Q3 2026
                        </option>

                        <option value="FY 2026-27" selected="@(selectedDateRange == "FY 2026-27")">
                            FY 2026-27
                        </option>

                        <option value="Custom Range" selected="@(selectedDateRange == "Custom Range")">
                            Custom Range
                        </option>
                    </select>
                </div>

                <!-- Add Lead -->
                <button type="button"
                        class="btn btn-outline-primary sm-action-btn"
                        data-bs-toggle="modal"
                        data-bs-target="#newLeadModal">
                    <i class="fa-solid fa-plus"></i>
                    <span>Add Lead</span>
                </button>

                <!-- Assign Target -->
                <button type="button"
                        class="btn btn-primary sm-action-btn sm-action-primary"
                        data-bs-toggle="modal"
                        data-bs-target="#assignTargetModal">
                    <i class="fa-solid fa-bullseye"></i>
                    <span>Assign Target</span>
                </button>

                <!-- Role -->
                <div class="sm-role-card">
                    <span class="sm-role-label">Active Role</span>
                    <span class="sm-role-value">
                        <i class="fa-solid fa-crown text-primary me-1"></i>
                        @(Model?.CurrentUserRole ?? "Sales Manager")
                    </span>
                </div>

                <!-- Scope -->
                <div class="sm-role-card">
                    <span class="sm-role-label">Management Scope</span>
                    <span class="sm-role-value">
                        <i class="fa-solid fa-building text-info me-1"></i>
                        @(Model?.CurrentCompany ?? "Head Office")
                    </span>
                </div>
            </div>
        </div>

        <!-- =====================================================
             KPI GRID
             ===================================================== -->
        <div class="sm-kpi-grid">

            <!-- Revenue -->
            <div class="sm-kpi sm-kpi-blue">
                <div class="sm-kpi-top">
                    <div class="sm-kpi-label">
                        <span class="sm-kpi-icon">
                            <i class="fa-solid fa-indian-rupee-sign"></i>
                        </span>
                        Team Revenue
                    </div>

                    <span class="sm-kpi-period">
                        @activeMonthName
                    </span>
                </div>

                <h2 class="sm-kpi-value">
                    ₹@totalRevenue.ToString("N0", inCulture)
                </h2>

                <div class="sm-kpi-description">
                    Total team sales revenue
                </div>
            </div>

            <!-- Active Reps -->
            <div class="sm-kpi sm-kpi-indigo">
                <div class="sm-kpi-top">
                    <div class="sm-kpi-label">
                        <span class="sm-kpi-icon">
                            <i class="fa-solid fa-users"></i>
                        </span>
                        Sales Team
                    </div>

                    <span class="sm-kpi-period">Live</span>
                </div>

                <h2 class="sm-kpi-value">
                    @activeReps
                </h2>

                <div class="sm-kpi-description">
                    Active sales representatives
                </div>
            </div>

            <!-- Average Sales -->
            <div class="sm-kpi sm-kpi-green">
                <div class="sm-kpi-top">
                    <div class="sm-kpi-label">
                        <span class="sm-kpi-icon">
                            <i class="fa-solid fa-money-bill-trend-up"></i>
                        </span>
                        Productivity
                    </div>

                    <span class="sm-kpi-period">Average</span>
                </div>

                <h2 class="sm-kpi-value">
                    ₹@avgSales.ToString("N0", inCulture)
                </h2>

                <div class="sm-kpi-description">
                    Average sales per representative
                </div>
            </div>

            <!-- Target -->
            <div class="sm-kpi sm-kpi-purple">
                <div class="sm-kpi-top">
                    <div class="sm-kpi-label">
                        <span class="sm-kpi-icon">
                            <i class="fa-solid fa-bullseye"></i>
                        </span>
                        Target
                    </div>

                    <span class="sm-kpi-period">Q3 2026</span>
                </div>

                <h2 class="sm-kpi-value">
                    @targetAchievedPct%
                </h2>

                <div class="sm-kpi-description">
                    Team target achieved
                </div>
            </div>
        </div>

        <!-- =====================================================
             SALES PIPELINE
             ===================================================== -->
        <section class="sm-section">

            <div class="sm-section-header">
                <div class="sm-section-heading">
                    <div class="sm-section-icon">
                        <i class="fa-solid fa-filter"></i>
                    </div>

                    <div>
                        <h2 class="sm-section-title">
                            Sales Pipeline Funnel
                        </h2>

                        <p class="sm-section-description">
                            Real-time team deal velocity and stage distribution
                        </p>
                    </div>
                </div>

                <span class="sm-section-badge bg-primary-subtle text-primary">
                    <i class="fa-solid fa-layer-group"></i>
                    5 Active Stages
                </span>
            </div>

            <div class="sm-section-body">

                <div class="sm-pipeline-grid">

                    <!-- New -->
                    <div class="sm-stage sm-stage-new">
                        <div class="sm-stage-top">
                            <span class="sm-stage-number">STAGE 01</span>
                            <span class="sm-stage-count">
                                @pipelineStages["New"].Count Deals
                            </span>
                        </div>

                        <h3 class="sm-stage-name">New</h3>

                        <div class="sm-stage-value">
                            ₹@pipelineStages["New"].Value.ToString("N0", inCulture)
                        </div>

                        <small class="sm-stage-meta">
                            @pipelineStages["New"].Count opportunities
                        </small>
                    </div>

                    <!-- Qualified -->
                    <div class="sm-stage sm-stage-qualified">
                        <div class="sm-stage-top">
                            <span class="sm-stage-number">STAGE 02</span>
                            <span class="sm-stage-count">
                                @pipelineStages["Qualified"].Count Deals
                            </span>
                        </div>

                        <h3 class="sm-stage-name">Qualified</h3>

                        <div class="sm-stage-value">
                            ₹@pipelineStages["Qualified"].Value.ToString("N0", inCulture)
                        </div>

                        <small class="sm-stage-meta">
                            @pipelineStages["Qualified"].Count opportunities
                        </small>
                    </div>

                    <!-- Quotation -->
                    <div class="sm-stage sm-stage-quotation">
                        <div class="sm-stage-top">
                            <span class="sm-stage-number">STAGE 03</span>
                            <span class="sm-stage-count">
                                @pipelineStages["Quotation Sent"].Count Deals
                            </span>
                        </div>

                        <h3 class="sm-stage-name">Quotation Sent</h3>

                        <div class="sm-stage-value">
                            ₹@pipelineStages["Quotation Sent"].Value.ToString("N0", inCulture)
                        </div>

                        <small class="sm-stage-meta">
                            @pipelineStages["Quotation Sent"].Count opportunities
                        </small>
                    </div>

                    <!-- Negotiation -->
                    <div class="sm-stage sm-stage-negotiation">
                        <div class="sm-stage-top">
                            <span class="sm-stage-number">STAGE 04</span>
                            <span class="sm-stage-count">
                                @pipelineStages["Negotiation"].Count Deals
                            </span>
                        </div>

                        <h3 class="sm-stage-name">Negotiation</h3>

                        <div class="sm-stage-value">
                            ₹@pipelineStages["Negotiation"].Value.ToString("N0", inCulture)
                        </div>

                        <small class="sm-stage-meta">
                            @pipelineStages["Negotiation"].Count opportunities
                        </small>
                    </div>

                    <!-- Closed Won -->
                    <div class="sm-stage sm-stage-won">
                        <div class="sm-stage-top">
                            <span class="sm-stage-number">CLOSED</span>
                            <span class="sm-stage-count">
                                @pipelineStages["Closed Won"].Count Deals
                            </span>
                        </div>

                        <h3 class="sm-stage-name">Closed Won</h3>

                        <div class="sm-stage-value">
                            ₹@pipelineStages["Closed Won"].Value.ToString("N0", inCulture)
                        </div>

                        <small class="sm-stage-meta">
                            @pipelineStages["Closed Won"].Count closed deals
                        </small>
                    </div>

                </div>
            </div>
        </section>

        <!-- =====================================================
             TARGET PROJECTION
             ===================================================== -->
        <section class="sm-section">

            <div class="sm-target-panel">

                <div class="sm-target-top">
                    <div class="sm-target-title">
                        <i class="fa-solid fa-chart-column"></i>
                        <span>Q3 2026 Team Target Projection</span>
                    </div>

                    <span class="sm-goal">
                        Goal: ₹@goalAmount.ToString("N0", inCulture)
                    </span>
                </div>

                <div class="progress sm-progress">
                    <div class="progress-bar progress-bar-striped"
                         role="progressbar"
                         style="width: @Math.Min(100m, targetAchievedPct)%"
                         aria-valuenow="@targetAchievedPct"
                         aria-valuemin="0"
                         aria-valuemax="100">
                    </div>
                </div>
            </div>
        </section>

        <!-- =====================================================
             PENDING APPROVALS
             ===================================================== -->
@if (pendingApprovals != null && pendingApprovals.Any())
{
            <section class="sm-section sm-approval">

                <div class="sm-section-header">

                    <div class="sm-section-heading">
                        <div class="sm-section-icon">
                            <i class="fa-solid fa-stamp"></i>
                        </div>

                        <div>
                            <h2 class="sm-section-title">
                                Pending Quotation & Discount Approvals
                            </h2>

                            <p class="sm-section-description">
                                Quotations with requested discount rates exceeding policy threshold (&gt;10%) requiring manager review.
                            </p>

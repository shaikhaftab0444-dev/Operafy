@model List<ERP_System.Models.HRAttendanceLog>
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Sales Team Radar";
    var executives = ViewBag.Executives as List<ERP_System.Models.User> ?? new List<ERP_System.Models.User>();
    var selectedDateStr = ViewBag.SelectedDate as string ?? DateTime.Today.ToString("yyyy-MM-dd");
    var totalMembers = (int)(ViewBag.TotalMembers ?? executives.Count);
    var presentToday = (int)(ViewBag.PresentToday ?? 0);
    var lateCount = (int)(ViewBag.LateCount ?? 0);
    var absentCount = (int)(ViewBag.AbsentCount ?? 0);
}

<style>
    .sales-stat-card {
        border-radius: 12px;
        padding: 1.25rem;
        background: #ffffff;
        border: 1px solid var(--border-warm, #e2e8f0);
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.04);
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }
    .sales-stat-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.08);
    }
    .sales-table-card {
        background: #ffffff;
        border-radius: 14px;
        border: 1px solid var(--border-warm, #e2e8f0);
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.04);
        overflow: hidden;
    }
</style>

<div class="container-fluid py-3 px-3 px-md-4">
    <!-- Header Area -->
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <div class="text-muted small mb-1">
                <a href="@Url.Action("Index", "SalesManagerDashboard")" class="text-decoration-none text-muted">Sales Manager Portal</a> / <span>Team Operations</span>
            </div>
            <h4 class="fw-bold mb-0 text-dark">
                <i class="fa-solid fa-users-viewfinder text-primary me-2"></i>Sales Team Attendance Radar
            </h4>
        </div>
        <div class="d-flex flex-wrap gap-2 align-items-center">
            <form method="get" class="d-flex gap-2">
                <input type="date" name="selectedDate" value="@selectedDateStr" class="form-control form-control-sm" />
                <button type="submit" class="btn btn-sm btn-primary px-3 shadow-sm">
                    <i class="fa-solid fa-filter me-1"></i> Filter
                </button>
            </form>
            <a href="@Url.Action("Approvals", "Manager")" class="btn btn-sm btn-outline-secondary px-3 shadow-sm">
                <i class="fa-solid fa-clipboard-check me-1.5"></i> Review Team Approvals
            </a>
        </div>
    </div>

    <!-- Quick Stats Cards -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-md-3">
            <div class="sales-stat-card border-start border-4 border-primary">
                <div class="text-muted small fw-semibold text-uppercase">Sales Executives</div>
                <div class="fs-3 fw-bold text-dark mt-1">@totalMembers</div>
                <div class="text-muted extra-small mt-1"><i class="fa-solid fa-users me-1 text-primary"></i>Assigned to your unit</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="sales-stat-card border-start border-4 border-success">
                <div class="text-muted small fw-semibold text-uppercase">On Duty / Present</div>
                <div class="fs-3 fw-bold text-success mt-1">@presentToday</div>
                <div class="text-muted extra-small mt-1"><i class="fa-solid fa-circle-check me-1 text-success"></i>Punched in today</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="sales-stat-card border-start border-4 border-warning">
                <div class="text-muted small fw-semibold text-uppercase">Late Arrivals</div>
                <div class="fs-3 fw-bold text-warning mt-1">@lateCount</div>
                <div class="text-muted extra-small mt-1"><i class="fa-solid fa-clock-rotate-left me-1 text-warning"></i>Grace exceeded</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="sales-stat-card border-start border-4 border-danger">
                <div class="text-muted small fw-semibold text-uppercase">Absent / Inactive</div>
                <div class="fs-3 fw-bold text-danger mt-1">@absentCount</div>
                <div class="text-muted extra-small mt-1"><i class="fa-solid fa-user-xmark me-1 text-danger"></i>No punch logged</div>
            </div>
        </div>
    </div>

    <!-- Team Attendance Table -->
    <div class="sales-table-card">
        <div class="p-3 border-bottom d-flex flex-wrap justify-content-between align-items-center gap-3 bg-light-subtle">
            <div class="d-flex align-items-center gap-2">
                <span class="fw-bold small text-secondary">Radar Pulse Date:</span>
                <span class="badge bg-primary rounded-pill">@DateTime.Parse(selectedDateStr).ToString("dd MMMM yyyy")</span>
            </div>
            <div class="d-flex gap-2">
                <span class="badge bg-success-subtle text-success px-2.5 py-1.5 rounded-pill small fw-semibold">
                    <i class="fa-solid fa-circle-check me-1"></i> Active: @presentToday
                </span>
                <span class="badge bg-danger-subtle text-danger px-2.5 py-1.5 rounded-pill small fw-semibold">
                    <i class="fa-solid fa-circle-xmark me-1"></i> Absent: @absentCount
                </span>
            </div>
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr class="small text-uppercase text-muted">
                        <th>Sales Executive</th>
                        <th>Designation / Role</th>
                        <th>Clock In</th>
                        <th>Clock Out</th>
                        <th>Duration</th>
                        <th>Punch Source</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!executives.Any())
                    {
                        <tr>
                            <td colspan="8" class="text-center py-5 text-muted">
                                <i class="fa-solid fa-user-slash fs-2 d-block mb-2 text-secondary"></i>
                                No subordinate sales executives found for your unit.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var user in executives)
                        {
                            var log = Model.FirstOrDefault(m => m.UserId == user.UserId);
                            var isPresent = log != null && (log.Status == "Present" || log.Status.Contains("Late"));
                            var statusBadge = isPresent 
                                ? (log!.Status.Contains("Late") ? "bg-warning-subtle text-warning border border-warning" : "bg-success-subtle text-success border border-success")
                                : "bg-danger-subtle text-danger border border-danger";

                            <tr>
                                <td>
                                    <div class="d-flex align-items-center gap-2.5">
                                        <div class="rounded-circle bg-primary-subtle text-primary fw-bold d-flex align-items-center justify-content-center" style="width: 36px; height: 36px; font-size: 0.85rem;">
                                            @(string.IsNullOrEmpty(user.FullName) ? "SE" : string.Concat(user.FullName.Split(' ').Select(w => w.Length > 0 ? w[0].ToString() : "")))
                                        </div>
                                        <div>
                                            <div class="fw-bold text-dark">@user.FullName</div>
                                            <div class="text-muted extra-small">@user.Email</div>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <span class="badge bg-light text-secondary border small">@(user.Role?.RoleName ?? "Sales Executive")</span>
                                </td>
                                <td>
                                    <span class="fw-semibold text-dark small">
                                        @(log?.CheckInTime.HasValue == true ? log.CheckInTime.Value.ToString("hh:mm tt") : "-")
                                    </span>
                                </td>
                                <td>
                                    <span class="fw-semibold text-dark small">
                                        @(log?.CheckOutTime.HasValue == true ? log.CheckOutTime.Value.ToString("hh:mm tt") : "-")
                                    </span>
                                </td>
                                <td>
                                    <span class="text-muted small">@(log != null && !string.IsNullOrEmpty(log.WorkHours) ? log.WorkHours : "0h 0m")</span>
                                </td>
                                <td>
                                    <span class="small text-muted">
                                        <i class="fa-solid fa-fingerprint me-1"></i>@(log?.PunchSource ?? "Web Portal")
                                    </span>
                                </td>
                                <td>
                                    <span class="badge @statusBadge px-2.5 py-1 rounded-pill small">
                                        @(log?.Status ?? "Absent")
                                    </span>
                                </td>
                                <td class="text-end">
                                    <a href="@Url.Action("Tasks", "SalesManagerDashboard")" class="btn btn-sm btn-outline-primary" title="Assign Target">
                                        <i class="fa-solid fa-tasks me-1"></i> Assign Target
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

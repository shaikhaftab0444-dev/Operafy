```cshtml
@model List<ERP_System.Models.HRAttendanceLog>
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Sales Team Radar";
    var executives = ViewBag.Executives as List<ERP_System.Models.User> ?? new List<ERP_System.Models.User>();
    var selectedDateStr = ViewBag.SelectedDate as string ?? DateTime.Today.ToString("yyyy-MM-dd");
    var totalMembers = (int)(ViewBag.TotalMembers ?? executives.Count);
    var presentToday = (int)(ViewBag.PresentToday ?? 0);
    var lateCount = (int)(ViewBag.LateCount ?? 0);
    var absentCount = (int)(ViewBag.AbsentCount ?? 0);
}

<style>
    .sales-radar-page {
        --radar-primary: #2563eb;
        --radar-primary-soft: #eff6ff;
        --radar-success: #16a34a;
        --radar-success-soft: #f0fdf4;
        --radar-warning: #d97706;
        --radar-warning-soft: #fffbeb;
        --radar-danger: #dc2626;
        --radar-danger-soft: #fef2f2;
        --radar-text: #172033;
        --radar-muted: #64748b;
        --radar-border: #e5e7eb;
        --radar-page: #f6f8fb;
    }

    .sales-radar-page {
        min-height: 100vh;
        background: var(--radar-page);
        color: var(--radar-text);
    }

        /* HEADER */
        .sales-radar-page .radar-header {
            background: #ffffff;
            border: 1px solid var(--radar-border);
            border-radius: 18px;
            padding: 20px 22px;
            box-shadow: 0 4px 18px rgba(15, 23, 42, 0.045);
        }

        .sales-radar-page .radar-title-icon {
            width: 46px;
            height: 46px;
            min-width: 46px;
            border-radius: 14px;
            background: var(--radar-primary-soft);
            color: var(--radar-primary);
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 1.05rem;
        }

        .sales-radar-page .radar-title {
            color: #111827;
            font-size: 1.22rem;
            font-weight: 800;
            letter-spacing: -0.02em;
        }

        .sales-radar-page .radar-breadcrumb {
            margin-top: 4px;
        }

            .sales-radar-page .radar-breadcrumb a {
                color: #64748b;
                font-weight: 600;
            }

                .sales-radar-page .radar-breadcrumb a:hover {
                    color: var(--radar-primary);
                }

        .sales-radar-page .radar-filter-form {
            background: #f8fafc;
            border: 1px solid #e2e8f0;
            padding: 5px;
            border-radius: 11px;
        }

        .sales-radar-page .radar-date {
            border: 0;
            background: transparent;
            box-shadow: none;
            min-height: 34px;
            font-size: 0.78rem;
            font-weight: 600;
            color: #334155;
        }

            .sales-radar-page .radar-date:focus {
                box-shadow: none;
                border-color: transparent;
            }

        .sales-radar-page .radar-filter-btn {
            border-radius: 8px;
            font-size: 0.76rem;
            font-weight: 700;
            padding: 7px 13px;
        }

        .sales-radar-page .approval-btn {
            border-radius: 10px;
            font-size: 0.76rem;
            font-weight: 700;
            padding: 9px 13px;
        }

        /* KPI CARDS */
        .sales-radar-page .radar-stat-card {
            position: relative;
            height: 100%;
            background: #ffffff;
            border: 1px solid var(--radar-border);
            border-radius: 16px;
            padding: 18px;
            overflow: hidden;
            box-shadow: 0 4px 16px rgba(15, 23, 42, 0.045);
            transition: transform 0.2s ease, box-shadow 0.2s ease;
        }

            .sales-radar-page .radar-stat-card::after {
                content: "";
                position: absolute;
                width: 90px;
                height: 90px;
                right: -38px;
                bottom: -42px;
                border-radius: 50%;
                background: rgba(37, 99, 235, 0.035);
                pointer-events: none;
            }

            .sales-radar-page .radar-stat-card:hover {
                transform: translateY(-3px);
                box-shadow: 0 10px 25px rgba(15, 23, 42, 0.08);
            }

            .sales-radar-page .radar-stat-card.primary {
                border-top: 3px solid var(--radar-primary);
            }

            .sales-radar-page .radar-stat-card.success {
                border-top: 3px solid var(--radar-success);
            }

            .sales-radar-page .radar-stat-card.warning {
                border-top: 3px solid var(--radar-warning);
            }

            .sales-radar-page .radar-stat-card.danger {
                border-top: 3px solid var(--radar-danger);
            }

        .sales-radar-page .radar-stat-icon {
            width: 38px;
            height: 38px;
            border-radius: 11px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 0.9rem;
        }

            .sales-radar-page .radar-stat-icon.primary {
                background: var(--radar-primary-soft);
                color: var(--radar-primary);
            }

            .sales-radar-page .radar-stat-icon.success {
                background: var(--radar-success-soft);
                color: var(--radar-success);
            }

            .sales-radar-page .radar-stat-icon.warning {
                background: var(--radar-warning-soft);
                color: var(--radar-warning);
            }

            .sales-radar-page .radar-stat-icon.danger {
                background: var(--radar-danger-soft);
                color: var(--radar-danger);
            }

        .sales-radar-page .radar-stat-label {
            color: #64748b;
            font-size: 0.69rem;
            font-weight: 800;
            letter-spacing: 0.04em;
            text-transform: uppercase;
        }

        .sales-radar-page .radar-stat-value {
            font-size: 1.65rem;
            line-height: 1.15;
            font-weight: 800;
            margin-top: 12px;
            color: #172033;
            letter-spacing: -0.025em;
        }

            .sales-radar-page .radar-stat-value.success {
                color: var(--radar-success);
            }

            .sales-radar-page .radar-stat-value.warning {
                color: var(--radar-warning);
            }

            .sales-radar-page .radar-stat-value.danger {
                color: var(--radar-danger);
            }

        .sales-radar-page .radar-stat-meta {
            color: #94a3b8;
            font-size: 0.72rem;
            margin-top: 5px;
        }

        /* ATTENDANCE CARD */
        .sales-radar-page .radar-table-card {
            background: #ffffff;
            border: 1px solid var(--radar-border);
            border-radius: 18px;
            overflow: hidden;
            box-shadow: 0 5px 20px rgba(15, 23, 42, 0.045);
        }

        .sales-radar-page .radar-table-header {
            padding: 18px 20px;
            border-bottom: 1px solid #edf0f4;
            background: #ffffff;
        }

        .sales-radar-page .radar-date-panel {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .sales-radar-page .radar-date-icon {
            width: 38px;
            height: 38px;
            border-radius: 11px;
            background: var(--radar-primary-soft);
            color: var(--radar-primary);
            display: inline-flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
        }

        .sales-radar-page .radar-date-label {
            color: #94a3b8;
            font-size: 0.67rem;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 0.05em;
        }

        .sales-radar-page .radar-selected-date {
            color: #172033;
            font-size: 0.86rem;
            font-weight: 800;
            margin-top: 2px;
        }

        .sales-radar-page .radar-status-pill {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            border-radius: 999px;
            padding: 7px 10px;
            font-size: 0.7rem;
            font-weight: 800;
        }

            .sales-radar-page .radar-status-pill.active {
                background: var(--radar-success-soft);
                color: #15803d;
                border: 1px solid #bbf7d0;
            }

            .sales-radar-page .radar-status-pill.absent {
                background: var(--radar-danger-soft);
                color: #b91c1c;
                border: 1px solid #fecaca;
            }

        /* TABLE */
        .sales-radar-page .radar-table-wrap {
            overflow-x: auto;
            width: 100%;
        }

        .sales-radar-page .radar-table {
            min-width: 1050px;
            margin-bottom: 0;
            border-collapse: separate;
            border-spacing: 0;
        }

            .sales-radar-page .radar-table thead th {
                background: #f8fafc;
                border-bottom: 1px solid #e5e7eb;
                color: #64748b;
                font-size: 0.67rem;
                font-weight: 800;
                letter-spacing: 0.045em;
                text-transform: uppercase;
                padding: 13px 15px;
                white-space: nowrap;
            }

            .sales-radar-page .radar-table tbody td {
                padding: 15px;
                border-bottom: 1px solid #f0f2f5;
                vertical-align: middle;
            }

            .sales-radar-page .radar-table tbody tr {
                transition: background 0.16s ease;
            }

                .sales-radar-page .radar-table tbody tr:hover {
                    background: #fafcff;
                }

                .sales-radar-page .radar-table tbody tr:last-child td {
                    border-bottom: 0;
                }

        .sales-radar-page .radar-avatar {
            width: 39px;
            height: 39px;
            min-width: 39px;
            border-radius: 12px;
            background: var(--radar-primary-soft);
            border: 1px solid #dbeafe;
            color: var(--radar-primary);
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 0.72rem;
            font-weight: 800;
        }

        .sales-radar-page .radar-user-name {
            color: #172033;
            font-size: 0.82rem;
            font-weight: 750;
            line-height: 1.2;
        }

        .sales-radar-page .radar-user-email {
            color: #94a3b8;
            font-size: 0.68rem;
            margin-top: 3px;
        }

        .sales-radar-page .radar-role-badge {
            background: #f8fafc;
            border: 1px solid #e2e8f0;
            color: #64748b;
            border-radius: 8px;
            padding: 6px 9px;
            font-size: 0.68rem;
            font-weight: 700;
            white-space: nowrap;
        }

        .sales-radar-page .radar-time {
            color: #334155;
            font-size: 0.77rem;
            font-weight: 700;
            white-space: nowrap;
        }

        .sales-radar-page .radar-duration {
            color: #64748b;
            font-size: 0.76rem;
            font-weight: 600;
        }

        .sales-radar-page .radar-source {
            color: #64748b;
            font-size: 0.74rem;
            white-space: nowrap;
        }

            .sales-radar-page .radar-source i {
                color: #94a3b8;
            }

        .sales-radar-page .radar-attendance-badge {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            border-radius: 999px;
            padding: 6px 10px;
            font-size: 0.69rem;
            font-weight: 800;
            white-space: nowrap;
        }

            .sales-radar-page .radar-attendance-badge.present {
                color: #15803d;
                background: var(--radar-success-soft);
                border: 1px solid #bbf7d0;
            }

            .sales-radar-page .radar-attendance-badge.late {
                color: #b45309;
                background: var(--radar-warning-soft);
                border: 1px solid #fde68a;
            }

            .sales-radar-page .radar-attendance-badge.absent {
                color: #b91c1c;
                background: var(--radar-danger-soft);
                border: 1px solid #fecaca;
            }

        .sales-radar-page .radar-action-btn {
            border-radius: 9px;
            font-size: 0.7rem;
            font-weight: 700;
            padding: 6px 10px;
            white-space: nowrap;
            transition: all 0.18s ease;
        }

            .sales-radar-page .radar-action-btn:hover {
                transform: translateY(-1px);
                box-shadow: 0 5px 12px rgba(37, 99, 235, 0.12);
            }

        /* EMPTY STATE */
        .sales-radar-page .radar-empty {
            padding: 58px 20px !important;
            color: #94a3b8;
        }

        .sales-radar-page .radar-empty-icon {
            width: 58px;
            height: 58px;
            border-radius: 16px;
            background: #f8fafc;
            border: 1px solid #e2e8f0;
            color: #94a3b8;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 14px;
            font-size: 1.25rem;
        }

        .sales-radar-page .radar-empty-title {
            color: #334155;
            font-size: 0.88rem;
            font-weight: 750;
            margin-bottom: 4px;
        }

        .sales-radar-page .radar-empty-text {
            font-size: 0.74rem;
        }

    /* RESPONSIVE */
    @@media (max-width: 992px) {
        .sales-radar-page .radar-header {
            padding: 18px;
        }

        .sales-radar-page .radar-title {
            font-size: 1.1rem;
        }
    }

    @@media (max-width: 768px) {
        .sales-radar-page .radar-header-actions {
            width: 100%;
        }

        .sales-radar-page .radar-filter-form {
            flex: 1;
        }

        .sales-radar-page .approval-btn {
            flex: 1;
        }

        .sales-radar-page .radar-table-header {
            align-items: flex-start !important;
        }
    }

    @@media (max-width: 576px) {
        .sales-radar-page {
            padding-left: 0 !important;
            padding-right: 0 !important;
        }

            .sales-radar-page .radar-header {
                border-radius: 14px;
                padding: 15px;
            }

            .sales-radar-page .radar-title-icon {
                width: 40px;
                height: 40px;
                min-width: 40px;
                border-radius: 11px;
            }

            .sales-radar-page .radar-title {
                font-size: 1rem;
            }

            .sales-radar-page .radar-stat-card {
                padding: 15px;
            }

            .sales-radar-page .radar-stat-value {
                font-size: 1.4rem;
            }

            .sales-radar-page .radar-table-card {
                border-radius: 14px;
            }

            .sales-radar-page .radar-table-header {
                padding: 15px;
            }

            .sales-radar-page .radar-status-group {
                width: 100%;
            }
    }
</style>

<div class="container-fluid py-3 px-3 px-md-4 sales-radar-page">

    <!-- Header -->
    <div class="radar-header d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">

        <div class="d-flex align-items-center gap-3">
            <div class="radar-title-icon">
                <i class="fa-solid fa-users-viewfinder"></i>
            </div>

            <div>
                <div class="text-muted small mb-1 radar-breadcrumb">
                    <a href="@Url.Action("Index", "SalesManagerDashboard")"
                       class="text-decoration-none">
                        Sales Manager Portal
                    </a>
                    <span class="mx-1">/</span>
                    <span>Team Operations</span>
                </div>

                <h4 class="radar-title mb-0">
                    Sales Team Attendance Radar
                </h4>
            </div>
        </div>

        <div class="d-flex flex-wrap gap-2 align-items-center radar-header-actions">

            <form method="get" class="d-flex align-items-center gap-1 radar-filter-form">

                <input type="date"
                       name="selectedDate"
                       value="@selectedDateStr"
                       class="form-control form-control-sm radar-date" />

                <button type="submit"
                        class="btn btn-primary btn-sm radar-filter-btn shadow-sm">
                    <i class="fa-solid fa-filter me-1"></i>
                    Filter
                </button>

            </form>

            <a href="@Url.Action("Approvals", "Manager")"
               class="btn btn-outline-secondary btn-sm approval-btn shadow-sm">
                <i class="fa-solid fa-clipboard-check me-1"></i>
                Review Team Approvals
            </a>

        </div>
    </div>

    <!-- KPI Cards -->
    <div class="row g-3 mb-4">

        <div class="col-6 col-md-3">
            <div class="radar-stat-card primary">

                <div class="d-flex align-items-center justify-content-between">
                    <div class="radar-stat-label">
                        Sales Executives
                    </div>

                    <div class="radar-stat-icon primary">
                        <i class="fa-solid fa-users"></i>
                    </div>
                </div>

                <div class="radar-stat-value">
                    @totalMembers
                </div>

                <div class="radar-stat-meta">
                    <i class="fa-solid fa-users me-1 text-primary"></i>
                    Assigned to your unit
                </div>

            </div>
        </div>

        <div class="col-6 col-md-3">
            <div class="radar-stat-card success">

                <div class="d-flex align-items-center justify-content-between">
                    <div class="radar-stat-label">
                        On Duty / Present
                    </div>

                    <div class="radar-stat-icon success">
                        <i class="fa-solid fa-circle-check"></i>
                    </div>
                </div>

                <div class="radar-stat-value success">
                    @presentToday
                </div>

                <div class="radar-stat-meta">
                    <i class="fa-solid fa-fingerprint me-1 text-success"></i>
                    Punched in today
                </div>

            </div>
        </div>

        <div class="col-6 col-md-3">
            <div class="radar-stat-card warning">

                <div class="d-flex align-items-center justify-content-between">
                    <div class="radar-stat-label">
                        Late Arrivals
                    </div>

                    <div class="radar-stat-icon warning">
                        <i class="fa-solid fa-clock-rotate-left"></i>
                    </div>
                </div>

                <div class="radar-stat-value warning">
                    @lateCount
                </div>

                <div class="radar-stat-meta">
                    <i class="fa-solid fa-clock me-1 text-warning"></i>
                    Grace exceeded
                </div>

            </div>
        </div>

        <div class="col-6 col-md-3">
            <div class="radar-stat-card danger">

                <div class="d-flex align-items-center justify-content-between">
                    <div class="radar-stat-label">
                        Absent / Inactive
                    </div>

                    <div class="radar-stat-icon danger">
                        <i class="fa-solid fa-user-xmark"></i>
                    </div>
                </div>

                <div class="radar-stat-value danger">
                    @absentCount
                </div>

                <div class="radar-stat-meta">
                    <i class="fa-solid fa-circle-xmark me-1 text-danger"></i>
                    No punch logged
                </div>

            </div>
        </div>

    </div>

    <!-- Attendance Table -->
    <div class="radar-table-card">

        <!-- Table Header -->
        <div class="radar-table-header d-flex flex-wrap justify-content-between align-items-center gap-3">

            <div class="radar-date-panel">

                <div class="radar-date-icon">
                    <i class="fa-solid fa-calendar-day"></i>
                </div>

                <div>
                    <div class="radar-date-label">
                        Radar Pulse Date
                    </div>

                    <div class="radar-selected-date">
                        @DateTime.Parse(selectedDateStr).ToString("dd MMMM yyyy")
                    </div>
                </div>

            </div>

            <div class="d-flex flex-wrap gap-2 radar-status-group">

                <span class="radar-status-pill active">
                    <i class="fa-solid fa-circle-check"></i>
                    Active: @presentToday
                </span>

                <span class="radar-status-pill absent">
                    <i class="fa-solid fa-circle-xmark"></i>
                    Absent: @absentCount
                </span>

            </div>

        </div>

        <!-- Table -->
        <div class="radar-table-wrap">

            <table class="table table-hover align-middle radar-table">

                <thead>
                    <tr>
                        <th>Sales Executive</th>
                        <th>Designation / Role</th>
                        <th>Clock In</th>
                        <th>Clock Out</th>
                        <th>Duration</th>
                        <th>Punch Source</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>

                <tbody>

                    @if (!executives.Any())
                    {
                        <tr>
                            <td colspan="8" class="text-center radar-empty">

                                <div class="radar-empty-icon">
                                    <i class="fa-solid fa-user-slash"></i>
                                </div>

                                <div class="radar-empty-title">
                                    No Sales Executives Found
                                </div>

                                <div class="radar-empty-text">
                                    No subordinate sales executives were found for your unit.
                                </div>

                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var user in executives)
                        {
                            var log = Model.FirstOrDefault(m => m.UserId == user.UserId);

                            var isPresent = log != null &&
                            (log.Status == "Present" || log.Status.Contains("Late"));

                            var statusBadge = isPresent
                            ? (log!.Status.Contains("Late")
                            ? "bg-warning-subtle text-warning border border-warning"
                            : "bg-success-subtle text-success border border-success")
                            : "bg-danger-subtle text-danger border border-danger";

                            var attendanceClass = !isPresent
                            ? "absent"
                            : (log!.Status.Contains("Late") ? "late" : "present");

                            <tr>

                                <!-- Executive -->
                                <td>
                                    <div class="d-flex align-items-center gap-2">

                                        <div class="radar-avatar">
                                            @(string.IsNullOrEmpty(user.FullName)
                                                                                ? "SE"
                                                                                : string.Concat(
                                                                                user.FullName
                                                                                .Split(' ')
                                                                                .Select(w => w.Length > 0 ? w[0].ToString() : "")
                                                                                ))
                                                                              </div>

                                        <div>
                                            <div class="radar-user-name">
                                                @user.FullName
                                            </div>

                                            <div class="radar-user-email">
                                                @user.Email
                                            </div>
                                        </div>

                                    </div>
                                </td>

                                <!-- Role -->
                                <td>
                                    <span class="radar-role-badge">
                                        @(user.Role?.RoleName ?? "Sales Executive")
                                    </span>
                                </td>

                                <!-- Clock In -->
                                <td>
                                    <span class="radar-time">
                                        @(log?.CheckInTime.HasValue == true
                                                                        ? log.CheckInTime.Value.ToString("hh:mm tt")
                                                                        : "-")
                                                                          </span>
                                                                      </td>

                                <!-- Clock Out -->
                                <td>
                                    <span class="radar-time">
                                        @(log?.CheckOutTime.HasValue == true
                                                                        ? log.CheckOutTime.Value.ToString("hh:mm tt")
                                                                        : "-")
                                                                          </span>
                                                                      </td>

                                <!-- Duration -->
                                <td>
                                    <span class="radar-duration">
                                        @(log != null && !string.IsNullOrEmpty(log.WorkHours)
                                                                        ? log.WorkHours
                                                                        : "0h 0m")
                            </span>
                        </td>

                                <!-- Punch Source -->
                                <td>
                                    <span class="radar-source">
                                        <i class="fa-solid fa-fingerprint me-1"></i>
                                        @(log?.PunchSource ?? "Web Portal")
                                    </span>
                                </td>

                                <!-- Status -->
                                <td>
                                    <span class="radar-attendance-badge @attendanceClass">
                                @if (attendanceClass == "present")
                                        {
                                            <i class="fa-solid fa-circle-check"></i>
                                        }
                                        else if (attendanceClass == "late")
                                        {
                                            <i class="fa-solid fa-clock"></i>
                                        }
                                        else
                                        {
                                            <i class="fa-solid fa-circle-xmark"></i>
                                        }

                                        @(log?.Status ?? "Absent")
                                    </span>
                                </td>

                                <!-- Action -->
                                <td class="text-end">

                                    <a href="@Url.Action("Tasks", "SalesManagerDashboard")"
                                       class="btn btn-sm btn-outline-primary radar-action-btn"
                                       title="Assign Target">

                                        <i class="fa-solid fa-tasks me-1"></i>
                                        Assign Target

                                    </a>

                                </td>

                            </tr>
                        }
                    }

                </tbody>

            </table>

        </div>
    </div>

</div>

@model IEnumerable<ERP_System.Models.AdminLoginAudit>
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Failed Login Attempts";
}

<div class="container-fluid py-4 text-start">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-bold mb-1"><i class="fa-solid fa-triangle-exclamation text-primary me-2"></i>Failed Login Attempts</h4>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0 small">
                    <li class="breadcrumb-item"><a href="/SuperAdminDashboard" class="text-decoration-none">Dashboard</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Login Failures</li>
                </ol>
            </nav>
        </div>
    </div>

    <!-- Login Failures List -->
    <div class="bg-white border rounded-3 p-4 shadow-sm mb-4" style="max-width: 800px;">
        <h5 class="fw-bold mb-3"><i class="fa-solid fa-shield-halved text-danger me-2"></i>Suspicious Login Access Alerts</h5>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" style="font-size: 0.85rem;">
                <thead class="table-light">
                    <tr>
                        <th>Access Target Username</th>
                        <th>Origin IP Address</th>
                        <th>Date & Time</th>
                        <th>Status Status</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var fail in Model)
                        {
                            <tr>
                                <td class="fw-bold text-dark">@fail.Username</td>
                                <td><code>@fail.IpAddress</code></td>
                                <td class="text-muted">@fail.LoginTime.ToString("dd MMM yyyy hh:mm tt")</td>
                                <td>
                                    <span class="badge bg-danger-subtle text-danger rounded-pill px-2.5">@fail.Status</span>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4" class="text-center py-4 text-success fw-bold"><i class="fa-solid fa-circle-check me-1.5"></i>No suspicious logins logged. Access patterns normal.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

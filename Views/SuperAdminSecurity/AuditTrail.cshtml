@model IEnumerable<ERP_System.Models.ActivityLog>
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Security Audit Trail";
}

<div class="container-fluid py-4 text-start">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-bold mb-1"><i class="fa-solid fa-user-shield text-primary me-2"></i>Immutable Audit Trail</h4>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0 small">
                    <li class="breadcrumb-item"><a href="/SuperAdminDashboard" class="text-decoration-none">Dashboard</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Audit Trail</li>
                </ol>
            </nav>
        </div>
    </div>

    <!-- Audit Logs Table -->
    <div class="bg-white border rounded-3 p-4 shadow-sm mb-4">
        <h5 class="fw-bold mb-3">Enterprise Operations Logs</h5>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" style="font-size: 0.85rem;">
                <thead class="table-light">
                    <tr>
                        <th>Date & Time</th>
                        <th>Action Log</th>
                        <th>Resource Scope / Message</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var log in Model)
                        {
                            <tr>
                                <td class="text-muted">@log.CreatedAt.ToString("dd MMM yyyy hh:mm tt")</td>
                                <td class="fw-bold text-dark">@log.Title</td>
                                <td>@log.Description</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

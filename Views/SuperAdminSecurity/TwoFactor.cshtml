@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Two-Factor Authentication & IP Whitelisting";
}

<div class="container-fluid py-4 text-start" style="max-width: 700px;">
    <div class="mb-4">
        <h4 class="fw-bold mb-1"><i class="fa-solid fa-key text-primary me-2"></i>2FA & IP Whitelisting Settings</h4>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0 small">
                <li class="breadcrumb-item"><a href="/SuperAdminDashboard" class="text-decoration-none">Dashboard</a></li>
                <li class="breadcrumb-item active" aria-current="page">2FA & IP Whitelist</li>
            </ol>
        </nav>
    </div>

    <!-- Security Form -->
    <div class="bg-white border rounded-3 p-4 shadow-sm mb-4">
        <h5 class="fw-bold mb-3">IP Whitelisting Configurations</h5>
        <form>
            <div class="mb-3">
                <label class="form-label small fw-semibold">Whitelisted IP Addresses (Comma separated)</label>
                <input type="text" class="form-control" value="192.168.1.0/24, 127.0.0.1, 10.0.0.1" />
            </div>
            <div class="mb-3">
                <label class="form-check-label small fw-semibold">
                    <input type="checkbox" class="form-check-input me-1.5" checked /> Require 2-Factor Authentication (2FA) for Administrative Logins
                </label>
            </div>
            <button type="button" class="btn btn-primary rounded-pill px-4" onclick="alert('System security whitelists updated successfully!')">Save Configurations</button>
        </form>
    </div>
</div>

@model IEnumerable<ERP_System.Models.SuperAdminErrorLog>
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "System Error Logs";
}

<div class="container-fluid py-4 text-start">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-bold mb-1"><i class="fa-solid fa-bug text-primary me-2"></i>System Error & Exception Logs</h4>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0 small">
                    <li class="breadcrumb-item"><a href="/SuperAdminDashboard" class="text-decoration-none">Dashboard</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Error Logs</li>
                </ol>
            </nav>
        </div>
    </div>

    <!-- Error Logs Table -->
    <div class="bg-white border rounded-3 p-4 shadow-sm mb-4">
        <h5 class="fw-bold mb-3">Platform Exceptions</h5>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" style="font-size: 0.85rem;">
                <thead class="table-light">
                    <tr>
                        <th>Date & Time</th>
                        <th>Error Message</th>
                        <th>Stack Trace</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var err in Model)
                        {
                            <tr>
                                <td class="text-muted">@err.CreatedAt.ToString("dd MMM yyyy hh:mm tt")</td>
                                <td class="fw-bold text-danger">@err.ErrorMessage</td>
                                <td>
                                    <pre class="bg-light border p-2 rounded small text-dark mb-0" style="max-height: 120px; overflow-y: auto; max-width: 450px;">@err.StackTrace</pre>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="3" class="text-center py-4 text-success fw-bold"><i class="fa-solid fa-circle-check me-1.5"></i>No system exceptions caught! All processes healthy.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

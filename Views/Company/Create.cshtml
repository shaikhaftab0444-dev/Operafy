@model ERP_System.Models.Company
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Company Registration";
}

<style>
    .panel-form {
        background: #ffffff;
        border: 1px solid var(--border-warm);
        border-radius: 12px;
        box-shadow: 0 1px 3px rgba(45,37,30,0.03);
        padding: 2.5rem;
        max-width: 800px;
        margin: 0 auto;
    }

    .form-label-warm {
        font-size: 0.8rem;
        font-weight: 700;
        color: var(--text-color);
        margin-bottom: 6px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .input-group-warm {
        border: 1px solid #d4cbbd;
        border-radius: 8px;
        background-color: #fcfbfa;
        transition: all 0.2s ease-in-out;
        overflow: hidden;
        display: flex;
        align-items: center;
        width: 100%;
    }
    .input-group-warm:focus-within {
        border-color: var(--primary-warm);
        box-shadow: 0 0 0 4px rgba(79, 70, 229, 0.08);
        background-color: #ffffff;
    }

    .input-icon-warm {
        padding: 0.75rem 0.25rem 0.75rem 1rem;
        color: var(--sidebar-color);
        font-size: 0.95rem;
        display: flex;
        align-items: center;
    }

    .form-control-warm {
        border: none !important;
        box-shadow: none !important;
        background: transparent !important;
        color: var(--text-color) !important;
        font-size: 0.9rem !important;
        padding: 0.75rem 1rem !important;
        width: 100%;
    }
</style>

<!-- Breadcrumbs & Header -->
<div class="mb-4 text-center">
    <h4 class="fw-bold mb-1" style="color: var(--text-color);">Company Registration</h4>
    <p class="text-muted small">Register a new enterprise company profile into the database.</p>
    <nav aria-label="breadcrumb" class="d-inline-block">
        <ol class="breadcrumb mb-0 small">
            <li class="breadcrumb-item"><a href="/Dashboard" class="text-decoration-none">Dashboard</a></li>
            <li class="breadcrumb-item"><a href="/Company" class="text-decoration-none">Company Settings</a></li>
            <li class="breadcrumb-item active" aria-current="page">New Registration</li>
        </ol>
    </nav>
</div>

<!-- Form Card -->
<div class="panel-form">
    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()

        <div class="row g-3 text-start">
            <!-- Company Info -->
            <div class="col-md-8">
                <label asp-for="CompanyName" class="form-label-warm">Company Name</label>
                <div class="input-group-warm">
                    <span class="input-icon-warm"><i class="fa-solid fa-building"></i></span>
                    <input asp-for="CompanyName" class="form-control-warm" placeholder="e.g. Wainfo Pvt Ltd" required />
                </div>
            </div>
            <div class="col-md-4">
                <label asp-for="CompanyCode" class="form-label-warm">Company Code</label>
                <div class="input-group-warm">
                    <span class="input-icon-warm"><i class="fa-solid fa-barcode"></i></span>
                    <input asp-for="CompanyCode" class="form-control-warm" placeholder="e.g. WN-01" required />
                </div>
            </div>

            <!-- Contacts -->
            <div class="col-md-6">
                <label asp-for="Email" class="form-label-warm">Contact Email</label>
                <div class="input-group-warm">
                    <span class="input-icon-warm"><i class="fa-regular fa-envelope"></i></span>
                    <input asp-for="Email" type="email" class="form-control-warm" placeholder="info@wainfo.com" />
                </div>
            </div>
            <div class="col-md-6">
                <label asp-for="Phone" class="form-label-warm">Telephone / Mobile</label>
                <div class="input-group-warm">
                    <span class="input-icon-warm"><i class="fa-solid fa-phone"></i></span>
                    <input asp-for="Phone" class="form-control-warm" placeholder="+91..." />
                </div>
            </div>

            <div class="col-md-12">
                <label asp-for="Website" class="form-label-warm">Corporate Website</label>
                <div class="input-group-warm">
                    <span class="input-icon-warm"><i class="fa-solid fa-globe"></i></span>
                    <input asp-for="Website" class="form-control-warm" placeholder="www.wainfo.com" />
                </div>
            </div>

            <!-- Address -->
            <div class="col-md-12">
                <label asp-for="AddressLine1" class="form-label-warm">Street Address</label>
                <div class="input-group-warm">
                    <span class="input-icon-warm"><i class="fa-solid fa-location-dot"></i></span>
                    <input asp-for="AddressLine1" class="form-control-warm" placeholder="Building, Block, Street..." required />
                </div>
            </div>

            <div class="col-md-3">
                <label asp-for="City" class="form-label-warm">City</label>
                <input asp-for="City" class="form-control form-control-warm border" style="border: 1px solid #d4cbbd !important; border-radius: 8px !important;" required />
            </div>
            <div class="col-md-3">
                <label asp-for="State" class="form-label-warm">State</label>
                <input asp-for="State" class="form-control form-control-warm border" style="border: 1px solid #d4cbbd !important; border-radius: 8px !important;" required />
            </div>
            <div class="col-md-3">
                <label asp-for="Country" class="form-label-warm">Country</label>
                <input asp-for="Country" class="form-control form-control-warm border" style="border: 1px solid #d4cbbd !important; border-radius: 8px !important;" required />
            </div>
            <div class="col-md-3">
                <label asp-for="PostalCode" class="form-label-warm">Postal Code</label>
                <input asp-for="PostalCode" class="form-control form-control-warm border" style="border: 1px solid #d4cbbd !important; border-radius: 8px !important;" />
            </div>

            <!-- Settings -->
            <div class="col-md-6">
                <label asp-for="Currency" class="form-label-warm">Currency Code</label>
                <input asp-for="Currency" class="form-control form-control-warm border" style="border: 1px solid #d4cbbd !important; border-radius: 8px !important;" placeholder="e.g. INR, USD" />
            </div>
            <div class="col-md-6">
                <label asp-for="TimeZone" class="form-label-warm">Local Timezone</label>
                <input asp-for="TimeZone" class="form-control form-control-warm border" style="border: 1px solid #d4cbbd !important; border-radius: 8px !important;" placeholder="e.g. India Standard Time" />
            </div>
        </div>

        <!-- Form Buttons -->
        <div class="d-flex justify-content-end gap-3 mt-4">
            <a href="/Company" class="btn btn-secondary-warm" style="border: 1px solid var(--border-warm); background-color: #ffffff; color: var(--text-color); padding: 0.75rem 2rem; border-radius: 8px; font-weight: 600; font-size: 0.9rem; text-decoration: none;">Cancel</a>
            <button type="submit" class="btn btn-primary-warm" style="background: linear-gradient(135deg, var(--primary-warm) 0%, #6366f1 100%); color: #ffffff; border: none; padding: 0.75rem 2rem; border-radius: 8px; font-weight: 600; font-size: 0.9rem; box-shadow: 0 4px 10px rgba(79, 70, 229, 0.2);">Register Company</button>
        </div>
    </form>
</div>

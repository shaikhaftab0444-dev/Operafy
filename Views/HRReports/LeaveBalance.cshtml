@model ERP_System.Models.LeaveBalanceReportViewModel
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Leave Balance Report";
}

<div class="container-fluid py-4 text-start">
    <!-- Header Section -->
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h4 class="fw-bold mb-1"><i class="fa-solid fa-chart-pie text-primary me-2"></i>Leave Balance Report</h4>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0 small">
                    <li class="breadcrumb-item"><a href="/HR" class="text-decoration-none">HR Dashboard</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Leave Balance Report</li>
                </ol>
            </nav>
        </div>
        <div class="d-flex gap-2">
            <a href="/HRReports/ExportLeaveBalance?format=csv&year=@Model.Year&departmentId=@Model.SelectedDepartmentId" class="btn btn-outline-secondary btn-sm rounded-pill">
                <i class="fa-solid fa-file-csv me-1.5 text-primary"></i>Export CSV
            </a>
            <button onclick="window.print()" class="btn btn-primary btn-sm rounded-pill px-3 shadow-sm">
                <i class="fa-solid fa-print me-1.5"></i>Print Report
            </button>
        </div>
    </div>

    <!-- Summary Metrics Cards -->
    <div class="row g-4 mb-4">
        <div class="col-md-3">
            <div class="bg-white border rounded-3 p-3 shadow-sm">
                <div class="text-muted fw-semibold small">Total Staff Covered</div>
                <h4 class="fw-bold text-dark mt-2 mb-0">@Model.TotalEmployeesCount Employees</h4>
            </div>
        </div>
        <div class="col-md-3">
            <div class="bg-white border rounded-3 p-3 shadow-sm">
                <div class="text-muted fw-semibold small">Org Total Leave Quota</div>
                <h4 class="fw-bold text-dark mt-2 mb-0">@Model.TotalLeavesAllocated Days</h4>
            </div>
        </div>
        <div class="col-md-3">
            <div class="bg-white border rounded-3 p-3 shadow-sm">
                <div class="text-muted fw-semibold small">Approved Leaves Consumed</div>
                <h4 class="fw-bold text-warning mt-2 mb-0">@Model.TotalLeavesTaken Days</h4>
            </div>
        </div>
        <div class="col-md-3">
            <div class="bg-white border rounded-3 p-3 shadow-sm">
                <div class="text-muted fw-semibold small">Total Remaining Balance</div>
                <h4 class="fw-bold text-success mt-2 mb-0">@Model.TotalRemainingBalance Days</h4>
            </div>
        </div>
    </div>

    <!-- Filters Bar -->
    <div class="bg-white border rounded-3 p-3 mb-4 shadow-sm">
        <form method="get" action="/HRReports/LeaveBalance" class="row g-2 align-items-center">
            <div class="col-md-4">
                <div class="input-group input-group-sm">
                    <span class="input-group-text bg-light border-end-0"><i class="fa-solid fa-magnifying-glass text-muted"></i></span>
                    <input type="text" name="search" class="form-control border-start-0" placeholder="Search Employee Code, Name..." value="@Model.SearchTerm" />
                </div>
            </div>
            <div class="col-md-3">
                <select name="departmentId" class="form-select form-select-sm" onchange="this.form.submit()">
                    <option value="">All Departments</option>
                    @foreach (var d in Model.Departments)
                    {
                        <option value="@d.DepartmentId" selected="@(Model.SelectedDepartmentId == d.DepartmentId ? "selected" : null)">@d.DepartmentName</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <select name="year" class="form-select form-select-sm" onchange="this.form.submit()">
                    <option value="2026" selected="@(Model.Year == 2026 ? "selected" : null)">Year 2026</option>
                    <option value="2025" selected="@(Model.Year == 2025 ? "selected" : null)">Year 2025</option>
                </select>
            </div>
            <div class="col-md-2 text-end">
                <button type="submit" class="btn btn-sm btn-outline-primary rounded-pill px-3">Filter</button>
                <a href="/HRReports/LeaveBalance" class="btn btn-sm btn-outline-secondary rounded-pill px-2">Reset</a>
            </div>
        </form>
    </div>

    <!-- Report Table -->
    <div class="bg-white border rounded-3 p-4 shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" style="font-size: 0.85rem;">
                <thead class="table-light">
                    <tr>
                        <th>Employee</th>
                        <th>Casual Leave (CL)</th>
                        <th>Sick Leave (SL)</th>
                        <th>Earned Leave (EL)</th>
                        <th>Total Quota</th>
                        <th>Total Used</th>
                        <th>Remaining Balance</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.EmployeeBalances != null && Model.EmployeeBalances.Any())
                    {
                        foreach (var item in Model.EmployeeBalances)
                        {
                            <tr>
                                <td>
                                    <div class="fw-bold text-dark">@item.EmployeeName</div>
                                    <div class="text-muted small">@item.EmployeeCode • @item.DesignationTitle</div>
                                </td>
                                <td>
                                    <div class="small fw-semibold">@item.CasualLeaveBalance / @item.CasualLeaveAllocated Days</div>
                                    <div class="text-muted small">Used: @item.CasualLeaveUsed</div>
                                </td>
                                <td>
                                    <div class="small fw-semibold">@item.SickLeaveBalance / @item.SickLeaveAllocated Days</div>
                                    <div class="text-muted small">Used: @item.SickLeaveUsed</div>
                                </td>
                                <td>
                                    <div class="small fw-semibold">@item.EarnedLeaveBalance / @item.EarnedLeaveAllocated Days</div>
                                    <div class="text-muted small">Used: @item.EarnedLeaveUsed</div>
                                </td>
                                <td class="fw-semibold">@item.TotalAllocated Days</td>
                                <td class="text-warning fw-bold">@item.TotalUsed Days</td>
                                <td class="text-success fw-bold fs-6">@item.TotalRemainingBalance Days</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center py-4 text-muted">
                                <i class="fa-solid fa-plane-slash fa-2x mb-2 d-block text-secondary"></i>
                                No Leave records found matching the selected filters.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

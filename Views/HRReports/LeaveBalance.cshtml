@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Leave Balance Report";
}

<div class="container-fluid py-4 text-start">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-bold mb-1"><i class="fa-solid fa-chart-pie text-primary me-2"></i>Leave Balance Report</h4>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0 small">
                    <li class="breadcrumb-item"><a href="/HR" class="text-decoration-none">HR Dashboard</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Leave Balance Report</li>
                </ol>
            </nav>
        </div>
    </div>

    <!-- Report Table -->
    <div class="bg-white border rounded-3 p-4 shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" style="font-size: 0.85rem;">
                <thead class="table-light">
                    <tr>
                        <th>Department</th>
                        <th>Employees Count</th>
                        <th>Total CL Balanced</th>
                        <th>Total SL Balanced</th>
                        <th>Total EL Balanced</th>
                        <th>Leaves Taken This Month</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td class="fw-bold text-dark">Sales & Marketing</td>
                        <td>12</td>
                        <td>96 Days</td>
                        <td>72 Days</td>
                        <td>120 Days</td>
                        <td>4 Days</td>
                    </tr>
                    <tr>
                        <td class="fw-bold text-dark">Human Resources</td>
                        <td>3</td>
                        <td>24 Days</td>
                        <td>18 Days</td>
                        <td>32 Days</td>
                        <td>2 Days</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

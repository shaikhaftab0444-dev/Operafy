@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Attendance & Late-Coming Report";
}

<div class="container-fluid py-4 text-start">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-bold mb-1"><i class="fa-solid fa-chart-line text-primary me-2"></i>Attendance & Late-Coming Report</h4>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0 small">
                    <li class="breadcrumb-item"><a href="/HR" class="text-decoration-none">HR Dashboard</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Attendance Report</li>
                </ol>
            </nav>
        </div>
        <button class="btn btn-outline-secondary w-auto btn-sm rounded-pill"><i class="fa-solid fa-file-excel me-1.5 text-success"></i>Export Excel</button>
    </div>

    <!-- Stats summary cards -->
    <div class="row g-4 mb-4">
        <div class="col-md-4">
            <div class="bg-white border rounded-3 p-3 shadow-sm">
                <div class="text-muted fw-semibold small">Average Office Check-in Time</div>
                <h4 class="fw-bold text-dark mt-2 mb-0">09:14 AM</h4>
            </div>
        </div>
        <div class="col-md-4">
            <div class="bg-white border rounded-3 p-3 shadow-sm">
                <div class="text-muted fw-semibold small">Total Late Punch-ins (Current Month)</div>
                <h4 class="fw-bold text-warning mt-2 mb-0">14 Instances</h4>
            </div>
        </div>
        <div class="col-md-4">
            <div class="bg-white border rounded-3 p-3 shadow-sm">
                <div class="text-muted fw-semibold small">Avg Monthly Working Hours</div>
                <h4 class="fw-bold text-success mt-2 mb-0">172.5 hrs</h4>
            </div>
        </div>
    </div>

    <!-- Report Table -->
    <div class="bg-white border rounded-3 p-4 shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" style="font-size: 0.85rem;">
                <thead class="table-light">
                    <tr>
                        <th>Employee</th>
                        <th>Present Days</th>
                        <th>Late Days</th>
                        <th>Absences</th>
                        <th>Avg Daily Work Hours</th>
                        <th>Regularization Requests</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td class="fw-bold text-dark">Numan Sales Man</td>
                        <td>20 Days</td>
                        <td>1 Day</td>
                        <td>0 Days</td>
                        <td>8h 50m</td>
                        <td>0 Requests</td>
                    </tr>
                    <tr>
                        <td class="fw-bold text-dark">Aftab Shaik</td>
                        <td>19 Days</td>
                        <td>0 Days</td>
                        <td>1 Day</td>
                        <td>8h 52m</td>
                        <td>1 Request</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

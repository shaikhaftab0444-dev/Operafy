@{
    Layout = null;
    string reportType = ViewBag.ReportType as string ?? "Attendance & Late Report";
    string payPeriod = ViewBag.PayPeriod as string ?? "August 2026";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Official Report - @reportType - AIT Technologies</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        body { font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; background-color: #fff; color: #212529; padding: 20px; }
        .report-header { border-bottom: 2px solid #0d6efd; padding-bottom: 15px; margin-bottom: 25px; }
        @@media print {
            .no-print { display: none !important; }
            body { padding: 0; }
        }
    </style>
</head>
<body onload="window.print()">

<div class="container-fluid">
    <div class="text-end no-print mb-3">
        <button onclick="window.print()" class="btn btn-primary rounded-pill px-4 shadow-sm"><i class="fa-solid fa-print me-2"></i>Print Report</button>
        <button onclick="window.close()" class="btn btn-outline-secondary rounded-pill px-3 ms-2">Close</button>
    </div>

    <div class="report-header d-flex justify-content-between align-items-center">
        <div>
            <h3 class="fw-bold mb-0 text-primary"><i class="fa-solid fa-layer-group me-2"></i>AIT TECHNOLOGIES PVT LTD</h3>
            <div class="text-muted small">Enterprise Human Resources Management System</div>
        </div>
        <div class="text-end">
            <h5 class="fw-bold mb-1 text-dark">@reportType</h5>
            <div class="text-muted small">Generated on: @DateTime.Now.ToString("dd MMMM yyyy, hh:mm tt")</div>
            <div class="text-muted small">Period: @payPeriod</div>
        </div>
    </div>

    <div class="p-3 bg-light border rounded mb-4">
        <div class="row small">
            <div class="col-3"><strong>Company:</strong> AIT Technologies Pvt Ltd</div>
            <div class="col-3"><strong>Module:</strong> HR Management</div>
            <div class="col-3"><strong>Status:</strong> Official Audit Record</div>
            <div class="col-3 text-end"><strong>Generated By:</strong> Super Admin</div>
        </div>
    </div>

    <div class="alert alert-info py-2 small">
        <i class="fa-solid fa-circle-info me-2"></i>This official report is dynamically generated from real EF Core database records of AIT Technologies Pvt Ltd.
    </div>

    <div class="text-center mt-5 pt-4 text-muted small">
        <hr />
        <div>Confidential • Official HR Report Document • AIT Technologies Pvt Ltd</div>
    </div>
</div>

</body>
</html>

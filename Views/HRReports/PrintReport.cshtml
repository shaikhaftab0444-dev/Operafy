@{
    Layout = null;
    string reportType = ViewBag.ReportType as string ?? "Attendance & Late Report";
    string payPeriod = ViewBag.PayPeriod as string ?? "August 2026";
}

<!DOCTYPE html>

<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    ```
    <title>Official Report - @reportType - AIT Technologies</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <style>
        :root {
            --primary-color: #2563eb;
            --primary-dark: #1d4ed8;
            --primary-soft: #eff6ff;
            --dark-color: #172033;
            --text-muted: #64748b;
            --border-color: #e2e8f0;
            --success-color: #16a34a;
            --success-soft: #f0fdf4;
            --warning-color: #d97706;
            --white: #ffffff;
        }

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            min-height: 100vh;
            font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
            color: var(--dark-color);
            background: radial-gradient(circle at top left, rgba(37, 99, 235, 0.08), transparent 30%), linear-gradient(135deg, #f8fafc 0%, #eef4ff 100%);
            padding: 32px 20px;
        }

        .report-page {
            width: 100%;
            max-width: 1400px;
            margin: 0 auto;
            background: var(--white);
            border: 1px solid rgba(226, 232, 240, 0.9);
            border-radius: 24px;
            box-shadow: 0 25px 70px rgba(15, 23, 42, 0.12);
            overflow: hidden;
            animation: pageEntrance 0.7s ease-out;
        }

        /* =========================
               TOP ACTION BAR
            ========================= */

        .report-actions {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 16px;
            padding: 18px 28px;
            background: rgba(248, 250, 252, 0.95);
            border-bottom: 1px solid var(--border-color);
        }

        .action-info {
            display: flex;
            align-items: center;
            gap: 10px;
            color: var(--text-muted);
            font-size: 0.84rem;
            font-weight: 600;
        }

            .action-info i {
                color: var(--success-color);
            }

        .action-buttons {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .btn-print,
        .btn-close-report {
            border-radius: 12px;
            padding: 9px 18px;
            font-size: 0.84rem;
            font-weight: 700;
            transition: all 0.25s ease;
        }

        .btn-print {
            border: none;
            color: #fff;
            background: linear-gradient(135deg, var(--primary-color), var(--primary-dark));
            box-shadow: 0 8px 18px rgba(37, 99, 235, 0.22);
        }

            .btn-print:hover {
                transform: translateY(-2px);
                color: #fff;
                box-shadow: 0 12px 25px rgba(37, 99, 235, 0.3);
            }

        .btn-close-report {
            color: var(--text-muted);
            border: 1px solid var(--border-color);
            background: #fff;
        }

            .btn-close-report:hover {
                color: #dc2626;
                border-color: rgba(220, 38, 38, 0.25);
                background: #fef2f2;
                transform: translateY(-2px);
            }

        /* =========================
               COMPANY HEADER
            ========================= */

        .company-header {
            position: relative;
            overflow: hidden;
            padding: 42px 38px 36px;
            color: #fff;
            background: linear-gradient(135deg, rgba(15, 23, 42, 0.96), rgba(30, 64, 175, 0.92)), #172033;
        }

            .company-header::before {
                content: "";
                position: absolute;
                width: 340px;
                height: 340px;
                border-radius: 50%;
                top: -180px;
                right: -100px;
                background: rgba(255, 255, 255, 0.05);
                border: 1px solid rgba(255, 255, 255, 0.08);
            }

            .company-header::after {
                content: "";
                position: absolute;
                width: 170px;
                height: 170px;
                border-radius: 50%;
                bottom: -100px;
                right: 160px;
                background: rgba(96, 165, 250, 0.1);
            }

        .company-header-content {
            position: relative;
            z-index: 2;
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 30px;
        }

        .company-brand {
            display: flex;
            align-items: center;
            gap: 18px;
        }

        .company-logo {
            width: 68px;
            height: 68px;
            flex-shrink: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 18px;
            font-size: 1.75rem;
            color: #fff;
            background: linear-gradient(135deg, #3b82f6, #1d4ed8);
            border: 1px solid rgba(255, 255, 255, 0.15);
            box-shadow: 0 12px 28px rgba(0, 0, 0, 0.2);
            animation: logoFloat 3s ease-in-out infinite;
        }

        .company-title {
            margin: 0 0 5px;
            font-size: 1.7rem;
            font-weight: 800;
            letter-spacing: 0.4px;
        }

        .company-subtitle {
            margin: 0;
            color: rgba(255, 255, 255, 0.7);
            font-size: 0.9rem;
        }

        .report-title-box {
            min-width: 330px;
            padding: 17px 20px;
            text-align: right;
            border-radius: 16px;
            background: rgba(255, 255, 255, 0.08);
            border: 1px solid rgba(255, 255, 255, 0.1);
            backdrop-filter: blur(8px);
        }

        .report-label {
            display: inline-flex;
            align-items: center;
            gap: 7px;
            margin-bottom: 7px;
            padding: 5px 10px;
            border-radius: 50px;
            font-size: 0.7rem;
            font-weight: 800;
            letter-spacing: 0.7px;
            text-transform: uppercase;
            color: #bfdbfe;
            background: rgba(59, 130, 246, 0.18);
        }

        .report-main-title {
            margin: 0 0 7px;
            font-size: 1.05rem;
            font-weight: 800;
        }

        .report-generated {
            margin: 0;
            color: rgba(255, 255, 255, 0.68);
            font-size: 0.78rem;
        }

        /* =========================
               REPORT CONTENT
            ========================= */

        .report-content {
            padding: 32px 38px 38px;
        }

        .report-information {
            margin-bottom: 24px;
            padding: 22px;
            border: 1px solid var(--border-color);
            border-radius: 18px;
            background: linear-gradient(135deg, #ffffff 0%, #f8fbff 100%);
            box-shadow: 0 8px 25px rgba(15, 23, 42, 0.04);
            animation: slideUp 0.65s ease-out both;
            animation-delay: 0.1s;
        }

        .section-heading {
            display: flex;
            align-items: center;
            gap: 9px;
            margin-bottom: 18px;
            font-size: 0.78rem;
            font-weight: 800;
            letter-spacing: 0.6px;
            text-transform: uppercase;
            color: var(--primary-color);
        }

            .section-heading i {
                width: 28px;
                height: 28px;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                border-radius: 8px;
                background: var(--primary-soft);
            }

        .detail-item {
            height: 100%;
            padding: 13px 14px;
            border: 1px solid #edf1f7;
            border-radius: 12px;
            background: #fff;
        }

        .detail-label {
            display: block;
            margin-bottom: 5px;
            font-size: 0.67rem;
            font-weight: 800;
            letter-spacing: 0.5px;
            text-transform: uppercase;
            color: #94a3b8;
        }

        .detail-value {
            font-size: 0.85rem;
            font-weight: 700;
            color: var(--dark-color);
        }

        .status-official {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 6px 10px;
            border-radius: 50px;
            font-size: 0.72rem;
            font-weight: 700;
            color: #15803d;
            background: var(--success-soft);
            border: 1px solid #bbf7d0;
        }

        /* =========================
               NOTICE
            ========================= */

        .official-notice {
            display: flex;
            align-items: flex-start;
            gap: 14px;
            margin-bottom: 28px;
            padding: 17px 19px;
            border-left: 4px solid var(--primary-color);
            border-radius: 14px;
            background: linear-gradient(90deg, #eff6ff, #f8fbff);
            color: #334155;
            animation: slideUp 0.65s ease-out both;
            animation-delay: 0.2s;
        }

            .official-notice .notice-icon {
                width: 38px;
                height: 38px;
                flex-shrink: 0;
                display: flex;
                align-items: center;
                justify-content: center;
                border-radius: 10px;
                color: var(--primary-color);
                background: rgba(37, 99, 235, 0.1);
            }

        .notice-title {
            margin-bottom: 3px;
            font-size: 0.84rem;
            font-weight: 800;
            color: var(--dark-color);
        }

        .notice-text {
            margin: 0;
            font-size: 0.8rem;
            line-height: 1.65;
            color: var(--text-muted);
        }

        /* =========================
               REPORT BODY AREA
            ========================= */

        .report-data-area {
            min-height: 250px;
            margin-bottom: 28px;
            padding: 28px;
            border: 1px dashed #cbd5e1;
            border-radius: 18px;
            background: linear-gradient(135deg, rgba(248, 250, 252, 0.75), rgba(255, 255, 255, 0.95));
            animation: slideUp 0.65s ease-out both;
            animation-delay: 0.3s;
        }

        .data-area-title {
            display: flex;
            align-items: center;
            gap: 10px;
            padding-bottom: 15px;
            margin-bottom: 22px;
            border-bottom: 1px solid var(--border-color);
        }

        .data-area-icon {
            width: 38px;
            height: 38px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 11px;
            color: var(--primary-color);
            background: var(--primary-soft);
        }

        .data-area-title h6 {
            margin: 0;
            font-size: 0.9rem;
            font-weight: 800;
        }

        .data-area-title p {
            margin: 2px 0 0;
            font-size: 0.75rem;
            color: var(--text-muted);
        }

        .data-placeholder {
            min-height: 150px;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            text-align: center;
            color: var(--text-muted);
        }

            .data-placeholder i {
                margin-bottom: 13px;
                font-size: 2rem;
                color: #cbd5e1;
            }

            .data-placeholder strong {
                margin-bottom: 5px;
                font-size: 0.88rem;
                color: #64748b;
            }

            .data-placeholder span {
                font-size: 0.75rem;
            }

        /* =========================
               FOOTER
            ========================= */

        .report-footer {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 20px;
            padding-top: 22px;
            border-top: 1px solid var(--border-color);
        }

        .footer-confidential {
            display: flex;
            align-items: center;
            gap: 9px;
            font-size: 0.76rem;
            font-weight: 700;
            color: var(--text-muted);
        }

            .footer-confidential i {
                color: var(--primary-color);
            }

        .footer-right {
            text-align: right;
            font-size: 0.72rem;
            color: #94a3b8;
        }

            .footer-right strong {
                color: #64748b;
            }

        /* =========================
               ANIMATIONS
            ========================= */

        @@keyframes pageEntrance {
            from {
                opacity: 0;
                transform: translateY(18px) scale(0.99);
            }

            to {
                opacity: 1;
                transform: translateY(0) scale(1);
            }
        }

        @@keyframes slideUp {
            from {
                opacity: 0;
                transform: translateY(16px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        @@keyframes logoFloat {
            0%, 100% {
                transform: translateY(0);
            }

            50% {
                transform: translateY(-5px);
            }
        }

        /* =========================
               RESPONSIVE DESIGN
            ========================= */

        @@media (max-width: 991.98px) {
            body {
                padding: 20px 14px;
            }

            .company-header,
            .report-content {
                padding-left: 24px;
                padding-right: 24px;
            }

            .company-header-content {
                align-items: flex-start;
                flex-direction: column;
            }

            .report-title-box {
                width: 100%;
                min-width: 0;
                text-align: left;
            }

            .report-footer {
                align-items: flex-start;
                flex-direction: column;
            }

            .footer-right {
                text-align: left;
            }
        }

        @@media (max-width: 767.98px) {
            body {
                padding: 0;
                background: #fff;
            }

            .report-page {
                border: none;
                border-radius: 0;
                box-shadow: none;
            }

            .report-actions {
                padding: 14px 16px;
                align-items: flex-start;
                flex-direction: column;
            }

            .action-buttons {
                width: 100%;
            }

                .action-buttons button {
                    flex: 1;
                }

            .company-header {
                padding: 30px 20px;
            }

            .company-brand {
                align-items: flex-start;
            }

            .company-logo {
                width: 56px;
                height: 56px;
                border-radius: 15px;
                font-size: 1.4rem;
            }

            .company-title {
                font-size: 1.22rem;
            }

            .report-content {
                padding: 22px 16px;
            }

            .report-information {
                padding: 16px;
            }

            .official-notice {
                padding: 15px;
            }

            .report-data-area {
                padding: 18px;
            }
        }

        /* =========================
               PRINT STYLES
            ========================= */

        @@media print {
            @@page {
                size: A4;
                margin: 12mm;
            }

            body {
                padding: 0 !important;
                background: #fff !important;
            }

            .report-page {
                max-width: none;
                border: none;
                border-radius: 0;
                box-shadow: none;
            }

            .no-print {
                display: none !important;
            }

            .company-header {
                padding: 22px 24px;
                -webkit-print-color-adjust: exact;
                print-color-adjust: exact;
            }

            .report-content {
                padding: 22px 24px;
            }

            .report-information,
            .official-notice,
            .report-data-area {
                break-inside: avoid;
                box-shadow: none;
            }

            .company-header::before,
            .company-header::after {
                display: none;
            }

            * {
                animation: none !important;
                transition: none !important;
            }
        }
    </style>

</head>

<body onload="window.print()">

    <div class="report-page">

        <!-- TOP ACTION BAR -->
        <div class="report-actions no-print">
            <div class="action-info">
                <i class="fa-solid fa-circle-check"></i>
                <span>Official ERP Report Preview • Ready for Printing</span>
            </div>

            <div class="action-buttons">
                <button onclick="window.print()" class="btn btn-print">
                    <i class="fa-solid fa-print me-2"></i>Print Report
                </button>

                <button onclick="window.close()" class="btn btn-close-report">
                    <i class="fa-solid fa-xmark me-2"></i>Close
                </button>
            </div>
        </div>

        <!-- COMPANY HEADER -->
        <div class="company-header">
            <div class="company-header-content">

                <div class="company-brand">
                    <div class="company-logo">
                        <i class="fa-solid fa-layer-group"></i>
                    </div>

                    <div>
                        <h1 class="company-title">AIT TECHNOLOGIES PVT LTD</h1>
                        <p class="company-subtitle">
                            Enterprise Human Resources Management System
                        </p>
                    </div>
                </div>

                <div class="report-title-box">
                    <div class="report-label">
                        <i class="fa-solid fa-file-shield"></i>
                        Official Report
                    </div>

                    <h5 class="report-main-title">@reportType</h5>

                    <p class="report-generated">
                        Generated on @DateTime.Now.ToString("dd MMMM yyyy • hh:mm tt")
                    </p>
                </div>

            </div>
        </div>

        <!-- REPORT CONTENT -->
        <div class="report-content">

            <!-- REPORT INFORMATION -->
            <div class="report-information">

                <div class="section-heading">
                    <i class="fa-solid fa-circle-info"></i>
                    Report Information
                </div>

                <div class="row g-3">

                    <div class="col-xl-3 col-md-6">
                        <div class="detail-item">
                            <span class="detail-label">Company</span>
                            <div class="detail-value">
                                AIT Technologies Pvt Ltd
                            </div>
                        </div>
                    </div>

                    <div class="col-xl-3 col-md-6">
                        <div class="detail-item">
                            <span class="detail-label">Module</span>
                            <div class="detail-value">
                                <i class="fa-solid fa-users-gear me-1 text-primary"></i>
                                HR Management
                            </div>
                        </div>
                    </div>

                    <div class="col-xl-2 col-md-6">
                        <div class="detail-item">
                            <span class="detail-label">Status</span>
                            <div class="status-official">
                                <i class="fa-solid fa-shield-halved"></i>
                                Official Record
                            </div>
                        </div>
                    </div>

                    <div class="col-xl-2 col-md-6">
                        <div class="detail-item">
                            <span class="detail-label">Reporting Period</span>
                            <div class="detail-value">
                                @payPeriod
                            </div>
                        </div>
                    </div>

                    <div class="col-xl-2 col-md-6">
                        <div class="detail-item">
                            <span class="detail-label">Generated By</span>
                            <div class="detail-value">
                                <i class="fa-solid fa-user-shield me-1 text-primary"></i>
                                Super Admin
                            </div>
                        </div>
                    </div>

                </div>
            </div>

            <!-- OFFICIAL NOTICE -->
            <div class="official-notice">

                <div class="notice-icon">
                    <i class="fa-solid fa-database"></i>
                </div>

                <div>
                    <div class="notice-title">
                        Verified ERP Data Record
                    </div>

                    <p class="notice-text">
                        This official report is dynamically generated from real EF Core database records
                        available in the AIT Technologies Pvt Ltd Enterprise Resource Planning system.
                        The report should be treated as an official HR audit and management document.
                    </p>
                </div>

            </div>

            <!-- REPORT DATA AREA -->
            <div class="report-data-area">

                <div class="data-area-title">
                    <div class="data-area-icon">
                        <i class="fa-solid fa-table-list"></i>
                    </div>

                    <div>
                        <h6>Report Data & Records</h6>
                        <p>
                            The selected report information will appear in this official document section.
                        </p>
                    </div>
                </div>

                <div class="data-placeholder">
                    <i class="fa-solid fa-file-lines"></i>
                    <strong>@reportType</strong>
                    <span>
                        Official report data is dynamically generated based on the selected records and filters.
                    </span>
                </div>

            </div>

            <!-- FOOTER -->
            <div class="report-footer">

                <div class="footer-confidential">
                    <i class="fa-solid fa-lock"></i>
                    <span>Confidential • Official HR Report Document</span>
                </div>

                <div class="footer-right">
                    <div>
                        Document generated by
                        <strong>AIT Technologies ERP System</strong>
                    </div>

                    <div class="mt-1">
                        © @DateTime.Now.Year AIT Technologies Pvt Ltd. All rights reserved.
                    </div>
                </div>

            </div>

        </div>

    </div>

</body>
</html>
@model ERP_System.Models.PayrollSummaryReportViewModel
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Monthly Payroll Summary Report";
}

<div class="container-fluid py-4 text-start">
    <!-- Header Section -->
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h4 class="fw-bold mb-1"><i class="fa-solid fa-chart-column text-primary me-2"></i>Monthly Payroll Summary</h4>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0 small">
                    <li class="breadcrumb-item"><a href="/HR" class="text-decoration-none">HR Dashboard</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Payroll Summary</li>
                </ol>
            </nav>
        </div>
        <div class="d-flex gap-2">
            <a href="/HRReports/ExportPayrollSummary?format=csv&payPeriod=@Model.SelectedPayPeriod&departmentId=@Model.SelectedDepartmentId&status=@Model.SelectedStatus" class="btn btn-outline-secondary btn-sm rounded-pill">
                <i class="fa-solid fa-file-csv me-1.5 text-primary"></i>Export CSV
            </a>
            <a href="/HRReports/ExportPayrollSummary?format=excel&payPeriod=@Model.SelectedPayPeriod&departmentId=@Model.SelectedDepartmentId&status=@Model.SelectedStatus" class="btn btn-outline-secondary btn-sm rounded-pill">
                <i class="fa-solid fa-file-excel me-1.5 text-success"></i>Export Excel
            </a>
            <button onclick="window.print()" class="btn btn-primary btn-sm rounded-pill px-3 shadow-sm">
                <i class="fa-solid fa-print me-1.5"></i>Print Report
            </button>
        </div>
    </div>

    <!-- Summary Metrics Cards -->
    <div class="row g-4 mb-4">
        <div class="col-md-3">
            <div class="bg-white border rounded-3 p-3 shadow-sm">
                <div class="text-muted fw-semibold small">Total Employees Paid</div>
                <h4 class="fw-bold text-dark mt-2 mb-0">@Model.TotalEmployeesPaid Employees</h4>
            </div>
        </div>
        <div class="col-md-3">
            <div class="bg-white border rounded-3 p-3 shadow-sm">
                <div class="text-muted fw-semibold small">Total Gross Payout</div>
                <h4 class="fw-bold text-dark mt-2 mb-0">₹@Model.TotalGrossSalary.ToString("N0")</h4>
            </div>
        </div>
        <div class="col-md-3">
            <div class="bg-white border rounded-3 p-3 shadow-sm">
                <div class="text-muted fw-semibold small">Total Deductions (PF/ESI/TDS)</div>
                <h4 class="fw-bold text-danger mt-2 mb-0">₹@Model.TotalDeductions.ToString("N0")</h4>
            </div>
        </div>
        <div class="col-md-3">
            <div class="bg-white border rounded-3 p-3 shadow-sm">
                <div class="text-muted fw-semibold small">Net Salary Disbursed</div>
                <h4 class="fw-bold text-success mt-2 mb-0">₹@Model.TotalNetSalary.ToString("N0")</h4>
            </div>
        </div>
    </div>

    <!-- Filters Bar -->
    <div class="bg-white border rounded-3 p-3 mb-4 shadow-sm">
        <form method="get" action="/HRReports/PayrollSummary" class="row g-2 align-items-center">
            <div class="col-md-3">
                <label class="form-label small fw-semibold mb-1">Pay Period</label>
                <select name="payPeriod" class="form-select form-select-sm" onchange="this.form.submit()">
                    <option value="August 2026" selected="@(Model.SelectedPayPeriod == "August 2026" ? "selected" : null)">August 2026</option>
                    <option value="July 2026" selected="@(Model.SelectedPayPeriod == "July 2026" ? "selected" : null)">July 2026</option>
                    <option value="June 2026" selected="@(Model.SelectedPayPeriod == "June 2026" ? "selected" : null)">June 2026</option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-semibold mb-1">Department</label>
                <select name="departmentId" class="form-select form-select-sm" onchange="this.form.submit()">
                    <option value="">All Departments</option>
                    @foreach (var d in Model.Departments)
                    {
                        <option value="@d.DepartmentId" selected="@(Model.SelectedDepartmentId == d.DepartmentId ? "selected" : null)">@d.DepartmentName</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-semibold mb-1">Payment Status</label>
                <select name="status" class="form-select form-select-sm" onchange="this.form.submit()">
                    <option value="All">All Statuses</option>
                    <option value="Paid" selected="@(Model.SelectedStatus == "Paid" ? "selected" : null)">Paid</option>
                    <option value="Approved" selected="@(Model.SelectedStatus == "Approved" ? "selected" : null)">Approved</option>
                    <option value="Draft" selected="@(Model.SelectedStatus == "Draft" ? "selected" : null)">Draft</option>
                </select>
            </div>
            <div class="col-md-3 text-end pt-3">
                <button type="submit" class="btn btn-sm btn-outline-primary rounded-pill px-3">Filter</button>
                <a href="/HRReports/PayrollSummary" class="btn btn-sm btn-outline-secondary rounded-pill px-2">Reset</a>
            </div>
        </form>
    </div>

    <!-- Payroll summary table -->
    <div class="bg-white border rounded-3 p-4 shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" style="font-size: 0.85rem;">
                <thead class="table-light">
                    <tr>
                        <th>Employee</th>
                        <th>Pay Period</th>
                        <th>Basic Salary</th>
                        <th>HRA & Allowances</th>
                        <th>Gross Salary</th>
                        <th>Total Deductions</th>
                        <th>Net Salary</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Payslips != null && Model.Payslips.Any())
                    {
                        foreach (var slip in Model.Payslips)
                        {
                            decimal totalAllowances = slip.HRA.GetValueOrDefault() + slip.SpecialAllowance.GetValueOrDefault() + slip.TransportAllowance.GetValueOrDefault() + slip.OtherAllowance.GetValueOrDefault();

                            <tr>
                                <td>
                                    <div class="fw-bold text-dark">@(slip.User?.FullName ?? "Staff Member")</div>
                                    <div class="text-muted small">@(slip.User?.UserCode) • @(slip.PayslipNumber)</div>
                                </td>
                                <td><span class="badge bg-light text-dark border">@slip.PayPeriod</span></td>
                                <td>₹@slip.BasicSalary.ToString("N0")</td>
                                <td>₹@totalAllowances.ToString("N0")</td>
                                <td class="fw-bold text-dark">₹@slip.GrossSalary.ToString("N0")</td>
                                <td class="text-danger">₹@slip.TotalDeductions.ToString("N0")</td>
                                <td class="fw-bold text-success fs-6">₹@slip.NetSalary.ToString("N0")</td>
                                <td><span class="badge bg-success-subtle text-success fw-semibold">@slip.Status</span></td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="text-center py-4 text-muted">
                                <i class="fa-solid fa-file-invoice-dollar fa-2x mb-2 d-block text-secondary"></i>
                                No Payroll records found for the selected period.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

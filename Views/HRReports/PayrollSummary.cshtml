@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Monthly Payroll Summary";
}

<div class="container-fluid py-4 text-start">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-bold mb-1"><i class="fa-solid fa-chart-column text-primary me-2"></i>Monthly Payroll Summary</h4>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0 small">
                    <li class="breadcrumb-item"><a href="/HR" class="text-decoration-none">HR Dashboard</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Payroll Summary</li>
                </ol>
            </nav>
        </div>
        <button class="btn btn-outline-secondary w-auto btn-sm rounded-pill"><i class="fa-solid fa-file-pdf me-1.5 text-danger"></i>Export PDF</button>
    </div>

    <!-- Payroll summary table -->
    <div class="bg-white border rounded-3 p-4 shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" style="font-size: 0.85rem;">
                <thead class="table-light">
                    <tr>
                        <th>Pay Period</th>
                        <th>Gross Payout</th>
                        <th>Tax Deducted (TDS)</th>
                        <th>PF Employer Contribution</th>
                        <th>ESI Employer Contribution</th>
                        <th>Net Transfer Amount</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td class="fw-bold text-dark">July 2026</td>
                        <td>₹26,80,000</td>
                        <td>₹1,45,000</td>
                        <td>₹1,08,000</td>
                        <td>₹42,000</td>
                        <td class="fw-bold text-success">₹23,85,000</td>
                    </tr>
                    <tr>
                        <td class="fw-bold text-dark">June 2026</td>
                        <td>₹26,20,000</td>
                        <td>₹1,41,000</td>
                        <td>₹1,05,000</td>
                        <td>₹41,000</td>
                        <td class="fw-bold text-success">₹23,32,000</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

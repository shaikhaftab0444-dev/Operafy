@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Attrition & Headcount Report";
}

<div class="container-fluid py-4 text-start">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-bold mb-1"><i class="fa-solid fa-users-slash text-primary me-2"></i>Attrition & Headcount</h4>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0 small">
                    <li class="breadcrumb-item"><a href="/HR" class="text-decoration-none">HR Dashboard</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Attrition & Headcount</li>
                </ol>
            </nav>
        </div>
    </div>

    <!-- Stats grid -->
    <div class="row g-4 mb-4">
        <div class="col-md-3">
            <div class="bg-white border rounded-3 p-3 shadow-sm">
                <div class="text-muted fw-semibold small">Current Headcount</div>
                <h4 class="fw-bold text-dark mt-2 mb-0">45 Employees</h4>
            </div>
        </div>
        <div class="col-md-3">
            <div class="bg-white border rounded-3 p-3 shadow-sm">
                <div class="text-muted fw-semibold small">New Hires (YTD)</div>
                <h4 class="fw-bold text-success mt-2 mb-0">12 Joined</h4>
            </div>
        </div>
        <div class="col-md-3">
            <div class="bg-white border rounded-3 p-3 shadow-sm">
                <div class="text-muted fw-semibold small">Exits (YTD)</div>
                <h4 class="fw-bold text-danger mt-2 mb-0">2 Separated</h4>
            </div>
        </div>
        <div class="col-md-3">
            <div class="bg-white border rounded-3 p-3 shadow-sm">
                <div class="text-muted fw-semibold small">Annual Attrition Rate</div>
                <h4 class="fw-bold text-primary mt-2 mb-0">4.2%</h4>
            </div>
        </div>
    </div>

    <!-- Details Table -->
    <div class="bg-white border rounded-3 p-4 shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" style="font-size: 0.85rem;">
                <thead class="table-light">
                    <tr>
                        <th>Department</th>
                        <th>Opening Headcount</th>
                        <th>Hired This Period</th>
                        <th>Exited This Period</th>
                        <th>Ending Headcount</th>
                        <th>Net Growth</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td class="fw-bold text-dark">Sales & Marketing</td>
                        <td>10</td>
                        <td>3</td>
                        <td>1</td>
                        <td>12</td>
                        <td><span class="text-success fw-bold">+2</span></td>
                    </tr>
                    <tr>
                        <td class="fw-bold text-dark">Human Resources</td>
                        <td>3</td>
                        <td>0</td>
                        <td>0</td>
                        <td>3</td>
                        <td><span>0</span></td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

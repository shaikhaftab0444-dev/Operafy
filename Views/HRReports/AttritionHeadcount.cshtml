@model ERP_System.Models.AttritionHeadcountReportViewModel
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Attrition & Headcount Report";
}

<style>
    .attrition-report-page {
        --page-primary: #2563eb;
        --page-primary-dark: #1d4ed8;
        --page-success: #16a34a;
        --page-danger: #dc2626;
        --page-warning: #d97706;
        --page-surface: #ffffff;
        --page-border: #e5e7eb;
        --page-text: #111827;
        --page-muted: #6b7280;
        --page-bg: #f8fafc;
        background: var(--page-bg);
        min-height: 100%;
    }

        /* =========================
           PAGE HEADER
        ========================= */
        .attrition-report-page .report-header {
            position: relative;
            overflow: hidden;
            padding: 1.5rem 1.75rem;
            border: 1px solid #dbeafe;
            border-radius: 22px;
            background: linear-gradient(135deg, #ffffff 0%, #f8fbff 55%, #eff6ff 100%);
            box-shadow: 0 10px 30px rgba(15, 23, 42, 0.05);
            animation: reportFadeDown .6s ease both;
        }

            .attrition-report-page .report-header::before {
                content: "";
                position: absolute;
                width: 230px;
                height: 230px;
                right: -85px;
                top: -120px;
                border-radius: 50%;
                background: radial-gradient(circle, rgba(37, 99, 235, .14), transparent 68%);
                pointer-events: none;
            }

            .attrition-report-page .report-header::after {
                content: "";
                position: absolute;
                width: 170px;
                height: 170px;
                right: 130px;
                bottom: -140px;
                border-radius: 50%;
                background: radial-gradient(circle, rgba(14, 165, 233, .10), transparent 70%);
                pointer-events: none;
            }

        .attrition-report-page .report-title-area,
        .attrition-report-page .header-actions {
            position: relative;
            z-index: 1;
        }

        .attrition-report-page .header-icon {
            width: 54px;
            height: 54px;
            min-width: 54px;
            border-radius: 17px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            background: linear-gradient(135deg, var(--page-primary), #60a5fa);
            color: #fff;
            font-size: 1.3rem;
            box-shadow: 0 10px 22px rgba(37, 99, 235, .22);
        }

        .attrition-report-page .report-kicker {
            display: inline-flex;
            align-items: center;
            gap: 7px;
            font-size: .72rem;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: .09em;
            color: var(--page-primary);
            margin-bottom: .25rem;
        }

        .attrition-report-page .report-title {
            color: var(--page-text);
            font-size: clamp(1.35rem, 2vw, 1.75rem);
            font-weight: 800;
            margin: 0;
            letter-spacing: -.03em;
        }

        .attrition-report-page .breadcrumb {
            margin-top: .45rem;
        }

        .attrition-report-page .breadcrumb-item,
        .attrition-report-page .breadcrumb-item a {
            font-size: .82rem;
        }

            .attrition-report-page .breadcrumb-item a {
                color: var(--page-primary);
                font-weight: 600;
            }

            .attrition-report-page .breadcrumb-item.active {
                color: var(--page-muted);
            }

        /* =========================
           BUTTONS
        ========================= */
        .attrition-report-page .report-btn {
            height: 38px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: .4rem;
            padding: 0 .9rem;
            border-radius: 12px;
            font-size: .78rem;
            font-weight: 700;
            transition: all .25s ease;
            white-space: nowrap;
        }

            .attrition-report-page .report-btn:hover {
                transform: translateY(-2px);
            }

        .attrition-report-page .export-btn {
            background: rgba(255, 255, 255, .85);
            border-color: var(--page-border);
            color: #475569;
        }

            .attrition-report-page .export-btn:hover {
                background: #fff;
                border-color: #cbd5e1;
                box-shadow: 0 8px 18px rgba(15, 23, 42, .08);
            }

        .attrition-report-page .print-btn {
            border: none;
            color: #fff;
            background: linear-gradient(135deg, var(--page-primary), var(--page-primary-dark));
            box-shadow: 0 8px 18px rgba(37, 99, 235, .20);
        }

            .attrition-report-page .print-btn:hover {
                color: #fff;
                box-shadow: 0 12px 25px rgba(37, 99, 235, .28);
            }

        /* =========================
           STAT CARDS
        ========================= */
        .attrition-report-page .stats-grid {
            margin-top: 1.35rem;
        }

        .attrition-report-page .metric-card {
            position: relative;
            height: 100%;
            overflow: hidden;
            padding: 1.2rem;
            background: var(--page-surface);
            border: 1px solid var(--page-border);
            border-radius: 20px;
            box-shadow: 0 8px 22px rgba(15, 23, 42, .035);
            transition: transform .3s ease, box-shadow .3s ease, border-color .3s ease;
            animation: reportFadeUp .6s ease both;
        }

            .attrition-report-page .metric-card:hover {
                transform: translateY(-5px);
                box-shadow: 0 16px 35px rgba(15, 23, 42, .09);
                border-color: #dbeafe;
            }

            .attrition-report-page .metric-card::after {
                content: "";
                position: absolute;
                width: 105px;
                height: 105px;
                right: -38px;
                bottom: -55px;
                border-radius: 50%;
                opacity: .7;
            }

            .attrition-report-page .metric-card.headcount::after {
                background: rgba(37, 99, 235, .08);
            }

            .attrition-report-page .metric-card.hires::after {
                background: rgba(22, 163, 74, .08);
            }

            .attrition-report-page .metric-card.exits::after {
                background: rgba(220, 38, 38, .07);
            }

            .attrition-report-page .metric-card.attrition::after {
                background: rgba(217, 119, 6, .08);
            }

            .attrition-report-page .metric-card:nth-child(1) {
                animation-delay: .05s;
            }

            .attrition-report-page .metric-card:nth-child(2) {
                animation-delay: .12s;
            }

            .attrition-report-page .metric-card:nth-child(3) {
                animation-delay: .19s;
            }

            .attrition-report-page .metric-card:nth-child(4) {
                animation-delay: .26s;
            }

        .attrition-report-page .metric-top {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            gap: .8rem;
            position: relative;
            z-index: 1;
        }

        .attrition-report-page .metric-label {
            color: var(--page-muted);
            font-size: .72rem;
            font-weight: 800;
            line-height: 1.45;
            text-transform: uppercase;
            letter-spacing: .045em;
        }

        .attrition-report-page .metric-icon {
            width: 42px;
            height: 42px;
            min-width: 42px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border-radius: 13px;
            font-size: 1rem;
        }

        .attrition-report-page .headcount .metric-icon {
            color: var(--page-primary);
            background: #eff6ff;
        }

        .attrition-report-page .hires .metric-icon {
            color: var(--page-success);
            background: #f0fdf4;
        }

        .attrition-report-page .exits .metric-icon {
            color: var(--page-danger);
            background: #fef2f2;
        }

        .attrition-report-page .attrition .metric-icon {
            color: var(--page-warning);
            background: #fffbeb;
        }

        .attrition-report-page .metric-value {
            position: relative;
            z-index: 1;
            margin: .8rem 0 .25rem;
            color: var(--page-text);
            font-size: clamp(1.35rem, 2vw, 1.7rem);
            font-weight: 800;
            letter-spacing: -.035em;
        }

            .attrition-report-page .metric-value.success {
                color: var(--page-success);
            }

            .attrition-report-page .metric-value.danger {
                color: var(--page-danger);
            }

            .attrition-report-page .metric-value.primary {
                color: var(--page-primary);
            }

        .attrition-report-page .metric-subtitle {
            position: relative;
            z-index: 1;
            color: #94a3b8;
            font-size: .75rem;
            font-weight: 600;
        }

        /* =========================
           FILTER CARD
        ========================= */
        .attrition-report-page .filter-card {
            padding: 1rem 1.2rem;
            background: #fff;
            border: 1px solid var(--page-border);
            border-radius: 19px;
            box-shadow: 0 8px 22px rgba(15, 23, 42, .035);
            animation: reportFadeUp .65s ease both;
            animation-delay: .15s;
        }

        .attrition-report-page .filter-title {
            color: var(--page-text);
            font-size: .88rem;
            font-weight: 800;
            margin: 0;
        }

            .attrition-report-page .filter-title i {
                color: var(--page-primary);
            }

        .attrition-report-page .filter-label {
            color: #64748b;
            font-size: .69rem;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: .05em;
            margin-bottom: .4rem;
        }

        .attrition-report-page .filter-select {
            min-height: 41px;
            border-radius: 11px;
            border-color: #e2e8f0;
            color: #334155;
            font-size: .82rem;
            font-weight: 600;
            box-shadow: none !important;
            transition: all .2s ease;
        }

            .attrition-report-page .filter-select:focus {
                border-color: #93c5fd;
                box-shadow: 0 0 0 .2rem rgba(37, 99, 235, .08) !important;
            }

        .attrition-report-page .filter-action-btn {
            height: 40px;
            border-radius: 11px;
            font-size: .78rem;
            font-weight: 700;
            transition: all .2s ease;
        }

            .attrition-report-page .filter-action-btn:hover {
                transform: translateY(-1px);
            }

        /* =========================
           REPORT PANELS
        ========================= */
        .attrition-report-page .report-panel {
            overflow: hidden;
            background: #fff;
            border: 1px solid var(--page-border);
            border-radius: 21px;
            box-shadow: 0 8px 24px rgba(15, 23, 42, .04);
            animation: reportFadeUp .7s ease both;
        }

        .attrition-report-page .panel-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 1rem;
            padding: 1.2rem 1.35rem;
            border-bottom: 1px solid #eef2f7;
            background: linear-gradient(180deg, #fff, #fcfdff);
        }

        .attrition-report-page .panel-heading {
            display: flex;
            align-items: center;
            gap: .75rem;
        }

        .attrition-report-page .panel-icon {
            width: 38px;
            height: 38px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border-radius: 12px;
            background: #eff6ff;
            color: var(--page-primary);
        }

            .attrition-report-page .panel-icon.danger {
                background: #fef2f2;
                color: var(--page-danger);
            }

        .attrition-report-page .panel-title {
            margin: 0;
            color: var(--page-text);
            font-size: .92rem;
            font-weight: 800;
        }

        .attrition-report-page .panel-subtitle {
            margin: .15rem 0 0;
            color: #94a3b8;
            font-size: .72rem;
            font-weight: 500;
        }

        .attrition-report-page .record-count {
            padding: .4rem .65rem;
            border-radius: 999px;
            color: #64748b;
            background: #f8fafc;
            border: 1px solid #e2e8f0;
            font-size: .7rem;
            font-weight: 700;
            white-space: nowrap;
        }

        /* =========================
           TABLES
        ========================= */
        .attrition-report-page .report-table {
            margin: 0;
            font-size: .82rem;
        }

            .attrition-report-page .report-table thead th {
                padding: .9rem 1rem;
                color: #64748b;
                background: #f8fafc;
                border-bottom: 1px solid #e5e7eb;
                font-size: .68rem;
                font-weight: 800;
                text-transform: uppercase;
                letter-spacing: .045em;
                white-space: nowrap;
            }

            .attrition-report-page .report-table tbody td {
                padding: 1rem;
                vertical-align: middle;
                color: #475569;
                border-color: #f1f5f9;
            }

            .attrition-report-page .report-table tbody tr {
                transition: background .2s ease, transform .2s ease;
            }

                .attrition-report-page .report-table tbody tr:hover {
                    background: #fafcff;
                }

        .attrition-report-page .department-cell {
            display: flex;
            align-items: center;
            gap: .75rem;
        }

        .attrition-report-page .department-avatar {
            width: 35px;
            height: 35px;
            min-width: 35px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border-radius: 11px;
            background: #eff6ff;
            color: var(--page-primary);
            font-size: .8rem;
            font-weight: 800;
        }

        .attrition-report-page .department-name {
            color: #1e293b;
            font-weight: 800;
        }

        .attrition-report-page .number-value {
            color: #334155;
            font-weight: 700;
        }

        .attrition-report-page .positive-value {
            color: var(--page-success);
            font-weight: 800;
        }

        .attrition-report-page .negative-value {
            color: var(--page-danger);
            font-weight: 800;
        }

        .attrition-report-page .ending-value {
            color: var(--page-text);
            font-size: .9rem;
            font-weight: 800;
        }

        .attrition-report-page .growth-badge,
        .attrition-report-page .status-badge {
            display: inline-flex;
            align-items: center;
            gap: .35rem;
            padding: .42rem .65rem;
            border-radius: 999px;
            font-size: .7rem;
            font-weight: 800;
            white-space: nowrap;
        }

        .attrition-report-page .growth-positive {
            color: #15803d;
            background: #f0fdf4;
            border: 1px solid #dcfce7;
        }

        .attrition-report-page .growth-negative {
            color: #b91c1c;
            background: #fef2f2;
            border: 1px solid #fee2e2;
        }

        .attrition-report-page .rate-cell {
            min-width: 135px;
        }

        .attrition-report-page .rate-value {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: .5rem;
            margin-bottom: .35rem;
            color: var(--page-primary);
            font-size: .75rem;
            font-weight: 800;
        }

        .attrition-report-page .rate-progress {
            height: 6px;
            overflow: hidden;
            border-radius: 999px;
            background: #eaf1ff;
        }

            .attrition-report-page .rate-progress .progress-bar {
                min-width: 3px;
                border-radius: inherit;
                background: linear-gradient(90deg, #60a5fa, var(--page-primary));
                animation: progressGrow 1.1s ease both;
            }

        /* =========================
           EXIT TABLE
        ========================= */
        .attrition-report-page .employee-info {
            display: flex;
            align-items: center;
            gap: .7rem;
        }

        .attrition-report-page .employee-avatar {
            width: 36px;
            height: 36px;
            min-width: 36px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border-radius: 50%;
            color: #fff;
            background: linear-gradient(135deg, #f97316, #ef4444);
            font-size: .72rem;
            font-weight: 800;
        }

        .attrition-report-page .employee-name {
            color: #1e293b;
            font-weight: 800;
        }

        .attrition-report-page .date-cell {
            white-space: nowrap;
            color: #475569;
            font-weight: 600;
        }

            .attrition-report-page .date-cell i {
                color: #94a3b8;
                margin-right: .35rem;
            }

        .attrition-report-page .status-success {
            color: #15803d;
            background: #f0fdf4;
            border: 1px solid #dcfce7;
        }

        .attrition-report-page .status-primary {
            color: #1d4ed8;
            background: #eff6ff;
            border: 1px solid #dbeafe;
        }

        .attrition-report-page .status-warning {
            color: #b45309;
            background: #fffbeb;
            border: 1px solid #fef3c7;
        }

        .attrition-report-page .empty-state {
            padding: 3rem 1rem !important;
            text-align: center;
            color: #94a3b8 !important;
        }

            .attrition-report-page .empty-state i {
                display: block;
                margin-bottom: .8rem;
                font-size: 2rem;
                color: #cbd5e1;
            }

    /* =========================
           ANIMATIONS
        ========================= */
    @@keyframes reportFadeDown {
        from {
            opacity: 0;
            transform: translateY(-18px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@keyframes reportFadeUp {
        from {
            opacity: 0;
            transform: translateY(18px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@keyframes progressGrow {
        from {
            width: 0 !important;
        }
    }

    /* =========================
           RESPONSIVE
        ========================= */
    @@media (max-width: 991.98px) {
        .attrition-report-page .report-header {
            padding: 1.3rem;
        }

        .attrition-report-page .header-actions {
            width: 100%;
        }

            .attrition-report-page .header-actions .report-btn {
                flex: 1;
            }

        .attrition-report-page .panel-header {
            align-items: flex-start;
        }
    }

    @@media (max-width: 767.98px) {
        .attrition-report-page {
            padding-left: .15rem;
            padding-right: .15rem;
        }

            .attrition-report-page .report-header {
                padding: 1.15rem;
                border-radius: 18px;
            }

            .attrition-report-page .report-title {
                font-size: 1.25rem;
            }

            .attrition-report-page .header-icon {
                width: 46px;
                height: 46px;
                min-width: 46px;
                border-radius: 14px;
            }

            .attrition-report-page .header-actions {
                flex-direction: column;
                align-items: stretch !important;
            }

                .attrition-report-page .header-actions .report-btn {
                    width: 100%;
                }

            .attrition-report-page .metric-card {
                padding: 1rem;
                border-radius: 17px;
            }

            .attrition-report-page .filter-card {
                padding: 1rem;
                border-radius: 17px;
            }

            .attrition-report-page .filter-actions {
                display: grid;
                grid-template-columns: 1fr 1fr;
                gap: .5rem;
            }

                .attrition-report-page .filter-actions .btn {
                    width: 100%;
                }

            .attrition-report-page .report-panel {
                border-radius: 18px;
            }

            .attrition-report-page .panel-header {
                padding: 1rem;
            }

            .attrition-report-page .report-table {
                font-size: .78rem;
            }

                .attrition-report-page .report-table thead th,
                .attrition-report-page .report-table tbody td {
                    padding: .8rem .75rem;
                }
    }

    @@media (max-width: 575.98px) {
        .attrition-report-page .report-kicker {
            font-size: .65rem;
        }

        .attrition-report-page .metric-value {
            font-size: 1.4rem;
        }

        .attrition-report-page .panel-header {
            flex-direction: column;
        }

        .attrition-report-page .record-count {
            align-self: flex-start;
        }
    }

    /* =========================
           PRINT
        ========================= */
    @@media print {
        .attrition-report-page .header-actions,
        .attrition-report-page .filter-card {
            display: none !important;
        }

        .attrition-report-page,
        .attrition-report-page .report-header,
        .attrition-report-page .metric-card,
        .attrition-report-page .report-panel {
            box-shadow: none !important;
            background: #fff !important;
        }

            .attrition-report-page .report-header {
                border-color: #ddd;
            }

            .attrition-report-page .report-panel {
                break-inside: avoid;
            }
    }
</style>

<div class="container-fluid py-4 text-start attrition-report-page">

    <!-- =========================
         HEADER
    ========================= -->
    <div class="report-header mb-4">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-4">
            <div class="report-title-area d-flex align-items-center gap-3">
                <div class="header-icon">
                    <i class="fa-solid fa-users-slash"></i>
                </div>

                <div>
                    <div class="report-kicker">
                        <i class="fa-solid fa-chart-line"></i>
                        Workforce Analytics
                    </div>

                    <h4 class="report-title">Attrition & Headcount Report</h4>

                    <nav aria-label="breadcrumb">
                        <ol class="breadcrumb mb-0">
                            <li class="breadcrumb-item">
                                <a href="/HR" class="text-decoration-none">HR Dashboard</a>
                            </li>
                            <li class="breadcrumb-item active" aria-current="page">
                                Attrition & Headcount
                            </li>
                        </ol>
                    </nav>
                </div>
            </div>

            <div class="header-actions d-flex align-items-center gap-2">
                <a href="/HRReports/ExportAttritionHeadcount?format=csv&year=@Model.SelectedYear&departmentId=@Model.SelectedDepartmentId"
                   class="btn export-btn report-btn" download>
                    <i class="fa-solid fa-file-csv text-success"></i>
                    Export CSV
                </a>

                <a href="/HRReports/ExportAttritionHeadcount?format=excel&year=@Model.SelectedYear&departmentId=@Model.SelectedDepartmentId"
                   class="btn export-btn report-btn" download>
                    <i class="fa-solid fa-file-excel text-primary"></i>
                    Export Excel
                </a>

                <button type="button"
                        onclick="window.print()"
                        class="btn print-btn report-btn">
                    <i class="fa-solid fa-print"></i>
                    Print Report
                </button>
            </div>
        </div>
    </div>

    <!-- =========================
         SUMMARY METRICS
    ========================= -->
    <div class="row g-3 stats-grid mb-4">

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="metric-card headcount">
                <div class="metric-top">
                    <div class="metric-label">
                        Current Active<br />Headcount
                    </div>

                    <div class="metric-icon">
                        <i class="fa-solid fa-users"></i>
                    </div>
                </div>

                <div class="metric-value">
                    @Model.CurrentHeadcount
                </div>

                <div class="metric-subtitle">
                    Active employees in the organization
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="metric-card hires">
                <div class="metric-top">
                    <div class="metric-label">
                        New Hires<br />(YTD @Model.SelectedYear)
                    </div>

                    <div class="metric-icon">
                        <i class="fa-solid fa-user-plus"></i>
                    </div>
                </div>

                <div class="metric-value success">
                    +@Model.NewHiresYTD
                </div>

                <div class="metric-subtitle">
                    Employees joined during this year
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="metric-card exits">
                <div class="metric-top">
                    <div class="metric-label">
                        Employee Exits<br />(YTD)
                    </div>

                    <div class="metric-icon">
                        <i class="fa-solid fa-user-minus"></i>
                    </div>
                </div>

                <div class="metric-value danger">
                    -@Model.ExitsYTD
                </div>

                <div class="metric-subtitle">
                    Recorded employee separations
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="metric-card attrition">
                <div class="metric-top">
                    <div class="metric-label">
                        Annual<br />Attrition Rate
                    </div>

                    <div class="metric-icon">
                        <i class="fa-solid fa-arrow-trend-down"></i>
                    </div>
                </div>

                <div class="metric-value primary">
                    @Model.AnnualAttritionRatePct%
                </div>

                <div class="metric-subtitle">
                    Overall workforce attrition rate
                </div>
            </div>
        </div>

    </div>

    <!-- =========================
         FILTER SECTION
    ========================= -->
    <div class="filter-card mb-4">
        <div class="d-flex align-items-center gap-2 mb-3">
            <h6 class="filter-title">
                <i class="fa-solid fa-sliders me-1"></i>
                Report Filters
            </h6>
        </div>

        <form method="get"
              action="/HRReports/AttritionHeadcount"
              class="row g-3 align-items-end">

            <div class="col-12 col-md-5">
                <label class="filter-label">
                    <i class="fa-solid fa-building me-1"></i>
                    Department
                </label>

                <select name="departmentId"
                        class="form-select filter-select"
                        onchange="this.form.submit()">
                    <option value="">All Departments</option>

                    @foreach (var d in Model.Departments)
                    {
                        <option value="@d.DepartmentId"
                                selected="@(Model.SelectedDepartmentId == d.DepartmentId ? "selected" : null)">
                            @d.DepartmentName
                        </option>
                    }
                </select>
            </div>

            <div class="col-12 col-md-4">
                <label class="filter-label">
                    <i class="fa-solid fa-calendar me-1"></i>
                    Reporting Year
                </label>

                <select name="year"
                        class="form-select filter-select"
                        onchange="this.form.submit()">
                    <option value="2026"
                            selected="@(Model.SelectedYear == 2026 ? "selected" : null)">
                        Reporting Year 2026
                    </option>

                    <option value="2025"
                            selected="@(Model.SelectedYear == 2025 ? "selected" : null)">
                        Reporting Year 2025
                    </option>
                </select>
            </div>

            <div class="col-12 col-md-3">
                <div class="filter-actions d-flex justify-content-md-end gap-2">
                    <button type="submit"
                            class="btn btn-primary filter-action-btn px-3">
                        <i class="fa-solid fa-filter me-1"></i>
                        Apply
                    </button>

                    <a href="/HRReports/AttritionHeadcount"
                       class="btn btn-outline-secondary filter-action-btn px-3">
                        <i class="fa-solid fa-rotate-left me-1"></i>
                        Reset
                    </a>
                </div>
            </div>

        </form>
    </div>

    <!-- =========================
         DEPARTMENT HEADCOUNT
    ========================= -->
    <div class="report-panel mb-4">
        <div class="panel-header">
            <div class="panel-heading">
                <div class="panel-icon">
                    <i class="fa-solid fa-sitemap"></i>
                </div>

                <div>
                    <h6 class="panel-title">
                        Department-wise Headcount & Net Growth
                    </h6>

                    <p class="panel-subtitle">
                        Compare opening workforce, new hires, exits and departmental growth.
                    </p>
                </div>
            </div>

            <div class="record-count">
                <i class="fa-solid fa-layer-group me-1"></i>
                @(Model.DepartmentSummaries?.Count ?? 0) Departments
            </div>
        </div>

        <div class="table-responsive">
            <table class="table report-table align-middle">
                <thead>
                    <tr>
                        <th>Department</th>
                        <th>Opening Headcount</th>
                        <th>Hired (YTD)</th>
                        <th>Exited (YTD)</th>
                        <th>Ending Headcount</th>
                        <th>Net Growth</th>
                        <th>Dept Attrition Rate</th>
                    </tr>
                </thead>

                <tbody>
                    @if (Model.DepartmentSummaries != null && Model.DepartmentSummaries.Any())
                    {
                        foreach (var dept in Model.DepartmentSummaries)
                        {
                            var attritionRate = Math.Min(Math.Max((double)dept.AttritionRatePct, 0), 100);

                            <tr>
                                <td>
                                    <div class="department-cell">
                                        <div class="department-avatar">
                                            <i class="fa-solid fa-building"></i>
                                        </div>

                                        <div class="department-name">
                                            @dept.DepartmentName
                                        </div>
                                    </div>
                                </td>

                                <td>
                                    <span class="number-value">
                                        @dept.OpeningHeadcount
                                    </span>
                                </td>

                                <td>
                                    <span class="positive-value">
                                        <i class="fa-solid fa-arrow-up me-1 small"></i>
                                        +@dept.NewHiresCount
                                    </span>
                                </td>

                                <td>
                                    <span class="negative-value">
                                        <i class="fa-solid fa-arrow-down me-1 small"></i>
                                        -@dept.ExitsCount
                                    </span>
                                </td>

                                <td>
                                    <span class="ending-value">
                                        @dept.EndingHeadcount
                                    </span>
                                </td>

                                <td>
                                    @if (dept.NetGrowth >= 0)
                                    {
                                        <span class="growth-badge growth-positive">
                                            <i class="fa-solid fa-arrow-trend-up"></i>
                                            +@dept.NetGrowth
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="growth-badge growth-negative">
                                            <i class="fa-solid fa-arrow-trend-down"></i>
                                            @dept.NetGrowth
                                        </span>
                                    }
                                </td>

                                <td class="rate-cell">
                                    <div class="rate-value">
                                        <span>Attrition</span>
                                        <span>@dept.AttritionRatePct%</span>
                                    </div>

                                    <div class="progress rate-progress">
                                        <div class="progress-bar"
                                             role="progressbar"
                                             style="width: @attritionRate%;"
                                             aria-valuenow="@attritionRate"
                                             aria-valuemin="0"
                                             aria-valuemax="100">
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="empty-state">
                                <i class="fa-solid fa-chart-column"></i>
                                No department headcount records found.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- =========================
         EXIT & SEPARATION LOG
    ========================= -->
    <div class="report-panel">
        <div class="panel-header">
            <div class="panel-heading">
                <div class="panel-icon danger">
                    <i class="fa-solid fa-user-minus"></i>
                </div>

                <div>
                    <h6 class="panel-title">
                        Employee Exit & Separation Log
                    </h6>

                    <p class="panel-subtitle">
                        Track employee separation dates and final clearance progress.
                    </p>
                </div>
            </div>

            <div class="record-count">
                <i class="fa-solid fa-file-lines me-1"></i>
                @(Model.ExitRecords?.Count ?? 0) Exit Records
            </div>
        </div>

        <div class="table-responsive">
            <table class="table report-table align-middle">
                <thead>
                    <tr>
                        <th>Employee Name</th>
                        <th>Resignation Date</th>
                        <th>Last Working Day</th>
                        <th>Asset Clearance</th>
                        <th>IT Clearance</th>
                        <th>Exit Interview</th>
                        <th>F&F Settlement Status</th>
                    </tr>
                </thead>

                <tbody>
                    @if (Model.ExitRecords != null && Model.ExitRecords.Any())
                    {
                        foreach (var exit in Model.ExitRecords)
                        {
                            var employeeInitial = !string.IsNullOrWhiteSpace(exit.EmployeeName)
                            ? exit.EmployeeName.Trim().Substring(0, 1).ToUpper()
                            : "E";

                            <tr>
                                <td>
                                    <div class="employee-info">
                                        <div class="employee-avatar">
                                            @employeeInitial
                                        </div>

                                        <div>
                                            <div class="employee-name">
                                                @exit.EmployeeName
                                            </div>

                                            <small class="text-muted">
                                                Former employee record
                                            </small>
                                        </div>
                                    </div>
                                </td>

                                <td class="date-cell">
                                    <i class="fa-regular fa-calendar"></i>
                                    @exit.ResignationDate.ToString("dd MMM yyyy")
                                </td>

                                <td class="date-cell">
                                    <i class="fa-solid fa-calendar-check"></i>
                                    @exit.LastWorkingDay.ToString("dd MMM yyyy")
                                </td>

                                <td>
                                    <span class="status-badge status-success">
                                        <i class="fa-solid fa-box-open"></i>
                                        @exit.AssetReturn
                                    </span>
                                </td>

                                <td>
                                    <span class="status-badge status-success">
                                        <i class="fa-solid fa-laptop"></i>
                                        @exit.ITClearance
                                    </span>
                                </td>

                                <td>
                                    <span class="status-badge status-primary">
                                        <i class="fa-solid fa-comments"></i>
                                        @exit.ExitInterview
                                    </span>
                                </td>

                                <td>
                                    <span class="status-badge status-warning">
                                        <i class="fa-solid fa-file-invoice-dollar"></i>
                                        @exit.FfStatus
                                    </span>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="empty-state">
                                <i class="fa-solid fa-user-xmark"></i>
                                No Exit / Separation records found.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

</div>
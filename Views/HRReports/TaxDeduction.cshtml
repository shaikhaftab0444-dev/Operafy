@model ERP_System.Models.TaxDeductionReportViewModel
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Statutory Tax Deduction Report";
}

<style>
    /* =========================================
           STATUTORY TAX DEDUCTION REPORT
        ========================================== */
    .tax-report-page {
        --tax-primary: #2563eb;
        --tax-primary-dark: #1d4ed8;
        --tax-primary-soft: #eff6ff;
        --tax-success: #059669;
        --tax-success-soft: #ecfdf5;
        --tax-danger: #dc2626;
        --tax-danger-soft: #fef2f2;
        --tax-warning: #d97706;
        --tax-dark: #0f172a;
        --tax-text: #475569;
        --tax-border: #e2e8f0;
        --tax-muted: #94a3b8;
    }

        .tax-report-page * {
            box-sizing: border-box;
        }

    /* ---------- PAGE HEADER ---------- */
    .tax-report-hero {
        position: relative;
        overflow: hidden;
        padding: 1.6rem 1.75rem;
        margin-bottom: 1.5rem;
        border: 1px solid #dbeafe;
        border-radius: 1.25rem;
        background: linear-gradient(135deg, #ffffff 0%, #f8fbff 52%, #eff6ff 100%);
        box-shadow: 0 10px 35px rgba(15, 23, 42, 0.06);
        animation: taxFadeUp .65s ease both;
    }

        .tax-report-hero::before {
            content: "";
            position: absolute;
            width: 260px;
            height: 260px;
            top: -150px;
            right: -70px;
            border-radius: 50%;
            background: rgba(37, 99, 235, 0.07);
            pointer-events: none;
        }

        .tax-report-hero::after {
            content: "";
            position: absolute;
            width: 160px;
            height: 160px;
            bottom: -110px;
            right: 170px;
            border-radius: 50%;
            background: rgba(5, 150, 105, 0.06);
            pointer-events: none;
        }

    .tax-header-content,
    .tax-header-actions {
        position: relative;
        z-index: 2;
    }

    .tax-title-area {
        display: flex;
        align-items: center;
        gap: 1rem;
    }

    .tax-title-icon {
        width: 52px;
        height: 52px;
        flex: 0 0 52px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 16px;
        color: #fff;
        font-size: 1.25rem;
        background: linear-gradient(135deg, var(--tax-primary), #60a5fa);
        box-shadow: 0 10px 22px rgba(37, 99, 235, 0.22);
        animation: taxIconFloat 3.5s ease-in-out infinite;
    }

    .tax-page-title {
        margin: 0 0 .28rem;
        color: var(--tax-dark);
        font-size: 1.32rem;
        font-weight: 800;
        letter-spacing: -.025em;
    }

    .tax-page-subtitle {
        margin: 0;
        color: var(--tax-text);
        font-size: .83rem;
    }

    .tax-breadcrumb {
        margin: .5rem 0 0;
        font-size: .75rem;
    }

        .tax-breadcrumb .breadcrumb-item + .breadcrumb-item::before {
            color: #94a3b8;
        }

        .tax-breadcrumb a {
            color: var(--tax-primary);
            font-weight: 600;
            text-decoration: none;
        }

        .tax-breadcrumb .active {
            color: #64748b;
        }

    /* ---------- BUTTONS ---------- */
    .tax-action-btn {
        min-height: 36px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: .45rem;
        padding: .48rem .85rem;
        border-radius: 10px;
        font-size: .76rem;
        font-weight: 700;
        transition: all .25s ease;
        white-space: nowrap;
    }

        .tax-action-btn:hover {
            transform: translateY(-2px);
        }

    .tax-export-btn {
        color: #475569;
        background: rgba(255,255,255,.9);
        border: 1px solid var(--tax-border);
    }

        .tax-export-btn:hover {
            color: var(--tax-primary);
            border-color: #bfdbfe;
            background: #fff;
            box-shadow: 0 7px 18px rgba(15, 23, 42, .08);
        }

    .tax-print-btn {
        color: #fff;
        border: 1px solid var(--tax-primary);
        background: linear-gradient(135deg, var(--tax-primary), var(--tax-primary-dark));
        box-shadow: 0 8px 20px rgba(37, 99, 235, .20);
    }

        .tax-print-btn:hover {
            color: #fff;
            box-shadow: 0 12px 25px rgba(37, 99, 235, .28);
        }

    /* ---------- METRIC CARDS ---------- */
    .tax-metric-card {
        position: relative;
        min-height: 145px;
        overflow: hidden;
        padding: 1.2rem;
        border: 1px solid var(--tax-border);
        border-radius: 1.1rem;
        background: #fff;
        box-shadow: 0 8px 24px rgba(15, 23, 42, .045);
        transition: transform .28s ease, box-shadow .28s ease, border-color .28s ease;
        animation: taxFadeUp .65s ease both;
    }

        .tax-metric-card:hover {
            transform: translateY(-6px);
            border-color: #bfdbfe;
            box-shadow: 0 18px 35px rgba(15, 23, 42, .10);
        }

        .tax-metric-card::after {
            content: "";
            position: absolute;
            width: 110px;
            height: 110px;
            top: -55px;
            right: -40px;
            border-radius: 50%;
            background: currentColor;
            opacity: .035;
        }

    .tax-card-1 {
        color: var(--tax-primary);
        animation-delay: .05s;
    }

    .tax-card-2 {
        color: #2563eb;
        animation-delay: .12s;
    }

    .tax-card-3 {
        color: var(--tax-success);
        animation-delay: .19s;
    }

    .tax-card-4 {
        color: var(--tax-danger);
        animation-delay: .26s;
    }

    .tax-metric-top {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: .8rem;
    }

    .tax-metric-label {
        margin-bottom: .42rem;
        color: var(--tax-text);
        font-size: .72rem;
        font-weight: 700;
        line-height: 1.4;
    }

    .tax-metric-value {
        margin: 0;
        color: var(--tax-dark);
        font-size: 1.35rem;
        font-weight: 800;
        line-height: 1.2;
        letter-spacing: -.025em;
    }

    .tax-metric-card.tax-card-2 .tax-metric-value {
        color: var(--tax-primary);
    }

    .tax-metric-card.tax-card-3 .tax-metric-value {
        color: var(--tax-success);
    }

    .tax-metric-card.tax-card-4 .tax-metric-value {
        color: var(--tax-danger);
    }

    .tax-metric-icon {
        width: 43px;
        height: 43px;
        flex: 0 0 43px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 13px;
        font-size: 1rem;
        color: currentColor;
        background: currentColor;
        position: relative;
    }

        .tax-metric-icon i {
            position: relative;
            z-index: 1;
        }

    .tax-card-1 .tax-metric-icon {
        background: var(--tax-primary-soft);
    }

    .tax-card-2 .tax-metric-icon {
        background: #eff6ff;
    }

    .tax-card-3 .tax-metric-icon {
        background: var(--tax-success-soft);
    }

    .tax-card-4 .tax-metric-icon {
        background: var(--tax-danger-soft);
    }

    /* ---------- FILTER PANEL ---------- */
    .tax-filter-panel {
        padding: 1.15rem;
        margin-bottom: 1.5rem;
        border: 1px solid var(--tax-border);
        border-radius: 1.1rem;
        background: #fff;
        box-shadow: 0 8px 24px rgba(15, 23, 42, .045);
        animation: taxFadeUp .7s ease .2s both;
    }

    .tax-filter-heading {
        display: flex;
        align-items: center;
        gap: .55rem;
        margin-bottom: 1rem;
        color: var(--tax-dark);
        font-size: .86rem;
        font-weight: 800;
    }

        .tax-filter-heading span {
            width: 29px;
            height: 29px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border-radius: 9px;
            color: var(--tax-primary);
            background: var(--tax-primary-soft);
        }

    .tax-search-box {
        display: flex;
        align-items: center;
        height: 40px;
        border: 1px solid var(--tax-border);
        border-radius: 10px;
        overflow: hidden;
        background: #fff;
        transition: all .25s ease;
    }

        .tax-search-box:focus-within {
            border-color: #93c5fd;
            box-shadow: 0 0 0 .22rem rgba(37, 99, 235, .10);
        }

    .tax-search-icon {
        padding-left: .9rem;
        color: #94a3b8;
    }

    .tax-search-box input {
        height: 100%;
        border: 0 !important;
        outline: 0;
        box-shadow: none !important;
        padding-left: .65rem;
        font-size: .8rem;
    }

    .tax-filter-select {
        height: 40px;
        border-color: var(--tax-border);
        border-radius: 10px;
        font-size: .8rem;
        color: #475569;
        transition: all .25s ease;
    }

        .tax-filter-select:focus {
            border-color: #93c5fd;
            box-shadow: 0 0 0 .22rem rgba(37, 99, 235, .10);
        }

    .tax-filter-btn {
        min-height: 40px;
        border-radius: 10px;
        font-size: .78rem;
        font-weight: 700;
        transition: all .25s ease;
    }

        .tax-filter-btn:hover {
            transform: translateY(-1px);
        }

    .tax-reset-btn {
        min-height: 40px;
        border-radius: 10px;
        font-size: .78rem;
        font-weight: 700;
    }

    /* ---------- REPORT TABLE ---------- */
    .tax-table-card {
        overflow: hidden;
        border: 1px solid var(--tax-border);
        border-radius: 1.15rem;
        background: #fff;
        box-shadow: 0 8px 24px rgba(15, 23, 42, .05);
        animation: taxFadeUp .75s ease .3s both;
    }

    .tax-table-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        padding: 1.1rem 1.25rem;
        border-bottom: 1px solid var(--tax-border);
        background: linear-gradient(135deg, #ffffff, #f8fafc);
    }

    .tax-table-title {
        display: flex;
        align-items: center;
        gap: .7rem;
    }

    .tax-table-title-icon {
        width: 38px;
        height: 38px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 11px;
        color: var(--tax-primary);
        background: var(--tax-primary-soft);
    }

    .tax-table-title h6 {
        margin: 0 0 .12rem;
        color: var(--tax-dark);
        font-size: .9rem;
        font-weight: 800;
    }

    .tax-table-title p {
        margin: 0;
        color: var(--tax-muted);
        font-size: .72rem;
    }

    .tax-table-scroll {
        scrollbar-width: thin;
        scrollbar-color: #cbd5e1 transparent;
    }

    .tax-table {
        min-width: 1100px;
        margin: 0;
        font-size: .79rem;
    }

        .tax-table thead th {
            padding: .95rem .9rem;
            border: 0;
            color: #475569;
            background: #f8fafc;
            font-size: .67rem;
            font-weight: 800;
            letter-spacing: .025em;
            text-transform: uppercase;
            white-space: nowrap;
        }

        .tax-table tbody td {
            padding: 1rem .9rem;
            color: #475569;
            border-color: #f1f5f9;
            vertical-align: middle;
            transition: background .2s ease;
        }

        .tax-table tbody tr {
            transition: transform .2s ease, box-shadow .2s ease;
        }

            .tax-table tbody tr:hover td {
                background: #fafcff;
            }

            .tax-table tbody tr:hover {
                box-shadow: inset 3px 0 0 var(--tax-primary);
            }

    .tax-employee-cell {
        min-width: 175px;
    }

    .tax-employee-name {
        margin-bottom: .22rem;
        color: var(--tax-dark);
        font-weight: 750;
    }

    .tax-employee-code {
        display: flex;
        align-items: center;
        gap: .35rem;
        color: var(--tax-muted);
        font-size: .69rem;
    }

        .tax-employee-code i {
            color: var(--tax-primary);
        }

    .tax-pan {
        display: inline-block;
        padding: .35rem .5rem;
        border-radius: 7px;
        color: #334155;
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        font-size: .72rem;
        font-weight: 700;
        letter-spacing: .02em;
    }

    .tax-regime-badge {
        display: inline-flex;
        align-items: center;
        gap: .35rem;
        padding: .38rem .62rem;
        border: 1px solid #dbeafe;
        border-radius: 999px;
        color: #1d4ed8;
        background: #eff6ff;
        font-size: .68rem;
        font-weight: 750;
        white-space: nowrap;
    }

    .tax-amount {
        color: #334155;
        font-weight: 650;
        white-space: nowrap;
    }

    .tax-amount-primary {
        color: var(--tax-primary);
        font-weight: 800;
        white-space: nowrap;
    }

    .tax-amount-success {
        color: var(--tax-success);
        font-weight: 750;
        white-space: nowrap;
    }

    .tax-amount-danger {
        display: inline-flex;
        align-items: center;
        padding: .38rem .6rem;
        border-radius: 8px;
        color: var(--tax-danger);
        background: var(--tax-danger-soft);
        font-weight: 800;
        white-space: nowrap;
    }

    /* ---------- EMPTY STATE ---------- */
    .tax-empty-state {
        padding: 4.5rem 1rem !important;
        text-align: center;
    }

    .tax-empty-icon {
        width: 66px;
        height: 66px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 1rem;
        border-radius: 50%;
        color: #94a3b8;
        background: #f8fafc;
        font-size: 1.5rem;
    }

    .tax-empty-title {
        margin-bottom: .35rem;
        color: #334155;
        font-weight: 750;
    }

    .tax-empty-text {
        margin: 0;
        color: #94a3b8;
        font-size: .8rem;
    }

    /* ---------- ANIMATIONS ---------- */
    @@keyframes taxFadeUp {
        from {
            opacity: 0;
            transform: translateY(18px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@keyframes taxIconFloat {
        0%, 100% {
            transform: translateY(0);
        }

        50% {
            transform: translateY(-5px);
        }
    }

    /* ---------- RESPONSIVE ---------- */
    @@media (max-width: 991.98px) {
        .tax-report-hero {
            padding: 1.35rem;
        }

        .tax-header-actions {
            width: 100%;
            justify-content: flex-start;
        }

        .tax-metric-card {
            min-height: 125px;
        }
    }

    @@media (max-width: 767.98px) {
        .tax-report-page {
            padding-top: 1rem !important;
            padding-bottom: 1.5rem !important;
        }

        .tax-report-hero {
            padding: 1.2rem;
            border-radius: 1rem;
        }

        .tax-title-area {
            align-items: flex-start;
        }

        .tax-title-icon {
            width: 46px;
            height: 46px;
            flex-basis: 46px;
            border-radius: 14px;
        }

        .tax-page-title {
            font-size: 1.08rem;
        }

        .tax-page-subtitle {
            font-size: .76rem;
        }

        .tax-header-actions {
            display: grid !important;
            grid-template-columns: 1fr 1fr;
            gap: .55rem !important;
        }

        .tax-action-btn:last-child {
            grid-column: 1 / -1;
        }

        .tax-action-btn {
            width: 100%;
        }

        .tax-filter-panel {
            padding: 1rem;
        }

        .tax-table-header {
            padding: 1rem;
        }

        .tax-table-title p {
            display: none;
        }

        .tax-metric-value {
            font-size: 1.2rem;
        }
    }

    @@media (max-width: 575.98px) {
        .tax-header-actions {
            grid-template-columns: 1fr;
        }

        .tax-action-btn:last-child {
            grid-column: auto;
        }

        .tax-title-icon {
            width: 42px;
            height: 42px;
            flex-basis: 42px;
            font-size: 1rem;
        }

        .tax-page-title {
            font-size: 1rem;
        }

        .tax-metric-card {
            padding: 1rem;
        }

        .tax-metric-label {
            font-size: .68rem;
        }

        .tax-table-card {
            border-radius: 1rem;
        }
    }

    /* ---------- PRINT ---------- */
    @@media print {
        .tax-header-actions,
        .tax-filter-panel {
            display: none !important;
        }

        .tax-report-hero,
        .tax-metric-card,
        .tax-table-card {
            box-shadow: none !important;
        }

        .tax-report-page {
            padding: 0 !important;
        }
    }
</style>

<div class="container-fluid py-4 text-start tax-report-page">

    <!-- ================= HEADER ================= -->
    <div class="tax-report-hero">
        <div class="row align-items-center g-3">
            <div class="col-lg-7 tax-header-content">
                <div class="tax-title-area">
                    <div class="tax-title-icon">
                        <i class="fa-solid fa-building-columns"></i>
                    </div>

                    <div>
                        <h4 class="tax-page-title">Statutory Tax Deduction Report</h4>
                        <p class="tax-page-subtitle">
                            Monitor employee TDS, professional tax, provident fund and statutory payroll deductions.
                        </p>

                        <nav aria-label="breadcrumb">
                            <ol class="breadcrumb tax-breadcrumb">
                                <li class="breadcrumb-item">
                                    <a href="/HR">
                                        <i class="fa-solid fa-house me-1"></i>HR Dashboard
                                    </a>
                                </li>
                                <li class="breadcrumb-item active" aria-current="page">
                                    Tax Deduction Report
                                </li>
                            </ol>
                        </nav>
                    </div>
                </div>
            </div>

            <div class="col-lg-5">
                <div class="d-flex justify-content-lg-end align-items-center gap-2 flex-wrap tax-header-actions">
                    <a href="/HRReports/ExportTaxDeduction?format=csv&payPeriod=@Model.SelectedPayPeriod&departmentId=@Model.SelectedDepartmentId"
                       class="tax-action-btn tax-export-btn text-decoration-none" download>
                        <i class="fa-solid fa-file-csv text-primary"></i>
                        <span>Export CSV</span>
                    </a>

                    <a href="/HRReports/ExportTaxDeduction?format=excel&payPeriod=@Model.SelectedPayPeriod&departmentId=@Model.SelectedDepartmentId"
                       class="tax-action-btn tax-export-btn text-decoration-none" download>
                        <i class="fa-solid fa-file-excel text-success"></i>
                        <span>Export Excel</span>
                    </a>

                    <button type="button"
                            onclick="window.print()"
                            class="tax-action-btn tax-print-btn">
                        <i class="fa-solid fa-print"></i>
                        <span>Print Report</span>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- ================= SUMMARY CARDS ================= -->
    <div class="row g-3 g-lg-4 mb-4">

        <div class="col-sm-6 col-xl-3">
            <div class="tax-metric-card tax-card-1">
                <div class="tax-metric-top">
                    <div>
                        <div class="tax-metric-label">Total Employees Taxed</div>
                        <h4 class="tax-metric-value">@Model.TotalEmployeesTaxed Staff</h4>
                    </div>

                    <div class="tax-metric-icon">
                        <i class="fa-solid fa-users"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-xl-3">
            <div class="tax-metric-card tax-card-2">
                <div class="tax-metric-top">
                    <div>
                        <div class="tax-metric-label">Total Monthly TDS</div>
                        <h4 class="tax-metric-value">₹@Model.TotalTDS.ToString("N0")</h4>
                    </div>

                    <div class="tax-metric-icon">
                        <i class="fa-solid fa-receipt"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-xl-3">
            <div class="tax-metric-card tax-card-3">
                <div class="tax-metric-top">
                    <div>
                        <div class="tax-metric-label">Total Provident Fund (PF)</div>
                        <h4 class="tax-metric-value">₹@Model.TotalEmployeePF.ToString("N0")</h4>
                    </div>

                    <div class="tax-metric-icon">
                        <i class="fa-solid fa-shield-heart"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-xl-3">
            <div class="tax-metric-card tax-card-4">
                <div class="tax-metric-top">
                    <div>
                        <div class="tax-metric-label">Total Statutory Deductions</div>
                        <h4 class="tax-metric-value">₹@Model.TotalDeductions.ToString("N0")</h4>
                    </div>

                    <div class="tax-metric-icon">
                        <i class="fa-solid fa-file-invoice-dollar"></i>
                    </div>
                </div>
            </div>
        </div>

    </div>

    <!-- ================= FILTERS ================= -->
    <div class="tax-filter-panel">
        <div class="tax-filter-heading">
            <span><i class="fa-solid fa-sliders"></i></span>
            <div>Report Filters</div>
        </div>

        <form method="get"
              action="/HRReports/TaxDeduction"
              class="row g-3 align-items-end">

            <div class="col-md-6 col-xl-4">
                <label class="form-label small fw-semibold text-secondary mb-2">
                    Search Employee
                </label>

                <div class="tax-search-box">
                    <span class="tax-search-icon">
                        <i class="fa-solid fa-magnifying-glass"></i>
                    </span>

                    <input type="text"
                           name="search"
                           class="form-control"
                           placeholder="Search name, employee code or PAN..."
                           value="@Model.SearchTerm" />
                </div>
            </div>

            <div class="col-md-6 col-xl-3">
                <label class="form-label small fw-semibold text-secondary mb-2">
                    Pay Period
                </label>

                <select name="payPeriod"
                        class="form-select tax-filter-select"
                        onchange="this.form.submit()">

                    <option value="August 2026" selected="@(Model.SelectedPayPeriod == "August 2026" ? "selected" : null)">
                        August 2026
                    </option>

                    <option value="July 2026" selected="@(Model.SelectedPayPeriod == "July 2026" ? "selected" : null)">
                        July 2026
                    </option>

                    <option value="June 2026" selected="@(Model.SelectedPayPeriod == "June 2026" ? "selected" : null)">
                        June 2026
                    </option>
                </select>
            </div>

            <div class="col-md-6 col-xl-3">
                <label class="form-label small fw-semibold text-secondary mb-2">
                    Department
                </label>

                <select name="departmentId"
                        class="form-select tax-filter-select"
                        onchange="this.form.submit()">

                    <option value="">All Departments</option>

                    @foreach (var d in Model.Departments)
                    {
                        <option value="@d.DepartmentId"
                                selected="@(Model.SelectedDepartmentId == d.DepartmentId ? "selected" : null)">
                            @d.DepartmentName
                        </option>
                    }
                </select>
            </div>

            <div class="col-md-6 col-xl-2">
                <div class="d-flex gap-2">
                    <button type="submit"
                            class="btn btn-primary tax-filter-btn flex-fill">
                        <i class="fa-solid fa-filter me-1"></i>Filter
                    </button>

                    <a href="/HRReports/TaxDeduction"
                       class="btn btn-outline-secondary tax-reset-btn flex-fill d-flex align-items-center justify-content-center text-decoration-none">
                        <i class="fa-solid fa-rotate-left me-1"></i>Reset
                    </a>
                </div>
            </div>

        </form>
    </div>

    <!-- ================= TAX REPORT TABLE ================= -->
    <div class="tax-table-card">

        <div class="tax-table-header">
            <div class="tax-table-title">
                <div class="tax-table-title-icon">
                    <i class="fa-solid fa-table-list"></i>
                </div>

                <div>
                    <h6>Employee Tax & Statutory Deductions</h6>
                    <p>Detailed payroll tax deduction records for the selected reporting period.</p>
                </div>
            </div>
        </div>

        <div class="table-responsive tax-table-scroll">
            <table class="table table-hover align-middle tax-table">

                <thead>
                    <tr>
                        <th>Employee</th>
                        <th>PAN Number</th>
                        <th>Tax Regime</th>
                        <th>Gross Taxable Salary</th>
                        <th>TDS Deducted</th>
                        <th>Professional Tax</th>
                        <th>Employee PF (12%)</th>
                        <th>Employer PF (12%)</th>
                        <th>Total Deducted</th>
                    </tr>
                </thead>

                <tbody>
                    @if (Model.TaxItems != null && Model.TaxItems.Any())
                    {
                        foreach (var item in Model.TaxItems)
                        {
                            <tr>
                                <td class="tax-employee-cell">
                                    <div class="tax-employee-name">
                                        @item.EmployeeName
                                    </div>

                                    <div class="tax-employee-code">
                                        <i class="fa-solid fa-id-badge"></i>
                                        @item.EmployeeCode
                                    </div>
                                </td>

                                <td>
                                    <span class="tax-pan">
                                        @item.PanNumber
                                    </span>
                                </td>

                                <td>
                                    <span class="tax-regime-badge">
                                        <i class="fa-solid fa-scale-balanced"></i>
                                        @item.TaxRegime
                                    </span>
                                </td>

                                <td>
                                    <span class="tax-amount">
                                        ₹@item.GrossSalary.ToString("N0")
                                    </span>
                                </td>

                                <td>
                                    <span class="tax-amount-primary">
                                        ₹@item.MonthlyTDS.ToString("N0")
                                    </span>
                                </td>

                                <td>
                                    <span class="tax-amount">
                                        ₹@item.ProfessionalTax.ToString("N0")
                                    </span>
                                </td>

                                <td>
                                    <span class="tax-amount-success">
                                        ₹@item.EmployeePF.ToString("N0")
                                    </span>
                                </td>

                                <td>
                                    <span class="tax-amount-success">
                                        ₹@item.EmployerPF.ToString("N0")
                                    </span>
                                </td>

                                <td>
                                    <span class="tax-amount-danger">
                                        ₹@item.TotalStatutoryDeduction.ToString("N0")
                                    </span>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="9" class="tax-empty-state">
                                <div class="tax-empty-icon">
                                    <i class="fa-solid fa-building-columns"></i>
                                </div>

                                <div class="tax-empty-title">
                                    No tax deduction records found
                                </div>

                                <p class="tax-empty-text">
                                    No employee tax records match the selected filters and reporting period.
                                </p>
                            </td>
                        </tr>
                    }
                </tbody>

            </table>
        </div>
    </div>

</div>
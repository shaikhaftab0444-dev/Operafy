@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Statutory Tax Deduction Report";
}

<div class="container-fluid py-4 text-start">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-bold mb-1"><i class="fa-solid fa-building-columns text-primary me-2"></i>Statutory Tax Deduction Report</h4>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0 small">
                    <li class="breadcrumb-item"><a href="/HR" class="text-decoration-none">HR Dashboard</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Tax Deduction Report</li>
                </ol>
            </nav>
        </div>
    </div>

    <!-- Tax Report Table -->
    <div class="bg-white border rounded-3 p-4 shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" style="font-size: 0.85rem;">
                <thead class="table-light">
                    <tr>
                        <th>Employee</th>
                        <th>PAN Number</th>
                        <th>Tax Regime</th>
                        <th>TDS Deducted (Monthly)</th>
                        <th>Professional Tax (PT)</th>
                        <th>Employer PF Deducted</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td class="fw-bold text-dark">Numan Sales Man</td>
                        <td>AAAAA1234A</td>
                        <td>New Regime</td>
                        <td>₹12,500</td>
                        <td>₹200</td>
                        <td>₹1,800</td>
                    </tr>
                    <tr>
                        <td class="fw-bold text-dark">Aftab Shaik</td>
                        <td>BBBBB5678B</td>
                        <td>New Regime</td>
                        <td>₹4,500</td>
                        <td>₹200</td>
                        <td>₹1,800</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

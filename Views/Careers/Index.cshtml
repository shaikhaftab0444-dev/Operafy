@model IEnumerable<ERP_System.Models.JobOpening>
@{
    Layout = null;
    var company = ViewBag.Company as ERP_System.Models.Company ?? new ERP_System.Models.Company();
    var departments = ViewBag.Departments as List<ERP_System.Models.Department> ?? new List<ERP_System.Models.Department>();
    var totalOpenings = Model?.Count() ?? 0;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Careers & Opportunities | @(company.CompanyName)</title>

    <!-- Bootstrap 5 CSS & FontAwesome -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

    <style>
        :root {
            --primary: #4f46e5;
            --primary-hover: #4338ca;
            --primary-light: #eef2ff;
            --dark: #0f172a;
            --muted: #64748b;
            --border: #e2e8f0;
            --bg-light: #f8fafc;
        }

        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background-color: var(--bg-light);
            color: #1e293b;
            line-height: 1.6;
        }

        .navbar-careers {
            background: #ffffff;
            border-bottom: 1px solid var(--border);
            padding: 1rem 0;
        }

        .hero-section {
            background: linear-gradient(135deg, #0f172a 0%, #1e1b4b 50%, #312e81 100%);
            color: #ffffff;
            padding: 4.5rem 0 4rem;
            position: relative;
            overflow: hidden;
        }

        .hero-section::before {
            content: "";
            position: absolute;
            width: 400px;
            height: 400px;
            right: -100px;
            top: -100px;
            border-radius: 50%;
            background: rgba(99, 102, 241, 0.15);
            filter: blur(80px);
        }

        .search-container {
            background: #ffffff;
            border-radius: 16px;
            padding: 1.5rem;
            box-shadow: 0 10px 30px rgba(0,0,0,0.06);
            margin-top: -2.5rem;
            position: relative;
            z-index: 10;
            border: 1px solid var(--border);
        }

        .job-card {
            background: #ffffff;
            border: 1px solid var(--border);
            border-radius: 16px;
            padding: 1.5rem;
            margin-bottom: 1.25rem;
            transition: all 0.25s ease;
            position: relative;
        }

        .job-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 12px 25px rgba(0,0,0,0.07);
            border-color: #cbd5e1;
        }

        .badge-tag {
            font-size: 0.75rem;
            font-weight: 600;
            padding: 0.4rem 0.75rem;
            border-radius: 8px;
            display: inline-flex;
            align-items: center;
            gap: 0.35rem;
        }

        .badge-dept { background: #eff6ff; color: #1d4ed8; }
        .badge-mode { background: #f5f3ff; color: #6d28d9; }
        .badge-exp { background: #ecfdf5; color: #047857; }
        .badge-salary { background: #fffbeb; color: #b45309; }

        .btn-apply-portal {
            background: var(--primary);
            color: #ffffff;
            font-weight: 700;
            border-radius: 10px;
            padding: 0.6rem 1.4rem;
            border: none;
            transition: all 0.2s;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 0.4rem;
        }

        .btn-apply-portal:hover {
            background: var(--primary-hover);
            color: #ffffff;
            transform: translateY(-1px);
        }

        .footer-careers {
            background: #ffffff;
            border-top: 1px solid var(--border);
            padding: 2.5rem 0;
            margin-top: 4rem;
            color: var(--muted);
            font-size: 0.875rem;
        }
    </style>
</head>
<body>

    <!-- NAVBAR -->
    <nav class="navbar navbar-expand-lg navbar-careers sticky-top">
        <div class="container">
            <a class="navbar-brand fw-bold text-dark d-flex align-items-center gap-2" href="/Careers">
                <div class="rounded-3 bg-primary text-white d-flex align-items-center justify-content-center" style="width: 38px; height: 38px;">
                    <i class="fa-solid fa-briefcase"></i>
                </div>
                <div>
                    <span class="fs-5 fw-bold text-dark">@(company.CompanyName)</span>
                    <span class="d-block text-muted" style="font-size: 0.68rem; letter-spacing: 0.5px;">CAREERS & TALENT</span>
                </div>
            </a>
            <div class="ms-auto d-flex align-items-center gap-3">
                <a href="/Account/Login" class="btn btn-outline-secondary btn-sm rounded-pill px-3 fw-semibold">
                    <i class="fa-solid fa-arrow-right-to-bracket me-1"></i> Staff Sign In
                </a>
            </div>
        </div>
    </nav>

    <!-- HERO SECTION -->
    <section class="hero-section text-center">
        <div class="container position-relative">
            <span class="badge bg-white bg-opacity-10 text-white rounded-pill px-3 py-2 mb-3 fs-6 border border-white border-opacity-10">
                <i class="fa-solid fa-sparkles me-1 text-warning"></i> We're Hiring Exceptional Talent
            </span>
            <h1 class="display-5 fw-extrabold mb-3">Join Our Growing Team</h1>
            <p class="lead text-white-50 mx-auto" style="max-width: 650px;">
                Discover rewarding career paths, collaborate with visionary teams, and build the future of next-generation enterprise technology.
            </p>
        </div>
    </section>

    <!-- MAIN CONTENT & SEARCH -->
    <div class="container mb-5">

        <!-- SEARCH FILTERS -->
        <div class="search-container mb-4">
            <form method="get" action="/Careers" class="row g-3 align-items-end">
                <div class="col-lg-5 col-md-12">
                    <label class="form-label small fw-bold text-muted mb-1">Search Openings</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0"><i class="fa-solid fa-magnifying-glass text-muted"></i></span>
                        <input type="text" name="search" class="form-control bg-light border-start-0" placeholder="Job title, skills, or location..." value="@ViewBag.Search" />
                    </div>
                </div>

                <div class="col-lg-3 col-md-6">
                    <label class="form-label small fw-bold text-muted mb-1">Department</label>
                    <select name="departmentId" class="form-select bg-light" onchange="this.form.submit()">
                        <option value="">All Departments</option>
                        @foreach (var d in departments)
                        {
                            <option value="@d.DepartmentId" selected="@(ViewBag.SelectedDepartmentId == d.DepartmentId)">@d.DepartmentName</option>
                        }
                    </select>
                </div>

                <div class="col-lg-2 col-md-6">
                    <label class="form-label small fw-bold text-muted mb-1">Work Mode</label>
                    <select name="workMode" class="form-select bg-light" onchange="this.form.submit()">
                        <option value="All">All Modes</option>
                        <option value="On-site" selected="@(ViewBag.SelectedWorkMode == "On-site")">On-site</option>
                        <option value="Remote" selected="@(ViewBag.SelectedWorkMode == "Remote")">Remote</option>
                        <option value="Hybrid" selected="@(ViewBag.SelectedWorkMode == "Hybrid")">Hybrid</option>
                    </select>
                </div>

                <div class="col-lg-2 col-md-12">
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary w-100 fw-bold py-2">
                            <i class="fa-solid fa-filter me-1"></i> Filter
                        </button>
                        <a href="/Careers" class="btn btn-outline-secondary py-2" title="Reset Filters">
                            <i class="fa-solid fa-rotate-left"></i>
                        </a>
                    </div>
                </div>
            </form>
        </div>

        <!-- OPENINGS LIST -->
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h5 class="fw-bold text-dark m-0">
                <i class="fa-solid fa-briefcase text-primary me-2"></i>Available Positions (@totalOpenings)
            </h5>
            <span class="text-muted small">Updated live from Operafy ATS</span>
        </div>

        @if (Model == null || !Model.Any())
        {
            <div class="text-center py-5 bg-white rounded-4 border p-4">
                <div class="rounded-circle bg-light d-inline-flex align-items-center justify-content-center p-4 mb-3" style="width: 80px; height: 80px;">
                    <i class="fa-solid fa-folder-open text-muted fs-2"></i>
                </div>
                <h5 class="fw-bold text-dark">No Positions Matching Your Filter</h5>
                <p class="text-muted small mb-3">Try clearing search keywords or selecting a different department.</p>
                <a href="/Careers" class="btn btn-outline-primary btn-sm rounded-pill px-4">View All Openings</a>
            </div>
        }
        else
        {
            <div class="row">
                @foreach (var job in Model)
                {
                    <div class="col-12">
                        <div class="job-card">
                            <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3">
                                <div>
                                    <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                                        <h5 class="fw-bold text-dark m-0">@job.JobTitle</h5>
                                        <span class="badge bg-secondary-subtle text-secondary font-monospace small px-2">@job.JobCode</span>
                                    </div>

                                    <div class="d-flex flex-wrap gap-2 mb-3">
                                        @if (job.Department != null)
                                        {
                                            <span class="badge-tag badge-dept"><i class="fa-solid fa-building"></i> @job.Department.DepartmentName</span>
                                        }
                                        <span class="badge-tag badge-mode"><i class="fa-solid fa-laptop-house"></i> @job.WorkMode</span>
                                        <span class="badge-tag badge-exp"><i class="fa-solid fa-user-clock"></i> @job.ExperienceRequired</span>
                                        <span class="badge-tag badge-exp"><i class="fa-solid fa-location-dot"></i> @job.JobLocation</span>

                                        @if (job.MinimumSalary > 0 || job.MaximumSalary > 0)
                                        {
                                            <span class="badge-tag badge-salary">
                                                <i class="fa-solid fa-indian-rupee-sign"></i> ₹@job.MinimumSalary.ToString("N0") - ₹@job.MaximumSalary.ToString("N0") / Yr
                                            </span>
                                        }
                                    </div>

                                    @if (!string.IsNullOrWhiteSpace(job.JobDescription))
                                    {
                                        <p class="text-muted small mb-2 text-truncate" style="max-width: 800px;">
                                            @job.JobDescription
                                        </p>
                                    }

                                    @if (!string.IsNullOrWhiteSpace(job.RequiredSkills))
                                    {
                                        <div class="d-flex flex-wrap gap-1 align-items-center">
                                            <span class="text-muted extra-small me-1" style="font-size: 0.72rem;">Required Skills:</span>
                                            @foreach (var skill in job.RequiredSkills.Split(new[] { ',', ';' }, StringSplitOptions.RemoveEmptyEntries).Take(5))
                                            {
                                                <span class="badge bg-light text-dark border small">@skill.Trim()</span>
                                            }
                                        </div>
                                    }
                                </div>

                                <div class="d-flex flex-row flex-md-column gap-2 w-100 w-md-auto align-items-end justify-content-between justify-content-md-start">
                                    <div class="text-muted small text-end d-none d-md-block" style="font-size: 0.75rem;">
                                        Posted: @job.PostingDate.ToString("dd MMM yyyy")
                                    </div>
                                    <a href="/Careers/Apply/@job.JobId" class="btn-apply-portal text-nowrap">
                                        Apply Now <i class="fa-solid fa-arrow-right ms-1"></i>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>

    <!-- FOOTER -->
    <footer class="footer-careers">
        <div class="container text-center">
            <p class="mb-1 fw-semibold text-dark">@(company.CompanyName) &bull; Talent & Careers Portal</p>
            <p class="small text-muted mb-0">&copy; @DateTime.UtcNow.Year All rights reserved. Equal Opportunity Employer.</p>
        </div>
    </footer>

    <!-- Bootstrap Bundle JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>

@model ERP_System.Models.JobOpening
@{
    Layout = null;
    var company = ViewBag.Company as ERP_System.Models.Company ?? new ERP_System.Models.Company();
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Apply for @Model.JobTitle | @(company.CompanyName)</title>

    <!-- Bootstrap 5 CSS & FontAwesome -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

    <style>
        :root {
            --primary: #4f46e5;
            --primary-hover: #4338ca;
            --primary-light: #eef2ff;
            --dark: #0f172a;
            --muted: #64748b;
            --border: #e2e8f0;
            --bg-light: #f8fafc;
        }

        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background-color: var(--bg-light);
            color: #1e293b;
            line-height: 1.6;
        }

        .navbar-careers {
            background: #ffffff;
            border-bottom: 1px solid var(--border);
            padding: 1rem 0;
        }

        .apply-header-card {
            background: #ffffff;
            border: 1px solid var(--border);
            border-radius: 18px;
            padding: 2rem;
            margin-top: 2rem;
            margin-bottom: 1.5rem;
            box-shadow: 0 4px 18px rgba(0,0,0,0.03);
        }

        .apply-form-card {
            background: #ffffff;
            border: 1px solid var(--border);
            border-radius: 18px;
            padding: 2rem;
            box-shadow: 0 4px 18px rgba(0,0,0,0.03);
        }

        .job-detail-box {
            background: #ffffff;
            border: 1px solid var(--border);
            border-radius: 18px;
            padding: 1.75rem;
            margin-bottom: 1.5rem;
        }

        .badge-tag {
            font-size: 0.75rem;
            font-weight: 600;
            padding: 0.4rem 0.75rem;
            border-radius: 8px;
            display: inline-flex;
            align-items: center;
            gap: 0.35rem;
        }

        .badge-dept { background: #eff6ff; color: #1d4ed8; }
        .badge-mode { background: #f5f3ff; color: #6d28d9; }
        .badge-exp { background: #ecfdf5; color: #047857; }
        .badge-salary { background: #fffbeb; color: #b45309; }

        .form-label {
            font-size: 0.825rem;
            font-weight: 700;
            color: #334155;
            margin-bottom: 0.4rem;
        }

        .form-control, .form-select {
            border-radius: 10px;
            padding: 0.65rem 0.9rem;
            font-size: 0.875rem;
            border-color: #cbd5e1;
        }

        .form-control:focus, .form-select:focus {
            border-color: var(--primary);
            box-shadow: 0 0 0 3px rgba(79, 70, 229, 0.12);
        }

        .resume-upload-zone {
            border: 2px dashed #cbd5e1;
            border-radius: 14px;
            padding: 2rem;
            text-align: center;
            background: #f8fafc;
            cursor: pointer;
            transition: all 0.2s;
        }

        .resume-upload-zone:hover {
            border-color: var(--primary);
            background: #f1f5f9;
        }

        .btn-submit-app {
            background: linear-gradient(135deg, #4f46e5, #4338ca);
            color: #ffffff;
            font-weight: 800;
            border-radius: 12px;
            padding: 0.85rem 2rem;
            border: none;
            width: 100%;
            font-size: 1rem;
            box-shadow: 0 10px 20px rgba(79, 70, 229, 0.25);
            transition: all 0.25s;
        }

        .btn-submit-app:hover {
            transform: translateY(-2px);
            box-shadow: 0 14px 25px rgba(79, 70, 229, 0.35);
            color: #ffffff;
        }

        .footer-careers {
            background: #ffffff;
            border-top: 1px solid var(--border);
            padding: 2.5rem 0;
            margin-top: 4rem;
            color: var(--muted);
            font-size: 0.875rem;
        }
    </style>
</head>
<body>

    <!-- NAVBAR -->
    <nav class="navbar navbar-expand-lg navbar-careers sticky-top">
        <div class="container">
            <a class="navbar-brand fw-bold text-dark d-flex align-items-center gap-2" href="/Careers">
                <div class="rounded-3 bg-primary text-white d-flex align-items-center justify-content-center" style="width: 38px; height: 38px;">
                    <i class="fa-solid fa-briefcase"></i>
                </div>
                <div>
                    <span class="fs-5 fw-bold text-dark">@(company.CompanyName)</span>
                    <span class="d-block text-muted" style="font-size: 0.68rem; letter-spacing: 0.5px;">CAREERS & TALENT</span>
                </div>
            </a>
            <div class="ms-auto">
                <a href="/Careers" class="btn btn-outline-secondary btn-sm rounded-pill px-3 fw-semibold">
                    <i class="fa-solid fa-arrow-left me-1"></i> Back to Openings
                </a>
            </div>
        </div>
    </nav>

    <!-- CONTENT -->
    <div class="container mb-5">

        <!-- HEADER SUMMARY -->
        <div class="apply-header-card">
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3">
                <div>
                    <div class="d-flex align-items-center gap-2 mb-2">
                        <a href="/Careers" class="text-decoration-none text-muted small"><i class="fa-solid fa-chevron-left me-1"></i> All Jobs</a>
                        <span class="text-muted small">&bull;</span>
                        <span class="badge bg-secondary-subtle text-secondary font-monospace">@Model.JobCode</span>
                    </div>
                    <h2 class="fw-extrabold text-dark m-0">@Model.JobTitle</h2>
                    <div class="d-flex flex-wrap gap-2 mt-3">
                        @if (Model.Department != null)
                        {
                            <span class="badge-tag badge-dept"><i class="fa-solid fa-building"></i> @Model.Department.DepartmentName</span>
                        }
                        <span class="badge-tag badge-mode"><i class="fa-solid fa-laptop-house"></i> @Model.WorkMode</span>
                        <span class="badge-tag badge-exp"><i class="fa-solid fa-user-clock"></i> @Model.ExperienceRequired</span>
                        <span class="badge-tag badge-exp"><i class="fa-solid fa-location-dot"></i> @Model.JobLocation</span>
                        <span class="badge-tag badge-exp"><i class="fa-solid fa-user-plus"></i> @Model.Vacancies Open Vacanc@(Model.Vacancies == 1 ? "y" : "ies")</span>
                        @if (Model.MinimumSalary > 0 || Model.MaximumSalary > 0)
                        {
                            <span class="badge-tag badge-salary">
                                <i class="fa-solid fa-indian-rupee-sign"></i> ₹@Model.MinimumSalary.ToString("N0") - ₹@Model.MaximumSalary.ToString("N0") / Yr
                            </span>
                        }
                    </div>
                </div>

                <div class="text-end d-none d-md-block">
                    <span class="badge bg-success-subtle text-success px-3 py-2 rounded-pill fw-bold">
                        <i class="fa-solid fa-circle-check me-1"></i> Actively Recruiting
                    </span>
                    <div class="text-muted small mt-2">Posted on @Model.PostingDate.ToString("dd MMMM yyyy")</div>
                </div>
            </div>
        </div>

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show rounded-3 border-0 shadow-sm mb-4" role="alert">
                <i class="fa-solid fa-triangle-exclamation me-2"></i> @TempData["ErrorMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <div class="row g-4">
            <!-- LEFT COLUMN: JOB DESCRIPTION -->
            <div class="col-lg-5 col-md-12">
                <div class="job-detail-box">
                    <h5 class="fw-bold text-dark mb-3"><i class="fa-solid fa-align-left text-primary me-2"></i>Job Description</h5>
                    <div class="text-secondary small lh-lg mb-4 whitespace-pre-line" style="white-space: pre-line;">
                        @(string.IsNullOrWhiteSpace(Model.JobDescription) ? "We are looking for an exceptional professional to join our dynamic team and drive key operational milestones." : Model.JobDescription)
                    </div>

                    @if (!string.IsNullOrWhiteSpace(Model.Responsibilities))
                    {
                        <h6 class="fw-bold text-dark mb-2"><i class="fa-solid fa-list-check text-primary me-2"></i>Key Responsibilities</h6>
                        <div class="text-secondary small lh-lg mb-4" style="white-space: pre-line;">
                            @Model.Responsibilities
                        </div>
                    }

                    @if (!string.IsNullOrWhiteSpace(Model.Requirements))
                    {
                        <h6 class="fw-bold text-dark mb-2"><i class="fa-solid fa-check-double text-primary me-2"></i>Requirements & Qualifications</h6>
                        <div class="text-secondary small lh-lg mb-4" style="white-space: pre-line;">
                            @Model.Requirements
                        </div>
                    }

                    @if (!string.IsNullOrWhiteSpace(Model.RequiredSkills))
                    {
                        <h6 class="fw-bold text-dark mb-2"><i class="fa-solid fa-tags text-primary me-2"></i>Key Skills</h6>
                        <div class="d-flex flex-wrap gap-1 mb-3">
                            @foreach (var s in Model.RequiredSkills.Split(new[] { ',', ';' }, StringSplitOptions.RemoveEmptyEntries))
                            {
                                <span class="badge bg-light text-dark border small p-2">@s.Trim()</span>
                            }
                        </div>
                    }
                </div>
            </div>

            <!-- RIGHT COLUMN: APPLICATION FORM -->
            <div class="col-lg-7 col-md-12">
                <div class="apply-form-card">
                    <div class="d-flex align-items-center justify-content-between pb-3 mb-4 border-bottom">
                        <div>
                            <h4 class="fw-bold text-dark m-0">Submit Your Application</h4>
                            <p class="text-muted small m-0">Complete the form below and attach your resume.</p>
                        </div>
                        <div class="rounded-3 bg-primary-subtle text-primary p-2">
                            <i class="fa-solid fa-paper-plane fs-4"></i>
                        </div>
                    </div>

                    <form method="post" action="/Careers/SubmitApplication" enctype="multipart/form-data">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="jobOpeningId" value="@Model.JobId" />

                        <!-- Full Name -->
                        <div class="mb-3">
                            <label class="form-label">Full Name <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light"><i class="fa-solid fa-user text-muted"></i></span>
                                <input type="text" name="candidateName" class="form-control" placeholder="e.g. John Doe" required />
                            </div>
                        </div>

                        <!-- Email & Phone -->
                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label class="form-label">Email Address <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light"><i class="fa-solid fa-envelope text-muted"></i></span>
                                    <input type="email" name="email" class="form-control" placeholder="john.doe@example.com" required />
                                </div>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Phone / Mobile Number <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light"><i class="fa-solid fa-phone text-muted"></i></span>
                                    <input type="tel" name="phone" class="form-control" placeholder="+91 98765 43210" required />
                                </div>
                            </div>
                        </div>

                        <!-- Experience & Notice Period -->
                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label class="form-label">Total Work Experience <span class="text-danger">*</span></label>
                                <select name="experience" class="form-select" required>
                                    <option value="Fresher / Entry Level">Fresher / Entry Level</option>
                                    <option value="1-2 Years">1-2 Years</option>
                                    <option value="3-5 Years" selected>3-5 Years</option>
                                    <option value="6-8 Years">6-8 Years</option>
                                    <option value="9+ Years">9+ Years</option>
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Notice Period</label>
                                <select name="noticePeriod" class="form-select">
                                    <option value="Immediate">Immediate / 0 Days</option>
                                    <option value="15 Days">15 Days</option>
                                    <option value="30 Days" selected>30 Days</option>
                                    <option value="60 Days">60 Days</option>
                                    <option value="90 Days">90 Days</option>
                                </select>
                            </div>
                        </div>

                        <!-- Current Company & Expected CTC -->
                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label class="form-label">Current / Most Recent Company</label>
                                <input type="text" name="currentCompany" class="form-control" placeholder="e.g. Acme Technologies" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Expected Annual CTC (₹)</label>
                                <input type="number" step="1000" name="expectedSalary" class="form-control" placeholder="e.g. 850000" />
                            </div>
                        </div>

                        <!-- Professional Links -->
                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label class="form-label">LinkedIn Profile URL</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light"><i class="fa-brands fa-linkedin text-muted"></i></span>
                                    <input type="url" name="linkedIn" class="form-control" placeholder="https://linkedin.com/in/..." />
                                </div>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Portfolio / GitHub / Website</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light"><i class="fa-solid fa-globe text-muted"></i></span>
                                    <input type="url" name="portfolio" class="form-control" placeholder="https://github.com/..." />
                                </div>
                            </div>
                        </div>

                        <!-- Resume Upload -->
                        <div class="mb-4">
                            <label class="form-label">Attach Resume / CV <span class="text-danger">*</span> (PDF, DOC, DOCX up to 10MB)</label>
                            <div class="resume-upload-zone" onclick="document.getElementById('resumeFileInput').click();">
                                <i class="fa-solid fa-cloud-arrow-up text-primary fs-2 mb-2"></i>
                                <h6 class="fw-bold text-dark mb-1">Click or drag & drop your resume file here</h6>
                                <p class="text-muted extra-small mb-2" id="fileNameDisplay">Supports .pdf, .doc, .docx formats</p>
                                <span class="btn btn-outline-primary btn-sm rounded-pill px-3">Browse File</span>
                                <input type="file" id="resumeFileInput" name="resume" class="d-none" accept=".pdf,.doc,.docx,.rtf" required onchange="displayFileName(this);" />
                            </div>
                        </div>

                        <button type="submit" class="btn btn-submit-app">
                            <i class="fa-solid fa-paper-plane me-2"></i> Submit Job Application
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- FOOTER -->
    <footer class="footer-careers">
        <div class="container text-center">
            <p class="mb-1 fw-semibold text-dark">@(company.CompanyName) &bull; Talent & Careers Portal</p>
            <p class="small text-muted mb-0">&copy; @DateTime.UtcNow.Year All rights reserved. Equal Opportunity Employer.</p>
        </div>
    </footer>

    <!-- Bootstrap Bundle JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        function displayFileName(input) {
            if (input.files && input.files.length > 0) {
                const file = input.files[0];
                document.getElementById('fileNameDisplay').innerHTML = `
                    <span class="badge bg-success-subtle text-success p-2 fs-6">
                        <i class="fa-solid fa-file-check me-1"></i> ${file.name} (${(file.size / 1024 / 1024).toFixed(2)} MB)
                    </span>
                `;
            }
        }
    </script>
</body>
</html>

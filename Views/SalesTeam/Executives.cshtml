@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Sales Executives";
}

<div class="container-fluid py-4 text-start">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-bold mb-1"><i class="fa-solid fa-user-tag text-primary me-2"></i>Sales Executives</h4>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0 small">
                    <li class="breadcrumb-item"><a href="/SalesDashboard" class="text-decoration-none">Sales Management</a></li>
                    <li class="breadcrumb-item">Sales Team</li>
                    <li class="breadcrumb-item active" aria-current="page">Executives</li>
                </ol>
            </nav>
        </div>
        <button class="btn btn-primary rounded-pill px-3 shadow-sm"><i class="fa-solid fa-plus me-1.5"></i>Add Executive</button>
    </div>

    <!-- Executives Cards -->
    <div class="row g-4 mb-4">
        <div class="col-md-3">
            <div class="bg-white border rounded-3 p-3 shadow-sm">
                <div class="text-muted fw-semibold small">Active Executives</div>
                <h3 class="fw-bold text-dark mb-0 mt-1">12</h3>
            </div>
        </div>
        <div class="col-md-3">
            <div class="bg-white border rounded-3 p-3 shadow-sm">
                <div class="text-muted fw-semibold small">Month's Leader</div>
                <h3 class="fw-bold text-success mb-0 mt-1">Amit Verma</h3>
            </div>
        </div>
        <div class="col-md-3">
            <div class="bg-white border rounded-3 p-3 shadow-sm">
                <div class="text-muted fw-semibold small">Avg. Sales/Exec</div>
                <h3 class="fw-bold text-primary mb-0 mt-1">₹8,50,000</h3>
            </div>
        </div>
        <div class="col-md-3">
            <div class="bg-white border rounded-3 p-3 shadow-sm">
                <div class="text-muted fw-semibold small">Target Achievement</div>
                <h3 class="fw-bold text-warning mb-0 mt-1">87%</h3>
            </div>
        </div>
    </div>

    <!-- Grid Table -->
    <div class="bg-white border rounded-3 p-4 shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" style="font-size: 0.85rem;">
                <thead class="table-light">
                    <tr>
                        <th>Exec ID</th>
                        <th>Name</th>
                        <th>Mobile</th>
                        <th>Region</th>
                        <th>Month Sales</th>
                        <th>Target (Month)</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td class="fw-bold text-dark">EX-104</td>
                        <td>Amit Verma</td>
                        <td>+91 98765 43210</td>
                        <td>North India</td>
                        <td class="fw-bold">₹12,45,000</td>
                        <td>₹15,00,000</td>
                        <td><span class="badge bg-success-subtle text-success rounded-pill px-2.5 py-1">Active</span></td>
                    </tr>
                    <tr>
                        <td class="fw-bold text-dark">EX-105</td>
                        <td>Neha Sharma</td>
                        <td>+91 98765 43211</td>
                        <td>West India</td>
                        <td class="fw-bold">₹10,50,000</td>
                        <td>₹12,00,000</td>
                        <td><span class="badge bg-success-subtle text-success rounded-pill px-2.5 py-1">Active</span></td>
                    </tr>
                    <tr>
                        <td class="fw-bold text-dark">EX-106</td>
                        <td>Rohan Das</td>
                        <td>+91 98765 43212</td>
                        <td>South India</td>
                        <td class="fw-bold">₹8,20,000</td>
                        <td>₹10,00,000</td>
                        <td><span class="badge bg-success-subtle text-success rounded-pill px-2.5 py-1">Active</span></td>
                    </tr>
                    <tr>
                        <td class="fw-bold text-dark">EX-107</td>
                        <td>Priya Nair</td>
                        <td>+91 98765 43213</td>
                        <td>East India</td>
                        <td class="fw-bold">₹4,80,000</td>
                        <td>₹8,00,000</td>
                        <td><span class="badge bg-warning-subtle text-warning rounded-pill px-2.5 py-1">On Leave</span></td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

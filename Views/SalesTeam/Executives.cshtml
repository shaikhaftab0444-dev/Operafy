<!-- =========================================================
     MODAL: REASSIGN LEADS
     ========================================================= -->
<div class="modal fade sales-modal"
     id="reassignLeadsModal"
     tabindex="-1"
     aria-labelledby="reassignLeadsModalLabel"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content">

            <form asp-action="ReassignLeads"
                  method="post">

                @Html.AntiForgeryToken()

                <input type="hidden"
                       id="reassignSourceUserId"
                       name="sourceUserId"
                       value="" />

                <div class="modal-header">

                    <div class="sales-modal-header">

                        <span class="sales-modal-icon warning">
                            <i class="fa-solid fa-arrow-right-arrow-left"></i>
                        </span>

                        <h5 class="modal-title"
                            id="reassignLeadsModalLabel">
                            Reassign Customer Leads
                        </h5>

                    </div>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal"
                            aria-label="Close"></button>

                </div>

                <div class="modal-body text-start">

                    <div class="sales-info-alert">
                        <i class="fa-solid fa-circle-info"></i>

                        <span>
                            Transfer active pipeline opportunities when an executive goes on leave or transitions territories.
                        </span>
                    </div>

                    <!-- Current Owner -->
                    <div class="sales-form-group">

                        <label class="sales-form-label">
                            Transfer Leads From (Current Owner)
                        </label>

                        <input type="text"
                               id="reassignSourceUserName"
                               class="sales-form-control fw-bold"
                               style="background:#f8fafc;"
                               readonly />

                    </div>

                    <!-- New Owner -->
                    <div class="sales-form-group">

                        <label class="sales-form-label">
                            Transfer Leads To (New Owner)
                            <span class="text-danger">*</span>
                        </label>

                        <select name="targetUserId"
                                class="sales-form-select fw-semibold"
                                required>

                            <option value="">
                                -- Select Target Executive --
                            </option>

                            @foreach (var exec in allExecutives)
                            {
                                <option value="@exec.UserId">
                                    @exec.ExecCode -
                                    @(exec.User?.FullName ?? "Executive")
                                    (@exec.Region)
                                </option>
                            }

                        </select>

                    </div>

                    <!-- Stage -->
                    <div class="sales-form-group">

                        <label class="sales-form-label">
                            Lead Funnel Stage Filter
                        </label>

                        <select name="stage"
                                class="sales-form-select">

                            <option value="All">
                                All Active Pipeline Leads
                            </option>

                            <option value="New">
                                New Only
                            </option>

                            <option value="Contacted">
                                Contacted Only
                            </option>

                            <option value="Qualified">
                                Qualified Only
                            </option>

                            <option value="Quotation Sent">
                                Quotation Sent Only
                            </option>

                            <option value="Negotiation">
                                Negotiation Only
                            </option>

                        </select>

                    </div>

                </div>

                <div class="modal-footer">

                    <button type="button"
                            class="sales-cancel-btn"
                            data-bs-dismiss="modal">
                        Cancel
                    </button>

                    <button type="submit"
                            class="sales-warning-btn">
                        <i class="fa-solid fa-arrow-right-arrow-left me-1"></i>
                        Execute Reassignment
                    </button>

                </div>

            </form>

        </div>
    </div>
</div>

@section Scripts {

    <script>
        function editExec(
            id,
            code,
            name,
            region,
            mobile,
            target,
            commission,
            coordId,
            status
        ) {
            document.getElementById('editId').value = id;
            document.getElementById('editExecCode').value = code;
            document.getElementById('editFullName').value = name;
            document.getElementById('editRegion').value = region;
            document.getElementById('editMobile').value = mobile;
            document.getElementById('editTarget').value = target;
            document.getElementById('editCommission').value = commission;
            document.getElementById('editCoordinatorId').value = coordId || '';
            document.getElementById('editStatus').value = status;

            var modal = new bootstrap.Modal(
                document.getElementById('editExecutiveModal')
            );

            modal.show();
        }

        function reassignLeads(userId, userName) {
            document.getElementById('reassignSourceUserId').value = userId;
            document.getElementById('reassignSourceUserName').value = userName;

            var modal = new bootstrap.Modal(
                document.getElementById('reassignLeadsModal')
            );

            modal.show();
        }
    </script>
}

                        <p class="sales-page-subtitle">
                            Manage field representatives, territories, targets and sales performance.
                        </p>

                        <nav aria-label="breadcrumb">
                            <ol class="breadcrumb sales-breadcrumb">
                                <li class="breadcrumb-item">
                                    <a href="/SalesDashboard" class="text-decoration-none">
                                        Sales Management
                                    </a>
                                </li>

                                <li class="breadcrumb-item text-muted">
                                    Sales Team
                                </li>

                                <li class="breadcrumb-item active fw-semibold"
                                    aria-current="page">
                                    Executives
                                </li>
                            </ol>
                        </nav>
                    </div>
                </div>

                <button type="button"
                        class="sales-header-action"
                        data-bs-toggle="modal"
                        data-bs-target="#addExecutiveModal">
                    <i class="fa-solid fa-plus"></i>
                    Add Executive
                </button>

            </div>
        </section>

        <!-- =========================
             SUCCESS ALERT
             ========================= -->
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert sales-alert sales-alert-success alert-dismissible fade show"
                 role="alert">

                <span class="sales-alert-icon">
                    <i class="fa-solid fa-circle-check"></i>
                </span>

                <span>
                    @TempData["SuccessMessage"]
                </span>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="alert"
                        aria-label="Close"></button>
            </div>
        }

        <!-- =========================
             ERROR ALERT
             ========================= -->
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert sales-alert sales-alert-danger alert-dismissible fade show"
                 role="alert">

                <span class="sales-alert-icon">
                    <i class="fa-solid fa-triangle-exclamation"></i>
                </span>

                <span>
                    @TempData["ErrorMessage"]
                </span>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="alert"
                        aria-label="Close"></button>
            </div>
        }

        <!-- =========================
             KPI SUMMARY
             ========================= -->
        <section class="sales-kpi-grid">

            <!-- Active Executives -->
            <div class="sales-kpi">
                <div class="sales-kpi-top">
                    <span class="sales-kpi-label">
                        Active Executives
                    </span>

                    <span class="sales-kpi-icon blue">
                        <i class="fa-solid fa-users"></i>
                    </span>
                </div>

                <h2 class="sales-kpi-value">
                    @ViewBag.ActiveCount
                </h2>

                <span class="sales-kpi-description">
                    Reps currently in territory
                </span>
            </div>

            <!-- Month Leader -->
            <div class="sales-kpi">
                <div class="sales-kpi-top">
                    <span class="sales-kpi-label">
                        Month's Leader
                    </span>

                    <span class="sales-kpi-icon green">
                        <i class="fa-solid fa-trophy"></i>
                    </span>
                </div>

                <h2 class="sales-kpi-value success text-truncate">
                    @ViewBag.MonthLeader
                </h2>

                <span class="sales-kpi-description">
                    Top billing sales performer
                </span>
            </div>

            <!-- Average Sales -->
            <div class="sales-kpi">
                <div class="sales-kpi-top">
                    <span class="sales-kpi-label">
                        Avg. Sales / Exec
                    </span>

                    <span class="sales-kpi-icon cyan">
                        <i class="fa-solid fa-chart-line"></i>
                    </span>
                </div>

                <h2 class="sales-kpi-value primary">
                    ₹@(((decimal)ViewBag.AvgSales).ToString("N0"))
                </h2>

                <span class="sales-kpi-description">
                    Month run rate per active rep
                </span>
            </div>

            <!-- Target Achievement -->
            <div class="sales-kpi">
                <div class="sales-kpi-top">
                    <span class="sales-kpi-label">
                        Target Achievement
                    </span>

                    <span class="sales-kpi-icon orange">
                        <i class="fa-solid fa-bullseye"></i>
                    </span>
                </div>

                <h2 class="sales-kpi-value warning">
                    @ViewBag.TargetAchievement%
                </h2>

                <span class="sales-kpi-description">
                    Overall quota fulfilled
                </span>
            </div>

        </section>

        <!-- =========================
             SALES FORCE DIRECTORY
             ========================= -->
        <section class="sales-directory-card">

            <div class="sales-directory-header">

                <h2 class="sales-directory-title">
                    <span class="sales-directory-title-icon">
                        <i class="fa-solid fa-id-badge"></i>
                    </span>

                    Sales Force Directory
                </h2>

                <span class="sales-directory-count">
                    Showing @Model.Count() registered executives
                </span>

            </div>

            <div class="sales-table-wrap">

                <table class="sales-table">

                    <thead>
                        <tr>
                            <th>Exec ID</th>
                            <th>Name</th>
                            <th>Mobile</th>
                            <th>Region</th>
                            <th>Assigned Coordinator</th>
                            <th class="text-end">Month Sales</th>
                            <th class="text-end">Target (Month)</th>
                            <th class="text-center">Status</th>
                            <th class="text-center" style="width: 170px;">
                                Actions
                            </th>
                        </tr>
                    </thead>

                    <tbody>

                        @if (Model != null && Model.Any())
                        {
                            foreach (var exec in Model)
                            {
                                decimal sales = 0;

                                if (repMonthlySales.ContainsKey(exec.UserId))
                                {
                                    sales = repMonthlySales[exec.UserId];
                                }

                                if (sales == 0)
                                {
                                    if (exec.ExecCode == "EX-104")
                                    {
                                        sales = 1245000m;
                                    }
                                    else if (exec.ExecCode == "EX-105")
                                    {
                                        sales = 1050000m;
                                    }
                                    else if (exec.ExecCode == "EX-106")
                                    {
                                        sales = 820000m;
                                    }
                                    else if (exec.ExecCode == "EX-107")
                                    {
                                        sales = 480000m;
                                    }
                                }

                                var badgeClass =
                                exec.Status == "Active"
                                ? "active"
                                : exec.Status == "On Leave"
                                ? "leave"
                                : "inactive";

                                <tr>

                                    <!-- Executive ID -->
                                    <td>
                                        <span class="exec-code">
                                            @exec.ExecCode
                                        </span>
                                    </td>

                                    <!-- Name -->
                                    <td class="exec-profile">

                                        <div class="exec-name">
                                            @(exec.User?.FullName ?? "Executive " + exec.ExecCode)
                                        </div>

                                        <span class="exec-email">
                                            @(exec.User?.Email ?? "-")
                                        </span>

                                    </td>

                                    <!-- Mobile -->
                                    <td>
                                        <span class="exec-mobile">
                                            <i class="fa-solid fa-phone me-1"></i>
                                            @(string.IsNullOrEmpty(exec.MobileNumber)
                                                                                ? (exec.User?.MobileNumber ?? "+91 98765 00000")
                                                                                : exec.MobileNumber)
                                </span>
                            </td>

                                    <!-- Region -->
                                    <td>

                                        <span class="region-badge">
                                            <i class="fa-solid fa-location-dot"></i>
                                            @exec.Region
                                        </span>

                                    </td>

                                    <!-- Coordinator -->
                                    <td>

                                @if (exec.AssignedCoordinator != null)
                                        {
                                            <span class="coordinator-badge">
                                                <i class="fa-solid fa-user-tie"></i>

                                                @exec.AssignedCoordinator.CoordinatorCode:
                                                @(exec.AssignedCoordinator.User?.FullName ?? "Coordinator")
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="unassigned-badge">
                                                Unassigned
                                            </span>
                                        }

                                    </td>

                                    <!-- Month Sales -->
                                    <td class="text-end">
                                        <span class="sales-amount">
                                            ₹@sales.ToString("N0")
                                        </span>
                                    </td>

                                    <!-- Monthly Target -->
                                    <td class="text-end">
                                        <span class="target-amount">
                                            ₹@exec.MonthlyTarget.ToString("N0")
                                        </span>
                                    </td>

                                    <!-- Status -->
                                    <td class="text-center">

                                        <span class="status-pill @badgeClass">

                                            @if (exec.Status == "Active")
                                            {
                                                <i class="fa-solid fa-circle-check"></i>
                                            }
                                            else if (exec.Status == "On Leave")
                                            {
                                                <i class="fa-solid fa-clock"></i>
                                            }
                                            else
                                            {
                                                <i class="fa-solid fa-circle-minus"></i>
                                            }

                                            @exec.Status

                                        </span>

                                    </td>

                                    <!-- Actions -->
                                    <td class="text-center">

                                        <div class="action-group">

                                            <button type="button"
                                                    class="exec-edit-btn"
                                                    title="Edit Profile"
                                                    onclick="editExec('@exec.Id', '@exec.ExecCode', '@(exec.User?.FullName)', '@exec.Region', '@exec.MobileNumber', '@exec.MonthlyTarget', '@exec.CommissionPercentage', '@exec.AssignedCoordinatorId', '@exec.Status')">

                                                <i class="fa-solid fa-pen"></i>

                                            </button>

                                            <button type="button"
                                                    class="exec-reassign-btn"
                                                    title="Reassign Leads"
                                                    onclick="reassignLeads('@exec.UserId', '@(exec.User?.FullName ?? exec.ExecCode)')">

                                                <i class="fa-solid fa-arrow-right-arrow-left me-1"></i>
                                                Reassign

                                            </button>

                                        </div>

                                    </td>

                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="9">

                                    <div class="sales-empty">

                                        <div class="sales-empty-icon">
                                            <i class="fa-solid fa-user-group"></i>
                                        </div>

                                        <h6>
                                            No sales executives found
                                        </h6>

                                        <p>
                                            Click "Add Executive" above to onboard your first representative.
                                        </p>

                                    </div>

                                </td>
                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </section>

    </div>
</div>

<!-- =========================================================
     MODAL: ADD EXECUTIVE
     ========================================================= -->
<div class="modal fade sales-modal"
     id="addExecutiveModal"
     tabindex="-1"
     aria-labelledby="addExecutiveModalLabel"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content">

            <form asp-action="SaveExecutive" method="post">

                @Html.AntiForgeryToken()

                <input type="hidden"
                       name="Id"
                       value="0" />

                <div class="modal-header">

                    <div class="sales-modal-header">

                        <span class="sales-modal-icon blue">
                            <i class="fa-solid fa-user-plus"></i>
                        </span>

                        <h5 class="modal-title"
                            id="addExecutiveModalLabel">
                            Add Sales Executive
                        </h5>

                    </div>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal"
                            aria-label="Close"></button>

                </div>

                <div class="modal-body text-start">

                    <!-- Full Name -->
                    <div class="sales-form-group">

                        <label class="sales-form-label">
                            Full Name
                            <span class="text-danger">*</span>
                        </label>

                        <input type="text"
                               name="fullName"
                               class="sales-form-control"
                               placeholder="e.g. Vikram Malhotra"
                               required />

                    </div>

                    <!-- Email / Mobile -->
                    <div class="row g-3">

                        <div class="col-md-6">

                            <div class="sales-form-group">

                                <label class="sales-form-label">
                                    Email Address
                                    <span class="text-danger">*</span>
                                </label>

                                <input type="email"
                                       name="email"
                                       class="sales-form-control"
                                       placeholder="vikram@erp.com"
                                       required />

                            </div>

                        </div>

                        <div class="col-md-6">

                            <div class="sales-form-group">

                                <label class="sales-form-label">
                                    Mobile Number
                                </label>

                                <input type="text"
                                       name="MobileNumber"
                                       class="sales-form-control"
                                       placeholder="+91 98765 43210" />

                            </div>

                        </div>

                    </div>

                    <!-- Region / Commission -->
                    <div class="row g-3">

                        <div class="col-md-6">

                            <div class="sales-form-group">

                                <label class="sales-form-label">
                                    Assigned Region
                                    <span class="text-danger">*</span>
                                </label>

                                <select name="Region"
                                        class="sales-form-select"
                                        required>

                                    <option value="North India">
                                        North India
                                    </option>

                                    <option value="West India">
                                        West India
                                    </option>

                                    <option value="South India">
                                        South India
                                    </option>

                                    <option value="East India">
                                        East India
                                    </option>

                                </select>

                            </div>

                        </div>

                        <div class="col-md-6">

                            <div class="sales-form-group">

                                <label class="sales-form-label">
                                    Commission Slab (%)
                                </label>

                                <input type="number"
                                       step="0.1"
                                       name="CommissionPercentage"
                                       class="sales-form-control"
                                       value="2.5" />

                            </div>

                        </div>

                    </div>

                    <!-- Target -->
                    <div class="sales-form-group">

                        <label class="sales-form-label">
                            Monthly Target (₹)
                            <span class="text-danger">*</span>
                        </label>

                        <input type="number"
                               step="1000"
                               name="MonthlyTarget"
                               class="sales-form-control fw-bold"
                               value="1500000"
                               required />

                    </div>

                    <!-- Coordinator -->
                    <div class="sales-form-group">

                        <label class="sales-form-label">
                            Assigned Coordinator
                        </label>

                        <select name="AssignedCoordinatorId"
                                class="sales-form-select">

                            <option value="">
                                -- None (Unassigned) --
                            </option>

                            @foreach (var c in coordinators)
                            {
                                <option value="@c.Id">
                                    @c.CoordinatorCode -
                                    @(c.User?.FullName ?? "Coordinator")
                                    (@c.PrimaryTerritory)
                                </option>
                            }

                        </select>

                    </div>

                    <!-- Status -->
                    <div class="sales-form-group">

                        <label class="sales-form-label">
                            Initial Status
                        </label>

                        <select name="Status"
                                class="sales-form-select">

                            <option value="Active">
                                Active
                            </option>

                            <option value="On Leave">
                                On Leave
                            </option>

                            <option value="Inactive">
                                Inactive
                            </option>

                        </select>

                    </div>

                </div>

                <div class="modal-footer">

                    <button type="button"
                            class="sales-cancel-btn"
                            data-bs-dismiss="modal">
                        Cancel
                    </button>

                    <button type="submit"
                            class="sales-save-btn">
                        <i class="fa-solid fa-check me-1"></i>
                        Save Executive
                    </button>

                </div>

            </form>

        </div>
    </div>
</div>


@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Sales Coordinators";
}

<div class="container-fluid py-4 text-start">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-bold mb-1"><i class="fa-solid fa-user-tie text-primary me-2"></i>Sales Coordinators</h4>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0 small">
                    <li class="breadcrumb-item"><a href="/SalesDashboard" class="text-decoration-none">Sales Management</a></li>
                    <li class="breadcrumb-item">Sales Team</li>
                    <li class="breadcrumb-item active" aria-current="page">Coordinators</li>
                </ol>
            </nav>
        </div>
        <button class="btn btn-primary rounded-pill px-3 shadow-sm"><i class="fa-solid fa-plus me-1.5"></i>Add Coordinator</button>
    </div>

    <!-- Grid Table -->
    <div class="bg-white border rounded-3 p-4 shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" style="font-size: 0.85rem;">
                <thead class="table-light">
                    <tr>
                        <th>Cord ID</th>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Assigned Executives</th>
                        <th>Primary Territory</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td class="fw-bold text-dark">SC-301</td>
                        <td>Karan Johar</td>
                        <td>karan@erp.com</td>
                        <td>EX-104, EX-107</td>
                        <td>North Zone</td>
                        <td><span class="badge bg-success-subtle text-success rounded-pill px-2.5 py-1">Active</span></td>
                    </tr>
                    <tr>
                        <td class="fw-bold text-dark">SC-302</td>
                        <td>Shalini Sen</td>
                        <td>shalini@erp.com</td>
                        <td>EX-105, EX-106</td>
                        <td>West & South Zone</td>
                        <td><span class="badge bg-success-subtle text-success rounded-pill px-2.5 py-1">Active</span></td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

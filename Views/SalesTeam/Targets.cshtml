@model IEnumerable<ERP_System.Models.SalesTargetAllocation>

@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Sales Targets";

    string selectedQuarter = ViewBag.SelectedQuarter as string ?? "Q3 2026";
    var executives = ViewBag.Executives as List<ERP_System.Models.SalesExecutiveProfile> ?? new List<ERP_System.Models.SalesExecutiveProfile>();
    var repPacingList = ViewBag.RepPacingList as List<dynamic> ?? new List<dynamic>();

    decimal enterpriseTarget = ViewBag.EnterpriseTarget != null ? (decimal)ViewBag.EnterpriseTarget : 6000000m;
    decimal enterpriseAchieved = ViewBag.EnterpriseAchieved != null ? (decimal)ViewBag.EnterpriseAchieved : 5000000m;
    int enterprisePct = enterpriseTarget > 0 ? (int)Math.Min(100, Math.Round((enterpriseAchieved / enterpriseTarget) * 100)) : 0;

    decimal retailTarget = ViewBag.RetailTarget != null ? (decimal)ViewBag.RetailTarget : 2000000m;
    decimal retailAchieved = ViewBag.RetailAchieved != null ? (decimal)ViewBag.RetailAchieved : 1850000m;
    int retailPct = retailTarget > 0 ? (int)Math.Min(100, Math.Round((retailAchieved / retailTarget) * 100)) : 0;

    decimal acqTarget = ViewBag.AcqTarget != null ? (decimal)ViewBag.AcqTarget : 50m;
    decimal acqAchieved = ViewBag.AcqAchieved != null ? (decimal)ViewBag.AcqAchieved : 35m;
    int acqPct = acqTarget > 0 ? (int)Math.Min(100, Math.Round((acqAchieved / acqTarget) * 100)) : 0;
}


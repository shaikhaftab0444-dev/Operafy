@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Sales Targets";
}

<div class="container-fluid py-4 text-start">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-bold mb-1"><i class="fa-solid fa-bullseye text-primary me-2"></i>Sales Targets</h4>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0 small">
                    <li class="breadcrumb-item"><a href="/SalesDashboard" class="text-decoration-none">Sales Management</a></li>
                    <li class="breadcrumb-item">Sales Team</li>
                    <li class="breadcrumb-item active" aria-current="page">Targets</li>
                </ol>
            </nav>
        </div>
        <button class="btn btn-primary rounded-pill px-3 shadow-sm"><i class="fa-solid fa-gear me-1.5"></i>Set Targets</button>
    </div>

    <!-- Active Target Details -->
    <div class="bg-white border rounded-3 p-4 shadow-sm mb-4">
        <h6 class="fw-bold text-dark mb-3">Q3 2026 Target Progression</h6>
        
        <div class="mb-4">
            <div class="d-flex justify-content-between mb-1 small">
                <span>Enterprise Invoices Revenue Target</span>
                <span class="fw-bold">₹50,00,000 / ₹60,00,000 (83%)</span>
            </div>
            <div class="progress" style="height: 10px;">
                <div class="progress-bar bg-success" role="progressbar" style="width: 83%;" aria-valuenow="83" aria-valuemin="0" aria-valuemax="100"></div>
            </div>
        </div>

        <div class="mb-4">
            <div class="d-flex justify-content-between mb-1 small">
                <span>Retail Counter Sales Target</span>
                <span class="fw-bold">₹18,50,000 / ₹20,00,000 (92%)</span>
            </div>
            <div class="progress" style="height: 10px;">
                <div class="progress-bar bg-info" role="progressbar" style="width: 92%;" aria-valuenow="92" aria-valuemin="0" aria-valuemax="100"></div>
            </div>
        </div>

        <div>
            <div class="d-flex justify-content-between mb-1 small">
                <span>New Customer Acquisitions</span>
                <span class="fw-bold">35 / 50 Accounts (70%)</span>
            </div>
            <div class="progress" style="height: 10px;">
                <div class="progress-bar bg-warning" role="progressbar" style="width: 70%;" aria-valuenow="70" aria-valuemin="0" aria-valuemax="100"></div>
            </div>
        </div>
    </div>
</div>

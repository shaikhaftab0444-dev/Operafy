<div class="sales-targets-page">
    <div class="container-fluid page-shell text-start">

        <!-- Success Message -->
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert success-alert alert-dismissible fade show mb-3" role="alert">
                <i class="fa-solid fa-circle-check me-2"></i>@TempData["SuccessMessage"]
                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="alert"
                        aria-label="Close"></button>
            </div>
        }

        <!-- =====================================================
             HERO HEADER
        ====================================================== -->

        <section class="target-hero">
            <div class="hero-content">

                <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">

                    <div class="d-flex align-items-start gap-3">

                        <div class="hero-icon">
                            <i class="fa-solid fa-bullseye"></i>
                        </div>

                        <div>
                            <div class="hero-eyebrow">
                                Sales Performance Management
                            </div>

                            <h1 class="page-title">
                                Sales Targets
                            </h1>

                            <p class="page-subtitle">
                                Monitor quarterly quotas, revenue achievement and individual executive pacing.
                            </p>

                            <nav aria-label="breadcrumb">
                                <ol class="breadcrumb mb-0">

                                    <li class="breadcrumb-item">
                                        <a href="/SalesDashboard"
                                           class="text-decoration-none">
                                            Sales Management
                                        </a>
                                    </li>

                                    <li class="breadcrumb-item text-muted">
                                        Sales Team
                                    </li>

                                    <li class="breadcrumb-item active fw-semibold"
                                        aria-current="page">
                                        Targets
                                    </li>

                                </ol>
                            </nav>
                        </div>

                    </div>

                    <div class="hero-controls d-flex align-items-center gap-2">

                        <form method="get"
                              asp-action="Targets"
                              id="quarterForm"
                              class="quarter-control">

                            <label class="quarter-label mb-0">
                                <i class="fa-regular fa-calendar-days me-1"></i>
                                Quarter
                            </label>

                            <select name="quarter"
                                    class="form-select quarter-select"
                                    onchange="document.getElementById('quarterForm').submit();">

                                <option value="Q1 2026"
                                        selected="@(selectedQuarter == "Q1 2026")">
                                    Q1 2026
                                </option>

                                <option value="Q2 2026"
                                        selected="@(selectedQuarter == "Q2 2026")">
                                    Q2 2026
                                </option>

                                <option value="Q3 2026"
                                        selected="@(selectedQuarter == "Q3 2026")">
                                    Q3 2026
                                </option>

                                <option value="Q4 2026"
                                        selected="@(selectedQuarter == "Q4 2026")">
                                    Q4 2026
                                </option>

                            </select>

                        </form>

                        <button type="button"
                                class="btn set-target-button"
                                data-bs-toggle="modal"
                                data-bs-target="#setTargetsModal">

                            <i class="fa-solid fa-sliders me-1"></i>
                            Set Targets

                        </button>

                    </div>

                </div>

            </div>
        </section>

        <!-- =====================================================
             TARGET PROGRESSION
        ====================================================== -->

        <section class="progression-card">

            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">

                <div class="d-flex align-items-center">

                    <span class="section-heading-icon">
                        <i class="fa-solid fa-chart-pie"></i>
                    </span>

                    <div>
                        <h2 class="section-heading">
                            @selectedQuarter Target Progression
                        </h2>

                        <div class="section-subtitle">
                            Department-level quota performance
                        </div>
                    </div>

                </div>

                <span class="quarter-badge">
                    <i class="fa-regular fa-calendar me-1"></i>
                    Quarterly Quota Overview
                </span>

            </div>

            <!-- Enterprise -->
            <div class="target-row">

                <div class="target-row-header">

                    <div class="target-name">
                        <span class="target-name-icon">
                            <i class="fa-solid fa-building"></i>
                        </span>

                        Enterprise Invoices Revenue Target
                    </div>

                    <div class="target-values">
                        ₹@enterpriseAchieved.ToString("N0")
                        /
                        ₹@enterpriseTarget.ToString("N0")

                        <span class="target-percent enterprise">
                            (@enterprisePct%)
                        </span>
                    </div>

                </div>

                <div class="progress target-progress"
                     role="progressbar"
                     aria-valuenow="@enterprisePct"
                     aria-valuemin="0"
                     aria-valuemax="100">

                    <div class="progress-bar enterprise-bar"
                         style="width: @enterprisePct%;"
                         aria-hidden="true">
                    </div>

                </div>

            </div>

            <!-- Retail -->
            <div class="target-row">

                <div class="target-row-header">

                    <div class="target-name">
                        <span class="target-name-icon">
                            <i class="fa-solid fa-cash-register"></i>
                        </span>

                        Retail Counter Sales Target
                    </div>

                    <div class="target-values">
                        ₹@retailAchieved.ToString("N0")
                        /
                        ₹@retailTarget.ToString("N0")

                        <span class="target-percent retail">
                            (@retailPct%)
                        </span>
                    </div>

                </div>

                <div class="progress target-progress"
                     role="progressbar"
                     aria-valuenow="@retailPct"
                     aria-valuemin="0"
                     aria-valuemax="100">

                    <div class="progress-bar retail-bar"
                         style="width: @retailPct%;"
                         aria-hidden="true">
                    </div>

                </div>

            </div>

            <!-- New Customer Acquisition -->
            <div class="target-row">

                <div class="target-row-header">

                    <div class="target-name">
                        <span class="target-name-icon">
                            <i class="fa-solid fa-user-plus"></i>
                        </span>

                        New Customer Acquisitions
                    </div>

                    <div class="target-values">
                        @((int)acqAchieved)
                        /
                        @((int)acqTarget)
                        Accounts

                        <span class="target-percent acquisition">
                            (@acqPct%)
                        </span>
                    </div>

                </div>

                <div class="progress target-progress"
                     role="progressbar"
                     aria-valuenow="@acqPct"
                     aria-valuemin="0"
                     aria-valuemax="100">

                    <div class="progress-bar acquisition-bar"
                         style="width: @acqPct%;"
                         aria-hidden="true">
                    </div>

                </div>

            </div>

        </section>

        <!-- =====================================================
             EXECUTIVE BREAKDOWN
        ====================================================== -->

        <section class="breakdown-card">

            <div class="breakdown-header">

                <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">

                    <div class="d-flex align-items-center">

                        <span class="section-heading-icon">
                            <i class="fa-solid fa-users-gear"></i>
                        </span>

                        <div>
                            <h2 class="section-heading">
                                Executive Individual Quota Breakdown (@selectedQuarter)
                            </h2>

                            <div class="section-subtitle">
                                Individual pacing against assigned quarterly targets
                            </div>
                        </div>

                    </div>

                    <span class="breakdown-meta">
                        Pacing tracks actual achieved revenue vs. quarterly target
                    </span>

                </div>

            </div>

            <div class="table-wrap">

                <table class="table targets-table align-middle mb-0">

                    <thead>
                        <tr>
                            <th>Sales Executive</th>
                            <th>Region</th>
                            <th class="text-end">Quarter Target (₹)</th>
                            <th class="text-end">Achieved (₹)</th>
                            <th class="text-center" style="width: 100px;">
                                Pacing %
                            </th>
                            <th style="min-width: 180px;">
                                Pacing Status
                            </th>
                            <th class="text-center" style="width: 120px;">
                                Action
                            </th>
                        </tr>
                    </thead>

                    <tbody>

                        @if (repPacingList != null && repPacingList.Any())
                        {
                            foreach (var rep in repPacingList)
                            {
                                <tr>

                                    <!-- Executive -->
                                    <td>

                                        <div class="d-flex align-items-center gap-2">

                                            <div class="rep-avatar">
                                                <i class="fa-solid fa-user"></i>
                                            </div>

                                            <div>
                                                <div class="rep-name">
                                                    @rep.Name
                                                </div>

                                                <span class="exec-code">
                                                    @rep.ExecId
                                                </span>
                                            </div>

                                        </div>

                                    </td>

                                    <!-- Region -->
                                    <td>

                                        <span class="region-badge">
                                            <i class="fa-solid fa-location-dot"></i>
                                            @rep.Region
                                        </span>

                                    </td>

                                    <!-- Target -->
                                    <td class="text-end">
                                        <span class="money-target">
                                            ₹@(((decimal)rep.Target).ToString("N0"))
                                        </span>
                                    </td>

                                    <!-- Achieved -->
                                    <td class="text-end">
                                        <span class="money-achieved">
                                            ₹@(((decimal)rep.Achieved).ToString("N0"))
                                        </span>
                                    </td>

                                    <!-- Pacing -->
                                    <td class="text-center">

                                        <span class="pacing-pill bg-@rep.StatusClass-subtle text-@rep.StatusClass border border-@rep.StatusClass">
                                            @rep.Pacing%
                                        </span>

                                    </td>

                                    <!-- Pacing Status -->
                                    <td>

                                        <div class="d-flex align-items-center gap-2">

                                            <div class="progress pacing-track">

                                                <div class="progress-bar bg-@rep.StatusClass"
                                                     role="progressbar"
                                                     style="width: @Math.Min(100, rep.Pacing)%;"
                                                     aria-valuenow="@rep.Pacing"
                                                     aria-valuemin="0"
                                                     aria-valuemax="100">
                                                </div>

                                            </div>

                                            <small class="pacing-status">
                                                @rep.Status
                                            </small>

                                        </div>

                                    </td>

                                    <!-- Action -->
                                    <td class="text-center">

                                        <button type="button"
                                                class="btn adjust-button"
                                                onclick="openTargetModal('@selectedQuarter', 'Enterprise Invoices', '@rep.UserId', '@rep.Target')">

                                            <i class="fa-solid fa-sliders"></i>
                                            Adjust

                                        </button>

                                    </td>

                                </tr>
                            }
                        }
                        else
                        {
                            <tr>

                                <td colspan="7"
                                    class="text-center empty-state">

                                    <div class="empty-icon">
                                        <i class="fa-solid fa-chart-column"></i>
                                    </div>

                                    <div class="empty-title">
                                        No individual target breakdown found
                                    </div>

                                    <p class="empty-text">
                                        No executive pacing data is available for this quarter.
                                    </p>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </section>

    </div>
</div>

<!-- =========================================================
     MODAL: SET TARGETS
========================================================= -->

<div class="modal fade"
     id="setTargetsModal"
     tabindex="-1"
     aria-labelledby="setTargetsModalLabel"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content">

            <form asp-action="SetTarget" method="post">

                @Html.AntiForgeryToken()

                <div class="modal-header modal-header-primary">

                    <h5 class="modal-title"
                        id="setTargetsModalLabel">

                        <i class="fa-solid fa-bullseye me-2"></i>
                        Configure Sales Target

                    </h5>

                    <button type="button"
                            class="btn-close btn-close-white"
                            data-bs-dismiss="modal"
                            aria-label="Close">
                    </button>

                </div>

                <div class="modal-body">

                    <!-- Quarter -->
                    <div class="mb-3">

                        <label class="form-label">
                            Fiscal Quarter
                            <span class="text-danger">*</span>
                        </label>

                        <select id="modalQuarter"
                                name="FiscalQuarter"
                                class="form-select fw-semibold"
                                required>

                            <option value="Q1 2026"
                                    selected="@(selectedQuarter == "Q1 2026")">
                                Q1 2026
                            </option>

                            <option value="Q2 2026"
                                    selected="@(selectedQuarter == "Q2 2026")">
                                Q2 2026
                            </option>

                            <option value="Q3 2026"
                                    selected="@(selectedQuarter == "Q3 2026")">
                                Q3 2026
                            </option>

                            <option value="Q4 2026"
                                    selected="@(selectedQuarter == "Q4 2026")">
                                Q4 2026
                            </option>

                        </select>

                    </div>

                    <!-- Category -->
                    <div class="mb-3">

                        <label class="form-label">
                            Target Category
                            <span class="text-danger">*</span>
                        </label>

                        <select id="modalCategory"
                                name="TargetCategory"
                                class="form-select fw-semibold"
                                required>

                            <option value="Enterprise Invoices">
                                Enterprise Invoices (Revenue)
                            </option>

                            <option value="Retail Counter">
                                Retail Counter Sales (Revenue)
                            </option>

                            <option value="New Customer Acquisitions">
                                New Customer Acquisitions (Count)
                            </option>

                        </select>

                    </div>

                    <!-- Sales Representative -->
                    <div class="mb-3">

                        <label class="form-label">
                            Target Assignment
                        </label>

                        <select id="modalRepUser"
                                name="SalesRepUserId"
                                class="form-select">

                            <option value="">
                                -- Team-Wide Aggregate Target --
                            </option>

                            @foreach (var exec in executives)
                            {
                                <option value="@exec.UserId">
                                    @exec.ExecCode - @(exec.User?.FullName ?? "Executive") (@exec.Region)
                                </option>
                            }

                        </select>

                        <div class="target-help">
                            <i class="fa-solid fa-circle-info me-1"></i>
                            Leave empty to set the department aggregate milestone.
                        </div>

                    </div>

                    <!-- Target Value -->
                    <div class="mb-2">

                        <label class="form-label">
                            Target Value (₹ / Count)
                            <span class="text-danger">*</span>
                        </label>

                        <input type="number"
                               step="1000"
                               id="modalTargetValue"
                               name="TargetValue"
                               class="form-control fw-bold"
                               placeholder="e.g. 5000000"
                               required />

                    </div>

                </div>

                <div class="modal-footer">

                    <button type="button"
                            class="btn btn-secondary modal-cancel"
                            data-bs-dismiss="modal">
                        Cancel
                    </button>

                    <button type="submit"
                            class="btn modal-save">

                        <i class="fa-solid fa-check me-1"></i>
                        Save Target

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>

@section Scripts {

    <script>
        function openTargetModal(quarter, category, repUserId, targetValue) {

            document.getElementById('modalQuarter').value = quarter;

            document.getElementById('modalCategory').value =
                category || 'Enterprise Invoices';

            document.getElementById('modalRepUser').value =
                repUserId || '';

            document.getElementById('modalTargetValue').value =
                targetValue || '';

            var modal = new bootstrap.Modal(
                document.getElementById('setTargetsModal')
            );

            modal.show();
        }
    </script>

}
```

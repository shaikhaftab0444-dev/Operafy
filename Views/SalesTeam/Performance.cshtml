    /* =========================
           RESPONSIVE
           ========================= */

    @@media (max-width: 991.98px) {
        .sales-performance-page {
            padding: 22px;
        }

        .performer-card.gold {
            transform: none;
        }

            .performer-card.gold:hover {
                transform: translateY(-4px);
            }

        .performer-content {
            padding-left: 18px;
            padding-right: 18px;
        }
    }

    @@media (max-width: 767.98px) {

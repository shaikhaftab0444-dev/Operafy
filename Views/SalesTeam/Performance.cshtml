        }

        .leaderboard-card,
        .performer-card {
            box-shadow: none !important;
            break-inside: avoid;
        }

        .leaderboard-table-wrapper {
            overflow: visible !important;
        }

        .leaderboard-table {
            min-width: 0 !important;
            font-size: 9px !important;
        }

        .performer-card {
            transform: none !important;
        }
    }
</style>

<div class="sales-performance-page">

    <!-- =========================================================
         PAGE HEADER
         ========================================================= -->
    <div class="sales-page-header d-flex flex-wrap justify-content-between align-items-center gap-3">

        <div>
            <div class="d-flex align-items-center">
                <span class="sales-page-title-icon">
                    <i class="fa-solid fa-ranking-star"></i>
                </span>

                <h4 class="sales-page-title mb-0">
                    Sales Performance
                </h4>
            </div>

            <nav aria-label="breadcrumb" class="sales-breadcrumb">
                <ol class="breadcrumb mb-0">
                    <li class="breadcrumb-item">
                        <a href="/SalesDashboard" class="text-decoration-none">
                            Sales Management
                        </a>
                    </li>
                    <li class="breadcrumb-item">
                        Sales Team
                    </li>
                    <li class="breadcrumb-item active fw-semibold" aria-current="page">
                        Performance
                    </li>
                </ol>
            </nav>
        </div>

        <div class="d-flex gap-2 sales-action-group">

            <a asp-action="ExportPerformanceCsv"
               class="btn btn-outline-secondary sales-action-btn shadow-sm">
                <i class="fa-solid fa-file-csv text-success"></i>
                <span>Export CSV</span>
            </a>

            <button type="button"
                    class="btn btn-outline-dark sales-action-btn shadow-sm"
                    onclick="window.print();">
                <i class="fa-solid fa-print"></i>
                <span>Print Report</span>
            </button>

        </div>
    </div>


    <!-- =========================================================
         TOP 3 PERFORMANCE PODIUM
         ========================================================= -->
    <div class="row g-4 podium-row align-items-end">

        <!-- =====================================================
             RANK #2
             ===================================================== -->
        <div class="col-lg-4 order-2 order-lg-1">

            <div class="performer-card silver shadow-sm">

                <span class="rank-circle rank-2">
                    #2
                </span>

                <div class="performer-content">

                    <div class="performer-icon silver">
                        <i class="fa-solid fa-medal fa-2x"></i>
                    </div>

                    <div class="performer-name">
                        @(secondPerformer?.Name ?? "Representative 2")
                    </div>

                    <div class="performer-meta">
                        <i class="fa-solid fa-id-badge"></i>
                        @(secondPerformer?.ExecId ?? "EX-105")
                        <span>•</span>
                        @(secondPerformer?.Region ?? "West")
                    </div>

                    <div class="performer-revenue">
                        ₹@(secondPerformer != null ? secondPerformer.Revenue.ToString("N0") : "0")
                    </div>

                    <div class="performer-caption">
                        Revenue Contribution
                    </div>

                    <div class="performer-stats">

                        <div class="performer-stat">
                            <div class="performer-stat-value">
                                @(secondPerformer?.TargetAchievement ?? 0)%
                            </div>
                            <div class="performer-stat-label">
                                Quota
                            </div>
                        </div>

                        <div class="performer-stat">
                            <div class="performer-stat-value">
                                @(secondPerformer?.ConversionRate ?? 0)%
                            </div>
                            <div class="performer-stat-label">
                                Win Rate
                            </div>
                        </div>

                    </div>

                </div>
            </div>
        </div>


        <!-- =====================================================
             RANK #1
             ===================================================== -->
        <div class="col-lg-4 order-1 order-lg-2">

            <div class="performer-card gold shadow">

                <span class="rank-circle rank-1">
                    #1
                </span>

                <div class="performer-content">

                    <div class="performer-icon gold">
                        <i class="fa-solid fa-crown fa-2x"></i>
                    </div>

                    <div class="performer-name">
                        @(topPerformer?.Name ?? "Top Performer")
                    </div>

                    <div class="performer-meta">
                        <i class="fa-solid fa-id-badge"></i>
                        @(topPerformer?.ExecId ?? "EX-104")
                        <span>•</span>
                        @(topPerformer?.Region ?? "North")
                    </div>

                    <div class="performer-revenue">
                        ₹@(topPerformer != null ? topPerformer.Revenue.ToString("N0") : "0")
                    </div>

                    <div class="performer-caption">
                        Current Month Revenue Leader
                    </div>

                    <div class="performer-stats">

                        <div class="performer-stat">
                            <div class="performer-stat-value">
                                @(topPerformer?.TargetAchievement ?? 0)%
                            </div>
                            <div class="performer-stat-label">
                                Quota
                            </div>
                        </div>

                        <div class="performer-stat">
                            <div class="performer-stat-value">
                                @(topPerformer?.ConversionRate ?? 0)%
                            </div>
                            <div class="performer-stat-label">
                                Win Rate
                            </div>
                        </div>

                        <div class="performer-stat">
                            <div class="performer-stat-value">
                                @(topPerformer?.WonDeals ?? 0)
                            </div>
                            <div class="performer-stat-label">
                                Deals Closed
                            </div>
                        </div>

                    </div>

                </div>
            </div>
        </div>


        <!-- =====================================================
             RANK #3
             ===================================================== -->
        <div class="col-lg-4 order-3">

            <div class="performer-card bronze shadow-sm">

                <span class="rank-circle rank-3">
                    #3
                </span>

                <div class="performer-content">

                    <div class="performer-icon bronze">
                        <i class="fa-solid fa-award fa-2x"></i>
                    </div>

                    <div class="performer-name">
                        @(thirdPerformer?.Name ?? "Representative 3")
                    </div>

                    <div class="performer-meta">
                        <i class="fa-solid fa-id-badge"></i>
                        @(thirdPerformer?.ExecId ?? "EX-106")
                        <span>•</span>
                        @(thirdPerformer?.Region ?? "South")
                    </div>

                    <div class="performer-revenue">
                        ₹@(thirdPerformer != null ? thirdPerformer.Revenue.ToString("N0") : "0")
                    </div>

                    <div class="performer-caption">
                        Revenue Contribution
                    </div>

                    <div class="performer-stats">

                        <div class="performer-stat">
                            <div class="performer-stat-value">
                                @(thirdPerformer?.TargetAchievement ?? 0)%
                            </div>
                            <div class="performer-stat-label">
                                Quota
                            </div>
                        </div>

                        <div class="performer-stat">
                            <div class="performer-stat-value">
                                @(thirdPerformer?.ConversionRate ?? 0)%
                            </div>
                            <div class="performer-stat-label">
                                Win Rate
                            </div>
                        </div>

                    </div>

                </div>
            </div>
        </div>

    </div>


    <!-- =========================================================
         LEADERBOARD
         ========================================================= -->
    <div class="leaderboard-card">

        <div class="leaderboard-header">

            <div class="leaderboard-header-top d-flex justify-content-between align-items-center gap-3">

                <div>

                    <h6 class="leaderboard-title">
                        <span class="leaderboard-title-icon">
                            <i class="fa-solid fa-trophy"></i>
                        </span>

                        Sales Executives Leaderboard
                    </h6>

                    <div class="leaderboard-subtitle">
                        Current month performance based on paid invoices and opportunity closure
                    </div>

                </div>

                <span class="live-indicator">
                    <span class="live-dot"></span>
                    Live Performance
                </span>

            </div>

        </div>


        <div class="leaderboard-table-wrapper">

            <table class="table leaderboard-table table-hover align-middle">

                <thead>
                    <tr>

                        <th class="text-center" style="width: 65px;">
                            Rank
                        </th>

                        <th>
                            Executive
                        </th>

                        <th>
                            Region
                        </th>

                        <th class="text-end">
                            Revenue Contribution
                        </th>

                        <th class="text-end">
                            Target (Month)
                        </th>

                        <th class="text-center">
                            Target Achievement
                        </th>

                        <th class="text-center">
                            Deals Closed
                        </th>

                        <th class="text-center">
                            Conversion Rate
                        </th>

                        <th class="text-end">
                            Gap to Target (₹)
                        </th>

                        <th class="text-center">
                            Status
                        </th>

                    </tr>
                </thead>


                <tbody>

                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            var rankBadge = item.Rank == 1
                            ? "background: #f4c430; color: #3d3200;"
                            : item.Rank == 2
                            ? "background: #9ca3af; color: white;"
                            : item.Rank == 3
                            ? "background: #e67e22; color: white;"
                            : "background: #eef0f3; color: #667085;";

                            var achClass = item.TargetAchievement >= 100
                            ? "text-success fw-bold"
                            : item.TargetAchievement >= 80
                            ? "text-primary fw-bold"
                            : "text-warning fw-bold";

                            var progressClass = item.TargetAchievement >= 100
                            ? "bg-success"
                            : item.TargetAchievement >= 80
                            ? "bg-primary"
                            : "bg-warning";

                            var executiveInitial =
                            !string.IsNullOrWhiteSpace(item.Name)
                            ? item.Name.Trim().Substring(0, 1).ToUpper()
                            : "E";

                            <tr>

                                <!-- Rank -->
                                <td class="text-center">

                                    <span class="rank-table-badge"
                                          style="@rankBadge">

                                        #@item.Rank

                                    </span>

                                </td>


                                <!-- Executive -->
                                <td>

                                    <div class="executive-cell">

                                        <div class="executive-avatar">
                                            @executiveInitial
                                        </div>

                                        <div>
                                            <div class="executive-name">
                                                @item.Name
                                            </div>

                                            <span class="executive-id">
                                                @item.ExecId
                                            </span>
                                        </div>

                                    </div>

                                </td>


                                <!-- Region -->
                                <td>

                                    <span class="region-badge">
                                        <i class="fa-solid fa-location-dot text-primary"></i>
                                        @item.Region
                                    </span>

                                </td>


                                <!-- Revenue -->
                                <td class="text-end">

                                    <span class="revenue-value">
                                        ₹@item.Revenue.ToString("N0")
                                    </span>

                                </td>


                                <!-- Target -->
                                <td class="text-end">

                                    <span class="target-value">
                                        ₹@item.Target.ToString("N0")
                                    </span>

                                </td>


                                <!-- Achievement -->
                                <td class="text-center">

                                    <span class="achievement-value @achClass">
                                        @item.TargetAchievement%
                                    </span>

                                    <div class="achievement-progress">

                                        <div class="progress-bar @progressClass"
                                             role="progressbar"
                                             style="width: @Math.Min(100, item.TargetAchievement)%;">
                                        </div>

                                    </div>

                                </td>


                                <!-- Deals -->
                                <td class="text-center">

                                    <span class="deal-number">
                                        @item.WonDeals
                                    </span>

                                    <span class="deal-total">
                                        / @item.TotalDeals
                                    </span>

                                </td>


                                <!-- Conversion -->
                                <td class="text-center">

                                    <span class="conversion-value">
                                        @item.ConversionRate%
                                    </span>

                                </td>


                                <!-- Gap -->
                                <td class="text-end">

                                    @if (item.GapToTarget <= 0)
                                    {
                                        <span class="achieved-badge">
                                            <i class="fa-solid fa-check"></i>
                                            Achieved
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="gap-value">
                                            ₹@item.GapToTarget.ToString("N0")
                                        </span>
                                    }

                                </td>


                                <!-- Status -->
                                <td class="text-center">

                                    @if (item.Status == "Active")
                                    {
                                        <span class="status-badge status-active">
                                            <i class="fa-solid fa-circle-check"></i>
                                            @item.Status
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="status-badge status-other">
                                            @item.Status
                                        </span>
                                    }

                                </td>

                            </tr>
                        }
                    }
                    else
                    {
                        <tr>

                            <td colspan="10" class="empty-performance">

                                <div class="empty-performance-icon">
                                    <i class="fa-solid fa-chart-line"></i>
                                </div>

                                <div class="empty-performance-title">
                                    No sales performance data available
                                </div>

                                <p class="empty-performance-text">
                                    There is no performance information available for this period.
                                </p>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>
```

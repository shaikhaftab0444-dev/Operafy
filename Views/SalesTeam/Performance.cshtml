@model IEnumerable<ERP_System.Models.SalesPerformanceLeaderboardItem>

@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Sales Performance";

    var topPerformer = ViewBag.TopPerformer as ERP_System.Models.SalesPerformanceLeaderboardItem;
    var secondPerformer = ViewBag.SecondPerformer as ERP_System.Models.SalesPerformanceLeaderboardItem;
    var thirdPerformer = ViewBag.ThirdPerformer as ERP_System.Models.SalesPerformanceLeaderboardItem;
}

<style>
    /* =========================================================
           SALES PERFORMANCE PAGE
           Scoped styles - does not modify dashboard layout
           ========================================================= */

    .sales-performance-page {
        background: #f6f8fb;
        min-height: calc(100vh - 70px);
        padding: 28px;
    }

    .sales-page-header {
        margin-bottom: 26px;
    }

    .sales-page-title {
        color: #172033;
        font-size: 1.45rem;
        font-weight: 750;
        letter-spacing: -0.3px;
    }

    .sales-page-title-icon {
        width: 38px;
        height: 38px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 11px;
        background: #eef2ff;
        color: #4f46e5;
        margin-right: 10px;
        font-size: 1rem;
    }

    .sales-breadcrumb {
        margin-top: 5px;
    }

        .sales-breadcrumb .breadcrumb-item {
            font-size: .78rem;
            color: #8a94a6;
        }

        .sales-breadcrumb a {
            color: #7b8495 !important;
        }

    .sales-action-btn {
        height: 40px;
        padding: 0 17px;
        border-radius: 10px !important;
        font-size: .82rem;
        font-weight: 650;
        display: inline-flex;
        align-items: center;
        gap: 7px;
        transition: all .2s ease;
        background: #fff;
    }

        .sales-action-btn:hover {
            transform: translateY(-1px);
            box-shadow: 0 7px 18px rgba(31, 41, 55, .08) !important;
        }

    /* =========================
           PODIUM
           ========================= */

    .podium-row {
        margin-bottom: 28px;
    }

    .performer-card {
        position: relative;
        overflow: hidden;
        border: 1px solid #e8ecf2 !important;
        border-radius: 17px !important;
        min-height: 280px;
        transition: transform .22s ease, box-shadow .22s ease;
    }

        .performer-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 15px 35px rgba(31, 41, 55, .10) !important;
        }

        .performer-card::before {
            content: "";
            position: absolute;
            left: 0;
            right: 0;
            top: 0;
            height: 4px;
        }

        .performer-card.silver {
            background: linear-gradient(145deg, #ffffff 0%, #f4f6f9 100%);
        }

            .performer-card.silver::before {
                background: #9ca3af;
            }

        .performer-card.gold {
            background: linear-gradient(145deg, #fffdf7 0%, #fff7df 100%);
            min-height: 300px;
            transform: translateY(-7px);
            border-color: #f3e5b5 !important;
        }

            .performer-card.gold::before {
                background: #eab308;
            }

            .performer-card.gold:hover {
                transform: translateY(-11px);
            }

        .performer-card.bronze {
            background: linear-gradient(145deg, #fffaf6 0%, #fff1e8 100%);
        }

            .performer-card.bronze::before {
                background: #ea7b22;
            }

    .rank-circle {
        position: absolute;
        top: 18px;
        left: 50%;
        transform: translateX(-50%);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        font-weight: 800;
        box-shadow: 0 5px 12px rgba(31, 41, 55, .14);
    }

        .rank-circle.rank-1 {
            width: 43px;
            height: 43px;
            background: #f4c430;
            color: #3d3200;
            font-size: 1rem;
        }

        .rank-circle.rank-2,
        .rank-circle.rank-3 {
            width: 36px;
            height: 36px;
            font-size: .82rem;
            color: #fff;
        }

        .rank-circle.rank-2 {
            background: #9ca3af;
        }

        .rank-circle.rank-3 {
            background: #e67e22;
        }

    .performer-content {
        position: relative;
        z-index: 1;
        padding: 57px 24px 22px;
        text-align: center;
    }

    .gold .performer-content {
        padding-top: 61px;
    }

    .performer-icon {
        margin-bottom: 12px;
    }

        .performer-icon.silver {
            color: #9ca3af;
        }

        .performer-icon.gold {
            color: #eab308;
        }

        .performer-icon.bronze {
            color: #e67e22;
        }

    .performer-name {
        color: #182233;
        font-weight: 750;
        font-size: 1rem;
        margin-bottom: 7px;
    }

    .gold .performer-name {
        font-size: 1.12rem;
    }

    .performer-meta {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        background: rgba(255,255,255,.72);
        border: 1px solid rgba(148,163,184,.22);
        border-radius: 999px;
        padding: 5px 10px;
        color: #667085;
        font-size: .72rem;
        font-weight: 600;
        margin-bottom: 14px;
    }

    .performer-revenue {
        color: #2563eb;
        font-size: 1.55rem;
        line-height: 1.1;
        font-weight: 800;
        letter-spacing: -.4px;
        margin-bottom: 4px;
    }

    .gold .performer-revenue {
        color: #15803d;
        font-size: 1.85rem;
    }

    .performer-caption {
        color: #7b8495;
        font-size: .72rem;
        margin-bottom: 15px;
    }

    .performer-stats {
        display: flex;
        justify-content: center;
        gap: 0;
        border-top: 1px solid rgba(100,116,139,.15);
        padding-top: 13px;
        margin-top: 3px;
    }

    .performer-stat {
        min-width: 80px;
        padding: 0 11px;
        border-right: 1px solid rgba(100,116,139,.12);
    }

        .performer-stat:last-child {
            border-right: 0;
        }

    .performer-stat-value {
        color: #172033;
        font-size: .86rem;
        font-weight: 750;
    }

    .performer-stat-label {
        color: #8992a3;
        font-size: .66rem;
        margin-top: 2px;
    }

    /* =========================
           LEADERBOARD
           ========================= */

    .leaderboard-card {
        background: #fff;
        border: 1px solid #e7ebf1;
        border-radius: 17px;
        box-shadow: 0 7px 25px rgba(31, 41, 55, .045);

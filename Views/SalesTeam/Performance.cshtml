@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Sales Performance";
}

<div class="container-fluid py-4 text-start">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-bold mb-1"><i class="fa-solid fa-ranking-star text-primary me-2"></i>Sales Performance</h4>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0 small">
                    <li class="breadcrumb-item"><a href="/SalesDashboard" class="text-decoration-none">Sales Management</a></li>
                    <li class="breadcrumb-item">Sales Team</li>
                    <li class="breadcrumb-item active" aria-current="page">Performance</li>
                </ol>
            </nav>
        </div>
    </div>

    <!-- Leaderboard -->
    <div class="bg-white border rounded-3 p-4 shadow-sm">
        <h6 class="fw-bold text-dark mb-4"><i class="fa-solid fa-trophy text-warning me-2"></i>Sales Executives Leaderboard (Current Month)</h6>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" style="font-size: 0.85rem;">
                <thead class="table-light">
                    <tr>
                        <th style="width: 80px;">Rank</th>
                        <th>Executive</th>
                        <th>Revenue Contribution</th>
                        <th>Target Achievement</th>
                        <th>Lead Conversion Rate</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td><span class="badge bg-warning text-dark fw-bold rounded-pill px-2.5 py-1">#1</span></td>
                        <td class="fw-bold text-dark">Amit Verma</td>
                        <td class="fw-bold text-primary">₹12,45,000</td>
                        <td>83%</td>
                        <td>24.5%</td>
                    </tr>
                    <tr>
                        <td><span class="badge bg-secondary text-dark fw-bold rounded-pill px-2.5 py-1">#2</span></td>
                        <td class="fw-bold text-dark">Neha Sharma</td>
                        <td class="fw-bold text-primary">₹10,50,000</td>
                        <td>87.5%</td>
                        <td>19.8%</td>
                    </tr>
                    <tr>
                        <td><span class="badge bg-danger text-white fw-bold rounded-pill px-2.5 py-1">#3</span></td>
                        <td class="fw-bold text-dark">Rohan Das</td>
                        <td class="fw-bold text-primary">₹8,20,000</td>
                        <td>82%</td>
                        <td>15.2%</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

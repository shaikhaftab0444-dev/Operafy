        align-items: center;
        justify-content: center;
        margin-right: 8px;
        font-size: .78rem;
    }

    .leaderboard-subtitle {
        color: #8a94a6;
        font-size: .72rem;
        margin-top: 4px;
        margin-left: 39px;
    }

    .live-indicator {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: #f0fdf4;

    }

    .live-dot {
        width: 6px;
        height: 6px;
        background: #22c55e;
        border-radius: 50%;
        box-shadow: 0 0 0 3px rgba(34,197,94,.12);
    }

    .leaderboard-table-wrapper {
        overflow-x: auto;
    }

    .leaderboard-table {
        min-width: 1100px;
        margin-bottom: 0 !important;
    }

        .leaderboard-table thead th {
            background: #f8fafc;
            color: #667085;
            border-bottom: 1px solid #e8edf3;
            border-top: 0;
            padding: 13px 14px;
            font-size: .68rem;
            font-weight: 750;
            text-transform: uppercase;
            letter-spacing: .35px;

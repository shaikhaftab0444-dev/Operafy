                     aria-labelledby="branches-tab">

                    <div class="table-responsive">

                        <table class="table table-hover align-middle">

                            <thead>
                                <tr>
                                    <th>Branch ID</th>
                                    <th>Branch Name</th>
                                    <th>Branch Code</th>
                                    <th>City / State</th>
                                    <th>Address</th>
                                    <th>Status</th>
                                </tr>
                            </thead>

                            <tbody>

                                @{
                                    var branches = ViewBag.CompanyBranches as List<ERP_System.Models.Branch>;
                                }

                                @if (branches != null && branches.Any())
                                {
                                    foreach (var branch in branches)
                                    {
                                        <tr>

                                            <td class="fw-bold text-secondary">
                                                BR#@branch.BranchId.ToString("D2")
                                            </td>

                                            <td class="fw-bold text-dark">
                                                @branch.BranchName
                                            </td>

                                            <td>
                                                <span class="badge bg-secondary-subtle text-secondary-emphasis">
                                                    @branch.BranchCode
                                                </span>
                                            </td>

                                            <td>
                                                @branch.City, @branch.State
                                            </td>

                                            <td>
                                                @branch.AddressLine1
                                            </td>

                                            <td>
                                                @if (branch.IsActive)
                                                {
                                                    <span class="badge bg-success-subtle text-success-emphasis rounded-pill px-3 py-1">
                                                        Active
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-danger-subtle text-danger-emphasis rounded-pill px-3 py-1">
                                                        Inactive
                                                    </span>
                                                }
                                            </td>

                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="6"
                                            class="text-center text-muted py-4">
                                            No branches registered for this company.
                                        </td>
                                    </tr>
                                }

                            </tbody>

                        </table>

                    </div>
                </div>

                <!-- PRODUCTS -->
                <div class="tab-pane fade"
                     id="products-pane"
                     role="tabpanel"
                     aria-labelledby="products-tab">

                    <div class="table-responsive">

                        <table class="table table-hover align-middle">

                            <thead>
                                <tr>
                                    <th>Product Name</th>
                                    <th>Category</th>
                                    <th>Branch Location</th>
                                    <th class="text-center">Stock Quantity</th>
                                    <th class="text-end">Price</th>
                                    <th>Status</th>
                                </tr>
                            </thead>

                            <tbody>

                                @{
                                    var products = ViewBag.CompanyProducts as List<ERP_System.Models.Product>;
                                }

                                @if (products != null && products.Any())
                                {
                                    foreach (var prod in products)
                                    {
                                        decimal simulatedPrice = 1500;

                                        if (prod.ProductName != null)
                                        {
                                            if (prod.ProductName.Contains("Laptop", StringComparison.OrdinalIgnoreCase))
                                            {
                                                simulatedPrice = 65000;
                                            }
                                            else if (prod.ProductName.Contains("Mouse", StringComparison.OrdinalIgnoreCase))
                                            {
                                                simulatedPrice = 800;
                                            }
                                            else if (prod.ProductName.Contains("Keyboard", StringComparison.OrdinalIgnoreCase))
                                            {
                                                simulatedPrice = 1500;
                                            }
                                            else if (prod.ProductName.Contains("Monitor", StringComparison.OrdinalIgnoreCase))
                                            {
                                                simulatedPrice = 12000;
                                            }
                                        }

                                        var stockStatus =
                                            prod.StockQty > 10 ? "In Stock" :
                                            prod.StockQty > 0 ? "Low Stock" :
                                            "Out of Stock";

                                        var statusBadge =
                                            stockStatus == "In Stock"
                                                ? "bg-success-subtle text-success-emphasis"
                                                : stockStatus == "Low Stock"
                                                    ? "bg-warning-subtle text-warning-emphasis"
                                                    : "bg-danger-subtle text-danger-emphasis";

                                        <tr>

                                            <td class="fw-bold text-dark">
                                                @prod.ProductName
                                            </td>

                                            <td>
                                                <span class="badge bg-light text-dark border px-3 py-1">
                                                    @prod.Category
                                                </span>
                                            </td>

                                            <td>
                                                <i class="fa-solid fa-code-fork me-2 text-muted"></i>
                                                @(prod.Branch?.BranchName ?? "Head Office")
                                            </td>

                                            <td class="text-center fw-bold">
                                                @prod.StockQty
                                            </td>

                                            <td class="text-end fw-bold text-dark">
                                                @simulatedPrice.ToString("N2") @Model.CurrencySymbol
                                            </td>

                                            <td>
                                                <span class="badge rounded-pill px-3 py-1 @statusBadge">
                                                    @stockStatus
                                                </span>
                                            </td>

                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="6"
                                            class="text-center text-muted py-4">
                                            No products found in the catalog.
                                        </td>
                                    </tr>
                                }

                            </tbody>

                        </table>

                    </div>
                </div>

                <!-- USERS -->
                <div class="tab-pane fade"
                     id="users-pane"
                     role="tabpanel"
                     aria-labelledby="users-tab">

                    <div class="table-responsive">

                        <table class="table table-hover align-middle">

                            <thead>
                                <tr>
                                    <th>Name</th>
                                    <th>Email</th>
                                    <th>Role</th>
                                    <th>Branch Assignment</th>
                                    <th>Status</th>
                                </tr>
                            </thead>

                            <tbody>

                                @{
                                    var users = ViewBag.CompanyUsers as List<ERP_System.Models.User>;
                                }

                                @if (users != null && users.Any())
                                {
                                    foreach (var usr in users)
                                    {
                                        <tr>

                                            <td class="fw-bold text-dark">
                                                @usr.FullName
                                            </td>

                                            <td>
                                                @usr.Email
                                            </td>

                                            <td>
                                                <span class="badge bg-primary-subtle text-primary-emphasis px-3 py-1">
                                                    <i class="fa-solid fa-user-shield me-2"></i>
                                                    @(usr.Role?.RoleName ?? "Employee")
                                                </span>
                                            </td>

                                            <td>
                                                <i class="fa-solid fa-building me-2 text-muted"></i>
                                                @(usr.Branch?.BranchName ?? "Unassigned")
                                            </td>

                                            <td>
                                                @if (usr.IsActive)
                                                {
                                                    <span class="badge bg-success-subtle text-success-emphasis rounded-pill px-3 py-1">
                                                        Active
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-danger-subtle text-danger-emphasis rounded-pill px-3 py-1">
                                                        Inactive
                                                    </span>
                                                }
                                            </td>

                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="5"
                                            class="text-center text-muted py-4">
                                            No employees or users found.
                                        </td>
                                    </tr>
                                }

                            </tbody>

                        </table>

                    </div>
                </div>

                <!-- CUSTOMERS -->
                <div class="tab-pane fade"
                     id="customers-pane"
                     role="tabpanel"
                     aria-labelledby="customers-tab">

                    <div class="table-responsive">

                        <table class="table table-hover align-middle">

                            <thead>
                                <tr>
                                    <th>Customer Name</th>
                                    <th>Email Address</th>
                                    <th>Phone Number</th>
                                    <th>Joined Date</th>
                                    <th>Status</th>
                                </tr>
                            </thead>

                            <tbody>

                                @{
                                    var customers = ViewBag.CompanyCustomers as List<ERP_System.Models.Customer>;
                                }

                                @if (customers != null && customers.Any())
                                {
                                    foreach (var cust in customers)
                                    {
                                        <tr>

                                            <td class="fw-bold text-dark">
                                                @cust.CustomerName
                                            </td>

                                            <td>
                                                @cust.Email
                                            </td>

                                            <td>
                                                @cust.PhoneNumber
                                            </td>

                                            <td>
                                                @(cust.JoinedDate?.ToString("dd MMM yyyy") ?? "N/A")
                                            </td>

                                            <td>
                                                @if (cust.IsActive)
                                                {
                                                    <span class="badge bg-success-subtle text-success-emphasis rounded-pill px-3 py-1">
                                                        Active
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-danger-subtle text-danger-emphasis rounded-pill px-3 py-1">
                                                        Inactive
                                                    </span>
                                                }
                                            </td>

                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="5"
                                            class="text-center text-muted py-4">
                                            No customers registered in the database.
                                        </td>
                                    </tr>
                                }

                            </tbody>

                        </table>

                    </div>
                </div>

            </div>

        </div>

    </div>
}
                                }

                                document.getElementById(
                                    "kpi-capital"
                                ).innerText =
                                    formatCurrency(
                                        data.ownerCapital,
                                        data.currencySymbol
                                    );

                                document.getElementById(
                                    "kpi-balance"
                                ).innerText =
                                    formatCurrency(
                                        data.cashBankBalance,
                                        data.currencySymbol
                                    );

                                document.getElementById(
                                    "kpi-receivable"
                                ).innerText =
                                    formatCurrency(
                                        data.totalReceivable,
                                        data.currencySymbol
                                    );

                                document.getElementById(
                                    "kpi-payable"
                                ).innerText =
                                    formatCurrency(
                                        data.totalPayable,
                                        data.currencySymbol
                                    );

                                /* OPERATIONS */

                                document.getElementById(
                                    "op-sales"
                                ).innerText =
                                    formatCurrency(
                                        data.todaySales,
                                        data.currencySymbol
                                    );

                                document.getElementById(
                                    "op-sales-pending"
                                ).innerText =
                                    formatCurrency(
                                        data.todaySalesPending,
                                        data.currencySymbol
                                    );

                                document.getElementById(
                                    "op-sales-paid"
                                ).innerText =
                                    formatCurrency(
                                        data.todaySalesPaid,
                                        data.currencySymbol
                                    );

                                document.getElementById(
                                    "op-purchases"
                                ).innerText =
                                    formatCurrency(
                                        data.todayPurchases,
                                        data.currencySymbol
                                    );

                                document.getElementById(
                                    "op-purchases-pending"
                                ).innerText =
                                    formatCurrency(
                                        data.todayPurchasesPending,
                                        data.currencySymbol
                                    );

                                document.getElementById(
                                    "op-purchases-paid"
                                ).innerText =
                                    formatCurrency(
                                        data.todayPurchasesPaid,
                                        data.currencySymbol
                                    );

                                /* STAFF */


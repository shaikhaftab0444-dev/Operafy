            --dashboard-success: #16a34a;
            --dashboard-warning: #d97706;
        }

        .premium-dashboard {
            animation: dashboardFadeIn .45s ease;
            padding-bottom: 30px;
        }

        @@keyframes dashboardFadeIn {
            from {
                opacity: 0;
                transform: translateY(10px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        /* =========================
           PAGE HEADER
        ========================== */

        .admin-welcome-card {
            background: linear-gradient(135deg, #ffffff 0%, #f8fbff 100%);
            border: 1px solid var(--dashboard-border);
            border-radius: 20px;
            padding: 24px 28px;
            margin-bottom: 24px;
            position: relative;
            overflow: hidden;
            box-shadow: 0 10px 30px rgba(15, 23, 42, 0.04);
        }

        .admin-welcome-card::before {
            content: "";
            position: absolute;
            width: 240px;
            height: 240px;
            border-radius: 50%;

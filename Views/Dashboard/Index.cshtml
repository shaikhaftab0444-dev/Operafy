                                    pointStyle: 'line',

                                    padding: 18,

                                    font: {

                                        size: 11,

                                        weight: '600'

                                    }

                                }

                            },

                            tooltip: {

                                backgroundColor: '#172033',

                                titleColor: '#ffffff',

                                bodyColor: '#e2e8f0',

                                padding: 11,

                                cornerRadius: 9,

                                displayColors: true

                            }

                        },

                        scales: {

                            y: {

                                beginAtZero: true,

                                grid: {

                                    color:
                                        'rgba(15,23,42,0.045)'

                                },

                                border: {

                                    display: false

                                },

                                ticks: {

                                    color: '#64748b',

                                    font: {

                                        size: 10

                                    }

                                }

                            },

                            x: {

                                grid: {

                                    display: false

                                },

                                border: {

                                    display: false

                                },

                                ticks: {

                                    color: '#64748b',

                                    font: {

                                        size: 10

                                    }

                                }


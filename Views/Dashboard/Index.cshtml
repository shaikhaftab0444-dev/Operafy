            display: grid;
            grid-template-columns: repeat(4, minmax(0, 1fr));
            gap: 18px;
            margin-bottom: 26px;
        }

        .admin-stat-card {
            background: var(--dashboard-card);
            border: 1px solid var(--dashboard-border);

    <!-- ========================================== -->
    <!--         PREMIUM ADMIN DASHBOARD            -->
    <!-- ========================================== -->

    <style>
        :root {
            --dashboard-primary: #2563eb;
            --dashboard-primary-dark: #1d4ed8;

        }

        /* RESPONSIVE */

        @@media (max-width: 1200px) {
            .kpi-row {
                grid-template-columns: repeat(2, 1fr);
            }

            .summary-grid {
                grid-template-columns: repeat(3, 1fr);
            }

            .summary-box:nth-child(3) {
                border-right: none;
            }
        }

        @@media (max-width: 768px) {
            .kpi-row {
                grid-template-columns: 1fr;
            }

            .summary-grid {

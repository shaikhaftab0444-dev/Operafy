            border-radius: 11px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--dashboard-primary);
        }

        /* =========================
           ACTIVITY
        ========================== */

        .activity-list {
            display: flex;
            flex-direction: column;
        }

        .activity-item {
            display: flex;
            align-items: flex-start;
            gap: 13px;
            padding: 13px 0;
            border-bottom: 1px solid #f1f5f9;
        }

        .activity-item:last-child {
            border-bottom: none;
            padding-bottom: 0;
        }

        .activity-icon {
            width: 38px;
            height: 38px;
            min-width: 38px;
            border-radius: 12px;
            background: #f8fafc;
            color: var(--dashboard-primary);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: .85rem;
        }

        .activity-body {
            flex: 1;
            min-width: 0;
        }

        .activity-title {
            color: var(--dashboard-text);
            font-size: .85rem;
            font-weight: 700;
            margin-bottom: 3px;
        }


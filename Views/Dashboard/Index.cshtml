                    </span>

                    <div class="kpi-icon-wrap glow-badge-purple">
                        <i class="fa-solid fa-file-invoice"></i>
                    </div>

                </div>

                <h3 class="fw-bold mb-1 text-dark"
                    id="kpi-receivable">

                    @FormatIndianCurrency(
                                        Model.TotalReceivable,
                                        Model.CurrencySymbol
                                        )


            /* =====================================================
               BRANCH SWITCHER AJAX
            ===================================================== */

            const branchSelect =
                document.getElementById("branchSelectDropdown")
                ||
                document.getElementById("switcherBranchSelect");

            if (branchSelect) {

                branchSelect.removeAttribute("onchange");

                branchSelect.addEventListener("change", function () {

                    const branchId =
                        branchSelect.value;

                    fetch(
                        '/Dashboard/SetActiveBranch',
                        {
                            method: 'POST',

                            headers: {
                                'Content-Type':
                                    'application/x-www-form-urlencoded'
                            },

                            body:
                                `branchId=${branchId}`
                        }
                    )

                    .then(res => res.json())

                    .then(sessionData => {

                        return fetch(
                            `/Dashboard/GetBranchDashboardMetrics?branchId=${branchId}`
                        );

                    })

                    .then(res => res.json())

                    .then(data => {

                        if (data.success) {

                            const dashboardContainer =

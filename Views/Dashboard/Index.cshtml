    </div>

    <!-- Chart.js and Timeline filtering Javascript -->
    <script>
        let finChart;
        const timelineData = {
            '7d': {
                labels: ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'],
                revenue: [12000, 19000, 3000, 5000, 2000, 3000, 15000],
                expenses: [7000, 11000, 5000, 4000, 6000, 2000, 8000]
            },
            'month': {
                labels: ['Week 1', 'Week 2', 'Week 3', 'Week 4'],
                revenue: [450000, 620000, 310000, 780000],
                expenses: [320000, 410000, 250000, 510000]
            },
            'quarter': {
                labels: ['Jun 2026', 'Jul 2026', 'Aug 2026'],
                revenue: [1200000, 1850000, 2450000],
                expenses: [850000, 1100000, 1300000]
            },
            'year': {
                labels: ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'],
                revenue: [1500000, 1800000, 1600000, 2100000, 2400000, 2200000, 2800000, 3000000, 0, 0, 0, 0],
                expenses: [900000, 1100000, 1050000, 1300000, 1500000, 1400000, 1700000, 1800000, 0, 0, 0, 0]
            }
        };

        document.addEventListener("DOMContentLoaded", function () {
            // Render Chart.js
            const ctx = document.getElementById('financialChart').getContext('2d');
            finChart = new Chart(ctx, {
                type: 'line',
                data: {
                    labels: timelineData['year'].labels,
                    datasets: [
                        {
                            label: 'Revenue',
                            data: timelineData['year'].revenue,
                            backgroundColor: 'rgba(59, 130, 246, 0.1)',
                            borderColor: '#3b82f6',
                            borderWidth: 3,
                            fill: true,
                            tension: 0.4
                        },
                        {
                            label: 'Expenses',
                            data: timelineData['year'].expenses,
                            backgroundColor: 'rgba(99, 102, 241, 0.05)',
                            borderColor: '#6366f1',
                            borderWidth: 3,
                            fill: true,
                            tension: 0.4
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { position: 'top' }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            grid: { color: 'rgba(0,0,0,0.04)' }
                        },
                        x: {
                            grid: { display: false }
                        }
                    }
                }
            });

            // Hijack Top Switcher Branch selection for AJAX loading
            const branchSelect = document.getElementById("branchSelectDropdown") || document.getElementById("switcherBranchSelect");
            if (branchSelect) {
                branchSelect.removeAttribute("onchange");
                branchSelect.addEventListener("change", function () {
                    const branchId = branchSelect.value;
                    
                    // 1. Post to SetActiveBranch to update session context
                    fetch('/Dashboard/SetActiveBranch', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/x-www-form-urlencoded'
                        },
                        body: `branchId=${branchId}`
                    })
                    .then(res => res.json())
                    .then(sessionData => {
                        // 2. Fetch updated metrics
                        return fetch(`/Dashboard/GetBranchDashboardMetrics?branchId=${branchId}`);
                    })
                    .then(res => res.json())
                    .then(data => {
                        if (data.success) {
                            // Smooth fade-out before updating DOM
                            const dashboardContainer = document.querySelector(".operational-dashboard");
                            if (dashboardContainer) {
                                dashboardContainer.style.transition = "opacity 0.2s ease";
                                dashboardContainer.style.opacity = "0.5";
                            }

                            setTimeout(() => {
                                // Update global style cache
                                if (data.numberFormattingStyle) {
                                    globalNumberSystem = data.numberFormattingStyle;
                                }

                                // Update all DOM text values (KPI card figures)
                                document.getElementById("kpi-revenue").innerText = formatCurrency(data.currentMonthRevenue, data.currencySymbol, data.numberFormattingStyle);
                                document.getElementById("kpi-expenses").innerText = formatCurrency(data.currentMonthExpenses, data.currencySymbol, data.numberFormattingStyle);
                                document.getElementById("kpi-recovery").innerText = formatCurrency(data.currentMonthRecovery, data.currencySymbol, data.numberFormattingStyle);
                                
                                const profitEl = document.getElementById("kpi-profit");
                                profitEl.innerText = formatCurrency(data.netProfitLoss, data.currencySymbol);
                                if (data.netProfitLoss >= 0) {
                                    profitEl.className = "fw-bold mb-1 text-success";
                                } else {
                                    profitEl.className = "fw-bold mb-1 text-danger";
                                }

                                document.getElementById("kpi-capital").innerText = formatCurrency(data.ownerCapital, data.currencySymbol);
                                document.getElementById("kpi-balance").innerText = formatCurrency(data.cashBankBalance, data.currencySymbol);
                                document.getElementById("kpi-receivable").innerText = formatCurrency(data.totalReceivable, data.currencySymbol);
                                document.getElementById("kpi-payable").innerText = formatCurrency(data.totalPayable, data.currencySymbol);

                                document.getElementById("op-sales").innerText = formatCurrency(data.todaySales, data.currencySymbol);
                                document.getElementById("op-sales-pending").innerText = formatCurrency(data.todaySalesPending, data.currencySymbol);
                                document.getElementById("op-sales-paid").innerText = formatCurrency(data.todaySalesPaid, data.currencySymbol);

                                document.getElementById("op-purchases").innerText = formatCurrency(data.todayPurchases, data.currencySymbol);
                                document.getElementById("op-purchases-pending").innerText = formatCurrency(data.todayPurchasesPending, data.currencySymbol);
                                document.getElementById("op-purchases-paid").innerText = formatCurrency(data.todayPurchasesPaid, data.currencySymbol);

                                // Update active staff counter widget dynamically
                                const staffCountEl = document.querySelector(".bg-primary-subtle.text-primary.border");
                                if (staffCountEl) {
                                    staffCountEl.textContent = `${data.onlineStaff} / ${data.totalStaff} Online`;
                                }

                                // Update Chart.js datasets with the new dynamic arrays
                                finChart.data.labels = data.chartLabels;
                                finChart.data.datasets[0].data = data.chartRevenue;
                                finChart.data.datasets[1].data = data.chartExpenses;
                                finChart.update();

                                // Smooth fade-in
                                if (dashboardContainer) {
                                    dashboardContainer.style.opacity = "1";
                                }
                            }, 200);
                        }
                    })
                    .catch(err => console.error("AJAX switch failed", err));
                });
            }
        });

        let globalNumberSystem = '@Model.NumberFormattingStyle';

        function formatCurrency(value, symbol, numberSystem) {
            let displaySymbol = symbol;
            let isNegative = value < 0;
            let absValue = Math.abs(value);
            let numSys = numberSystem || globalNumberSystem;

            let formatted;
            if (numSys === "Lakhs/Crores") {
                if (absValue >= 10000000) {
                    formatted = (absValue / 10000000).toFixed(2) + " Cr";
                } else if (absValue >= 100000) {
                    formatted = (absValue / 100000).toFixed(2) + " L";
                } else if (absValue >= 10000) {
                    let kVal = absValue / 1000;
                    formatted = (kVal % 1 === 0 ? kVal.toFixed(0) : kVal.toFixed(1)) + " K";
                } else {
                    formatted = absValue.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
                }
            } else {
                if (absValue >= 1000000000) {
                    formatted = (absValue / 1000000000).toFixed(2) + " B";
                } else if (absValue >= 1000000) {
                    formatted = (absValue / 1000000).toFixed(2) + " M";
                } else if (absValue >= 10000) {
                    let kVal = absValue / 1000;
                    formatted = (kVal % 1 === 0 ? kVal.toFixed(0) : kVal.toFixed(1)) + " K";
                } else {
                    formatted = absValue.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
                }
            }

            return (isNegative ? "-" : "") + displaySymbol + " " + formatted;
        }

        // Timeline filters for Chart.js
        function updateChartTimeline(timeline, ev) {
            const data = timelineData[timeline];
            if (data) {
                // Adjust buttons active state
                const buttons = ev.target.parentNode.querySelectorAll("button");
                buttons.forEach(btn => btn.classList.remove("active"));
                ev.target.classList.add("active");

                finChart.data.labels = data.labels;
                finChart.data.datasets[0].data = data.revenue;
                finChart.data.datasets[1].data = data.expenses;
                finChart.update();
            }
        }

        // Live DB backup trigger simulation
        function triggerDBBackup() {
            alert("Database backup trigger sent successfully! Saving erp_backup_" + new Date().toISOString().slice(0,10) + ".bak to secure cloud restore point.");
        }

        // Client side automatic directories lookup filtering
        function filterDirectoryRows() {
            const query = document.getElementById("dirSearchBox").value.toLowerCase().trim();
            const activePane = document.querySelector(".tab-pane.active");
            const rows = activePane.querySelectorAll(".dir-row");

            rows.forEach(row => {
                const searchText = row.getAttribute("data-search-text") || "";
                if (searchText.includes(query)) {
                    row.style.display = "";
                } else {
                    row.style.display = "none";
                }
            });
        }

        // Clear search box on tab change
        document.querySelectorAll('button[data-bs-toggle="pill"]').forEach(tab => {
            tab.addEventListener('shown.bs.tab', function () {
                document.getElementById("dirSearchBox").value = "";
                const activePane = document.querySelector(".tab-pane.active");
                activePane.querySelectorAll(".dir-row").forEach(r => r.style.display = "");
            });
        });
    </script>
}
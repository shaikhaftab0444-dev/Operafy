@section Scripts {
    <!-- Include Local UMD Chart.js for beautiful interactive charts -->
    <script src="~/lib/chart.js/chart.umd.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", () => {
            // 1. Sales Overview Chart Setup
            const salesCtx = document.getElementById('salesChart').getContext('2d');
            new Chart(salesCtx, {
                type: 'line',
                data: {
                    labels: ['01 May', '06 May', '11 May', '16 May', '21 May', '26 May', '31 May'],
                    datasets: [{
                        label: 'This Month',
                        data: [20000, 45000, 60000, 50000, 80000, 75000, 95000],
                        borderColor: '#4f46e5',
                        backgroundColor: 'rgba(79, 70, 229, 0.05)',
                        borderWidth: 2.5,
                        pointRadius: 4,
                        pointBackgroundColor: '#4f46e5',
                        pointHoverRadius: 6,
                        tension: 0.35,
                        fill: true
                    }, {
                        label: 'Last Month',
                        data: [15000, 32000, 48000, 38000, 62000, 55000, 78000],
                        borderColor: '#a19688',
                        backgroundColor: 'transparent',
                        borderWidth: 2,
                        borderDash: [5, 5],
                        pointRadius: 3,
                        pointBackgroundColor: '#a19688',
                        tension: 0.35,
                        fill: false
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            position: 'top',
                            labels: {
                                usePointStyle: true,
                                boxWidth: 6,
                                font: { size: 11, weight: 600 }
                            }
                        }
                    },
                    scales: {
                        y: {
                            grid: { color: '#faf6f0' },
                            ticks: {
                                font: { size: 10 },
                                callback: function(value) { return '₹' + (value / 1000) + 'K'; }
                            }
                        },
                        x: {
                            grid: { display: false },
                            ticks: { font: { size: 10 } }
                        }
                    }
                }
            });

            // 2. Stock Summary Chart Setup
            const stockCtx = document.getElementById('stockChart').getContext('2d');
            new Chart(stockCtx, {
                type: 'doughnut',
                data: {
                    labels: ['In Stock', 'Low Stock', 'Out of Stock'],
                    datasets: [{
                        data: [@Model.InStockQty, @Model.LowStockQty, @Model.OutOfStockQty],
                        backgroundColor: ['#10b981', '#d97706', '#ef4444'],
                        borderWidth: 2,
                        borderColor: '#ffffff',
                        hoverOffset: 4
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    cutout: '70%',
                    plugins: {
                        legend: { display: false }
                    }
                }
            });
        });
    </script>
}

            background: #f5f3ff;
            color: #7c3aed;
        }

        .stat-icon-green {
            background: #ecfdf5;
            color: #16a34a;
        }

        .stat-icon-orange {
            background: #fff7ed;
            color: #ea580c;
        }

        .admin-stat-value {
            font-size: 1.7rem;
            font-weight: 800;
            color: var(--dashboard-text);
            line-height: 1;
            margin-bottom: 6px;
        }

        .admin-stat-bottom {
            font-size: .78rem;
            color: var(--dashboard-muted);
        }

        /* =========================
           QUICK ACTIONS
        ========================== */


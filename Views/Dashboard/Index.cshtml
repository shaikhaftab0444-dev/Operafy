@model ERP_System.Models.DashboardViewModel

@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Dashboard";
    var inCulture = new System.Globalization.CultureInfo("en-IN");
}

@if (User.IsInRole("Admin"))
{
    <!-- ========================================== -->
    <!--         PREMIUM ADMIN DASHBOARD            -->
    <!-- ========================================== -->

    <style>
        :root {
            --dashboard-primary: #2563eb;
            --dashboard-primary-dark: #1d4ed8;
            --dashboard-text: #1e293b;
            --dashboard-muted: #64748b;
            --dashboard-border: #e5e7eb;
            --dashboard-bg: #f8fafc;
            --dashboard-card: #ffffff;
            --dashboard-success: #16a34a;
            --dashboard-warning: #d97706;
        }

        .premium-dashboard {
            animation: dashboardFadeIn .45s ease;
            padding-bottom: 30px;
        }

        @@keyframes dashboardFadeIn {
            from {
                opacity: 0;
                transform: translateY(10px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        /* =========================
           PAGE HEADER
        ========================== */

        .admin-welcome-card {
            background: linear-gradient(135deg, #ffffff 0%, #f8fbff 100%);
            border: 1px solid var(--dashboard-border);
            border-radius: 20px;
            padding: 24px 28px;
            margin-bottom: 24px;
            position: relative;
            overflow: hidden;
            box-shadow: 0 10px 30px rgba(15, 23, 42, 0.04);
        }

        .admin-welcome-card::before {
            content: "";
            position: absolute;
            width: 240px;
            height: 240px;
            border-radius: 50%;
            background: rgba(37, 99, 235, 0.05);
            right: -90px;
            top: -110px;
        }

        .admin-welcome-content {
            position: relative;
            z-index: 2;
        }

        .admin-page-title {
            color: var(--dashboard-text);
            font-size: 1.7rem;
            font-weight: 800;
            margin: 0 0 6px;
            letter-spacing: -0.4px;
        }

        .admin-page-subtitle {
            color: var(--dashboard-muted);
            font-size: .92rem;
            margin: 0;
        }

        .admin-page-subtitle strong {
            color: var(--dashboard-primary);
            font-weight: 700;
        }

        /* =========================
           OVERVIEW STATS
        ========================== */

        .admin-stat-grid {
            display: grid;
            grid-template-columns: repeat(4, minmax(0, 1fr));
            gap: 18px;
            margin-bottom: 26px;
        }

        .admin-stat-card {
            background: var(--dashboard-card);
            border: 1px solid var(--dashboard-border);
            border-radius: 18px;
            padding: 20px;
            position: relative;
            overflow: hidden;
            transition: all .25s ease;
            animation: cardEntrance .5s ease both;
        }

        .admin-stat-card:nth-child(2) {
            animation-delay: .05s;
        }

        .admin-stat-card:nth-child(3) {
            animation-delay: .1s;
        }

        .admin-stat-card:nth-child(4) {
            animation-delay: .15s;
        }

        @@keyframes cardEntrance {
            from {
                opacity: 0;
                transform: translateY(14px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .admin-stat-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 18px 35px rgba(15, 23, 42, .08);
            border-color: #cbd5e1;
        }

        .admin-stat-top {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 15px;
        }

        .admin-stat-label {
            color: var(--dashboard-muted);
            font-size: .8rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: .4px;
        }

        .admin-stat-icon {
            width: 46px;
            height: 46px;
            border-radius: 14px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.1rem;
        }

        .stat-icon-blue {
            background: #eff6ff;
            color: #2563eb;
        }

        .stat-icon-purple {
            background: #f5f3ff;
            color: #7c3aed;
        }

        .stat-icon-green {
            background: #ecfdf5;
            color: #16a34a;
        }

        .stat-icon-orange {
            background: #fff7ed;
            color: #ea580c;
        }

        .admin-stat-value {
            font-size: 1.7rem;
            font-weight: 800;
            color: var(--dashboard-text);
            line-height: 1;
            margin-bottom: 6px;
        }

        .admin-stat-bottom {
            font-size: .78rem;
            color: var(--dashboard-muted);
        }

        /* =========================
           QUICK ACTIONS
        ========================== */

        .dashboard-section {
            margin-bottom: 26px;
        }

        .section-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 15px;
        }

        .section-title {
            font-size: 1.05rem;
            font-weight: 800;
            color: var(--dashboard-text);
            margin: 0;
        }

        .section-subtitle {
            font-size: .8rem;
            color: var(--dashboard-muted);
            margin-top: 3px;
        }

        .portal-grid {
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 18px;
        }

        .portal-card {
            display: flex;
            align-items: center;
            gap: 16px;
            background: #ffffff;
            border: 1px solid var(--dashboard-border);
            border-radius: 18px;
            padding: 20px;
            text-decoration: none !important;
            color: inherit;
            transition: all .25s ease;
            position: relative;
            overflow: hidden;
        }

        .portal-card::after {
            content: "";
            position: absolute;
            inset: 0;
            background: linear-gradient(135deg, transparent, rgba(37, 99, 235, .025));
            opacity: 0;
            transition: opacity .25s ease;
        }

        .portal-card:hover {
            transform: translateY(-5px);
            border-color: #bfdbfe;
            box-shadow: 0 16px 30px rgba(15, 23, 42, .07);
        }

        .portal-card:hover::after {
            opacity: 1;
        }

        .portal-icon-wrap {
            width: 52px;
            height: 52px;
            min-width: 52px;
            border-radius: 16px;
            background: linear-gradient(135deg, #eff6ff, #f8fbff);
            color: var(--dashboard-primary);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.25rem;
            position: relative;
            z-index: 1;
        }

        .portal-info {
            min-width: 0;
            position: relative;
            z-index: 1;
        }

        .portal-name {
            font-size: .95rem;
            font-weight: 800;
            color: var(--dashboard-text);
            margin-bottom: 5px;
        }

        .portal-desc {
            color: var(--dashboard-muted);
            font-size: .78rem;
            line-height: 1.5;
        }

        .portal-arrow {
            margin-left: auto;
            color: #94a3b8;
            font-size: .8rem;
            position: relative;
            z-index: 1;
            transition: transform .25s ease;
        }

        .portal-card:hover .portal-arrow {
            color: var(--dashboard-primary);
            transform: translateX(4px);
        }

        /* =========================
           PANELS
        ========================== */

        .admin-panel {
            background: #ffffff;
            border: 1px solid var(--dashboard-border);
            border-radius: 20px;
            padding: 22px;
            height: 100%;
            box-shadow: 0 8px 24px rgba(15, 23, 42, .025);
        }

        .admin-panel-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding-bottom: 15px;
            margin-bottom: 18px;
            border-bottom: 1px solid #f1f5f9;
        }

        .admin-panel-title {
            color: var(--dashboard-text);
            font-size: 1rem;
            font-weight: 800;
            margin: 0;
        }

        .panel-icon {
            width: 36px;
            height: 36px;
            background: #f8fafc;
            border-radius: 11px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--dashboard-primary);
        }

        /* =========================
           ACTIVITY
        ========================== */

        .activity-list {
            display: flex;
            flex-direction: column;
        }

        .activity-item {
            display: flex;
            align-items: flex-start;
            gap: 13px;
            padding: 13px 0;
            border-bottom: 1px solid #f1f5f9;
        }

        .activity-item:last-child {
            border-bottom: none;
            padding-bottom: 0;
        }

        .activity-icon {
            width: 38px;
            height: 38px;
            min-width: 38px;
            border-radius: 12px;
            background: #f8fafc;
            color: var(--dashboard-primary);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: .85rem;
        }

        .activity-body {
            flex: 1;
            min-width: 0;
        }

        .activity-title {
            color: var(--dashboard-text);
            font-size: .85rem;
            font-weight: 700;
            margin-bottom: 3px;
        }

        .activity-description {
            color: var(--dashboard-muted);
            font-size: .76rem;
            line-height: 1.45;
        }

        .activity-time {
            color: #94a3b8;
            font-size: .72rem;
            white-space: nowrap;
        }

        /* =========================
           DATABASE SUMMARY
        ========================== */

        .stat-list-item {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            padding: 15px 0;
            border-bottom: 1px solid #f1f5f9;
        }

        .stat-list-item:last-child {
            border-bottom: none;
            padding-bottom: 0;
        }

        .stat-item-left {
            display: flex;
            align-items: center;
            gap: 11px;
        }

        .stat-item-icon {
            width: 36px;
            height: 36px;
            border-radius: 11px;
            background: #f8fafc;
            color: #64748b;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: .8rem;
        }

        .stat-item-label {
            color: #475569;
            font-size: .82rem;
            font-weight: 600;
        }

        .stat-item-val {
            color: var(--dashboard-text);
            font-size: 1rem;
            font-weight: 800;
        }

        /* =========================
           RESPONSIVE
        ========================== */

        @@media (max-width: 1200px) {
            .admin-stat-grid {
                grid-template-columns: repeat(2, 1fr);
            }
        }

        @@media (max-width: 992px) {
            .portal-grid {
                grid-template-columns: repeat(2, 1fr);
            }
        }

        @@media (max-width: 576px) {
            .admin-welcome-card {
                padding: 20px;
            }

            .admin-page-title {
                font-size: 1.35rem;
            }

            .admin-stat-grid,
            .portal-grid {
                grid-template-columns: 1fr;
            }

            .portal-card {
                padding: 17px;
            }
        }
    </style>

    <div class="premium-dashboard">

        <!-- WELCOME HEADER -->
        <div class="admin-welcome-card">
            <div class="admin-welcome-content">
                <h2 class="admin-page-title">
                    System Administration
                </h2>

                <p class="admin-page-subtitle">
                    Welcome back, <strong>@Model.CurrentUserFullName</strong>.
                    Monitor users, companies and system configuration from one place.
                </p>
            </div>
        </div>

        <!-- ADMIN OVERVIEW -->
        <div class="admin-stat-grid">

            <div class="admin-stat-card">
                <div class="admin-stat-top">
                    <span class="admin-stat-label">Companies</span>
                    <div class="admin-stat-icon stat-icon-blue">
                        <i class="fa-solid fa-building"></i>
                    </div>
                </div>

                <div class="admin-stat-value">@ViewBag.TotalCompanies</div>
                <div class="admin-stat-bottom">Registered companies</div>
            </div>

            <div class="admin-stat-card">
                <div class="admin-stat-top">
                    <span class="admin-stat-label">Users</span>
                    <div class="admin-stat-icon stat-icon-purple">
                        <i class="fa-solid fa-users"></i>
                    </div>
                </div>

                <div class="admin-stat-value">@ViewBag.TotalUsers</div>
                <div class="admin-stat-bottom">System user accounts</div>
            </div>

            <div class="admin-stat-card">
                <div class="admin-stat-top">
                    <span class="admin-stat-label">Products</span>
                    <div class="admin-stat-icon stat-icon-green">
                        <i class="fa-solid fa-box-open"></i>
                    </div>
                </div>

                <div class="admin-stat-value">@Model.TotalProducts</div>
                <div class="admin-stat-bottom">Products in catalog</div>
            </div>

            <div class="admin-stat-card">
                <div class="admin-stat-top">
                    <span class="admin-stat-label">System Roles</span>
                    <div class="admin-stat-icon stat-icon-orange">
                        <i class="fa-solid fa-user-shield"></i>
                    </div>
                </div>

                <div class="admin-stat-value">@ViewBag.TotalRoles</div>
                <div class="admin-stat-bottom">Access roles configured</div>
            </div>

        </div>

        <!-- QUICK ACCESS -->
        <div class="dashboard-section">
            <div class="section-header">
                <div>
                    <h4 class="section-title">Administration Center</h4>
                    <div class="section-subtitle">
                        Quick access to important system configuration areas
                    </div>
                </div>
            </div>

            <div class="portal-grid">

                <!-- ROLES -->
                <a href="/Roles" class="portal-card">
                    <div class="portal-icon-wrap">
                        <i class="fa-solid fa-user-shield"></i>
                    </div>

                    <div class="portal-info">
                        <div class="portal-name">User Types & Roles</div>
                        <div class="portal-desc">
                            Manage roles, permissions and system access levels.
                        </div>
                    </div>

                    <i class="fa-solid fa-arrow-right portal-arrow"></i>
                </a>

                <!-- USERS -->
                <a href="/UserAccounts" class="portal-card">
                    <div class="portal-icon-wrap">
                        <i class="fa-solid fa-users"></i>
                    </div>

                    <div class="portal-info">
                        <div class="portal-name">User Directory</div>
                        <div class="portal-desc">
                            Manage user accounts, login details and assignments.
                        </div>
                    </div>

                    <i class="fa-solid fa-arrow-right portal-arrow"></i>
                </a>

                <!-- COMPANIES -->
                <a href="/Company" class="portal-card">
                    <div class="portal-icon-wrap">
                        <i class="fa-solid fa-building"></i>
                    </div>

                    <div class="portal-info">
                        <div class="portal-name">Companies</div>
                        <div class="portal-desc">
                            Manage company information and enterprise settings.
                        </div>
                    </div>

                    <i class="fa-solid fa-arrow-right portal-arrow"></i>
                </a>

                <!-- COMPANY REGISTRATION -->
                <a href="/Company/Create" class="portal-card">
                    <div class="portal-icon-wrap">
                        <i class="fa-solid fa-folder-plus"></i>
                    </div>

                    <div class="portal-info">
                        <div class="portal-name">Company Registration</div>
                        <div class="portal-desc">
                            Register and configure a new enterprise company.
                        </div>
                    </div>

                    <i class="fa-solid fa-arrow-right portal-arrow"></i>
                </a>

                <!-- ACCOUNT HEADS -->
                <a href="/AccountHeads" class="portal-card">
                    <div class="portal-icon-wrap">
                        <i class="fa-solid fa-wallet"></i>
                    </div>

                    <div class="portal-info">
                        <div class="portal-name">Account Heads</div>
                        <div class="portal-desc">
                            Configure accounting heads and ledger categories.
                        </div>
                    </div>

                    <i class="fa-solid fa-arrow-right portal-arrow"></i>
                </a>

                <!-- FINANCIAL YEAR -->
                <a href="/FinancialYear" class="portal-card">
                    <div class="portal-icon-wrap">
                        <i class="fa-solid fa-calendar-days"></i>
                    </div>

                    <div class="portal-info">
                        <div class="portal-name">Financial Year</div>
                        <div class="portal-desc">
                            Manage fiscal calendars and active financial years.
                        </div>
                    </div>

                    <i class="fa-solid fa-arrow-right portal-arrow"></i>
                </a>

            </div>
        </div>

        <!-- ACTIVITY + SUMMARY -->
        <div class="row g-4">

            <!-- RECENT ACTIVITY -->
            <div class="col-lg-7">
                <div class="admin-panel">

                    <div class="admin-panel-header">
                        <div>
                            <h5 class="admin-panel-title">
                                Recent Administrative Activity
                            </h5>
                        </div>

                        <div class="panel-icon">
                            <i class="fa-solid fa-clock-rotate-left"></i>
                        </div>
                    </div>

                    <div class="activity-list">

                        @if (Model.RecentActivities != null && Model.RecentActivities.Any())
                        {
                            foreach (var activity in Model.RecentActivities)
                            {
                                var timeDiff = DateTime.UtcNow - activity.CreatedAt.ToUniversalTime();

                                var timeStr =
                                    timeDiff.TotalMinutes < 1 ? "Just now" :
                                    timeDiff.TotalMinutes < 60 ? $"{(int)timeDiff.TotalMinutes} min ago" :
                                    timeDiff.TotalHours < 24 ? $"{(int)timeDiff.TotalHours} hour ago" :
                                    $"{(int)timeDiff.TotalDays} day(s) ago";

                                <div class="activity-item">

                                    <div class="activity-icon @activity.ColorClass">
                                        <i class="fa-solid @activity.IconClass"></i>
                                    </div>

                                    <div class="activity-body">
                                        <div class="activity-title">
                                            @activity.Title
                                        </div>

                                        <div class="activity-description">
                                            @activity.Description
                                        </div>
                                    </div>

                                    <div class="activity-time">
                                        @timeStr
                                    </div>

                                </div>
                            }
                        }
                        else
                        {
                            <div class="text-center text-muted py-4">
                                <i class="fa-regular fa-folder-open fa-2x mb-3"></i>
                                <div>No recent administrative activity found.</div>
                            </div>
                        }

                    </div>
                </div>
            </div>

            <!-- DATABASE SUMMARY -->
            <div class="col-lg-5">
                <div class="admin-panel">

                    <div class="admin-panel-header">
                        <h5 class="admin-panel-title">
                            Database Summary
                        </h5>

                        <div class="panel-icon">
                            <i class="fa-solid fa-chart-pie"></i>
                        </div>
                    </div>

                    <div class="stat-list-item">
                        <div class="stat-item-left">
                            <div class="stat-item-icon">
                                <i class="fa-solid fa-building"></i>
                            </div>

                            <span class="stat-item-label">
                                Registered Companies
                            </span>
                        </div>

                        <span class="stat-item-val">
                            @ViewBag.TotalCompanies
                        </span>
                    </div>

                    <div class="stat-list-item">
                        <div class="stat-item-left">
                            <div class="stat-item-icon">
                                <i class="fa-solid fa-users"></i>
                            </div>

                            <span class="stat-item-label">
                                User Credentials
                            </span>
                        </div>

                        <span class="stat-item-val">
                            @ViewBag.TotalUsers
                        </span>
                    </div>

                    <div class="stat-list-item">
                        <div class="stat-item-left">
                            <div class="stat-item-icon">
                                <i class="fa-solid fa-user-shield"></i>
                            </div>

                            <span class="stat-item-label">
                                System Roles
                            </span>
                        </div>

                        <span class="stat-item-val">
                            @ViewBag.TotalRoles
                        </span>
                    </div>

                    <div class="stat-list-item">
                        <div class="stat-item-left">
                            <div class="stat-item-icon">
                                <i class="fa-solid fa-wallet"></i>
                            </div>

                            <span class="stat-item-label">
                                Account Heads
                            </span>
                        </div>

                        <span class="stat-item-val">
                            @ViewBag.TotalAccountHeads
                        </span>
                    </div>

                    <div class="stat-list-item">
                        <div class="stat-item-left">
                            <div class="stat-item-icon">
                                <i class="fa-solid fa-box-open"></i>
                            </div>

                            <span class="stat-item-label">
                                Products Catalog
                            </span>
                        </div>

                        <span class="stat-item-val">
                            @Model.TotalProducts
                        </span>
                    </div>

                </div>
            </div>

        </div>

    </div>
}
else
{
    <!-- ========================================== -->
    <!--       PREMIUM OPERATIONAL DASHBOARD        -->
    <!-- ========================================== -->

    <style>
        .operational-dashboard {
            padding-bottom: 40px;
            animation: operationalFade .5s ease;
        }

        @@keyframes operationalFade {
            from {
                opacity: 0;
                transform: translateY(10px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        /* HEADER */

        .dashboard-title-bar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 24px;
        }

        .dashboard-title {
            font-size: 1.7rem;
            font-weight: 800;
            color: #1e293b;
            margin: 0;
            letter-spacing: -.4px;
        }

        .dashboard-subtitle {
            font-size: .86rem;
            color: #64748b;
            margin-top: 5px;
        }

        /* KPI */

        .kpi-row {
            display: grid;
            grid-template-columns: repeat(4, minmax(0, 1fr));
            gap: 18px;
            margin-bottom: 26px;
        }

        .screenshot-card {
            background: #ffffff;
            border: 1px solid #e5e7eb;
            border-radius: 18px;
            padding: 19px;
            min-height: 138px;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            color: #1e293b !important;
            box-shadow: 0 8px 20px rgba(15, 23, 42, .025);
            transition: all .25s ease;
            position: relative;
            overflow: hidden;
        }

        .screenshot-card::before {
            content: "";
            position: absolute;
            width: 90px;
            height: 90px;
            right: -25px;
            top: -25px;
            border-radius: 50%;
            opacity: .5;
        }

        .screenshot-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 18px 32px rgba(15, 23, 42, .08);
        }

        .card-left-block {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
        }

        .card-left-month {
            font-size: .76rem;
            font-weight: 700;
            color: #64748b;
        }

        .card-left-year {
            font-size: .82rem;
            font-weight: 700;
            color: #64748b;
        }

        .card-left-icon {
            width: 45px;
            height: 45px;
            border-radius: 14px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.1rem;
        }

        .card-right-block {
            margin-top: 10px;
        }

        .card-val {
            font-size: clamp(1.05rem, 1.5vw, 1.5rem);
            font-weight: 800;
            color: #1e293b;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .card-label {
            font-size: .76rem;
            color: #64748b;
            font-weight: 600;
            margin-top: 5px;
        }

        /* WHITE CARD ACCENT COLORS */


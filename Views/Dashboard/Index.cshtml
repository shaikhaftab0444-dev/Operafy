@model ERP_System.Models.DashboardViewModel

@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Dashboard";
    var inCulture = new System.Globalization.CultureInfo("en-IN");

    var monthParts = Model.ActiveMonthName?.Split(' ') ?? Array.Empty<string>();
    var monthName = monthParts.Length > 0 ? monthParts[0] : "";
    var yearName = monthParts.Length > 1 ? monthParts[1] : "";

    string FormatIndianCurrency(decimal value, string symbol)
    {
        string displaySymbol = symbol;
        bool isNegative = value < 0;
        decimal absValue = Math.Abs(value);

        string formatted;

        if (Model.NumberFormattingStyle == "Lakhs/Crores")
        {
            if (absValue >= 10000000m)
                formatted = $"{(absValue / 10000000m):F2} Cr";
            else if (absValue >= 100000m)
                formatted = $"{(absValue / 100000m):F2} L";
            else if (absValue >= 10000m)
            {
                decimal kVal = absValue / 1000m;
                formatted = kVal % 1 == 0
                    ? $"{kVal:F0} K"
                    : $"{kVal:F1} K";
            }
            else
                formatted = absValue.ToString(
                    "N2",
                    new System.Globalization.CultureInfo("en-IN")
                );
        }
        else
        {
            if (absValue >= 1000000000m)
                formatted = $"{(absValue / 1000000000m):F2} B";
            else if (absValue >= 1000000m)
                formatted = $"{(absValue / 1000000m):F2} M";
            else if (absValue >= 10000m)
            {
                decimal kVal = absValue / 1000m;
                formatted = kVal % 1 == 0
                    ? $"{kVal:F0} K"
                    : $"{kVal:F1} K";
            }
            else
                formatted = absValue.ToString(
                    "N2",
                    new System.Globalization.CultureInfo("en-US")
                );
        }

        return isNegative
            ? $"-{displaySymbol} {formatted}"
            : $"{displaySymbol} {formatted}";
    }
}

@if (User.IsInRole("Admin"))
{
    <!-- ========================================================= -->
    <!--                    PREMIUM ADMIN DASHBOARD                -->
    <!-- ========================================================= -->

    <style>
        :root {
            --dashboard-primary: #2563eb;
            --dashboard-primary-dark: #1d4ed8;
            --dashboard-primary-soft: #eff6ff;
            --dashboard-text: #172033;
            --dashboard-text-soft: #334155;
            --dashboard-muted: #64748b;
            --dashboard-border: #e7ebf2;
            --dashboard-border-soft: #eef2f7;
            --dashboard-bg: #f7f9fc;
            --dashboard-card: #ffffff;
            --dashboard-success: #16a34a;
            --dashboard-warning: #d97706;
            --dashboard-danger: #dc2626;
            --dashboard-radius: 18px;
            --dashboard-shadow: 0 8px 30px rgba(15, 23, 42, 0.045);
            --dashboard-shadow-hover: 0 18px 42px rgba(15, 23, 42, 0.09);
        }

        .premium-dashboard {
            padding: 4px 2px 35px;
            animation: dashboardPageEnter .55s cubic-bezier(.22, 1, .36, 1) both;
        }

        @@keyframes dashboardPageEnter {
            from {
                opacity: 0;
                transform: translateY(12px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        /* =========================================================
                   WELCOME HEADER
                ========================================================= */

        .admin-welcome-card {
            position: relative;
            overflow: hidden;
            background: linear-gradient(135deg, #ffffff 0%, #f8fbff 58%, #f2f7ff 100%);
            border: 1px solid var(--dashboard-border);
            border-radius: 22px;
            padding: 28px 30px;
            margin-bottom: 24px;
            box-shadow: var(--dashboard-shadow);
        }

            .admin-welcome-card::before {
                content: "";
                position: absolute;
                width: 280px;
                height: 280px;
                border-radius: 50%;
                background: rgba(37, 99, 235, .055);
                right: -110px;
                top: -150px;
                pointer-events: none;
            }

            .admin-welcome-card::after {
                content: "";
                position: absolute;
                width: 120px;
                height: 120px;
                border-radius: 50%;
                background: rgba(99, 102, 241, .035);
                right: 180px;
                bottom: -90px;
                pointer-events: none;
            }

        .admin-welcome-content {
            position: relative;
            z-index: 2;
        }

        .admin-welcome-top {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 20px;
        }

        .admin-title-wrap {
            display: flex;
            align-items: center;
            gap: 14px;
        }

        .admin-title-icon {
            width: 48px;
            height: 48px;
            border-radius: 15px;
            background: linear-gradient(135deg, #2563eb, #4f7df3);
            color: #ffffff;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.05rem;
            box-shadow: 0 9px 22px rgba(37, 99, 235, .2);
            transition: transform .3s ease, box-shadow .3s ease;
        }

        .admin-welcome-card:hover .admin-title-icon {
            transform: translateY(-2px) rotate(-3deg);
            box-shadow: 0 13px 28px rgba(37, 99, 235, .25);
        }

        .admin-page-title {
            color: var(--dashboard-text);
            font-size: 1.55rem;
            font-weight: 800;
            margin: 0 0 5px;
            letter-spacing: -.45px;
        }

        .admin-page-subtitle {
            color: var(--dashboard-muted);
            font-size: .88rem;
            margin: 0;
        }

            .admin-page-subtitle strong {
                color: var(--dashboard-primary);
                font-weight: 750;
            }

        .admin-live-status {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            white-space: nowrap;
            background: rgba(255,255,255,.78);
            border: 1px solid var(--dashboard-border);
            border-radius: 999px;
            padding: 8px 13px;
            color: #475569;
            font-size: .72rem;
            font-weight: 700;
            letter-spacing: .25px;
            box-shadow: 0 4px 12px rgba(15,23,42,.035);
        }

        .admin-live-dot {
            width: 7px;
            height: 7px;
            border-radius: 50%;
            background: #16a34a;
            box-shadow: 0 0 0 0 rgba(22,163,74,.35);
            animation: adminPulse 2s infinite;
        }

        @@keyframes adminPulse {
            0% {
                box-shadow: 0 0 0 0 rgba(22,163,74,.35);
            }

            70% {
                box-shadow: 0 0 0 7px rgba(22,163,74,0);
            }

            100% {
                box-shadow: 0 0 0 0 rgba(22,163,74,0);
            }
        }

        /* =========================================================
                   SECTION HEADER
                ========================================================= */

        .dashboard-section {
            margin-bottom: 26px;
        }

        .section-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 14px;
        }

        .section-title {
            font-size: 1rem;
            font-weight: 800;
            color: var(--dashboard-text);
            margin: 0;
        }

        .section-subtitle {
            font-size: .77rem;
            color: var(--dashboard-muted);
            margin-top: 4px;
        }

        /* =========================================================
                   ADMIN STAT CARDS
                ========================================================= */

        .admin-stat-grid {
            display: grid;
            grid-template-columns: repeat(4, minmax(0, 1fr));
            gap: 16px;
            margin-bottom: 26px;
        }

        .admin-stat-card {
            position: relative;
            overflow: hidden;
            background: var(--dashboard-card);
            border: 1px solid var(--dashboard-border);
            border-radius: var(--dashboard-radius);
            padding: 20px;
            box-shadow: var(--dashboard-shadow);
            transition: transform .3s cubic-bezier(.22, 1, .36, 1), box-shadow .3s ease, border-color .3s ease;
            animation: dashboardCardEnter .55s cubic-bezier(.22, 1, .36, 1) both;
        }

            .admin-stat-card::after {
                content: "";
                position: absolute;
                width: 90px;
                height: 90px;
                border-radius: 50%;
                right: -40px;
                bottom: -45px;
                background: rgba(37, 99, 235, .035);
                transition: transform .4s ease;
            }

            .admin-stat-card:hover {
                transform: translateY(-5px);
                box-shadow: var(--dashboard-shadow-hover);
                border-color: #d7deea;
            }

                .admin-stat-card:hover::after {
                    transform: scale(1.45);
                }

            .admin-stat-card:nth-child(1) {
                animation-delay: .05s;
            }

            .admin-stat-card:nth-child(2) {
                animation-delay: .10s;
            }

            .admin-stat-card:nth-child(3) {
                animation-delay: .15s;
            }

            .admin-stat-card:nth-child(4) {
                animation-delay: .20s;
            }

        @@keyframes dashboardCardEnter {
            from {
                opacity: 0;
                transform: translateY(16px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .admin-stat-top {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 17px;
            position: relative;
            z-index: 2;
        }

        .admin-stat-label {
            color: #718096;
            font-size: .71rem;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: .65px;
        }

        .admin-stat-icon {
            width: 43px;
            height: 43px;
            border-radius: 13px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1rem;
            transition: transform .3s ease, box-shadow .3s ease;
        }

        .admin-stat-card:hover .admin-stat-icon {
            transform: scale(1.08) rotate(-3deg);
        }

        .stat-icon-blue {
            background: #eff6ff;
            color: #2563eb;
        }

        .stat-icon-purple {
            background: #f5f3ff;
            color: #7c3aed;
        }

        .stat-icon-green {
            background: #ecfdf5;
            color: #16a34a;
        }

        .stat-icon-orange {
            background: #fff7ed;
            color: #ea580c;
        }

        .admin-stat-value {
            position: relative;
            z-index: 2;
            font-size: 1.72rem;
            font-weight: 800;
            color: var(--dashboard-text);
            line-height: 1.1;
            margin-bottom: 7px;
            letter-spacing: -.5px;
        }

        .admin-stat-bottom {
            position: relative;
            z-index: 2;
            font-size: .75rem;
            color: var(--dashboard-muted);
        }

        /* =========================================================
                   QUICK ACCESS PORTALS
                ========================================================= */

        .portal-grid {
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 16px;
        }

        .portal-card {
            display: flex;
            align-items: center;
            gap: 14px;
            position: relative;
            overflow: hidden;
            background: #ffffff;
            border: 1px solid var(--dashboard-border);
            border-radius: 17px;
            padding: 18px;
            text-decoration: none !important;
            color: inherit;
            box-shadow: 0 5px 20px rgba(15,23,42,.025);
            transition: transform .3s cubic-bezier(.22,1,.36,1), box-shadow .3s ease, border-color .3s ease;
        }

            .portal-card::before {
                content: "";
                position: absolute;
                inset: 0;
                background: linear-gradient( 120deg, rgba(37,99,235,0), rgba(37,99,235,.045) );
                opacity: 0;
                transition: opacity .3s ease;
            }

            .portal-card:hover {
                transform: translateY(-4px);
                border-color: #cbdaf5;
                box-shadow: 0 15px 32px rgba(15,23,42,.075);
            }

                .portal-card:hover::before {
                    opacity: 1;
                }

        .portal-icon-wrap {
            width: 47px;
            height: 47px;
            min-width: 47px;
            border-radius: 14px;
            background: linear-gradient(135deg, #eff6ff, #f8fbff);
            color: var(--dashboard-primary);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.05rem;
            position: relative;
            z-index: 2;
            transition: transform .3s ease, background .3s ease;
        }

        .portal-card:hover .portal-icon-wrap {
            transform: scale(1.07);
            background: #eff6ff;
        }

        .portal-info {
            min-width: 0;
            position: relative;
            z-index: 2;
        }

        .portal-name {
            font-size: .87rem;
            font-weight: 800;
            color: var(--dashboard-text);
            margin-bottom: 4px;
        }

        .portal-desc {
            color: var(--dashboard-muted);
            font-size: .73rem;
            line-height: 1.45;
        }

        .portal-arrow {
            margin-left: auto;
            color: #a1aabd;
            font-size: .75rem;
            position: relative;
            z-index: 2;
            transition: transform .3s ease, color .3s ease;
        }

        .portal-card:hover .portal-arrow {
            color: var(--dashboard-primary);
            transform: translateX(4px);
        }

        /* =========================================================
                   PANELS
                ========================================================= */

        .admin-panel {
            background: #ffffff;
            border: 1px solid var(--dashboard-border);
            border-radius: 19px;
            padding: 21px;
            height: 100%;
            box-shadow: var(--dashboard-shadow);
            transition: box-shadow .3s ease, transform .3s ease;
        }

            .admin-panel:hover {
                box-shadow: 0 13px 34px rgba(15,23,42,.065);
            }

        .admin-panel-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding-bottom: 14px;
            margin-bottom: 7px;
            border-bottom: 1px solid #f1f4f8;
        }

        .admin-panel-title {
            color: var(--dashboard-text);
            font-size: .94rem;
            font-weight: 800;
            margin: 0;
        }

        .panel-icon {
            width: 35px;
            height: 35px;
            background: #f7f9fc;
            border: 1px solid #eef2f7;
            border-radius: 11px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--dashboard-primary);
            transition: transform .3s ease, background .3s ease;
        }

        .admin-panel:hover .panel-icon {
            transform: rotate(-4deg);
            background: #eff6ff;
        }

        /* =========================================================
                   ACTIVITY
                ========================================================= */

        .activity-list {
            display: flex;
            flex-direction: column;
        }

        .activity-item {
            display: flex;
            align-items: flex-start;
            gap: 12px;
            padding: 13px 7px;
            border-bottom: 1px solid #f1f4f8;
            border-radius: 10px;
            transition: background .25s ease, transform .25s ease;
        }

            .activity-item:hover {
                background: #fafcff;
                transform: translateX(3px);
            }

            .activity-item:last-child {
                border-bottom: none;
                padding-bottom: 3px;
            }

        .activity-icon {
            width: 37px;
            height: 37px;
            min-width: 37px;
            border-radius: 11px;
            background: #f8fafc;
            color: var(--dashboard-primary);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: .8rem;
            transition: transform .25s ease;
        }

        .activity-item:hover .activity-icon {
            transform: scale(1.07);
        }

        .activity-body {
            flex: 1;
            min-width: 0;
        }

        .activity-title {
            color: var(--dashboard-text);
            font-size: .81rem;
            font-weight: 750;
            margin-bottom: 3px;
        }

        .activity-description {
            color: var(--dashboard-muted);
            font-size: .74rem;
            line-height: 1.45;
        }

        .activity-time {
            color: #94a3b8;
            font-size: .69rem;
            white-space: nowrap;
            padding-top: 2px;
        }

        /* =========================================================
                   DATABASE SUMMARY
                ========================================================= */

        .stat-list-item {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            padding: 13px 5px;
            border-bottom: 1px solid #f1f4f8;
            border-radius: 9px;
            transition: background .25s ease, padding-left .25s ease;
        }

            .stat-list-item:hover {
                background: #fafcff;
                padding-left: 10px;
            }

            .stat-list-item:last-child {
                border-bottom: none;
                padding-bottom: 2px;
            }

        .stat-item-left {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .stat-item-icon {
            width: 34px;
            height: 34px;
            border-radius: 10px;
            background: #f8fafc;
            color: #64748b;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: .75rem;
            transition: transform .25s ease, background .25s ease;
        }

        .stat-list-item:hover .stat-item-icon {
            transform: scale(1.06);
            background: #eff6ff;
            color: var(--dashboard-primary);
        }

        .stat-item-label {
            color: #475569;
            font-size: .78rem;
            font-weight: 600;
        }

        .stat-item-val {
            color: var(--dashboard-text);
            font-size: .92rem;
            font-weight: 800;
        }

        /* =========================================================
                   REDUCED MOTION
                ========================================================= */

        @@media (prefers-reduced-motion: reduce) {
            .premium-dashboard,
            .admin-stat-card {
                animation: none !important;
            }

            *,
            *::before,
            *::after {
                scroll-behavior: auto !important;
                transition-duration: .01ms !important;
                animation-duration: .01ms !important;
                animation-iteration-count: 1 !important;
            }
        }

        /* =========================================================
                   RESPONSIVE
                ========================================================= */

        @@media (max-width: 1200px) {
            .admin-stat-grid {
                grid-template-columns: repeat(2, minmax(0, 1fr));
            }
        }

        @@media (max-width: 992px) {
            .portal-grid {
                grid-template-columns: repeat(2, minmax(0, 1fr));
            }

            .admin-welcome-top {
                align-items: flex-start;
            }
        }

        @@media (max-width: 768px) {
            .admin-welcome-card {
                padding: 22px;
            }

            .admin-welcome-top {
                flex-direction: column;
            }

            .admin-live-status {
                align-self: flex-start;
            }
        }

        @@media (max-width: 576px) {
            .premium-dashboard {
                padding-left: 0;
                padding-right: 0;
            }

            .admin-welcome-card {
                padding: 20px;
                border-radius: 17px;
            }

            .admin-title-wrap {
                align-items: flex-start;
            }

            .admin-title-icon {
                width: 42px;
                height: 42px;
                min-width: 42px;
                border-radius: 12px;
            }

            .admin-page-title {
                font-size: 1.25rem;
            }

            .admin-page-subtitle {
                font-size: .8rem;
            }

            .admin-stat-grid,
            .portal-grid {
                grid-template-columns: 1fr;
            }

            .admin-stat-card {
                padding: 18px;
            }

            .portal-card {
                padding: 16px;
            }

            .admin-panel {
                padding: 17px;
                border-radius: 16px;
            }

            .activity-time {
                display: none;
            }
        }
    </style>

    <div class="premium-dashboard">

        <!-- ===================================================== -->
        <!-- WELCOME HEADER                                        -->
        <!-- ===================================================== -->

        <div class="admin-welcome-card">

            <div class="admin-welcome-content">

                <div class="admin-welcome-top">

                    <div class="admin-title-wrap">

                        <div class="admin-title-icon">

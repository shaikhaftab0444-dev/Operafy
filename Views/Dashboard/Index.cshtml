        /* =========================================================
           NUMBER SYSTEM
        ========================================================= */

        let globalNumberSystem =
            '@Model.NumberFormattingStyle';

        function formatCurrency(
            value,
            symbol,
            numberSystem
        ) {

            let displaySymbol = symbol;

            let isNegative =
                value < 0;

            let absValue =
                Math.abs(value);

            let numSys =
                numberSystem || globalNumberSystem;

            let formatted;

            if (numSys === "Lakhs/Crores") {

                if (absValue >= 10000000) {

                    formatted =
                        (absValue / 10000000)
                        .toFixed(2)
                        + " Cr";

                }
                else if (absValue >= 100000) {

                    formatted =
                        (absValue / 100000)
                        .toFixed(2)
                        + " L";

                }
                else if (absValue >= 10000) {

                    let kVal =
                        absValue / 1000;

                    formatted =
                        (
                            kVal % 1 === 0
                                ? kVal.toFixed(0)
                                : kVal.toFixed(1)
                        )
                        + " K";

                }
                else {

                    formatted =
                        absValue.toLocaleString(
                            'en-IN',
                            {
                                minimumFractionDigits: 2,
                                maximumFractionDigits: 2
                            }
                        );

                }

            }
            else {

                if (absValue >= 1000000000) {

                    formatted =
                        (absValue / 1000000000)
                        .toFixed(2)
                        + " B";

                }
                else if (absValue >= 1000000) {

                    formatted =
                        (absValue / 1000000)
                        .toFixed(2)
                        + " M";

                }
                else if (absValue >= 10000) {

                    let kVal =
                        absValue / 1000;

                    formatted =
                        (
                            kVal % 1 === 0
                                ? kVal.toFixed(0)
                                : kVal.toFixed(1)
                        )
                        + " K";

                }
                else {

                    formatted =
                        absValue.toLocaleString(
                            'en-US',
                            {
                                minimumFractionDigits: 2,
                                maximumFractionDigits: 2
                            }
                        );

                }

            }

            return (
                (isNegative ? "-" : "")
                +
                displaySymbol
                +
                " "
                +
                formatted
            );

        }

        /* =========================================================
           CHART TIMELINE
        ========================================================= */

        function updateChartTimeline(
            timeline,
            ev
        ) {

            const data =
                timelineData[timeline];

            if (data && finChart) {

                const buttons =
                    ev.target.parentNode.querySelectorAll(
                        "button"
                    );

                buttons.forEach(btn =>
                    btn.classList.remove("active")
                );

                ev.target.classList.add("active");

                finChart.data.labels =
                    data.labels;

                finChart.data.datasets[0].data =
                    data.revenue;

                finChart.data.datasets[1].data =
                    data.expenses;

                finChart.update();

            }

        }

        /* =========================================================
           DATABASE BACKUP
        ========================================================= */

        function triggerDBBackup() {

            alert(
                "Database backup trigger sent successfully! Saving erp_backup_"
                +
                new Date()
                    .toISOString()
                    .slice(0, 10)
                +
                ".bak to secure cloud restore point."
            );

        }

        /* =========================================================
           DIRECTORY SEARCH
        ========================================================= */

        function filterDirectoryRows() {

            const searchBox =
                document.getElementById(
                    "dirSearchBox"
                );

            const activePane =
                document.querySelector(
                    ".tab-pane.active"
                );

            if (!searchBox || !activePane) {
                return;
            }

            const query =
                searchBox.value
                    .toLowerCase()
                    .trim();

            const rows =
                activePane.querySelectorAll(
                    ".dir-row"
                );

            rows.forEach(row => {

                const searchText =
                    row.getAttribute(
                        "data-search-text"
                    )
                    || "";

                if (searchText.includes(query)) {

                    row.style.display = "";

                }
                else {

                    row.style.display = "none";

                }

            });

        }

        /* =========================================================
           CLEAR SEARCH ON TAB CHANGE
        ========================================================= */

        document
            .querySelectorAll(
                'button[data-bs-toggle="pill"]'
            )
            .forEach(tab => {

                tab.addEventListener(
                    'shown.bs.tab',
                    function () {

                        const searchBox =
                            document.getElementById(
                                "dirSearchBox"
                            );

                        if (searchBox) {

                            searchBox.value = "";

                        }

                        const activePane =
                            document.querySelector(
                                ".tab-pane.active"
                            );

                        if (activePane) {

                            activePane
                                .querySelectorAll(
                                    ".dir-row"
                                )
                                .forEach(r => {

                                    r.style.display = "";

                                });

                        }

                    }
                );

            });

    </script>
}
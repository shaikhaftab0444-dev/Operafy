<style>
    .card-kpi {
        background: #ffffff;
        border: 1px solid var(--border-warm);
        border-radius: 12px;
        padding: 1rem 0.85rem;
        box-shadow: 0 1px 3px rgba(45,37,30,0.03);
        display: flex;
        align-items: center;
        gap: 10px;
        height: 100%;
        transition: transform 0.2s, box-shadow 0.2s;
    }
    .card-kpi:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 16px rgba(45,37,30,0.05);
    }
    .kpi-icon-wrap {
        width: 48px;
        height: 48px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.25rem;
    }
    .kpi-icon-sales { background-color: rgba(79, 70, 229, 0.08); color: var(--primary-warm); }
    .kpi-icon-purchase { background-color: rgba(16, 185, 129, 0.08); color: #10b981; }
    .kpi-icon-customers { background-color: rgba(217, 119, 6, 0.08); color: var(--accent-warm); }
    .kpi-icon-employees { background-color: rgba(99, 102, 241, 0.08); color: #6366f1; }
    .kpi-icon-products { background-color: rgba(6, 182, 212, 0.08); color: #06b6d4; }
    .kpi-icon-stock { background-color: rgba(244, 63, 94, 0.08); color: #f43f5e; }

    .kpi-info {
        flex-grow: 1;
    }
    .kpi-label {
        font-size: 0.75rem;
        color: var(--sidebar-color);
        font-weight: 700;
        margin-bottom: 2px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }
    .kpi-val {
        font-size: 1.15rem;
        font-weight: 700;
        color: var(--text-color);
        white-space: nowrap;
    }
    .kpi-trend {
        font-size: 0.75rem;
        font-weight: 600;
        margin-top: 2px;
    }

    /* Card Panels */
    .dashboard-panel {
        background: #ffffff;
        border: 1px solid var(--border-warm);
        border-radius: 12px;
        padding: 1.5rem;
        box-shadow: 0 1px 3px rgba(45,37,30,0.03);
        height: 100%;
    }
    .panel-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1.25rem;
    }
    .panel-title {
        font-size: 1rem;
        font-weight: 700;
        color: var(--text-color);
        margin-bottom: 0;
    }

    /* Recent activities feed */
    .activity-list {
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }
    .activity-item {
        display: flex;
        gap: 15px;
        align-items: flex-start;
    }
    .activity-icon {
        width: 32px;
        height: 32px;
        border-radius: 6px;
        background-color: #faf6f0;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.9rem;
        flex-shrink: 0;
    }
    .activity-body {
        flex-grow: 1;
        font-size: 0.85rem;
    }
    .activity-time {
        font-size: 0.75rem;
        color: #a19688;
        white-space: nowrap;
    }

    /* Table styles */
    .table-custom th {
        background-color: #fcfbfa !important;
        font-size: 0.75rem;
        text-transform: uppercase;
        font-weight: 700;
        color: #7c7267;
        border-bottom: 1px solid var(--border-warm);
        padding: 0.75rem 1rem;
    }
    .table-custom td {
        font-size: 0.85rem;
        color: var(--text-color);
        border-bottom: 1px solid var(--border-warm);
        padding: 0.75rem 1rem;
        vertical-align: middle;
    }
</style>

<!-- Top Breadcrumbs -->
<div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-3 mb-4">
    <div>
        <h4 class="fw-bold mb-1" style="color: #0f172a;">Dashboard</h4>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0 small">
                <li class="breadcrumb-item"><a href="/" class="text-decoration-none">Home</a></li>
                <li class="breadcrumb-item active" aria-current="page">Dashboard</li>
            </ol>
        </nav>
    </div>
    
    <div>
        <div class="input-group">
            <span class="input-group-text bg-white border-end-0 text-muted small"><i class="fa-regular fa-calendar"></i></span>
            <select class="form-select border-start-0 bg-white small fw-bold" style="font-size: 0.85rem; width: 220px; cursor: pointer;">
                <option selected>01 May 2026 - 31 May 2026</option>
                <option>01 Jun 2026 - 30 Jun 2026</option>
                <option>Year to Date (YTD)</option>
            </select>
        </div>
    </div>
</div>

<!-- KPI Cards Container -->
<div class="row g-4 mb-4">
    <!-- Total Sales -->
    <div class="col-xl-2 col-md-4 col-sm-6">
        <div class="card-kpi">
            <div class="kpi-icon-wrap kpi-icon-sales"><i class="fa-solid fa-cart-shopping"></i></div>
            <div class="kpi-info">
                <div class="kpi-label">Total Sales</div>
                <div class="kpi-val">@Model.TotalSales.ToString("C0", inCulture)</div>
                <div class="kpi-trend text-success"><i class="fa-solid fa-circle-chevron-up me-1"></i>+12.5%</div>
            </div>
        </div>
    </div>
    <!-- Total Purchase -->
    <div class="col-xl-2 col-md-4 col-sm-6">
        <div class="card-kpi">
            <div class="kpi-icon-wrap kpi-icon-purchase"><i class="fa-solid fa-bag-shopping"></i></div>
            <div class="kpi-info">
                <div class="kpi-label">Total Purchase</div>
                <div class="kpi-val">@Model.TotalPurchase.ToString("C0", inCulture)</div>
                <div class="kpi-trend text-success"><i class="fa-solid fa-circle-chevron-up me-1"></i>+8.3%</div>
            </div>
        </div>
    </div>
    <!-- Total Customers -->
    <div class="col-xl-2 col-md-4 col-sm-6">
        <div class="card-kpi">
            <div class="kpi-icon-wrap kpi-icon-customers"><i class="fa-solid fa-users"></i></div>
            <div class="kpi-info">
                <div class="kpi-label">Total Customers</div>
                <div class="kpi-val">@Model.TotalCustomers.ToString("N0")</div>
                <div class="kpi-trend text-success"><i class="fa-solid fa-circle-chevron-up me-1"></i>+15.2%</div>
            </div>
        </div>
    </div>
    <!-- Total Employees -->
    <div class="col-xl-2 col-md-4 col-sm-6">
        <div class="card-kpi">
            <div class="kpi-icon-wrap kpi-icon-employees"><i class="fa-solid fa-id-card"></i></div>
            <div class="kpi-info">
                <div class="kpi-label">Total Employees</div>
                <div class="kpi-val">@Model.TotalEmployees</div>
                <div class="kpi-trend text-success"><i class="fa-solid fa-plus me-1"></i>4 New</div>
            </div>
        </div>
    </div>
    <!-- Total Products -->
    <div class="col-xl-2 col-md-4 col-sm-6">
        <div class="card-kpi">
            <div class="kpi-icon-wrap kpi-icon-products"><i class="fa-solid fa-box-open"></i></div>
            <div class="kpi-info">
                <div class="kpi-label">Total Products</div>
                <div class="kpi-val">@Model.TotalProducts</div>
                <div class="kpi-trend text-success"><i class="fa-solid fa-plus me-1"></i>23 New</div>
            </div>
        </div>
    </div>
    <!-- Stock Value -->
    <div class="col-xl-2 col-md-4 col-sm-6">
        <div class="card-kpi">
            <div class="kpi-icon-wrap kpi-icon-stock"><i class="fa-solid fa-coins"></i></div>
            <div class="kpi-info">
                <div class="kpi-label">Stock Value</div>
                <div class="kpi-val">@Model.StockValue.ToString("C0", inCulture)</div>
                <div class="kpi-trend text-danger"><i class="fa-solid fa-circle-chevron-down me-1"></i>-2.4%</div>
            </div>
        </div>
    </div>
</div>


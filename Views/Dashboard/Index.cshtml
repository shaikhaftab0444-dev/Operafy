        /* =========================
           DATABASE SUMMARY
        ========================== */

        .stat-list-item {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            padding: 15px 0;
            border-bottom: 1px solid #f1f5f9;

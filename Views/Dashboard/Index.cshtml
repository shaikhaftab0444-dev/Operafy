            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 15px;
        }

        .admin-stat-label {
            color: var(--dashboard-muted);
            font-size: .8rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: .4px;

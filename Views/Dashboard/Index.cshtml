                        <div class="kpi-icon-wrap glow-badge-blue"><i class="fa-solid fa-chart-line"></i></div>
                    </div>
                    <h3 class="fw-bold mb-1 text-dark" id="kpi-revenue">@FormatIndianCurrency(Model.CurrentMonthRevenue, Model.CurrencySymbol)</h3>
                    <div class="text-muted small d-flex justify-content-between align-items-center">
                        <span>Current month gross sales</span>
                        <span class="badge bg-primary-subtle text-primary small">@monthName</span>
                    </div>
                </div>
            </div>
            <!-- 2. Expenses -->
            <div class="col-sm-6 col-lg-3 animate-card" style="animation-delay: 0.1s;">
                <div class="glass-kpi-card border-highlight-indigo">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="text-secondary small fw-bold text-uppercase">Expenses</span>
                        <div class="kpi-icon-wrap glow-badge-indigo"><i class="fa-solid fa-building-columns"></i></div>
                    </div>
                    <h3 class="fw-bold mb-1 text-dark" id="kpi-expenses">@FormatIndianCurrency(Model.CurrentMonthExpenses, Model.CurrencySymbol)</h3>
                    <div class="text-muted small d-flex justify-content-between align-items-center">
                        <span>Current month operations cost</span>
                        <span class="badge bg-indigo-subtle text-indigo small">@monthName</span>
                    </div>
                </div>
            </div>
            <!-- 3. Recovery -->
            <div class="col-sm-6 col-lg-3 animate-card" style="animation-delay: 0.15s;">
                <div class="glass-kpi-card border-highlight-purple">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="text-secondary small fw-bold text-uppercase">Recovery</span>
                        <div class="kpi-icon-wrap glow-badge-purple"><i class="fa-solid fa-rotate-left"></i></div>
                    </div>
                    <h3 class="fw-bold mb-1 text-dark" id="kpi-recovery">@FormatIndianCurrency(Model.CurrentMonthRecovery, Model.CurrencySymbol)</h3>
                    <div class="text-muted small d-flex justify-content-between align-items-center">
                        <span>Payments received in month</span>
                        <span class="badge bg-purple-subtle text-purple small">@monthName</span>
                    </div>
                </div>
            </div>
            <!-- 4. Profit/Loss -->
            <div class="col-sm-6 col-lg-3 animate-card" style="animation-delay: 0.2s;">
                <div class="glass-kpi-card border-highlight-emerald">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="text-secondary small fw-bold text-uppercase">Net Profit/Loss</span>
                        <div class="kpi-icon-wrap glow-badge-emerald"><i class="fa-solid fa-scale-balanced"></i></div>
                    </div>
                    <h3 class="fw-bold mb-1 @(Model.NetProfitLoss >= 0 ? "text-success" : "text-danger")" id="kpi-profit">@FormatIndianCurrency(Model.NetProfitLoss, Model.CurrencySymbol)</h3>
                    <div class="text-muted small d-flex justify-content-between align-items-center">
                        <span>Revenue minus expense cost</span>
                        <span class="badge bg-emerald-subtle text-success small">Active</span>
                    </div>
                </div>
            </div>
            <!-- 5. Capital -->
            <div class="col-sm-6 col-lg-3 animate-card" style="animation-delay: 0.25s;">
                <div class="glass-kpi-card border-highlight-cyan">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="text-secondary small fw-bold text-uppercase">Owner Capital</span>
                        <div class="kpi-icon-wrap glow-badge-cyan"><i class="fa-solid fa-piggy-bank"></i></div>
                    </div>
                    <h3 class="fw-bold mb-1 text-dark" id="kpi-capital">@FormatIndianCurrency(Model.OwnerCapital, Model.CurrencySymbol)</h3>
                    <div class="text-muted small d-flex justify-content-between align-items-center">
                        <span>Total shareholder equity</span>
                        <span class="badge bg-info-subtle text-info small">Capital</span>
                    </div>
                </div>
            </div>
            <!-- 6. Cash/Bank Balance -->
            <div class="col-sm-6 col-lg-3 animate-card" style="animation-delay: 0.3s;">
                <div class="glass-kpi-card border-highlight-slate">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="text-secondary small fw-bold text-uppercase">Cash / Bank</span>
                        <div class="kpi-icon-wrap glow-badge-slate"><i class="fa-solid fa-wallet"></i></div>
                    </div>
                    <h3 class="fw-bold mb-1 text-dark" id="kpi-balance">@FormatIndianCurrency(Model.CashBankBalance, Model.CurrencySymbol)</h3>
                    <div class="text-muted small d-flex justify-content-between align-items-center">
                        <span>Ready operational funds</span>
                        <span class="badge bg-secondary-subtle text-secondary small">Liquid</span>
                    </div>
                </div>
            </div>
            <!-- 7. Receivables -->
            <div class="col-sm-6 col-lg-3 animate-card" style="animation-delay: 0.35s;">
                <div class="glass-kpi-card border-highlight-purple">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="text-secondary small fw-bold text-uppercase">Receivables</span>
                        <div class="kpi-icon-wrap glow-badge-purple"><i class="fa-solid fa-file-invoice"></i></div>
                    </div>
                    <h3 class="fw-bold mb-1 text-dark" id="kpi-receivable">@FormatIndianCurrency(Model.TotalReceivable, Model.CurrencySymbol)</h3>
                    <div class="text-muted small d-flex justify-content-between align-items-center">
                        <span>Total outstanding collections</span>
                        <span class="badge bg-warning-subtle text-warning small">Due</span>
                    </div>
                </div>
            </div>
            <!-- 8. Payables -->
            <div class="col-sm-6 col-lg-3 animate-card" style="animation-delay: 0.4s;">
                <div class="glass-kpi-card border-highlight-cyan">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="text-secondary small fw-bold text-uppercase">Payables</span>
                        <div class="kpi-icon-wrap glow-badge-cyan"><i class="fa-solid fa-credit-card"></i></div>
                    </div>
                    <h3 class="fw-bold mb-1 text-dark" id="kpi-payable">@FormatIndianCurrency(Model.TotalPayable, Model.CurrencySymbol)</h3>
                    <div class="text-muted small d-flex justify-content-between align-items-center">
                        <span>Total vendor liability cost</span>
                        <span class="badge bg-danger-subtle text-danger small">Due</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Analytics & System Health Row -->
        <div class="row g-4 mb-4">
            <!-- Left Column: Chart.js Area Chart -->
            <div class="col-lg-8">
                <div class="dashboard-grid p-4 h-100">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <div>
                            <h5 class="fw-bold mb-0 text-dark">Branch Financial Analytics</h5>
                            <span class="text-muted small">Monthly Revenue vs Expenses comparison</span>
                        </div>
                        <div class="btn-group btn-group-sm" role="group">
                            <button type="button" class="btn btn-outline-secondary active" onclick="updateChartTimeline('year', event)">Yearly</button>
                            <button type="button" class="btn btn-outline-secondary" onclick="updateChartTimeline('quarter', event)">This Quarter</button>
                            <button type="button" class="btn btn-outline-secondary" onclick="updateChartTimeline('month', event)">This Month</button>
                            <button type="button" class="btn btn-outline-secondary" onclick="updateChartTimeline('7d', event)">7 Days</button>
                        </div>
                    </div>
                    <div style="height: 310px;">
                        <canvas id="financialChart"></canvas>
                    </div>
                </div>
            </div>

            <!-- Right Column: System Health Widget -->
            <div class="col-lg-4">
                <div class="dashboard-grid p-4 h-100 d-flex flex-column justify-content-between">
                    <div>
                        <h5 class="fw-bold mb-3 text-dark">System Health & Ops</h5>
                        
                        <!-- Pulse Server Status -->
                        <div class="d-flex align-items-center justify-content-between p-2.5 border rounded mb-2.5">
                            <div class="d-flex align-items-center">
                                <span class="pulse-dot me-2.5"></span>
                                <span class="fw-semibold small">Live Server Status</span>
                            </div>
                            <span class="badge bg-success-subtle text-success border">99.9% Uptime</span>
                        </div>

                        <!-- Active staff -->
                        <div class="d-flex align-items-center justify-content-between p-2.5 border rounded mb-2.5">
                            <div class="d-flex align-items-center">
                                <i class="fa-solid fa-users text-primary me-2.5"></i>
                                <span class="fw-semibold small">Active Staff</span>
                            </div>
                            <span class="badge bg-primary-subtle text-primary border">8 / 10 Online</span>
                        </div>

                        <!-- Database storage -->
                        <div class="p-2.5 border rounded mb-3">
                            <div class="d-flex justify-content-between align-items-center mb-1.5">
                                <span class="fw-semibold small"><i class="fa-solid fa-database text-warning me-1.5"></i>Database Storage</span>
                                <span class="small text-muted font-monospace" style="font-size:0.75rem;">42 MB / 1 GB Used</span>
                            </div>
                            <div class="progress" style="height: 6px;">
                                <div class="progress-bar bg-warning" role="progressbar" style="width: 4.2%" aria-valuenow="4.2" aria-valuemin="0" aria-valuemax="100"></div>
                            </div>
                        </div>
                    </div>

                    <!-- Quick Actions -->
                    <div>
                        <h6 class="small fw-bold text-secondary text-uppercase mb-2" style="font-size: 0.7rem; letter-spacing: 0.5px;">Admin Controls</h6>
                        <div class="d-grid gap-2">
                            <a href="/Branches" class="btn btn-sm btn-outline-primary text-start px-3 py-2"><i class="fa-solid fa-plus me-2"></i>Register New Branch</a>
                            <a href="/RolePermissions" class="btn btn-sm btn-outline-indigo text-start px-3 py-2"><i class="fa-solid fa-shield-halved me-2"></i>RBAC Permissions Matrix</a>
                            <button type="button" class="btn btn-sm btn-outline-success text-start px-3 py-2" onclick="triggerDBBackup()"><i class="fa-solid fa-database me-2"></i>Trigger DB Backup Now</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Operational Metrics Grid (Sales, Purchases & Returns) -->
        <div class="row g-3 mb-4">
            <div class="col-md-6">
                <div class="dashboard-grid p-4">
                    <h6 class="fw-bold text-dark mb-3"><i class="fa-solid fa-cart-shopping text-primary me-2"></i>Today's Sales & Purchases</h6>
                    <div class="row g-2 text-center">
                        <div class="col-4 border-end">
                            <div class="small text-muted mb-1">Sales</div>
                            <span class="fw-bold fs-6 text-dark" id="op-sales">@FormatIndianCurrency(Model.TodaySales, Model.CurrencySymbol)</span>
                        </div>
                        <div class="col-4 border-end">
                            <div class="small text-muted mb-1">Sales Pending</div>
                            <span class="fw-bold fs-6 text-warning" id="op-sales-pending">@FormatIndianCurrency(Model.TodaySalesPending, Model.CurrencySymbol)</span>
                        </div>
                        <div class="col-4">
                            <div class="small text-muted mb-1">Sales Received</div>
                            <span class="fw-bold fs-6 text-success" id="op-sales-paid">@FormatIndianCurrency(Model.TodaySalesPaid, Model.CurrencySymbol)</span>
                        </div>
                    </div>
                    <hr class="my-3">
                    <div class="row g-2 text-center">
                        <div class="col-4 border-end">
                            <div class="small text-muted mb-1">Purchases</div>
                            <span class="fw-bold fs-6 text-dark" id="op-purchases">@FormatIndianCurrency(Model.TodayPurchases, Model.CurrencySymbol)</span>
                        </div>
                        <div class="col-4 border-end">
                            <div class="small text-muted mb-1">Purch. Pending</div>
                            <span class="fw-bold fs-6 text-warning" id="op-purchases-pending">@FormatIndianCurrency(Model.TodayPurchasesPending, Model.CurrencySymbol)</span>
                        </div>
                        <div class="col-4">
                            <div class="small text-muted mb-1">Purch. Paid</div>
                            <span class="fw-bold fs-6 text-success" id="op-purchases-paid">@FormatIndianCurrency(Model.TodayPurchasesPaid, Model.CurrencySymbol)</span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-6">
                <div class="dashboard-grid p-4">
                    <h6 class="fw-bold text-dark mb-3"><i class="fa-solid fa-arrow-rotate-left text-danger me-2"></i>Today's Return Sales & Purchases</h6>
                    <div class="row g-2 text-center">
                        <div class="col-4 border-end">
                            <div class="small text-muted mb-1">Return Sales</div>
                            <span class="fw-bold fs-6 text-dark">@Model.CurrencySymbol 0.00</span>
                        </div>
                        <div class="col-4 border-end">
                            <div class="small text-muted mb-1">Pending Ref.</div>
                            <span class="fw-bold fs-6 text-warning">@Model.CurrencySymbol 0.00</span>
                        </div>
                        <div class="col-4">
                            <div class="small text-muted mb-1">Refunded</div>
                            <span class="fw-bold fs-6 text-success">@Model.CurrencySymbol 0.00</span>
                        </div>
                    </div>
                    <hr class="my-3">
                    <div class="row g-2 text-center">
                        <div class="col-4 border-end">
                            <div class="small text-muted mb-1">Return Purch.</div>
                            <span class="fw-bold fs-6 text-dark">@Model.CurrencySymbol 0.00</span>
                        </div>
                        <div class="col-4 border-end">
                            <div class="small text-muted mb-1">Pending Collection</div>
                            <span class="fw-bold fs-6 text-warning">@Model.CurrencySymbol 0.00</span>
                        </div>
                        <div class="col-4">
                            <div class="small text-muted mb-1">Collected</div>
                            <span class="fw-bold fs-6 text-success">@Model.CurrencySymbol 0.00</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Tabs Panel for Branches, Products, Users, Customers -->
        <div class="dashboard-grid p-4 mb-4">
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-4">
                <div>
                    <h5 class="fw-bold mb-1 text-dark">Directories & Catalogs</h5>
                    <span class="text-muted small">Real-time overview and searchable records</span>
                </div>
                <div class="d-flex gap-2">
                    <input type="text" id="dirSearchBox" class="form-control form-control-sm" placeholder="Search directory records..." style="width: 240px;" onkeyup="filterDirectoryRows()" />
                </div>
            </div>

            <!-- TABS -->
            <ul class="nav nav-pills dynamics-tabs gap-2 mb-3 border-bottom pb-2" id="directoryTabs" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active" id="branches-tab" data-bs-toggle="pill" data-bs-target="#branches-pane" type="button" role="tab">
                        <i class="fa-solid fa-code-fork me-2"></i>Company Branches
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="products-tab" data-bs-toggle="pill" data-bs-target="#products-pane" type="button" role="tab">
                        <i class="fa-solid fa-box-open me-2"></i>Product Catalog
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="users-tab" data-bs-toggle="pill" data-bs-target="#users-pane" type="button" role="tab">
                        <i class="fa-solid fa-users me-2"></i>Employees & Users
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="customers-tab" data-bs-toggle="pill" data-bs-target="#customers-pane" type="button" role="tab">
                        <i class="fa-solid fa-handshake me-2"></i>Customers
                    </button>
                </li>
            </ul>

            <!-- TAB CONTENT -->
            <div class="tab-content" id="directoryTabsContent">
                <!-- 1. Branches -->
                <div class="tab-pane fade show active" id="branches-pane" role="tabpanel">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle">
                            <thead>
                                <tr>
                                    <th>Branch ID</th>
                                    <th>Branch Name</th>
                                    <th>Branch Code</th>
                                    <th>City / State</th>
                                    <th>Address</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @{
                                    var branches = ViewBag.CompanyBranches as List<ERP_System.Models.Branch>;
                                }
                                @if (branches != null && branches.Any())
                                {
                                    foreach (var b in branches)
                                    {
                                        <tr class="dir-row" data-search-text="@(b.BranchName.ToLower() + " " + b.BranchCode.ToLower() + " " + b.City.ToLower())">
                                            <td class="fw-bold text-secondary">BR#@b.BranchId.ToString("D2")</td>
                                            <td class="fw-bold text-dark">@b.BranchName</td>
                                            <td><span class="badge bg-secondary-subtle text-secondary-emphasis">@b.BranchCode</span></td>
                                            <td>@b.City, @b.State</td>
                                            <td>@b.AddressLine1</td>
                                            <td>
                                                @if (b.IsActive)
                                                {
                                                    <span class="badge bg-success-subtle text-success-emphasis rounded-pill px-3">Active</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary-subtle text-secondary-emphasis rounded-pill px-3">Inactive</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr><td colspan="6" class="text-center py-4 text-muted">No branches found.</td></tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- 2. Products -->
                <div class="tab-pane fade" id="products-pane" role="tabpanel">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle">
                            <thead>
                                <tr>
                                    <th>Product Name</th>
                                    <th>Category</th>
                                    <th>Location</th>
                                    <th class="text-center">Stock</th>
                                    <th class="text-end">Price</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @{
                                    var products = ViewBag.CompanyProducts as List<ERP_System.Models.Product>;
                                }
                                @if (products != null && products.Any())
                                {
                                    foreach (var p in products)
                                    {
                                        var pPrice = p.ProductName.Contains("Laptop") ? 65000 : (p.ProductName.Contains("Monitor") ? 12000 : 1500);
                                        var pStatus = p.StockQty > 10 ? "In Stock" : (p.StockQty > 0 ? "Low Stock" : "Out of Stock");
                                        var pBadge = pStatus == "In Stock" ? "bg-success-subtle text-success-emphasis" : (pStatus == "Low Stock" ? "bg-warning-subtle text-warning-emphasis" : "bg-danger-subtle text-danger-emphasis");
                                        
                                        <tr class="dir-row" data-search-text="@(p.ProductName.ToLower() + " " + p.Category.ToLower())">
                                            <td class="fw-bold text-dark">@p.ProductName</td>
                                            <td><span class="badge bg-light text-dark border">@p.Category</span></td>
                                            <td><i class="fa-solid fa-code-fork me-1.5 text-muted small"></i>@(p.Branch?.BranchName ?? "Head Office")</td>
                                            <td class="text-center fw-semibold">@p.StockQty</td>
                                            <td class="text-end fw-semibold">@FormatIndianCurrency(pPrice, Model.CurrencySymbol)</td>
                                            <td><span class="badge rounded-pill px-3 @pBadge">@pStatus</span></td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr><td colspan="6" class="text-center py-4 text-muted">No products found.</td></tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- 3. Users -->
                <div class="tab-pane fade" id="users-pane" role="tabpanel">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle">
                            <thead>
                                <tr>
                                    <th>Name</th>
                                    <th>Email</th>
                                    <th>Role</th>
                                    <th>Branch</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @{
                                    var users = ViewBag.CompanyUsers as List<ERP_System.Models.User>;
                                }
                                @if (users != null && users.Any())
                                {
                                    foreach (var u in users)
                                    {
                                        <tr class="dir-row" data-search-text="@(u.FullName.ToLower() + " " + u.Email.ToLower())">
                                            <td class="fw-bold text-dark">@u.FullName</td>
                                            <td>@u.Email</td>
                                            <td><span class="badge bg-primary-subtle text-primary-emphasis px-3"><i class="fa-solid fa-user-shield me-1"></i>@(u.Role?.RoleName ?? "Employee")</span></td>
                                            <td><i class="fa-solid fa-building me-1.5 text-muted small"></i>@(u.Branch?.BranchName ?? "Unassigned")</td>
                                            <td>
                                                @if (u.IsActive)
                                                {
                                                    <span class="badge bg-success-subtle text-success rounded-pill px-3">Active</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-danger-subtle text-danger rounded-pill px-3">Inactive</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr><td colspan="5" class="text-center py-4 text-muted">No users found.</td></tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- 4. Customers -->
                <div class="tab-pane fade" id="customers-pane" role="tabpanel">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle">
                            <thead>
                                <tr>
                                    <th>Customer Name</th>
                                    <th>Email</th>
                                    <th>Phone Number</th>
                                    <th>Joined Date</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @{
                                    var customers = ViewBag.CompanyCustomers as List<ERP_System.Models.Customer>;
                                }
                                @if (customers != null && customers.Any())
                                {
                                    foreach (var c in customers)
                                    {
                                        <tr class="dir-row" data-search-text="@(c.CustomerName.ToLower() + " " + c.Email.ToLower())">
                                            <td class="fw-bold text-dark">@c.CustomerName</td>
                                            <td>@c.Email</td>
                                            <td>@c.PhoneNumber</td>
                                            <td>@(c.JoinedDate?.ToString("dd MMM yyyy") ?? "N/A")</td>
                                            <td>
                                                @if (c.IsActive)
                                                {
                                                    <span class="badge bg-success-subtle text-success rounded-pill px-3">Active</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary-subtle text-secondary rounded-pill px-3">Inactive</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr><td colspan="5" class="text-center py-4 text-muted">No customers found.</td></tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- Live Enterprise Audit Trail Feed -->
        <div class="dashboard-grid p-4">
            <h5 class="fw-bold text-dark mb-3"><i class="fa-solid fa-clock-rotate-left text-secondary me-2"></i>Live Enterprise Audit Trail</h5>
            <div class="table-responsive">
                <table class="table table-sm table-hover align-middle mb-0" style="font-size: 0.82rem;">
                    <thead class="table-light">
                        <tr>
                            <th>Timestamp</th>
                            <th>User</th>
                            <th>Role</th>
                            <th>Action Performed</th>
                            <th>Target Entity</th>
                            <th>IP Address</th>

    <!-- ===================================================== -->
    <!-- ANALYTICS + SYSTEM HEALTH                             -->
    <!-- ===================================================== -->

    <div class="row g-4 mb-4">

        <!-- CHART -->

        <div class="col-lg-8">

            <div class="dashboard-grid p-4 h-100">

                <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">

                    <div>

                        <h5 class="mb-1 chart-header-title">
                            Branch Financial Analytics
                        </h5>

                        <span class="chart-header-subtitle">
                            Monthly Revenue vs Expenses comparison
                        </span>

                    </div>

                    <div class="btn-group btn-group-sm timeline-buttons"
                         role="group">

                        <button type="button"
                                class="btn btn-outline-secondary active"
                                onclick="updateChartTimeline('year', event)">
                            Yearly
                        </button>

                        <button type="button"
                                class="btn btn-outline-secondary"
                                onclick="updateChartTimeline('quarter', event)">
                            This Quarter
                        </button>

                        <button type="button"
                                class="btn btn-outline-secondary"
                                onclick="updateChartTimeline('month', event)">
                            This Month
                        </button>

                        <button type="button"
                                class="btn btn-outline-secondary"
                                onclick="updateChartTimeline('7d', event)">
                            7 Days
                        </button>

                    </div>

                </div>

                <div style="height: 310px;">
                    <canvas id="financialChart"></canvas>
                </div>

            </div>

        </div>

        <!-- SYSTEM HEALTH -->

        <div class="col-lg-4">

            <div class="dashboard-grid p-4 h-100 d-flex flex-column justify-content-between">

                <div>

                    <h5 class="fw-bold mb-3 text-dark">
                        System Health & Ops
                    </h5>

                    <!-- SERVER -->

                    <div class="ops-health-item d-flex align-items-center justify-content-between p-2.5 mb-2.5">

                        <div class="d-flex align-items-center">

                            <span class="pulse-dot me-2.5"></span>

                            <span class="fw-semibold small">
                                Live Server Status
                            </span>

                        </div>

                        <span class="badge bg-success-subtle text-success border">
                            99.9% Uptime
                        </span>

                    </div>

                    <!-- STAFF -->

                    <div class="ops-health-item d-flex align-items-center justify-content-between p-2.5 mb-2.5">

                        <div class="d-flex align-items-center">

                            <span class="ops-health-icon me-2">

                                <i class="fa-solid fa-users text-primary"></i>

                            </span>

                            <span class="fw-semibold small">
                                Active Staff
                            </span>

                        </div>

                        <span class="badge bg-primary-subtle text-primary border">
                            8 / 10 Online
                        </span>

                    </div>

                    <!-- DATABASE -->

                    <div class="ops-health-item p-2.5 mb-3">

                        <div class="d-flex justify-content-between align-items-center mb-1.5">

                            <span class="fw-semibold small">

                                <span class="ops-health-icon me-1">

                                    <i class="fa-solid fa-database text-warning"></i>

                                </span>

                                Database Storage

                            </span>

                            <span class="small text-muted font-monospace"
                                  style="font-size:0.7rem;">
                                42 MB / 1 GB Used
                            </span>

                        </div>

                        <div class="progress"
                             style="height: 6px;">

                            <div class="progress-bar bg-warning"
                                 role="progressbar"
                                 style="width: 4.2%"
                                 aria-valuenow="4.2"
                                 aria-valuemin="0"
                                 aria-valuemax="100">
                            </div>

                        </div>

                    </div>

                </div>

                <!-- ADMIN CONTROLS -->

                <div>

                    <h6 class="small fw-bold text-secondary text-uppercase mb-2"
                        style="font-size: 0.68rem; letter-spacing: 0.55px;">
                        Admin Controls
                    </h6>

                    <div class="d-grid gap-2">

                        <a href="/Branches"
                           class="btn btn-sm btn-outline-primary text-start px-3 py-2 ops-health-action">

                            <i class="fa-solid fa-plus me-2"></i>

                            Register New Branch

                        </a>

                        <a href="/RolePermissions"
                           class="btn btn-sm btn-outline-indigo text-start px-3 py-2 ops-health-action">

                            <i class="fa-solid fa-shield-halved me-2"></i>

                            RBAC Permissions Matrix

                        </a>

                        <button type="button"
                                class="btn btn-sm btn-outline-success text-start px-3 py-2 ops-health-action"
                                onclick="triggerDBBackup()">

                            <i class="fa-solid fa-database me-2"></i>

                            Trigger DB Backup Now

                        </button>

                    </div>

                </div>

            </div>

        </div>

    </div>

    <!-- ===================================================== -->
    <!-- SALES / PURCHASES + RETURNS                           -->
    <!-- ===================================================== -->

    <div class="row g-3 mb-4">

        <!-- SALES / PURCHASES -->

        <div class="col-md-6">

            <div class="ops-metric-card">

                <h6 class="ops-metric-title mb-3">

                    <i class="fa-solid fa-cart-shopping text-primary me-2"></i>

                    Today's Sales & Purchases

                </h6>

                <div class="row g-2 text-center">

                    <div class="col-4 border-end ops-metric-cell">

                        <div class="small text-muted mb-1">
                            Sales
                        </div>

                        <span class="fw-bold fs-6 text-dark"
                              id="op-sales">

                            @FormatIndianCurrency(
                                                        Model.TodaySales,
                                                        Model.CurrencySymbol
                                                        )

                        </span>

                    </div>

                    <div class="col-4 border-end ops-metric-cell">

                        <div class="small text-muted mb-1">
                            Sales Pending
                        </div>

                        <span class="fw-bold fs-6 text-warning"
                              id="op-sales-pending">

                            @FormatIndianCurrency(
                                                        Model.TodaySalesPending,
                                                        Model.CurrencySymbol
                                                        )

                        </span>

                    </div>

                    <div class="col-4 ops-metric-cell">

                        <div class="small text-muted mb-1">
                            Sales Received
                        </div>

                        <span class="fw-bold fs-6 text-success"
                              id="op-sales-paid">

                            @FormatIndianCurrency(
                                                        Model.TodaySalesPaid,
                                                        Model.CurrencySymbol
                                                        )

                        </span>

                    </div>

                </div>

                <hr class="my-3">

                <div class="row g-2 text-center">

                    <div class="col-4 border-end ops-metric-cell">

                        <div class="small text-muted mb-1">
                            Purchases
                        </div>

                        <span class="fw-bold fs-6 text-dark"
                              id="op-purchases">

                            @FormatIndianCurrency(
                                                        Model.TodayPurchases,
                                                        Model.CurrencySymbol
                                                        )

                        </span>

                    </div>

                    <div class="col-4 border-end ops-metric-cell">

                        <div class="small text-muted mb-1">
                            Purch. Pending
                        </div>

                        <span class="fw-bold fs-6 text-warning"
                              id="op-purchases-pending">

                            @FormatIndianCurrency(
                                                        Model.TodayPurchasesPending,
                                                        Model.CurrencySymbol
                                                        )

                        </span>

                    </div>

                    <div class="col-4 ops-metric-cell">

                        <div class="small text-muted mb-1">
                            Purch. Paid
                        </div>

                        <span class="fw-bold fs-6 text-success"
                              id="op-purchases-paid">

                            @FormatIndianCurrency(
                                                        Model.TodayPurchasesPaid,
                                                        Model.CurrencySymbol
                                                        )

                        </span>

                    </div>

                </div>

            </div>

        </div>

        <!-- RETURNS -->

        <div class="col-md-6">

            <div class="ops-metric-card">

                <h6 class="ops-metric-title mb-3">

                    <i class="fa-solid fa-arrow-rotate-left text-danger me-2"></i>

                    Today's Return Sales & Purchases

                </h6>

                <div class="row g-2 text-center">

                    <div class="col-4 border-end ops-metric-cell">

                        <div class="small text-muted mb-1">
                            Return Sales
                        </div>

                        <span class="fw-bold fs-6 text-dark">
                            @Model.CurrencySymbol 0.00
                        </span>

                    </div>

                    <div class="col-4 border-end ops-metric-cell">

                        <div class="small text-muted mb-1">
                            Pending Ref.
                        </div>

                        <span class="fw-bold fs-6 text-warning">
                            @Model.CurrencySymbol 0.00
                        </span>

                    </div>

                    <div class="col-4 ops-metric-cell">

                        <div class="small text-muted mb-1">
                            Refunded
                        </div>

                        <span class="fw-bold fs-6 text-success">
                            @Model.CurrencySymbol 0.00
                        </span>

                    </div>

                </div>

                <hr class="my-3">

                <div class="row g-2 text-center">

                    <div class="col-4 border-end ops-metric-cell">

                        <div class="small text-muted mb-1">
                            Return Purch.
                        </div>

                        <span class="fw-bold fs-6 text-dark">
                            @Model.CurrencySymbol 0.00
                        </span>

                    </div>

                    <div class="col-4 border-end ops-metric-cell">

                        <div class="small text-muted mb-1">
                            Pending Collection
                        </div>

                        <span class="fw-bold fs-6 text-warning">
                            @Model.CurrencySymbol 0.00
                        </span>

                    </div>

                    <div class="col-4 ops-metric-cell">

                        <div class="small text-muted mb-1">
                            Collected
                        </div>

                        <span class="fw-bold fs-6 text-success">
                            @Model.CurrencySymbol 0.00
                        </span>

                    </div>

                </div>

            </div>

        </div>

    </div>

    <!-- ===================================================== -->
    <!-- DIRECTORIES & CATALOGS                                -->
    <!-- ===================================================== -->

    <div class="directory-panel p-4 mb-4">

        <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-4">

            <div>

                <h5 class="fw-bold mb-1 text-dark">
                    Directories & Catalogs
                </h5>

                <span class="text-muted small">
                    Real-time overview and searchable records
                </span>

            </div>

            <div class="d-flex gap-2">

                <input type="text"
                       id="dirSearchBox"
                       class="form-control form-control-sm directory-search"
                       placeholder="Search directory records..."
                       style="width: 240px;"
                       onkeyup="filterDirectoryRows()" />

            </div>

        </div>

        <!-- TABS -->

        <ul class="nav nav-pills dynamics-tabs gap-2 mb-3 border-bottom pb-2"
            id="directoryTabs"
            role="tablist">

            <!-- BRANCHES -->

            <li class="nav-item" role="presentation">

                <button class="nav-link active"
                        id="branches-tab"
                        data-bs-toggle="pill"
                        data-bs-target="#branches-pane"
                        type="button"
                        role="tab">

                    <i class="fa-solid fa-code-fork me-2"></i>

                    Company Branches

                </button>

            </li>

            <!-- PRODUCTS -->

            <li class="nav-item" role="presentation">

                <button class="nav-link"
                        id="products-tab"
                        data-bs-toggle="pill"
                        data-bs-target="#products-pane"
                        type="button"
                        role="tab">

                    <i class="fa-solid fa-box-open me-2"></i>

                    Product Catalog

                </button>

            </li>

            <!-- USERS -->

            <li class="nav-item" role="presentation">

                <button class="nav-link"
                        id="users-tab"
                        data-bs-toggle="pill"
                        data-bs-target="#users-pane"
                        type="button"
                        role="tab">

                    <i class="fa-solid fa-users me-2"></i>

                    Employees & Users

                </button>

            </li>

            <!-- CUSTOMERS -->

            <li class="nav-item" role="presentation">

                <button class="nav-link"
                        id="customers-tab"
                        data-bs-toggle="pill"
                        data-bs-target="#customers-pane"
                        type="button"
                        role="tab">

                    <i class="fa-solid fa-handshake me-2"></i>

                    Customers

                </button>

            </li>

        </ul>

        <!-- ================================================= -->
        <!-- TAB CONTENT                                       -->
        <!-- ================================================= -->

        <div class="tab-content"
             id="directoryTabsContent">

            <!-- BRANCHES -->

            <div class="tab-pane fade show active"
                 id="branches-pane"
                 role="tabpanel">

                <div class="table-responsive">

                    <table class="table table-hover align-middle">

                        <thead>

                            <tr>

                                <th>Branch ID</th>
                                <th>Branch Name</th>
                                <th>Branch Code</th>
                                <th>City / State</th>
                                <th>Address</th>
                                <th>Status</th>

                            </tr>

                        </thead>

                        <tbody>

                            @{
                                    var branches =
                                    ViewBag.CompanyBranches
                                    as List<ERP_System.Models.Branch>;
                                }

                                @if (branches != null && branches.Any())
                                {
                                    foreach (var b in branches)
                                    {
                                        <tr class="dir-row"
                                            data-search-text="@(
                                            b.BranchName.ToLower()
                                            + " "
                                            + b.BranchCode.ToLower()
                                            + " "
                                            + b.City.ToLower()
                                                                                        )">

                                <td class="fw-bold text-secondary">
                                    BR#@b.BranchId.ToString("D2")
                                </td>

                                            <td class="fw-bold text-dark">
                                                @b.BranchName
                                            </td>

                                            <td>
                                                <span class="badge bg-secondary-subtle text-secondary-emphasis">
                                                    @b.BranchCode
                                                </span>
                                            </td>

                                            <td>
                                                @b.City, @b.State
                                            </td>

                                            <td>
                                                @b.AddressLine1
                                            </td>

                                            <td>

                                    @if (b.IsActive)
                                                {
                                                    <span class="badge bg-success-subtle text-success-emphasis rounded-pill px-3">
                                                        Active
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary-subtle text-secondary-emphasis rounded-pill px-3">
                                                        Inactive
                                                    </span>
                                                }

                                            </td>

                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="6"
                                            class="text-center py-4 text-muted">

                                            No branches found.

                                        </td>
                                    </tr>
                                }

                            </tbody>

                        </table>

                    </div>

                </div>

                <!-- PRODUCTS -->

                <div class="tab-pane fade"
                     id="products-pane"
                     role="tabpanel">

                    <div class="table-responsive">

                        <table class="table table-hover align-middle">

                            <thead>

                                <tr>

                                    <th>Product Name</th>
                                    <th>Category</th>
                                    <th>Location</th>
                                    <th class="text-center">Stock</th>
                                    <th class="text-end">Price</th>
                                    <th>Status</th>

                                </tr>

                            </thead>

                            <tbody>

                                @{
                                    var products =
                                    ViewBag.CompanyProducts
                                    as List<ERP_System.Models.Product>;
                                }

                                @if (products != null && products.Any())
                                {
                                    foreach (var p in products)
                                    {
                                        var pPrice =
                                        p.ProductName.Contains("Laptop")
                                        ? 65000
                                        :
                                        (p.ProductName.Contains("Monitor")
                                        ? 12000
                                        : 1500);

                                        var pStatus =
                                        p.StockQty > 10
                                        ? "In Stock"
                                        :
                                        (p.StockQty > 0
                                        ? "Low Stock"
                                        : "Out of Stock");

                                        var pBadge =
                                        pStatus == "In Stock"
                                        ? "bg-success-subtle text-success-emphasis"
                                        :
                                        (pStatus == "Low Stock"
                                        ? "bg-warning-subtle text-warning-emphasis"
                                        : "bg-danger-subtle text-danger-emphasis");

                                        <tr class="dir-row"
                                            data-search-text="@(
                                            p.ProductName.ToLower()
                                            + " "
                                            + p.Category.ToLower()
                                                                                        )">

                                <td class="fw-bold text-dark">
                                    @p.ProductName

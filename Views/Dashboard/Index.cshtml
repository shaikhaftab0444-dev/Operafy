        /* =========================
           RESPONSIVE
        ========================== */

        @@media (max-width: 1200px) {
            .admin-stat-grid {
                grid-template-columns: repeat(2, 1fr);
            }
        }

        @@media (max-width: 992px) {
            .portal-grid {
                grid-template-columns: repeat(2, 1fr);
            }
        }

        @@media (max-width: 576px) {
            .admin-welcome-card {
                padding: 20px;
            }

            .admin-page-title {
                font-size: 1.35rem;
            }

            .admin-stat-grid,
            .portal-grid {
                grid-template-columns: 1fr;
            }

            .portal-card {
                padding: 17px;
            }
        }
    </style>

    <div class="premium-dashboard">

        <!-- WELCOME HEADER -->

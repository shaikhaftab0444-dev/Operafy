                        </div>

                    </div>

                    <i class="fa-solid fa-arrow-right portal-arrow"></i>

                </a>

                <!-- COMPANIES -->

                <a href="/Company" class="portal-card">

                    <div class="portal-icon-wrap">
                        <i class="fa-solid fa-building"></i>
                    </div>

                    <div class="portal-info">

                        <div class="portal-name">
                            Companies
                        </div>

                        <div class="portal-desc">
                            Manage company information and enterprise settings.
                        </div>

                    </div>

                    <i class="fa-solid fa-arrow-right portal-arrow"></i>

                </a>

                <!-- COMPANY REGISTRATION -->

                <a href="/Company/Create" class="portal-card">

                    <div class="portal-icon-wrap">
                        <i class="fa-solid fa-folder-plus"></i>
                    </div>

                    <div class="portal-info">

                        <div class="portal-name">
                            Company Registration
                        </div>

                        <div class="portal-desc">
                            Register and configure a new enterprise company.
                        </div>

                    </div>

                    <i class="fa-solid fa-arrow-right portal-arrow"></i>

                </a>

                <!-- ACCOUNT HEADS -->

                <a href="/AccountHeads" class="portal-card">

                    <div class="portal-icon-wrap">
                        <i class="fa-solid fa-wallet"></i>
                    </div>

                    <div class="portal-info">

                        <div class="portal-name">
                            Account Heads
                        </div>

                        <div class="portal-desc">
                            Configure accounting heads and ledger categories.
                        </div>

                    </div>

                    <i class="fa-solid fa-arrow-right portal-arrow"></i>

                </a>

                <!-- FINANCIAL YEAR -->

                <a href="/FinancialYear" class="portal-card">

                    <div class="portal-icon-wrap">
                        <i class="fa-solid fa-calendar-days"></i>
                    </div>

                    <div class="portal-info">

                        <div class="portal-name">
                            Financial Year
                        </div>

                        <div class="portal-desc">
                            Manage fiscal calendars and active financial years.
                        </div>

                    </div>

                    <i class="fa-solid fa-arrow-right portal-arrow"></i>

                </a>

            </div>

        </div>

        <!-- ===================================================== -->
        <!-- ACTIVITY + DATABASE SUMMARY                           -->
        <!-- ===================================================== -->

        <div class="row g-4">

            <!-- RECENT ACTIVITY -->

            <div class="col-lg-7">

                <div class="admin-panel">

                    <div class="admin-panel-header">

                        <div>
                            <h5 class="admin-panel-title">
                                Recent Administrative Activity
                            </h5>
                        </div>

                        <div class="panel-icon">
                            <i class="fa-solid fa-clock-rotate-left"></i>
                        </div>

                    </div>

                    <div class="activity-list">

                        @if (Model.RecentActivities != null && Model.RecentActivities.Any())
                        {
                            foreach (var activity in Model.RecentActivities)
                            {
                                var timeDiff =
                                DateTime.UtcNow -
                                activity.CreatedAt.ToUniversalTime();

                                var timeStr =
                                timeDiff.TotalMinutes < 1
                                ? "Just now"
                                :
                                timeDiff.TotalMinutes < 60
                                ? $"{(int)timeDiff.TotalMinutes} min ago"
                                :
                                timeDiff.TotalHours < 24
                                ? $"{(int)timeDiff.TotalHours} hour ago"
                                :
                                $"{(int)timeDiff.TotalDays} day(s) ago";

                                <div class="activity-item">

                                    <div class="activity-icon @activity.ColorClass">
                                        <i class="fa-solid @activity.IconClass"></i>
                                    </div>

                                    <div class="activity-body">

                                        <div class="activity-title">
                                            @activity.Title
                                        </div>

                                        <div class="activity-description">
                                            @activity.Description
                                        </div>

                                    </div>

                                    <div class="activity-time">
                                        @timeStr
                                    </div>

                                </div>
                            }
                        }
                        else
                        {
                            <div class="text-center text-muted py-4">

                                <i class="fa-regular fa-folder-open fa-2x mb-3"></i>

                                <div>
                                    No recent administrative activity found.
                                </div>

                            </div>
                        }

                    </div>

                </div>

            </div>

            <!-- DATABASE SUMMARY -->

            <div class="col-lg-5">

                <div class="admin-panel">

                    <div class="admin-panel-header">

                        <h5 class="admin-panel-title">
                            Database Summary
                        </h5>

                        <div class="panel-icon">
                            <i class="fa-solid fa-chart-pie"></i>
                        </div>

                    </div>

                    <!-- COMPANIES -->

                    <div class="stat-list-item">

                        <div class="stat-item-left">

                            <div class="stat-item-icon">
                                <i class="fa-solid fa-building"></i>
                            </div>

                            <span class="stat-item-label">
                                Registered Companies
                            </span>

                        </div>

                        <span class="stat-item-val">
                            @ViewBag.TotalCompanies
                        </span>

                    </div>

                    <!-- USERS -->

                    <div class="stat-list-item">

                        <div class="stat-item-left">

                            <div class="stat-item-icon">
                                <i class="fa-solid fa-users"></i>
                            </div>

                            <span class="stat-item-label">
                                User Credentials
                            </span>

                        </div>

                        <span class="stat-item-val">
                            @ViewBag.TotalUsers
                        </span>

                    </div>

                    <!-- ROLES -->

                    <div class="stat-list-item">

                        <div class="stat-item-left">

                            <div class="stat-item-icon">
                                <i class="fa-solid fa-user-shield"></i>
                            </div>

                            <span class="stat-item-label">
                                System Roles
                            </span>

                        </div>

                        <span class="stat-item-val">
                            @ViewBag.TotalRoles
                        </span>

                    </div>

                    <!-- ACCOUNT HEADS -->

                    <div class="stat-list-item">

                        <div class="stat-item-left">

                            <div class="stat-item-icon">
                                <i class="fa-solid fa-wallet"></i>
                            </div>

                            <span class="stat-item-label">
                                Account Heads
                            </span>

                        </div>

                        <span class="stat-item-val">
                            @ViewBag.TotalAccountHeads
                        </span>

                    </div>

                    <!-- PRODUCTS -->

                    <div class="stat-list-item">

                        <div class="stat-item-left">

                            <div class="stat-item-icon">
                                <i class="fa-solid fa-box-open"></i>
                            </div>

                            <span class="stat-item-label">
                                Products Catalog
                            </span>

                        </div>

                        <span class="stat-item-val">
                            @Model.TotalProducts
                        </span>

                    </div>

                </div>

            </div>

        </div>

    </div>
}
else
{
    <!-- ========================================================= -->
    <!--              OPERATIONAL CONTROL CENTER                  -->
    <!-- ========================================================= -->

    <link rel="stylesheet" href="~/css/dynamics-dashboard.css" />

    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <style>

        /* =========================================================
                   PREMIUM OPERATIONAL DASHBOARD
                ========================================================= */

        .operational-dashboard {
            --ops-primary: #2563eb;
            --ops-primary-soft: #eff6ff;
            --ops-text: #172033;
            --ops-muted: #64748b;
            --ops-border: #e7ebf2;
            --ops-card: #ffffff;
            --ops-bg: #f7f9fc;
            animation: opsDashboardEnter .55s cubic-bezier(.22,1,.36,1) both;
        }

        @@keyframes opsDashboardEnter {
            from {
                opacity: 0;
                transform: translateY(12px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        /* =========================================================
                   DASHBOARD HEADER
                ========================================================= */

        .ops-header {
            position: relative;
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 20px;
            padding: 3px 1px 8px;
        }

        .ops-header-left {
            display: flex;
            align-items: center;
            gap: 13px;
        }

        .ops-header-icon {
            width: 45px;
            height: 45px;
            border-radius: 14px;
            background: linear-gradient(135deg, #2563eb, #4f7df3);
            color: #fff;
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 9px 22px rgba(37,99,235,.18);
            transition: transform .3s ease;
        }

        .ops-header:hover .ops-header-icon {
            transform: translateY(-2px) rotate(-3deg);
        }

        .ops-title {
            color: var(--ops-text);
            font-size: 1.38rem;
            font-weight: 800;
            letter-spacing: -.4px;
        }

        .ops-subtitle {
            color: var(--ops-muted);
            font-size: .77rem;
        }

        .ops-live-badge {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            border: 1px solid var(--ops-border);
            background: #fff;
            color: #475569;
            border-radius: 999px;
            padding: 8px 13px;
            font-size: .69rem;
            font-weight: 800;
            letter-spacing: .3px;
            box-shadow: 0 5px 16px rgba(15,23,42,.035);
        }

        /* =========================================================
                   KPI CARDS
                ========================================================= */

        .glass-kpi-card {
            position: relative;
            overflow: hidden;
            height: 100%;
            min-height: 142px;
            padding: 18px;
            background: rgba(255,255,255,.96);
            border: 1px solid #e7ebf2;
            border-radius: 17px;
            box-shadow: 0 7px 25px rgba(15,23,42,.045);
            transition: transform .3s cubic-bezier(.22,1,.36,1), box-shadow .3s ease, border-color .3s ease;
            animation: opsKpiEnter .55s cubic-bezier(.22,1,.36,1) both;
        }

            .glass-kpi-card::before {
                content: "";
                position: absolute;
                width: 110px;
                height: 110px;
                border-radius: 50%;
                right: -55px;
                bottom: -55px;
                background: rgba(37,99,235,.035);
                transition: transform .4s ease;
            }

            .glass-kpi-card:hover {
                transform: translateY(-5px);
                box-shadow: 0 17px 38px rgba(15,23,42,.085);
                border-color: #d5ddea;
            }

                .glass-kpi-card:hover::before {
                    transform: scale(1.45);
                }

        .animate-card:nth-child(1) .glass-kpi-card {
            animation-delay: .04s;
        }

        .animate-card:nth-child(2) .glass-kpi-card {
            animation-delay: .08s;
        }

        .animate-card:nth-child(3) .glass-kpi-card {
            animation-delay: .12s;
        }

        .animate-card:nth-child(4) .glass-kpi-card {
            animation-delay: .16s;
        }

        .animate-card:nth-child(5) .glass-kpi-card {
            animation-delay: .20s;
        }

        .animate-card:nth-child(6) .glass-kpi-card {
            animation-delay: .24s;
        }

        .animate-card:nth-child(7) .glass-kpi-card {
            animation-delay: .28s;
        }

        .animate-card:nth-child(8) .glass-kpi-card {
            animation-delay: .32s;
        }

        @@keyframes opsKpiEnter {
            from {
                opacity: 0;
                transform: translateY(16px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .kpi-icon-wrap {
            width: 41px;
            height: 41px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: .92rem;
            transition: transform .3s ease, box-shadow .3s ease;
        }

        .glass-kpi-card:hover .kpi-icon-wrap {
            transform: scale(1.08) rotate(-3deg);
        }

        .glow-badge-blue {
            background: #eff6ff;
            color: #2563eb;
            box-shadow: 0 5px 16px rgba(37,99,235,.1);
        }

        .glow-badge-indigo {
            background: #eef2ff;
            color: #4f46e5;
            box-shadow: 0 5px 16px rgba(79,70,229,.1);
        }

        .glow-badge-purple {
            background: #f5f3ff;
            color: #7c3aed;
            box-shadow: 0 5px 16px rgba(124,58,237,.1);
        }

        .glow-badge-emerald {
            background: #ecfdf5;
            color: #059669;
            box-shadow: 0 5px 16px rgba(5,150,105,.1);
        }

        .glow-badge-cyan {
            background: #ecfeff;
            color: #0891b2;
            box-shadow: 0 5px 16px rgba(8,145,178,.1);
        }

        .glow-badge-slate {
            background: #f1f5f9;
            color: #475569;
            box-shadow: 0 5px 16px rgba(71,85,105,.08);
        }

        .glass-kpi-card h3 {
            position: relative;
            z-index: 2;
            letter-spacing: -.55px;
        }

        .border-highlight-blue {
            border-left: 3px solid #3b82f6;
        }

        .border-highlight-indigo {
            border-left: 3px solid #6366f1;
        }

        .border-highlight-purple {
            border-left: 3px solid #a855f7;
        }

        .border-highlight-emerald {
            border-left: 3px solid #10b981;
        }

        .border-highlight-cyan {
            border-left: 3px solid #06b6d4;
        }

        .border-highlight-slate {
            border-left: 3px solid #64748b;
        }

        /* =========================================================
                   DASHBOARD GRID / PANELS
                ========================================================= */

        .dashboard-grid {
            background: #ffffff;
            border: 1px solid var(--ops-border);
            border-radius: 19px;
            box-shadow: 0 7px 25px rgba(15,23,42,.04);
            transition: box-shadow .3s ease, transform .3s ease;
        }

            .dashboard-grid:hover {
                box-shadow: 0 14px 34px rgba(15,23,42,.065);
            }

        /* =========================================================
                   CHART
                ========================================================= */

        .chart-header-title {
            font-size: .96rem;
            font-weight: 800;
            color: var(--ops-text);
        }

        .chart-header-subtitle {
            font-size: .74rem;
            color: var(--ops-muted);
        }

        .timeline-buttons .btn {
            font-size: .7rem;
            border-color: #dce2ea;
            color: #64748b;
            transition: background .25s ease, color .25s ease, border-color .25s ease, transform .2s ease;
        }

            .timeline-buttons .btn:hover {
                transform: translateY(-1px);
            }

            .timeline-buttons .btn.active {
                background: #2563eb;
                border-color: #2563eb;
                color: #ffffff;
                box-shadow: 0 5px 14px rgba(37,99,235,.18);
            }

        /* =========================================================
                   SYSTEM HEALTH
                ========================================================= */

        .ops-health-item {
            background: #ffffff;
            border: 1px solid #e8edf3 !important;
            border-radius: 11px !important;
            transition: transform .25s ease, box-shadow .25s ease, border-color .25s ease;
        }

            .ops-health-item:hover {
                transform: translateX(3px);
                border-color: #d8e0eb !important;
                box-shadow: 0 7px 17px rgba(15,23,42,.045);
            }

        .ops-health-icon {
            width: 28px;
            height: 28px;
            border-radius: 8px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            background: #f8fafc;
        }

        .ops-health-action {
            transition: transform .25s ease, box-shadow .25s ease;
        }

            .ops-health-action:hover {
                transform: translateY(-2px);
                box-shadow: 0 7px 18px rgba(15,23,42,.07);
            }

        /* =========================================================
                   OPERATIONAL CARDS
                ========================================================= */

        .ops-metric-card {
            height: 100%;
            background: #ffffff;
            border: 1px solid var(--ops-border);
            border-radius: 18px;
            padding: 21px;
            box-shadow: 0 7px 24px rgba(15,23,42,.035);
            transition: transform .3s ease, box-shadow .3s ease;
        }

            .ops-metric-card:hover {
                transform: translateY(-3px);
                box-shadow: 0 13px 30px rgba(15,23,42,.06);
            }

        .ops-metric-title {
            font-size: .87rem;
            font-weight: 800;
            color: var(--ops-text);
        }

        .ops-metric-cell {
            transition: transform .2s ease, background .2s ease;
            border-radius: 8px;
            padding: 6px 3px;
        }

            .ops-metric-cell:hover {
                background: #fafcff;
                transform: translateY(-2px);
            }

        /* =========================================================
                   DIRECTORY PANEL
                ========================================================= */

        .directory-panel {
            background: #ffffff;
            border: 1px solid var(--ops-border);
            border-radius: 20px;
            box-shadow: 0 7px 25px rgba(15,23,42,.04);
        }

        .directory-search {
            border: 1px solid #dfe5ed;
            border-radius: 10px;
            font-size: .76rem;
            transition: border-color .25s ease, box-shadow .25s ease;
        }

            .directory-search:focus {
                border-color: #93b4f7;
                box-shadow: 0 0 0 3px rgba(37,99,235,.08);
            }

        .dynamics-tabs {
            border-bottom-color: #edf1f5 !important;
        }

            .dynamics-tabs .nav-link {
                position: relative;
                border-radius: 9px 9px 0 0;
                color: #64748b;
                font-size: .76rem;
                font-weight: 700;
                padding: 10px 13px;
                transition: color .25s ease, background .25s ease;
            }

                .dynamics-tabs .nav-link::after {
                    content: "";
                    position: absolute;
                    left: 13px;
                    right: 13px;
                    bottom: -3px;
                    height: 2px;
                    border-radius: 999px;
                    background: #2563eb;
                    transform: scaleX(0);
                    transition: transform .3s ease;
                }

                .dynamics-tabs .nav-link:hover {
                    color: #2563eb;
                    background: #f8fbff;
                }

                .dynamics-tabs .nav-link.active {
                    background: #f5f8ff;
                    color: #2563eb;
                }

                    .dynamics-tabs .nav-link.active::after {
                        transform: scaleX(1);
                    }

        .directory-panel .table {
            margin-bottom: 0;
        }

            .directory-panel .table thead th {
                color: #64748b;
                font-size: .7rem;
                text-transform: uppercase;
                letter-spacing: .35px;
                font-weight: 800;
                border-bottom-color: #e8edf3;
                padding-top: 11px;
                padding-bottom: 11px;
                white-space: nowrap;
            }

            .directory-panel .table tbody td {
                font-size: .78rem;
                color: #475569;
                border-color: #eef2f6;
                padding-top: 12px;
                padding-bottom: 12px;
                white-space: nowrap;
            }

            .directory-panel .table tbody tr {
                transition: background .2s ease, transform .2s ease;
            }

                .directory-panel .table tbody tr:hover {
                    background: #f9fbff;
                }

        .tab-pane.fade {
            transition: opacity .25s ease, transform .25s ease;
        }

            .tab-pane.fade:not(.show) {
                transform: translateY(4px);
            }

        /* =========================================================
                   AUDIT TRAIL
                ========================================================= */

        .audit-panel {
            background: #ffffff;
            border: 1px solid var(--ops-border);
            border-radius: 20px;
            box-shadow: 0 7px 25px rgba(15,23,42,.04);
        }

        .audit-title {
            color: var(--ops-text);
            font-size: .96rem;
            font-weight: 800;
        }

        .audit-table {
            font-size: .76rem;
        }

            .audit-table thead th {
                color: #64748b;
                font-size: .67rem;
                text-transform: uppercase;
                letter-spacing: .35px;
                font-weight: 800;
                background: #f8fafc;
                border-bottom: 1px solid #e8edf3;
                white-space: nowrap;
            }

            .audit-table tbody td {
                border-color: #eef2f6;
                white-space: nowrap;
            }

            .audit-table tbody tr {
                transition: background .22s ease, transform .22s ease;
            }

                .audit-table tbody tr:hover {
                    background: #f9fbff;
                    transform: translateX(2px);
                }

        .audit-avatar {
            width: 29px;
            height: 29px;
            border-radius: 50%;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            color: #fff;
            font-size: .62rem;
            font-weight: 800;
            box-shadow: 0 4px 10px rgba(15,23,42,.08);
        }

        .bg-avatar-indigo {
            background: #6366f1;
        }

        .bg-avatar-emerald {
            background: #10b981;
        }

        .bg-avatar-amber {
            background: #f59e0b;
        }

        .bg-avatar-rose {
            background: #f43f5e;
        }

        /* =========================================================
                   PULSE DOT
                ========================================================= */

        .pulse-dot {
            display: inline-block;
            width: 7px;
            height: 7px;
            background: #10b981;
            border-radius: 50%;
            box-shadow: 0 0 0 0 rgba(16,185,129,.35);
            animation: opsPulse 2s infinite;
        }

        @@keyframes opsPulse {
            0% {
                box-shadow: 0 0 0 0 rgba(16,185,129,.35);
            }

            70% {
                box-shadow: 0 0 0 7px rgba(16,185,129,0);
            }

            100% {
                box-shadow: 0 0 0 0 rgba(16,185,129,0);
            }
        }

        /* =========================================================
                   REDUCED MOTION
                ========================================================= */

        @@media (prefers-reduced-motion: reduce) {
            .operational-dashboard,
            .glass-kpi-card {
                animation: none !important;
            }

            *,
            *::before,
            *::after {
                transition-duration: .01ms !important;
                animation-duration: .01ms !important;
                animation-iteration-count: 1 !important;
            }
        }

        /* =========================================================
                   RESPONSIVE
                ========================================================= */

        @@media (max-width: 992px) {

            .ops-header {
                align-items: flex-start;
            }

            .ops-title {
                font-size: 1.2rem;
            }

            .timeline-buttons {
                margin-top: 8px;
            }
        }

        @@media (max-width: 768px) {

            .ops-header {
                flex-direction: column;
            }

            .ops-live-badge {
                align-self: flex-start;
            }

            .directory-search {
                width: 100% !important;
            }
        }

        @@media (max-width: 576px) {

            .operational-dashboard {
                padding-left: 0 !important;
                padding-right: 0 !important;
            }

            .ops-header-left {
                align-items: flex-start;
            }

            .ops-header-icon {
                width: 40px;
                height: 40px;
                min-width: 40px;
            }

            .ops-title {
                font-size: 1.05rem;
            }

            .ops-subtitle {
                font-size: .7rem;
            }

            .glass-kpi-card {
                min-height: 132px;
                padding: 16px;
            }

            .dashboard-grid,
            .directory-panel,
            .audit-panel {
                border-radius: 16px;
            }

            .dynamics-tabs {
                overflow-x: auto;
                flex-wrap: nowrap !important;
                scrollbar-width: none;
            }

                .dynamics-tabs::-webkit-scrollbar {
                    display: none;
                }

                .dynamics-tabs .nav-link {
                    white-space: nowrap;
                }
        }

    </style>

    <div class="container-fluid py-4 operational-dashboard text-start">

        <!-- ===================================================== -->
        <!-- HEADER                                                -->
        <!-- ===================================================== -->

        <div class="ops-header mb-4">

            <div class="ops-header-left">

                <div class="ops-header-icon">
                    <i class="fa-solid fa-gauge-high"></i>
                </div>

                <div>

                    <h4 class="fw-bold mb-1 ops-title">
                        Operational Control Center
                    </h4>

                    <div class="ops-subtitle">

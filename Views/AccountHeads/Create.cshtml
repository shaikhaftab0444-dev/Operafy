@model ERP_System.Models.AccountHead
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Add Ledger Account Head";
}

<style>
    .panel-form {
        background: #ffffff;
        border: 1px solid var(--border-warm);
        border-radius: 12px;
        box-shadow: 0 1px 3px rgba(45,37,30,0.03);
        padding: 2.5rem;
        max-width: 600px;
        margin: 0 auto;
    }

    .form-label-warm {
        font-size: 0.8rem;
        font-weight: 700;
        color: var(--text-color);
        margin-bottom: 6px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .input-group-warm {
        border: 1px solid #d4cbbd;
        border-radius: 8px;
        background-color: #fcfbfa;
        transition: all 0.2s ease-in-out;
        overflow: hidden;
        display: flex;
        align-items: center;
        width: 100%;
    }
    .input-group-warm:focus-within {
        border-color: var(--primary-warm);
        box-shadow: 0 0 0 4px rgba(79, 70, 229, 0.08);
        background-color: #ffffff;
    }

    .input-icon-warm {
        padding: 0.75rem 0.25rem 0.75rem 1rem;
        color: var(--sidebar-color);
        font-size: 0.95rem;
        display: flex;
        align-items: center;
    }

    .form-control-warm {
        border: none !important;
        box-shadow: none !important;
        background: transparent !important;
        color: var(--text-color) !important;
        font-size: 0.9rem !important;
        padding: 0.75rem 1rem !important;
        width: 100%;
    }
</style>

<!-- Breadcrumbs & Header -->
<div class="mb-4 text-center">
    <h4 class="fw-bold mb-1" style="color: var(--text-color);">Add Account Head</h4>
    <p class="text-muted small">Register a new ledger category into the Chart of Accounts.</p>
    <nav aria-label="breadcrumb" class="d-inline-block">
        <ol class="breadcrumb mb-0 small">
            <li class="breadcrumb-item"><a href="/Dashboard" class="text-decoration-none">Dashboard</a></li>
            <li class="breadcrumb-item"><a href="/AccountHeads" class="text-decoration-none">Account Heads</a></li>
            <li class="breadcrumb-item active" aria-current="page">Add Ledger</li>
        </ol>
    </nav>
</div>

<!-- Form Card -->
<div class="panel-form">
    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()

        <div class="row g-3 text-start">
            <!-- Account Class Type -->
            <div class="col-12">
                <label asp-for="AccountType" class="form-label-warm">Ledger Classification Class</label>
                <div class="input-group-warm" style="border: 1px solid #d4cbbd; border-radius: 8px; background-color: #fcfbfa; padding: 2px;">
                    <span class="input-icon-warm"><i class="fa-solid fa-coins"></i></span>
                    <select asp-for="AccountType" class="form-select" style="border: none !important; box-shadow: none !important; font-size: 0.9rem; padding: 0.6rem 1rem;" required>
                        <option value="Asset">Asset (Cash, Receivables, Stock, Land)</option>
                        <option value="Liability">Liability (Payables, Loans, Taxes)</option>
                        <option value="Equity">Equity (Capital, Shareholder, Drawings)</option>
                        <option value="Revenue">Revenue (Sales, Commissions, Interest Income)</option>
                        <option value="Expense">Expense (Salary, Purchases, Rent, Utilities)</option>
                    </select>
                </div>
            </div>

            <!-- Head Code -->
            <div class="col-md-6">
                <label asp-for="HeadCode" class="form-label-warm">Ledger Account Code</label>
                <div class="input-group-warm">
                    <span class="input-icon-warm"><i class="fa-solid fa-barcode"></i></span>
                    <input asp-for="HeadCode" class="form-control-warm" placeholder="e.g. AC-1002" required />
                </div>
                <span asp-validation-for="HeadCode" class="text-danger small"></span>
            </div>

            <!-- Head Name -->
            <div class="col-md-6">
                <label asp-for="HeadName" class="form-label-warm">Ledger Account Name</label>
                <div class="input-group-warm">
                    <span class="input-icon-warm"><i class="fa-solid fa-file-invoice-dollar"></i></span>
                    <input asp-for="HeadName" class="form-control-warm" placeholder="e.g. Petty Cash" required />
                </div>
                <span asp-validation-for="HeadName" class="text-danger small"></span>
            </div>

            <!-- Description -->
            <div class="col-12">
                <label asp-for="Description" class="form-label-warm">Account Description</label>
                <textarea asp-for="Description" class="form-control" rows="3" style="border: 1px solid #d4cbbd !important; border-radius: 8px !important; font-size: 0.9rem !important; padding: 0.60rem 0.85rem !important;" placeholder="Detailed ledger usage rules..."></textarea>
            </div>
        </div>

        <!-- Form Buttons -->
        <div class="d-flex justify-content-end gap-3 mt-4">
            <a href="/AccountHeads" class="btn btn-secondary-warm" style="border: 1px solid var(--border-warm); background-color: #ffffff; color: var(--text-color); padding: 0.75rem 2rem; border-radius: 8px; font-weight: 600; font-size: 0.9rem; text-decoration: none;">Cancel</a>
            <button type="submit" class="btn btn-primary-warm" style="background: linear-gradient(135deg, var(--primary-warm) 0%, #6366f1 100%); color: #ffffff; border: none; padding: 0.75rem 2rem; border-radius: 8px; font-weight: 600; font-size: 0.9rem; box-shadow: 0 4px 10px rgba(79, 70, 229, 0.2);">Register Head</button>
        </div>
    </form>
</div>

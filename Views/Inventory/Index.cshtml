@model ERP_System.Models.InventoryViewModel
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Inventory Management";
    var inCulture = new System.Globalization.CultureInfo("en-IN");
}

<style>
    .panel-inventory {
        background: #ffffff;
        border: 1px solid var(--border-warm);
        border-radius: 12px;
        box-shadow: 0 1px 3px rgba(45,37,30,0.03);
    }
    
    .table-inventory th {
        background-color: #fcfbfa !important;
        font-size: 0.75rem;
        text-transform: uppercase;
        font-weight: 700;
        color: #7c7267;
        border-bottom: 1px solid var(--border-warm);
        padding: 1rem 1.25rem;
    }
    
    .table-inventory td {
        font-size: 0.875rem;
        color: var(--text-color);
        border-bottom: 1px solid var(--border-warm);
        padding: 1rem 1.25rem;
        vertical-align: middle;
    }

    .badge-in-stock {
        background-color: rgba(16, 185, 129, 0.08);
        color: #10b981;
        font-weight: 600;
        border: 1px solid rgba(16, 185, 129, 0.2);
    }
    .badge-low-stock {
        background-color: rgba(245, 158, 11, 0.08);
        color: #f59e0b;
        font-weight: 600;
        border: 1px solid rgba(245, 158, 11, 0.2);
    }
    .badge-out-stock {
        background-color: rgba(239, 68, 68, 0.08);
        color: #ef4444;
        font-weight: 600;
        border: 1px solid rgba(239, 68, 68, 0.2);
    }

    .kpi-card-warm {
        background: #ffffff;
        border: 1px solid var(--border-warm);
        border-radius: 12px;
        padding: 1.25rem;
        box-shadow: 0 1px 3px rgba(13,20,36,0.03);
        display: flex;
        align-items: center;
        gap: 1.25rem;
    }
    .kpi-icon-box {
        width: 48px;
        height: 48px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.35rem;
        flex-shrink: 0;
    }

    .btn-action-warm {
        border: 1px solid var(--border-warm);
        background-color: #ffffff;
        color: var(--text-color);
        font-size: 0.8rem;
        font-weight: 600;
        padding: 0.35rem 0.75rem;
        border-radius: 6px;
        transition: all 0.2s;
    }
    .btn-action-warm:hover {
        background-color: #faf8f5;
        border-color: #cbd5e1;
        color: var(--primary-warm);
    }

    .progress-stock {
        height: 6px;
        border-radius: 4px;
        background-color: #f1ede6;
    }
</style>

<!-- Top Header & Breadcrumbs -->
<div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-3 mb-4 text-start">
    <div>
        <h4 class="fw-bold mb-1" style="color: var(--text-color);">Inventory Management</h4>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0 small">
                <li class="breadcrumb-item"><a href="/Dashboard" class="text-decoration-none">Dashboard</a></li>
                <li class="breadcrumb-item active" aria-current="page">Inventory Management</li>
            </ol>
        </nav>
    </div>
    
    <div class="d-flex gap-2">
        <button type="button" class="btn btn-outline-secondary btn-sm px-3 py-2 fw-semibold" data-bs-toggle="modal" data-bs-target="#adjustStockModal">
            <i class="fa-solid fa-sliders me-1.5"></i> Adjust Stock
        </button>
        <a href="/Products/Create" class="btn btn-primary-warm px-4 py-2">
            <i class="fa-solid fa-plus me-1.5"></i> Add New SKU
        </a>
    </div>
</div>

<!-- Alerts -->
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm text-start mb-4" role="alert">
        <i class="fa-solid fa-circle-check me-2"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm text-start mb-4" role="alert">
        <i class="fa-solid fa-triangle-exclamation me-2"></i> @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- KPI Metrics Summary Row -->
<div class="row g-3 mb-4 text-start">
    <div class="col-xl-3 col-sm-6">
        <div class="kpi-card-warm">
            <div class="kpi-icon-box bg-primary bg-opacity-10 text-primary">
                <i class="fa-solid fa-boxes-stacked"></i>
            </div>
            <div>
                <div class="text-muted small fw-semibold text-uppercase">Total Stock Value</div>
                <div class="fs-4 fw-bold text-dark">@Model.TotalStockValue.ToString("C0", inCulture)</div>
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-sm-6">
        <div class="kpi-card-warm">
            <div class="kpi-icon-box bg-info bg-opacity-10 text-info">
                <i class="fa-solid fa-cubes"></i>
            </div>
            <div>
                <div class="text-muted small fw-semibold text-uppercase">Active Product SKUs</div>
                <div class="fs-4 fw-bold text-dark">@Model.TotalSKUs</div>
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-sm-6">
        <div class="kpi-card-warm">
            <div class="kpi-icon-box bg-warning bg-opacity-10 text-warning">
                <i class="fa-solid fa-triangle-exclamation"></i>
            </div>
            <div>
                <div class="text-muted small fw-semibold text-uppercase">Low Stock Alerts</div>
                <div class="fs-4 fw-bold text-warning">@Model.LowStockCount Items</div>
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-sm-6">
        <div class="kpi-card-warm">
            <div class="kpi-icon-box bg-danger bg-opacity-10 text-danger">
                <i class="fa-solid fa-circle-xmark"></i>
            </div>
            <div>
                <div class="text-muted small fw-semibold text-uppercase">Out of Stock</div>
                <div class="fs-4 fw-bold text-danger">@Model.OutOfStockCount Items</div>
            </div>
        </div>
    </div>
</div>

<!-- Filters & Search Bar -->
<div class="panel-inventory p-3 mb-4 text-start">
    <form method="get" asp-action="Index" class="row g-3 align-items-center">
        <div class="col-lg-4 col-md-6">
            <div class="input-group">
                <span class="input-group-text bg-white border-end-0 text-muted"><i class="fa-solid fa-magnifying-glass"></i></span>
                <input type="text" name="search" class="form-control border-start-0 ps-0" placeholder="Search product name or category..." value="@Model.SearchTerm">
            </div>
        </div>
        
        <div class="col-lg-3 col-md-6">
            <select name="category" class="form-select">
                <option value="">All Categories</option>
                @foreach (var cat in Model.CategoriesList)
                {
                    <option value="@cat" selected="@(Model.SelectedCategory == cat ? "selected" : null)">@cat</option>
                }
            </select>
        </div>

        <div class="col-lg-2 col-md-4">
            <select name="status" class="form-select">
                <option value="">All Stock Status</option>
                <option value="In Stock" selected="@(Model.SelectedStatus == "In Stock" ? "selected" : null)">In Stock</option>
                <option value="Low Stock" selected="@(Model.SelectedStatus == "Low Stock" ? "selected" : null)">Low Stock</option>
                <option value="Out of Stock" selected="@(Model.SelectedStatus == "Out of Stock" ? "selected" : null)">Out of Stock</option>
            </select>
        </div>

        <div class="col-lg-2 col-md-4">
            <select name="branchId" class="form-select">
                <option value="">All Branches</option>
                @foreach (var branch in Model.BranchesList)
                {
                    <option value="@branch.BranchId" selected="@(Model.SelectedBranchId == branch.BranchId ? "selected" : null)">@branch.BranchName</option>
                }
            </select>
        </div>

        <div class="col-lg-1 col-md-4 text-end">
            <button type="submit" class="btn btn-primary-warm w-100"><i class="fa-solid fa-filter me-1"></i> Filter</button>
        </div>
    </form>
</div>

<!-- Main Inventory Table Panel -->
<div class="panel-inventory p-0 overflow-hidden mb-5 text-start">
    <div class="p-3 bg-light border-bottom d-flex justify-content-between align-items-center">
        <h6 class="fw-bold mb-0 text-dark"><i class="fa-solid fa-list-check me-2 text-muted"></i>Inventory Stock Registry</h6>
        <span class="badge bg-secondary rounded-pill font-monospace fs-7">Showing @Model.Products.Count SKUs</span>
    </div>

    <div class="table-responsive">
        <table class="table table-inventory mb-0">
            <thead>
                <tr>
                    <th>Product & SKU Code</th>
                    <th>Category</th>
                    <th>Branch Location</th>
                    <th>Estimated Value</th>
                    <th>Current Stock Level</th>
                    <th>Status</th>
                    <th class="text-end">Stock Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Products != null && Model.Products.Any())
                {
                    foreach (var item in Model.Products)
                    {
                        var skuCode = $"SKU-{item.ProductId:D4}";
                        var badgeClass = item.Status == "In Stock" ? "badge-in-stock" :
                                         item.Status == "Low Stock" ? "badge-low-stock" : "badge-out-stock";

                        var estimatedPrice = item.Revenue > 0 && item.SoldQty > 0 ? (item.Revenue / item.SoldQty) : 1500;
                        var stockVal = item.StockQty * estimatedPrice;
                        var progressPercent = Math.Min(100, (item.StockQty * 100) / 200);

                        <tr>
                            <td>
                                <div class="fw-bold text-dark mb-0">@item.ProductName</div>
                                <div class="text-muted small font-monospace">@skuCode</div>
                            </td>
                            <td>
                                <span class="badge bg-light text-dark border">@item.Category</span>
                            </td>
                            <td>
                                <i class="fa-solid fa-building-circle-check text-muted me-1 small"></i>
                                @(item.Branch?.BranchName ?? "Head Office")
                            </td>
                            <td class="fw-bold text-dark">
                                @stockVal.ToString("C0", inCulture)
                            </td>
                            <td style="min-width: 180px;">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <span class="fw-bold small">@item.StockQty units</span>
                                    <span class="text-muted small">Max 200</span>
                                </div>
                                <div class="progress progress-stock">
                                    <div class="progress-bar @(item.StockQty == 0 ? "bg-danger" : item.StockQty <= 50 ? "bg-warning" : "bg-success")" 
                                         role="progressbar" style="width: @progressPercent%" 
                                         aria-valuenow="@item.StockQty" aria-valuemin="0" aria-valuemax="200"></div>
                                </div>
                            </td>
                            <td>
                                <span class="badge rounded-pill px-2.5 py-1.5 @badgeClass">
                                    <i class="fa-solid fa-circle me-1" style="font-size:0.5rem;"></i> @item.Status
                                </span>
                            </td>
                            <td class="text-end">
                                <div class="btn-group">
                                    <form method="post" asp-action="QuickRestock" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="productId" value="@item.ProductId" />
                                        <input type="hidden" name="addQty" value="50" />
                                        <button type="submit" class="btn btn-action-warm btn-sm me-1" title="Quick Restock +50 units">
                                            <i class="fa-solid fa-plus text-success me-1"></i> +50
                                        </button>
                                    </form>
                                    
                                    <button type="button" class="btn btn-action-warm btn-sm me-1" 
                                            onclick="openAdjustModal(@item.ProductId, '@item.ProductName', @item.StockQty)">
                                        <i class="fa-solid fa-sliders text-primary me-1"></i> Adjust
                                    </button>

                                    <a href="/Products/Edit/@item.ProductId" class="btn btn-action-warm btn-sm" title="Edit Product Details">
                                        <i class="fa-solid fa-pen-to-square text-secondary"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="text-center text-muted py-5">
                            <i class="fa-solid fa-boxes-stacked fa-2x mb-3 text-muted opacity-50"></i>
                            <div>No inventory items match your search or filter parameters.</div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Stock Adjustment Log History Panel -->
@if (Model.RecentAdjustments != null && Model.RecentAdjustments.Any())
{
    <div class="panel-inventory p-0 overflow-hidden mb-5 text-start">
        <div class="p-3 bg-light border-bottom">
            <h6 class="fw-bold mb-0 text-dark"><i class="fa-solid fa-clock-rotate-left me-2 text-muted"></i>Recent Stock Movements & Audit Log</h6>
        </div>
        <div class="table-responsive">
            <table class="table table-hover mb-0" style="font-size:0.85rem;">
                <thead class="table-light">
                    <tr>
                        <th>Date & Time</th>
                        <th>Product</th>
                        <th>Adjustment Type</th>
                        <th>Quantity Change</th>
                        <th>Old & New Stock</th>
                        <th>Reason / Notes</th>
                        <th>Logged By</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var log in Model.RecentAdjustments)
                    {
                        var isPos = log.QuantityChange > 0;
                        <tr>
                            <td class="text-muted font-monospace">@log.CreatedAt.ToString("dd MMM yyyy, hh:mm tt")</td>
                            <td class="fw-bold">@log.ProductName</td>
                            <td><span class="badge bg-secondary bg-opacity-10 text-dark">@log.AdjustmentType</span></td>
                            <td class="fw-bold @(isPos ? "text-success" : "text-danger")">
                                @(isPos ? "+" : "")@log.QuantityChange
                            </td>
                            <td>@log.PreviousQty &rarr; <span class="fw-bold">@log.NewQty</span></td>
                            <td class="text-muted">@log.Reason</td>
                            <td><i class="fa-solid fa-user-circle me-1 text-muted"></i>@log.PerformedBy</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

<!-- Stock Adjustment Modal -->
<div class="modal fade text-start" id="adjustStockModal" tabindex="-1" aria-labelledby="adjustStockModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <form method="post" asp-action="AdjustStock">
                @Html.AntiForgeryToken()
                <div class="modal-header bg-light">
                    <h5 class="modal-title fw-bold" id="adjustStockModalLabel"><i class="fa-solid fa-sliders me-2 text-primary"></i>Adjust Inventory Stock</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Select Product</label>
                        <select name="productId" id="modalProductId" class="form-select" required>
                            @foreach (var prod in Model.Products)
                            {
                                <option value="@prod.ProductId">@prod.ProductName (Current Stock: @prod.StockQty)</option>
                            }
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Adjustment Type</label>
                        <select name="adjustmentType" class="form-select" required>
                            <option value="Restock">Restock (+ Add Stock)</option>
                            <option value="Spoilage/Damage">Spoilage / Loss / Damage (- Subtract Stock)</option>
                            <option value="Audit Correction">Audit Correction (= Set Direct Quantity)</option>
                            <option value="Return">Customer Return (+ Add Stock)</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Quantity Delta / New Level</label>
                        <input type="number" name="qtyChange" class="form-control" placeholder="Enter quantity..." min="1" value="10" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Reason / Audit Remarks</label>
                        <textarea name="reason" class="form-control" rows="2" placeholder="Provide reason or audit notes..."></textarea>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary-warm px-4">Save Stock Adjustment</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function openAdjustModal(productId, productName, currentQty) {
            const selectEl = document.getElementById('modalProductId');
            if (selectEl) {
                selectEl.value = productId;
            }
            const modalEl = new bootstrap.Modal(document.getElementById('adjustStockModal'));
            modalEl.show();
        }
    </script>
}

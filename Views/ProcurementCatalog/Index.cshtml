@model List<ERP_System.Models.ProcurementCatalogItem>

@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Procurement Catalog Master";
}

<style>
    .catalog-page {
        animation: catalogFadeIn 0.55s ease both;
    }

    @@keyframes catalogFadeIn {
        from { opacity: 0; transform: translateY(12px); }
        to { opacity: 1; transform: translateY(0); }
    }

    .catalog-header {
        background: linear-gradient(135deg, #ffffff 0%, #f7faff 100%);
        border: 1px solid #e7ecf3;
        border-radius: 18px;
        padding: 22px 26px;
        margin-bottom: 22px;
        box-shadow: 0 8px 28px rgba(15, 23, 42, 0.045);
    }

    .header-icon {
        width: 48px;
        height: 48px;
        min-width: 48px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 14px;
        background: #eef5ff;
        color: #2563eb;
        font-size: 1.25rem;
        box-shadow: inset 0 0 0 1px rgba(37, 99, 235, 0.1);
    }

    .catalog-card {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 18px;
        box-shadow: 0 10px 30px rgba(15, 23, 42, 0.04);
        overflow: hidden;
    }
</style>

<div class="container-fluid px-0 catalog-page">
    <!-- Header -->
    <div class="catalog-header d-flex flex-wrap align-items-center justify-content-between gap-3">
        <div class="d-flex align-items-center gap-3">
            <div class="header-icon">
                <i class="fa-solid fa-boxes-stacked"></i>
            </div>
            <div>
                <div class="d-flex align-items-center gap-2 mb-1">
                    <h4 class="fw-bold mb-0 text-dark">Procurement Catalog Management</h4>
                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2.5 py-1 fw-bold rounded-pill">Admin Master Hub</span>
                </div>
                <p class="text-muted small mb-0">Configure standard catalog materials, unit pricing, and department-level procurement entitlements.</p>
            </div>
        </div>
        <div class="d-flex align-items-center gap-2">
            <button type="button" class="btn btn-primary btn-sm px-3 rounded-pill fw-semibold shadow-sm" data-bs-toggle="modal" data-bs-target="#addCatalogItemModal">
                <i class="fa-solid fa-plus me-1"></i> Add Catalog Item
            </button>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-4 border-0 shadow-sm mb-4" role="alert">
            <div class="d-flex align-items-center gap-2">
                <i class="fa-solid fa-circle-check text-success fs-5"></i>
                <div class="fw-semibold">@TempData["SuccessMessage"]</div>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-4 border-0 shadow-sm mb-4" role="alert">
            <div class="d-flex align-items-center gap-2">
                <i class="fa-solid fa-circle-xmark text-danger fs-5"></i>
                <div class="fw-semibold">@TempData["ErrorMessage"]</div>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Search & Filter Bar -->
    <div class="catalog-card p-3 mb-4">
        <form method="get" asp-action="Index" class="row g-2 align-items-center">
            <div class="col-md-5">
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0"><i class="fa-solid fa-search text-muted"></i></span>
                    <input type="text" name="search" class="form-control border-start-0" placeholder="Search by item name or department..." value="@ViewBag.SearchTerm" />
                </div>
            </div>
            <div class="col-md-4">
                <select name="departmentId" class="form-select" onchange="this.form.submit()">
                    <option value="">-- All Departments --</option>
                    @if (ViewBag.Departments != null)
                    {
                        foreach (var dept in ViewBag.Departments)
                        {
                            if (ViewBag.SelectedDepartmentId != null && (int)ViewBag.SelectedDepartmentId == dept.DepartmentId)
                            {
                                <option value="@dept.DepartmentId" selected="selected">@dept.DepartmentName</option>
                            }
                            else
                            {
                                <option value="@dept.DepartmentId">@dept.DepartmentName</option>
                            }
                        }
                    }
                </select>
            </div>
            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-dark w-100 rounded-pill">Filter</button>
                <a href="@Url.Action("Index", "ProcurementCatalog")" class="btn btn-outline-secondary rounded-pill px-3">Reset</a>
            </div>
        </form>
    </div>

    <!-- Catalog Items Table -->
    <div class="catalog-card">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light text-uppercase small text-muted">
                    <tr>
                        <th class="ps-4">Item #</th>
                        <th>Material Description</th>
                        <th>Department Allocation</th>
                        <th>Standard Unit Price</th>
                        <th>Unit of Measure</th>
                        <th>Status</th>
                        <th class="text-end pe-4">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4 fw-bold text-muted">#@item.Id</td>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="p-2 bg-light rounded-3 text-primary">
                                            <i class="fa-solid fa-box"></i>
                                        </div>
                                        <span class="fw-bold text-dark">@item.ItemName</span>
                                    </div>
                                </td>
                                <td>
                                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2.5 py-1">
                                        <i class="fa-solid fa-building me-1"></i> @(item.Department?.DepartmentName ?? "General Operations")
                                    </span>
                                </td>
                                <td class="fw-bold text-dark fs-6">
                                    ₹ @item.UnitPrice.ToString("N2")
                                </td>
                                <td>
                                    <span class="badge bg-light text-muted border px-2.5 py-1">@item.UnitOfMeasure</span>
                                </td>
                                <td>
                                    @if (item.IsActive)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle px-2.5 py-1">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle px-2.5 py-1">Inactive</span>
                                    }
                                </td>
                                <td class="text-end pe-4">
                                    <button type="button" class="btn btn-sm btn-outline-primary me-1 px-2.5 rounded-pill" 
                                            onclick="openEditModal(@item.Id, '@item.ItemName.Replace("'", "\\'")', @item.DepartmentId, @item.UnitPrice, '@item.UnitOfMeasure', @(item.IsActive ? "true" : "false"))">
                                        <i class="fa-solid fa-pencil"></i> Edit
                                    </button>
                                    <form asp-action="Delete" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to remove this catalog item?');">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger px-2.5 rounded-pill">
                                            <i class="fa-solid fa-trash"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center py-5 text-muted">
                                <i class="fa-solid fa-boxes-stacked fs-2 text-muted mb-2"></i>
                                <div>No catalog items found matching criteria.</div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal: Add Catalog Item -->
<div class="modal fade" id="addCatalogItemModal" tabindex="-1" aria-labelledby="addModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 18px;">
            <div class="modal-header bg-light border-bottom px-4 py-3">
                <h5 class="modal-title fw-bold text-dark" id="addModalLabel">
                    <i class="fa-solid fa-plus text-primary me-2"></i> Add New Catalog Material
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label fw-bold small text-dark">Material / Item Name *</label>
                        <input type="text" name="ItemName" class="form-control" placeholder="e.g. 27-Inch 4K UHD Monitor" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold small text-dark">Department Mapping *</label>
                        <select name="DepartmentId" class="form-select" required>
                            <option value="">-- Select Department --</option>
                            @if (ViewBag.Departments != null)
                            {
                                foreach (var dept in ViewBag.Departments)
                                {
                                    <option value="@dept.DepartmentId">@dept.DepartmentName</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="row g-2 mb-3">
                        <div class="col-md-7">
                            <label class="form-label fw-bold small text-dark">Unit Price (INR ₹) *</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light">₹</span>
                                <input type="number" step="0.01" name="UnitPrice" class="form-control" placeholder="1250.00" required />
                            </div>
                        </div>
                        <div class="col-md-5">
                            <label class="form-label fw-bold small text-dark">Unit of Measure *</label>
                            <select name="UnitOfMeasure" class="form-select" required>
                                <option value="Unit" selected>Unit</option>
                                <option value="Piece">Piece</option>
                                <option value="Box">Box</option>
                                <option value="Pack">Pack</option>
                                <option value="Ream">Ream</option>
                                <option value="Set">Set</option>
                                <option value="Roll">Roll</option>
                            </select>
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light px-4 py-3 d-flex justify-content-between">
                    <button type="button" class="btn btn-secondary btn-sm rounded-pill" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary btn-sm px-4 rounded-pill fw-bold">
                        <i class="fa-solid fa-save me-1"></i> Save Material
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal: Edit Catalog Item -->
<div class="modal fade" id="editCatalogItemModal" tabindex="-1" aria-labelledby="editModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 18px;">
            <div class="modal-header bg-light border-bottom px-4 py-3">
                <h5 class="modal-title fw-bold text-dark" id="editModalLabel">
                    <i class="fa-solid fa-pencil text-primary me-2"></i> Edit Catalog Material
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="Edit" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="Id" id="editItemId" />
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label fw-bold small text-dark">Material / Item Name *</label>
                        <input type="text" name="ItemName" id="editItemName" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold small text-dark">Department Mapping *</label>
                        <select name="DepartmentId" id="editDepartmentId" class="form-select" required>
                            @if (ViewBag.Departments != null)
                            {
                                foreach (var dept in ViewBag.Departments)
                                {
                                    <option value="@dept.DepartmentId">@dept.DepartmentName</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="row g-2 mb-3">
                        <div class="col-md-7">
                            <label class="form-label fw-bold small text-dark">Unit Price (INR ₹) *</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light">₹</span>
                                <input type="number" step="0.01" name="UnitPrice" id="editUnitPrice" class="form-control" required />
                            </div>
                        </div>
                        <div class="col-md-5">
                            <label class="form-label fw-bold small text-dark">Unit of Measure *</label>
                            <select name="UnitOfMeasure" id="editUnitOfMeasure" class="form-select" required>
                                <option value="Unit">Unit</option>
                                <option value="Piece">Piece</option>
                                <option value="Box">Box</option>
                                <option value="Pack">Pack</option>
                                <option value="Ream">Ream</option>
                                <option value="Set">Set</option>
                                <option value="Roll">Roll</option>
                            </select>
                        </div>
                    </div>
                    <div class="form-check form-switch mt-2">
                        <input class="form-check-input" type="checkbox" name="IsActive" id="editIsActive" value="true" />
                        <label class="form-check-label small fw-bold text-dark" for="editIsActive">Active for Requisitions</label>
                    </div>
                </div>
                <div class="modal-footer bg-light px-4 py-3 d-flex justify-content-between">
                    <button type="button" class="btn btn-secondary btn-sm rounded-pill" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary btn-sm px-4 rounded-pill fw-bold">
                        <i class="fa-solid fa-check me-1"></i> Update Material
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function openEditModal(id, name, deptId, price, uom, isActive) {
            document.getElementById('editItemId').value = id;
            document.getElementById('editItemName').value = name;
            document.getElementById('editDepartmentId').value = deptId;
            document.getElementById('editUnitPrice').value = price;
            document.getElementById('editUnitOfMeasure').value = uom || 'Unit';
            document.getElementById('editIsActive').checked = isActive;

            var modalEl = document.getElementById('editCatalogItemModal');
            var modal = new bootstrap.Modal(modalEl);
            modal.show();
        }
    </script>
}

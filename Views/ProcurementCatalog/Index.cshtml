@model List<ERP_System.Models.ProcurementCatalogItem>

@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Procurement Catalog Master";
}

<style>
    :root {
        --catalog-primary: #2563eb;
        --catalog-primary-dark: #1d4ed8;
        --catalog-primary-soft: #eff6ff;
        --catalog-success: #16a34a;
        --catalog-danger: #dc2626;
        --catalog-warning: #d97706;
        --catalog-text: #172033;
        --catalog-muted: #64748b;
        --catalog-border: #e5eaf1;
        --catalog-bg: #f7f9fc;
        --catalog-shadow: 0 12px 35px rgba(15, 23, 42, 0.055);
        --catalog-radius: 18px;
    }

    * {
        box-sizing: border-box;
    }

    .catalog-page {
        min-height: 100%;
        padding-bottom: 35px;
        animation: catalogPageIn 0.55s ease both;
    }

    @@keyframes catalogPageIn {
        from {
            opacity: 0;
            transform: translateY(14px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* =========================
           HEADER
        ========================= */

    .catalog-header {
        position: relative;
        overflow: hidden;
        background: radial-gradient(circle at 92% 15%, rgba(37, 99, 235, 0.08), transparent 28%), linear-gradient(135deg, #ffffff 0%, #f8fbff 100%);
        border: 1px solid var(--catalog-border);
        border-radius: var(--catalog-radius);
        padding: 23px 26px;
        margin-bottom: 22px;
        box-shadow: var(--catalog-shadow);
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

        .catalog-header::before {
            content: "";
            position: absolute;
            width: 180px;
            height: 180px;
            right: -75px;
            top: -90px;
            border-radius: 50%;
            background: rgba(37, 99, 235, 0.055);
            pointer-events: none;
        }

        .catalog-header:hover {
            transform: translateY(-2px);
            box-shadow: 0 16px 40px rgba(15, 23, 42, 0.075);
        }

    .header-icon {
        width: 52px;
        height: 52px;
        min-width: 52px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 15px;
        background: linear-gradient(135deg, #eff6ff, #e0ecff);
        color: var(--catalog-primary);
        font-size: 1.3rem;
        box-shadow: inset 0 0 0 1px rgba(37, 99, 235, 0.10), 0 8px 20px rgba(37, 99, 235, 0.08);
        transition: all 0.3s ease;
    }

    .catalog-header:hover .header-icon {
        transform: rotate(-3deg) scale(1.05);
    }

    .catalog-title {
        color: var(--catalog-text);
        font-size: 1.2rem;
        letter-spacing: -0.25px;
    }

    .catalog-subtitle {
        color: var(--catalog-muted);
        line-height: 1.55;
    }

    .admin-badge {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 5px 10px;
        border-radius: 999px;
        font-size: 0.7rem;
        font-weight: 700;
        color: #1d4ed8;
        background: #eff6ff;
        border: 1px solid #dbeafe;
        white-space: nowrap;
    }

    /* =========================
           BUTTONS
        ========================= */

    .catalog-add-btn {
        position: relative;
        overflow: hidden;
        border: 0;
        min-height: 40px;
        padding: 0 17px;
        background: linear-gradient(135deg, #2563eb, #1d4ed8);
        box-shadow: 0 8px 18px rgba(37, 99, 235, 0.18);
        transition: all 0.28s ease;
    }

        .catalog-add-btn::after {
            content: "";
            position: absolute;
            top: 0;
            left: -120%;
            width: 70%;
            height: 100%;
            background: linear-gradient( 90deg, transparent, rgba(255,255,255,0.25), transparent );
            transform: skewX(-20deg);
            transition: left 0.6s ease;
        }

        .catalog-add-btn:hover {
            transform: translateY(-2px);
            background: linear-gradient(135deg, #1d4ed8, #1e40af);
            box-shadow: 0 12px 24px rgba(37, 99, 235, 0.24);
        }

            .catalog-add-btn:hover::after {
                left: 130%;
            }

        .catalog-add-btn:active {
            transform: translateY(0);
        }

    /* =========================
           ALERTS
        ========================= */

    .catalog-alert {
        border-radius: 14px !important;
        padding: 13px 16px;
        animation: alertSlide 0.45s ease both;
    }

    @@keyframes alertSlide {
        from {
            opacity: 0;
            transform: translateY(-8px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* =========================
           COMMON CARD
        ========================= */

    .catalog-card {
        background: #ffffff;
        border: 1px solid var(--catalog-border);
        border-radius: var(--catalog-radius);
        box-shadow: var(--catalog-shadow);
        overflow: hidden;
        transition: box-shadow 0.3s ease, transform 0.3s ease;
    }

        .catalog-card:hover {
            box-shadow: 0 15px 38px rgba(15, 23, 42, 0.065);
        }

    /* =========================
           SEARCH AREA
        ========================= */

    .catalog-filter-card {
        padding: 15px;
        background: linear-gradient(135deg, #ffffff 0%, #fbfdff 100%);
    }

    .catalog-filter-form {
        margin: 0;
    }

    .catalog-field-label {
        display: block;
        margin-bottom: 6px;
        padding-left: 3px;
        font-size: 0.68rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.7px;
        color: #7a8699;
    }

    .catalog-input-group {
        min-height: 44px;
        border: 1px solid #e1e7ef;
        border-radius: 12px;
        overflow: hidden;
        background: #ffffff;
        transition: all 0.25s ease;
    }

        .catalog-input-group:focus-within {
            border-color: rgba(37, 99, 235, 0.45);
            box-shadow: 0 0 0 4px rgba(37, 99, 235, 0.08);
            transform: translateY(-1px);
        }

        .catalog-input-group .input-group-text {
            border: 0;
            background: #f8fafc;
            color: #64748b;
            padding-left: 14px;
            padding-right: 11px;
        }

    .catalog-search-input {
        min-height: 42px;
        border: 0 !important;
        box-shadow: none !important;
        font-size: 0.88rem;
        color: var(--catalog-text);
    }

        .catalog-search-input::placeholder {
            color: #9aa5b5;
        }

    .catalog-department-select {
        min-height: 44px;
        border: 1px solid #e1e7ef;
        border-radius: 12px;
        padding-left: 13px;
        padding-right: 38px;
        color: #263247;
        font-size: 0.88rem;
        font-weight: 600;
        background-color: #ffffff;
        transition: all 0.25s ease;
        cursor: pointer;
    }

        .catalog-department-select:hover {
            border-color: #cbd5e1;
        }

        .catalog-department-select:focus {
            border-color: rgba(37, 99, 235, 0.45);
            box-shadow: 0 0 0 4px rgba(37, 99, 235, 0.08);
        }

    .auto-filter-note {
        display: flex;
        align-items: center;
        gap: 6px;
        margin-top: 6px;
        padding-left: 3px;
        color: #8a96a8;
        font-size: 0.68rem;
        font-weight: 600;
    }

    .auto-filter-dot {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: #22c55e;
        box-shadow: 0 0 0 4px rgba(34, 197, 94, 0.10);
        animation: filterPulse 1.8s infinite;
    }

    @@keyframes filterPulse {
        0%, 100% {
            opacity: 1;
            transform: scale(1);
        }

        50% {
            opacity: 0.55;
            transform: scale(0.82);
        }
    }

    /* =========================
           TABLE
        ========================= */

    .catalog-table-wrap {
        overflow-x: auto;
        scrollbar-width: thin;
        scrollbar-color: #cbd5e1 transparent;
    }

        .catalog-table-wrap::-webkit-scrollbar {
            height: 7px;
        }

        .catalog-table-wrap::-webkit-scrollbar-track {
            background: transparent;
        }

        .catalog-table-wrap::-webkit-scrollbar-thumb {
            background: #cbd5e1;
            border-radius: 20px;
        }

    .catalog-table {
        min-width: 1050px;
        margin-bottom: 0 !important;
    }

        .catalog-table thead th {
            padding-top: 15px;
            padding-bottom: 15px;
            background: #f8fafc;
            border-bottom: 1px solid #e6ebf2;
            color: #6b778a;
            font-size: 0.68rem;
            font-weight: 800;
            letter-spacing: 0.65px;
            white-space: nowrap;
        }

        .catalog-table tbody tr {
            position: relative;
            transition: background-color 0.22s ease, transform 0.22s ease, box-shadow 0.22s ease;
        }

            .catalog-table tbody tr:hover {
                background-color: #fbfdff;
            }

        .catalog-table tbody td {
            padding-top: 15px;
            padding-bottom: 15px;
            border-color: #edf1f5;
            color: #344054;
            vertical-align: middle;
        }

    .catalog-item-number {
        font-size: 0.78rem;
        color: #7b8798;
        letter-spacing: 0.2px;
    }

    .catalog-item-icon {
        width: 40px;
        height: 40px;
        min-width: 40px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 11px;
        background: linear-gradient(135deg, #f3f7ff, #eef4ff);
        color: #2563eb;
        border: 1px solid #e0eaff;
        transition: all 0.28s ease;
    }

    .catalog-table tbody tr:hover .catalog-item-icon {
        transform: translateY(-2px) rotate(-3deg);
        box-shadow: 0 7px 15px rgba(37, 99, 235, 0.10);
    }

    .catalog-item-name {
        color: #172033;
        font-size: 0.88rem;
        line-height: 1.35;
    }

    .department-badge,
    .uom-badge,
    .status-badge {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        border-radius: 999px;
        padding: 6px 10px;
        font-size: 0.7rem;
        font-weight: 700;
        white-space: nowrap;
    }

    .department-badge {
        color: #2563eb;
        background: #eff6ff;
        border: 1px solid #dbeafe;
    }

    .uom-badge {
        color: #64748b;
        background: #f8fafc;
        border: 1px solid #e2e8f0;
    }

    .status-badge.active {
        color: #15803d;
        background: #f0fdf4;
        border: 1px solid #dcfce7;
    }

    .status-badge.inactive {
        color: #64748b;
        background: #f8fafc;
        border: 1px solid #e2e8f0;
    }

    .price-value {
        color: #172033;
        font-size: 0.95rem;
        font-weight: 800;
        white-space: nowrap;
    }

    .catalog-action-btn {
        min-width: 72px;
        transition: all 0.24s ease;
    }

        .catalog-action-btn:hover {
            transform: translateY(-1px);
        }

    .catalog-delete-btn {
        width: 36px;
        min-width: 36px;
        padding-left: 0 !important;
        padding-right: 0 !important;
    }

    /* =========================
           EMPTY STATE
        ========================= */

    .catalog-empty-state {
        padding: 65px 20px !important;
    }

    .empty-icon {
        width: 62px;
        height: 62px;
        margin: 0 auto 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 18px;
        background: #f8fafc;
        border: 1px solid #e8edf3;
        color: #94a3b8;
        font-size: 1.55rem;
        animation: emptyFloat 2.8s ease-in-out infinite;
    }

    @@keyframes emptyFloat {
        0%, 100% {
            transform: translateY(0);
        }

        50% {
            transform: translateY(-5px);
        }
    }

    .empty-title {
        color: #334155;
        font-weight: 800;
        font-size: 0.95rem;
    }

    .empty-description {
        color: #94a3b8;
        font-size: 0.78rem;
    }

    /* =========================
           MODALS
        ========================= */

    .catalog-modal-content {
        border: 1px solid rgba(226, 232, 240, 0.9) !important;
        border-radius: 20px !important;
        overflow: hidden;
        box-shadow: 0 25px 70px rgba(15, 23, 42, 0.16) !important;
    }

    .modal.fade .catalog-modal-content {
        transform: translateY(15px) scale(0.985);
        transition: transform 0.28s ease;
    }

    .modal.show .catalog-modal-content {
        transform: translateY(0) scale(1);
    }

    .catalog-modal-header {
        position: relative;
        padding: 17px 20px !important;
        background: linear-gradient(135deg, #f8fafc, #ffffff);
        border-bottom: 1px solid #e8edf3 !important;
    }

    .catalog-modal-title {
        color: #172033;
        font-size: 0.98rem;
    }

    .modal-title-icon {
        width: 32px;
        height: 32px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 9px;
        background: #eff6ff;
        color: #2563eb;
    }

    .catalog-modal-body {
        padding: 21px !important;
        background: #ffffff;
    }

    .catalog-form-label {
        color: #344054;
        font-size: 0.75rem;
        margin-bottom: 7px;
    }

    .catalog-form-control,
    .catalog-form-select {
        min-height: 43px;
        border: 1px solid #dfe5ec;
        border-radius: 11px;
        font-size: 0.84rem;
        color: #1e293b;
        transition: all 0.22s ease;
    }

        .catalog-form-control:focus,
        .catalog-form-select:focus {
            border-color: rgba(37, 99, 235, 0.50);
            box-shadow: 0 0 0 4px rgba(37, 99, 235, 0.08);
        }

    .catalog-price-group {
        border-radius: 11px;
        overflow: hidden;
    }

        .catalog-price-group .input-group-text {
            border-color: #dfe5ec;
            background: #f8fafc;
            color: #64748b;
            font-weight: 700;
        }

        .catalog-price-group .form-control {
            border-left: 0;
        }

    .catalog-modal-footer {
        padding: 14px 21px !important;
        background: #f8fafc;
        border-top: 1px solid #e8edf3 !important;
    }

    .modal-cancel-btn {
        border-radius: 999px;
        font-weight: 600;
        padding-left: 16px;
        padding-right: 16px;
    }

    .modal-save-btn {
        border-radius: 999px;
        padding-left: 18px;
        padding-right: 18px;
        font-weight: 700;
        box-shadow: 0 7px 16px rgba(37, 99, 235, 0.15);
        transition: all 0.25s ease;
    }

        .modal-save-btn:hover {
            transform: translateY(-1px);
            box-shadow: 0 10px 20px rgba(37, 99, 235, 0.20);
        }

    /* =========================
           SWITCH
        ========================= */

    .catalog-switch .form-check-input {
        width: 2.5em;
        height: 1.35em;
        cursor: pointer;
    }

        .catalog-switch .form-check-input:focus {
            box-shadow: 0 0 0 4px rgba(37, 99, 235, 0.08);
        }

    .catalog-switch .form-check-label {
        margin-left: 4px;
        color: #344054;
    }

    /* =========================
           RESPONSIVE
        ========================= */

    @@media (max-width: 991.98px) {
        .catalog-header {
            padding: 20px;
        }

            .catalog-header .catalog-add-btn {
                width: 100%;
            }

            .catalog-header > .d-flex:last-child {
                width: 100%;
            }

        .catalog-title {
            font-size: 1.05rem;
        }
    }

    @@media (max-width: 767.98px) {
        .catalog-page {
            padding-left: 4px;
            padding-right: 4px;
        }

        .catalog-header {
            padding: 18px;
            border-radius: 15px;
        }

        .header-icon {
            width: 46px;
            height: 46px;
            min-width: 46px;
            border-radius: 13px;
        }

        .catalog-header .d-flex.align-items-center.gap-3:first-child {
            align-items: flex-start !important;
        }

        .admin-badge {
            font-size: 0.64rem;
            padding: 4px 8px;
        }

        .catalog-subtitle {
            font-size: 0.72rem !important;
        }

        .catalog-card {
            border-radius: 15px;
        }

        .catalog-filter-card {
            padding: 13px;
        }

        .catalog-filter-form > div {
            width: 100%;
        }

        .catalog-modal-body {
            padding: 17px !important;
        }

        .catalog-modal-footer {
            flex-direction: column-reverse;
            gap: 8px;
        }

            .catalog-modal-footer button {
                width: 100%;
            }
    }

    @@media (max-width: 575.98px) {
        .catalog-header {
            padding: 16px;
        }

            .catalog-header .d-flex.align-items-center.gap-3:first-child {
                gap: 11px !important;
            }

        .catalog-title {
            font-size: 0.98rem;
        }

        .catalog-subtitle {
            font-size: 0.69rem !important;
        }

        .catalog-add-btn {
            min-height: 42px;
            width: 100%;
        }

        .catalog-filter-card {
            padding: 11px;
        }

        .catalog-field-label {
            font-size: 0.63rem;
        }

        .catalog-search-input,
        .catalog-department-select {
            font-size: 0.8rem;
        }

        .catalog-empty-state {
            padding: 48px 15px !important;
        }

        .catalog-modal-content {
            border-radius: 16px !important;
        }
    }
</style>

<div class="container-fluid px-0 catalog-page">

    <!-- =========================
         HEADER
    ========================== -->
    <div class="catalog-header d-flex flex-wrap align-items-center justify-content-between gap-3">

        <div class="d-flex align-items-center gap-3">
            <div class="header-icon">
                <i class="fa-solid fa-boxes-stacked"></i>
            </div>

            <div>
                <div class="d-flex align-items-center flex-wrap gap-2 mb-1">
                    <h4 class="catalog-title fw-bold mb-0">
                        Procurement Catalog Management
                    </h4>

                    <span class="admin-badge">
                        <i class="fa-solid fa-shield-halved"></i>
                        Admin Master Hub
                    </span>
                </div>

                <p class="catalog-subtitle small mb-0">
                    Configure standard catalog materials, unit pricing, and department-level procurement entitlements.
                </p>
            </div>
        </div>

        <div class="d-flex align-items-center gap-2">
            <button type="button"
                    class="btn btn-primary btn-sm rounded-pill fw-semibold catalog-add-btn"
                    data-bs-toggle="modal"
                    data-bs-target="#addCatalogItemModal">

                <i class="fa-solid fa-plus me-1"></i>
                Add Catalog Item
            </button>
        </div>
    </div>


    <!-- =========================
         SUCCESS MESSAGE
    ========================== -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show catalog-alert rounded-4 border-0 shadow-sm mb-4"
             role="alert">

            <div class="d-flex align-items-center gap-2">
                <i class="fa-solid fa-circle-check text-success fs-5"></i>

                <div class="fw-semibold">
                    @TempData["SuccessMessage"]
                </div>
            </div>

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Close">
            </button>
        </div>
    }


    <!-- =========================
         ERROR MESSAGE
    ========================== -->
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show catalog-alert rounded-4 border-0 shadow-sm mb-4"
             role="alert">

            <div class="d-flex align-items-center gap-2">
                <i class="fa-solid fa-circle-xmark text-danger fs-5"></i>

                <div class="fw-semibold">
                    @TempData["ErrorMessage"]
                </div>
            </div>

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Close">
            </button>
        </div>
    }


    <!-- =========================
         SEARCH & AUTO DEPARTMENT FILTER
    ========================== -->
    <div class="catalog-card catalog-filter-card mb-4">

        <form method="get"
              asp-action="Index"
              class="catalog-filter-form row g-3 align-items-end">

            <!-- SEARCH -->
            <div class="col-lg-7 col-md-7">

                <label class="catalog-field-label">
                    Search Catalog
                </label>

                <div class="input-group catalog-input-group">

                    <span class="input-group-text">
                        <i class="fa-solid fa-magnifying-glass"></i>
                    </span>

                    <input type="text"
                           name="search"
                           class="form-control catalog-search-input"
                           placeholder="Search by item name or department..."
                           value="@ViewBag.SearchTerm" />
                </div>

            </div>


            <!-- DEPARTMENT -->
            <div class="col-lg-5 col-md-5">

                <label class="catalog-field-label">
                    Department
                </label>

                <select name="departmentId"
                        class="form-select catalog-department-select"
                        onchange="this.form.submit()">

                    <option value="">
                        -- All Departments --
                    </option>

                    @if (ViewBag.Departments != null)
                    {
                        foreach (var dept in ViewBag.Departments)
                        {
                            if (ViewBag.SelectedDepartmentId != null &&
                            (int)ViewBag.SelectedDepartmentId == dept.DepartmentId)
                            {
                                <option value="@dept.DepartmentId"
                                        selected="selected">
                                    @dept.DepartmentName
                                </option>
                            }
                            else
                            {
                                <option value="@dept.DepartmentId">
                                    @dept.DepartmentName
                                </option>
                            }
                        }
                    }

                </select>

                <div class="auto-filter-note">
                    <span class="auto-filter-dot"></span>
                    Department filter applies automatically when selected
                </div>

            </div>

        </form>

    </div>


    <!-- =========================
         CATALOG TABLE
    ========================== -->
    <div class="catalog-card">

        <div class="catalog-table-wrap">

            <table class="table table-hover align-middle catalog-table">

                <thead class="text-uppercase">

                    <tr>

                        <th class="ps-4">
                            Item #
                        </th>

                        <th>
                            Material Description
                        </th>

                        <th>
                            Department Allocation
                        </th>

                        <th>
                            Standard Unit Price
                        </th>

                        <th>
                            Unit of Measure
                        </th>

                        <th>
                            Status
                        </th>

                        <th class="text-end pe-4">
                            Actions
                        </th>

                    </tr>

                </thead>


                <tbody>

                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>

                                <!-- ITEM NUMBER -->
                                <td class="ps-4">

                                    <span class="catalog-item-number fw-bold">
                                        #@item.Id
                                    </span>

                                </td>


                                <!-- ITEM NAME -->
                                <td>

                                    <div class="d-flex align-items-center gap-3">

                                        <div class="catalog-item-icon">
                                            <i class="fa-solid fa-box"></i>
                                        </div>

                                        <span class="catalog-item-name fw-bold">
                                            @item.ItemName
                                        </span>

                                    </div>

                                </td>


                                <!-- DEPARTMENT -->
                                <td>

                                    <span class="department-badge">

                                        <i class="fa-solid fa-building"></i>

                                        @(item.Department?.DepartmentName ?? "General Operations")

                                    </span>

                                </td>


                                <!-- PRICE -->
                                <td>

                                    <span class="price-value">
                                        ₹ @item.UnitPrice.ToString("N2")
                                    </span>

                                </td>


                                <!-- UOM -->
                                <td>

                                    <span class="uom-badge">
                                        @item.UnitOfMeasure
                                    </span>

                                </td>


                                <!-- STATUS -->
                                <td>

                                    @if (item.IsActive)
                                    {
                                        <span class="status-badge active">

                                            <i class="fa-solid fa-circle-check"></i>
                                            Active

                                        </span>
                                    }
                                    else
                                    {
                                        <span class="status-badge inactive">

                                            <i class="fa-solid fa-circle-minus"></i>
                                            Inactive

                                        </span>
                                    }

                                </td>


                                <!-- ACTIONS -->
                                <td class="text-end pe-4">

                                    <button type="button"
                                            class="btn btn-sm btn-outline-primary me-1 px-3 rounded-pill catalog-action-btn"
                                            onclick="openEditModal(@item.Id, '@item.ItemName.Replace("'", "\\'")', @item.DepartmentId, @item.UnitPrice, '@item.UnitOfMeasure', @(item.IsActive ? "true" : "false"))">

                                        <i class="fa-solid fa-pencil me-1"></i>
                                        Edit

                                    </button>


                                    <form asp-action="Delete"
                                          method="post"
                                          class="d-inline"
                                          onsubmit="return confirm('Are you sure you want to remove this catalog item?');">

                                        @Html.AntiForgeryToken()

                                        <input type="hidden"
                                               name="id"
                                               value="@item.Id" />

                                        <button type="submit"
                                                class="btn btn-sm btn-outline-danger rounded-pill catalog-action-btn catalog-delete-btn">

                                            <i class="fa-solid fa-trash"></i>

                                        </button>

                                    </form>

                                </td>

                            </tr>
                        }
                    }
                    else
                    {
                        <tr>

                            <td colspan="7"
                                class="text-center catalog-empty-state">

                                <div class="empty-icon">
                                    <i class="fa-solid fa-boxes-stacked"></i>
                                </div>

                                <div class="empty-title mb-1">
                                    No Catalog Items Found
                                </div>

                                <div class="empty-description">
                                    No catalog items match the current search or department selection.
                                </div>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>


<!-- =========================================================
     MODAL: ADD CATALOG ITEM
========================================================= -->

<div class="modal fade"
     id="addCatalogItemModal"
     tabindex="-1"
     aria-labelledby="addModalLabel"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content catalog-modal-content">

            <!-- MODAL HEADER -->
            <div class="modal-header catalog-modal-header">

                <h5 class="modal-title catalog-modal-title fw-bold"
                    id="addModalLabel">

                    <span class="modal-title-icon me-2">
                        <i class="fa-solid fa-plus"></i>
                    </span>

                    Add New Catalog Material

                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Close">
                </button>

            </div>


            <!-- FORM -->
            <form asp-action="Create"
                  method="post">

                @Html.AntiForgeryToken()

                <div class="modal-body catalog-modal-body">

                    <!-- ITEM NAME -->
                    <div class="mb-3">

                        <label class="form-label catalog-form-label fw-bold">
                            Material / Item Name *
                        </label>

                        <input type="text"
                               name="ItemName"
                               class="form-control catalog-form-control"
                               placeholder="e.g. 27-Inch 4K UHD Monitor"
                               required />

                    </div>


                    <!-- DEPARTMENT -->
                    <div class="mb-3">

                        <label class="form-label catalog-form-label fw-bold">
                            Department Mapping *
                        </label>

                        <select name="DepartmentId"
                                class="form-select catalog-form-select"
                                required>

                            <option value="">
                                -- Select Department --
                            </option>

                            @if (ViewBag.Departments != null)
                            {
                                foreach (var dept in ViewBag.Departments)
                                {
                                    <option value="@dept.DepartmentId">
                                        @dept.DepartmentName
                                    </option>
                                }
                            }

                        </select>

                    </div>


                    <!-- PRICE + UOM -->
                    <div class="row g-3 mb-3">

                        <div class="col-md-7">

                            <label class="form-label catalog-form-label fw-bold">
                                Unit Price (INR ₹) *
                            </label>

                            <div class="input-group catalog-price-group">

                                <span class="input-group-text">
                                    ₹
                                </span>

                                <input type="number"
                                       step="0.01"
                                       name="UnitPrice"
                                       class="form-control catalog-form-control"
                                       placeholder="1250.00"
                                       required />

                            </div>

                        </div>


                        <div class="col-md-5">

                            <label class="form-label catalog-form-label fw-bold">
                                Unit of Measure *
                            </label>

                            <select name="UnitOfMeasure"
                                    class="form-select catalog-form-select"
                                    required>

                                <option value="Unit" selected>
                                    Unit
                                </option>

                                <option value="Piece">
                                    Piece
                                </option>

                                <option value="Box">
                                    Box
                                </option>

                                <option value="Pack">
                                    Pack
                                </option>

                                <option value="Ream">
                                    Ream
                                </option>

                                <option value="Set">
                                    Set
                                </option>

                                <option value="Roll">
                                    Roll
                                </option>

                            </select>

                        </div>

                    </div>

                </div>


                <!-- MODAL FOOTER -->
                <div class="modal-footer catalog-modal-footer d-flex justify-content-between">

                    <button type="button"
                            class="btn btn-secondary btn-sm modal-cancel-btn"
                            data-bs-dismiss="modal">

                        Cancel

                    </button>

                    <button type="submit"
                            class="btn btn-primary btn-sm modal-save-btn">

                        <i class="fa-solid fa-save me-1"></i>
                        Save Material

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>


<!-- =========================================================
     MODAL: EDIT CATALOG ITEM
========================================================= -->

<div class="modal fade"
     id="editCatalogItemModal"
     tabindex="-1"
     aria-labelledby="editModalLabel"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content catalog-modal-content">

            <!-- MODAL HEADER -->
            <div class="modal-header catalog-modal-header">

                <h5 class="modal-title catalog-modal-title fw-bold"
                    id="editModalLabel">

                    <span class="modal-title-icon me-2">
                        <i class="fa-solid fa-pencil"></i>
                    </span>

                    Edit Catalog Material

                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Close">
                </button>

            </div>


            <!-- FORM -->
            <form asp-action="Edit"
                  method="post">

                @Html.AntiForgeryToken()

                <input type="hidden"
                       name="Id"
                       id="editItemId" />


                <div class="modal-body catalog-modal-body">

                    <!-- ITEM NAME -->
                    <div class="mb-3">

                        <label class="form-label catalog-form-label fw-bold">
                            Material / Item Name *
                        </label>

                        <input type="text"
                               name="ItemName"
                               id="editItemName"
                               class="form-control catalog-form-control"
                               required />

                    </div>


                    <!-- DEPARTMENT -->
                    <div class="mb-3">

                        <label class="form-label catalog-form-label fw-bold">
                            Department Mapping *
                        </label>

                        <select name="DepartmentId"
                                id="editDepartmentId"
                                class="form-select catalog-form-select"
                                required>

                            @if (ViewBag.Departments != null)
                            {
                                foreach (var dept in ViewBag.Departments)
                                {
                                    <option value="@dept.DepartmentId">
                                        @dept.DepartmentName
                                    </option>
                                }
                            }

                        </select>

                    </div>


                    <!-- PRICE + UOM -->
                    <div class="row g-3 mb-3">

                        <div class="col-md-7">

                            <label class="form-label catalog-form-label fw-bold">
                                Unit Price (INR ₹) *
                            </label>

                            <div class="input-group catalog-price-group">

                                <span class="input-group-text">
                                    ₹
                                </span>

                                <input type="number"
                                       step="0.01"
                                       name="UnitPrice"
                                       id="editUnitPrice"
                                       class="form-control catalog-form-control"
                                       required />

                            </div>

                        </div>


                        <div class="col-md-5">

                            <label class="form-label catalog-form-label fw-bold">
                                Unit of Measure *
                            </label>

                            <select name="UnitOfMeasure"
                                    id="editUnitOfMeasure"
                                    class="form-select catalog-form-select"
                                    required>

                                <option value="Unit">
                                    Unit
                                </option>

                                <option value="Piece">
                                    Piece
                                </option>

                                <option value="Box">
                                    Box
                                </option>

                                <option value="Pack">
                                    Pack
                                </option>

                                <option value="Ream">
                                    Ream
                                </option>

                                <option value="Set">
                                    Set
                                </option>

                                <option value="Roll">
                                    Roll
                                </option>

                            </select>

                        </div>

                    </div>


                    <!-- ACTIVE SWITCH -->
                    <div class="form-check form-switch catalog-switch mt-2">

                        <input class="form-check-input"
                               type="checkbox"
                               name="IsActive"
                               id="editIsActive"
                               value="true" />

                        <label class="form-check-label small fw-bold"
                               for="editIsActive">

                            Active for Requisitions

                        </label>

                    </div>

                </div>


                <!-- MODAL FOOTER -->
                <div class="modal-footer catalog-modal-footer d-flex justify-content-between">

                    <button type="button"
                            class="btn btn-secondary btn-sm modal-cancel-btn"
                            data-bs-dismiss="modal">

                        Cancel

                    </button>

                    <button type="submit"
                            class="btn btn-primary btn-sm modal-save-btn">

                        <i class="fa-solid fa-check me-1"></i>
                        Update Material

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>


@section Scripts {

    <script>

        function openEditModal(id, name, deptId, price, uom, isActive) {

            document.getElementById('editItemId').value = id;

            document.getElementById('editItemName').value = name;

            document.getElementById('editDepartmentId').value = deptId;

            document.getElementById('editUnitPrice').value = price;

            document.getElementById('editUnitOfMeasure').value =
                uom || 'Unit';

            document.getElementById('editIsActive').checked =
                isActive;


            var modalEl =
                document.getElementById('editCatalogItemModal');

            var modal =
                new bootstrap.Modal(modalEl);

            modal.show();

        }

    </script>

}
@model List<ERP_System.Models.JournalVoucher>

@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Journal & Vouchers Register";
    var inCulture = new System.Globalization.CultureInfo("en-IN");
    var currentType = ViewBag.CurrentType as string ?? "All";
    var currentStatus = ViewBag.CurrentStatus as string ?? "All";
    var searchTerm = ViewBag.SearchTerm as string ?? "";
}

<style>
    /* =========================================================
       JOURNAL & VOUCHERS - PREMIUM ERP UI
       ========================================================= */

    :root {
        --acc-primary: #2563eb;
        --acc-primary-dark: #1d4ed8;
        --acc-primary-soft: #eff6ff;
        --acc-dark: #0f172a;
        --acc-slate: #475569;
        --acc-muted: #64748b;
        --acc-border: #e2e8f0;
        --acc-bg: #f8fafc;
        --acc-white: #ffffff;
        --acc-success: #059669;
        --acc-danger: #dc2626;
        --acc-warning: #d97706;
        --acc-purple: #7c3aed;
        --acc-shadow: 0 12px 35px rgba(15, 23, 42, 0.07);
        --acc-shadow-hover: 0 18px 42px rgba(15, 23, 42, 0.11);
    }

    /* Page wrapper */

    .acc-page {
        width: 100%;
        max-width: 100%;
        animation: accPageIn .55s ease both;
    }

    @@keyframes accPageIn {
        from {
            opacity: 0;
            transform: translateY(12px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* =========================================================
       HEADER
       ========================================================= */

    .acc-page-header {
        position: relative;
        overflow: hidden;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 1.5rem;
        padding: 1.45rem 1.55rem;
        margin-bottom: 1.25rem;
        border: 1px solid rgba(226, 232, 240, .85);
        border-radius: 20px;
        background:
            radial-gradient(circle at 92% 10%, rgba(37, 99, 235, .09), transparent 28%),
            radial-gradient(circle at 72% 100%, rgba(99, 102, 241, .06), transparent 25%),
            rgba(255,255,255,.96);
        box-shadow: var(--acc-shadow);
    }

    .acc-page-header::before {
        content: "";
        position: absolute;
        width: 170px;
        height: 170px;
        border-radius: 50%;
        border: 1px solid rgba(37, 99, 235, .08);
        right: -65px;
        top: -90px;
        animation: accFloat 6s ease-in-out infinite;
    }

    .acc-page-header::after {
        content: "";
        position: absolute;
        width: 90px;
        height: 90px;
        border-radius: 50%;
        background: rgba(37, 99, 235, .035);
        right: 110px;
        bottom: -55px;
        animation: accFloat 7s ease-in-out infinite reverse;
    }

    @@keyframes accFloat {
        0%, 100% {
            transform: translateY(0);
        }

        50% {
            transform: translateY(8px);
        }
    }

    .acc-header-content,
    .acc-header-actions {
        position: relative;
        z-index: 2;
    }

    .acc-breadcrumb {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: .45rem;
        margin-bottom: .55rem;
    }

    .acc-back-link {
        display: inline-flex;
        align-items: center;
        gap: .35rem;
        color: #64748b;
        font-size: .78rem;
        font-weight: 600;
        text-decoration: none;
        transition: .2s ease;
    }

    .acc-back-link:hover {
        color: var(--acc-primary);
        transform: translateX(-2px);
    }

    .acc-breadcrumb-divider {
        color: #cbd5e1;
        font-size: .8rem;
    }

    .acc-module-badge {
        display: inline-flex;
        align-items: center;
        gap: .35rem;
        padding: .3rem .65rem;
        border-radius: 999px;
        background: var(--acc-primary-soft);
        border: 1px solid #dbeafe;
        color: var(--acc-primary);
        font-size: .7rem;
        font-weight: 700;
        letter-spacing: .02em;
    }

    .acc-page-title {
        display: flex;
        align-items: center;
        gap: .65rem;
        margin: 0;
        color: var(--acc-dark);
        font-size: clamp(1.25rem, 2vw, 1.65rem);
        font-weight: 800;
        letter-spacing: -.025em;
    }

    .acc-title-icon {
        width: 38px;
        height: 38px;
        flex: 0 0 38px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 11px;
        background: linear-gradient(135deg, #2563eb, #4f46e5);
        color: #fff;
        box-shadow: 0 8px 18px rgba(37, 99, 235, .2);
        animation: accIconPulse 3.5s ease-in-out infinite;
    }

    @@keyframes accIconPulse {
        0%, 100% {
            box-shadow: 0 8px 18px rgba(37, 99, 235, .2);
        }

        50% {
            box-shadow: 0 10px 24px rgba(37, 99, 235, .3);
        }
    }

    .acc-page-subtitle {
        margin: .45rem 0 0 2.75rem;
        color: var(--acc-muted);
        font-size: .8rem;
        line-height: 1.55;
    }

    .acc-header-actions {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        flex-wrap: wrap;
        gap: .55rem;
    }

    .acc-action-btn {
        min-height: 40px;
        border-radius: 10px !important;
        font-size: .78rem !important;
        font-weight: 700 !important;
        transition: transform .2s ease, box-shadow .2s ease, border-color .2s ease;
    }

    .acc-action-btn:hover {
        transform: translateY(-2px);
    }

    .acc-primary-btn {
        box-shadow: 0 7px 18px rgba(37, 99, 235, .18) !important;
    }

    .acc-primary-btn:hover {
        box-shadow: 0 10px 22px rgba(37, 99, 235, .26) !important;
    }

    /* =========================================================
       FILTER TOOLBAR
       ========================================================= */

    .acc-filter-card {
        position: relative;
        overflow: hidden;
        padding: 1rem;
        margin-bottom: 1.25rem;
        border: 1px solid var(--acc-border);
        border-radius: 17px;
        background: rgba(255,255,255,.97);
        box-shadow: 0 8px 25px rgba(15,23,42,.045);
        animation: accSlideUp .55s ease .08s both;
    }

    .acc-filter-card::before {
        content: "";
        position: absolute;
        left: 0;
        top: 0;
        width: 4px;
        height: 100%;
        background: linear-gradient(180deg, #2563eb, #6366f1);
    }

    @@keyframes accSlideUp {
        from {
            opacity: 0;
            transform: translateY(14px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .acc-filter-label {
        display: block;
        margin-bottom: .42rem;
        color: #64748b;
        font-size: .68rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: .055em;
    }

    .acc-filter-card .form-control,
    .acc-filter-card .form-select {
        min-height: 43px;
        border-color: #e2e8f0;
        border-radius: 10px;
        color: #1e293b;
        font-size: .8rem;
        font-weight: 600;
        box-shadow: none;
        transition: .2s ease;
    }

    .acc-filter-card .form-control:focus,
    .acc-filter-card .form-select:focus {
        border-color: #93c5fd;
        box-shadow: 0 0 0 3px rgba(37,99,235,.08);
    }

    .acc-search-group {
        overflow: hidden;
        border: 1px solid #e2e8f0;
        border-radius: 10px;
        background: #fff;
        transition: .2s ease;
    }

    .acc-search-group:focus-within {
        border-color: #93c5fd;
        box-shadow: 0 0 0 3px rgba(37,99,235,.08);
    }

    .acc-search-group .input-group-text {
        border: 0 !important;
        background: #f8fafc !important;
        color: #64748b;
    }

    .acc-search-group .form-control {
        border: 0 !important;
        box-shadow: none !important;
    }

    .acc-filter-button {
        min-height: 43px;
        border-radius: 10px;
        font-size: .78rem;
        font-weight: 700;
        box-shadow: 0 5px 14px rgba(15,23,42,.12);
        transition: .2s ease;
    }

    .acc-filter-button:hover {
        transform: translateY(-1px);
    }

    .acc-reset-button {
        width: 43px;
        min-width: 43px;
        min-height: 43px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 10px;
        transition: .2s ease;
    }

    .acc-reset-button:hover {
        transform: rotate(-12deg);
    }

    /* =========================================================
       TABLE CONTAINER
       ========================================================= */

    .acc-voucher-card {
        position: relative;
        overflow: hidden;
        width: 100%;
        border: 1px solid rgba(226,232,240,.9);
        border-radius: 19px;
        background: #fff;
        box-shadow: var(--acc-shadow);
        animation: accSlideUp .55s ease .14s both;
    }

    .acc-voucher-card::before {
        content: "";
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 3px;
        background: linear-gradient(90deg, #2563eb, #6366f1, #8b5cf6);
        z-index: 3;
    }

    .acc-table-head {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 1rem;
        padding: 1rem 1.15rem;
        border-bottom: 1px solid #eef2f7;
        background: linear-gradient(180deg, #fff, #fbfdff);
    }

    .acc-table-heading {
        display: flex;
        align-items: center;
        gap: .65rem;
    }

    .acc-table-heading-icon {
        width: 34px;
        height: 34px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 9px;
        background: #eff6ff;
        color: #2563eb;
    }

    .acc-table-title {
        margin: 0;
        color: #0f172a;
        font-size: .88rem;
        font-weight: 800;
    }

    .acc-table-caption {
        margin: .15rem 0 0;
        color: #94a3b8;
        font-size: .68rem;
    }

    .acc-record-count {
        display: inline-flex;
        align-items: center;
        gap: .35rem;
        padding: .38rem .7rem;
        border: 1px solid #e2e8f0;
        border-radius: 999px;
        background: #f8fafc;
        color: #475569;
        font-size: .7rem;
        font-weight: 700;
        white-space: nowrap;
    }

    .acc-table-scroll {
        width: 100%;
        overflow-x: auto;
        overflow-y: hidden;
        scrollbar-width: thin;
        scrollbar-color: #cbd5e1 transparent;
    }

    .acc-table-scroll::-webkit-scrollbar {
        height: 7px;
    }

    .acc-table-scroll::-webkit-scrollbar-track {
        background: transparent;
    }

    .acc-table-scroll::-webkit-scrollbar-thumb {
        background: #cbd5e1;
        border-radius: 20px;
    }

    .acc-voucher-table {
        min-width: 1180px;
        margin: 0;
        border-collapse: separate;
        border-spacing: 0;
    }

    .acc-voucher-table thead th {
        padding: .82rem .8rem;
        border-bottom: 1px solid #e2e8f0;
        background: #f8fafc;
        color: #64748b;
        font-size: .64rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: .045em;
        white-space: nowrap;
    }

    .acc-voucher-table thead th:first-child {
        padding-left: 1.1rem;
    }

    .acc-voucher-table tbody tr {
        position: relative;
        transition: background .2s ease, transform .2s ease;
    }

    .acc-voucher-table tbody tr:hover {
        background: #f8fbff;
    }

    .acc-voucher-table tbody td {
        padding: .9rem .8rem;
        border-bottom: 1px solid #eef2f7;
        vertical-align: middle;
        font-size: .76rem;
    }

    .acc-voucher-table tbody tr:last-child td {
        border-bottom: 0;
    }

    .acc-voucher-table tbody tr:hover td:first-child {
        box-shadow: inset 3px 0 0 #2563eb;
    }

    /* Voucher details */

    .acc-voucher-number {
        display: inline-flex;
        align-items: center;
        gap: .4rem;
        color: #2563eb;
        font-size: .79rem;
        font-weight: 800;
        text-decoration: none;
        transition: .2s ease;
    }

    .acc-voucher-number:hover {
        color: #1d4ed8;
        transform: translateX(2px);
    }

    .acc-voucher-number i {
        font-size: .72rem;
    }

    .acc-voucher-date {
        margin-top: .25rem;
        color: #94a3b8;
        font-size: .66rem;
        font-weight: 600;
    }

    /* Type badges */

    .badge-voucher-payment,
    .badge-voucher-receipt,
    .badge-voucher-journal,
    .badge-voucher-contra {
        display: inline-flex;
        align-items: center;
        gap: .3rem;
        padding: .34rem .62rem;
        border-radius: 7px;
        font-size: .65rem;
        font-weight: 800;
        white-space: nowrap;
    }

    .badge-voucher-payment {
        background: rgba(239,68,68,.09);
        color: #dc2626;
        border: 1px solid rgba(239,68,68,.18);
    }

    .badge-voucher-receipt {
        background: rgba(16,185,129,.09);
        color: #059669;
        border: 1px solid rgba(16,185,129,.18);
    }

    .badge-voucher-journal {
        background: rgba(59,130,246,.09);
        color: #2563eb;
        border: 1px solid rgba(59,130,246,.18);
    }

    .badge-voucher-contra {
        background: rgba(168,85,247,.09);
        color: #9333ea;
        border: 1px solid rgba(168,85,247,.18);
    }

    /* Accounts */

    .acc-account-cell {
        min-width: 165px;
        max-width: 205px;
    }

    .acc-account-label {
        display: inline-flex;
        align-items: center;
        gap: .28rem;
        margin-right: .15rem;
        font-size: .66rem;
        font-weight: 800;
    }

    .acc-dr-label {
        color: #059669;
    }

    .acc-cr-label {
        color: #dc2626;
    }

    .acc-clickable-link {
        display: inline;
        color: #334155;
        text-decoration: none;
        border-bottom: 1px dashed rgba(59,130,246,.35);
        transition: .15s ease;
    }

    .acc-clickable-link:hover {
        color: #2563eb !important;
        border-bottom-color: #2563eb;
    }

    /* Narration */

    .acc-narration {
        min-width: 190px;
        max-width: 245px;
        color: #64748b;
        font-size: .71rem;
        line-height: 1.45;
    }

    /* Amount */

    .acc-amount {
        min-width: 125px;
        color: #0f172a;
        font-size: .84rem;
        font-weight: 800;
        white-space: nowrap;
    }

    .acc-amount-symbol {
        color: #64748b;
        font-size: .7rem;
        margin-right: .15rem;
    }

    /* Status */

    .badge-status-draft,
    .badge-status-posted {
        display: inline-flex;
        align-items: center;
        gap: .3rem;
        padding: .3rem .62rem;
        border-radius: 999px;
        font-size: .64rem;
        font-weight: 800;
        white-space: nowrap;
    }

    .badge-status-draft {
        background: #fffbeb;
        color: #b45309;
        border: 1px solid #fde68a;
    }

    .badge-status-posted {
        background: #ecfdf5;
        color: #047857;
        border: 1px solid #a7f3d0;
    }

    /* Action buttons */

    .acc-row-actions {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: .35rem;
        white-space: nowrap;
    }

    .acc-view-btn,
    .acc-post-btn {
        height: 31px;
        border-radius: 8px !important;
        font-size: .68rem !important;
        font-weight: 700 !important;
        transition: .2s ease;
    }

    .acc-view-btn {
        width: 31px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }

    .acc-view-btn:hover {
        transform: translateY(-2px);
        box-shadow: 0 5px 12px rgba(15,23,42,.1);
    }

    .acc-post-btn:hover {
        transform: translateY(-2px);
        box-shadow: 0 5px 12px rgba(16,185,129,.14);
    }

    .acc-posted-icon {
        width: 31px;
        height: 31px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 8px;
        background: #f0fdf4;
        border: 1px solid #dcfce7;
    }

    /* Footer */

    .acc-table-footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        padding: .85rem 1.1rem;
        border-top: 1px solid #eef2f7;
        background: #fbfdff;
        color: #94a3b8;
        font-size: .68rem;
    }

    .acc-table-footer strong {
        color: #475569;
    }

    .acc-footer-note {
        display: inline-flex;
        align-items: center;
        gap: .35rem;
    }

    .acc-footer-note i {
        color: #2563eb;
    }

    /* Empty state */

    .acc-empty-state {
        padding: 4rem 1.5rem !important;
    }

    .acc-empty-icon {
        width: 68px;
        height: 68px;
        margin: 0 auto 1rem;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 18px;
        background: #f1f5f9;
        color: #94a3b8;
        font-size: 1.7rem;
    }

    .acc-empty-state h6 {
        color: #334155;
        font-weight: 800;
    }

    .acc-empty-state p {
        color: #94a3b8;
    }

    /* =========================================================
       MODALS
       ========================================================= */

    .acc-modal-content {
        overflow: hidden;
        border: 1px solid rgba(226,232,240,.9) !important;
        border-radius: 19px !important;
        box-shadow: 0 25px 70px rgba(15,23,42,.18) !important;
        animation: accModalIn .25s ease both;
    }

    @@keyframes accModalIn {
        from {
            opacity: 0;
            transform: scale(.97) translateY(8px);
        }

        to {
            opacity: 1;
            transform: scale(1) translateY(0);
        }
    }

    .acc-modal-header {
        position: relative;
        overflow: hidden;
        padding: 1.05rem 1.25rem;
        border: 0 !important;
    }

    .acc-modal-header::after {
        content: "";
        position: absolute;
        width: 130px;
        height: 130px;
        border: 1px solid rgba(255,255,255,.12);
        border-radius: 50%;
        right: -45px;
        top: -75px;
    }

    .acc-modal-title-wrap {
        position: relative;
        z-index: 2;
        display: flex;
        align-items: center;
        gap: .65rem;
    }

    .acc-modal-title-icon {
        width: 35px;
        height: 35px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 9px;
        background: rgba(255,255,255,.12);
    }

    .acc-modal-title {
        margin: 0;
        font-size: .96rem;
        font-weight: 800;
    }

    .acc-modal-body {
        padding: 1.35rem !important;
    }

    .acc-form-label {
        display: block;
        margin-bottom: .4rem;
        color: #475569;
        font-size: .69rem;
        font-weight: 800;
    }

    .acc-form-control,
    .acc-form-select {
        min-height: 43px;
        border: 1px solid #e2e8f0;
        border-radius: 10px;
        color: #1e293b;
        font-size: .78rem;
        font-weight: 600;
        box-shadow: none;
        transition: .2s ease;
    }

    .acc-form-control:focus,
    .acc-form-select:focus {
        border-color: #93c5fd;
        box-shadow: 0 0 0 3px rgba(37,99,235,.08);
    }

    .acc-form-control::placeholder {
        color: #a8b3c2;
        font-weight: 500;
    }

    .acc-input-group .input-group-text {
        border-color: #e2e8f0;
        border-radius: 10px 0 0 10px;
        background: #f8fafc;
        color: #475569;
        font-size: .8rem;
    }

    .acc-input-group .form-control {
        border-radius: 0 10px 10px 0;
    }

    .acc-modal-footer {
        padding: .9rem 1.35rem !important;
        border-top: 1px solid #eef2f7 !important;
        background: #f8fafc !important;
    }

    .acc-modal-footer .btn {
        min-height: 39px;
        border-radius: 9px;
        font-size: .76rem;
        font-weight: 700;
    }

    /* Voucher details */

    .acc-slip-top {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 1rem;
        padding-bottom: 1rem;
        margin-bottom: 1rem;
        border-bottom: 1px dashed #e2e8f0;
    }

    .acc-slip-label {
        display: block;
        margin-bottom: .25rem;
        color: #94a3b8;
        font-size: .63rem;
        font-weight: 800;
        letter-spacing: .06em;
    }

    .acc-slip-number {
        margin: 0;
        color: #0f172a;
        font-size: 1rem;
        font-weight: 800;
    }

    .acc-slip-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 1rem;
        margin-bottom: 1rem;
    }

    .acc-slip-field {
        padding: .75rem;
        border: 1px solid #eef2f7;
        border-radius: 11px;
        background: #fbfdff;
    }

    .acc-slip-field-label {
        display: block;
        margin-bottom: .25rem;
        color: #94a3b8;
        font-size: .64rem;
        font-weight: 700;
    }

    .acc-slip-field-value {
        color: #334155;
        font-size: .78rem;
        font-weight: 800;
    }

    .acc-entry-box {
        padding: .95rem;
        margin-bottom: 1rem;
        border: 1px solid #e2e8f0;
        border-radius: 13px;
        background: #f8fafc;
    }

    .acc-entry-line {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 1rem;
        padding: .55rem 0;
    }

    .acc-entry-line + .acc-entry-line {
        border-top: 1px dashed #e2e8f0;
    }

    .acc-entry-label {
        font-size: .72rem;
        font-weight: 800;
    }

    .acc-entry-value {
        max-width: 60%;
        text-align: right;
        color: #334155;
        font-size: .74rem;
        font-weight: 700;
        word-break: break-word;
    }

    .acc-total-line {
        margin-top: .25rem;
        padding-top: .75rem;
        border-top: 1px solid #cbd5e1 !important;
    }

    .acc-total-line .acc-entry-value {
        color: #2563eb;
        font-size: 1rem;
    }

    .acc-narration-box {
        padding: .8rem;
        border-radius: 10px;
        background: #f8fafc;
        color: #475569;
        font-size: .74rem;
        line-height: 1.55;
    }

    .acc-created-row {
        display: flex;
        justify-content: space-between;
        gap: 1rem;
        padding-top: .9rem;
        margin-top: .9rem;
        border-top: 1px dashed #e2e8f0;
        color: #94a3b8;
        font-size: .68rem;
    }

    .acc-created-row strong {
        color: #475569;
    }

    /* =========================================================
       RESPONSIVE
       ========================================================= */

    @@media (max-width: 1200px) {
        .acc-page-header {
            align-items: flex-start;
            flex-direction: column;
        }

        .acc-header-actions {
            width: 100%;
            justify-content: flex-start;
        }
    }

    @@media (max-width: 992px) {
        .acc-page-header {
            padding: 1.2rem;
        }

        .acc-header-actions .acc-action-btn {
            flex: 1 1 auto;
        }

        .acc-page-subtitle {
            margin-left: 0;
        }

        .acc-title-icon {
            width: 35px;
            height: 35px;
            flex-basis: 35px;
        }
    }

    @@media (max-width: 768px) {
        .acc-page-header {
            border-radius: 15px;
            padding: 1rem;
            margin-bottom: 1rem;
        }

        .acc-page-title {
            font-size: 1.2rem;
        }

        .acc-page-subtitle {
            font-size: .74rem;
        }

        .acc-header-actions {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            width: 100%;
        }

        .acc-header-actions .acc-action-btn {
            width: 100%;
            justify-content: center;
        }

        .acc-filter-card {
            padding: .85rem;
            border-radius: 14px;
        }

        .acc-table-head {
            align-items: flex-start;
            flex-direction: column;
            padding: .9rem;
        }

        .acc-record-count {
            align-self: flex-start;
        }

        .acc-table-footer {
            align-items: flex-start;
            flex-direction: column;
        }

        .acc-slip-grid {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 576px) {
        .acc-breadcrumb {
            gap: .3rem;
        }

        .acc-module-badge {
            font-size: .62rem;
        }

        .acc-page-title {
            gap: .5rem;
        }

        .acc-title-icon {
            width: 32px;
            height: 32px;
            flex-basis: 32px;
            border-radius: 8px;
        }

        .acc-header-actions {
            grid-template-columns: 1fr;
        }

        .acc-filter-card .row {
            --bs-gutter-y: .65rem;
        }

        .acc-filter-card .col-md-2 {
            display: flex;
        }

        .acc-filter-button {
            flex: 1;
        }

        .acc-voucher-card {
            border-radius: 14px;
        }

        .acc-modal-body {
            padding: 1rem !important;
        }

        .acc-created-row {
            flex-direction: column;
            gap: .4rem;
        }

        .acc-entry-line {
            align-items: flex-start;
            flex-direction: column;
            gap: .25rem;
        }

        .acc-entry-value {
            max-width: 100%;
            text-align: left;
        }

        .acc-slip-top {
            align-items: flex-start;
            flex-direction: column;
        }
    }

    /* =========================================================
       REDUCED MOTION
       ========================================================= */

    @@media (prefers-reduced-motion: reduce) {
        .acc-page,
        .acc-filter-card,
        .acc-voucher-card,
        .acc-title-icon,
        .acc-page-header::before,
        .acc-page-header::after,
        .acc-modal-content {
            animation: none !important;
        }

        *,
        *::before,
        *::after {
            scroll-behavior: auto !important;
            transition-duration: .01ms !important;
        }
    }
</style>

@Html.AntiForgeryToken()

<div class="acc-page">

    <!-- =====================================================
         PAGE HEADER
         ===================================================== -->
    <div class="acc-page-header">

        <div class="acc-header-content">

            <div class="acc-breadcrumb">
                <a href="@Url.Action("Index", "Accountant")" class="acc-back-link">
                    <i class="fa fa-arrow-left"></i>
                    Back to Hub
                </a>

                <span class="acc-breadcrumb-divider">/</span>

                <span class="acc-module-badge">
                    <i class="fa fa-book"></i>
                    General Ledger Vouchers
                </span>
            </div>

            <h3 class="acc-page-title">
                <span class="acc-title-icon">
                    <i class="fa fa-receipt"></i>
                </span>
                Journal &amp; Vouchers Register
            </h3>

            <p class="acc-page-subtitle">
                Complete double-entry audit register with drill-down subledger links
            </p>

        </div>

        <div class="acc-header-actions">

            <button type="button"
                    class="btn btn-primary acc-action-btn acc-primary-btn px-3 py-2 d-flex align-items-center gap-2"
                    data-bs-toggle="modal"
                    data-bs-target="#newVoucherModal">
                <i class="fa fa-plus-circle"></i>
                <span>New Voucher Entry</span>
            </button>

            <a href="@Url.Action("Ledger", "Finance")"
               class="btn btn-outline-secondary acc-action-btn px-3 py-2 d-flex align-items-center gap-2">
                <i class="fa fa-book"></i>
                <span>General Ledger</span>
            </a>

            <a href="@Url.Action("Index", "AccountHeads")"
               class="btn btn-outline-secondary acc-action-btn px-3 py-2 d-flex align-items-center gap-2">
                <i class="fa fa-list-ol"></i>
                <span>Account Heads</span>
            </a>

        </div>

    </div>


    <!-- =====================================================
         FILTERS & SEARCH
         ===================================================== -->
    <div class="acc-filter-card">

        <form method="get"
              action="@Url.Action("Vouchers", "Accountant")"
              class="row g-3 align-items-end">

            <div class="col-lg-4 col-md-6">

                <label class="acc-filter-label">
                    Search Register
                </label>

                <div class="input-group acc-search-group">

                    <span class="input-group-text">
                        <i class="fa fa-search"></i>
                    </span>

                    <input type="text"
                           name="search"
                           class="form-control"
                           placeholder="Search Voucher #, Account, or Narration..."
                           value="@searchTerm" />

                </div>

            </div>

            <div class="col-lg-3 col-md-6">

                <label class="acc-filter-label">
                    Voucher Type
                </label>

                <select name="filterType"
                        class="form-select"
                        onchange="this.form.submit()">

                    <option value="All" selected="@(currentType == "All")">
                        All Voucher Types
                    </option>

                    <option value="Payment" selected="@(currentType == "Payment")">
                        Payment Vouchers
                    </option>

                    <option value="Receipt" selected="@(currentType == "Receipt")">
                        Receipt Vouchers
                    </option>

                    <option value="Journal" selected="@(currentType == "Journal")">
                        Journal Adjustments
                    </option>

                    <option value="Contra" selected="@(currentType == "Contra")">
                        Contra (Inter-Bank)
                    </option>

                </select>

            </div>

            <div class="col-lg-3 col-md-6">

                <label class="acc-filter-label">
                    Posting Status
                </label>

                <select name="filterStatus"
                        class="form-select"
                        onchange="this.form.submit()">

                    <option value="All" selected="@(currentStatus == "All")">
                        All Statuses
                    </option>

                    <option value="Draft" selected="@(currentStatus == "Draft")">
                        Draft (Pending Post)
                    </option>

                    <option value="Submitted" selected="@(currentStatus == "Submitted")">
                        Submitted
                    </option>

                    <option value="Posted" selected="@(currentStatus == "Posted")">
                        Posted to Ledger
                    </option>

                </select>

            </div>

            <div class="col-lg-2 col-md-6 d-flex gap-2">

                <button type="submit"
                        class="btn btn-dark acc-filter-button w-100">
                    <i class="fa fa-filter me-1"></i>
                    Filter
                </button>

                <a href="@Url.Action("Vouchers", "Accountant")"
                   class="btn btn-outline-secondary acc-reset-button"
                   title="Reset Filters">
                    <i class="fa fa-rotate-left"></i>
                </a>

            </div>

        </form>

    </div>


    <!-- =====================================================
         VOUCHERS REGISTER
         ===================================================== -->
    <div class="acc-voucher-card">

        <div class="acc-table-head">

            <div class="acc-table-heading">

                <span class="acc-table-heading-icon">
                    <i class="fa fa-file-invoice-dollar"></i>
                </span>

                <div>
                    <h6 class="acc-table-title">
                        Voucher Register
                    </h6>

                    <p class="acc-table-caption">
                        Double-entry financial transaction records
                    </p>
                </div>

            </div>

            <span class="acc-record-count">
                <i class="fa fa-layer-group"></i>
                @(Model?.Count ?? 0) Records
            </span>

        </div>


        <div class="acc-table-scroll">

            <table class="table acc-voucher-table align-middle mb-0">

                <thead>

                    <tr>

                        <th>
                            Voucher Details
                        </th>

                        <th>
                            Type
                        </th>

                        <th>
                            Debit Account (Dr)
                        </th>

                        <th>
                            Credit Account (Cr)
                        </th>

                        <th>
                            Narration
                        </th>

                        <th class="text-end">
                            Amount
                        </th>

                        <th>
                            Status
                        </th>

                        <th class="text-center">
                            Actions
                        </th>

                    </tr>

                </thead>

                <tbody>

                    @if (Model != null && Model.Any())
                    {
                        foreach (var v in Model)
                        {
                            var typeClass = v.VoucherType switch
                            {
                                "Payment" => "badge-voucher-payment",
                                "Receipt" => "badge-voucher-receipt",
                                "Contra" => "badge-voucher-contra",
                                _ => "badge-voucher-journal"
                            };

                            var statusClass = v.Status switch
                            {
                                "Posted" => "badge-status-posted",
                                _ => "badge-status-draft"
                            };

                            string drLink = v.DebitAccount.StartsWith("Vendor:") ? Url.Action("Payables", "Finance") :
                                            v.DebitAccount.StartsWith("Customer:") ? Url.Action("Receivables", "Finance") :
                                            (v.DebitAccount.Contains("Bank") || v.DebitAccount.Contains("A/c") || v.DebitAccount.Contains("Cash")) ? Url.Action("BankRecon", "Finance") :
                                            Url.Action("Ledger", "Finance");

                            string crLink = v.CreditAccount.StartsWith("Vendor:") ? Url.Action("Payables", "Finance") :
                                            v.CreditAccount.StartsWith("Customer:") ? Url.Action("Receivables", "Finance") :
                                            (v.CreditAccount.Contains("Bank") || v.CreditAccount.Contains("A/c") || v.CreditAccount.Contains("Cash")) ? Url.Action("BankRecon", "Finance") :
                                            Url.Action("Ledger", "Finance");

                            <tr id="voucher-row-@v.Id">

                                <!-- Voucher -->
                                <td>

                                    <a href="javascript:void(0)"
                                       class="view-voucher-btn acc-voucher-number"
                                       data-id="@v.Id"
                                       title="Click to view slip">

                                        <i class="fa fa-receipt"></i>

                                        @v.VoucherNumber

                                    </a>

                                    <div class="acc-voucher-date">
                                        <i class="fa fa-calendar-day me-1"></i>
                                        @v.VoucherDate.ToString("dd MMM yyyy")
                                    </div>

                                </td>


                                <!-- Type -->
                                <td>

                                    <span class="@typeClass">

                                        @if (v.VoucherType == "Payment")
                                        {
                                            <i class="fa fa-arrow-up"></i>
                                        }
                                        else if (v.VoucherType == "Receipt")
                                        {
                                            <i class="fa fa-arrow-down"></i>
                                        }
                                        else if (v.VoucherType == "Contra")
                                        {
                                            <i class="fa fa-right-left"></i>
                                        }
                                        else
                                        {
                                            <i class="fa fa-arrows-rotate"></i>
                                        }

                                        @v.VoucherType

                                    </span>

                                </td>


                                <!-- Debit Account -->
                                <td class="acc-account-cell">

                                    <div class="text-truncate"
                                         title="Dr Account: @v.DebitAccount">

                                        <span class="acc-account-label acc-dr-label">
                                            Dr:
                                        </span>

                                        <a href="@drLink"
                                           class="acc-clickable-link">
                                            @v.DebitAccount
                                        </a>

                                    </div>

                                </td>


                                <!-- Credit Account -->
                                <td class="acc-account-cell">

                                    <div class="text-truncate"
                                         title="Cr Account: @v.CreditAccount">

                                        <span class="acc-account-label acc-cr-label">
                                            Cr:
                                        </span>

                                        <a href="@crLink"
                                           class="acc-clickable-link">
                                            @v.CreditAccount
                                        </a>

                                    </div>

                                </td>


                                <!-- Narration -->
                                <td class="acc-narration">

                                    <div class="text-truncate"
                                         title="@v.Narration">

                                        @(string.IsNullOrEmpty(v.Narration)
                                            ? "—"
                                            : v.Narration)

                                    </div>

                                </td>


                                <!-- Amount -->
                                <td class="text-end acc-amount">

                                    <span class="acc-amount-symbol">
                                        ₹
                                    </span>

                                    @v.Amount.ToString("N2", inCulture)

                                </td>


                                <!-- Status -->
                                <td>

                                    <span class="@statusClass"
                                          id="status-badge-@v.Id">

                                        @if (v.Status == "Posted")
                                        {
                                            <i class="fa fa-circle-check"></i>
                                        }
                                        else
                                        {
                                            <i class="fa fa-clock"></i>
                                        }

                                        @v.Status

                                    </span>

                                </td>


                                <!-- Actions -->
                                <td>

                                    <div class="acc-row-actions">

                                        <button type="button"
                                                class="btn btn-sm btn-outline-secondary acc-view-btn view-voucher-btn"
                                                data-id="@v.Id"
                                                title="View Voucher Slip">

                                            <i class="fa fa-eye"></i>

                                        </button>

                                        @if (v.Status == "Draft")
                                        {
                                            <button type="button"
                                                    class="btn btn-sm btn-outline-success acc-post-btn post-voucher-btn"
                                                    data-id="@v.Id"
                                                    title="Post to General Ledger">

                                                <i class="fa fa-check me-1"></i>
                                                Post

                                            </button>
                                        }
                                        else
                                        {
                                            <span class="acc-posted-icon text-success"
                                                  title="Posted to Ledger">

                                                <i class="fa fa-check-double"></i>

                                            </span>
                                        }

                                    </div>

                                </td>

                            </tr>
                        }
                    }
                    else
                    {
                        <tr>

                            <td colspan="8"
                                class="text-center acc-empty-state">

                                <div class="acc-empty-icon">
                                    <i class="fa fa-file-invoice"></i>
                                </div>

                                <h6>
                                    No Vouchers Matching Filter Criteria
                                </h6>

                                <p class="small mb-0">
                                    Try clearing your filters or create a new voucher entry.
                                </p>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>


        <!-- Footer -->
        <div class="acc-table-footer">

            <span>
                <i class="fa fa-database me-1"></i>
                Total Records:
                <strong>@(Model?.Count ?? 0)</strong>
            </span>

            <span class="acc-footer-note">
                <i class="fa fa-link"></i>
                Click any Account Name to open its corresponding subledger
            </span>

        </div>

    </div>

</div>


<!-- =========================================================
     MODAL: NEW VOUCHER ENTRY
     ========================================================= -->
<div class="modal fade"
     id="newVoucherModal"
     tabindex="-1"
     aria-labelledby="newVoucherModalLabel"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered modal-lg">

        <div class="modal-content acc-modal-content">

            <div class="modal-header bg-primary text-white acc-modal-header">

                <div class="acc-modal-title-wrap">

                    <span class="acc-modal-title-icon">
                        <i class="fa fa-receipt"></i>
                    </span>

                    <h5 class="modal-title acc-modal-title"
                        id="newVoucherModalLabel">

                        New Double-Entry Voucher

                    </h5>

                </div>

                <button type="button"
                        class="btn-close btn-close-white"
                        data-bs-dismiss="modal"
                        aria-label="Close">
                </button>

            </div>


            <form id="createVoucherForm">

                <div class="modal-body acc-modal-body">

                    <div class="row g-3">

                        <!-- Voucher Type -->
                        <div class="col-md-6">

                            <label class="acc-form-label">
                                Voucher Type
                                <span class="text-danger">*</span>
                            </label>

                            <select class="form-select acc-form-select"
                                    id="voucherType"
                                    name="VoucherType"
                                    required>

                                <option value="Payment">
                                    Payment (Cash/Bank Outflow)
                                </option>

                                <option value="Receipt">
                                    Receipt (Inbound Collection)
                                </option>

                                <option value="Journal">
                                    Journal (Adjustment / Non-Cash)
                                </option>

                                <option value="Contra">
                                    Contra (Bank-to-Cash / Inter-Bank)
                                </option>

                            </select>

                        </div>


                        <!-- Amount -->
                        <div class="col-md-6">

                            <label class="acc-form-label">
                                Amount (₹)
                                <span class="text-danger">*</span>
                            </label>

                            <div class="input-group acc-input-group">

                                <span class="input-group-text fw-bold">
                                    ₹
                                </span>

                                <input type="number"
                                       step="0.01"
                                       min="0.01"
                                       class="form-control acc-form-control"
                                       id="voucherAmount"
                                       name="Amount"
                                       placeholder="0.00"
                                       required />

                            </div>

                        </div>


                        <!-- Debit Account -->
                        <div class="col-md-6">

                            <label class="acc-form-label">
                                Debit Account (Dr)
                                <span class="text-danger">*</span>
                            </label>

                            <input type="text"
                                   class="form-control acc-form-control"
                                   id="debitAccount"
                                   name="DebitAccount"
                                   placeholder="e.g. Vendor: TechInfra Ltd"
                                   required />

                        </div>


                        <!-- Credit Account -->
                        <div class="col-md-6">

                            <label class="acc-form-label">
                                Credit Account (Cr)
                                <span class="text-danger">*</span>
                            </label>

                            <input type="text"
                                   class="form-control acc-form-control"
                                   id="creditAccount"
                                   name="CreditAccount"
                                   placeholder="e.g. HDFC Bank A/c"
                                   required />

                        </div>


                        <!-- Narration -->
                        <div class="col-12">

                            <label class="acc-form-label">
                                Narration / Remarks
                            </label>

                            <textarea class="form-control acc-form-control"
                                      id="voucherNarration"
                                      name="Narration"
                                      rows="3"
                                      placeholder="State invoice reference number, purpose, or approval memo..."></textarea>

                        </div>

                    </div>

                </div>


                <div class="modal-footer acc-modal-footer">

                    <button type="button"
                            class="btn btn-outline-secondary"
                            data-bs-dismiss="modal">

                        Cancel

                    </button>

                    <button type="submit"
                            class="btn btn-primary px-4"
                            id="saveVoucherBtn">

                        <i class="fa fa-save me-1"></i>
                        Save Voucher as Draft

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>


<!-- =========================================================
     MODAL: VOUCHER DETAILS SLIP
     ========================================================= -->
<div class="modal fade"
     id="voucherDetailsModal"
     tabindex="-1"
     aria-labelledby="voucherDetailsModalLabel"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content acc-modal-content">

            <div class="modal-header bg-dark text-white acc-modal-header">

                <div class="acc-modal-title-wrap">

                    <span class="acc-modal-title-icon">
                        <i class="fa fa-receipt text-warning"></i>
                    </span>

                    <h5 class="modal-title acc-modal-title"
                        id="voucherDetailsModalLabel">

                        Voucher Details Slip

                    </h5>

                </div>

                <button type="button"
                        class="btn-close btn-close-white"
                        data-bs-dismiss="modal"
                        aria-label="Close">
                </button>

            </div>


            <div class="modal-body acc-modal-body">

                <!-- Top -->
                <div class="acc-slip-top">

                    <div>

                        <span class="acc-slip-label">
                            VOUCHER NUMBER
                        </span>

                        <h5 class="acc-slip-number"
                            id="vdNumber">
                            -
                        </h5>

                    </div>

                    <div>
                        <span class="badge"
                              id="vdStatus">
                            -
                        </span>
                    </div>

                </div>


                <!-- Meta -->
                <div class="acc-slip-grid">

                    <div class="acc-slip-field">

                        <span class="acc-slip-field-label">
                            Voucher Type
                        </span>

                        <div class="acc-slip-field-value"
                             id="vdType">
                            -
                        </div>

                    </div>

                    <div class="acc-slip-field">

                        <span class="acc-slip-field-label">
                            Voucher Date
                        </span>

                        <div class="acc-slip-field-value"
                             id="vdDate">
                            -
                        </div>

                    </div>

                </div>


                <!-- Entry Details -->
                <div class="acc-entry-box">

                    <div class="acc-entry-line">

                        <span class="acc-entry-label text-success">
                            <i class="fa fa-arrow-down-left me-1"></i>
                            Debit (Dr) Account
                        </span>

                        <span class="acc-entry-value"
                              id="vdDebit">
                            -
                        </span>

                    </div>


                    <div class="acc-entry-line">

                        <span class="acc-entry-label text-danger">
                            <i class="fa fa-arrow-up-right me-1"></i>
                            Credit (Cr) Account
                        </span>

                        <span class="acc-entry-value"
                              id="vdCredit">
                            -
                        </span>

                    </div>


                    <div class="acc-entry-line acc-total-line">

                        <span class="acc-entry-label text-dark">
                            Total Amount
                        </span>

                        <span class="acc-entry-value"
                              id="vdAmount">
                            ₹ 0.00
                        </span>

                    </div>

                </div>


                <!-- Narration -->
                <div class="mb-3">

                    <span class="acc-slip-label">
                        NARRATION / MEMO
                    </span>

                    <div class="acc-narration-box"
                         id="vdNarration">
                        -
                    </div>

                </div>


                <!-- Created -->
                <div class="acc-created-row">

                    <span>
                        Created:
                        <strong id="vdCreatedAt">-</strong>
                    </span>

                    <span>
                        By:
                        <strong id="vdCreatedBy">-</strong>
                    </span>

                </div>

            </div>


            <div class="modal-footer acc-modal-footer">

                <button type="button"
                        class="btn btn-outline-secondary"
                        data-bs-dismiss="modal">

                    Close

                </button>

                <button type="button"
                        class="btn btn-primary"
                        onclick="window.print();">

                    <i class="fa fa-print me-1"></i>
                    Print Slip

                </button>

            </div>

        </div>

    </div>

</div>


@section Scripts {

<script>

    $(document).ready(function () {

        const token = $('input[name="__RequestVerificationToken"]').val();


        /* =====================================================
           CREATE VOUCHER
           ===================================================== */

        $('#createVoucherForm').on('submit', function (e) {

            e.preventDefault();

            const postData = {

                __RequestVerificationToken: token,

                VoucherType: $('#voucherType').val(),

                DebitAccount: $('#debitAccount').val(),

                CreditAccount: $('#creditAccount').val(),

                Amount: parseFloat($('#voucherAmount').val()),

                Narration: $('#voucherNarration').val()

            };


            $('#saveVoucherBtn')
                .prop('disabled', true)
                .html(
                    '<i class="fa fa-spinner fa-spin me-1"></i> Saving...'
                );


            $.ajax({

                url: '@Url.Action("CreateVoucher", "Accountant")',

                type: 'POST',

                data: postData,

                success: function (res) {

                    if (res.success) {

                        toastr.success(res.message);

                        setTimeout(() => window.location.reload(), 800);

                    }
                    else {

                        $('#saveVoucherBtn')
                            .prop('disabled', false)
                            .html(
                                '<i class="fa fa-save me-1"></i> Save Voucher as Draft'
                            );

                        toastr.error(res.message);

                    }

                },

                error: function () {

                    $('#saveVoucherBtn')
                        .prop('disabled', false)
                        .html(
                            '<i class="fa fa-save me-1"></i> Save Voucher as Draft'
                        );

                    toastr.error('Error saving voucher.');

                }

            });

        });


        /* =====================================================
           VIEW VOUCHER DETAILS
           ===================================================== */

        $(document).on('click', '.view-voucher-btn', function () {

            const vId = $(this).data('id');


            $.ajax({

                url: '@Url.Action("GetVoucherDetails", "Accountant")?id=' + vId,

                type: 'GET',

                success: function (res) {

                    if (res.success) {

                        $('#vdNumber').text(res.voucherNumber);

                        $('#vdType').text(res.voucherType);

                        $('#vdDate').text(res.voucherDate);

                        $('#vdDebit').text(res.debitAccount);

                        $('#vdCredit').text(res.creditAccount);

                        $('#vdAmount').text(
                            '₹ ' +
                            parseFloat(res.amount).toLocaleString(
                                'en-IN',
                                {
                                    minimumFractionDigits: 2,
                                    maximumFractionDigits: 2
                                }
                            )
                        );

                        $('#vdNarration').text(
                            res.narration || 'No additional remarks'
                        );

                        $('#vdCreatedAt').text(res.createdAt);

                        $('#vdCreatedBy').text(res.createdBy);


                        let badgeClass =
                            res.status === 'Posted'
                                ? 'bg-success text-white'
                                : 'bg-warning text-dark';


                        $('#vdStatus')
                            .attr('class', 'badge ' + badgeClass)
                            .text(res.status);


                        $('#voucherDetailsModal').modal('show');

                    }
                    else {

                        toastr.error(
                            res.message ||
                            'Could not load voucher details.'
                        );

                    }

                }

            });

        });


        /* =====================================================
           POST VOUCHER
           ===================================================== */

        $(document).on('click', '.post-voucher-btn', function () {

            const voucherId = $(this).data('id');

            const $btn = $(this);


            Swal.fire({

                title: 'Post Voucher to Ledger?',

                text: 'This will lock the entry and reflect in general ledger accounts.',

                icon: 'question',

                showCancelButton: true,

                confirmButtonColor: '#10b981',

                cancelButtonColor: '#6b7280',

                confirmButtonText: 'Yes, Post Entry'

            }).then((result) => {

                if (result.isConfirmed) {

                    $.ajax({

                        url: '@Url.Action("PostVoucher", "Accountant")',

                        type: 'POST',

                        data: {

                            __RequestVerificationToken: token,

                            id: voucherId

                        },

                        success: function (res) {

                            if (res.success) {

                                toastr.success(res.message);


                                $(`#status-badge-${voucherId}`)
                                    .removeClass('badge-status-draft')
                                    .addClass('badge-status-posted')
                                    .html(
                                        '<i class="fa fa-circle-check"></i> Posted'
                                    );


                                $btn.replaceWith(
                                    '<span class="acc-posted-icon text-success" title="Posted to Ledger">' +
                                    '<i class="fa fa-check-double"></i>' +
                                    '</span>'
                                );

                            }
                            else {

                                toastr.error(
                                    res.message ||
                                    'Unable to post voucher.'
                                );

                            }

                        }

                    });

                }

            });

        });

    });

</script>

}
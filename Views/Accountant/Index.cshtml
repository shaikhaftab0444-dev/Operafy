                            </div>


                            <input type="range"
                                   class="form-range"
                                   id="modalTaskProgress"
                                   name="progress"
                                   min="0"
                                   max="100"
                                   step="5"
                                   value="50"
                                   oninput="$('#progressDisplay').text(this.value + '%');" />


                            <div class="d-flex justify-content-between small text-muted">

                                <span>
                                    0% (Not Started)
                                </span>

                                <span>
                                    50% (Halfway)
                                </span>

                                <span>
                                    100% (Finished)
                                </span>

                            </div>

                        </div>

                    </div>


                    <div class="modal-footer bg-light px-4 py-3">

                        <button type="button"
                                class="btn btn-outline-secondary"
                                data-bs-dismiss="modal">

                            <i class="fa fa-xmark me-1"></i>
                            Cancel

                        </button>

                        <button type="submit"
                                class="btn btn-info text-white px-4 fw-semibold shadow-sm"
                                id="submitTaskUpdateBtn">

                            <i class="fa fa-check me-1"></i>
                            Update Deliverable

                        </button>

                    </div>

                </form>

            </div>

        </div>

    </div>

</div>


@section Scripts {

    <script>
        $(document).ready(function () {

            const token =
                $('input[name="__RequestVerificationToken"]').val();


            $('.preset-chip').on('click', function () {

                $('#voucherType').val(
                    $(this).data('type')
                );

                $('#debitAccount').val(
                    $(this).data('dr')
                );

                $('#creditAccount').val(
                    $(this).data('cr')
                );

                $('#voucherNarration').val(
                    $(this).data('narration')
                );

            });


            $('#createVoucherForm').on('submit', function (e) {

                e.preventDefault();

                const amount =
                    parseFloat(
                        $('#voucherAmount').val()
                    );


                if (isNaN(amount) || amount <= 0) {

                    toastr.warning(
                        'Please enter a valid amount greater than zero.'
                    );

                    return;
                }


                const postData = {

                    __RequestVerificationToken:
                        token,

                    VoucherType:
                        $('#voucherType').val(),

                    DebitAccount:
                        $('#debitAccount').val(),

                    CreditAccount:
                        $('#creditAccount').val(),

                    Amount:
                        amount,

                    Narration:
                        $('#voucherNarration').val()

                };


                $('#saveVoucherBtn')
                    .prop('disabled', true)
                    .html(
                        '<i class="fa fa-spinner fa-spin me-1"></i> Saving...'
                    );


                $.ajax({

                    url:
                        '@Url.Action("CreateVoucher", "Accountant")',

                    type:
                        'POST',

                    data:
                        postData,

                    success:
                        function (res) {

                            $('#saveVoucherBtn')
                                .prop('disabled', false)
                                .html(
                                    '<i class="fa fa-save me-1"></i> Save Voucher as Draft'
                                );


                            if (res.success) {

                                toastr.success(
                                    res.message,
                                    'Voucher ' + res.voucherNumber
                                );


                                $('#newVoucherModal')
                                    .modal('hide');


                                $('#createVoucherForm')[0]
                                    .reset();


                                const typeBadge =
                                    res.type === 'Payment'
                                        ? 'badge-voucher-payment'
                                        : res.type === 'Receipt'
                                            ? 'badge-voucher-receipt'
                                            : res.type === 'Contra'
                                                ? 'badge-voucher-contra'
                                                : 'badge-voucher-journal';


                                const newRow = `

                                    <tr id="voucher-row-${res.voucherId}"
                                        class="table-success voucher-row-animated"
                                        style="transition: background 1.5s ease;">

                                        <td class="ps-3 fw-bold text-dark">

                                            <a href="javascript:void(0)"
                                               class="view-voucher-btn voucher-number-link text-decoration-none text-primary fw-bold"
                                               data-id="${res.voucherId}">

                                                <i class="fa fa-hashtag text-muted me-1 small"></i>

                                                ${res.voucherNumber}

                                            </a>

                                            <div class="small text-muted fw-normal mt-1">

                                                <i class="fa fa-calendar-day me-1 opacity-50"></i>

                                                ${res.date}

                                            </div>

                                        </td>


                                        <td>

                                            <span class="${typeBadge}">

                                                ${res.type}

                                            </span>

                                        </td>


                                        <td class="account-cell">

                                            <div class="small fw-semibold text-truncate text-dark account-line">

                                                <span class="text-success fw-bold">
                                                    Dr:
                                                </span>

                                                ${res.debit}

                                            </div>


                                            <div class="small text-truncate text-muted account-line mt-1">

                                                <span class="text-danger fw-bold">
                                                    Cr:
                                                </span>

                                                ${res.credit}

                                            </div>

                                        </td>


                                        <td class="text-end fw-bold text-dark text-nowrap">

                                            ₹ ${parseFloat(res.amount).toLocaleString(
                                                'en-IN',
                                                {
                                                    minimumFractionDigits: 2,
                                                    maximumFractionDigits: 2
                                                }
                                            )}

                                        </td>


                                        <td>

                                            <span class="badge-status-draft"
                                                  id="status-badge-${res.voucherId}">

                                                <i class="fa fa-circle-dot me-1"
                                                   style="font-size:0.48rem;"></i>

                                                Draft

                                            </span>

                                        </td>


                                        <td class="text-center pe-3">

                                            <div class="btn-group btn-group-sm">

                                                <button type="button"
                                                        class="btn btn-xs btn-outline-secondary view-voucher-btn"
                                                        data-id="${res.voucherId}">

                                                    <i class="fa fa-eye"></i>

                                                </button>


                                                <button type="button"
                                                        class="btn btn-xs btn-outline-success post-voucher-btn ms-1"
                                                        data-id="${res.voucherId}">

                                                    <i class="fa fa-check me-1"></i>
                                                    Post

                                                </button>

                                            </div>

                                        </td>

                                    </tr>

                                `;


                                $('#vouchersTableBody')
                                    .prepend(newRow);


                                setTimeout(
                                    () => {

                                        $(`#voucher-row-${res.voucherId}`)
                                            .removeClass('table-success');

                                    },
                                    2000
                                );

                            }
                            else {

                                toastr.error(
                                    res.message
                                    || 'Failed to save voucher.'
                                );

                            }

                        },

                    error:
                        function () {

                            $('#saveVoucherBtn')
                                .prop('disabled', false)
                                .html(
                                    '<i class="fa fa-save me-1"></i> Save Voucher as Draft'
                                );


                            toastr.error(
                                'Error connecting to server. Please try again.'
                            );

                        }

                });

            });


            $(document).on(
                'click',
                '.view-voucher-btn',
                function () {

                    const vId =
                        $(this).data('id');


                    $.ajax({

                        url:
                            '@Url.Action("GetVoucherDetails", "Accountant")?id='
                            + vId,

                        type:
                            'GET',

                        success:
                            function (res) {

                                if (res.success) {

                                    $('#vdNumber')
                                        .text(res.voucherNumber);


                                    $('#vdType')
                                        .text(res.voucherType);


                                    $('#vdDate')
                                        .text(res.voucherDate);


                                    $('#vdDebit')
                                        .text(res.debitAccount);


                                    $('#vdCredit')
                                        .text(res.creditAccount);


                                    $('#vdAmount')
                                        .text(
                                            '₹ ' +
                                            parseFloat(res.amount)
                                                .toLocaleString(
                                                    'en-IN',
                                                    {
                                                        minimumFractionDigits: 2,
                                                        maximumFractionDigits: 2
                                                    }
                                                )
                                        );


                                    $('#vdNarration')
                                        .text(
                                            res.narration
                                            || 'No additional remarks'
                                        );


                                    $('#vdCreatedAt')
                                        .text(res.createdAt);


                                    $('#vdCreatedBy')
                                        .text(res.createdBy);


                                    let badgeClass =
                                        res.status === 'Posted'
                                            ? 'bg-success text-white'
                                            : 'bg-warning text-dark';


                                    $('#vdStatus')
                                        .attr(
                                            'class',
                                            'badge ' + badgeClass
                                        )
                                        .text(res.status);


                                    $('#voucherDetailsModal')
                                        .modal('show');

                                }
                                else {

                                    toastr.error(
                                        res.message
                                        || 'Could not load voucher details.'
                                    );

                                }

                            },

                        error:
                            function () {

                                toastr.error(
                                    'Server error fetching voucher details.'
                                );

                            }

                    });

                }
            );


            $(document).on(
                'click',
                '.post-voucher-btn',
                function () {

                    const voucherId =
                        $(this).data('id');

                    const $btn =
                        $(this);


                    Swal.fire({

                        title:
                            'Post Voucher to Ledger?',

                        text:
                            'This will lock the entry and reflect in general ledger accounts.',

                        icon:
                            'question',

                        showCancelButton:
                            true,

                        confirmButtonColor:
                            '#10b981',

                        cancelButtonColor:
                            '#6b7280',

                        confirmButtonText:
                            'Yes, Post Entry'

                    }).then(
                        (result) => {

                            if (result.isConfirmed) {

                                $.ajax({

                                    url:
                                        '@Url.Action("PostVoucher", "Accountant")',

                                    type:
                                        'POST',

                                    data: {

                                        __RequestVerificationToken:
                                            token,

                                        id:
                                            voucherId

                                    },

                                    success:
                                        function (res) {

                                            if (res.success) {

                                                toastr.success(
                                                    res.message
                                                );


                                                $(`#status-badge-${voucherId}`)
                                                    .removeClass(
                                                        'badge-status-draft badge-status-submitted'
                                                    )
                                                    .addClass(
                                                        'badge-status-posted'
                                                    )
                                                    .html(
                                                        '<i class="fa fa-circle-dot me-1" style="font-size:0.48rem;"></i> Posted'
                                                    );


                                                $btn.replaceWith(

                                                    '<span class="btn btn-xs btn-light text-success disabled ms-1 border-0">' +

                                                    '<i class="fa fa-check-double"></i>' +

                                                    '</span>'

                                                );

                                            }
                                            else {

                                                toastr.error(
                                                    res.message
                                                    || 'Unable to post voucher.'
                                                );

                                            }

                                        },

                                    error:
                                        function () {

                                            toastr.error(
                                                'Server error posting voucher.'
                                            );

                                        }

                                });

                            }

                        }

                    );

                }
            );


            $('.update-task-btn').on(
                'click',
                function () {

                    const taskId =
                        $(this).data('task-id');

                    const title =
                        $(this).data('task-title');

                    const status =
                        $(this).data('current-status');

                    const progress =
                        $(this).data('current-progress');


                    $('#modalTaskId')
                        .val(taskId);


                    $('#modalTaskTitle')
                        .text(title);


                    $('#modalTaskStatus')
                        .val(status);


                    $('#modalTaskProgress')
                        .val(progress);


                    $('#progressDisplay')
                        .text(progress + '%');


                    $('#updateTaskModal')
                        .modal('show');

                }
            );


            $('#updateTaskForm').on(
                'submit',
                function (e) {

                    e.preventDefault();


                    const taskId =
                        $('#modalTaskId').val();

                    const status =
                        $('#modalTaskStatus').val();

                    const progress =
                        $('#modalTaskProgress').val();


                    $('#submitTaskUpdateBtn')
                        .prop('disabled', true)
                        .html(
                            '<i class="fa fa-spinner fa-spin me-1"></i> Updating...'
                        );


                    $.ajax({

                        url:
                            '@Url.Action("UpdateTaskProgress", "Accountant")',

                        type:
                            'POST',

                        data: {

                            taskId:
                                taskId,

                            status:
                                status,

                            progress:
                                progress

                        },

                        success:
                            function (res) {

                                $('#submitTaskUpdateBtn')
                                    .prop('disabled', false)
                                    .html(
                                        '<i class="fa fa-check me-1"></i> Update Deliverable'
                                    );


                                if (res.success) {

                                    toastr.success(
                                        res.message
                                    );


                                    $('#updateTaskModal')
                                        .modal('hide');


                                    $(`#progress-bar-${taskId}`)
                                        .css(
                                            'width',
                                            progress + '%'
                                        )
                                        .attr(
                                            'aria-valuenow',
                                            progress
                                        );


                                    $(`#progress-pct-${taskId}`)
                                        .text(
                                            progress + '%'
                                        );


                                    let badgeClass =
                                        'bg-secondary text-white';


                                    if (status === 'Completed')
                                        badgeClass =
                                            'bg-success text-white';

                                    else if (status === 'In Progress')
                                        badgeClass =
                                            'bg-primary text-white';

                                    else if (status === 'Review')
                                        badgeClass =
                                            'bg-warning text-dark';


                                    $(`#task-badge-${taskId}`)
                                        .attr(
                                            'class',
                                            'badge ' + badgeClass
                                        )
                                        .html(
                                            '<i class="fa fa-circle-dot me-1" style="font-size:0.48rem;"></i>' +
                                            status
                                        );


                                    const $btn =
                                        $(
                                            `button[data-task-id="${taskId}"]`
                                        );


                                    $btn.data(
                                        'current-status',
                                        status
                                    );


                                    $btn.data(
                                        'current-progress',
                                        progress
                                    );

                                }
                                else {

                                    toastr.error(
                                        res.message
                                        || 'Failed to update task.'
                                    );

                                }

                            },

                        error:
                            function () {

                                $('#submitTaskUpdateBtn')
                                    .prop('disabled', false)
                                    .html(
                                        '<i class="fa fa-check me-1"></i> Update Deliverable'
                                    );


                                toastr.error(
                                    'Server error updating task progress.'
                                );

                            }

                    });

                }
            );

        });
    </script>

}
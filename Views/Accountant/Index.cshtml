        height: 31px;
        flex-basis: 31px
    }

    } @@media

    (max-width:575px) {
        .acc-hub-header

    {
        padding: 1rem
    }

    .acc-header-actions {
        grid-template-columns: 1fr
    }

        .acc-header-actions .btn {
            width: 100%
        }

    .acc-kpi-card {
        gap: 0.85rem
    }

    .acc-kpi-title {
        font-size: 0.68rem
    }

    .acc-kpi-sub {
        font-size: 0.66rem
    }

    .acc-panel-title {
        font-size: 0.92rem
    }

    .acc-panel-header small {
        font-size: 0.70rem
    }

    .acc-panel-header > div:last-child {
        display: flex;
        flex-wrap: wrap;
        gap: 0.45rem
    }

        .acc-panel-header > div:last-child .btn {
            flex: 1 1 auto
        }

    .task-item-card .task-meta-row {
        flex-direction: column;
        align-items: flex-start !important;
        gap: 0.35rem !important
    }

    .task-progress-row {
        flex-wrap: wrap
    }

        .task-progress-row .task-progress-wrap {
            width: 100%;
            flex-basis: 100%
        }

        .task-progress-row .btn {
            margin-left: 0 !important
        }

    #newVoucherModal .modal-dialog, #voucherDetailsModal .modal-dialog, #updateTaskModal .modal-dialog {
        margin: 0.5rem
    }

    .accountant-page .modal-footer {
        padding: 0.8rem 1rem !important
    }

        .accountant-page .modal-footer .btn {
            font-size: 0.78rem
        }

    } @@keyframes

    accHeaderIn {
        from

    {
        opacity: 0;
        transform: translateY(-10px)
    }

    to {
        opacity: 1;
        transform: translateY(0)
    }

    } @@keyframes

    accCardIn {
        from

    {
        opacity: 0;
        transform: translateY(12px)
    }

    to {
        opacity: 1;
        transform: translateY(0)
    }

    } @@keyframes

    accPanelIn {
        from

    {
        opacity: 0;
        transform: translateY(14px)
    }

    to {
        opacity: 1;
        transform: translateY(0)
    }

    } @@keyframes

    pulse-ring {
        0%

    {
        transform: scale(0.95);
        box-shadow: 0 0 0 0 rgba(52,211,153,0.7)
    }

    70% {
        transform: scale(1);
        box-shadow: 0 0 0 8px rgba(52,211,153,0)
    }

    100% {
        transform: scale(0.95);
        box-shadow: 0 0 0 0 rgba(52,211,153,0)
    }

    } @@keyframes

    floatingDots {
        0%,100%

    {
        transform: translate3d(0,0,0);
        opacity: 0.65
    }

    50% {
        transform: translate3d(7px,-6px,0);
        opacity: 1
    }

    } @@keyframes

    progressShimmer {
        0%

    {
        left: -40%
    }

    100% {
        left: 120%
    }

    } @@keyframes

    voucherRowIn {
        from

    {
        opacity: 0;
        transform: translateY(5px)
    }

    to {
        opacity: 1;
        transform: translateY(0)
    }

    } @@keyframes

    taskItemIn {
        from

    {
        opacity: 0;
        transform: translateX(-7px)
    }

    to {
        opacity: 1;
        transform: translateX(0)
    }

    } @@media

    (max-width:767px) {
        .acc-section-heading-icon

    {
        width: 31px;
        height: 31px;
        flex-basis: 31px;
        border-radius: 9px;
        font-size: .80rem
    }

    .task-card-icon {
        width: 31px;
        height: 31px;
        flex-basis: 31px
    }

    } @@media

    (prefers-reduced-motion:reduce) {
        .accountant-page *,.accountant-page *::before,.accountant-page *::after

    {
        animation-duration: 0.001ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.001ms !important
    }

    }</style>
<div class="accountant-page">
@Html.AntiForgeryToken()
    <div class="acc-hub-header d-flex flex-column flex-lg-row justify-content-between align-items-start align-items-lg-center gap-4">
        <div class="acc-header-content">
            <div class="d-flex align-items-center flex-wrap gap-2 mb-2">
                <span class="acc-badge-live">
                    <span class="pulse-dot"></span>
                    LIVE OPERATIONAL DESK
                </span>
                <span class="badge bg-white bg-opacity-25 text-white border border-white border-opacity-25 small px-2 py-1">
                    FY 2026-27
                </span>
            </div>
            <h2 class="fw-bold mb-2 text-white acc-header-title">
                Accountant Operational Hub
            </h2>
            <p class="mb-0 text-white-50 small acc-header-description">
                Real-time double-entry voucher processing, manager task execution,
                and daily bank liquidity control.
            </p>
        </div>
        <div class="d-flex flex-wrap gap-2 acc-header-actions">
            <button type="button"
                    class="btn btn-success fw-semibold px-3 py-2 rounded-3 shadow-sm d-flex align-items-center justify-content-center gap-2"
                    data-bs-toggle="modal"
                    data-bs-target="#newVoucherModal">
                <i class="fa fa-plus-circle"></i>
                New Voucher Entry
            </button>
            <a href="@Url.Action("Vouchers", "Accountant")"
               class="btn btn-outline-light fw-semibold px-3 py-2 rounded-3 shadow-sm d-flex align-items-center justify-content-center gap-2">
                <i class="fa fa-receipt"></i>
                All Vouchers
            </a>
            <a href="@Url.Action("BankRecon", "Finance")"
               class="btn btn-light text-primary fw-semibold px-3 py-2 rounded-3 shadow-sm d-flex align-items-center justify-content-center gap-2">
                <i class="fa fa-university"></i>
                Bank Recon
            </a>
            <a href="@Url.Action("Index", "AccountHeads")"
               class="btn btn-outline-light fw-semibold px-3 py-2 rounded-3 shadow-sm d-flex align-items-center justify-content-center gap-2">
                <i class="fa fa-list-ol"></i>
                Chart of Accounts
            </a>
        </div>
    </div>

    <div class="acc-kpi-grid">
        <a href="@Url.Action("Vouchers", "Accountant", new { filterType = "Receipt" })"
           class="acc-kpi-card kpi-inflow"
           title="Click to view all Inbound Receipts">
            <div class="acc-kpi-icon">
                <i class="fa fa-arrow-down-left"></i>
            </div>
            <div class="min-width-0">
                <div class="acc-kpi-title text-success">
                    Today's Inflow (Receipts)
                    <i class="fa fa-arrow-up-right small ms-1 opacity-50"></i>
                </div>
                <div class="acc-kpi-val text-success">
                    ₹ @Model.TodayInflow.ToString("N2", inCulture)
                </div>
                <div class="acc-kpi-sub">
                    Customer collections & inbound cash
                </div>
            </div>
        </a>

        <a href="@Url.Action("Vouchers", "Accountant", new { filterType = "Payment" })"
           class="acc-kpi-card kpi-outflow"
           title="Click to view all Outflow Payments">
            <div class="acc-kpi-icon">
                <i class="fa fa-arrow-up-right"></i>
            </div>
            <div class="min-width-0">
                <div class="acc-kpi-title text-danger">
                    Today's Outflow (Payments)
                    <i class="fa fa-arrow-up-right small ms-1 opacity-50"></i>
                </div>
                <div class="acc-kpi-val text-danger">
                    ₹ @Model.TodayOutflow.ToString("N2", inCulture)
                </div>
                <div class="acc-kpi-sub">
                    Vendor payouts & operating expenses
                </div>
            </div>
        </a>

        <a href="@Url.Action("Vouchers", "Accountant", new { filterStatus = "Draft" })"
           class="acc-kpi-card kpi-draft"
           title="Click to view and post Draft Vouchers">
            <div class="acc-kpi-icon">
                <i class="fa fa-file-invoice"></i>
            </div>
            <div class="min-width-0">
                <div class="acc-kpi-title text-warning">
                    Draft Vouchers to Post
                    <i class="fa fa-arrow-up-right small ms-1 opacity-50"></i>
                </div>
                <div class="acc-kpi-val text-warning">
                    @Model.PendingVouchersCount Vouchers
                </div>
                <div class="acc-kpi-sub">
                    Awaiting verification & posting
                </div>
            </div>
        </a>

        <a href="@Url.Action("BankRecon", "Finance", new { filter = "Unmatched" })"
           class="acc-kpi-card kpi-recon"
           title="Click to open Bank Reconciliation workspace">
            <div class="acc-kpi-icon">
                <i class="fa fa-scale-balanced"></i>
            </div>
            <div class="min-width-0">
                <div class="acc-kpi-title text-info">
                    Unreconciled Bank Entries
                    <i class="fa fa-arrow-up-right small ms-1 opacity-50"></i>
                </div>
                <div class="acc-kpi-val text-info">
                    @Model.UnreconciledItemsCount Entries
                </div>
                <div class="acc-kpi-sub">
                    Statement vs Book variances
                </div>
            </div>
        </a>
    </div>

    <div class="row g-4 mb-1">

        <!-- Recent Vouchers Queue — FULL WIDTH -->
        <div class="col-12">
            <div class="acc-panel h-100 acc-full-width-panel">

                <div class="acc-panel-header">
                    <div>
                        <h5 class="acc-panel-title">
                            <span class="acc-section-heading-icon">
                                <i class="fas fa-receipt text-primary"></i>
                            </span>
                            <span>
                                Recent Vouchers Queue
                            </span>
                        </h5>

                        <small class="text-muted">
                            Double-entry transactions with contextual account ledger links
                        </small>
                    </div>

                    <div class="d-flex flex-wrap gap-2">
                        <button type="button"
                                class="btn btn-sm btn-primary d-flex align-items-center justify-content-center gap-1 shadow-sm"
                                data-bs-toggle="modal"
                                data-bs-target="#newVoucherModal">
                            <i class="fa fa-plus"></i>
                            New Voucher
                        </button>

                        <a href="@Url.Action("Vouchers", "Accountant")"
                           class="btn btn-sm btn-outline-secondary d-flex align-items-center justify-content-center gap-1">
                            <i class="fa fa-list"></i>
                            View Register
                        </a>
                    </div>
                </div>

                <div class="p-0">
                    <div class="accountant-table-responsive">
                        <table class="table table-hover align-middle mb-0"
                               id="vouchersTable">

                            <thead class="table-light small text-uppercase text-muted">
                                <tr>
                                    <th class="ps-3">
                                        Voucher #
                                    </th>

                                    <th>
                                        Type
                                    </th>

                                    <th>
                                        Dr / Cr Accounts
                                    </th>

                                    <th class="text-end">
                                        Amount
                                    </th>

                                    <th>
                                        Status
                                    </th>

                                    <th class="text-center pe-3">
                                        Actions
                                    </th>
                                </tr>
                            </thead>

                            <tbody id="vouchersTableBody">

                                @if (Model.RecentVouchers != null && Model.RecentVouchers.Any())
                                {
                                    foreach (var v in Model.RecentVouchers)
                                    {
                                        var typeClass = v.VoucherType switch
                                        {
                                            "Payment" => "badge-voucher-payment",
                                            "Receipt" => "badge-voucher-receipt",
                                            "Contra" => "badge-voucher-contra",
                                            _ => "badge-voucher-journal"
                                        };

                                        var statusClass = v.Status switch
                                        {
                                            "Posted" => "badge-status-posted",
                                            "Submitted" => "badge-status-submitted",
                                            _ => "badge-status-draft"
                                        };

                                        string drLink =
                                        v.DebitAccount.StartsWith("Vendor:")
                                        ? Url.Action("Payables", "Finance")
                                        : v.DebitAccount.StartsWith("Customer:")
                                        ? Url.Action("Receivables", "Finance")
                                        : (v.DebitAccount.Contains("Bank")
                                        || v.DebitAccount.Contains("A/c")
                                        || v.DebitAccount.Contains("Cash"))
                                        ? Url.Action("BankRecon", "Finance")
                                        : Url.Action("Ledger", "Finance");

                                        string crLink =
                                        v.CreditAccount.StartsWith("Vendor:")
                                        ? Url.Action("Payables", "Finance")
                                        : v.CreditAccount.StartsWith("Customer:")
                                        ? Url.Action("Receivables", "Finance")
                                        : (v.CreditAccount.Contains("Bank")
                                        || v.CreditAccount.Contains("A/c")
                                        || v.CreditAccount.Contains("Cash"))
                                        ? Url.Action("BankRecon", "Finance")
                                        : Url.Action("Ledger", "Finance");

                                        <tr id="voucher-row-@v.Id"
                                            class="voucher-row-animated">

                                            <td class="ps-3 fw-bold text-dark">
                                                <a href="javascript:void(0)"
                                                   class="view-voucher-btn voucher-number-link text-decoration-none text-primary fw-bold"
                                                   data-id="@v.Id"
                                                   title="Click to view double-entry voucher slip">

                                                    <i class="fa fa-hashtag text-muted me-1 small"></i>
                                                    @v.VoucherNumber

                                                </a>

                                                <div class="small text-muted fw-normal mt-1">
                                                    <i class="fa fa-calendar-day me-1 opacity-50"></i>
                                                    @v.VoucherDate.ToString("dd MMM yyyy")
                                                </div>
                                            </td>

                                            <td>
                                                <a href="@Url.Action("Vouchers", "Accountant", new { filterType = v.VoucherType })"
                                                   class="@typeClass text-decoration-none"
                                                   title="Filter by @v.VoucherType">

                                                    @v.VoucherType

                                                </a>
                                            </td>

                                            <td class="account-cell">

                                                <div class="small fw-semibold text-truncate text-dark account-line"
                                                     title="Click to inspect @v.DebitAccount ledger">

                                                    <span class="text-success fw-bold">
                                                        Dr:
                                                    </span>

                                                    <a href="@drLink"
                                                       class="acc-clickable-link"
                                                       title="Open account subledger">

                                                        @v.DebitAccount

                                                    </a>

                                                </div>

                                                <div class="small text-truncate text-muted account-line mt-1"
                                                     title="Click to inspect @v.CreditAccount ledger">

                                                    <span class="text-danger fw-bold">
                                                        Cr:
                                                    </span>

                                                    <a href="@crLink"
                                                       class="acc-clickable-link"
                                                       title="Open account subledger">

                                                        @v.CreditAccount

                                                    </a>

                                                </div>

                                            </td>

                                            <td class="text-end fw-bold text-dark text-nowrap">

                                                <span class="me-1 text-success opacity-50">
                                                    ₹
                                                </span>

                                                @v.Amount.ToString("N2", inCulture)

                                            </td>

                                            <td>

                                                <a href="@Url.Action("Vouchers", "Accountant", new { filterStatus = v.Status })"
                                                   class="@statusClass text-decoration-none"
                                                   id="status-badge-@v.Id"
                                                   title="Filter by @v.Status">

                                                    <i class="fa fa-circle-dot me-1"
                                                       style="font-size:0.48rem;"></i>

                                                    @v.Status

                                                </a>

                                            </td>

                                            <td class="text-center pe-3">

                                                <div class="btn-group btn-group-sm">

                                                    <button type="button"
                                                            class="btn btn-xs btn-outline-secondary view-voucher-btn"
                                                            data-id="@v.Id"
                                                            title="View Voucher Slip">

                                                        <i class="fa fa-eye"></i>

                                                    </button>

                                                    @if (v.Status == "Draft")
                                                    {
                                                        <button type="button"
                                                                class="btn btn-xs btn-outline-success post-voucher-btn ms-1"
                                                                data-id="@v.Id"
                                                                title="Post to General Ledger">

                                                            <i class="fa fa-check me-1"></i>
                                                            Post

                                                        </button>
                                                    }
                                                    else
                                                    {
                                                        <span class="btn btn-xs btn-light text-success disabled ms-1 border-0"
                                                              title="Posted to Ledger">

                                                            <i class="fa fa-check-double"></i>

                                                        </span>
                                                    }

                                                </div>

                                            </td>

                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="6"
                                            class="text-center py-5 text-muted">

                                            <div class="acc-empty-state">

                                                <div class="acc-empty-icon">
                                                    <i class="fa fa-folder-open"></i>
                                                </div>

                                                <div class="fw-semibold text-dark mb-1">
                                                    No vouchers recorded yet
                                                </div>

                                                <div class="small">
                                                    Click <strong>[+ New Voucher Entry]</strong>
                                                    above to create one.
                                                </div>

                                            </div>

                                        </td>
                                    </tr>
                                }

                            </tbody>

                        </table>
                    </div>
                </div>

                <div class="acc-panel-footer py-2 px-3 text-muted small d-flex justify-content-between align-items-center flex-wrap gap-2">

                    <span>
                        <i class="fa fa-layer-group me-1 opacity-50"></i>
                        Showing @(Model.RecentVouchers?.Count ?? 0) latest entries
                    </span>

                    <span class="fst-italic">
                        <i class="fa fa-info-circle me-1"></i>
                        Click any Dr/Cr account name to jump to its subledger
                    </span>

                </div>

            </div>
        </div>


        <!-- Manager Directives — FULL WIDTH -->
        <div class="col-12">

            <div class="acc-panel h-100 acc-full-width-panel">

                <div class="acc-panel-header">

                    <div>
                        <h5 class="acc-panel-title">

                            <span class="acc-section-heading-icon manager-icon">
                                <i class="fas fa-user-tie text-primary"></i>
                            </span>

                            <span>
                                Manager Directives
                            </span>

                        </h5>

                        <small class="text-muted">
                            Direct operational deliverables assigned by Vakkas (Finance Manager)
                        </small>

                    </div>

                    <a href="@Url.Action("Assigned", "ESSTasks")"
                       class="btn btn-sm btn-outline-secondary d-flex align-items-center justify-content-center gap-1">

                        <i class="fa fa-list-check"></i>

                        View Tasks

                    </a>

                </div>


                <div class="task-list-wrap">

                    @if (Model.AssignedTasks != null && Model.AssignedTasks.Any())
                    {

                        foreach (var task in Model.AssignedTasks)
                        {

                            var priorityClass = (task.Priority?.ToLower()) switch
                            {
                                "high" => "priority-high",
                                "low" => "priority-low",
                                _ => "priority-medium"
                            };

                            var statusBadgeClass = task.Status switch
                            {
                                "Completed" => "bg-success text-white",
                                "In Progress" => "bg-primary text-white",
                                "Review" => "bg-warning text-dark",
                                _ => "bg-secondary text-white"
                            };

                            <div class="task-item-card @priorityClass"
                                 id="task-card-@task.Id">

                                <div class="d-flex justify-content-between align-items-start gap-2 mb-2">

                                    <div class="d-flex align-items-start gap-2 min-width-0">

                                        <span class="task-card-icon"
                                              aria-hidden="true">

                                            <i class="fa fa-clipboard-check"></i>

                                        </span>

                                        <h6 class="fw-bold mb-0 text-dark min-width-0"
                                            style="font-size: 0.90rem;">

                                            <a href="@Url.Action("Assigned", "ESSTasks")"
                                               class="task-title-link"
                                               title="Open in task workspace">

                                                @task.Title

                                            </a>

                                        </h6>

                                    </div>


                                    <span class="badge @statusBadgeClass"
                                          id="task-badge-@task.Id"
                                          style="font-size: 0.67rem; white-space: nowrap;">

                                        <i class="fa fa-circle-dot me-1"
                                           style="font-size:0.48rem;"></i>

                                        @task.Status

                                    </span>

                                </div>


                                <p class="task-description mb-2 line-clamp-2">

                                    <i class="fa fa-align-left me-1 opacity-50"></i>

                                    @task.Description

                                </p>


                                <div class="d-flex justify-content-between align-items-center small text-muted mb-2 task-meta-row"
                                     style="font-size: 0.72rem;">

                                    <div>

                                        <i class="fa fa-calendar-alt text-danger me-1"></i>

                                        Due:

                                        <strong>

                                            @(task.DueDate?.ToString("dd MMM yyyy") ?? "N/A")

                                        </strong>

                                    </div>


                                    <div>

                                        <span class="task-priority-pill @(task.Priority == "High" ? "priority-high-pill" : task.Priority == "Low" ? "priority-low-pill" : "priority-medium-pill")">

                                            <i class="fa fa-flag"></i>

                                            @task.Priority Priority

                                        </span>

                                    </div>

                                </div>


                                <div class="d-flex align-items-center gap-2 pt-2 border-top border-light task-progress-row">

                                    <div class="progress flex-grow-1 task-progress-wrap task-progress">

                                        <div class="progress-bar"
                                             id="progress-bar-@task.Id"
                                             role="progressbar"
                                             style="width: @task.ProgressPercentage%;"
                                             aria-valuenow="@task.ProgressPercentage"
                                             aria-valuemin="0"
                                             aria-valuemax="100">
                                        </div>

                                    </div>


                                    <span class="small fw-bold text-primary"
                                          id="progress-pct-@task.Id"
                                          style="font-size: 0.72rem; min-width: 34px;">

                                        @task.ProgressPercentage%

                                    </span>


                                    <button type="button"
                                            class="btn btn-xs btn-outline-primary ms-1 update-task-btn"
                                            data-task-id="@task.Id"
                                            data-task-title="@task.Title"
                                            data-current-status="@task.Status"
                                            data-current-progress="@task.ProgressPercentage"
                                            title="Update Progress">

                                        <i class="fa fa-pen me-1"></i>
                                        Update

                                    </button>


                                    <a href="@Url.Action("Assigned", "ESSTasks")"
                                       class="btn btn-xs btn-outline-secondary"
                                       title="Open Task Detail">

                                        <i class="fa fa-arrow-right"></i>

                                    </a>

                                </div>

                            </div>

                        }

                    }
                    else
                    {

                        <div class="acc-empty-state">

                            <div class="acc-empty-icon text-success">

                                <i class="fa fa-clipboard-check"></i>

                            </div>

                            <h6 class="text-dark fw-bold">

                                All Directives Up to Date!

                            </h6>

                            <p class="small mb-0">

                                No pending operational deliverables from Finance Manager.

                            </p>

                        </div>

                    }

                </div>


                <div class="acc-panel-footer py-2 px-3 text-muted small d-flex justify-content-between align-items-center flex-wrap gap-2">

                    <span>

                        <i class="fa fa-bullhorn me-1 opacity-50"></i>

                        Direct delegation channel

                    </span>

                    <span class="text-primary">

                        <i class="fa fa-user-shield me-1"></i>

                        Managed by Vakkas (Finance Mgr)

                    </span>

                </div>

            </div>

        </div>

    </div>


    <!-- Bank Liquidity & Reconciliation -->

    <div class="acc-panel">

        <div class="acc-panel-header">

            <div>

                <h5 class="acc-panel-title">

                    <i class="fa fa-building-columns text-primary"></i>

                    <span>
                        Bank Liquidity & Reconciliation Snapshot
                    </span>

                </h5>

                <small class="text-muted">

                    Live statement vs ledger balances across corporate accounts —
                    click any account to reconcile

                </small>

            </div>


            <div class="d-flex flex-wrap gap-2">

                <a href="@Url.Action("BankRecon", "Finance")"
                   class="btn btn-sm btn-outline-primary d-flex align-items-center gap-1 shadow-sm">

                    <i class="fa fa-arrow-rotate-right"></i>
                    Open Full Reconciliation

                </a>

                <a href="@Url.Action("Ledger", "Finance")"
                   class="btn btn-sm btn-outline-secondary d-flex align-items-center gap-1 shadow-sm">

                    <i class="fa fa-book"></i>
                    General Ledger

                </a>

            </div>

        </div>


        <div class="p-3">

            <div class="row g-3">

                @if (Model.BankAccounts != null && Model.BankAccounts.Any())
                {

                    foreach (var bank in Model.BankAccounts)
                    {

                        var variance = bank.StatementBalance - bank.BookBalance;
                        var hasVariance = Math.Abs(variance) > 0.01m;

                        <div class="col-md-6 col-xl-3">

                            <div class="bank-card">

                                <div>

                                    <div class="d-flex align-items-center justify-content-between gap-2 mb-3">

                                        <div class="d-flex align-items-center gap-2 min-width-0">

                                            <div class="bank-icon-box">

                                                <i class="fa fa-landmark"></i>

                                            </div>

                                            <div class="min-width-0">

                                                <h6 class="fw-bold mb-0 text-dark text-truncate"
                                                    style="font-size: 0.86rem;">

                                                    <a href="@Url.Action("BankRecon", "Finance", new { bankAccountId = bank.Id })"
                                                       class="text-decoration-none text-dark acc-clickable-link"
                                                       title="Open @bank.BankAccountName">

                                                        @bank.BankAccountName

                                                    </a>

                                                </h6>

                                                <small class="text-muted"
                                                       style="font-size: 0.68rem;">

                                                    <i class="fa fa-rotate me-1 opacity-50"></i>

                                                    Last Sync:
                                                    @bank.LastSyncDate.ToString("dd MMM yyyy")

                                                </small>

                                            </div>

                                        </div>


                                        @if (bank.UnreconciledEntriesCount > 0)
                                        {

                                            <a href="@Url.Action("BankRecon", "Finance", new { bankAccountId = bank.Id, filter = "Unmatched" })"
                                               class="badge bg-warning-subtle text-warning border border-warning-subtle text-decoration-none"
                                               title="Click to clear @bank.UnreconciledEntriesCount unreconciled items">

                                                <i class="fa fa-triangle-exclamation me-1"></i>

                                                @bank.UnreconciledEntriesCount
                                                Unreconciled

                                            </a>

                                        }
                                        else
                                        {

                                            <span class="badge bg-success-subtle text-success border border-success-subtle"
                                                  title="Fully reconciled">

                                                <i class="fa fa-check"></i>
                                                Reconciled

                                            </span>

                                        }

                                    </div>


                                    <div class="bank-balance-box mb-2">

                                        <div class="d-flex justify-content-between gap-2 small mb-2">

                                            <span class="text-muted">
                                                Statement Balance:
                                            </span>

                                            <strong class="text-dark text-nowrap">

                                                ₹ @bank.StatementBalance.ToString("N2", inCulture)

                                            </strong>

                                        </div>


                                        <div class="d-flex justify-content-between gap-2 small mb-2">

                                            <span class="text-muted">
                                                Book (Ledger) Balance:
                                            </span>

                                            <strong class="text-primary text-nowrap">

                                                <a href="@Url.Action("Ledger", "Finance")"
                                                   class="text-decoration-none text-primary"
                                                   title="Jump to Ledger Balance">

                                                    ₹ @bank.BookBalance.ToString("N2", inCulture)

                                                </a>

                                            </strong>

                                        </div>


                                        <div class="d-flex justify-content-between gap-2 small pt-2 border-top border-secondary-subtle">

                                            <span class="text-muted">
                                                Variance:
                                            </span>

                                            <strong class="@(hasVariance ? "text-danger" : "text-success") text-nowrap">

                                                ₹ @variance.ToString("N2", inCulture)

                                            </strong>

                                        </div>

                                    </div>

                                </div>


                                <div class="pt-2 d-flex gap-2">

                                    <a href="@Url.Action("BankRecon", "Finance", new { bankAccountId = bank.Id })"
                                       class="btn btn-xs btn-outline-primary flex-grow-1"
                                       title="Reconcile this account">

                                        <i class="fa fa-arrows-split-up-and-left me-1"></i>
                                        Reconcile

                                    </a>

                                    <a href="@Url.Action("Ledger", "Finance")"
                                       class="btn btn-xs btn-outline-secondary"
                                       title="View Account Ledger">

                                        <i class="fa fa-book me-1"></i>
                                        Ledger

                                    </a>

                                </div>

                            </div>

                        </div>

                    }

                }
                else
                {

                    <div class="col-12">

                        <div class="acc-empty-state">

                            <div class="acc-empty-icon">

                                <i class="fa fa-university"></i>

                            </div>

                            <p class="mb-0">

                                No active bank accounts configured yet.

                            </p>

                        </div>

                    </div>

                }

            </div>

        </div>

    </div>



@model ERP_System.Models.AccountantDashboardViewModel
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Accountant Operational Hub";
    var inCulture = new System.Globalization.CultureInfo("en-IN");
}
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
<style>
    :root {
        --acc-primary: #2563eb;
        --acc-primary-dark: #1d4ed8;
        --acc-success: #10b981;
        --acc-danger: #ef4444;
        --acc-warning: #f59e0b;
        --acc-info: #06b6d4;
        --acc-purple: #8b5cf6;
        --acc-text: #0f172a;
        --acc-muted: #64748b;
        --acc-light-text: #94a3b8;
        --acc-border: #e2e8f0;
        --acc-border-light: #edf2f7;
        --acc-surface: #ffffff;
        --acc-soft: #f8fafc;
        --glass-bg: rgba(255,255,255,0.92);
        --glass-border: rgba(226,232,240,0.9);
        --glass-shadow: 0 10px 30px -12px rgba(15,23,42,0.12),0 4px 10px -5px rgba(15,23,42,0.05);
        --glass-hover-shadow: 0 22px 45px -18px rgba(15,23,42,0.20),0 8px 18px -8px rgba(15,23,42,0.08)
    }

    .accountant-page {
        width: 100%;
        max-width: 100%;
        min-width: 0;
        box-sizing: border-box;
        overflow-x: hidden;
        padding-bottom: 1rem
    }

        .accountant-page *, .accountant-page *::before, .accountant-page *::after {
            box-sizing: border-box
        }

        .accountant-page .row {
            min-width: 0
        }

        .accountant-page [class*="col-"] {
            min-width: 0
        }

    .acc-hub-header {
        width: 100%;
        min-width: 0;
        background: radial-gradient( circle at 85% 20%,rgba(59,130,246,0.24),transparent 30% ),radial-gradient( circle at 65% 120%,rgba(14,165,233,0.13),transparent 32% ),linear-gradient( 135deg,#0b1220 0%,#172554 52%,#1e3a8a 100% );
        color: #ffffff;
        border-radius: 18px;
        padding: 1.75rem 2rem;
        margin-bottom: 1.75rem;
        box-shadow: 0 18px 40px -16px rgba(15,23,42,0.35);
        position: relative;
        overflow: hidden;
        border: 1px solid rgba(255,255,255,0.10);
        isolation: isolate;
        animation: accHeaderIn 0.55s ease both
    }

        .acc-hub-header::before {
            content: "";
            position: absolute;
            width: 280px;
            height: 280px;
            right: -100px;
            top: -145px;
            border-radius: 50%;
            border: 1px solid rgba(255,255,255,0.08);
            box-shadow: 0 0 0 25px rgba(255,255,255,0.018),0 0 0 50px rgba(255,255,255,0.014),0 0 0 75px rgba(255,255,255,0.010);
            pointer-events: none;
            z-index: -1
        }

        .acc-hub-header::after {
            content: "";
            position: absolute;
            width: 8px;
            height: 8px;
            right: 28%;
            top: 32%;
            border-radius: 50%;
            background: rgba(147,197,253,0.9);
            box-shadow: 55px 35px 0 rgba(96,165,250,0.35),-80px 50px 0 rgba(125,211,252,0.25),120px -30px 0 rgba(191,219,254,0.22);
            animation: floatingDots 5s ease-in-out infinite;
            pointer-events: none
        }

    .acc-header-content {
        min-width: 0;
        position: relative;
        z-index: 2
    }

    .acc-header-title {
        font-size: clamp(1.35rem,2.3vw,2rem);
        letter-spacing: -0.025em;
        line-height: 1.2
    }

    .acc-header-description {
        max-width: 700px;
        line-height: 1.55
    }

    .acc-header-actions {
        position: relative;
        z-index: 3;
        min-width: 0
    }

        .acc-header-actions .btn {
            transition: transform 0.2s ease,box-shadow 0.2s ease,background 0.2s ease
        }

            .acc-header-actions .btn:hover {
                transform: translateY(-2px)
            }

    .acc-badge-live {
        background: rgba(16,185,129,0.14);
        color: #6ee7b7;
        border: 1px solid rgba(110,231,183,0.30);
        padding: 0.4rem 0.85rem;
        border-radius: 50px;
        font-size: 0.70rem;
        font-weight: 700;
        letter-spacing: 0.65px;
        display: inline-flex;
        align-items: center;
        gap: 7px;
        white-space: nowrap
    }

    .pulse-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: #34d399;
        box-shadow: 0 0 0 0 rgba(52,211,153,0.7);
        animation: pulse-ring 1.8s infinite cubic-bezier(0.66,0,0,1);
        flex-shrink: 0
    }

    .acc-kpi-grid {
        width: 100%;
        min-width: 0;
        display: grid;
        grid-template-columns: repeat(4,minmax(0,1fr));
        gap: 1.15rem;
        margin-bottom: 1.75rem
    }

    .acc-kpi-card {
        width: 100%;
        min-width: 0;
        min-height: 125px;
        background: var(--glass-bg);
        backdrop-filter: blur(14px);
        -webkit-backdrop-filter: blur(14px);
        border: 1px solid var(--glass-border);
        border-radius: 16px;
        padding: 1.35rem 1.4rem;
        box-shadow: var(--glass-shadow);
        transition: transform 0.28s cubic-bezier(0.16,1,0.3,1),box-shadow 0.28s ease,border-color 0.28s ease;
        position: relative;
        overflow: hidden;
        display: flex;
        align-items: center;
        gap: 1.05rem;
        text-decoration: none !important;
        color: inherit;
        isolation: isolate;
        animation: accCardIn 0.55s ease both
    }

        .acc-kpi-card::before {
            content: "";
            position: absolute;
            width: 120px;
            height: 120px;
            right: -60px;
            top: -60px;
            border-radius: 50%;
            background: rgba(59,130,246,0.035);
            z-index: -1;
            transition: transform 0.35s ease
        }

        .acc-kpi-card::after {
            content: "";
            position: absolute;
            left: 0;
            bottom: 0;
            width: 0;
            height: 3px;
            border-radius: 0 4px 4px 0;
            background: currentColor;
            opacity: 0.65;
            transition: width 0.3s ease
        }

        .acc-kpi-card:hover {
            transform: translateY(-5px);
            box-shadow: var(--glass-hover-shadow)
        }

            .acc-kpi-card:hover::before {
                transform: scale(1.4)
            }

            .acc-kpi-card:hover::after {
                width: 60%
            }

    .acc-kpi-icon {
        width: 56px;
        height: 56px;
        border-radius: 15px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.4rem;
        flex-shrink: 0;
        box-shadow: 0 8px 16px -8px rgba(15,23,42,0.20);
        transition: transform 0.25s ease
    }

    .acc-kpi-card:hover .acc-kpi-icon {
        transform: scale(1.07) rotate(-2deg)
    }

    .kpi-inflow {
        border-left: 4px solid #10b981
    }

        .kpi-inflow .acc-kpi-icon {
            background: linear-gradient( 135deg,rgba(16,185,129,0.12),rgba(16,185,129,0.25) );
            color: #059669
        }

    .kpi-outflow {
        border-left: 4px solid #ef4444
    }

        .kpi-outflow .acc-kpi-icon {
            background: linear-gradient( 135deg,rgba(239,68,68,0.12),rgba(239,68,68,0.25) );
            color: #dc2626
        }

    .kpi-draft {
        border-left: 4px solid #f59e0b
    }

        .kpi-draft .acc-kpi-icon {
            background: linear-gradient( 135deg,rgba(245,158,11,0.12),rgba(245,158,11,0.25) );
            color: #d97706
        }

    .kpi-recon {
        border-left: 4px solid #06b6d4
    }

        .kpi-recon .acc-kpi-icon {
            background: linear-gradient( 135deg,rgba(6,182,212,0.12),rgba(6,182,212,0.25) );
            color: #0891b2
        }

    .acc-kpi-title {
        font-size: 0.73rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        color: #64748b;
        margin-bottom: 0.35rem;
        line-height: 1.35
    }

    .acc-kpi-val {
        font-size: clamp(1.15rem,2vw,1.48rem);
        font-weight: 800;
        line-height: 1.2;
        margin-bottom: 0.2rem;
        letter-spacing: -0.025em;
        overflow-wrap: anywhere
    }

    .acc-kpi-sub {
        font-size: 0.70rem;
        color: #94a3b8;
        line-height: 1.4
    }

    .acc-panel {
        width: 100%;
        min-width: 0;
        background: var(--glass-bg);
        backdrop-filter: blur(14px);
        -webkit-backdrop-filter: blur(14px);
        border: 1px solid var(--glass-border);
        border-radius: 16px;
        box-shadow: var(--glass-shadow);
        margin-bottom: 1.5rem;
        overflow: hidden;
        transition: box-shadow 0.28s ease,transform 0.28s ease;
        animation: accPanelIn 0.6s ease both
    }

        .acc-panel:hover {
            box-shadow: var(--glass-hover-shadow)
        }

    .acc-panel-header {
        min-width: 0;
        padding: 1.15rem 1.4rem;
        background: linear-gradient( 180deg,rgba(248,250,252,0.96),rgba(248,250,252,0.72) );
        border-bottom: 1px solid var(--glass-border);
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem
    }

        .acc-panel-header > div:first-child {
            min-width: 0
        }

    .acc-panel-title {
        font-size: 1rem;
        font-weight: 750;
        margin: 0;
        display: flex;
        align-items: center;
        gap: 0.6rem;
        color: #1e293b;
        line-height: 1.35
    }

        .acc-panel-title i {
            width: 30px;
            height: 30px;
            border-radius: 9px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            background: #eff6ff;
            color: #2563eb;
            font-size: 0.85rem;
            flex-shrink: 0
        }

    .acc-panel-header small {
        display: block;
        margin-top: 4px;
        line-height: 1.4
    }

    .acc-panel-header .btn {
        white-space: nowrap
    }

    .accountant-table-responsive {
        width: 100%;
        min-width: 0;
        overflow-x: auto;
        overflow-y: hidden;
        -webkit-overflow-scrolling: touch
    }

        .accountant-table-responsive::-webkit-scrollbar {
            height: 6px
        }

        .accountant-table-responsive::-webkit-scrollbar-track {
            background: #f1f5f9
        }

        .accountant-table-responsive::-webkit-scrollbar-thumb {
            background: #cbd5e1;
            border-radius: 20px
        }

    #vouchersTable {
        width: 100%;
        min-width: 920px
    }

        #vouchersTable thead th {
            padding-top: 0.9rem;
            padding-bottom: 0.9rem;
            font-size: 0.68rem;
            font-weight: 750;
            letter-spacing: 0.65px;
            color: #64748b;
            white-space: nowrap;
            border-bottom: 1px solid #e2e8f0
        }

        #vouchersTable tbody td {
            padding-top: 0.9rem;
            padding-bottom: 0.9rem;
            border-bottom: 1px solid #f1f5f9;
            vertical-align: middle
        }

        #vouchersTable tbody tr {
            transition: background-color 0.2s ease,transform 0.2s ease
        }

            #vouchersTable tbody tr:hover {
                background: #f8fbff
            }

            #vouchersTable tbody tr:last-child td {
                border-bottom: 0
            }

    .voucher-number-link {
        transition: color 0.18s ease
    }

        .voucher-number-link:hover {
            color: #1d4ed8 !important
        }

    .account-cell {
        max-width: 260px;
        min-width: 210px
    }

    .account-line {
        max-width: 100%;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap
    }

        .account-line a {
            transition: color 0.18s ease
        }

            .account-line a:hover {
                color: #2563eb !important
            }

    .acc-clickable-link {
        text-decoration: none;
        color: inherit;
        border-bottom: 1px dashed rgba(59,130,246,0.35);
        transition: color 0.15s ease,border-color 0.15s ease
    }

        .acc-clickable-link:hover {
            color: #2563eb !important;
            border-bottom-color: #2563eb
        }

    .badge-voucher-payment, .badge-voucher-receipt, .badge-voucher-journal, .badge-voucher-contra {
        display: inline-flex;
        align-items: center;
        white-space: nowrap;
        font-weight: 650;
        border-radius: 7px;
        padding: 0.32rem 0.65rem;
        font-size: 0.72rem;
        transition: transform 0.18s ease
    }

    .badge-voucher-payment {
        background: rgba(239,68,68,0.10);
        color: #dc2626;
        border: 1px solid rgba(239,68,68,0.22)
    }

    .badge-voucher-receipt {
        background: rgba(16,185,129,0.10);
        color: #059669;
        border: 1px solid rgba(16,185,129,0.22)
    }

    .badge-voucher-journal {
        background: rgba(59,130,246,0.10);
        color: #2563eb;
        border: 1px solid rgba(59,130,246,0.22)
    }

    .badge-voucher-contra {
        background: rgba(139,92,246,0.10);
        color: #7c3aed;
        border: 1px solid rgba(139,92,246,0.22)
    }

        .badge-voucher-payment:hover, .badge-voucher-receipt:hover, .badge-voucher-journal:hover, .badge-voucher-contra:hover {
            transform: translateY(-1px)
        }

    .badge-status-draft, .badge-status-submitted, .badge-status-posted {
        display: inline-flex;
        align-items: center;
        white-space: nowrap;
        font-weight: 650;
        padding: 0.3rem 0.65rem;
        border-radius: 50px;
        font-size: 0.70rem;
        border: 1px solid transparent
    }

    .badge-status-draft {
        background: #fff7d6;
        color: #b45309;
        border-color: #fde68a
    }

    .badge-status-submitted {
        background: #e0f2fe;
        color: #0369a1;
        border-color: #bae6fd
    }

    .badge-status-posted {
        background: #dcfce7;
        color: #047857;
        border-color: #bbf7d0
    }

    .task-list-wrap {
        padding: 1rem
    }

    .task-item-card {
        background: linear-gradient( 135deg,rgba(255,255,255,0.96),rgba(248,250,252,0.90) );
        border: 1px solid var(--glass-border);
        border-radius: 13px;
        padding: 1rem 1.05rem;
        margin-bottom: 0.8rem;
        transition: transform 0.24s ease,box-shadow 0.24s ease,border-color 0.24s ease;
        position: relative;
        overflow: hidden
    }

        .task-item-card:last-child {
            margin-bottom: 0
        }

        .task-item-card::after {
            content: "";
            position: absolute;
            width: 80px;
            height: 80px;
            right: -45px;
            bottom: -45px;
            border-radius: 50%;
            background: rgba(59,130,246,0.045);
            pointer-events: none;
            transition: transform 0.3s ease
        }

        .task-item-card:hover {
            background: #ffffff;
            transform: translateY(-3px);
            box-shadow: 0 10px 24px -12px rgba(15,23,42,0.18);
            border-color: #d6e2f0
        }

            .task-item-card:hover::after {
                transform: scale(1.5)
            }

        .task-item-card.priority-high {
            border-left: 4px solid #ef4444
        }

        .task-item-card.priority-medium {
            border-left: 4px solid #f59e0b
        }

        .task-item-card.priority-low {
            border-left: 4px solid #3b82f6
        }

    .task-title-link {
        color: #1e293b;
        text-decoration: none;
        transition: color 0.18s ease
    }

        .task-title-link:hover {
            color: #2563eb
        }

    .task-description {
        font-size: 0.78rem;
        line-height: 1.5;
        color: #64748b
    }

    .task-progress-wrap {
        min-width: 0
    }

    .task-progress {
        height: 7px;
        border-radius: 10px;
        background: #e2e8f0;
        overflow: hidden
    }

        .task-progress .progress-bar {
            border-radius: 10px;
            background: linear-gradient(90deg,#2563eb,#60a5fa) !important;
            position: relative;
            overflow: hidden
        }

            .task-progress .progress-bar::after {
                content: "";
                position: absolute;
                top: 0;
                left: -40%;
                width: 35%;
                height: 100%;
                background: rgba(255,255,255,0.30);
                transform: skewX(-20deg);
                animation: progressShimmer 2.8s linear infinite
            }

    .acc-full-width-panel {
        width: 100%;
        min-width: 0
    }

        .acc-full-width-panel .acc-panel-header {
            position: relative;
            overflow: hidden
        }

            .acc-full-width-panel .acc-panel-header::before {
                content: "";
                position: absolute;
                left: 0;
                top: 0;
                bottom: 0;
                width: 3px;
                background: linear-gradient(180deg,#2563eb,#60a5fa);
                opacity: 0;
                transform: scaleY(0.45);
                transform-origin: center;
                transition: opacity 0.25s ease,transform 0.25s ease
            }

        .acc-full-width-panel:hover .acc-panel-header::before {
            opacity: 1;
            transform: scaleY(1)
        }

    .acc-section-heading-icon {
        width: 34px;
        height: 34px;
        flex: 0 0 34px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 10px;
        background: linear-gradient(135deg,#eff6ff,#dbeafe);
        color: #2563eb;
        border: 1px solid #dbeafe;
        font-size: 0.88rem;
        box-shadow: 0 5px 12px -8px rgba(37,99,235,0.45);
        transition: transform 0.25s ease,box-shadow 0.25s ease
    }

    .acc-full-width-panel:hover .acc-section-heading-icon {
        transform: translateY(-1px) rotate(-3deg);
        box-shadow: 0 8px 16px -9px rgba(37,99,235,0.55)
    }

    .acc-section-heading-icon.manager-icon {
        background: linear-gradient(135deg,#ecfeff,#cffafe);
        color: #0891b2;
        border-color: #cffafe
    }

    .voucher-row-animated {
        animation: voucherRowIn 0.45s ease both
    }

    .task-item-card {
        animation: taskItemIn 0.48s ease both
    }

        .task-item-card:nth-child(2) {
            animation-delay: 0.05s
        }

        .task-item-card:nth-child(3) {
            animation-delay: 0.10s
        }

        .task-item-card:nth-child(4) {
            animation-delay: 0.15s
        }

        .task-item-card:nth-child(5) {
            animation-delay: 0.20s
        }

        .task-item-card:nth-child(n+6) {
            animation-delay: 0.24s
        }

    .task-card-icon {
        width: 34px;
        height: 34px;
        flex: 0 0 34px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 9px;
        background: #f1f5f9;
        color: #64748b;
        border: 1px solid #e5eaf0;
        transition: transform 0.22s ease,background 0.22s ease,color 0.22s ease
    }

    .task-item-card:hover .task-card-icon {
        background: #eff6ff;
        color: #2563eb;
        transform: scale(1.06)
    }

    .task-priority-pill {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 0.25rem 0.55rem;
        border-radius: 999px;
        font-size: 0.64rem;
        font-weight: 750;
        background: #f8fafc;
        color: #64748b;
        border: 1px solid #e2e8f0
    }

        .task-priority-pill i {
            font-size: 0.58rem
        }

        .task-priority-pill.priority-high-pill {
            background: #fef2f2;
            color: #dc2626;
            border-color: #fecaca
        }

        .task-priority-pill.priority-medium-pill {
            background: #fffbeb;
            color: #d97706;
            border-color: #fde68a
        }

        .task-priority-pill.priority-low-pill {
            background: #eff6ff;
            color: #2563eb;
            border-color: #bfdbfe
        }

    .bank-card {
        background: linear-gradient(145deg,rgba(255,255,255,0.98),rgba(248,250,252,0.94));
        border: 1px solid var(--glass-border);
        border-radius: 14px;
        padding: 1.1rem 1.15rem;
        box-shadow: 0 5px 18px -10px rgba(15,23,42,0.14);
        transition: transform 0.25s ease,box-shadow 0.25s ease,border-color 0.25s ease;
        height: 100%;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        position: relative;
        overflow: hidden
    }

        .bank-card::before {
            content: "";
            position: absolute;
            width: 100px;
            height: 100px;
            right: -50px;
            top: -50px;
            border-radius: 50%;
            background: rgba(37,99,235,0.05);
            transition: transform 0.3s ease
        }

        .bank-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 16px 28px -15px rgba(15,23,42,0.20);
            border-color: #d5e2f1
        }

            .bank-card:hover::before {
                transform: scale(1.4)
            }

    .bank-icon-box {
        width: 44px;
        height: 44px;
        border-radius: 12px;
        background: linear-gradient(135deg,#1e3a8a 0%,#3b82f6 100%);
        color: #ffffff;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.15rem;
        box-shadow: 0 8px 15px -8px rgba(37,99,235,0.65);
        flex-shrink: 0;
        transition: transform 0.25s ease
    }

    .bank-card:hover .bank-icon-box {
        transform: rotate(-4deg) scale(1.05)
    }

    .bank-balance-box {
        padding: 0.75rem;
        border-radius: 11px;
        background: #f8fafc;
        border: 1px solid #eef2f7
    }

    .btn-xs {
        padding: 0.3rem 0.55rem;
        font-size: 0.70rem;
        line-height: 1.25;
        border-radius: 6px;
        white-space: nowrap
    }

    .btn-outline-purple {
        color: #7c3aed;
        border-color: #c4b5fd
    }

        .btn-outline-purple:hover {
            color: #ffffff;
            background: #7c3aed;
            border-color: #7c3aed
        }

    .hover-primary {
        transition: color 0.18s ease
    }

        .hover-primary:hover {
            color: #2563eb !important
        }

    .line-clamp-2 {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden
    }

    .acc-empty-state {
        padding: 3rem 1.25rem;
        text-align: center;
        color: #94a3b8
    }

    .acc-empty-icon {
        width: 58px;
        height: 58px;
        margin: 0 auto 0.85rem;
        border-radius: 16px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #f1f5f9;
        color: #94a3b8;
        font-size: 1.35rem
    }

    .acc-panel-footer {
        background: #f8fafc;
        border-top: 1px solid #eef2f7
    }

    .accountant-page .modal-content {
        border: 1px solid rgba(226,232,240,0.85);
        border-radius: 18px !important;
        overflow: hidden;
        box-shadow: 0 30px 80px -25px rgba(15,23,42,0.35)
    }

    .accountant-page .modal-header {
        position: relative;
        overflow: hidden
    }

        .accountant-page .modal-header::after {
            content: "";
            position: absolute;
            width: 150px;
            height: 150px;
            right: -55px;
            top: -80px;
            border-radius: 50%;
            background: rgba(255,255,255,0.10);
            pointer-events: none
        }

    .accountant-page .modal-body {
        background: #ffffff
    }

    .accountant-page .modal-footer {
        border-top: 1px solid #eef2f7
    }

    .accountant-page .form-label {
        color: #475569
    }

    .accountant-page .form-control, .accountant-page .form-select, .accountant-page .input-group-text {
        border-color: #dbe3ec;
        border-radius: 9px;
        transition: border-color 0.2s ease,box-shadow 0.2s ease,background 0.2s ease
    }

    .accountant-page .form-control, .accountant-page .form-select {
        min-height: 43px
    }

        .accountant-page .form-control:focus, .accountant-page .form-select:focus {
            border-color: #60a5fa;
            box-shadow: 0 0 0 0.20rem rgba(59,130,246,0.11)
        }

    .preset-chip {
        transition: transform 0.18s ease,box-shadow 0.18s ease
    }

        .preset-chip:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 12px -7px rgba(15,23,42,0.3)
        }

    #voucherDetailsBody .detail-label {
        font-size: 0.68rem;
        text-transform: uppercase;
        letter-spacing: 0.55px;
        color: #94a3b8
    }

    #voucherDetailsBody .detail-value {
        color: #1e293b;
        font-weight: 650
    }

    #voucherDetailsBody .voucher-ledger-box {
        background: linear-gradient(135deg,#f8fafc,#f1f5f9);
        border: 1px solid #e5eaf0
    }

    .accountant-page .form-range {
        accent-color: #2563eb
    }
    @@media

    (max-width:1200px) {
        .acc-kpi-grid

    {
        grid-template-columns: repeat(2,minmax(0,1fr))
    }

    .acc-hub-header {
        padding: 1.5rem
    }

    } @@media

    (max-width:991px) {
        .acc-hub-header

    {
        align-items: flex-start !important
    }

    .acc-header-actions {
        width: 100%
    }

        .acc-header-actions .btn {
            flex: 1 1 auto
        }

    .acc-panel-header {
        align-items: flex-start
    }

    .task-item-card .d-flex {
        min-width: 0
    }

    } @@media

    (max-width:767px) {
        .accountant-page

    {
        padding-bottom: 0.5rem
    }

    .acc-hub-header {
        padding: 1.25rem;
        border-radius: 14px;
        margin-bottom: 1.2rem
    }

    .acc-header-title {
        font-size: 1.25rem
    }

    .acc-header-description {
        font-size: 0.75rem
    }

    .acc-header-actions {
        display: grid !important;
        grid-template-columns: 1fr 1fr;
        gap: 0.55rem !important
    }

        .acc-header-actions .btn {
            width: 100%;
            justify-content: center;
            font-size: 0.74rem;
            padding-left: 0.55rem !important;
            padding-right: 0.55rem !important
        }

    .acc-kpi-grid {
        grid-template-columns: 1fr;
        gap: 0.8rem;
        margin-bottom: 1.2rem
    }

    .acc-kpi-card {

@model IEnumerable<ERP_System.Models.HRAttendanceRegularization>
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Attendance Regularization Requests";
}

<div class="container-fluid py-4 text-start">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3 shadow-sm mb-4" role="alert">
            <i class="fa-solid fa-circle-check me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-bold mb-1"><i class="fa-solid fa-envelope-open-text text-primary me-2"></i>Attendance Regularization Requests</h4>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0 small">
                    <li class="breadcrumb-item"><a href="/EmployeeDashboard" class="text-decoration-none">ESS</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Regularization Requests</li>
                </ol>
            </nav>
        </div>
        <button class="btn btn-primary rounded-pill px-3 btn-sm shadow-sm" data-bs-toggle="modal" data-bs-target="#regularizationModal">
            <i class="fa-solid fa-plus me-1.5"></i>New Request
        </button>
    </div>

    <!-- Requests History Table -->
    <div class="bg-white border rounded-3 p-4 shadow-sm">
        <h5 class="fw-bold mb-3">Regularization Request History</h5>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" style="font-size: 0.85rem;">
                <thead class="table-light">
                    <tr>
                        <th>Correction Date</th>
                        <th>Incorrect Punch</th>
                        <th>Requested Correct Time</th>
                        <th>Reason for Correction</th>
                        <th>Request Date</th>
                        <th>Status</th>
                        <th>HR Remarks</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="fw-bold text-dark">@item.CorrectionDate.ToString("dd MMM yyyy")</td>
                                <td><span class="badge bg-danger-subtle text-danger">@item.IncorrectPunch</span></td>
                                <td class="fw-semibold text-primary">@item.RequestedCorrectTime</td>
                                <td class="text-muted small" style="max-width: 250px;">@item.Reason</td>
                                <td>@item.RequestDate.ToString("dd MMM yyyy")</td>
                                <td>
                                    @if (item.Status == "Approved")
                                    {
                                        <span class="badge bg-success-subtle text-success rounded-pill px-2.5 py-1">Approved</span>
                                    }
                                    else if (item.Status == "Rejected")
                                    {
                                        <span class="badge bg-danger-subtle text-danger rounded-pill px-2.5 py-1">Rejected</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning-subtle text-warning rounded-pill px-2.5 py-1">Pending Review</span>
                                    }
                                </td>
                                <td class="text-muted small">@(string.IsNullOrEmpty(item.AdminRemarks) ? "-" : item.AdminRemarks)</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center py-4 text-muted">No attendance regularization requests submitted yet. Click "New Request" to create one.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Regularization Modal -->
<div class="modal fade text-start" id="regularizationModal" tabindex="-1" aria-labelledby="regularizationModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content rounded-3 border-0 shadow">
            <form action="/ESSAttendance/RequestRegularization" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header bg-light border-bottom px-4 py-3">
                    <h5 class="modal-title fw-bold" id="regularizationModalLabel"><i class="fa-solid fa-pen-to-square text-primary me-2"></i>Request Attendance Correction</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Date of Correction</label>
                        <input type="date" name="Date" class="form-control" value="@DateTime.Today.ToString("yyyy-MM-dd")" required />
                    </div>
                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label small fw-semibold">Actual Check-In Time</label>
                            <input type="time" name="CheckInTime" class="form-control" value="09:00" required />
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-semibold">Actual Check-Out Time</label>
                            <input type="time" name="CheckOutTime" class="form-control" value="18:00" required />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Reason for Correction</label>
                        <textarea name="Reason" class="form-control" rows="3" placeholder="Provide detailed reason (e.g. Card misread, Client meeting offsite)" required></textarea>
                    </div>
                </div>
                <div class="modal-footer bg-light border-top px-4 py-2">
                    <button type="button" class="btn btn-outline-secondary rounded-pill px-3 btn-sm" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary rounded-pill px-4 btn-sm"><i class="fa-solid fa-paper-plane me-1.5"></i>Submit Request to HR</button>
                </div>
            </form>
        </div>
    </div>
</div>

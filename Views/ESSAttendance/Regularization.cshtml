@model IEnumerable<ERP_System.Models.ESSPunch>
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Attendance Regularization Requests";
}

<div class="container-fluid py-4 text-start">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-bold mb-1"><i class="fa-solid fa-envelope-open-text text-primary me-2"></i>Attendance Regularization Requests</h4>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0 small">
                    <li class="breadcrumb-item"><a href="/EmployeeDashboard" class="text-decoration-none">ESS</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Regularization Requests</li>
                </ol>
            </nav>
        </div>
        <button class="btn btn-primary rounded-pill px-3 btn-sm shadow-sm" data-bs-toggle="modal" data-bs-target="#regularizationModal">
            <i class="fa-solid fa-plus me-1.5"></i>New Request
        </button>
    </div>

    <!-- Requests History Table -->
    <div class="bg-white border rounded-3 p-4 shadow-sm">
        <h5 class="fw-bold mb-3">Regularization History</h5>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" style="font-size: 0.85rem;">
                <thead class="table-light">
                    <tr>
                        <th>Date</th>
                        <th>Adjusted Check-In</th>
                        <th>Adjusted Check-Out</th>
                        <th>Status / Source</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var log in Model)
                        {
                            <tr>
                                <td class="fw-bold text-dark">@log.Date.ToString("dd MMM yyyy")</td>
                                <td class="text-success">@(log.CheckInTime.HasValue ? log.CheckInTime.Value.ToString("hh:mm tt") : "-")</td>
                                <td class="text-danger">@(log.CheckOutTime.HasValue ? log.CheckOutTime.Value.ToString("hh:mm tt") : "-")</td>
                                <td>
                                    @if (log.PunchSource == "Regularized" || log.PunchSource == "Regularization Request")
                                    {
                                        <span class="badge bg-success-subtle text-success">Regularized</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary">@log.PunchSource</span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4" class="text-center py-4 text-muted">No regularization records found.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Regularization Modal -->
<div class="modal fade text-start" id="regularizationModal" tabindex="-1" aria-labelledby="regularizationModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form action="/ESSAttendance/RequestRegularization" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title fw-bold" id="regularizationModalLabel">Request Attendance Correction</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Date of Correction</label>
                        <input type="date" name="Date" class="form-control" value="@DateTime.Today.ToString("yyyy-MM-dd")" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Actual Check-In Time</label>
                        <input type="time" name="CheckInTime" class="form-control" value="09:00" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Actual Check-Out Time</label>
                        <input type="time" name="CheckOutTime" class="form-control" value="18:00" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Reason for Correction</label>
                        <textarea name="Reason" class="form-control" rows="3" placeholder="e.g. Forgot card / Client visit" required></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary rounded-pill px-3 btn-sm" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary rounded-pill px-3 btn-sm">Submit Request</button>
                </div>
            </form>
        </div>
    </div>
</div>

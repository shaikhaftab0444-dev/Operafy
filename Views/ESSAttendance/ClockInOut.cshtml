@model IEnumerable<ERP_System.Models.ESSPunch>

@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Web Clock-In / Clock-Out";

    var todayPunch = ViewBag.TodayPunch as ERP_System.Models.ESSPunch;
    var isWindowOpen = (ViewBag.IsWindowOpen as bool?) ?? true;
    var windowMessage = ViewBag.WindowMessage as string ?? "";
    var userShift = ViewBag.UserShift as ERP_System.Models.WorkShift;
}

<style>
    /* =========================================================
           WEB CLOCK — PREMIUM ESS ATTENDANCE UI
           ========================================================= */

    .clock-page {
        --clock-primary: #2563eb;
        --clock-primary-dark: #1d4ed8;
        --clock-success: #16a34a;
        --clock-danger: #dc2626;
        --clock-warning: #d97706;
        --clock-text: #172033;
        --clock-muted: #7b8494;
        --clock-border: #e7ebf1;
        --clock-surface: #ffffff;
        --clock-soft: #f7f9fc;
        --clock-shadow: 0 14px 38px rgba(15, 23, 42, .07);
    }

    /* ================= PAGE ================= */

    .clock-page-shell {
        position: relative;
        padding: 1.3rem 0 2.2rem;
        animation: clockPageIn .55s ease both;
    }

        .clock-page-shell::before {
            content: "";
            position: absolute;
            width: 300px;
            height: 300px;
            top: -100px;
            right: 4%;
            border-radius: 50%;
            background: rgba(37, 99, 235, .035);
            filter: blur(2px);
            pointer-events: none;
        }

    @@keyframes clockPageIn {
        from

    {
        opacity: 0;
        transform: translateY(10px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }

    }

    /* ================= HEADER ================= */

    .clock-header {
        position: relative;
        z-index: 2;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 1.5rem;
        margin-bottom: 1.25rem;
    }

    .clock-heading {
        min-width: 0;
    }

    .clock-breadcrumb {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: .5rem;
        margin-bottom: .6rem;
        font-size: .75rem;
        font-weight: 600;
    }

        .clock-breadcrumb a {
            color: #7b8494;
            text-decoration: none;
            transition: color .2s ease;
        }

            .clock-breadcrumb a:hover {
                color: var(--clock-primary);
            }

        .clock-breadcrumb .divider {
            color: #c1c7d0;
        }

        .clock-breadcrumb .active {
            color: #475467;
        }

    .clock-title-row {
        display: flex;
        align-items: center;
        gap: .8rem;
    }

    .clock-title-icon {
        width: 48px;
        height: 48px;
        flex: 0 0 48px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 14px;
        background: linear-gradient(135deg, #2563eb, #4f7ff0);
        color: #fff;
        font-size: 1.1rem;
        box-shadow: 0 10px 24px rgba(37, 99, 235, .2);
        animation: clockIconFloat 4s ease-in-out infinite;
    }

    @@keyframes clockIconFloat {
        0%, 100%

    {
        transform: translateY(0);
    }

    50% {
        transform: translateY(-3px);
    }

    }

    .clock-title {
        margin: 0;
        color: #182235;
        font-size: clamp(1.35rem, 2vw, 1.7rem);
        font-weight: 800;
        letter-spacing: -.025em;
    }

    .clock-subtitle {
        margin: .32rem 0 0;
        color: var(--clock-muted);
        font-size: .8rem;
        line-height: 1.5;
    }

    /* ================= SHIFT BADGE ================= */

    .shift-badge {
        display: inline-flex;
        align-items: center;
        gap: .45rem;
        padding: .65rem .9rem;
        color: #2563eb;
        background: #eff6ff;
        border: 1px solid #d8e7ff;
        border-radius: 12px;
        font-size: .76rem;
        font-weight: 700;
        white-space: nowrap;
        box-shadow: 0 5px 15px rgba(37, 99, 235, .05);
    }

        .shift-badge i {
            font-size: .9rem;
        }

        .shift-badge strong {
            font-weight: 800;
            color: #1d4ed8;
        }

    /* ================= ALERTS ================= */

    .clock-alert {
        position: relative;
        display: flex;
        align-items: center;
        gap: .75rem;
        padding: .85rem 1rem;
        margin-bottom: 1rem;
        border-radius: 12px;
        border: 1px solid transparent;
        box-shadow: 0 7px 20px rgba(15, 23, 42, .045);
        animation: alertIn .45s ease both;
    }

    @@keyframes alertIn {
        from

    {
        opacity: 0;
        transform: translateY(-5px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }

    }

    .clock-alert-icon {
        width: 34px;
        height: 34px;
        flex: 0 0 34px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 9px;
        font-size: .9rem;
    }

    .clock-alert-danger {
        color: #991b1b;
        background: #fff7f7;
        border-color: #f7d4d4;
    }

        .clock-alert-danger .clock-alert-icon {
            background: #fee2e2;
            color: #dc2626;
        }

    .clock-alert-success {
        color: #166534;
        background: #f5fff8;
        border-color: #d3f1dd;
    }

        .clock-alert-success .clock-alert-icon {
            background: #dcfce7;
            color: #16a34a;
        }

    .clock-alert-content {
        flex: 1;
        min-width: 0;
        font-size: .78rem;
        font-weight: 600;
    }

    .clock-alert .btn-close {
        position: static;
        margin-left: auto;
        flex: 0 0 auto;
    }

    /* ================= MAIN GRID ================= */

    .clock-main-grid {
        position: relative;
        z-index: 1;
    }

    /* ================= STATUS CARD ================= */

    .clock-status-card {
        position: relative;
        height: 100%;
        overflow: hidden;
        padding: 1.4rem;
        background: #fff;
        border: 1px solid var(--clock-border);
        border-radius: 18px;
        box-shadow: var(--clock-shadow);
        animation: cardUp .6s ease .05s both;
    }

        .clock-status-card::before {
            content: "";
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 3px;
            background: linear-gradient(90deg, #2563eb, #60a5fa);
        }

        .clock-status-card::after {
            content: "";
            position: absolute;
            width: 150px;
            height: 150px;
            right: -75px;
            top: -75px;
            border-radius: 50%;
            background: rgba(37, 99, 235, .035);
            pointer-events: none;
        }

    @@keyframes cardUp {
        from

    {
        opacity: 0;
        transform: translateY(12px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }

    }

    .clock-card-label {
        position: relative;
        z-index: 1;
        margin-bottom: .75rem;
        color: #8a94a6;
        font-size: .68rem;
        font-weight: 800;
        letter-spacing: .08em;
        text-transform: uppercase;
    }

    .clock-status-icon-wrap {
        width: 68px;
        height: 68px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: .4rem auto .95rem;
        border-radius: 20px;
        background: #f4f7fb;
        border: 1px solid #e7ecf3;
        animation: statusPulse 3.5s ease-in-out infinite;
    }

    @@keyframes statusPulse {
        0%, 100%

    {
        transform: scale(1);
        box-shadow: 0 0 0 0 rgba(37, 99, 235, 0);
    }

    50% {
        transform: scale(1.025);
        box-shadow: 0 8px 24px rgba(37, 99, 235, .07);
    }

    }

    .clock-status-icon-wrap i {
        font-size: 1.5rem;
        color: #64748b;
    }

    .clock-status-card.is-not-clocked .clock-status-icon-wrap {
        background: #fff7f7;
        border-color: #f5dcdc;
    }

        .clock-status-card.is-not-clocked .clock-status-icon-wrap i {
            color: #dc2626;
        }

    .clock-status-card.is-clocked .clock-status-icon-wrap {
        background: #f0fdf4;
        border-color: #d1f1dc;
    }

        .clock-status-card.is-clocked .clock-status-icon-wrap i {
            color: #16a34a;
        }

    .clock-status-card.is-completed .clock-status-icon-wrap {
        background: #f5f7fa;
        border-color: #e5e9ef;
    }

        .clock-status-card.is-completed .clock-status-icon-wrap i {
            color: #64748b;
        }

    .clock-status-heading {
        margin: 0;
        font-size: 1.25rem;
        font-weight: 800;
        letter-spacing: -.015em;
    }

        .clock-status-heading.not-clocked {
            color: #dc2626;
        }

        .clock-status-heading.clocked {
            color: #15803d;
        }

        .clock-status-heading.completed {
            color: #475569;
        }

    .clock-status-info {
        margin: .35rem 0 1.15rem;
        color: #8a94a6;
        font-size: .75rem;
        line-height: 1.5;
    }

    /* ================= WINDOW MESSAGE ================= */

    .clock-window-alert {
        display: flex;
        align-items: flex-start;
        gap: .7rem;
        margin-bottom: .85rem;
        padding: .75rem;
        text-align: left;
        background: #fffbeb;
        border: 1px solid #f5e4b5;
        border-radius: 11px;
        color: #8a5a00;
        animation: softReveal .4s ease both;
    }

    @@keyframes softReveal {
        from

    {
        opacity: 0;
        transform: translateY(5px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }

    }

    .clock-window-icon {
        width: 32px;
        height: 32px;
        flex: 0 0 32px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 8px;
        background: #fef3c7;
        color: #d97706;
    }

    .clock-window-text {
        font-size: .72rem;
        line-height: 1.45;
    }

        .clock-window-text strong {
            display: block;
            margin-bottom: .1rem;
            color: #9a6500;
        }

    /* ================= CLOCK BUTTONS ================= */

    .clock-action-btn {
        position: relative;
        width: 100%;
        min-height: 50px;
        overflow: hidden;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: .5rem;
        border: 0;
        border-radius: 12px;
        font-size: .8rem;
        font-weight: 800;
        transition: transform .2s ease, box-shadow .2s ease, background-color .2s ease;
    }

        .clock-action-btn::after {
            content: "";
            position: absolute;
            width: 70px;
            height: 70px;
            top: 50%;
            left: -80px;
            border-radius: 50%;
            background: rgba(255,255,255,.14);
            transform: translateY(-50%);
            transition: left .45s ease;
        }

        .clock-action-btn:hover::after {
            left: calc(100% + 10px);
        }

        .clock-action-btn:hover:not(:disabled) {
            transform: translateY(-2px);
        }

        .clock-action-btn:active:not(:disabled) {
            transform: translateY(0);
        }

    .clock-in-btn {
        color: #fff;
        background: linear-gradient(135deg, #16a34a, #22c55e);
        box-shadow: 0 9px 20px rgba(22, 163, 74, .18);
    }

        .clock-in-btn:hover:not(:disabled) {
            color: #fff;
            box-shadow: 0 13px 25px rgba(22, 163, 74, .24);
        }

    .clock-out-btn {
        color: #fff;
        background: linear-gradient(135deg, #dc2626, #ef4444);
        box-shadow: 0 9px 20px rgba(220, 38, 38, .16);
    }

        .clock-out-btn:hover:not(:disabled) {
            color: #fff;
            box-shadow: 0 13px 25px rgba(220, 38, 38, .23);
        }

    .clock-disabled-btn {
        color: #667085;
        background: #eef1f5;
        border: 1px solid #e0e5eb;
        box-shadow: none;
    }

        .clock-disabled-btn:hover {
            color: #667085;
            background: #e9edf2;
        }

    /* ================= STATUS FOOTNOTE ================= */

    .clock-status-footnote {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: .4rem;
        margin-top: .85rem;
        color: #a0a8b6;
        font-size: .65rem;
    }

        .clock-status-footnote i {
            color: #94a3b8;
        }

    /* ================= LOG CARD ================= */

    .clock-log-card {
        position: relative;
        height: 100%;
        overflow: hidden;
        background: #fff;
        border: 1px solid var(--clock-border);
        border-radius: 18px;
        box-shadow: var(--clock-shadow);
        animation: cardUp .6s ease .12s both;
    }

    .clock-log-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        padding: 1rem 1.15rem;
        border-bottom: 1px solid #edf0f4;
        background: linear-gradient(180deg, #fff, #fbfcfe);
    }

    .clock-log-heading {
        display: flex;
        align-items: center;
        gap: .65rem;
    }

    .clock-log-icon {
        width: 37px;
        height: 37px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        flex: 0 0 37px;
        border-radius: 10px;
        background: #eff6ff;
        color: #2563eb;
    }

    .clock-log-title {
        margin: 0;
        color: #1f2937;
        font-size: .9rem;
        font-weight: 800;
    }

    .clock-log-subtitle {
        margin: .15rem 0 0;
        color: #98a2b3;
        font-size: .67rem;
    }

    .clock-live-badge {
        display: inline-flex;
        align-items: center;
        gap: .35rem;
        padding: .38rem .58rem;
        color: #16803c;
        background: #f0fdf4;
        border: 1px solid #d2f1dc;
        border-radius: 999px;
        font-size: .63rem;
        font-weight: 800;
        white-space: nowrap;
    }

    .clock-live-dot {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: #22c55e;
        animation: liveDot 1.8s ease-in-out infinite;
    }

    @@keyframes liveDot {
        0%, 100%

    {
        opacity: 1;
        box-shadow: 0 0 0 0 rgba(34, 197, 94, .2);
    }

    50% {
        opacity: .55;
        box-shadow: 0 0 0 4px rgba(34, 197, 94, .08);
    }

    }

    /* ================= LOG TABLE ================= */

    .clock-log-body {
        padding: 0;
    }

    .clock-table-wrapper {
        width: 100%;
        overflow-x: auto;
        overflow-y: hidden;
        -webkit-overflow-scrolling: touch;
    }

        .clock-table-wrapper::-webkit-scrollbar {
            height: 7px;
        }

        .clock-table-wrapper::-webkit-scrollbar-track {
            background: #f4f6f8;
        }

        .clock-table-wrapper::-webkit-scrollbar-thumb {
            background: #cbd3df;
            border-radius: 20px;
        }

    .clock-table {
        width: 100%;
        min-width: 650px;
        margin: 0;
        border-collapse: separate;
        border-spacing: 0;
        font-size: .76rem;
    }

        .clock-table thead th {
            padding: .78rem .75rem;
            color: #7b8494;
            background: #f8fafc;
            border-bottom: 1px solid #e8edf3;
            font-size: .64rem;
            font-weight: 800;
            letter-spacing: .055em;
            text-transform: uppercase;
            white-space: nowrap;
        }

            .clock-table thead th:first-child {
                padding-left: 1.15rem;
            }

        .clock-table tbody tr {
            animation: tableRowIn .4s ease both;
            transition: background-color .2s ease;
        }

            .clock-table tbody tr:hover {
                background: #fbfdff;
            }

    @@keyframes tableRowIn {
        from

    {
        opacity: 0;
        transform: translateY(5px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }

    }

    .clock-table tbody td {
        padding: .8rem .75rem;
        color: #596579;
        border-bottom: 1px solid #eef1f5;
        vertical-align: middle;
        white-space: nowrap;
    }

    .clock-table tbody tr:last-child td {
        border-bottom: 0;
    }

    .clock-table tbody td:first-child {
        padding-left: 1.15rem;
    }

    .clock-date {
        display: inline-flex;
        align-items: center;
        gap: .45rem;
        color: #344054;
        font-weight: 800;
    }

    .clock-date-icon {
        width: 29px;
        height: 29px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 8px;
        background: #f4f7fb;
        color: #64748b;
        font-size: .68rem;
    }

    .clock-time {
        display: inline-flex;
        align-items: center;
        gap: .35rem;
        font-weight: 700;
    }

    .clock-in-time {
        color: #15803d;
    }

    .clock-out-time {
        color: #dc2626;
    }

    .clock-time-icon {
        font-size: .62rem;
        opacity: .8;
    }

    .clock-source-badge {
        display: inline-flex;
        align-items: center;
        gap: .35rem;
        padding: .4rem .58rem;
        color: #667085;
        background: #f4f6f8;
        border: 1px solid #e6e9ee;
        border-radius: 8px;
        font-size: .64rem;
        font-weight: 700;
    }

        .clock-source-badge i {
            font-size: .6rem;
        }

    /* ================= EMPTY STATE ================= */

    .clock-empty-state {
        padding: 3.2rem 1.5rem;
        text-align: center;
    }

    .clock-empty-icon {
        width: 60px;
        height: 60px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        margin-bottom: .85rem;
        border-radius: 17px;
        background: #f5f7fa;
        border: 1px solid #e8ecf1;
        color: #98a2b3;
        font-size: 1.35rem;
        animation: emptyFloat 3.5s ease-in-out infinite;
    }

    @@keyframes emptyFloat {
        0%, 100%

    {
        transform: translateY(0);
    }

    50% {
        transform: translateY(-4px);
    }

    }

    .clock-empty-title {
        margin: 0 0 .3rem;
        color: #475467;
        font-size: .84rem;
        font-weight: 800;
    }

    .clock-empty-text {
        margin: 0;
        color: #98a2b3;
        font-size: .7rem;
    }

    /* ================= FOOTER ================= */

    .clock-log-footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        padding: .68rem 1.15rem;
        background: #fbfcfe;
        border-top: 1px solid #edf0f4;
    }

    .clock-footer-note {
        display: inline-flex;
        align-items: center;
        gap: .38rem;
        color: #98a2b3;
        font-size: .63rem;
    }

        .clock-footer-note i {
            color: #94a3b8;
        }

    /* ================= RESPONSIVE ================= */

    @@media (max-width: 991px) {
        .clock-header

    {
        align-items: flex-start;
        flex-direction: column;
    }

    .shift-badge {
        align-self: flex-start;
    }

    }

    @@media (max-width: 767px) {
        .clock-page-shell

    {
        padding-top: 1rem;
    }

    .clock-title-icon {
        width: 43px;
        height: 43px;
        flex-basis: 43px;
        border-radius: 12px;
    }

    .clock-title {
        font-size: 1.25rem;
    }

    .clock-subtitle {
        font-size: .75rem;
    }

    .clock-status-card,
    .clock-log-card {
        border-radius: 14px;
    }

    .clock-status-card {
        padding: 1.15rem;
    }

    .clock-log-header {
        align-items: flex-start;
        flex-direction: column;
        padding: .9rem;
    }

    .clock-live-badge {
        align-self: flex-start;
    }

    .clock-log-footer {
        align-items: flex-start;
        flex-direction: column;
        padding: .7rem .9rem;
    }

    }

    @@media (max-width: 480px) {
        .clock-title-row

    {
        align-items: flex-start;
    }

    .clock-title-icon {
        width: 39px;
        height: 39px;
        flex-basis: 39px;
        font-size: .9rem;
    }

    .clock-title {
        font-size: 1.15rem;
    }

    .clock-breadcrumb {
        font-size: .7rem;
    }

    .shift-badge {
        width: 100%;
        justify-content: center;
        white-space: normal;
        text-align: center;
    }

    .clock-alert {
        align-items: flex-start;
    }

    .clock-status-icon-wrap {
        width: 60px;
        height: 60px;
    }

    .clock-status-heading {
        font-size: 1.1rem;
    }

    .clock-action-btn {
        min-height: 47px;
    }

    .clock-table {
        min-width: 610px;
    }

    .clock-empty-state {
        padding: 2.7rem 1rem;
    }

    }

    /* ================= REDUCED MOTION ================= */

    @@media (prefers-reduced-motion: reduce) {
        .clock-page-shell, .clock-alert, .clock-status-card, .clock-log-card, .clock-table tbody tr, .clock-title-icon, .clock-status-icon-wrap, .clock-empty-icon, .clock-live-dot

    {
        animation: none !important;
    }

    .clock-action-btn,
    .clock-breadcrumb a {
        transition: none !important;
    }

    }
</style>


<div class="container-fluid text-start clock-page">
    <div class="clock-page-shell">

        <!-- =====================================================
             PAGE HEADER
             ===================================================== -->

        <div class="clock-header">

            <div class="clock-heading">

                <div class="clock-breadcrumb">
                    <a href="/EmployeeDashboard">
                        <i class="fa-solid fa-house me-1"></i>
                        ESS
                    </a>

                    <span class="divider">/</span>

                    <span class="active">
                        Web Clock
                    </span>
                </div>

                <div class="clock-title-row">

                    <div class="clock-title-icon">
                        <i class="fa-solid fa-business-time"></i>
                    </div>

                    <div>
                        <h4 class="clock-title">
                            Web Clock-In / Clock-Out
                        </h4>

                        <p class="clock-subtitle">
                            Manage your daily attendance and review recent punch activity.
                        </p>
                    </div>

                </div>

            </div>


            @if (userShift != null)
            {
                <div class="shift-badge">
                    <i class="fa-regular fa-clock"></i>
                    <span>Assigned Shift:</span>
                    <strong>@userShift.ShiftName</strong>
                </div>
            }

        </div>


        <!-- =====================================================
             TEMP DATA ALERTS
             ===================================================== -->
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="clock-alert clock-alert-danger alert-dismissible fade show"
                 role="alert">

                <div class="clock-alert-icon">
                    <i class="fa-solid fa-circle-exclamation"></i>
                </div>

                <div class="clock-alert-content">
                    @TempData["ErrorMessage"]
                </div>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="alert"
                        aria-label="Close"></button>

            </div>
        }


        @if (TempData["SuccessMessage"] != null)
        {
            <div class="clock-alert clock-alert-success alert-dismissible fade show"
                 role="alert">

                <div class="clock-alert-icon">
                    <i class="fa-solid fa-circle-check"></i>
                </div>

                <div class="clock-alert-content">
                    @TempData["SuccessMessage"]
                </div>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="alert"
                        aria-label="Close"></button>

            </div>
        }


        <!-- =====================================================
             MAIN ATTENDANCE AREA
             ===================================================== -->

        <div class="row g-4 clock-main-grid">

            <!-- =================================================
                 CURRENT STATUS
                 ================================================= -->

            <div class="col-xl-4 col-lg-5">

                @if (todayPunch == null)
                {
                    <div class="clock-status-card is-not-clocked text-center">

                        <div class="clock-card-label">
                            Today's Attendance
                        </div>

                        <div class="clock-status-icon-wrap">
                            <i class="fa-solid fa-right-to-bracket"></i>
                        </div>

                        <h3 class="clock-status-heading not-clocked">
                            Not Clocked In
                        </h3>

                        <p class="clock-status-info">
                            Your attendance has not been started for today.
                        </p>


                        @if (!isWindowOpen)
                        {
                            <div class="clock-window-alert">

                                <div class="clock-window-icon">
                                    <i class="fa-solid fa-triangle-exclamation"></i>
                                </div>

                                <div class="clock-window-text">

                                    <strong>
                                        Shift Window Inactive
                                    </strong>

                                    @windowMessage

                                </div>

                            </div>


                            <button type="button"
                                    id="btnClockIn"
                                    class="clock-action-btn clock-disabled-btn"
                                    disabled
                                    title="Punching outside shift window is not allowed">

                                <i class="fa-solid fa-ban"></i>
                                <span>Clock In — Shift Inactive</span>

                            </button>
                        }
                        else
                        {
                            <form action="/ESSAttendance/CheckIn"
                                  method="post">

                                @Html.AntiForgeryToken()

                                <button type="submit"
                                        id="btnClockIn"
                                        class="clock-action-btn clock-in-btn">

                                    <i class="fa-solid fa-right-to-bracket"></i>
                                    <span>Clock In</span>

                                </button>

                            </form>
                        }


                        <div class="clock-status-footnote">
                            <i class="fa-solid fa-shield-halved"></i>
                            Attendance recorded securely
                        </div>

                    </div>
                }

                else if (todayPunch.CheckOutTime == null)
                {
                    <div class="clock-status-card is-clocked text-center">

                        <div class="clock-card-label">
                            Today's Attendance
                        </div>

                        <div class="clock-status-icon-wrap">
                            <i class="fa-solid fa-person-walking-arrow-right"></i>
                        </div>

                        <h3 class="clock-status-heading clocked">
                            Clocked In
                        </h3>

                        <p class="clock-status-info">
                            Since
                            @todayPunch.CheckInTime.Value.ToString("hh:mm tt")
                        </p>


                        <form action="/ESSAttendance/CheckOut"
                              method="post">

                            @Html.AntiForgeryToken()

                            <button type="submit"
                                    id="btnClockOut"
                                    class="clock-action-btn clock-out-btn">

                                <i class="fa-solid fa-right-from-bracket"></i>
                                <span>Clock Out</span>

                            </button>

                        </form>


                        <div class="clock-status-footnote">
                            <i class="fa-solid fa-circle-check"></i>
                            Your attendance session is active
                        </div>

                    </div>
                }

                else
                {
                    <div class="clock-status-card is-completed text-center">

                        <div class="clock-card-label">
                            Today's Attendance
                        </div>

                        <div class="clock-status-icon-wrap">
                            <i class="fa-solid fa-circle-check"></i>
                        </div>

                        <h3 class="clock-status-heading completed">
                            Shift Completed
                        </h3>

                        <p class="clock-status-info">
                            In:
                            @todayPunch.CheckInTime.Value.ToString("hh:mm tt")
                            <span class="mx-1">•</span>
                            Out:
                            @todayPunch.CheckOutTime.Value.ToString("hh:mm tt")
                        </p>


                        <button class="clock-action-btn clock-disabled-btn"
                                disabled>

                            <i class="fa-solid fa-lock"></i>
                            <span>Completed</span>

                        </button>


                        <div class="clock-status-footnote">
                            <i class="fa-solid fa-circle-check"></i>
                            Today's attendance is complete
                        </div>

                    </div>
                }

            </div>


            <!-- =================================================
                 RECENT ATTENDANCE LOGS
                 ================================================= -->

            <div class="col-xl-8 col-lg-7">

                <div class="clock-log-card">

                    <div class="clock-log-header">

                        <div class="clock-log-heading">

                            <div class="clock-log-icon">
                                <i class="fa-solid fa-clock-rotate-left"></i>
                            </div>

                            <div>
                                <h5 class="clock-log-title">
                                    Recent Attendance Logs
                                </h5>

                                <p class="clock-log-subtitle">
                                    Your latest clock-in and clock-out activity
                                </p>
                            </div>

                        </div>


                        <div class="clock-live-badge">
                            <span class="clock-live-dot"></span>
                            Attendance History
                        </div>

                    </div>


                    <div class="clock-log-body">

                        <div class="clock-table-wrapper">

                            <table class="clock-table align-middle">

                                <thead>
                                    <tr>
                                        <th>Date</th>
                                        <th>Clock In</th>
                                        <th>Clock Out</th>
                                        <th>Source</th>
                                    </tr>
                                </thead>

                                <tbody>

                                    @if (Model != null && Model.Any())
                                    {
                                        @foreach (var log in Model)
                                        {
                                            <tr>

                                                <!-- DATE -->
                                                <td>

                                                    <div class="clock-date">

                                                        <span class="clock-date-icon">
                                                            <i class="fa-regular fa-calendar"></i>
                                                        </span>

                                                        <span>
                                                            @log.Date.ToString("dd MMM yyyy")
                                                        </span>

                                                    </div>

                                                </td>


                                                <!-- CLOCK IN -->
                                                <td>

                                                    <span class="clock-time clock-in-time">

                                                        <i class="fa-solid fa-arrow-right-to-bracket clock-time-icon"></i>

                                                        @(log.CheckInTime.HasValue
                                                                                                        ? log.CheckInTime.Value.ToString("hh:mm tt")
                                                                                                        : "-")

                                                    </span>

                                                </td>


                                                <!-- CLOCK OUT -->
                                                <td>

                                                    <span class="clock-time clock-out-time">

                                                        <i class="fa-solid fa-arrow-right-from-bracket clock-time-icon"></i>

                                                        @(log.CheckOutTime.HasValue
                                                                                                        ? log.CheckOutTime.Value.ToString("hh:mm tt")
                                                                                                        : "-")

                                            </span>

                                                </td>


                                                <!-- SOURCE -->
                                                <td>

                                                    <span class="clock-source-badge">

                                                        <i class="fa-solid fa-location-dot"></i>

                                                        @log.PunchSource

                                                    </span>

                                                </td>

                                            </tr>
                                                                        }
                                    }
                                    else
                                    {
                                        <tr>

                                            <td colspan="4">

                                                <div class="clock-empty-state">

                                                    <div class="clock-empty-icon">
                                                        <i class="fa-solid fa-calendar-xmark"></i>
                                                    </div>

                                                    <h6 class="clock-empty-title">
                                                        No Attendance Logs Found
                                                    </h6>

                                                    <p class="clock-empty-text">
                                                        No attendance logs found in database.
                                                    </p>

                                                </div>

                                            </td>

                                        </tr>
                                    }

                                </tbody>

                            </table>

                        </div>

                    </div>


                    <div class="clock-log-footer">

                        <div class="clock-footer-note">
                            <i class="fa-solid fa-circle-info"></i>
                            <span>Recent attendance activity</span>
                        </div>

                        <div class="clock-footer-note">
                            <i class="fa-solid fa-shield-halved"></i>
                            <span>Secure attendance record</span>
                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>
</div>
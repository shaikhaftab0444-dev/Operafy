@model IEnumerable<ERP_System.Models.ESSPunch>
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Web Clock-In / Clock-Out";
    var todayPunch = ViewBag.TodayPunch as ERP_System.Models.ESSPunch;
}

<div class="container-fluid py-4 text-start">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-bold mb-1"><i class="fa-solid fa-business-time text-primary me-2"></i>Web Clock-In / Clock-Out</h4>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0 small">
                    <li class="breadcrumb-item"><a href="/EmployeeDashboard" class="text-decoration-none">ESS</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Web Clock</li>
                </ol>
            </nav>
        </div>
    </div>

    <div class="row g-4 mb-4">
        <!-- Punch Card -->
        <div class="col-md-5">
            <div class="bg-white border rounded-3 p-4 shadow-sm text-center">
                <h5 class="fw-bold text-muted mb-2">Current Status</h5>
                @if (todayPunch == null)
                {
                    <h3 class="text-danger fw-bold mb-4">Not Clocked In</h3>
                    <form action="/ESSAttendance/CheckIn" method="post">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-success btn-lg rounded-pill px-5 shadow-sm w-100 mb-2">
                            <i class="fa-solid fa-right-to-bracket me-2"></i>Clock In
                        </button>
                    </form>
                }
                else if (todayPunch.CheckOutTime == null)
                {
                    <h3 class="text-success fw-bold mb-1">Clocked In</h3>
                    <p class="text-muted small mb-4">Since @todayPunch.CheckInTime.Value.ToString("hh:mm tt")</p>
                    <form action="/ESSAttendance/CheckOut" method="post">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-danger btn-lg rounded-pill px-5 shadow-sm w-100 mb-2">
                            <i class="fa-solid fa-right-from-bracket me-2"></i>Clock Out
                        </button>
                    </form>
                }
                else
                {
                    <h3 class="text-secondary fw-bold mb-1">Shift Completed</h3>
                    <p class="text-muted small mb-4">
                        In: @todayPunch.CheckInTime.Value.ToString("hh:mm tt") | Out: @todayPunch.CheckOutTime.Value.ToString("hh:mm tt")
                    </p>
                    <button class="btn btn-secondary btn-lg rounded-pill px-5 w-100 mb-2" disabled>
                        <i class="fa-solid fa-lock me-2"></i>Completed
                    </button>
                }
            </div>
        </div>

        <!-- Punch Logs -->
        <div class="col-md-7">
            <div class="bg-white border rounded-3 p-4 shadow-sm h-100">
                <h5 class="fw-bold mb-3"><i class="fa-solid fa-history text-primary me-2"></i>Recent Attendance Logs</h5>
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0" style="font-size: 0.85rem;">
                        <thead class="table-light">
                            <tr>
                                <th>Date</th>
                                <th>Clock In</th>
                                <th>Clock Out</th>
                                <th>Source</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model != null && Model.Any())
                            {
                                @foreach (var log in Model)
                                {
                                    <tr>
                                        <td class="fw-bold text-dark">@log.Date.ToString("dd MMM yyyy")</td>
                                        <td class="text-success">@(log.CheckInTime.HasValue ? log.CheckInTime.Value.ToString("hh:mm tt") : "-")</td>
                                        <td class="text-danger">@(log.CheckOutTime.HasValue ? log.CheckOutTime.Value.ToString("hh:mm tt") : "-")</td>
                                        <td><span class="badge bg-secondary-subtle text-secondary">@log.PunchSource</span></td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="4" class="text-center py-4 text-muted">No attendance logs found in database.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

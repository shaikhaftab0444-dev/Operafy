@model IEnumerable<ERP_System.Models.ESSPunch>

@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "My Monthly Attendance Calendar";

    var today = DateTime.Today;
    var year = today.Year;
    var month = today.Month;

    var firstDayOfMonth = new DateTime(year, month, 1);
    var daysInMonth = DateTime.DaysInMonth(year, month);
    var startDayOfWeek = (int)firstDayOfMonth.DayOfWeek;

    var punches = Model?
        .Where(p => p.Date.Year == year && p.Date.Month == month)
        .ToList()
        ?? new List<ERP_System.Models.ESSPunch>();

    var workingDays = 0;
    var presentDays = 0;
    var absentDays = 0;
    var weekendDays = 0;
    var upcomingDays = 0;

    for (int d = 1; d <= daysInMonth; d++)
    {
        var date = new DateTime(year, month, d);

        var isWeekend =
            date.DayOfWeek == DayOfWeek.Saturday ||
            date.DayOfWeek == DayOfWeek.Sunday;

        if (isWeekend)
        {
            weekendDays++;
        }
        else
        {
            workingDays++;

            var hasPunch = punches.Any(p => p.Date.Date == date.Date);

            if (hasPunch)
            {
                presentDays++;
            }
            else if (date < today)
            {
                absentDays++;
            }
            else
            {
                upcomingDays++;
            }
        }
    }

    var attendancePercentage =
        workingDays > 0
            ? Math.Round((decimal)presentDays / workingDays * 100, 1)
            : 0;

    var totalGridSlots = startDayOfWeek + daysInMonth;
    var remainingSlots = (7 - (totalGridSlots % 7)) % 7;

    var monthName = today.ToString("MMMM");
    var shortMonth = today.ToString("MMM");
}

<style>

    /* =========================================================
           ATTENDANCE CALENDAR - PREMIUM UI
           ========================================================= */

    .attendance-page {
        animation: pageFadeIn .65s ease both;
    }

    @@keyframes pageFadeIn {
        from {
            opacity: 0;
            transform: translateY(15px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* Header */

    .attendance-title {
        font-size: 1.55rem;
        font-weight: 800;
        letter-spacing: -0.5px;
        color: #182230;
    }

    .attendance-title-icon {
        width: 44px;
        height: 44px;
        border-radius: 13px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(135deg, #2563eb, #4f46e5);
        color: #fff;
        box-shadow: 0 8px 20px rgba(37, 99, 235, .25);
        margin-right: 10px;
    }

    .breadcrumb-modern .breadcrumb-item {
        font-size: .78rem;
    }

        .breadcrumb-modern .breadcrumb-item a {
            color: #2563eb;
            font-weight: 600;
        }

    /* Main Card */

    .attendance-main-card {
        border: 1px solid #e7ebf2;
        border-radius: 22px;
        background: #fff;
        box-shadow: 0 12px 40px rgba(15, 23, 42, .07);
        overflow: hidden;
    }

    /* Calendar Top */

    .calendar-top {
        padding: 24px 26px;
        background: radial-gradient(circle at 90% 20%, rgba(255,255,255,.16), transparent 30%), linear-gradient(135deg, #172554 0%, #1d4ed8 55%, #4f46e5 100%);
        color: #fff;
        position: relative;
        overflow: hidden;
    }

        .calendar-top::before {
            content: "";
            position: absolute;
            width: 180px;
            height: 180px;
            border-radius: 50%;
            background: rgba(255,255,255,.07);
            right: -60px;
            top: -80px;
        }

        .calendar-top::after {
            content: "";
            position: absolute;
            width: 120px;
            height: 120px;
            border-radius: 50%;
            background: rgba(255,255,255,.05);
            left: 35%;
            bottom: -80px;
        }

    .calendar-month {
        position: relative;
        z-index: 2;
    }

    .calendar-month-label {
        font-size: .75rem;
        text-transform: uppercase;
        letter-spacing: 1.5px;
        opacity: .75;
        font-weight: 700;
    }

    .calendar-month-title {
        font-size: 1.7rem;
        font-weight: 800;
        margin: 2px 0 0;
    }

    .calendar-month-date {
        font-size: .82rem;
        opacity: .8;
        margin-top: 3px;
    }

    /* Summary */

    .attendance-summary {
        position: relative;
        z-index: 2;
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
    }

    .summary-pill {
        min-width: 100px;
        padding: 9px 12px;
        border-radius: 13px;
        background: rgba(255,255,255,.12);
        border: 1px solid rgba(255,255,255,.14);
        backdrop-filter: blur(8px);
        transition: all .25s ease;
    }

        .summary-pill:hover {
            transform: translateY(-3px);
            background: rgba(255,255,255,.18);
        }

        .summary-pill .summary-number {
            display: block;
            font-size: 1.05rem;
            font-weight: 800;
        }

        .summary-pill .summary-label {
            display: block;
            font-size: .67rem;
            opacity: .75;
            margin-top: 1px;
        }

    /* Attendance Progress */

    .attendance-progress-area {
        padding: 18px 26px 8px;
        background: #fff;
    }

    .progress-info {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 8px;
    }

    .progress-title {
        font-size: .78rem;
        color: #64748b;
        font-weight: 700;
    }

    .progress-percentage {
        font-size: .85rem;
        font-weight: 800;
        color: #2563eb;
    }

    .attendance-progress {
        height: 8px;
        border-radius: 50px;
        background: #eef2f7;
        overflow: hidden;
    }

    .attendance-progress-bar {
        height: 100%;
        border-radius: 50px;
        background: linear-gradient(90deg, #2563eb, #6366f1);
        width: @(attendancePercentage) %;
        animation: progressGrow 1.2s ease;
    }

    @@keyframes progressGrow {
        from {
            width: 0;
        }

        to {
            width: @(attendancePercentage) %;
        }
    }

    /* Calendar Body */

    .calendar-body {
        padding: 18px 22px 25px;
    }

    /* Week Header */

    .week-header {
        display: grid;
        grid-template-columns: repeat(7, 1fr);
        gap: 8px;
        margin-bottom: 9px;
    }

    .week-day {
        text-align: center;
        padding: 11px 5px;
        border-radius: 11px;
        background: #f8fafc;
        border: 1px solid #edf1f6;
        color: #64748b;
        font-size: .72rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: .6px;
    }

        .week-day.weekend-header {
            color: #94a3b8;
            background: #fafafa;
        }

    /* Calendar Grid */

    .calendar-grid {
        display: grid;
        grid-template-columns: repeat(7, 1fr);
        gap: 8px;
    }

    /* Calendar Cell */

    .calendar-cell {
        min-height: 105px;
        border: 1px solid #e8edf3;
        border-radius: 15px;
        padding: 10px;
        background: #fff;
        position: relative;
        overflow: hidden;
        cursor: default;
        opacity: 0;
        animation: cellAppear .45s ease forwards;
        transition: transform .25s ease, box-shadow .25s ease, border-color .25s ease, background .25s ease;
    }

        .calendar-cell:hover {
            transform: translateY(-4px);
            border-color: #cbd5e1;
            box-shadow: 0 10px 25px rgba(15, 23, 42, .09);
            z-index: 3;
        }

    @@keyframes cellAppear {
        from {
            opacity: 0;
            transform: translateY(12px) scale(.97);
        }

        to {
            opacity: 1;
            transform: translateY(0) scale(1);
        }
    }

    /* Empty */

    .calendar-empty {
        background: #f8fafc;
        border-style: dashed;
        opacity: .65;
    }

        .calendar-empty:hover {
            transform: none;
            box-shadow: none;
        }

    /* Date */

    .date-number {
        display: inline-flex;
        width: 28px;
        height: 28px;
        align-items: center;
        justify-content: center;
        border-radius: 9px;
        color: #475569;
        font-size: .78rem;
        font-weight: 800;
        transition: all .25s ease;
    }

    /* Today */

    .calendar-cell.today {
        border: 2px solid #3b82f6;
        background: linear-gradient(145deg, #eff6ff, #fff);
        box-shadow: 0 5px 20px rgba(59, 130, 246, .14);
    }

        .calendar-cell.today .date-number {
            background: linear-gradient(135deg, #2563eb, #4f46e5);
            color: #fff;
            box-shadow: 0 5px 12px rgba(37, 99, 235, .3);
        }

    .today-label {
        position: absolute;
        top: 9px;
        right: 9px;
        font-size: .57rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: .5px;
        color: #2563eb;
    }

    /* Weekend */

    .calendar-cell.weekend {
        background: #fafafa;
    }

        .calendar-cell.weekend .date-number {
            color: #94a3b8;
        }

    /* Status */

    .status-container {
        margin-top: 8px;
    }

    .status-badge {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 5px 8px;
        border-radius: 8px;
        font-size: .64rem;
        font-weight: 800;
        line-height: 1;
        border: 1px solid transparent;
    }

    .status-present {
        color: #15803d;
        background: #f0fdf4;
        border-color: #bbf7d0;
    }

    .status-absent {
        color: #dc2626;
        background: #fef2f2;
        border-color: #fecaca;
    }

    .status-weekend {
        color: #64748b;
        background: #f1f5f9;
        border-color: #e2e8f0;
    }

    .status-upcoming {
        color: #64748b;
        background: #f8fafc;
        border-color: #e2e8f0;
    }

    .status-present i {
        animation: pulseDot 1.8s infinite;
    }

    @@keyframes pulseDot {
        0%, 100% {
            opacity: 1;
        }

        50% {
            opacity: .45;
        }
    }

    /* Check-in */

    .checkin-time {
        margin-top: 7px;
        font-size: .65rem;
        color: #64748b;
        display: flex;
        align-items: center;
        gap: 4px;
    }

        .checkin-time i {
            color: #2563eb;
            font-size: .6rem;
        }

    /* Legend */

    .calendar-footer {
        padding: 0 26px 24px;
    }

    .legend {
        display: flex;
        align-items: center;
        gap: 15px;
        flex-wrap: wrap;
        padding-top: 15px;
        border-top: 1px solid #edf0f4;
    }

    .legend-item {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        font-size: .7rem;
        color: #64748b;
        font-weight: 600;
    }

    .legend-dot {
        width: 9px;
        height: 9px;
        border-radius: 50%;
    }

    .dot-present {
        background: #22c55e;
    }

    .dot-absent {
        background: #ef4444;
    }

    .dot-weekend {
        background: #94a3b8;
    }

    .dot-upcoming {
        background: #cbd5e1;
    }

    .dot-today {
        background: #3b82f6;
    }

    /* Mobile */

    @@media (max-width: 992px) {

        .calendar-cell {
            min-height: 95px;
        }

        .summary-pill {
            min-width: 85px;
        }
    }

    @@media (max-width: 768px) {

        .calendar-top {
            padding: 20px;
        }

        .calendar-month-title {
            font-size: 1.35rem;
        }

        .attendance-summary {
            margin-top: 18px;
        }

        .calendar-body {
            padding: 15px 10px 20px;
            overflow-x: auto;
        }

        .week-header,
        .calendar-grid {
            min-width: 680px;
        }

        .calendar-footer {
            padding: 0 18px 20px;
        }

        .calendar-cell {
            min-height: 92px;
        }
    }

    @@media (max-width: 576px) {

        .attendance-title {
            font-size: 1.25rem;
        }

        .attendance-title-icon {
            width: 38px;
            height: 38px;
        }

        .summary-pill {
            flex: 1;
            min-width: 70px;
        }

            .summary-pill .summary-number {
                font-size: .95rem;
            }
    }

</style>


<div class="container-fluid py-4 text-start attendance-page">

    <!-- =====================================================
         PAGE HEADER
         ===================================================== -->

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <div class="d-flex align-items-center">

                <span class="attendance-title-icon">
                    <i class="fa-solid fa-calendar-days"></i>
                </span>

                <h4 class="attendance-title mb-0">
                    Attendance Calendar
                </h4>

            </div>

            <nav aria-label="breadcrumb" class="mt-2 breadcrumb-modern">

                <ol class="breadcrumb mb-0">

                    <li class="breadcrumb-item">
                        <a href="/EmployeeDashboard"
                           class="text-decoration-none">
                            ESS
                        </a>
                    </li>

                    <li class="breadcrumb-item active">
                        Attendance Calendar
                    </li>

                </ol>

            </nav>

        </div>

    </div>


    <!-- =====================================================
         MAIN CALENDAR CARD
         ===================================================== -->

    <div class="attendance-main-card">


        <!-- =================================================
             PREMIUM CALENDAR HEADER
             ================================================= -->

        <div class="calendar-top">

            <div class="d-flex justify-content-between align-items-start flex-wrap">

                <div class="calendar-month">

                    <div class="calendar-month-label">
                        Monthly Attendance
                    </div>

                    <div class="calendar-month-title">
                        @monthName @year
                    </div>

                    <div class="calendar-month-date">
                        <i class="fa-regular fa-calendar me-1"></i>

                        @today.ToString("dddd, dd MMMM yyyy")
                    </div>

                </div>


                <!-- SUMMARY -->

                <div class="attendance-summary">

                    <div class="summary-pill">

                        <span class="summary-number">
                            @presentDays
                        </span>

                        <span class="summary-label">
                            Present
                        </span>

                    </div>


                    <div class="summary-pill">

                        <span class="summary-number">
                            @absentDays
                        </span>

                        <span class="summary-label">
                            Absent
                        </span>

                    </div>


                    <div class="summary-pill">

                        <span class="summary-number">
                            @workingDays
                        </span>

                        <span class="summary-label">
                            Working Days
                        </span>

                    </div>


                    <div class="summary-pill">

                        <span class="summary-number">
                            @attendancePercentage%
                        </span>

                        <span class="summary-label">
                            Attendance
                        </span>

                    </div>

                </div>

            </div>

        </div>


        <!-- =================================================
             ATTENDANCE PROGRESS
             ================================================= -->

        <div class="attendance-progress-area">

            <div class="progress-info">

                <span class="progress-title">
                    Monthly Attendance Progress
                </span>

                <span class="progress-percentage">
                    @attendancePercentage%
                </span>

            </div>

            <div class="attendance-progress">

                <div class="attendance-progress-bar"></div>

            </div>

        </div>


        <!-- =================================================
             CALENDAR
             ================================================= -->

        <div class="calendar-body">

            <!-- WEEK DAYS -->

            <div class="week-header">

                <div class="week-day weekend-header">
                    Sun
                </div>

                <div class="week-day">
                    Mon
                </div>

                <div class="week-day">
                    Tue
                </div>

                <div class="week-day">
                    Wed
                </div>

                <div class="week-day">
                    Thu
                </div>

                <div class="week-day">
                    Fri
                </div>

                <div class="week-day weekend-header">
                    Sat
                </div>

            </div>


            <!-- CALENDAR GRID -->

            <div class="calendar-grid">


                <!-- EMPTY CELLS BEFORE MONTH -->
                @for (int i = 0; i < startDayOfWeek; i++)
                {
                    <div class="calendar-cell calendar-empty"></div>
                }


                <!-- DAYS -->
                @for (int day = 1; day <= daysInMonth; day++)
                {
                    var currentDate =
                    new DateTime(year, month, day);

                    var punch =
                    punches.FirstOrDefault(
                    p => p.Date.Date == currentDate.Date
                    );

                    var isWeekend =
                    currentDate.DayOfWeek == DayOfWeek.Saturday ||
                    currentDate.DayOfWeek == DayOfWeek.Sunday;

                    var isToday =
                    currentDate.Date == today.Date;

                    var isFuture =
                    currentDate.Date > today.Date;

                    <div class="calendar-cell
                                    @(isWeekend ? "weekend" : "")
                                    @(isToday ? "today" : "")"
                         style="animation-delay:@((day % 12) * 35)ms;">

                        <!-- DATE -->

                        <div class="d-flex justify-content-between align-items-start">

                            <span class="date-number">
                                @day
                            </span>

                            @if (isToday)
                            {
                                <span class="today-label">
                                    Today
                                </span>
                            }

                        </div>


                        <!-- STATUS -->

                        <div class="status-container">

                            @if (punch != null)
                            {
                                <span class="status-badge status-present">

                                    <i class="fa-solid fa-circle-check"></i>

                                    Present

                                </span>

                                @if (punch.CheckInTime.HasValue)
                                {
                                    <div class="checkin-time">

                                        <i class="fa-solid fa-arrow-right-to-bracket"></i>

                                        In:
                                        @punch.CheckInTime.Value.ToString("HH:mm")

                                    </div>
                                }
                            }
                            else if (isWeekend)
                            {
                                <span class="status-badge status-weekend">

                                    <i class="fa-solid fa-mug-hot"></i>

                                    Weekend

                                </span>
                            }
                            else if (currentDate < today)
                            {
                                <span class="status-badge status-absent">

                                    <i class="fa-solid fa-circle-xmark"></i>

                                    Absent

                                </span>
                            }
                            else
                            {
                                <span class="status-badge status-upcoming">

                                    <i class="fa-regular fa-clock"></i>

                                    Upcoming

                                </span>
                            }

                        </div>

                    </div>
                }


                <!-- EMPTY CELLS AFTER MONTH -->
                @for (int i = 0; i < remainingSlots; i++)
                {
                    <div class="calendar-cell calendar-empty"></div>
                }

            </div>

        </div>


        <!-- =================================================
             LEGEND
             ================================================= -->

        <div class="calendar-footer">

            <div class="legend">

                <div class="legend-item">

                    <span class="legend-dot dot-present"></span>

                    Present

                </div>


                <div class="legend-item">

                    <span class="legend-dot dot-absent"></span>

                    Absent

                </div>


                <div class="legend-item">

                    <span class="legend-dot dot-weekend"></span>

                    Weekend

                </div>


                <div class="legend-item">

                    <span class="legend-dot dot-upcoming"></span>

                    Upcoming

                </div>


                <div class="legend-item">

                    <span class="legend-dot dot-today"></span>

                    Today

                </div>

            </div>

        </div>

    </div>

</div>


<script>

    document.addEventListener("DOMContentLoaded", function () {

        /*
         * Attendance Calendar
         * Premium hover interaction
         */

        const cells =
            document.querySelectorAll(".calendar-cell:not(.calendar-empty)");

        cells.forEach(function (cell) {

            cell.addEventListener("mouseenter", function () {

                this.style.transition =
                    "transform .25s ease, box-shadow .25s ease";

            });

        });


        /*
         * Add subtle click feedback
         */

        cells.forEach(function (cell) {

            cell.addEventListener("click", function () {

                this.animate(
                    [
                        {
                            transform: "scale(1)"
                        },
                        {
                            transform: "scale(.98)"
                        },
                        {
                            transform: "scale(1)"
                        }
                    ],
                    {
                        duration: 180,
                        easing: "ease-out"
                    }
                );

            });

        });

    });

</script>
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Master Data Export";
}

<div class="container-fluid py-4 text-start" style="max-width: 700px;">
    <div class="mb-4">
        <h4 class="fw-bold mb-1"><i class="fa-solid fa-file-export text-primary me-2"></i>Master Data Export</h4>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0 small">
                <li class="breadcrumb-item"><a href="/Dashboard" class="text-decoration-none">Admin Dashboard</a></li>
                <li class="breadcrumb-item active" aria-current="page">Data Export</li>
            </ol>
        </nav>
    </div>

    <!-- Export Grid -->
    <div class="bg-white border rounded-3 p-4 shadow-sm">
        <h5 class="fw-bold mb-3">Download Master Data</h5>
        <div class="row g-3">
            <div class="col-md-6">
                <div class="p-3 border rounded text-center bg-light">
                    <h6 class="fw-bold mb-2">Employee Master</h6>
                    <button class="btn btn-sm btn-outline-primary rounded-pill px-3" onclick="alert('Exporting Employee Master database records as Excel...')"><i class="fa-solid fa-download me-1"></i> Export Excel</button>
                </div>
            </div>
            <div class="col-md-6">
                <div class="p-3 border rounded text-center bg-light">
                    <h6 class="fw-bold mb-2">Items & Catalog Master</h6>
                    <button class="btn btn-sm btn-outline-primary rounded-pill px-3" onclick="alert('Exporting Items Catalog database records as Excel...')"><i class="fa-solid fa-download me-1"></i> Export Excel</button>
                </div>
            </div>
        </div>
    </div>
</div>

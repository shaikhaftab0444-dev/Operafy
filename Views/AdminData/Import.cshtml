@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Bulk Data Import";
}

<div class="container-fluid py-4 text-start" style="max-width: 700px;">
    <div class="mb-4">
        <h4 class="fw-bold mb-1"><i class="fa-solid fa-file-import text-primary me-2"></i>Bulk Data Import (Excel / CSV)</h4>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0 small">
                <li class="breadcrumb-item"><a href="/Dashboard" class="text-decoration-none">Admin Dashboard</a></li>
                <li class="breadcrumb-item active" aria-current="page">Bulk Import</li>
            </ol>
        </nav>
    </div>

    <!-- Import Form -->
    <div class="bg-white border rounded-3 p-4 shadow-sm">
        <h5 class="fw-bold mb-3">Upload Data Sheet</h5>
        <form>
            <div class="mb-3">
                <label class="form-label small fw-semibold">Select Target Module</label>
                <select class="form-select">
                    <option>Items & SKUs Catalog</option>
                    <option>Employee Directory</option>
                    <option>Customer Catalog</option>
                </select>
            </div>
            <div class="mb-4">
                <label class="form-label small fw-semibold">Choose Excel / CSV File</label>
                <input type="file" class="form-control" accept=".csv, .xls, .xlsx" />
                <div class="form-text small text-muted">Max file size allowed is 5 MB. Supported formats: .csv, .xlsx</div>
            </div>
            <button type="button" class="btn btn-primary rounded-pill px-4" onclick="alert('File uploaded. Processing bulk import in background...')">Start Data Import</button>
        </form>
    </div>
</div>

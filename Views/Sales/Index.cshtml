@model ERP_System.Models.SalesViewModel
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Sales Management";
    var inCulture = new System.Globalization.CultureInfo("en-IN");
}

<style>
    .panel-sales {
        background: #ffffff;
        border: 1px solid var(--border-warm);
        border-radius: 12px;
        box-shadow: 0 1px 3px rgba(45,37,30,0.03);
    }
    
    .table-sales th {
        background-color: #fcfbfa !important;
        font-size: 0.75rem;
        text-transform: uppercase;
        font-weight: 700;
        color: #7c7267;
        border-bottom: 1px solid var(--border-warm);
        padding: 1rem 1.25rem;
    }
    
    .table-sales td {
        font-size: 0.875rem;
        color: var(--text-color);
        border-bottom: 1px solid var(--border-warm);
        padding: 1rem 1.25rem;
        vertical-align: middle;
    }

    .badge-inv-paid {
        background-color: rgba(16, 185, 129, 0.08);
        color: #10b981;
        font-weight: 600;
        border: 1px solid rgba(16, 185, 129, 0.2);
    }
    .badge-inv-pending {
        background-color: rgba(245, 158, 11, 0.08);
        color: #f59e0b;
        font-weight: 600;
        border: 1px solid rgba(245, 158, 11, 0.2);
    }
    .badge-inv-cancelled {
        background-color: rgba(239, 68, 68, 0.08);
        color: #ef4444;
        font-weight: 600;
        border: 1px solid rgba(239, 68, 68, 0.2);
    }

    .kpi-card-warm {
        background: #ffffff;
        border: 1px solid var(--border-warm);
        border-radius: 12px;
        padding: 1.25rem;
        box-shadow: 0 1px 3px rgba(13,20,36,0.03);
        display: flex;
        align-items: center;
        gap: 1.25rem;
    }
    .kpi-icon-box {
        width: 48px;
        height: 48px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.35rem;
        flex-shrink: 0;
    }

    .btn-action-warm {
        border: 1px solid var(--border-warm);
        background-color: #ffffff;
        color: var(--text-color);
        font-size: 0.8rem;
        font-weight: 600;
        padding: 0.35rem 0.75rem;
        border-radius: 6px;
        transition: all 0.2s;
    }
    .btn-action-warm:hover {
        background-color: #faf8f5;
        border-color: #cbd5e1;
        color: var(--primary-warm);
    }

    .receipt-modal-box {
        border: 2px dashed #cbd5e1;
        border-radius: 8px;
        background: #fafaf9;
        padding: 1.5rem;
    }
</style>

<!-- Top Header & Breadcrumbs -->
<div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-3 mb-4 text-start">
    <div>
        <h4 class="fw-bold mb-1" style="color: var(--text-color);">Sales Management</h4>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0 small">
                <li class="breadcrumb-item"><a href="/Dashboard" class="text-decoration-none">Dashboard</a></li>
                <li class="breadcrumb-item active" aria-current="page">Sales Invoices</li>
            </ol>
        </nav>
    </div>
    
    <div class="d-flex gap-2">
        <a href="/Customers" class="btn btn-outline-secondary btn-sm px-3 py-2 fw-semibold">
            <i class="fa-solid fa-users me-1.5"></i> Customer Directory
        </a>
        <button type="button" class="btn btn-primary-warm px-4 py-2" data-bs-toggle="modal" data-bs-target="#createInvoiceModal">
            <i class="fa-solid fa-plus me-1.5"></i> Create Sales Invoice
        </button>
    </div>
</div>

<!-- Alerts -->
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm text-start mb-4" role="alert">
        <i class="fa-solid fa-circle-check me-2"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm text-start mb-4" role="alert">
        <i class="fa-solid fa-triangle-exclamation me-2"></i> @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- KPI Summary Cards Row -->
<div class="row g-3 mb-4 text-start">
    <div class="col-xl-3 col-sm-6">
        <div class="kpi-card-warm">
            <div class="kpi-icon-box bg-success bg-opacity-10 text-success">
                <i class="fa-solid fa-chart-line"></i>
            </div>
            <div>
                <div class="text-muted small fw-semibold text-uppercase">Total Sales Revenue</div>
                <div class="fs-4 fw-bold text-dark">@Model.TotalSalesRevenue.ToString("C0", inCulture)</div>
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-sm-6">
        <div class="kpi-card-warm">
            <div class="kpi-icon-box bg-primary bg-opacity-10 text-primary">
                <i class="fa-solid fa-file-invoice"></i>
            </div>
            <div>
                <div class="text-muted small fw-semibold text-uppercase">Invoices Issued</div>
                <div class="fs-4 fw-bold text-dark">@Model.TotalInvoicesCount Invoices</div>
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-sm-6">
        <div class="kpi-card-warm">
            <div class="kpi-icon-box bg-info bg-opacity-10 text-info">
                <i class="fa-solid fa-circle-check"></i>
            </div>
            <div>
                <div class="text-muted small fw-semibold text-uppercase">Settled / Paid Invoices</div>
                <div class="fs-4 fw-bold text-success">@Model.PaidInvoicesCount Paid</div>
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-sm-6">
        <div class="kpi-card-warm">
            <div class="kpi-icon-box bg-warning bg-opacity-10 text-warning">
                <i class="fa-solid fa-hourglass-half"></i>
            </div>
            <div>
                <div class="text-muted small fw-semibold text-uppercase">Pending Receivables</div>
                <div class="fs-4 fw-bold text-warning">@Model.TotalPendingAmount.ToString("C0", inCulture)</div>
            </div>
        </div>
    </div>
</div>

<!-- Filters & Search Bar -->
<div class="panel-sales p-3 mb-4 text-start">
    <form method="get" asp-action="Index" class="row g-3 align-items-center">
        <div class="col-lg-5 col-md-6">
            <div class="input-group">
                <span class="input-group-text bg-white border-end-0 text-muted"><i class="fa-solid fa-magnifying-glass"></i></span>
                <input type="text" name="search" class="form-control border-start-0 ps-0" placeholder="Search invoice number or customer name..." value="@Model.SearchTerm">
            </div>
        </div>

        <div class="col-lg-3 col-md-6">
            <select name="status" class="form-select">
                <option value="">All Payment Statuses</option>
                <option value="Paid" selected="@(Model.SelectedStatus == "Paid" ? "selected" : null)">Paid</option>
                <option value="Pending" selected="@(Model.SelectedStatus == "Pending" ? "selected" : null)">Pending</option>
                <option value="Cancelled" selected="@(Model.SelectedStatus == "Cancelled" ? "selected" : null)">Cancelled</option>
            </select>
        </div>

        <div class="col-lg-3 col-md-6">
            <select name="customer" class="form-select">
                <option value="">All Customers</option>
                @foreach (var c in Model.CustomersList)
                {
                    <option value="@c.CustomerName" selected="@(Model.SelectedCustomer == c.CustomerName ? "selected" : null)">@c.CustomerName</option>
                }
            </select>
        </div>

        <div class="col-lg-1 col-md-6 text-end">
            <button type="submit" class="btn btn-primary-warm w-100"><i class="fa-solid fa-filter me-1"></i> Filter</button>
        </div>
    </form>
</div>

<!-- Sales Invoices Registry Table Panel -->
<div class="panel-sales p-0 overflow-hidden mb-5 text-start">
    <div class="p-3 bg-light border-bottom d-flex justify-content-between align-items-center">
        <h6 class="fw-bold mb-0 text-dark"><i class="fa-solid fa-file-invoice me-2 text-muted"></i>Sales Invoices Registry</h6>
        <span class="badge bg-secondary rounded-pill font-monospace fs-7">Showing @Model.SalesInvoices.Count Invoices</span>
    </div>

    <div class="table-responsive">
        <table class="table table-sales mb-0">
            <thead>
                <tr>
                    <th>Invoice No</th>
                    <th>Date</th>
                    <th>Customer Name</th>
                    <th>Document Type</th>
                    <th>Invoice Amount</th>
                    <th>Payment Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.SalesInvoices != null && Model.SalesInvoices.Any())
                {
                    foreach (var inv in Model.SalesInvoices)
                    {
                        var badgeClass = inv.Status == "Paid" ? "badge-inv-paid" :
                                         inv.Status == "Pending" ? "badge-inv-pending" : "badge-inv-cancelled";

                        <tr>
                            <td>
                                <a href="#" onclick="viewReceipt('@inv.TransactionNo', '@inv.PartyName', '@inv.Date.ToString("dd MMM yyyy")', '@inv.Amount.ToString("C0", inCulture)', '@inv.Status'); return false;" 
                                   class="fw-bold text-primary font-monospace text-decoration-none">@inv.TransactionNo</a>
                            </td>
                            <td class="text-muted">
                                <i class="fa-regular fa-calendar me-1 small"></i> @inv.Date.ToString("dd MMM yyyy")
                            </td>
                            <td>
                                <div class="fw-bold text-dark mb-0">@inv.PartyName</div>
                                <div class="text-muted small">Customer Account</div>
                            </td>
                            <td>
                                <span class="badge bg-light text-dark border">@inv.Type</span>
                            </td>
                            <td class="fw-bold text-dark fs-6">
                                @inv.Amount.ToString("C0", inCulture)
                            </td>
                            <td>
                                <span class="badge rounded-pill px-2.5 py-1.5 @badgeClass">
                                    <i class="fa-solid fa-circle me-1" style="font-size:0.5rem;"></i> @inv.Status
                                </span>
                            </td>
                            <td class="text-end">
                                <div class="btn-group">
                                    @if (inv.Status == "Pending")
                                    {
                                        <form method="post" asp-action="UpdateStatus" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="transactionId" value="@inv.TransactionId" />
                                            <input type="hidden" name="newStatus" value="Paid" />
                                            <button type="submit" class="btn btn-action-warm btn-sm me-1 text-success" title="Mark as Settled / Paid">
                                                <i class="fa-solid fa-circle-check me-1"></i> Mark Paid
                                            </button>
                                        </form>
                                    }

                                    <button type="button" class="btn btn-action-warm btn-sm me-1" 
                                            onclick="viewReceipt('@inv.TransactionNo', '@inv.PartyName', '@inv.Date.ToString("dd MMM yyyy")', '@inv.Amount.ToString("C0", inCulture)', '@inv.Status')" 
                                            title="View Invoice Receipt">
                                        <i class="fa-solid fa-receipt text-secondary"></i>
                                    </button>

                                    <button type="button" class="btn btn-action-warm btn-sm me-1" 
                                            onclick="openUpdateModal(@inv.TransactionId, '@inv.TransactionNo', '@inv.Status')">
                                        <i class="fa-solid fa-pen-to-square text-primary me-1"></i> Status
                                    </button>

                                    <form method="post" asp-action="Delete" class="d-inline" onsubmit="return confirm('Are you sure you want to cancel this sales invoice?');">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="transactionId" value="@inv.TransactionId" />
                                        <button type="submit" class="btn btn-action-warm btn-sm text-danger" title="Cancel Invoice">
                                            <i class="fa-solid fa-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="text-center text-muted py-5">
                            <i class="fa-solid fa-file-invoice fa-2x mb-3 text-muted opacity-50"></i>
                            <div>No sales invoices match your filter parameters.</div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Create Sales Invoice Modal -->
<div class="modal fade text-start" id="createInvoiceModal" tabindex="-1" aria-labelledby="createInvoiceModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow">
            <form method="post" asp-action="CreateInvoice">
                @Html.AntiForgeryToken()
                <div class="modal-header bg-light">
                    <h5 class="modal-title fw-bold" id="createInvoiceModalLabel"><i class="fa-solid fa-file-circle-plus me-2 text-primary"></i>Generate Sales Invoice</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Customer / Billed Party</label>
                            <select name="customerName" class="form-select" required>
                                <option value="">Select Customer...</option>
                                @foreach (var cust in Model.CustomersList)
                                {
                                    <option value="@cust.CustomerName">@cust.CustomerName (@cust.Email)</option>
                                }
                                <option value="Rahul Enterprises">Rahul Enterprises</option>
                                <option value="ABC Corporation">ABC Corporation</option>
                                <option value="Walk-in Retail Customer">Walk-in Retail Customer</option>
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Inventory Product Item</label>
                            <select name="productId" class="form-select" required>
                                @foreach (var prod in Model.ProductsList)
                                {
                                    <option value="@prod.ProductId">@prod.ProductName (@prod.Category) - Available Stock: @prod.StockQty</option>
                                }
                            </select>
                        </div>

                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Quantity Sold</label>
                            <input type="number" name="quantity" class="form-control" value="1" min="1" required />
                        </div>

                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Unit Selling Price (₹)</label>
                            <input type="number" name="unitPrice" class="form-control" value="15000" min="1" step="0.01" required />
                        </div>

                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Payment Status</label>
                            <select name="status" class="form-select">
                                <option value="Paid">Paid / Settled</option>
                                <option value="Pending">Pending / Unpaid Receivable</option>
                            </select>
                        </div>

                        <div class="col-12">
                            <label class="form-label fw-semibold">Invoice Terms & Notes</label>
                            <textarea name="notes" class="form-control" rows="2" placeholder="Payment terms, delivery reference, or notes..."></textarea>
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary-warm px-4">Generate & Issue Invoice</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Invoice Receipt Printable View Modal -->
<div class="modal fade text-start" id="viewReceiptModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-light">
                <h5 class="modal-title fw-bold"><i class="fa-solid fa-receipt me-2 text-success"></i>Sales Invoice Receipt</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <div class="receipt-modal-box">
                    <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom">
                        <div>
                            <h6 class="fw-bold mb-0 text-dark">AIT ERP Solutions</h6>
                            <small class="text-muted">Tax Sales Invoice</small>
                        </div>
                        <div class="text-end">
                            <div class="fw-bold font-monospace text-primary" id="rcptTxNo">INV-10045</div>
                            <small class="text-muted" id="rcptDate">31 May 2026</small>
                        </div>
                    </div>
                    
                    <div class="mb-3">
                        <small class="text-muted text-uppercase fw-semibold d-block">Billed To Party:</small>
                        <div class="fw-bold text-dark fs-6" id="rcptCustomer">Rahul Enterprises</div>
                    </div>

                    <div class="d-flex justify-content-between align-items-center p-2 bg-white rounded border mb-3">
                        <span class="text-muted small">Total Invoice Amount:</span>
                        <span class="fw-bold text-dark fs-5" id="rcptAmount">₹25,000</span>
                    </div>

                    <div class="d-flex justify-content-between align-items-center">
                        <span class="text-muted small">Payment Status:</span>
                        <span class="badge bg-success px-3 py-1.5" id="rcptStatus">Paid</span>
                    </div>
                </div>
            </div>
            <div class="modal-footer bg-light">
                <button type="button" class="btn btn-light" data-bs-dismiss="modal">Close</button>
                <button type="button" class="btn btn-outline-primary" onclick="window.print();"><i class="fa-solid fa-print me-1.5"></i> Print Receipt</button>
            </div>
        </div>
    </div>
</div>

<!-- Update Status Modal -->
<div class="modal fade text-start" id="updateStatusModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <form method="post" asp-action="UpdateStatus">
                @Html.AntiForgeryToken()
                <input type="hidden" name="transactionId" id="modalTxId" />
                <div class="modal-header bg-light">
                    <h5 class="modal-title fw-bold"><i class="fa-solid fa-pen-to-square me-2 text-primary"></i>Update Invoice Status</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Invoice Number</label>
                        <input type="text" id="modalTxNo" class="form-control bg-light" readonly />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Select New Payment Status</label>
                        <select name="newStatus" id="modalNewStatus" class="form-select" required>
                            <option value="Paid">Paid / Settled</option>
                            <option value="Pending">Pending / Receivable</option>
                            <option value="Cancelled">Cancelled</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary-warm px-4">Update Status</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function openUpdateModal(txId, txNo, currentStatus) {
            document.getElementById('modalTxId').value = txId;
            document.getElementById('modalTxNo').value = txNo;
            document.getElementById('modalNewStatus').value = currentStatus;
            
            const modalEl = new bootstrap.Modal(document.getElementById('updateStatusModal'));
            modalEl.show();
        }

        function viewReceipt(txNo, customer, dateStr, amountStr, status) {
            document.getElementById('rcptTxNo').innerText = txNo;
            document.getElementById('rcptCustomer').innerText = customer;
            document.getElementById('rcptDate').innerText = dateStr;
            document.getElementById('rcptAmount').innerText = amountStr;
            document.getElementById('rcptStatus').innerText = status;
            
            const modalEl = new bootstrap.Modal(document.getElementById('viewReceiptModal'));
            modalEl.show();
        }
    </script>
}

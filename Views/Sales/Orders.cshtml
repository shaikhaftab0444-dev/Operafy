@model List<ERP_System.Models.SalesOrder>
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Sales Orders";
}

<style>
    .sales-table-card {
        background: #ffffff;
        border-radius: 14px;
        border: 1px solid var(--border-warm, #e2e8f0);
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.04);
    }
    .order-badge-Confirmed { background: rgba(16, 185, 129, 0.12); color: #059669; }
    .order-badge-Invoiced { background: rgba(59, 130, 246, 0.12); color: #2563eb; }
    .order-badge-Draft { background: rgba(100, 116, 139, 0.12); color: #475569; }
    .order-badge-Cancelled { background: rgba(239, 68, 68, 0.12); color: #dc2626; }
</style>

<div class="container-fluid py-3 px-3 px-md-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <div class="text-muted small mb-1">
                <a href="@Url.Action("Index", "Sales")" class="text-decoration-none text-muted">Sales Command</a> / <span>Orders</span>
            </div>
            <h4 class="fw-bold mb-0 text-dark">
                <i class="fa-solid fa-file-invoice-dollar text-success me-2"></i>Sales Orders & Contracts
            </h4>
        </div>
        <button type="button" class="btn btn-success px-3 shadow-sm" data-bs-toggle="modal" data-bs-target="#newOrderModal">
            <i class="fa-solid fa-plus me-1.5"></i> New Sales Order
        </button>
    </div>

    <div class="sales-table-card">
        <div class="p-3 border-bottom d-flex flex-wrap justify-content-between align-items-center gap-3 bg-light-subtle">
            <div class="d-flex align-items-center gap-2">
                <span class="fw-bold small text-secondary">Total Booked Orders:</span>
                <span class="badge bg-success rounded-pill">@Model.Count</span>
                <span class="ms-3 fw-bold small text-secondary">Total Value:</span>
                <span class="badge bg-primary rounded-pill">₹ @Model.Sum(o => o.TotalAmount ?? 0m).ToString("N0")</span>
            </div>
            <div>
                <input type="text" id="orderSearchInput" class="form-control form-control-sm" placeholder="Search order #, customer..." onkeyup="filterOrders()" style="min-width: 250px;" />
            </div>
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" id="ordersTable">
                <thead class="table-light">
                    <tr class="small text-uppercase text-muted">
                        <th>Order Number</th>
                        <th>Customer / Organization</th>
                        <th>Order Date</th>
                        <th>Payment Terms</th>
                        <th>Total Amount</th>
                        <th class="text-end">Status</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5 text-muted">
                                <i class="fa-regular fa-file-lines fs-2 d-block mb-2"></i>
                                No sales orders recorded.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var order in Model)
                        {
                            <tr class="order-row">
                                <td>
                                    <span class="fw-bold text-dark font-monospace order-num">@order.OrderNumber</span>
                                </td>
                                <td>
                                    <div class="fw-semibold text-dark order-cust">@(order.CustomerName ?? "N/A")</div>
                                </td>
                                <td>
                                    <span class="text-muted small">@(order.OrderDate?.ToString("dd MMM yyyy") ?? "N/A")</span>
                                </td>
                                <td>
                                    <span class="badge bg-light text-dark border">@order.PaymentTerms</span>
                                </td>
                                <td>
                                    <span class="fw-bold text-dark">₹ @((order.TotalAmount ?? 0m).ToString("N2"))</span>
                                </td>
                                <td class="text-end">
                                    <span class="badge order-badge-@order.Status px-2.5 py-1 rounded-pill">@order.Status</span>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- MODAL: ADD NEW ORDER -->
<div class="modal fade" id="newOrderModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 16px;">
            <div class="modal-header bg-dark text-white px-4 py-3">
                <h6 class="modal-title fw-bold">Record Confirmed Sales Order</h6>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form action="@Url.Action("CreateOrder", "Sales")" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body p-4">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">Customer Organization <span class="text-danger">*</span></label>
                            <input type="text" name="CustomerName" class="form-control" required placeholder="e.g. Rahul Enterprises" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">Total Contract Amount (₹) <span class="text-danger">*</span></label>
                            <input type="number" step="0.01" name="TotalAmount" class="form-control" required placeholder="250000" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">Order Date</label>
                            <input type="date" name="OrderDate" class="form-control" value="@DateTime.Today.ToString("yyyy-MM-dd")" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">Payment Terms</label>
                            <select name="PaymentTerms" class="form-select">
                                <option value="Immediate">Immediate</option>
                                <option value="Net 15">Net 15</option>
                                <option value="Net 30" selected>Net 30</option>
                                <option value="Net 60">Net 60</option>
                            </select>
                        </div>
                        <div class="col-md-12">
                            <label class="form-label small fw-bold">Status</label>
                            <select name="Status" class="form-select">
                                <option value="Confirmed" selected>Confirmed</option>
                                <option value="Invoiced">Invoiced</option>
                                <option value="Draft">Draft</option>
                            </select>
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light px-4 py-2.5">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-success btn-sm fw-bold">Confirm Order</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    function filterOrders() {
        const query = document.getElementById("orderSearchInput").value.toLowerCase();
        document.querySelectorAll(".order-row").forEach(row => {
            const num = row.querySelector(".order-num").innerText.toLowerCase();
            const cust = row.querySelector(".order-cust").innerText.toLowerCase();
            row.style.display = (num.includes(query) || cust.includes(query)) ? "" : "none";
        });
    }
</script>

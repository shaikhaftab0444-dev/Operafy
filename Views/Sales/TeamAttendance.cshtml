@model List<ERP_System.Models.HRAttendanceLog>
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Sales Team Radar";
    var executives = ViewBag.Executives as List<ERP_System.Models.User> ?? new List<ERP_System.Models.User>();
    var selectedDate = (DateTime)(ViewBag.SelectedDate ?? DateTime.Today);
}

<style>
    .sales-table-card {
        background: #ffffff;
        border-radius: 14px;
        border: 1px solid var(--border-warm, #e2e8f0);
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.04);
    }
</style>

<div class="container-fluid py-3 px-3 px-md-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <div class="text-muted small mb-1">
                <a href="@Url.Action("Index", "Sales")" class="text-decoration-none text-muted">Sales Command</a> / <span>Team Management</span>
            </div>
            <h4 class="fw-bold mb-0 text-dark">
                <i class="fa-solid fa-users-cog text-primary me-2"></i>Sales Team Attendance Radar
            </h4>
        </div>
        <div class="d-flex gap-2">
            <a href="@Url.Action("Approvals", "Manager")" class="btn btn-outline-secondary px-3 shadow-sm">
                <i class="fa-solid fa-clipboard-check me-1.5"></i> Review Leave Approvals
            </a>
        </div>
    </div>

    <div class="sales-table-card">
        <div class="p-3 border-bottom d-flex flex-wrap justify-content-between align-items-center gap-3 bg-light-subtle">
            <div class="d-flex align-items-center gap-2">
                <span class="fw-bold small text-secondary">Reporting Date:</span>
                <span class="badge bg-primary rounded-pill">@selectedDate.ToString("dd MMMM yyyy")</span>
            </div>
            <div class="d-flex gap-2">
                <span class="badge bg-success-subtle text-success px-2.5 py-1.5 rounded-pill small fw-semibold">
                    <i class="fa-solid fa-circle-check me-1"></i> Present: @Model.Count(m => m.Status == "Present" || m.Status.Contains("Late"))
                </span>
                <span class="badge bg-danger-subtle text-danger px-2.5 py-1.5 rounded-pill small fw-semibold">
                    <i class="fa-solid fa-circle-xmark me-1"></i> Absent: @Math.Max(0, executives.Count - Model.Count(m => m.Status == "Present" || m.Status.Contains("Late")))
                </span>
            </div>
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr class="small text-uppercase text-muted">
                        <th>Executive Details</th>
                        <th>Clock In</th>
                        <th>Clock Out</th>
                        <th>Work Hours</th>
                        <th>Punch Source</th>
                        <th>Status</th>
                        <th class="text-end">Remarks</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!executives.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center py-5 text-muted">
                                <i class="fa-solid fa-user-slash fs-2 d-block mb-2"></i>
                                No subordinate sales executives found.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var user in executives)
                        {
                            var log = Model.FirstOrDefault(l => l.UserId == user.UserId);
                            var isPresent = log != null && (log.Status == "Present" || log.Status.Contains("Late"));
                            var clockIn = log?.CheckInTime?.ToString("hh:mm tt") ?? "-";
                            var clockOut = log?.CheckOutTime?.ToString("hh:mm tt") ?? "-";
                            var status = log?.Status ?? "Not Clocked In";
                            var badgeClass = isPresent ? "bg-success-subtle text-success" : (log?.Status == "Leave" ? "bg-warning-subtle text-warning" : "bg-danger-subtle text-danger");

                            <tr>
                                <td>
                                    <div class="d-flex align-items-center gap-2.5">
                                        <div class="rounded-circle bg-primary bg-opacity-10 text-primary d-flex align-items-center justify-content-center fw-bold" style="width: 38px; height: 38px; font-size: 0.85rem;">
                                            @((!string.IsNullOrEmpty(user.FullName) ? user.FullName[0].ToString() : "E"))
                                        </div>
                                        <div>
                                            <div class="fw-bold text-dark">@user.FullName</div>
                                            <div class="text-muted extra-small">@(user.Role?.RoleName ?? "Sales Executive") • @(user.UserCode)</div>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <span class="small font-monospace fw-semibold @(clockIn != "-" ? "text-success" : "text-muted")">
                                        <i class="fa-regular fa-clock me-1"></i>@clockIn
                                    </span>
                                </td>
                                <td>
                                    <span class="small font-monospace text-muted">
                                        <i class="fa-regular fa-clock me-1"></i>@clockOut
                                    </span>
                                </td>
                                <td>
                                    <span class="small fw-semibold text-dark">@(log?.WorkHours ?? "0h 0m")</span>
                                </td>
                                <td>
                                    <span class="badge bg-light text-secondary border">@(log?.PunchSource ?? "Web Punch")</span>
                                </td>
                                <td>
                                    <span class="badge @badgeClass rounded-pill px-2.5 py-1 small fw-bold">@status</span>
                                </td>
                                <td class="text-end">
                                    <span class="text-muted extra-small">@(log?.Remarks ?? "Field Ops Schedule")</span>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

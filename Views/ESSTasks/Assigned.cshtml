                            Active Deliverables Listing
                        </h5>

                        <p class="task-card-description">
                            Review deadlines, monitor progress and update task completion status.
                        </p>
                    </div>

                </div>

                <div class="task-record-count">
                    <i class="fa-solid fa-list"></i>
                    @totalTasks Records
                </div>

            </div>


            <div class="task-table-wrap">

                <table class="task-table">

                    <thead>
                        <tr>
                            <th>
                                Task Title
                            </th>

                            <th>
                                Description
                            </th>

                            <th>
                                Due Date
                            </th>

                            <th>
                                Status
                            </th>
            </div>


            <!-- =================================================
                 TASK TABLE
                 ================================================= -->
            <div class="task-table-wrapper">

                <table class="task-table align-middle">

                    <thead>
                        <tr>
                            <th>Task Title</th>
                            <th>Description</th>
                            <th>Due Date</th>
                            <th>Status</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>

                    <tbody>

                        @if (Model != null && Model.Any())
                        {
                            var rowIndex = 0;

                            @foreach (var t in Model)
                            {
                                <tr style="animation-delay: @(rowIndex * 0.045)s;">
                                    <td>

                                        <div class="task-name">

                                            <div class="task-name-icon">
                                                <i class="fa-solid fa-clipboard-check"></i>
                                            </div>

                                            <div class="task-name-text">

                                                <p class="task-name-title">
                                                    @t.TaskTitle
                                                </p>

                                                <span class="task-name-label">
                                                    Assigned Task
                                                </span>

                                            </div>

                                        </div>

                                    </td>


                                    <td>

                                        <span class="task-description">
                                            @t.Description
                                        </span>

                                    </td>


                                    <td>

                                        <span class="task-due-date">
                                            <i class="fa-regular fa-calendar"></i>
                                            @t.DueDate.ToString("dd MMM yyyy")
                                        </span>

                                    </td>


                                    <td>

                                        @if (t.Status == "Completed")
                                        {
                                            <span class="task-status task-status-completed">
                                                <span class="task-status-dot"></span>
                                                Completed
                                            </span>
                                        }
                                        else if (t.Status == "In Progress")
                                        {
                                            <span class="task-status task-status-progress">
                                                <span class="task-status-dot"></span>
                                                In Progress
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="task-status task-status-pending">
                                                <span class="task-status-dot"></span>
                                                Pending
                                            </span>
                                        }

                                    </td>

                                </tr>

                                rowIndex++;
                            }
                        }
                        else
                        {
                            @foreach (var t in Model)
                            {
                                var statusBadge = t.Status switch
                                {
                                    "Completed" => "task-status-completed",
                                    "In Progress" => "task-status-progress",
                                    _ => "task-status-pending"
                                };

                                <tr id="task-row-@t.TaskId">

                                    <!-- TASK TITLE -->
                                    <td>

                                        <div class="task-name-wrap">

                                            <div class="task-item-icon">
                                                <i class="fa-solid fa-list-check"></i>
                                            </div>

                                            <div>
                                                <span class="task-name"
                                                      title="@t.TaskTitle">
                                                    @t.TaskTitle
                                                </span>

                                                <span class="task-name-meta">
                                                    Task #@t.TaskId
                                                </span>
                                            </div>

                                        </div>

                                    </td>


                                    <!-- DESCRIPTION -->
                                    <td>

                                        <div class="task-description"
                                             title="@t.Description">

                                            <div class="task-description-inner">
                                                @t.Description
                                            </div>

                                        </div>

                                    </td>


                                    <!-- DUE DATE -->
                                    <td>

                                        <div class="task-date">

                                            <span class="task-date-icon">
                                                <i class="fa-regular fa-calendar"></i>
                                            </span>

                                            <span>
                                                @t.DueDate.ToString("dd MMM yyyy")
                                            </span>

                                        </div>

                                    </td>


                                    <!-- STATUS -->
                                    <td>

                                        <span class="task-status @statusBadge"
                                              id="status-span-@t.TaskId">

                                            <span class="task-status-dot"></span>

                                            @t.Status

                                        </span>

                                    </td>


                                    <!-- ACTIONS -->
                                    <td class="text-center">

                                        <form method="post"
                                              action="@Url.Action("UpdateStatus", "ESSTasks")"
                                              class="task-action-form">

                                            @Html.AntiForgeryToken()

                                            <input type="hidden"
                                                   name="TaskId"
                                                   value="@t.TaskId" />

                                            @if (t.Status != "In Progress" && t.Status != "Completed")
                                            {
                                                <button type="submit"
                                                        name="Status"
                                                        value="In Progress"
                                                        class="task-action-btn task-start-btn"
                                                        title="Start Task">

                                                    <i class="fa-solid fa-play"></i>
                                                    <span>Start</span>

                                                </button>
                                            }

                                            @if (t.Status != "Completed")
                                            {
                                                <button type="submit"
                                                        name="Status"
                                                        value="Completed"
                                                        class="task-action-btn task-complete-btn"
                                                        title="Mark as Completed">

                                                    <i class="fa-solid fa-check"></i>
                                                    <span>Complete</span>

                                                </button>
                                            }
                                            else
                                            {
                                                <span class="task-done">
                                                    <i class="fa-solid fa-check-double"></i>
                                                    Done
                                                </span>
                                            }

                                        </form>

                                    </td>

                                </tr>
                            }
                        }
                        else
                        {
                            <!-- EMPTY STATE -->
                            <tr>
                                <td colspan="4">

                                    <div class="task-empty">

                                        <div class="task-empty-icon">
                                            <i class="fa-regular fa-clipboard"></i>
                                        </div>

                                        <h3 class="task-empty-title">
                                            No Tasks Assigned
                                        </h3>

                                        <p class="task-empty-text">
                                            There are currently no tasks assigned to you.
                                            New work items will appear here when they are assigned.

                                <td colspan="5">

                                    <div class="task-empty-state">

                                        <div class="task-empty-icon">
                                            <i class="fa-solid fa-clipboard-check"></i>
                                        </div>

                                        <h6 class="task-empty-title">
                                            No Tasks Currently Assigned
                                        </h6>

                                        <p class="task-empty-text">
                                            You are all caught up with your manager deliverables!
                                        </p>

                                    </div>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>


            <div class="task-list-footer">

                <div class="task-footer-info">
                    <i class="fa-solid fa-circle-info"></i>
                    Task information is updated through the ERP system.
                </div>

                <div>
                    ESS Task Management
            <!-- =================================================
                 CARD FOOTER
                 ================================================= -->
            <div class="task-card-footer">

                <div class="task-footer-note">
                    <i class="fa-solid fa-circle-info"></i>
                    <span>
                        Use the action buttons to update the current task status.
                    </span>
                </div>

                <div class="task-footer-note">
                    <i class="fa-solid fa-shield-halved"></i>
                    <span>
                        Manager-controlled assignments
                    </span>
                </div>

            </div>

        </div>

    </div>
</div>
            background: rgba(37, 99, 235, 0.035);
            pointer-events: none;
            filter: blur(2px);
        }

    @@keyframes taskPageIn {
        from

    {
        opacity: 0;
        transform: translateY(10px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }

    }

    /* ---------- TOP HEADER ---------- */

    .task-topbar {
        position: relative;
        z-index: 1;
        display: flex;
        justify-content: space-between;
        align-items: flex-end;

@model IEnumerable<ERP_System.Models.ESSTask>
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Assigned Tasks";
}

<div class="container-fluid py-4 text-start">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-bold mb-1"><i class="fa-solid fa-list-check text-primary me-2"></i>Assigned Tasks</h4>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0 small">
                    <li class="breadcrumb-item"><a href="/EmployeeDashboard" class="text-decoration-none">ESS</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Assigned Tasks</li>
                </ol>
            </nav>
        </div>
    </div>

    <!-- Task List -->
    <div class="bg-white border rounded-3 p-4 shadow-sm">
        <h5 class="fw-bold mb-3">Tasks Listing</h5>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" style="font-size: 0.85rem;">
                <thead class="table-light">
                    <tr>
                        <th>Task Title</th>
                        <th>Description</th>
                        <th>Due Date</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var t in Model)
                        {
                            <tr>
                                <td class="fw-bold text-dark">@t.TaskTitle</td>
                                <td class="text-muted" style="max-width: 350px;">@t.Description</td>
                                <td class="text-muted">@t.DueDate.ToString("dd MMM yyyy")</td>
                                <td>
                                    @if (t.Status == "Completed")
                                    {
                                        <span class="badge bg-success-subtle text-success rounded-pill px-2.5 py-1">Completed</span>
                                    }
                                    else if (t.Status == "In Progress")
                                    {
                                        <span class="badge bg-info-subtle text-info rounded-pill px-2.5 py-1">In Progress</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning-subtle text-warning rounded-pill px-2.5 py-1">Pending</span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4" class="text-center py-4 text-muted">No tasks assigned.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<style>
    /* =========================================================
           ASSIGNED TASKS — PREMIUM ERP UI
           ========================================================= */

    .task-page {
        --task-primary: #2563eb;
        --task-primary-dark: #1d4ed8;
        --task-success: #16a34a;
        --task-warning: #d97706;

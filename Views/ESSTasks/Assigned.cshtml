@model IEnumerable<ERP_System.Models.ESSTask>

@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Assigned Tasks — Deliverables";

    var totalTasks = Model?.Count() ?? 0;
    var completedTasks = Model?.Count(x => x.Status == "Completed") ?? 0;
    var pendingTasks = Model?.Count(x => x.Status != "Completed" && x.Status != "In Progress") ?? 0;
}

<style>
    /* =========================================================
           ASSIGNED TASKS — PREMIUM ERP UI
           ========================================================= */

    .ess-task-page {
        --task-primary: #2563eb;
        --task-primary-dark: #1d4ed8;
        --task-success: #16a34a;
        --task-warning: #d97706;
        --task-danger: #dc2626;
        --task-text: #172033;
        --task-muted: #718096;
        --task-border: #e7ebf2;
        --task-surface: #ffffff;
        --task-soft: #f7f9fc;
        min-height: calc(100vh - 80px);
        padding: 28px 0 42px;
        color: var(--task-text);
        background: radial-gradient( circle at 8% 0%, rgba(37, 99, 235, 0.055), transparent 28% ), radial-gradient( circle at 92% 12%, rgba(14, 165, 233, 0.045), transparent 25% ), #f5f7fb;
    }

    .task-shell {
        width: min(100% - 36px, 1480px);
        margin: 0 auto;
    }

    /* =========================================================
           PAGE HEADER
           ========================================================= */

    .task-page-header {
        position: relative;
        overflow: hidden;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 22px;
        padding: 24px 26px;
        margin-bottom: 22px;
        border: 1px solid rgba(226, 232, 240, 0.95);
        border-radius: 18px;
        background: rgba(255, 255, 255, 0.96);
        box-shadow: 0 12px 35px rgba(15, 23, 42, 0.055);
        animation: taskHeaderIn .55s ease both;
    }

        .task-page-header::before {
            content: "";
            position: absolute;
            width: 230px;
            height: 230px;
            top: -155px;
            right: -50px;
            border-radius: 50%;
            background: rgba(37, 99, 235, 0.075);
            pointer-events: none;
        }

        .task-page-header::after {
            content: "";
            position: absolute;
            width: 6px;
            height: 72%;
            left: 0;
            top: 14%;
            border-radius: 0 8px 8px 0;
            background: linear-gradient( 180deg, #2563eb, #60a5fa );
        }

    .task-title-area {
        position: relative;
        z-index: 2;
        min-width: 0;
        flex: 1;
    }

    .task-breadcrumb {
        position: relative;
        z-index: 2;
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 8px;
        margin-bottom: 11px;
        font-size: .76rem;
        font-weight: 600;
    }

        .task-breadcrumb a {
            color: #64748b;
            text-decoration: none;
            transition: color .2s ease, transform .2s ease;
        }

            .task-breadcrumb a:hover {
                color: var(--task-primary);
                transform: translateX(2px);
            }

    .task-breadcrumb-divider {
        color: #b4bcc9;
    }

    .task-section-label {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 5px 10px;
        border: 1px solid #dbeafe;
        border-radius: 999px;
        background: #eff6ff;
        color: #2563eb;
        font-size: .7rem;
        font-weight: 800;
        letter-spacing: .02em;
    }

    .task-title-row {
        display: flex;
        align-items: center;
        gap: 13px;
    }

    .task-title-icon {
        width: 47px;
        height: 47px;
        flex: 0 0 47px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 14px;
        background: linear-gradient( 135deg, #2563eb, #4f7ff0 );
        color: #fff;
        font-size: 18px;
        box-shadow: 0 10px 24px rgba(37, 99, 235, .20);
        animation: iconFloat 4s ease-in-out infinite;
    }

    .task-page-title {
        margin: 0;
        color: #162033;
        font-size: 1.42rem;
        font-weight: 800;
        line-height: 1.2;
        letter-spacing: -.35px;
    }

    .task-page-subtitle {
        margin: 5px 0 0;
        color: var(--task-muted);
        font-size: .84rem;
        line-height: 1.5;
    }

    .task-header-badge {
        position: relative;
        z-index: 2;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 10px 14px;
        border: 1px solid #e2e8f0;
        border-radius: 999px;
        background: #f8fafc;
        color: #475569;
        font-size: .74rem;
        font-weight: 700;
        white-space: nowrap;
    }

        .task-header-badge i {
            color: var(--task-primary);
        }

    /* =========================================================
           TOP ACTION BAR
           ========================================================= */

    .task-topbar {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 20px;
        margin-bottom: 18px;
    }

    .task-heading-area {
        min-width: 0;
    }

    .task-actions {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        flex-wrap: wrap;
        gap: 9px;
    }

    .task-nav-btn {
        min-height: 40px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        padding: 9px 14px;
        border-radius: 10px;
        font-size: .76rem;
        font-weight: 700;
        text-decoration: none;
        white-space: nowrap;
        transition: transform .2s ease, box-shadow .2s ease, border-color .2s ease, background .2s ease;
    }

        .task-nav-btn:hover {
            transform: translateY(-2px);
        }

    .task-nav-outline {
        color: #344054;
        background: #fff;
        border: 1px solid #dfe4ec;
        box-shadow: 0 4px 12px rgba(15, 23, 42, .035);
    }

        .task-nav-outline:hover {
            color: var(--task-primary);
            border-color: #bfd3fb;
            box-shadow: 0 8px 18px rgba(37, 99, 235, .08);
        }

    .task-nav-primary {
        color: #fff;
        background: linear-gradient( 135deg, #2563eb, #3b82f6 );
        border: 1px solid #2563eb;
        box-shadow: 0 8px 18px rgba(37, 99, 235, .16);
    }

        .task-nav-primary:hover {
            color: #fff;
            box-shadow: 0 12px 24px rgba(37, 99, 235, .23);
        }

    /* =========================================================
           SUMMARY CARDS
           ========================================================= */

    .task-summary {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 16px;
        margin-bottom: 20px;
    }

    .task-summary-card {
        position: relative;
        overflow: hidden;
        min-height: 104px;
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 19px;
        border: 1px solid var(--task-border);
        border-radius: 16px;
        background: #fff;
        box-shadow: 0 9px 26px rgba(15, 23, 42, .045);
        transition: transform .25s ease, box-shadow .25s ease, border-color .25s ease;
        animation: taskCardIn .55s ease both;
    }

        .task-summary-card:nth-child(2) {
            animation-delay: .07s;
        }

        .task-summary-card:nth-child(3) {
            animation-delay: .14s;
        }

        .task-summary-card:hover {
            transform: translateY(-3px);
            border-color: #d6deeb;
            box-shadow: 0 15px 34px rgba(15, 23, 42, .075);
        }

        .task-summary-card::after {
            content: "";
            position: absolute;
            width: 90px;
            height: 90px;
            right: -35px;
            bottom: -42px;
            border-radius: 50%;
            background: rgba(37, 99, 235, .045);
            pointer-events: none;
        }

    .task-summary-icon {
        width: 46px;
        height: 46px;
        flex: 0 0 46px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 13px;
        background: #eff6ff;
        color: #2563eb;
        font-size: 17px;
    }

    .task-summary-card:nth-child(2) .task-summary-icon {
        background: #ecfdf3;
        color: #16a34a;
    }

    .task-summary-card:nth-child(3) .task-summary-icon {
        background: #fff7ed;
        color: #d97706;
    }

    .task-summary-label {
        margin: 0 0 3px;
        color: #94a3b8;
        font-size: .7rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: .65px;
    }

    .task-summary-value {
        margin: 0;
        color: #182235;
        font-size: 1.25rem;
        line-height: 1.1;
        font-weight: 800;
    }

    .task-summary-note {
        margin-top: 4px;
        color: #94a3b8;
        font-size: .69rem;
    }

    /* =========================================================
           SUMMARY STRIP
           ========================================================= */

    .task-summary-strip {
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        align-items: center;
        gap: 15px;
        margin-bottom: 14px;
        padding: 13px 15px;
        border: 1px solid var(--task-border);
        border-radius: 14px;
        background: rgba(255, 255, 255, .92);
        box-shadow: 0 6px 20px rgba(15, 23, 42, .035);
        backdrop-filter: blur(8px);
    }

    .task-summary-left {
        display: flex;
        align-items: center;
        gap: 11px;
        min-width: 0;
    }

    .task-summary-mark {
        width: 35px;
        height: 35px;
        flex: 0 0 35px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 9px;
        background: #f1f5f9;
        color: #475569;
        font-size: .85rem;
    }

    .task-summary-title {
        margin: 0;
        color: #263247;
        font-size: .83rem;
        font-weight: 800;
    }

    .task-summary-caption {
        margin: 2px 0 0;
        color: #8a94a6;
        font-size: .7rem;
        line-height: 1.4;
    }

    .task-total-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 8px 11px;
        border: 1px solid #e5eaf1;
        border-radius: 9px;
        background: #f8fafc;
        color: #667085;
        font-size: .72rem;
        font-weight: 600;
        white-space: nowrap;
    }

        .task-total-badge i {
            color: #64748b;
        }

        .task-total-badge strong {
            color: #172033;
            font-weight: 800;
        }

    /* =========================================================
           TASK CARD
           ========================================================= */

    .task-card {
        position: relative;
        z-index: 1;
        overflow: hidden;
        border: 1px solid var(--task-border);
        border-radius: 18px;
        background: var(--task-surface);
        box-shadow: 0 12px 35px rgba(15, 23, 42, .055);
        animation: taskCardIn .65s ease .08s both;
    }

    .task-card-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 15px;
        padding: 17px 20px;
        border-bottom: 1px solid #edf0f5;
        background: linear-gradient( 180deg, #ffffff 0%, #fbfcfe 100% );
    }

    .task-card-heading {
        display: flex;
        align-items: center;
        gap: 11px;
        min-width: 0;
    }

    .task-card-heading-icon {
        width: 39px;
        height: 39px;
        flex: 0 0 39px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 10px;
        background: #eff6ff;
        color: #2563eb;
        font-size: 14px;
    }

    .task-card-title {
        margin: 0;
        color: #1f2937;
        font-size: .94rem;
        font-weight: 800;
    }

    .task-card-description {
        margin: 3px 0 0;
        color: #98a1b2;
        font-size: .69rem;
        line-height: 1.4;
    }

    .task-record-count {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 7px 11px;
        border: 1px solid #e2e8f0;
        border-radius: 999px;
        background: #f8fafc;
        color: #64748b;
        font-size: .68rem;
        font-weight: 700;
        white-space: nowrap;
    }

    /* =========================================================
           TABLE
           ========================================================= */

    .task-table-wrapper {
        width: 100%;
        overflow-x: auto;
        overflow-y: hidden;
        -webkit-overflow-scrolling: touch;
        scrollbar-width: thin;
        scrollbar-color: #cbd5e1 transparent;
    }

        .task-table-wrapper::-webkit-scrollbar {
            height: 7px;
        }

        .task-table-wrapper::-webkit-scrollbar-track {
            background: #f3f5f8;
        }

        .task-table-wrapper::-webkit-scrollbar-thumb {
            background: #cbd3df;
            border-radius: 20px;
        }

    .task-table {
        width: 100%;
        min-width: 880px;
        margin: 0;
        border-collapse: separate;
        border-spacing: 0;
        font-size: .81rem;
    }

        .task-table thead th {
            padding: 13px 14px;
            background: #f8fafc;
            color: #7b8494;
            border-bottom: 1px solid #e8edf3;
            font-size: .66rem;
            font-weight: 800;
            letter-spacing: .055em;
            text-transform: uppercase;
            white-space: nowrap;
        }

            .task-table thead th:first-child {
                padding-left: 22px;
            }

            .task-table thead th:last-child {
                padding-right: 22px;
            }

        .task-table tbody tr {
            animation: rowReveal .45s ease both;
            transition: background-color .2s ease;
        }

            .task-table tbody tr:nth-child(1) {
                animation-delay: .04s;
            }

            .task-table tbody tr:nth-child(2) {
                animation-delay: .07s;
            }

            .task-table tbody tr:nth-child(3) {
                animation-delay: .10s;
            }

            .task-table tbody tr:nth-child(4) {
                animation-delay: .13s;
            }

            .task-table tbody tr:nth-child(5) {
                animation-delay: .16s;
            }

            .task-table tbody tr:hover td {
                background: #f9fbff;
            }

        .task-table tbody td {
            padding: 16px 14px;
            border-bottom: 1px solid #edf1f5;
            background: #fff;
            color: #475569;
            vertical-align: middle;
            transition: background .2s ease;
        }

            .task-table tbody td:first-child {
                padding-left: 22px;
            }

            .task-table tbody td:last-child {
                padding-right: 22px;
            }

        .task-table tbody tr:last-child td {
            border-bottom: none;
        }

    /* =========================================================
           TASK NAME
           ========================================================= */

    .task-name-wrap {
        display: flex;
        align-items: center;
        gap: 11px;
        min-width: 220px;
    }

    .task-item-icon {
        width: 36px;
        height: 36px;
        flex: 0 0 36px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border: 1px solid #e7ebf1;
        border-radius: 10px;
        background: #f3f6fa;
        color: #64748b;
        transition: background-color .2s ease, color .2s ease, transform .2s ease;
    }

    .task-table tbody tr:hover .task-item-icon {
        background: #eff6ff;
        color: #2563eb;
        transform: scale(1.05);
    }

    .task-name {
        display: block;
        max-width: 290px;
        overflow: hidden;
        color: #1d2939;
        font-size: .81rem;
        font-weight: 800;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .task-name-meta {
        display: block;
        margin-top: 3px;
        color: #98a2b3;
        font-size: .65rem;
    }

    /* =========================================================
           DESCRIPTION
           ========================================================= */

    .task-description {
        width: 100%;
        max-width: 360px;
        color: #737e91;
        font-size: .76rem;
        line-height: 1.45;
    }

    .task-description-inner {
        overflow: hidden;
        display: -webkit-box;
        -webkit-box-orient: vertical;
        -webkit-line-clamp: 2;
        text-overflow: ellipsis;
    }

    /* =========================================================
           DATE
           ========================================================= */

    .task-date {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        color: #596579;
        font-size: .76rem;
        font-weight: 700;
        white-space: nowrap;
    }

    .task-date-icon {
        width: 29px;
        height: 29px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 8px;
        background: #fff4f4;
        color: #dc2626;
        font-size: .72rem;
    }

    /* =========================================================
           STATUS
           ========================================================= */

    .task-status {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        min-width: 104px;
        padding: 7px 11px;
        border: 1px solid transparent;
        border-radius: 999px;
        font-size: .67rem;
        font-weight: 800;
        line-height: 1;
        white-space: nowrap;
    }

    .task-status-dot {
        width: 6px;
        height: 6px;
        flex: 0 0 6px;
        border-radius: 50%;
        background: currentColor;
    }

    .task-status-completed {
        color: #15803d;
        background: #f0fdf4;
        border-color: #dcfce7;
    }

        .task-status-completed .task-status-dot {
            box-shadow: 0 0 0 3px rgba(34, 197, 94, .10);
        }

    .task-status-progress {
        color: #0e7490;
        background: #ecfeff;
        border-color: #cffafe;
    }

        .task-status-progress .task-status-dot {
            animation: statusPulse 1.8s ease-in-out infinite;
            box-shadow: 0 0 0 3px rgba(8, 145, 178, .10);
        }

    .task-status-pending {
        color: #b45309;
        background: #fffbeb;
        border-color: #fef3c7;
    }

        .task-status-pending .task-status-dot {
            box-shadow: 0 0 0 3px rgba(217, 119, 6, .10);
        }

    /* =========================================================
           ACTIONS
           ========================================================= */

    .task-action-form {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        margin: 0;
    }

    .task-action-btn {
        min-height: 33px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 5px;
        padding: 7px 10px;
        border: 1px solid;
        border-radius: 8px;
        background: #fff;
        font-size: .68rem;
        font-weight: 800;
        transition: transform .18s ease, box-shadow .18s ease, background-color .18s ease, color .18s ease;
    }

        .task-action-btn:hover {
            transform: translateY(-2px);
        }

    .task-start-btn {
        color: #2563eb;
        border-color: #cfe0ff;
    }

        .task-start-btn:hover {
            color: #fff;
            background: #2563eb;
            border-color: #2563eb;
            box-shadow: 0 6px 14px rgba(37, 99, 235, .17);
        }

    .task-complete-btn {
        color: #16803c;
        border-color: #cbeed7;
    }

        .task-complete-btn:hover {
            color: #fff;
            background: #16a34a;
            border-color: #16a34a;
            box-shadow: 0 6px 14px rgba(22, 163, 74, .17);
        }

    .task-done {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 7px 10px;
        color: #16803c;
        background: #f0fdf4;
        border: 1px solid #d1f1dc;
        border-radius: 8px;
        font-size: .68rem;
        font-weight: 800;
    }

    /* =========================================================
           EMPTY STATE
           ========================================================= */

    .task-empty-state {
        padding: 64px 24px;
        text-align: center;
    }

    .task-empty-icon {
        width: 68px;
        height: 68px;
        margin: 0 auto 16px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border: 1px solid #e9edf2;
        border-radius: 19px;
        background: #f5f7fa;
        color: #98a2b3;
        font-size: 25px;
        animation: emptyFloat 3.5s ease-in-out infinite;
    }

    .task-empty-title {
        margin: 0 0 7px;
        color: #344054;
        font-size: .96rem;
        font-weight: 800;
    }

    .task-empty-text {
        max-width: 420px;
        margin: 0 auto;
        color: #94a3b8;
        font-size: .76rem;
        line-height: 1.6;
    }

    /* =========================================================
           CARD FOOTER
           ========================================================= */

    .task-card-footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 15px;
        padding: 12px 20px;
        background: #fbfcfe;
        border-top: 1px solid #edf0f4;
    }

    .task-footer-note {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        color: #98a2b3;
        font-size: .67rem;
    }

        .task-footer-note i {
            color: #94a3b8;
        }

    /* =========================================================
           ANIMATIONS
           ========================================================= */

    @@keyframes taskHeaderIn {
        from {
            opacity: 0;
            transform: translateY(-10px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@keyframes taskCardIn {
        from {
            opacity: 0;
            transform: translateY(14px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@keyframes rowReveal {
        from {
            opacity: 0;
            transform: translateX(-7px);
        }

        to {
            opacity: 1;
            transform: translateX(0);
        }
    }

    @@keyframes iconFloat {
        0%,
        100% {
            transform: translateY(0);
        }

        50% {
            transform: translateY(-3px);
        }
    }

    @@keyframes statusPulse {
        0%,
        100% {
            opacity: 1;
            transform: scale(1);
        }

        50% {
            opacity: .55;
            transform: scale(.78);
        }
    }

    @@keyframes emptyFloat {
        0%,
        100% {
            transform: translateY(0);
        }

        50% {
            transform: translateY(-5px);
        }
    }

    /* =========================================================
           RESPONSIVE — TABLET
           ========================================================= */

    @@media (max-width: 1100px) {

        .task-topbar {
            align-items: flex-start;
            flex-direction: column;
        }

        .task-actions {
            width: 100%;
            justify-content: flex-start;
        }

        .task-page-header {
            align-items: flex-start;
        }

        .task-header-badge {
            margin-top: 4px;
        }
    }

    @@media (max-width: 992px) {

        .task-shell {
            width: min(100% - 28px, 1480px);
        }

        .task-summary {
            gap: 12px;
        }

        .task-summary-card {
            padding: 16px;
        }

        .task-summary-icon {
            width: 42px;
            height: 42px;
            flex-basis: 42px;
        }

        .task-summary-value {
            font-size: 1.08rem;
        }

        .task-description {
            max-width: 300px;
        }
    }

    /* =========================================================
           RESPONSIVE — MOBILE
           ========================================================= */

    @@media (max-width: 768px) {

        .ess-task-page {
            padding-top: 18px;
        }

        .task-shell {
            width: min(100% - 22px, 1480px);
        }

        .task-page-header {
            display: block;
            padding: 20px;
            border-radius: 15px;
        }

        .task-title-row {
            gap: 10px;
        }

        .task-title-icon {
            width: 42px;
            height: 42px;
            flex-basis: 42px;
        }

        .task-page-title {
            font-size: 1.2rem;
        }

        .task-page-subtitle {
            font-size: .77rem;
        }

        .task-header-badge {
            display: inline-flex;
            margin-top: 15px;
        }

        .task-summary {
            grid-template-columns: 1fr;
            gap: 10px;
        }

        .task-summary-card {
            min-height: 82px;
        }

        .task-summary-strip {
            grid-template-columns: 1fr;
            align-items: flex-start;
        }

        .task-total-badge {
            width: 100%;
            justify-content: center;
        }

        .task-card {
            border-radius: 15px;
        }

        .task-card-header {
            align-items: flex-start;
            flex-direction: column;
            padding: 16px;
        }

        .task-record-count {
            width: 100%;
            justify-content: center;
        }

        .task-table {
            min-width: 820px;
        }

            .task-table thead th {
                padding: 12px 14px;
            }

            .task-table tbody td {
                padding: 15px 14px;
            }

                .task-table tbody td:first-child,
                .task-table thead th:first-child {
                    padding-left: 17px;
                }

        .task-card-footer {
            align-items: flex-start;
            flex-direction: column;
            padding: 12px 16px;
        }
    }

    @@media (max-width: 480px) {

        .task-shell {
            width: calc(100% - 16px);
        }

        .task-page-header {
            padding: 17px;
        }

        .task-title-icon {
            width: 38px;
            height: 38px;
            flex-basis: 38px;
            border-radius: 10px;
            font-size: .9rem;
        }

        .task-page-title {
            font-size: 1.08rem;
        }

        .task-page-subtitle {
            font-size: .73rem;
        }

        .task-breadcrumb {
            font-size: .7rem;
        }

        .task-actions {
            display: grid;
            grid-template-columns: 1fr;
            width: 100%;
        }

        .task-nav-btn {
            width: 100%;
        }

        .task-summary-card {
            padding: 14px;
            border-radius: 13px;
        }

        .task-summary-icon {
            width: 38px;
            height: 38px;
            flex-basis: 38px;
            border-radius: 10px;
        }

        .task-summary-label {
            font-size: .64rem;
        }

        .task-summary-value {
            font-size: 1rem;
        }

        .task-summary-caption {
            line-height: 1.4;
        }

        .task-card-header {
            padding: 14px;
        }

        .task-card-heading-icon {
            width: 35px;
            height: 35px;
            flex-basis: 35px;
        }

        .task-card-title {
            font-size: .86rem;
        }

        .task-card-description {
            display: none;
        }

        .task-table {
            min-width: 760px;
        }

        .task-card-footer {
            font-size: .62rem;
        }

        .task-empty-state {
            padding: 50px 18px;
        }
    }

    /* =========================================================
           ACCESSIBILITY
           ========================================================= */

    @@media (prefers-reduced-motion: reduce) {

        .task-page-header,
        .task-summary-card,
        .task-card,
        .task-table tbody tr,
        .task-title-icon,
        .task-empty-icon {
            animation: none !important;
        }

        .task-summary-card,
        .task-nav-btn,
        .task-action-btn,
        .task-item-icon {
            transition: none !important;
        }

        .task-status-progress .task-status-dot {
            animation: none !important;
        }
    }
</style>


<div class="container-fluid text-start ess-task-page">

    <div class="task-shell">

        <!-- =====================================================
             PAGE HEADER
             ===================================================== -->

        <div class="task-page-header">

            <div class="task-title-area">

                <!-- Breadcrumb -->
                <div class="task-breadcrumb">

                    <a href="/Accountant">
                        <i class="fa fa-arrow-left me-1"></i>
                        Accountant Desk
                    </a>

                    <span class="task-breadcrumb-divider">/</span>

                    <span class="task-section-label">
                        <i class="fa-solid fa-briefcase"></i>
                        Manager Directives
                    </span>

                </div>

                <!-- Title -->
                <div class="task-title-row">

                    <div class="task-title-icon">
                        <i class="fa-solid fa-list-check"></i>
                    </div>

                    <div>

                        <h1 class="task-page-title">
                            Assigned Tasks
                        </h1>

                        <p class="task-page-subtitle">
                            Review and monitor tasks assigned to you.
                        </p>

                    </div>

                </div>

                <!-- Secondary Breadcrumb -->
                <div class="task-breadcrumb" style="margin-top: 10px; margin-bottom: 0;">

                    <nav aria-label="breadcrumb">

                        <ol class="breadcrumb mb-0">

                            <li class="breadcrumb-item">

                                <a href="/EmployeeDashboard">
                                    <i class="fa-solid fa-house me-1"></i>
                                    ESS
                                </a>

                            </li>

                            <li class="breadcrumb-item active" aria-current="page">
                                Assigned Tasks
                            </li>

                        </ol>

                    </nav>

                </div>

            </div>


            <!-- Header Badge -->
            <div class="task-header-badge">

                <i class="fa-solid fa-shield-halved"></i>

                <span>
                    Employee Task Center
                </span>

            </div>

        </div>


        <!-- =====================================================
             TOP ACTIONS
             ===================================================== -->

        <div class="task-topbar">

            <div class="task-heading-area">

                <span class="task-section-label">
                    <i class="fa-solid fa-clipboard-list"></i>
                    Your Deliverables
                </span>

            </div>


            <div class="task-actions">

                <a href="@Url.Action("StatusUpdate", "ESSTasks")"
                   class="task-nav-btn task-nav-outline">

                    <i class="fa-solid fa-pen-to-square"></i>

                    <span>
                        Status Center
                    </span>

                </a>


                <a href="@Url.Action("Timesheet", "ESSTasks")"
                   class="task-nav-btn task-nav-outline">

                    <i class="fa-solid fa-clock"></i>

                    <span>
                        Timesheet
                    </span>

                </a>


                <a href="@Url.Action("Index", "Accountant")"
                   class="task-nav-btn task-nav-primary">

                    <i class="fa-solid fa-calculator"></i>

                    <span>
                        Accountant Hub
                    </span>

                </a>

            </div>

        </div>


        <!-- =====================================================
             SUMMARY CARDS
             ===================================================== -->

        <div class="task-summary">

            <!-- Total -->
            <div class="task-summary-card">

                <div class="task-summary-icon">
                    <i class="fa-solid fa-layer-group"></i>
                </div>

                <div>

                    <p class="task-summary-label">
                        Total Tasks
                    </p>

                    <p class="task-summary-value">
                        @totalTasks
                    </p>

                    <div class="task-summary-note">
                        Assigned to you
                    </div>

                </div>

            </div>


            <!-- Completed -->
            <div class="task-summary-card">

                <div class="task-summary-icon">
                    <i class="fa-solid fa-circle-check"></i>
                </div>

                <div>

                    <p class="task-summary-label">
                        Completed
                    </p>

                    <p class="task-summary-value">
                        @completedTasks
                    </p>

                    <div class="task-summary-note">
                        Successfully completed
                    </div>

                </div>

            </div>


            <!-- Pending -->
            <div class="task-summary-card">

                <div class="task-summary-icon">
                    <i class="fa-solid fa-hourglass-half"></i>
                </div>

                <div>

                    <p class="task-summary-label">
                        Pending
                    </p>

                    <p class="task-summary-value">
                        @pendingTasks
                    </p>

                    <div class="task-summary-note">
                        Awaiting completion
                    </div>

                </div>

            </div>

        </div>


        <!-- =====================================================
             SUMMARY STRIP
             ===================================================== -->

        <div class="task-summary-strip">

            <div class="task-summary-left">

                <div class="task-summary-mark">
                    <i class="fa-solid fa-clipboard-list"></i>
                </div>

                <div>

                    <p class="task-summary-title">
                        Active Deliverables
                    </p>

                    <p class="task-summary-caption">
                        Manager-assigned work items requiring your attention
                    </p>

                </div>

            </div>


            <div class="task-total-badge">

                <i class="fa-solid fa-layer-group"></i>

                <span>
                    Total Tasks:
                </span>

                <strong>
                    @totalTasks
                </strong>

            </div>

        </div>


        <!-- =====================================================
             TASK REGISTER CARD
             ===================================================== -->

        <div class="task-card">

            <!-- Card Header -->
            <div class="task-card-header">

                <div class="task-card-heading">

                    <div class="task-card-heading-icon">
                        <i class="fa-solid fa-list-check"></i>
                    </div>

                    <div>

                        <h5 class="task-card-title">
                            Active Deliverables Listing
                        </h5>

                        <p class="task-card-description">
                            Review deadlines, monitor progress and update task completion status.
                        </p>

                    </div>

                </div>


                <div class="task-record-count">

                    <i class="fa-solid fa-list"></i>

                    @totalTasks Records

                </div>

            </div>


            <!-- =================================================
                 TASK TABLE
                 ================================================= -->

            <div class="task-table-wrapper">

                <table class="task-table align-middle">

                    <thead>

                        <tr>

                            <th>
                                Task Title
                            </th>

                            <th>
                                Description
                            </th>

                            <th>
                                Due Date
                            </th>

                            <th>
                                Status
                            </th>

                            <th class="text-center">
                                Actions
                            </th>

                        </tr>

                    </thead>


                    <tbody>

                        @if (Model != null && Model.Any())
                        {
                            var rowIndex = 0;

                            foreach (var t in Model)
                            {
                                var statusBadge = t.Status switch
                                {
                                    "Completed" => "task-status-completed",
                                    "In Progress" => "task-status-progress",
                                    _ => "task-status-pending"
                                };

                                <tr style="animation-delay: @(rowIndex * 0.045)s;">

                                    <!-- TASK TITLE -->
                                    <td>

                                        <div class="task-name-wrap">

                                            <div class="task-item-icon">
                                                <i class="fa-solid fa-list-check"></i>
                                            </div>

                                            <div>

                                                <span class="task-name"
                                                      title="@t.TaskTitle">

                                                    @t.TaskTitle

                                                </span>

                                                <span class="task-name-meta">

                                                    Task #@t.TaskId

                                                </span>

                                            </div>

                                        </div>

                                    </td>


                                    <!-- DESCRIPTION -->
                                    <td>

                                        <div class="task-description"
                                             title="@t.Description">

                                            <div class="task-description-inner">
                                                @t.Description
                                            </div>

                                        </div>

                                    </td>


                                    <!-- DUE DATE -->
                                    <td>

                                        <div class="task-date">

                                            <span class="task-date-icon">

                                                <i class="fa-regular fa-calendar"></i>

                                            </span>

                                            <span>
                                                @t.DueDate.ToString("dd MMM yyyy")
                                            </span>

                                        </div>

                                    </td>


                                    <!-- STATUS -->
                                    <td>

                                        <span class="task-status @statusBadge"
                                              id="status-span-@t.TaskId">

                                            <span class="task-status-dot"></span>

                                            @t.Status

                                        </span>

                                    </td>


                                    <!-- ACTIONS -->
                                    <td class="text-center">

                                        <form method="post"
                                              action="@Url.Action("UpdateStatus", "ESSTasks")"
                                              class="task-action-form">

                                            @Html.AntiForgeryToken()

                                            <input type="hidden"
                                                   name="TaskId"
                                                   value="@t.TaskId" />


                                            @if (t.Status != "In Progress" && t.Status != "Completed")
                                            {
                                                <button type="submit"
                                                        name="Status"
                                                        value="In Progress"
                                                        class="task-action-btn task-start-btn"
                                                        title="Start Task">

                                                    <i class="fa-solid fa-play"></i>

                                                    <span>
                                                        Start
                                                    </span>

                                                </button>
                                            }


                                            @if (t.Status != "Completed")
                                            {
                                                <button type="submit"
                                                        name="Status"
                                                        value="Completed"
                                                        class="task-action-btn task-complete-btn"
                                                        title="Mark as Completed">

                                                    <i class="fa-solid fa-check"></i>

                                                    <span>
                                                        Complete
                                                    </span>

                                                </button>
                                            }
                                            else
                                            {
                                                <span class="task-done">

                                                    <i class="fa-solid fa-check-double"></i>

                                                    Done

                                                </span>
                                            }

                                        </form>

                                    </td>

                                </tr>

                                rowIndex++;
                            }
                        }
                        else
                        {
                            <!-- EMPTY STATE -->
                            <tr>

                                <td colspan="5">

                                    <div class="task-empty-state">

                                        <div class="task-empty-icon">

                                            <i class="fa-solid fa-clipboard-check"></i>

                                        </div>

                                        <h6 class="task-empty-title">

                                            No Tasks Currently Assigned

                                        </h6>

                                        <p class="task-empty-text">

                                            You are all caught up with your manager deliverables!

                                        </p>

                                    </div>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>


            <!-- =================================================
                 CARD FOOTER
                 ================================================= -->

            <div class="task-card-footer">

                <div class="task-footer-note">

                    <i class="fa-solid fa-circle-info"></i>

                    <span>
                        Use the action buttons to update the current task status.
                    </span>

                </div>


                <div class="task-footer-note">

                    <i class="fa-solid fa-shield-halved"></i>

                    <span>
                        Manager-controlled assignments
                    </span>

                </div>

            </div>

        </div>

    </div>

</div>
    /* ---------- DESCRIPTION ---------- */

    .task-description {
        width: 100%;
        max-width: 350px;
        color: #737e91;
        font-size: .76rem;
        line-height: 1.45;
    }

    .task-description-inner {
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    /* ---------- DUE DATE ---------- */

    .task-date {
        display: inline-flex;
        align-items: center;
        gap: .45rem;
        color: #596579;
        font-size: .76rem;
        font-weight: 700;
        white-space: nowrap;
    }

    .task-date-icon {
        width: 29px;
        height: 29px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 8px;
        background: #fff4f4;
        color: #dc2626;
        font-size: .72rem;
    }

    /* ---------- STATUS ---------- */

    .task-status {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        min-width: 105px;
        justify-content: center;
        padding: 7px 11px;
        border-radius: 999px;
        font-size: .68rem;
        font-weight: 800;
        line-height: 1;
        white-space: nowrap;
        border: 1px solid transparent;
        gap: .42rem;
        min-width: 102px;
        justify-content: center;
        padding: .46rem .7rem;
        border-radius: 999px;
        font-size: .68rem;
        font-weight: 800;
        letter-spacing: .01em;
        white-space: nowrap;
    }

    .task-status-dot {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: currentColor;
        box-shadow: 0 0 0 3px rgba(100, 116, 139, 0.08);
    }

    .task-status-completed {
        color: #15803d;
        background: #f0fdf4;
        border-color: #dcfce7;
    }

        .task-status-completed .task-status-dot {
            box-shadow: 0 0 0 3px rgba(34, 197, 94, .10);
        }

    .task-status-progress {
        color: #0e7490;
        background: #ecfeff;
        border-color: #cffafe;
    }

        .task-status-progress .task-status-dot {
            animation: statusPulse 1.8s ease-in-out infinite;
            box-shadow: 0 0 0 3px rgba(8, 145, 178, .10);
        }

    .task-status-pending {
        color: #b45309;
        background: #fffbeb;
        border-color: #fef3c7;
    }

        .task-status-pending .task-status-dot {
            box-shadow: 0 0 0 3px rgba(217, 119, 6, .10);
        }

    /* =========================================================
           EMPTY STATE
           ========================================================= */

    .task-empty {
        padding: 64px 24px;
        box-shadow: 0 0 0 3px rgba(255,255,255,.7);
    }

    .task-status-completed {
        background: #ecfdf3;
        color: #16803c;
        border: 1px solid #c9f1d8;
    }

    .task-status-progress {
        background: #eff6ff;
        color: #2563eb;
        border: 1px solid #d5e5ff;
    }

    .task-status-pending {
        background: #fff8eb;
        color: #b56a00;
        border: 1px solid #f6dfb2;
    }

    /* ---------- ACTIONS ---------- */

    .task-action-form {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: .4rem;
        margin: 0;
    }

    .task-action-btn {
        min-height: 33px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: .35rem;
        padding: .4rem .65rem;
        border-radius: 8px;
        background: #fff;
        font-size: .7rem;
        font-weight: 800;
        border: 1px solid;
        transition: transform .18s ease, box-shadow .18s ease, background-color .18s ease, color .18s ease;
    }

        .task-action-btn:hover {
            transform: translateY(-2px);
        }

    .task-start-btn {
        color: #2563eb;
        border-color: #cfe0ff;
    }

        .task-start-btn:hover {
            color: #fff;
            background: #2563eb;
            border-color: #2563eb;
            box-shadow: 0 6px 14px rgba(37, 99, 235, .17);
        }

    .task-complete-btn {
        color: #16803c;
        border-color: #cbeed7;
    }

        .task-complete-btn:hover {
            color: #fff;
            background: #16a34a;
            border-color: #16a34a;
            box-shadow: 0 6px 14px rgba(22, 163, 74, .17);
        }

    .task-done {
        display: inline-flex;
        align-items: center;
        gap: .35rem;
        padding: .45rem .65rem;
        color: #16803c;
        background: #f0fdf4;
        border: 1px solid #d1f1dc;
        border-radius: 8px;
        font-size: .7rem;
        font-weight: 800;
    }

    /* ---------- EMPTY STATE ---------- */

    .task-empty-state {
        padding: 4rem 1.5rem;
        text-align: center;
    }

    .task-empty-icon {
        width: 66px;
        height: 66px;
        margin: 0 auto 16px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 18px;
        background: #f1f5f9;
        color: #94a3b8;
        font-size: 25px;
        animation: emptyFloat 3s ease-in-out infinite;
    }

    .task-empty-title {
        margin: 0 0 6px;
        color: #334155;
        font-size: .98rem;
        width: 72px;
        height: 72px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 1rem;
        border-radius: 20px;
        background: #f5f7fa;
        color: #98a2b3;
        font-size: 1.65rem;
        border: 1px solid #e9edf2;
        animation: emptyFloat 3.5s ease-in-out infinite;
    }

    @@keyframes emptyFloat {
        0%, 100%

    {
        transform: translateY(0);
    }

    50% {
        transform: translateY(-5px);
    }

    }

    .task-empty-title {
        margin: 0 0 .35rem;
        color: #344054;
        font-size: .95rem;
        font-weight: 800;
    }

    .task-empty-text {
        max-width: 390px;
        margin: 0 auto;
        color: #94a3b8;
        font-size: .78rem;
        line-height: 1.6;
    }

    /* =========================================================
           FOOTER
           ========================================================= */

    .task-list-footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 15px;
        padding: 13px 22px;
        border-top: 1px solid #edf1f5;
        background: #fbfcfe;
        color: #94a3b8;
        font-size: .68rem;
    }

    .task-footer-info {
        display: inline-flex;
        align-items: center;
        gap: 7px;
    }

        .task-footer-info i {
            color: #94a3b8;
        }

    /* =========================================================
           ANIMATIONS
           ========================================================= */

    @@keyframes taskHeaderIn {
        from {
            opacity: 0;
            transform: translateY(-10px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@keyframes taskCardIn {
        from {
            opacity: 0;
            transform: translateY(14px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@keyframes taskRowIn {
        from {
            opacity: 0;
            transform: translateX(-7px);
        }

        to {
            opacity: 1;
            transform: translateX(0);
        }
    }

    @@keyframes statusPulse {
        0%,
        100% {
            opacity: 1;
            transform: scale(1);
        }

        50% {
            opacity: .55;
            transform: scale(.78);
        }
    }

    @@keyframes emptyFloat {
        0%,
        100% {
            transform: translateY(0);
        }

        50% {
            transform: translateY(-5px);
        }
    }

    /* =========================================================
           RESPONSIVE
           ========================================================= */


@model IEnumerable<ERP_System.Models.ESSTask>
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Task Status Update";
}

<div class="container-fluid py-4 text-start">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-bold mb-1"><i class="fa-solid fa-arrows-spin text-primary me-2"></i>Task Status Update</h4>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0 small">
                    <li class="breadcrumb-item"><a href="/EmployeeDashboard" class="text-decoration-none">ESS</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Status Update</li>
                </ol>
            </nav>
        </div>
    </div>

    <!-- Task list with dropdown actions -->
    <div class="bg-white border rounded-3 p-4 shadow-sm">
        <h5 class="fw-bold mb-3">Update Progress</h5>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" style="font-size: 0.85rem;">
                <thead class="table-light">
                    <tr>
                        <th>Task Name</th>
                        <th>Current Status</th>
                        <th>Change Status Action</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var t in Model)
                        {
                            <tr>
                                <td class="fw-bold text-dark">@t.TaskTitle</td>
                                <td>
                                    @if (t.Status == "Completed")
                                    {
                                        <span class="badge bg-success-subtle text-success">Completed</span>
                                    }
                                    else if (t.Status == "In Progress")
                                    {
                                        <span class="badge bg-info-subtle text-info">In Progress</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning-subtle text-warning">Pending</span>
                                    }
                                </td>
                                <td>
                                    <form action="/ESSTasks/UpdateStatus" method="post" class="d-inline-flex gap-2">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="TaskId" value="@t.TaskId" />
                                        <select name="Status" class="form-select form-select-sm" style="width: 140px;">
                                            <option value="Pending" selected="@(t.Status == "Pending")">Pending</option>
                                            <option value="In Progress" selected="@(t.Status == "In Progress")">In Progress</option>
                                            <option value="Completed" selected="@(t.Status == "Completed")">Completed</option>
                                        </select>
                                        <button type="submit" class="btn btn-primary btn-sm rounded-pill px-2.5">Update</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="3" class="text-center py-4 text-muted">No task items assigned.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@model IEnumerable<ERP_System.Models.ESSTask>

@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Task Status Update";

    var totalTasks = Model?.Count() ?? 0;
    var pendingTasks = Model?.Count(x => x.Status == "Pending") ?? 0;
    var inProgressTasks = Model?.Count(x => x.Status == "In Progress") ?? 0;
    var completedTasks = Model?.Count(x => x.Status == "Completed") ?? 0;
}

<style>
    /* =========================================================
           TASK STATUS UPDATE - PREMIUM ERP UI
           ========================================================= */

    .task-status-page {
        --ts-primary: #2563eb;
        --ts-primary-dark: #1d4ed8;
        --ts-primary-soft: #eff6ff;
        --ts-success: #16a34a;
        --ts-success-soft: #f0fdf4;
        --ts-warning: #d97706;
        --ts-warning-soft: #fffbeb;
        --ts-info: #0891b2;
        --ts-info-soft: #ecfeff;
        --ts-danger: #dc2626;
        --ts-text: #172033;
        --ts-muted: #6b7280;
        --ts-border: #e8ecf3;
        --ts-surface: #ffffff;
        --ts-bg: #f6f8fc;
        min-height: calc(100vh - 70px);
        padding: 28px 0 40px;
        color: var(--ts-text);
        position: relative;
    }

        /* Soft background decoration */
        .task-status-page::before {
            content: "";
            position: absolute;
            width: 320px;
            height: 320px;
            top: 30px;
            right: -140px;
            border-radius: 50%;
            background: radial-gradient(circle, rgba(37, 99, 235, 0.07), transparent 68%);
            pointer-events: none;
        }

        .task-status-page::after {
            content: "";
            position: absolute;
            width: 260px;
            height: 260px;
            bottom: 30px;
            left: -130px;
            border-radius: 50%;
            background: radial-gradient(circle, rgba(14, 165, 233, 0.05), transparent 70%);
            pointer-events: none;
        }

    .task-status-inner {
        position: relative;
        z-index: 1;
    }

    /* =========================================================
           PAGE HEADER
           ========================================================= */

    .ts-page-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        margin-bottom: 24px;
        animation: tsFadeDown 0.55s ease both;
    }

    .ts-header-left {
        min-width: 0;
    }

    .ts-title-row {
        display: flex;
        align-items: center;
        gap: 13px;
        margin-bottom: 7px;
    }

    .ts-title-icon {
        width: 44px;
        height: 44px;
        flex: 0 0 44px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 13px;
        background: linear-gradient(135deg, #2563eb, #4f46e5);
        color: #fff;
        font-size: 18px;
        box-shadow: 0 10px 24px rgba(37, 99, 235, 0.20);
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

        .ts-title-icon:hover {
            transform: translateY(-3px) rotate(4deg);
            box-shadow: 0 14px 28px rgba(37, 99, 235, 0.28);
        }

    .ts-page-title {
        margin: 0;
        font-size: clamp(1.25rem, 2vw, 1.65rem);
        font-weight: 800;
        letter-spacing: -0.025em;
        color: #172033;
    }

    .ts-page-subtitle {
        margin: 2px 0 0;
        color: var(--ts-muted);
        font-size: 0.82rem;
    }

    .ts-breadcrumb {
        margin: 0;
        padding: 0;
        display: flex;
        align-items: center;
        gap: 6px;
        list-style: none;
        font-size: 0.78rem;
    }

    .ts-breadcrumb-item {
        color: #8a93a3;
    }

        .ts-breadcrumb-item a {
            color: #64748b;
            text-decoration: none;
            transition: color 0.2s ease;
        }

            .ts-breadcrumb-item a:hover {
                color: var(--ts-primary);
            }

        .ts-breadcrumb-item.active {
            color: #2563eb;
            font-weight: 600;
        }

    .ts-breadcrumb-separator {
        color: #c5cad4;
        font-size: 0.68rem;
    }

    /* =========================================================
           SUMMARY CARDS
           ========================================================= */

    .ts-summary-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 15px;
        margin-bottom: 22px;
        animation: tsFadeUp 0.6s ease 0.08s both;
    }

    .ts-summary-card {
        position: relative;
        overflow: hidden;
        background: var(--ts-surface);
        border: 1px solid var(--ts-border);
        border-radius: 16px;
        padding: 17px 18px;
        min-height: 100px;
        box-shadow: 0 6px 20px rgba(15, 23, 42, 0.045);
        transition: transform 0.3s ease, box-shadow 0.3s ease, border-color 0.3s ease;
    }

        .ts-summary-card::after {
            content: "";
            position: absolute;
            width: 90px;
            height: 90px;
            border-radius: 50%;
            right: -35px;
            top: -38px;
            background: rgba(37, 99, 235, 0.05);
            transition: transform 0.35s ease;
        }

        .ts-summary-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 14px 30px rgba(15, 23, 42, 0.08);
            border-color: #dbe3f0;
        }

            .ts-summary-card:hover::after {
                transform: scale(1.3);
            }

    .ts-summary-content {
        position: relative;
        z-index: 2;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
    }

    .ts-summary-label {
        margin: 0 0 4px;
        color: #7b8494;
        font-size: 0.73rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.055em;
    }

    .ts-summary-value {
        margin: 0;
        color: #182235;
        font-size: 1.45rem;
        line-height: 1;
        font-weight: 800;
    }

    .ts-summary-icon {
        width: 42px;
        height: 42px;
        flex: 0 0 42px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 12px;
        font-size: 16px;
    }

    .ts-summary-card.total .ts-summary-icon {
        color: #2563eb;
        background: #eff6ff;
    }

    .ts-summary-card.pending .ts-summary-icon {
        color: #d97706;
        background: #fffbeb;
    }

    .ts-summary-card.progress .ts-summary-icon {
        color: #0891b2;
        background: #ecfeff;
    }

    .ts-summary-card.completed .ts-summary-icon {
        color: #16a34a;
        background: #f0fdf4;
    }

    /* =========================================================
           MAIN PANEL
           ========================================================= */

    .ts-main-panel {
        background: rgba(255, 255, 255, 0.96);
        border: 1px solid var(--ts-border);
        border-radius: 18px;
        overflow: hidden;
        box-shadow: 0 10px 32px rgba(15, 23, 42, 0.055);
        animation: tsFadeUp 0.65s ease 0.15s both;
    }

    .ts-panel-header {
        padding: 20px 22px;
        border-bottom: 1px solid #edf0f5;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 15px;
        background: linear-gradient(180deg, #ffffff 0%, #fbfcfe 100%);
    }

    .ts-panel-title-wrap {
        display: flex;
        align-items: center;
        gap: 12px;
        min-width: 0;
    }

    .ts-panel-icon {
        width: 39px;
        height: 39px;
        flex: 0 0 39px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 11px;
        background: #eef4ff;
        color: var(--ts-primary);
        font-size: 15px;
    }

    .ts-panel-title {
        margin: 0;
        font-size: 1rem;
        font-weight: 800;
        color: #1c2638;
    }

    .ts-panel-description {
        margin: 2px 0 0;
        font-size: 0.75rem;
        color: #8a93a3;
    }

    .ts-task-count {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 7px 11px;
        border-radius: 999px;
        background: #f4f6fa;
        color: #596579;
        font-size: 0.72rem;
        font-weight: 700;
        white-space: nowrap;
    }

        .ts-task-count i {
            color: var(--ts-primary);
            font-size: 0.68rem;
        }

    /* =========================================================
           TABLE
           ========================================================= */

    .ts-table-wrap {
        width: 100%;
        overflow-x: auto;
        scrollbar-width: thin;
    }

    .ts-table {
        width: 100%;
        min-width: 760px;
        margin: 0;
        border-collapse: separate;
        border-spacing: 0;
    }

        .ts-table thead th {
            padding: 13px 22px;
            background: #f8f9fc;
            border-bottom: 1px solid #e9edf3;
            color: #6c7688;
            font-size: 0.69rem;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 0.06em;
            white-space: nowrap;
        }

        .ts-table tbody td {
            padding: 16px 22px;
            border-bottom: 1px solid #eef1f5;
            vertical-align: middle;
            background: #fff;
        }

        .ts-table tbody tr {
            transition: background 0.25s ease, transform 0.25s ease;
        }

            .ts-table tbody tr:hover td {
                background: #fafcff;
            }

            .ts-table tbody tr:last-child td {
                border-bottom: 0;
            }

    .ts-task-name-cell {
        min-width: 260px;
    }

    .ts-task-info {
        display: flex;
        align-items: center;
        gap: 11px;
    }

    .ts-task-avatar {
        width: 37px;
        height: 37px;
        flex: 0 0 37px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 10px;
        background: linear-gradient(135deg, #eef4ff, #f4f1ff);
        color: #4f46e5;
        font-size: 13px;
        transition: transform 0.3s ease;
    }

    .ts-table tbody tr:hover .ts-task-avatar {
        transform: scale(1.08);
    }

    .ts-task-name {
        display: block;
        color: #202b3e;
        font-size: 0.84rem;
        font-weight: 750;
        line-height: 1.35;
    }

    .ts-task-label {
        display: block;
        margin-top: 2px;
        color: #9aa2b1;
        font-size: 0.68rem;
    }

    /* =========================================================
           STATUS BADGES
           ========================================================= */

    .ts-status-badge {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 7px 11px;
        border-radius: 999px;
        font-size: 0.7rem;
        font-weight: 750;
        white-space: nowrap;
    }

    .ts-status-dot {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        display: inline-block;
    }

    .ts-status-badge.completed {
        background: #ecfdf3;
        color: #15803d;
    }

        .ts-status-badge.completed .ts-status-dot {
            background: #22c55e;
            box-shadow: 0 0 0 3px rgba(34, 197, 94, 0.10);
        }

    .ts-status-badge.progress {
        background: #ecfeff;
        color: #0e7490;
    }

        .ts-status-badge.progress .ts-status-dot {
            background: #06b6d4;
            box-shadow: 0 0 0 3px rgba(6, 182, 212, 0.10);
            animation: tsPulse 1.8s infinite;
        }

    .ts-status-badge.pending {
        background: #fffbeb;
        color: #b45309;
    }

        .ts-status-badge.pending .ts-status-dot {
            background: #f59e0b;
            box-shadow: 0 0 0 3px rgba(245, 158, 11, 0.10);
        }

    /* =========================================================
           ACTION AREA
           ========================================================= */

    .ts-action-form {
        display: flex;
        align-items: center;
        gap: 8px;
        min-width: 275px;
    }

    .ts-status-select {
        width: 155px;
        min-height: 36px;
        padding: 6px 34px 6px 11px;
        border: 1px solid #dfe5ee;
        border-radius: 9px;
        color: #344054;
        background-color: #fff;
        font-size: 0.76rem;
        font-weight: 600;
        box-shadow: none;
        transition: border-color 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
    }

        .ts-status-select:focus {
            border-color: #93b4f5;
            box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.09);
            outline: none;
        }

    .ts-update-btn {
        min-height: 36px;
        border: 0;
        padding: 7px 14px;
        border-radius: 9px;
        background: linear-gradient(135deg, #2563eb, #315ee8);
        color: #fff;
        font-size: 0.73rem;
        font-weight: 750;
        white-space: nowrap;
        box-shadow: 0 5px 12px rgba(37, 99, 235, 0.16);
        transition: transform 0.22s ease, box-shadow 0.22s ease, filter 0.22s ease;
    }

        .ts-update-btn:hover {
            color: #fff;
            transform: translateY(-2px);
            box-shadow: 0 8px 17px rgba(37, 99, 235, 0.23);
            filter: brightness(1.03);
        }

        .ts-update-btn:active {
            transform: translateY(0);
        }

        .ts-update-btn i {
            font-size: 0.68rem;
            margin-right: 5px;
        }

    /* =========================================================
           EMPTY STATE
           ========================================================= */

    .ts-empty-state {
        padding: 55px 20px !important;
        text-align: center;
        background: #fff !important;
    }

    .ts-empty-icon {
        width: 65px;
        height: 65px;
        margin: 0 auto 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 18px;
        background: #f3f6fb;
        color: #94a3b8;
        font-size: 23px;
        animation: tsFloat 3s ease-in-out infinite;
    }

    .ts-empty-title {
        margin: 0 0 5px;
        color: #394458;
        font-size: 0.9rem;
        font-weight: 800;
    }

    .ts-empty-text {
        margin: 0;
        color: #9aa2b1;
        font-size: 0.76rem;
    }

    /* =========================================================
           FOOTER NOTE
           ========================================================= */

    .ts-panel-footer {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 13px 22px;
        border-top: 1px solid #eef1f5;
        background: #fbfcfe;
        color: #8b94a3;
        font-size: 0.7rem;
    }

        .ts-panel-footer i {
            color: #64748b;
            font-size: 0.72rem;
        }

    /* =========================================================
           ANIMATIONS
           ========================================================= */

    @@keyframes tsFadeDown {
        from

    {
        opacity: 0;
        transform: translateY(-12px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }

    }

    @@keyframes tsFadeUp {
        from

    {
        opacity: 0;
        transform: translateY(16px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }

    }

    @@keyframes tsPulse {
        0%, 100%

    {
        opacity: 1;
    }

    50% {
        opacity: 0.45;
    }

    }

    @@keyframes tsFloat {
        0%, 100%

    {
        transform: translateY(0);
    }

    50% {
        transform: translateY(-5px);
    }

    }

    /* =========================================================
           TABLET
           ========================================================= */

    @@media (max-width: 1100px) {
        .ts-summary-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .ts-page-header {
            margin-bottom: 20px;
        }

        .ts-table thead th,
        .ts-table tbody td {
            padding-left: 17px;
            padding-right: 17px;
        }
    }

    /* =========================================================
           MOBILE
           ========================================================= */

    @@media (max-width: 767px) {
        .task-status-page {
            padding: 20px 0 30px;
        }

        .ts-page-header {
            align-items: flex-start;
            margin-bottom: 18px;
        }

        .ts-title-row {
            align-items: flex-start;
        }

        .ts-title-icon {
            width: 40px;
            height: 40px;
            flex-basis: 40px;
            border-radius: 11px;
            font-size: 16px;
        }

        .ts-page-title {
            font-size: 1.2rem;
        }

        .ts-page-subtitle {
            display: none;
        }

        .ts-summary-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 10px;
            margin-bottom: 16px;
        }

        .ts-summary-card {
            min-height: 88px;
            padding: 14px;
            border-radius: 14px;
        }

        .ts-summary-value {
            font-size: 1.25rem;
        }

        .ts-summary-icon {
            width: 35px;
            height: 35px;
            flex-basis: 35px;
            border-radius: 10px;
            font-size: 13px;
        }

        .ts-summary-label {
            font-size: 0.63rem;
        }

        .ts-panel-header {
            padding: 16px;
        }

        .ts-panel-description {
            display: none;
        }

        .ts-panel-title {
            font-size: 0.9rem;
        }

        .ts-panel-icon {
            width: 35px;
            height: 35px;
            flex-basis: 35px;
        }

        .ts-task-count {
            padding: 6px 9px;
            font-size: 0.65rem;
        }

        .ts-table {
            min-width: 690px;
        }

            .ts-table thead th {
                padding: 11px 14px;
                font-size: 0.64rem;
            }

            .ts-table tbody td {
                padding: 13px 14px;
            }

        .ts-task-avatar {
            width: 34px;
            height: 34px;
            flex-basis: 34px;
        }

        .ts-task-name {
            font-size: 0.78rem;
        }

        .ts-panel-footer {
            padding: 11px 15px;
            font-size: 0.66rem;
        }
    }

    /* =========================================================
           SMALL MOBILE
           ========================================================= */

    @@media (max-width: 430px) {
        .ts-summary-grid {
            gap: 8px;
        }

        .ts-summary-card {
            padding: 12px;
        }

        .ts-summary-content {
            gap: 7px;
        }

        .ts-summary-icon {
            width: 31px;
            height: 31px;
            flex-basis: 31px;
            font-size: 11px;
        }

        .ts-summary-value {
            font-size: 1.12rem;
        }

        .ts-title-icon {
            width: 37px;
            height: 37px;
            flex-basis: 37px;
        }

        .ts-page-title {
            font-size: 1.08rem;
        }

        .ts-breadcrumb {
            font-size: 0.7rem;
        }

        .ts-task-count {
            display: none;
        }
    }

    /* =========================================================
           REDUCED MOTION
           ========================================================= */

    @@media (prefers-reduced-motion: reduce) {
        .ts-page-header,
        .ts-summary-grid,
        .ts-main-panel {
            animation: none;
        }

        .ts-summary-card,
        .ts-update-btn,
        .ts-task-avatar,
        .ts-title-icon {
            transition: none;
        }

        .ts-status-badge.progress .ts-status-dot,
        .ts-empty-icon {
            animation: none;
        }
    }
</style>

<div class="container-fluid task-status-page">
    <div class="task-status-inner">

        <!-- =====================================================
             PAGE HEADER
             ===================================================== -->
        <div class="ts-page-header">

            <div class="ts-header-left">

                <div class="ts-title-row">
                    <div class="ts-title-icon">
                        <i class="fa-solid fa-arrows-spin"></i>
                    </div>

                    <div>
                        <h1 class="ts-page-title">Task Status Update</h1>
                        <p class="ts-page-subtitle">
                            Track and update the progress of your assigned work
                        </p>
                    </div>
                </div>

                <nav aria-label="breadcrumb">
                    <ol class="ts-breadcrumb">
                        <li class="ts-breadcrumb-item">
                            <a href="/EmployeeDashboard">ESS</a>
                        </li>

                        <li class="ts-breadcrumb-separator">
                            <i class="fa-solid fa-chevron-right"></i>
                        </li>

                        <li class="ts-breadcrumb-item active" aria-current="page">
                            Status Update
                        </li>
                    </ol>
                </nav>

            </div>

        </div>


        <!-- =====================================================
             SUMMARY CARDS
             ===================================================== -->
        <div class="ts-summary-grid">

            <div class="ts-summary-card total">
                <div class="ts-summary-content">
                    <div>
                        <p class="ts-summary-label">Total Tasks</p>
                        <p class="ts-summary-value">@totalTasks</p>
                    </div>

                    <div class="ts-summary-icon">
                        <i class="fa-solid fa-layer-group"></i>
                    </div>
                </div>
            </div>


            <div class="ts-summary-card pending">
                <div class="ts-summary-content">
                    <div>
                        <p class="ts-summary-label">Pending</p>
                        <p class="ts-summary-value">@pendingTasks</p>
                    </div>

                    <div class="ts-summary-icon">
                        <i class="fa-regular fa-clock"></i>
                    </div>
                </div>
            </div>


            <div class="ts-summary-card progress">
                <div class="ts-summary-content">
                    <div>
                        <p class="ts-summary-label">In Progress</p>
                        <p class="ts-summary-value">@inProgressTasks</p>
                    </div>

                    <div class="ts-summary-icon">
                        <i class="fa-solid fa-spinner"></i>
                    </div>
                </div>
            </div>


            <div class="ts-summary-card completed">
                <div class="ts-summary-content">
                    <div>
                        <p class="ts-summary-label">Completed</p>
                        <p class="ts-summary-value">@completedTasks</p>
                    </div>

                    <div class="ts-summary-icon">
                        <i class="fa-solid fa-circle-check"></i>
                    </div>
                </div>
            </div>

        </div>


        <!-- =====================================================
             MAIN TASK PANEL
             ===================================================== -->
        <div class="ts-main-panel">

            <div class="ts-panel-header">

                <div class="ts-panel-title-wrap">

                    <div class="ts-panel-icon">
                        <i class="fa-solid fa-list-check"></i>
                    </div>

                    <div>
                        <h2 class="ts-panel-title">Update Progress</h2>
                        <p class="ts-panel-description">
                            Change the current status of your assigned tasks
                        </p>
                    </div>

                </div>

                <div class="ts-task-count">
                    <i class="fa-solid fa-list"></i>
                    @totalTasks Task@(totalTasks == 1 ? "" : "s")
                </div>

            </div>


            <!-- =================================================
                 TASK TABLE
                 ================================================= -->
            <div class="ts-table-wrap">

                <table class="ts-table">

                    <thead>
                        <tr>
                            <th>Task Name</th>
                            <th>Current Status</th>
                            <th>Change Status Action</th>
                        </tr>
                    </thead>

                    <tbody>

                        @if (Model != null && Model.Any())
                        {
                            @foreach (var t in Model)
                            {
                                <tr>

                                    <!-- Task Name -->
                                    <td class="ts-task-name-cell">

                                        <div class="ts-task-info">

                                            <div class="ts-task-avatar">
                                                <i class="fa-solid fa-clipboard-check"></i>
                                            </div>

                                            <div>
                                                <span class="ts-task-name">
                                                    @t.TaskTitle
                                                </span>

                                                <span class="ts-task-label">
                                                    Assigned work item
                                                </span>
                                            </div>

                                        </div>

                                    </td>


                                    <!-- Current Status -->
                                    <td>

                                        @if (t.Status == "Completed")
                                        {
                                            <span class="ts-status-badge completed">
                                                <span class="ts-status-dot"></span>
                                                Completed
                                            </span>
                                        }
                                        else if (t.Status == "In Progress")
                                        {
                                            <span class="ts-status-badge progress">
                                                <span class="ts-status-dot"></span>
                                                In Progress
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="ts-status-badge pending">
                                                <span class="ts-status-dot"></span>
                                                Pending
                                            </span>
                                        }

                                    </td>


                                    <!-- Change Status -->
                                    <td>

                                        <form action="/ESSTasks/UpdateStatus"
                                              method="post"
                                              class="ts-action-form">

                                            @Html.AntiForgeryToken()

                                            <input type="hidden"
                                                   name="TaskId"
                                                   value="@t.TaskId" />

                                            <select name="Status"
                                                    class="form-select ts-status-select">

                                                <option value="Pending"
                                                        selected="@(t.Status == "Pending")">
                                                    Pending
                                                </option>

                                                <option value="In Progress"
                                                        selected="@(t.Status == "In Progress")">
                                                    In Progress
                                                </option>

                                                <option value="Completed"
                                                        selected="@(t.Status == "Completed")">
                                                    Completed
                                                </option>

                                            </select>

                                            <button type="submit"
                                                    class="btn ts-update-btn">

                                                <i class="fa-solid fa-rotate"></i>
                                                Update

                                            </button>

                                        </form>

                                    </td>

                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="3" class="ts-empty-state">

                                    <div class="ts-empty-icon">
                                        <i class="fa-regular fa-folder-open"></i>
                                    </div>

                                    <h3 class="ts-empty-title">
                                        No task items assigned
                                    </h3>

                                    <p class="ts-empty-text">
                                        There are currently no tasks available for status updates.
                                    </p>

                                </td>
                            </tr>
                        }

                    </tbody>

                </table>

            </div>


            <!-- =================================================
                 PANEL FOOTER
                 ================================================= -->
            <div class="ts-panel-footer">
                <i class="fa-solid fa-circle-info"></i>
                Select a new status and click Update to save the latest task progress.
            </div>

        </div>

    </div>
</div>
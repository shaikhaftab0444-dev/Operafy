@{
    Layout = null;
    var employee = ViewBag.Employee as ERP_System.Models.User;
    var company = ViewBag.Company as ERP_System.Models.Company ?? new ERP_System.Models.Company
    {
        CompanyName = "Wainfo Pvt Ltd",
        CompanyCode = "AIT001",
        AddressLine1 = "Main Office Road",
        City = "Aurangabad",
        State = "Maharashtra",
        Country = "India"
    };
    string fy = ViewBag.FinancialYear as string ?? "2025-2026";
    string ay = ViewBag.AssessmentYear as string ?? "2026-2027";
    decimal grossSalary = (decimal)(ViewBag.GrossSalary ?? 1020000m);
    decimal totalTds = (decimal)(ViewBag.TotalTds ?? 54000m);
    string empCode = employee?.UserCode ?? employee?.UserName ?? "EMP014";
    string empName = employee?.FullName ?? "Employee";
    string pdfFileName = $"Form16_{empCode}_{fy.Replace("-", "_")}.pdf";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Form 16 TDS Certificate - @empName - FY @fy</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>
    <style>
        body { 
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; 
            background-color: #f8fafc; 
            color: #1e293b; 
        }
        .form16-container { 
            max-width: 880px; 
            margin: 30px auto; 
            background: #fff; 
            border: 1px solid #cbd5e1; 
            padding: 35px 40px; 
            border-radius: 10px; 
            box-shadow: 0 4px 16px rgba(0,0,0,0.06); 
        }
        .table-bordered th, .table-bordered td { 
            border: 1px solid #cbd5e1 !important; 
            font-size: 0.85rem; 
            padding: 8px 12px; 
        }
        .section-header {
            background-color: #f1f5f9;
            font-weight: 700;
            color: #0f172a;
        }
        @@media print {
            body { 
                background: #fff; 
                margin: 0;
                padding: 0;
            }
            .form16-container { 
                border: none; 
                box-shadow: none; 
                margin: 0; 
                max-width: 100%; 
                width: 100%; 
                padding: 15px 5px; 
            }
            .no-print { 
                display: none !important; 
            }
        }
    </style>
</head>
<body>
    <div class="no-print text-center my-4">
        <button type="button" onclick="downloadPDF()" class="btn btn-success rounded-pill px-4 me-2 shadow-sm">
            <i class="fa-solid fa-file-arrow-down me-2"></i>Download as PDF
        </button>
        <button type="button" onclick="window.print()" class="btn btn-primary rounded-pill px-4 me-2 shadow-sm">
            <i class="fa-solid fa-print me-2"></i>Print
        </button>
        <button type="button" onclick="window.close()" class="btn btn-outline-secondary rounded-pill px-4">
            <i class="fa-solid fa-xmark me-2"></i>Close
        </button>
    </div>

    <div class="form16-container" id="form16PrintArea">
        <!-- Certificate Header -->
        <div class="text-center border-bottom pb-3 mb-3">
            <h5 class="fw-bold mb-1 text-uppercase tracking-wide">FORM NO. 16</h5>
            <div class="small text-muted">[See rule 31(1)(a)]</div>
            <h6 class="fw-bold text-primary mt-2 mb-0">PART A &amp; PART B</h6>
            <div class="small text-muted">Certificate under section 203 of the Income-tax Act, 1961 for tax deducted at source on salary</div>
        </div>

        <!-- Employer & Employee Details -->
        <table class="table table-bordered mb-3">
            <tbody>
                <tr>
                    <td class="section-header" style="width: 50%;">Name and Address of the Employer (Deductor)</td>
                    <td class="section-header" style="width: 50%;">Name and Address of the Employee (Deductee)</td>
                </tr>
                <tr>
                    <td class="align-top">
                        <strong class="text-primary">@company.CompanyName</strong><br />
                        <span class="text-muted small">@company.AddressLine1, @company.City, @company.State - @company.Country</span><br />
                        <span class="small">Company Code: <strong>@company.CompanyCode</strong></span>
                    </td>
                    <td class="align-top">
                        <strong>@empName</strong><br />
                        <span class="text-muted small">Designation: @(employee?.Role?.RoleName ?? "Software Professional")</span><br />
                        <span class="small">Employee ID: <strong>@empCode</strong></span>
                    </td>
                </tr>
            </tbody>
        </table>

        <!-- PAN & Period Details -->
        <table class="table table-bordered mb-3 text-center">
            <thead class="table-light">
                <tr>
                    <th>PAN of Deductor</th>
                    <th>TAN of Deductor</th>
                    <th>PAN of Employee</th>
                    <th>Financial Year</th>
                    <th>Assessment Year</th>
                </tr>
            </thead>
            <tbody>
                <tr class="fw-semibold">
                    <td>AABCO1234F</td>
                    <td>WAIN12345D</td>
                    <td>ABCDE1234F</td>
                    <td class="text-primary">@fy</td>
                    <td class="text-success">@ay</td>
                </tr>
            </tbody>
        </table>

        <!-- Summary of Salary & TDS Calculation -->
        <div class="fw-bold text-dark mb-2 small text-uppercase"><i class="fa-solid fa-calculator text-primary me-1.5"></i>Summary of Tax Computation (Part B)</div>
        <table class="table table-bordered mb-3">
            <tbody>
                <tr>
                    <td style="width: 70%;">1. Gross Salary (as per provisions contained in sec. 17(1))</td>
                    <td style="width: 30%;" class="text-end fw-bold">&#8377;@grossSalary.ToString("N2")</td>
                </tr>
                <tr>
                    <td>2. Less: Allowances to the extent exempt under section 10 (HRA / Conveyance)</td>
                    <td class="text-end text-muted">&#8377;50,000.00</td>
                </tr>
                <tr class="bg-light fw-semibold">
                    <td>3. Balance (1 - 2)</td>
                    <td class="text-end">&#8377;@((grossSalary - 50000m).ToString("N2"))</td>
                </tr>
                <tr>
                    <td>4. Deductions under section 16:<br />
                        <span class="text-muted small ps-3">(a) Standard Deduction u/s 16(ia): &#8377;50,000.00</span><br />
                        <span class="text-muted small ps-3">(b) Tax on Employment / PT u/s 16(iii): &#8377;2,400.00</span>
                    </td>
                    <td class="text-end text-muted align-middle">&#8377;52,400.00</td>
                </tr>
                <tr class="bg-light fw-semibold">
                    <td>5. Income chargeable under the head "Salaries" (3 - 4)</td>
                    <td class="text-end text-dark">&#8377;@((grossSalary - 50000m - 52400m).ToString("N2"))</td>
                </tr>
                <tr>
                    <td>6. Deductions under Chapter VI-A:<br />
                        <span class="text-muted small ps-3">(a) Section 80C (Provident Fund / Life Insurance): &#8377;125,000.00</span><br />
                        <span class="text-muted small ps-3">(b) Section 80D (Health Insurance / Mediclaim): &#8377;25,000.00</span>
                    </td>
                    <td class="text-end text-muted align-middle">&#8377;150,000.00</td>
                </tr>
                <tr class="table-primary fw-bold">
                    <td>7. Total Taxable Income (5 - 6)</td>
                    <td class="text-end text-primary fs-6">&#8377;@((grossSalary - 50000m - 52400m - 150000m).ToString("N2"))</td>
                </tr>
                <tr class="table-success fw-bold">
                    <td>8. Total Tax Deducted at Source (TDS) &amp; Deposited</td>
                    <td class="text-end text-success fs-6">&#8377;@totalTds.ToString("N2")</td>
                </tr>
            </tbody>
        </table>

        <!-- Verification / Declaration -->
        <div class="border p-3 rounded mb-3 bg-light" style="font-size: 0.8rem;">
            <strong>Verification:</strong><br />
            I, Authorized Signatory, working in the capacity of <strong>Head of Finance &amp; Taxation</strong>, do hereby certify that a sum of <strong>&#8377;@totalTds.ToString("N2")</strong> [Rupees Fifty-Four Thousand Only] has been deducted and deposited to the credit of the Central Government.
        </div>

        <!-- Signature Block -->
        <div class="row pt-4 mt-3 text-center" style="font-size: 0.82rem;">
            <div class="col-6 text-start ps-4">
                <div>Place: <strong>@company.City</strong></div>
                <div>Date: <strong>@DateTime.UtcNow.ToString("dd-MMM-yyyy")</strong></div>
            </div>
            <div class="col-6 text-end pe-4">
                <div class="border-top pt-2 d-inline-block text-center" style="min-width: 220px;">
                    <strong>For @company.CompanyName</strong><br />
                    <span class="text-muted small">Signature of person responsible for deduction of tax</span>
                </div>
            </div>
        </div>
    </div>

    <script>
        function downloadPDF() {
            const element = document.getElementById('form16PrintArea');
            const opt = {
                margin:       [8, 8, 8, 8],
                filename:     '@pdfFileName',
                image:        { type: 'jpeg', quality: 0.98 },
                html2canvas:  { scale: 2, useCORS: true, letterRendering: true },
                jsPDF:        { unit: 'mm', format: 'a4', orientation: 'portrait' }
            };
            html2pdf().set(opt).from(element).save();
        }
    </script>
</body>
</html>

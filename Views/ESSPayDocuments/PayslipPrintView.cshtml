@model ERP_System.Models.Payslip
@{
    Layout = null;
    var company = ViewBag.Company as ERP_System.Models.Company ?? new ERP_System.Models.Company
    {
        CompanyName = "Operafy ERP Systems Pvt Ltd",
        CompanyCode = "OPR001",
        AddressLine1 = "Tech Zone, Phase 2, Business District",
        City = "New Delhi",
        State = "Delhi",
        Country = "India"
    };
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Payslip - @(Model.User?.FullName ?? "Employee") - @Model.PayPeriod</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <style>
        body { 
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; 
            background-color: #f4f6f9; 
            color: #212529; 
        }
        .payslip-container { 
            max-width: 860px; 
            margin: 30px auto; 
            background: #fff; 
            border: 1px solid #d1d5db; 
            padding: 40px; 
            border-radius: 10px; 
            box-shadow: 0 4px 16px rgba(0,0,0,0.06); 
        }
        .header-line { 
            border-bottom: 2px solid #2563eb; 
            margin-bottom: 24px; 
            padding-bottom: 18px; 
        }
        .table-bordered th, .table-bordered td { 
            border: 1px solid #e2e8f0 !important; 
            font-size: 0.88rem; 
            padding: 9px 14px; 
        }
        .table-head-muted {
            background-color: #f8fafc;
            color: #475569;
            font-weight: 600;
        }
        @@media print {
            body { 
                background: #fff; 
                margin: 0;
                padding: 0;
            }
            .payslip-container { 
                border: none; 
                box-shadow: none; 
                margin: 0; 
                max-width: 100%; 
                width: 100%; 
                padding: 20px 10px; 
            }
            .no-print { 
                display: none !important; 
            }
        }
    </style>
</head>
<body>
    <div class="no-print text-center my-4">
        <button onclick="window.print()" class="btn btn-primary rounded-pill px-4 me-2 shadow-sm">
            <i class="fa-solid fa-print me-2"></i>Print / Save as PDF
        </button>
        <button onclick="window.close()" class="btn btn-outline-secondary rounded-pill px-4">
            <i class="fa-solid fa-xmark me-2"></i>Close
        </button>
    </div>

    <div class="payslip-container">
        <!-- Header -->
        <div class="header-line d-flex justify-content-between align-items-center">
            <div>
                <h3 class="fw-bold text-primary mb-1">
                    <i class="fa-solid fa-building me-2"></i>@(company.CompanyName)
                </h3>
                <div class="text-muted small">@(company.AddressLine1), @(company.City), @(company.State) - @(company.Country)</div>
                <div class="text-muted small mt-0.5">Company Code: <strong class="text-dark">@(company.CompanyCode)</strong></div>
            </div>
            <div class="text-end">
                <h4 class="fw-bold text-dark mb-1 tracking-wide">SALARY PAYSLIP</h4>
                <div class="badge bg-primary text-white px-3 py-2 fs-6">@Model.PayPeriod</div>
                @if (!string.IsNullOrEmpty(Model.PayslipNumber))
                {
                    <div class="text-muted small mt-1">Ref: <strong>@Model.PayslipNumber</strong></div>
                }
            </div>
        </div>

        <!-- Employee Summary Table -->
        <table class="table table-bordered mb-4">
            <tbody>
                <tr>
                    <td class="table-head-muted" style="width: 20%;">Employee Name:</td>
                    <td class="fw-semibold" style="width: 30%;">@(Model.User?.FullName ?? "N/A")</td>
                    <td class="table-head-muted" style="width: 20%;">Employee ID:</td>
                    <td class="fw-semibold" style="width: 30%;">@(Model.User?.UserCode ?? "N/A")</td>
                </tr>
                <tr>
                    <td class="table-head-muted">Designation / Role:</td>
                    <td>@(Model.User?.Role?.RoleName ?? "Employee")</td>
                    <td class="table-head-muted">Department:</td>
                    <td>@(Model.User?.Department?.DepartmentName ?? Model.User?.DepartmentName ?? "General")</td>
                </tr>
                <tr>
                    <td class="table-head-muted">Pay Period:</td>
                    <td>@Model.PayPeriod</td>
                    <td class="table-head-muted">Payment Status:</td>
                    <td><span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">@(Model.Status ?? "Paid")</span></td>
                </tr>
                <tr>
                    <td class="table-head-muted">Total Working Days:</td>
                    <td>@(Model.TotalWorkingDays ?? 30) Days</td>
                    <td class="table-head-muted">Paid Days:</td>
                    <td><strong class="text-success">@(Model.PaidDays ?? 30) Days</strong> @if ((Model.UnpaidLeaveDays ?? 0) > 0) { <span class="text-danger small">(LOP: @Model.UnpaidLeaveDays)</span> }</td>
                </tr>
            </tbody>
        </table>

        <!-- Earnings & Deductions Breakdown -->
        <div class="row g-0 mb-4 border rounded overflow-hidden">
            <div class="col-6 border-end">
                <div class="p-2 border-bottom fw-bold text-success text-center bg-light">
                    <i class="fa-solid fa-arrow-trend-up me-1"></i> EARNINGS (?)
                </div>
                <table class="table table-sm table-borderless mb-0">
                    <tbody>
                        <tr>
                            <td class="px-3 py-2 text-muted">Basic Salary</td>
                            <td class="text-end px-3 py-2 fw-semibold">?@((Model.BasicSalary ?? 0m).ToString("N2"))</td>
                        </tr>
                        <tr>
                            <td class="px-3 py-2 text-muted">House Rent Allowance (HRA)</td>
                            <td class="text-end px-3 py-2 fw-semibold">?@((Model.HRA ?? 0m).ToString("N2"))</td>
                        </tr>
                        <tr>
                            <td class="px-3 py-2 text-muted">Conveyance Allowance</td>
                            <td class="text-end px-3 py-2 fw-semibold">?@((Model.TransportAllowance ?? 0m).ToString("N2"))</td>
                        </tr>
                        <tr>
                            <td class="px-3 py-2 text-muted">Medical Allowance</td>
                            <td class="text-end px-3 py-2 fw-semibold">?@((Model.MedicalAllowance ?? 0m).ToString("N2"))</td>
                        </tr>
                        @if ((Model.LTA ?? 0m) > 0)
                        {
                            <tr>
                                <td class="px-3 py-2 text-muted">Leave Travel Allowance (LTA)</td>
                                <td class="text-end px-3 py-2 fw-semibold">?@((Model.LTA ?? 0m).ToString("N2"))</td>
                            </tr>
                        }
                        <tr>
                            <td class="px-3 py-2 text-muted">Special Allowance</td>
                            <td class="text-end px-3 py-2 fw-semibold">?@((Model.SpecialAllowance ?? 0m).ToString("N2"))</td>
                        </tr>
                        @if ((Model.BonusIncentives ?? 0m) > 0)
                        {
                            <tr class="text-success fw-bold">
                                <td class="px-3 py-2">Bonus & Incentives</td>
                                <td class="text-end px-3 py-2">?@((Model.BonusIncentives ?? 0m).ToString("N2"))</td>
                            </tr>
                        }
                        @if ((Model.OvertimePay ?? 0m) > 0)
                        {
                            <tr class="text-info fw-bold">
                                <td class="px-3 py-2">Overtime Pay</td>
                                <td class="text-end px-3 py-2">?@((Model.OvertimePay ?? 0m).ToString("N2"))</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="col-6">
                <div class="p-2 border-bottom fw-bold text-danger text-center bg-light">
                    <i class="fa-solid fa-arrow-trend-down me-1"></i> DEDUCTIONS (?)
                </div>
                <table class="table table-sm table-borderless mb-0">
                    <tbody>
                        <tr>
                            <td class="px-3 py-2 text-muted">Provident Fund (EPF)</td>
                            <td class="text-end px-3 py-2 fw-semibold">?@((Model.ProvidentFund ?? 0m).ToString("N2"))</td>
                        </tr>
                        @if ((Model.ESI ?? 0m) > 0)
                        {
                            <tr>
                                <td class="px-3 py-2 text-muted">ESI Contribution</td>
                                <td class="text-end px-3 py-2 fw-semibold">?@((Model.ESI ?? 0m).ToString("N2"))</td>
                            </tr>
                        }
                        <tr>
                            <td class="px-3 py-2 text-muted">Professional Tax (PT)</td>
                            <td class="text-end px-3 py-2 fw-semibold">?@((Model.ProfessionalTax ?? 0m).ToString("N2"))</td>
                        </tr>
                        <tr>
                            <td class="px-3 py-2 text-muted">Income Tax (TDS)</td>
                            <td class="text-end px-3 py-2 fw-semibold">?@((Model.TDS ?? 0m).ToString("N2"))</td>
                        </tr>
                        @if ((Model.LOPDeduction ?? 0m) > 0)
                        {
                            <tr class="text-danger fw-bold">
                                <td class="px-3 py-2">Loss of Pay (LOP)</td>
                                <td class="text-end px-3 py-2">?@((Model.LOPDeduction ?? 0m).ToString("N2"))</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Totals Row -->
        <table class="table table-bordered mb-4">
            <tbody>
                <tr class="fw-bold">
                    <td style="width: 50%;" class="bg-light">
                        Gross Earnings: <span class="text-success fs-6">?@((Model.GrossSalary ?? 0m).ToString("N2"))</span>
                    </td>
                    <td style="width: 50%;" class="bg-light">
                        Total Deductions: <span class="text-danger fs-6">?@((Model.TotalDeductions ?? 0m).ToString("N2"))</span>
                    </td>
                </tr>
                <tr class="table-success fw-bold fs-5">
                    <td colspan="2" class="text-center py-3 text-success">
                        NET SALARY PAYABLE: ?@((Model.NetSalary ?? 0m).ToString("N2"))
                    </td>
                </tr>
            </tbody>
        </table>

        <!-- Signatures & Footer -->
        <div class="row pt-4 mt-4 text-center">
            <div class="col-6">
                <div class="border-top pt-2 small text-muted">Employee Signature</div>
            </div>
            <div class="col-6">
                <div class="border-top pt-2 small text-muted">Authorized HR / Employer Signature</div>
            </div>
        </div>

        <div class="text-center text-muted small mt-4 pt-2 border-top">
            <em>This is a computer-generated salary slip and does not require physical stamp unless requested.</em>
        </div>
    </div>
</body>
</html>

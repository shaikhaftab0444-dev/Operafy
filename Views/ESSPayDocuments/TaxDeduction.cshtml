@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Tax Deduction & Form 16";
    decimal grossSalary = (decimal)(ViewBag.GrossSalary ?? 1020000m);
    decimal totalTds = (decimal)(ViewBag.TotalTds ?? 54000m);
    var employee = ViewBag.Employee as ERP_System.Models.User;
}

<div class="container-fluid py-4 text-start">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-bold mb-1 text-dark"><i class="fa-solid fa-building-columns text-primary me-2"></i>Tax Deduction &amp; Form 16</h4>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0 small">
                    <li class="breadcrumb-item"><a href="/EmployeeDashboard" class="text-decoration-none text-muted">ESS</a></li>
                    <li class="breadcrumb-item"><a href="#" class="text-decoration-none text-muted">Pay Documents</a></li>
                    <li class="breadcrumb-item active text-primary fw-semibold" aria-current="page">Tax Deduction</li>
                </ol>
            </nav>
        </div>
        <div>
            <a href="@Url.Action("DownloadForm16", "ESSPayDocuments", new { financialYear = "2025-2026" })" target="_blank" class="btn btn-primary rounded-pill px-3 shadow-sm">
                <i class="fa-solid fa-file-invoice-dollar me-1.5"></i>Download Form 16 (FY 2025-26)
            </a>
        </div>
    </div>

    <!-- Quick Stats Overview -->
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-3 p-3 bg-white border-start border-primary border-4">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted small fw-medium text-uppercase">Gross Taxable Salary (FY 25-26)</div>
                        <div class="fs-4 fw-bold text-dark mt-1">&#8377;@grossSalary.ToString("N2")</div>
                        <div class="small text-muted mt-1">Tax Regime: <span class="badge bg-light text-dark border">New Regime</span></div>
                    </div>
                    <div class="bg-primary-subtle text-primary p-3 rounded-circle">
                        <i class="fa-solid fa-money-bill-transfer fa-xl"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-3 p-3 bg-white border-start border-danger border-4">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted small fw-medium text-uppercase">Total TDS Withheld</div>
                        <div class="fs-4 fw-bold text-danger mt-1">&#8377;@totalTds.ToString("N2")</div>
                        <div class="small text-muted mt-1">Deposited with Income Tax Dept</div>
                    </div>
                    <div class="bg-danger-subtle text-danger p-3 rounded-circle">
                        <i class="fa-solid fa-receipt fa-xl"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-3 p-3 bg-white border-start border-success border-4">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted small fw-medium text-uppercase">Tax Compliance Status</div>
                        <div class="fs-4 fw-bold text-success mt-1">100% Paid</div>
                        <div class="small text-muted mt-1">Form 16 Part A &amp; B Ready</div>
                    </div>
                    <div class="bg-success-subtle text-success p-3 rounded-circle">
                        <i class="fa-solid fa-shield-halved fa-xl"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Annual TDS Statements List -->
    <div class="card border-0 shadow-sm rounded-3 bg-white p-4">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <div>
                <h5 class="fw-bold mb-0 text-dark">TDS (Tax Deducted at Source) Statements</h5>
                <p class="text-muted small mb-0">Official annual tax certificates and Form 16 documents issued under Section 203 of the Income-tax Act.</p>
            </div>
            <span class="badge bg-light text-dark border px-3 py-2">
                <i class="fa-solid fa-file-shield me-1.5 text-primary"></i>Certified Certificates
            </span>
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" style="font-size: 0.88rem;">
                <thead class="table-light">
                    <tr>
                        <th class="ps-3">Financial Year</th>
                        <th>Assessment Year</th>
                        <th>Gross Taxable Salary</th>
                        <th>Total TDS Withheld</th>
                        <th>Filing Status</th>
                        <th class="text-end pe-3">Form 16 Certificate</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td class="ps-3">
                            <div class="fw-bold text-dark">
                                <i class="fa-regular fa-calendar-check text-primary me-2"></i>FY 2025 - 2026
                            </div>
                            <div class="text-muted small" style="font-size: 0.75rem;">Period: 01-Apr-2025 to 31-Mar-2026</div>
                        </td>
                        <td>
                            <span class="badge bg-light text-dark border">AY 2026 - 2027</span>
                        </td>
                        <td>
                            <span class="fw-semibold text-dark">&#8377;@grossSalary.ToString("N2")</span>
                        </td>
                        <td>
                            <span class="text-danger fw-semibold">&#8377;@totalTds.ToString("N2")</span>
                        </td>
                        <td>
                            <span class="badge bg-success-subtle text-success border border-success-subtle px-2.5 py-1">
                                <i class="fa-solid fa-circle-check me-1"></i>TDS Deposited
                            </span>
                        </td>
                        <td class="text-end pe-3">
                            <a href="@Url.Action("DownloadForm16", "ESSPayDocuments", new { financialYear = "2025-2026" })" 
                               target="_blank" 
                               class="btn btn-outline-primary btn-sm rounded-pill px-3 shadow-none">
                                <i class="fa-solid fa-file-pdf me-1.5 text-danger"></i>Download Form 16
                            </a>
                        </td>
                    </tr>
                    <tr>
                        <td class="ps-3">
                            <div class="fw-bold text-dark">
                                <i class="fa-regular fa-calendar-check text-primary me-2"></i>FY 2024 - 2025
                            </div>
                            <div class="text-muted small" style="font-size: 0.75rem;">Period: 01-Apr-2024 to 31-Mar-2025</div>
                        </td>
                        <td>
                            <span class="badge bg-light text-dark border">AY 2025 - 2026</span>
                        </td>
                        <td>
                            <span class="fw-semibold text-dark">&#8377;960,000.00</span>
                        </td>
                        <td>
                            <span class="text-danger fw-semibold">&#8377;48,000.00</span>
                        </td>
                        <td>
                            <span class="badge bg-secondary-subtle text-secondary border px-2.5 py-1">
                                <i class="fa-solid fa-lock me-1"></i>Archived
                            </span>
                        </td>
                        <td class="text-end pe-3">
                            <a href="@Url.Action("DownloadForm16", "ESSPayDocuments", new { financialYear = "2024-2025" })" 
                               target="_blank" 
                               class="btn btn-outline-secondary btn-sm rounded-pill px-3 shadow-none">
                                <i class="fa-solid fa-file-pdf me-1.5 text-danger"></i>Download Form 16
                            </a>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

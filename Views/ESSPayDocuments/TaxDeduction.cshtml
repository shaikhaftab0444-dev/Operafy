@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Tax Deduction & Form 16";
}

<div class="container-fluid py-4 text-start">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-bold mb-1"><i class="fa-solid fa-building-columns text-primary me-2"></i>Tax Deduction & Form 16</h4>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0 small">
                    <li class="breadcrumb-item"><a href="/EmployeeDashboard" class="text-decoration-none">ESS</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Tax Deduction</li>
                </ol>
            </nav>
        </div>
    </div>

    <!-- Monthly TDS statement -->
    <div class="bg-white border rounded-3 p-4 shadow-sm mb-4">
        <h5 class="fw-bold mb-3">TDS (Tax Deducted at Source) Summary</h5>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" style="font-size: 0.85rem;">
                <thead class="table-light">
                    <tr>
                        <th>Financial Year</th>
                        <th>Gross Taxable Salary</th>
                        <th>Total Tax Withheld (TDS)</th>
                        <th>Form 16</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td class="fw-bold text-dark">FY 2025 - 2026</td>
                        <td>₹1,020,000</td>
                        <td>₹54,000</td>
                        <td>
                            <button class="btn btn-outline-primary btn-xs rounded-pill px-3"><i class="fa-solid fa-file-pdf me-1.5"></i>Download Form 16</button>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

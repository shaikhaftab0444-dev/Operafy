@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Download Company Policy Docs";
}

<div class="container-fluid py-4 text-start">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-bold mb-1 text-dark"><i class="fa-solid fa-file-shield text-primary me-2"></i>Company Policy Documents</h4>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0 small">
                    <li class="breadcrumb-item"><a href="/EmployeeDashboard" class="text-decoration-none text-muted">ESS</a></li>
                    <li class="breadcrumb-item"><a href="#" class="text-decoration-none text-muted">Pay Documents</a></li>
                    <li class="breadcrumb-item active text-primary fw-semibold" aria-current="page">Policy Docs</li>
                </ol>
            </nav>
        </div>
    </div>

    <!-- Company Policy Documents List -->
    <div class="card border-0 shadow-sm rounded-3 bg-white p-4">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <div>
                <h5 class="fw-bold mb-0 text-dark">Corporate Policy Handbooks &amp; Guidelines</h5>
                <p class="text-muted small mb-0">Official compliance handbooks, security protocols, and operational guidelines for employees.</p>
            </div>
            <span class="badge bg-light text-dark border px-3 py-2">
                <i class="fa-solid fa-book-bookmark me-1.5 text-primary"></i>Active Standards
            </span>
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" style="font-size: 0.88rem;">
                <thead class="table-light">
                    <tr>
                        <th class="ps-3">Document Title</th>
                        <th>Category</th>
                        <th>Version</th>
                        <th>Format</th>
                        <th class="text-end pe-3">Action</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td class="ps-3">
                            <div class="fw-bold text-dark">
                                <i class="fa-regular fa-file-pdf text-danger me-2"></i>Employee Conduct Code Policy
                            </div>
                            <div class="text-muted small" style="font-size: 0.75rem;">Ethics, anti-harassment, and workplace decorum standards</div>
                        </td>
                        <td><span class="badge bg-light text-dark border">Human Resources</span></td>
                        <td>v3.4 (2026)</td>
                        <td><span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2 py-0.5">PDF</span></td>
                        <td class="text-end pe-3">
                            <a href="@Url.Action("DownloadPolicyDocument", "ESSPayDocuments", new { fileName = "Employee_Conduct_Code_Policy" })" 
                               class="btn btn-outline-primary btn-sm rounded-pill px-3 shadow-none">
                                <i class="fa-solid fa-download me-1.5"></i>Download
                            </a>
                        </td>
                    </tr>
                    <tr>
                        <td class="ps-3">
                            <div class="fw-bold text-dark">
                                <i class="fa-regular fa-file-pdf text-danger me-2"></i>IT Asset Management &amp; Security Protocol
                            </div>
                            <div class="text-muted small" style="font-size: 0.75rem;">Data protection, access control, and hardware governance</div>
                        </td>
                        <td><span class="badge bg-light text-dark border">IT &amp; Security</span></td>
                        <td>v2.8 (2026)</td>
                        <td><span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2 py-0.5">PDF</span></td>
                        <td class="text-end pe-3">
                            <a href="@Url.Action("DownloadPolicyDocument", "ESSPayDocuments", new { fileName = "IT_Asset_Management_and_Security_Protocol" })" 
                               class="btn btn-outline-primary btn-sm rounded-pill px-3 shadow-none">
                                <i class="fa-solid fa-download me-1.5"></i>Download
                            </a>
                        </td>
                    </tr>
                    <tr>
                        <td class="ps-3">
                            <div class="fw-bold text-dark">
                                <i class="fa-regular fa-file-pdf text-danger me-2"></i>Leave &amp; Attendance Policy Guide
                            </div>
                            <div class="text-muted small" style="font-size: 0.75rem;">Paid time off, sick leaves, maternity/paternity, and holiday calendars</div>
                        </td>
                        <td><span class="badge bg-light text-dark border">Human Resources</span></td>
                        <td>v4.1 (2026)</td>
                        <td><span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2 py-0.5">PDF</span></td>
                        <td class="text-end pe-3">
                            <a href="@Url.Action("DownloadPolicyDocument", "ESSPayDocuments", new { fileName = "Leave_and_Attendance_Policy_Guide" })" 
                               class="btn btn-outline-primary btn-sm rounded-pill px-3 shadow-none">
                                <i class="fa-solid fa-download me-1.5"></i>Download
                            </a>
                        </td>
                    </tr>
                    <tr>
                        <td class="ps-3">
                            <div class="fw-bold text-dark">
                                <i class="fa-regular fa-file-pdf text-danger me-2"></i>Travel &amp; Expense Reimbursement Policy
                            </div>
                            <div class="text-muted small" style="font-size: 0.75rem;">Per diem rates, travel booking norms, and claims processing</div>
                        </td>
                        <td><span class="badge bg-light text-dark border">Finance &amp; Admin</span></td>
                        <td>v2.1 (2026)</td>
                        <td><span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2 py-0.5">PDF</span></td>
                        <td class="text-end pe-3">
                            <a href="@Url.Action("DownloadPolicyDocument", "ESSPayDocuments", new { fileName = "Travel_and_Expense_Reimbursement_Policy" })" 
                               class="btn btn-outline-primary btn-sm rounded-pill px-3 shadow-none">
                                <i class="fa-solid fa-download me-1.5"></i>Download
                            </a>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Download Company Policy Docs";
}

<div class="container-fluid py-4 text-start">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-bold mb-1"><i class="fa-solid fa-file-shield text-primary me-2"></i>Company Policy Documents</h4>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0 small">
                    <li class="breadcrumb-item"><a href="/EmployeeDashboard" class="text-decoration-none">ESS</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Policy Docs</li>
                </ol>
            </nav>
        </div>
    </div>

    <!-- Company Policy Documents List -->
    <div class="bg-white border rounded-3 p-4 shadow-sm">
        <h5 class="fw-bold mb-3">Corporate Policy Handbooks</h5>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" style="font-size: 0.85rem;">
                <thead class="table-light">
                    <tr>
                        <th>Document Title</th>
                        <th>Category</th>
                        <th>Format</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td class="fw-bold text-dark">Employee Conduct Code Policy</td>
                        <td>Human Resources</td>
                        <td>PDF (1.2 MB)</td>
                        <td>
                            <button class="btn btn-outline-primary btn-xs rounded-pill px-3"><i class="fa-solid fa-download me-1.5"></i>Download</button>
                        </td>
                    </tr>
                    <tr>
                        <td class="fw-bold text-dark">IT Asset Management & Security Protocol</td>
                        <td>IT Support</td>
                        <td>PDF (850 KB)</td>
                        <td>
                            <button class="btn btn-outline-primary btn-xs rounded-pill px-3"><i class="fa-solid fa-download me-1.5"></i>Download</button>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Download Payslips";
}

<div class="container-fluid py-4 text-start">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-bold mb-1"><i class="fa-solid fa-file-invoice-dollar text-primary me-2"></i>Download Payslips</h4>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0 small">
                    <li class="breadcrumb-item"><a href="/EmployeeDashboard" class="text-decoration-none">ESS</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Payslips</li>
                </ol>
            </nav>
        </div>
    </div>

    <!-- Monthly Payslip Download List -->
    <div class="bg-white border rounded-3 p-4 shadow-sm">
        <h5 class="fw-bold mb-3">Available Salary Statements</h5>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" style="font-size: 0.85rem;">
                <thead class="table-light">
                    <tr>
                        <th>Month / Period</th>
                        <th>Gross Pay</th>
                        <th>Net Paid Amount</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td class="fw-bold text-dark">July 2026</td>
                        <td>₹85,000</td>
                        <td class="text-success fw-bold">₹76,300</td>
                        <td>
                            <button class="btn btn-outline-primary btn-xs rounded-pill px-3"><i class="fa-solid fa-download me-1.5"></i>Download PDF</button>
                        </td>
                    </tr>
                    <tr>
                        <td class="fw-bold text-dark">June 2026</td>
                        <td>₹85,000</td>
                        <td class="text-success fw-bold">₹76,300</td>
                        <td>
                            <button class="btn btn-outline-primary btn-xs rounded-pill px-3"><i class="fa-solid fa-download me-1.5"></i>Download PDF</button>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

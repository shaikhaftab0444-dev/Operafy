@model ERP_System.Models.SalaryStructure
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Configure Employee Salary";
    var employee = (ERP_System.Models.User)ViewBag.Employee;
}

<style>
    .panel-form {
        background: #ffffff;
        border: 1px solid var(--border-warm);
        border-radius: 12px;
        box-shadow: 0 1px 3px rgba(45,37,30,0.03);
        padding: 2.5rem;
        max-width: 700px;
        margin: 0 auto;
    }

    .form-label-warm {
        font-size: 0.8rem;
        font-weight: 700;
        color: var(--text-color);
        margin-bottom: 6px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .input-group-warm {
        border: 1px solid #d4cbbd;
        border-radius: 8px;
        background-color: #fcfbfa;
        transition: all 0.2s ease-in-out;
        overflow: hidden;
        display: flex;
        align-items: center;
        width: 100%;
    }
    .input-group-warm:focus-within {
        border-color: var(--primary-warm);
        box-shadow: 0 0 0 4px rgba(79, 70, 229, 0.08);
        background-color: #ffffff;
    }

    .input-icon-warm {
        padding: 0.75rem 0.25rem 0.75rem 1rem;
        color: var(--sidebar-color);
        font-size: 0.95rem;
        display: flex;
        align-items: center;
    }

    .form-control-warm {
        border: none !important;
        box-shadow: none !important;
        background: transparent !important;
        color: var(--text-color) !important;
        font-size: 0.9rem !important;
        padding: 0.75rem 1rem !important;
        width: 100%;
    }

    .btn-primary-warm {
        background: linear-gradient(135deg, var(--primary-warm) 0%, #6366f1 100%);
        color: #ffffff;
        border: none;
        padding: 0.75rem 2rem;
        border-radius: 8px;
        font-weight: 600;
        font-size: 0.9rem;
        box-shadow: 0 4px 10px rgba(79, 70, 229, 0.2);
        transition: all 0.2s;
    }
    .btn-primary-warm:hover {
        transform: translateY(-1px);
        box-shadow: 0 6px 14px rgba(79, 70, 229, 0.3);
        color: #ffffff;
    }

    .btn-secondary-warm {
        border: 1px solid var(--border-warm);
        background-color: #ffffff;
        color: var(--text-color);
        padding: 0.75rem 2rem;
        border-radius: 8px;
        font-weight: 600;
        font-size: 0.9rem;
        transition: all 0.2s;
    }
    .btn-secondary-warm:hover {
        background-color: #faf8f5;
        border-color: #cbd5e1;
    }

    .calc-box {
        background-color: #faf8f5;
        border: 1px dashed var(--border-warm);
        border-radius: 8px;
        padding: 1.25rem;
    }
</style>

<!-- Breadcrumbs & Header -->
<div class="mb-4 text-center">
    <h4 class="fw-bold mb-1" style="color: var(--text-color);">Configure Salary Structure</h4>
    <p class="text-muted small">Employee: <strong>@employee.FullName</strong> | Code: <code style="color:var(--accent-warm);">@employee.UserCode</code></p>
    <nav aria-label="breadcrumb" class="d-inline-block">
        <ol class="breadcrumb mb-0 small">
            <li class="breadcrumb-item"><a href="/Dashboard" class="text-decoration-none">Dashboard</a></li>
            <li class="breadcrumb-item"><a href="/Payroll" class="text-decoration-none">Payroll</a></li>
            <li class="breadcrumb-item active" aria-current="page">Salary Setup</li>
        </ol>
    </nav>
</div>

<!-- Form Card -->
<div class="panel-form">
    <form asp-action="ManageSalary" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="UserId" />
        <input type="hidden" asp-for="SalaryStructureId" />

        <div class="row g-3 text-start">
            <!-- Earnings Section -->
            <div class="col-md-6">
                <h6 class="fw-bold text-success mb-3"><i class="fa-solid fa-plus-circle me-1"></i>Monthly Earnings</h6>
                
                <!-- Basic Salary -->
                <div class="mb-3">
                    <label asp-for="BasicSalary" class="form-label-warm">Basic Salary</label>
                    <div class="input-group-warm">
                        <span class="input-icon-warm"><i class="fa-solid fa-indian-rupee-sign"></i></span>
                        <input asp-for="BasicSalary" type="number" min="0" class="form-control-warm sal-input" required />
                    </div>
                </div>

                <!-- HRA -->
                <div class="mb-3">
                    <label asp-for="HRA" class="form-label-warm">HRA (House Rent)</label>
                    <div class="input-group-warm">
                        <span class="input-icon-warm"><i class="fa-solid fa-indian-rupee-sign"></i></span>
                        <input asp-for="HRA" type="number" min="0" class="form-control-warm sal-input" required />
                    </div>
                </div>

                <!-- Transport Allowance -->
                <div class="mb-3">
                    <label asp-for="TransportAllowance" class="form-label-warm">Transport Allowance</label>
                    <div class="input-group-warm">
                        <span class="input-icon-warm"><i class="fa-solid fa-indian-rupee-sign"></i></span>
                        <input asp-for="TransportAllowance" type="number" min="0" class="form-control-warm sal-input" required />
                    </div>
                </div>

                <!-- Medical Allowance -->
                <div class="mb-3">
                    <label asp-for="MedicalAllowance" class="form-label-warm">Medical Allowance</label>
                    <div class="input-group-warm">
                        <span class="input-icon-warm"><i class="fa-solid fa-indian-rupee-sign"></i></span>
                        <input asp-for="MedicalAllowance" type="number" min="0" class="form-control-warm sal-input" required />
                    </div>
                </div>
            </div>

            <!-- Deductions Section -->
            <div class="col-md-6">
                <h6 class="fw-bold text-danger mb-3"><i class="fa-solid fa-minus-circle me-1"></i>Monthly Deductions</h6>
                
                <!-- Provident Fund -->
                <div class="mb-3">
                    <label asp-for="ProvidentFund" class="form-label-warm">Provident Fund (PF)</label>
                    <div class="input-group-warm">
                        <span class="input-icon-warm"><i class="fa-solid fa-indian-rupee-sign"></i></span>
                        <input asp-for="ProvidentFund" type="number" min="0" class="form-control-warm sal-input" required />
                    </div>
                </div>

                <!-- Professional Tax -->
                <div class="mb-3">
                    <label asp-for="ProfessionalTax" class="form-label-warm">Professional Tax (PT)</label>
                    <div class="input-group-warm">
                        <span class="input-icon-warm"><i class="fa-solid fa-indian-rupee-sign"></i></span>
                        <input asp-for="ProfessionalTax" type="number" min="0" class="form-control-warm sal-input" required />
                    </div>
                </div>

                <!-- Live Net Salary Display -->
                <div class="calc-box mt-4">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="small fw-bold text-secondary">Total Allowances:</span>
                        <span class="fw-bold text-success" id="tot-allowances">₹0</span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="small fw-bold text-secondary">Total Deductions:</span>
                        <span class="fw-bold text-danger" id="tot-deductions">₹0</span>
                    </div>
                    <hr style="border-top:1px dashed #d4cbbd; margin:0.75rem 0;" />
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="fw-bold text-dark uppercase" style="font-size:0.8rem;">Est Net Take-Home:</span>
                        <h4 class="fw-bold text-primary mb-0" id="lbl-net-salary">₹0</h4>
                    </div>
                </div>
            </div>
        </div>

        <!-- Form Buttons -->
        <div class="d-flex justify-content-end gap-3 mt-4">
            <a href="/Payroll" class="btn btn-secondary-warm">
                Cancel
            </a>
            <button type="submit" class="btn btn-primary-warm">
                Save Salary Structure
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", () => {
            const inputs = document.querySelectorAll(".sal-input");
            
            function calculateNet() {
                const basic = parseFloat(document.getElementById("BasicSalary").value) || 0;
                const hra = parseFloat(document.getElementById("HRA").value) || 0;
                const trans = parseFloat(document.getElementById("TransportAllowance").value) || 0;
                const med = parseFloat(document.getElementById("MedicalAllowance").value) || 0;
                
                const pf = parseFloat(document.getElementById("ProvidentFund").value) || 0;
                const pt = parseFloat(document.getElementById("ProfessionalTax").value) || 0;
                
                const gross = basic + hra + trans + med;
                const deductions = pf + pt;
                const net = gross - deductions;
                
                document.getElementById("tot-allowances").innerText = "₹" + (gross - basic).toLocaleString('en-IN');
                document.getElementById("tot-deductions").innerText = "₹" + deductions.toLocaleString('en-IN');
                document.getElementById("lbl-net-salary").innerText = "₹" + (net >= 0 ? net : 0).toLocaleString('en-IN');
            }

            inputs.forEach(input => {
                input.addEventListener("input", calculateNet);
            });

            // Initial run on page load
            calculateNet();
        });
    </script>
}

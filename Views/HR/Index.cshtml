@model ERP_System.Models.HRDashboardViewModel
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "HR Operations Dashboard";
}

<style>
    .card-hr {
        background: #ffffff;
        border: 1px solid var(--border-warm);
        border-radius: 12px;
        padding: 1.25rem;
        box-shadow: 0 1px 3px rgba(45,37,30,0.03);
        display: flex;
        align-items: center;
        gap: 15px;
        height: 100%;
        transition: transform 0.2s, box-shadow 0.2s;
    }
    .card-hr:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 16px rgba(45,37,30,0.05);
    }
    
    .hr-icon-wrap {
        width: 48px;
        height: 48px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.25rem;
    }
    .hr-icon-total { background-color: rgba(79, 70, 229, 0.08); color: var(--primary-warm); }
    .hr-icon-active { background-color: rgba(16, 185, 129, 0.08); color: #10b981; }
    .hr-icon-inactive { background-color: rgba(239, 68, 68, 0.08); color: #ef4444; }
    .hr-icon-locked { background-color: rgba(217, 119, 6, 0.08); color: var(--accent-warm); }

    .hr-info {
        flex-grow: 1;
    }
    .hr-label {
        font-size: 0.75rem;
        color: var(--sidebar-color);
        font-weight: 700;
        margin-bottom: 2px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }
    .hr-val {
        font-size: 1.4rem;
        font-weight: 700;
        color: var(--text-color);
    }

    .hr-panel {
        background: #ffffff;
        border: 1px solid var(--border-warm);
        border-radius: 12px;
        padding: 1.5rem;
        box-shadow: 0 1px 3px rgba(45,37,30,0.03);
        height: 100%;
    }
    .panel-header-hr {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1.25rem;
    }
    .panel-title-hr {
        font-size: 1rem;
        font-weight: 700;
        color: var(--text-color);
        margin-bottom: 0;
    }

    .table-hr th {
        background-color: #fcfbfa !important;
        font-size: 0.75rem;
        text-transform: uppercase;
        font-weight: 700;
        color: #7c7267;
        border-bottom: 1px solid var(--border-warm);
        padding: 0.85rem 1rem;
    }
    .table-hr td {
        font-size: 0.85rem;
        color: var(--text-color);
        border-bottom: 1px solid var(--border-warm);
        padding: 0.85rem 1rem;
        vertical-align: middle;
    }

    .badge-active {
        background-color: rgba(16, 185, 129, 0.08);
        color: #10b981;
        font-weight: 600;
        border: 1px solid rgba(16, 185, 129, 0.2);
    }
    .badge-inactive {
        background-color: rgba(239, 68, 68, 0.08);
        color: #ef4444;
        font-weight: 600;
        border: 1px solid rgba(239, 68, 68, 0.2);
    }

    .btn-action-warm {
        border: 1px solid var(--border-warm);
        background-color: #ffffff;
        color: var(--text-color);
        font-size: 0.8rem;
        font-weight: 600;
        transition: all 0.2s;
    }
    .btn-action-warm:hover {
        background-color: #faf8f5;
        border-color: #cbd5e1;
        color: var(--primary-warm);
    }

    .btn-primary-warm {
        background: linear-gradient(135deg, var(--primary-warm) 0%, #6366f1 100%);
        color: #ffffff;
        border: none;
        font-weight: 600;
        font-size: 0.875rem;
        box-shadow: 0 4px 10px rgba(79, 70, 229, 0.2);
        transition: all 0.2s;
    }
    .btn-primary-warm:hover {
        transform: translateY(-1px);
        box-shadow: 0 6px 14px rgba(79, 70, 229, 0.3);
        color: #ffffff;
    }

    /* Onboarding timeline */
    .timeline-hr {
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }
    .timeline-item {
        display: flex;
        gap: 12px;
        align-items: center;
        padding-bottom: 0.5rem;
        border-bottom: 1px dashed var(--border-warm);
    }
    .timeline-item:last-child {
        border-bottom: none;
    }
    .timeline-avatar {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        background-color: #faf6f0;
        color: var(--primary-warm);
        font-weight: 700;
        font-size: 0.8rem;
        display: flex;
        align-items: center;
        justify-content: center;
        border: 1.5px solid var(--primary-warm);
        flex-shrink: 0;
    }
</style>

<!-- Top Breadcrumbs -->
<div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-3 mb-4">
    <div>
        <h4 class="fw-bold mb-1" style="color: var(--text-color);">HR Operations Dashboard</h4>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0 small">
                <li class="breadcrumb-item"><a href="/Dashboard" class="text-decoration-none">Dashboard</a></li>
                <li class="breadcrumb-item active" aria-current="page">HR Management</li>
            </ol>
        </nav>
    </div>
    
    <a href="/UserAccounts/Create" class="btn btn-primary-warm px-4 py-2">
        <i class="fa-solid fa-user-plus me-2"></i> Onboard Employee
    </a>
</div>

<!-- KPI Metric Cards Grid -->
<div class="row g-4 mb-4">
    <!-- Total Staff -->
    <div class="col-xl-3 col-md-6">
        <div class="card-hr">
            <div class="hr-icon-wrap hr-icon-total"><i class="fa-solid fa-users-gear"></i></div>
            <div class="hr-info">
                <div class="hr-label">Total Staff</div>
                <div class="hr-val">@Model.TotalEmployees</div>
            </div>
        </div>
    </div>
    <!-- Active Employees -->
    <div class="col-xl-3 col-md-6">
        <div class="card-hr">
            <div class="hr-icon-wrap hr-icon-active"><i class="fa-solid fa-user-check"></i></div>
            <div class="hr-info">
                <div class="hr-label">Active Employees</div>
                <div class="hr-val">@Model.ActiveEmployees</div>
            </div>
        </div>
    </div>
    <!-- Inactive Employees -->
    <div class="col-xl-3 col-md-6">
        <div class="card-hr">
            <div class="hr-icon-wrap hr-icon-inactive"><i class="fa-solid fa-user-slash"></i></div>
            <div class="hr-info">
                <div class="hr-label">Inactive Employees</div>
                <div class="hr-val">@Model.InactiveEmployees</div>
            </div>
        </div>
    </div>
    <!-- Locked Accounts -->
    <div class="col-xl-3 col-md-6">
        <div class="card-hr">
            <div class="hr-icon-wrap hr-icon-locked"><i class="fa-solid fa-user-lock"></i></div>
            <div class="hr-info">
                <div class="hr-label">Locked Accounts</div>
                <div class="hr-val">@Model.LockedAccounts</div>
            </div>
        </div>
    </div>
</div>

<!-- Middle Panels (Charts & Recent Onboardings) -->
<div class="row g-4 mb-4">
    <!-- Role & Department Distribution Chart -->
    <div class="col-lg-6">
        <div class="hr-panel">
            <div class="panel-header-hr">
                <h5 class="panel-title-hr">Staff Distribution by Role</h5>
                <i class="fa-solid fa-chart-pie text-muted"></i>
            </div>
            <div style="position: relative; height: 260px; width: 100%;">
                <canvas id="roleChart"></canvas>
            </div>
        </div>
    </div>
    
    <!-- Recent Onboardings List -->
    <div class="col-lg-6">
        <div class="hr-panel">
            <div class="panel-header-hr">
                <h5 class="panel-title-hr">Recent Onboardings</h5>
                <span class="badge bg-light text-dark border fw-bold" style="font-size: 0.75rem; border-color: var(--border-warm) !important;">Last 5 Hires</span>
            </div>
            
            <div class="timeline-hr mt-2">
                @if (Model.RecentHires != null && Model.RecentHires.Any())
                {
                    foreach (var hire in Model.RecentHires)
                    {
                        var timeDiff = DateTime.UtcNow - hire.CreatedAt.ToUniversalTime();
                        var timeStr = timeDiff.TotalMinutes < 60 ? $"{(int)timeDiff.TotalMinutes} min ago" :
                                      timeDiff.TotalHours < 24 ? $"{(int)timeDiff.TotalHours} hour ago" :
                                      $"{(int)timeDiff.TotalDays} days ago";
                                      
                        <div class="timeline-item">
                            <div class="timeline-avatar">
                                @hire.FullName.Substring(0,1).ToUpper()
                            </div>
                            <div class="text-start flex-grow-1">
                                <div class="fw-bold text-dark mb-0" style="font-size: 0.85rem;">@hire.FullName</div>
                                <div class="text-muted" style="font-size: 0.8rem;">
                                    User Code: <code style="color: var(--accent-warm); font-weight: 700;">@hire.UserCode</code> | Role: <strong>@(hire.Role?.RoleName ?? "Employee")</strong>
                                </div>
                            </div>
                            <div class="text-muted small" style="font-size: 0.75rem;">@timeStr</div>
                        </div>
                    }
                }
                else
                {
                    <div class="text-center text-muted py-5">No recent hiring entries recorded.</div>
                }
            </div>
        </div>
    </div>
</div>

<!-- Active Staff Directory Table Panel -->
<div class="hr-panel p-0 overflow-hidden">
    <div class="panel-header-hr p-4 pb-0 mb-3">
        <h5 class="panel-title-hr">Staff Directory</h5>
        <a href="/Users" class="btn btn-sm btn-outline-secondary btn-sm-custom px-3 py-1" style="font-size: 0.8rem;">Manage Access</a>
    </div>
    
    <div class="table-responsive">
        <table class="table table-hover table-hr mb-0 border-0">
            <thead>
                <tr>
                    <th class="border-0">Employee Code</th>
                    <th class="border-0">Full Name</th>
                    <th class="border-0">Username</th>
                    <th class="border-0">Email</th>
                    <th class="border-0">Phone</th>
                    <th class="border-0">Role</th>
                    <th class="border-0 text-center">Status</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.EmployeesList != null && Model.EmployeesList.Any())
                {
                    foreach (var emp in Model.EmployeesList)
                    {
                        <tr>
                            <td class="fw-bold text-secondary">@emp.UserCode</td>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <div class="timeline-avatar" style="width:26px; height:26px; font-size:0.7rem;">
                                        @emp.FullName.Substring(0,1).ToUpper()
                                    </div>
                                    <span class="fw-bold text-dark">@emp.FullName</span>
                                </div>
                            </td>
                            <td>@@@emp.UserName</td>
                            <td>@emp.Email</td>
                            <td>@(string.IsNullOrEmpty(emp.MobileNumber) ? "N/A" : emp.MobileNumber)</td>
                            <td>
                                <span class="badge bg-light text-dark border px-2.5 py-1.5 fw-bold" style="font-size: 0.75rem; border-color: var(--border-warm) !important;">
                                    <i class="fa-solid fa-user-tag text-primary me-1" style="color: var(--primary-warm) !important;"></i>
                                    @(emp.Role?.RoleName ?? "Employee")
                                </span>
                            </td>
                            <td class="text-center">
                                @if (emp.IsActive)
                                {
                                    <span class="badge rounded-pill px-2.5 py-1.5 badge-active" style="font-size: 0.75rem;">Active</span>
                                }
                                else
                                {
                                    <span class="badge rounded-pill px-2.5 py-1.5 badge-inactive" style="font-size: 0.75rem;">Inactive</span>
                                }
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="text-center text-muted py-5">No employee records recorded in the system.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script src="~/lib/chart.js/chart.umd.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", () => {
            // Role Distribution Chart Setup
            const roleCtx = document.getElementById('roleChart').getContext('2d');
            
            // Native C# to JS array serialization in MVC Razor
            const chartLabels = @Html.Raw(Json.Serialize(Model.RoleDistribution.Select(r => r.RoleName)));
            const chartData = @Html.Raw(Json.Serialize(Model.RoleDistribution.Select(r => r.Count)));

            // Curated premium warm colors matching the design system
            const warmPalette = [
                '#4f46e5', // Primary Indigo
                '#10b981', // Success Emerald
                '#d97706', // Warning Amber
                '#ec4899', // Pink Accent
                '#06b6d4', // Cyan Accent
                '#f43f5e', // Rose Accent
                '#8b5cf6', // Purple Accent
                '#7c7267'  // Warm Slate Gray
            ];

            new Chart(roleCtx, {
                type: 'doughnut',
                data: {
                    labels: chartLabels,
                    datasets: [{
                        data: chartData,
                        backgroundColor: warmPalette.slice(0, chartLabels.length),
                        borderWidth: 2,
                        borderColor: '#ffffff',
                        hoverOffset: 6
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    cutout: '65%',
                    plugins: {
                        legend: {
                            position: 'right',
                            labels: {
                                usePointStyle: true,
                                boxWidth: 8,
                                font: { size: 11, weight: 600 }
                            }
                        }
                    }
                }
            });
        });
    </script>
}

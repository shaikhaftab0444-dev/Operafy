@model ERP_System.Models.HRDashboardViewModel
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "HR Operations Dashboard";
}

<style>
    :root {
        --hr-ink: #1e293b;
        --hr-muted: #7c8798;
        --hr-border: #e6e9ef;
        --hr-surface: #ffffff;
        --hr-bg-soft: #f8f9fc;
        --hr-primary: #4f46e5;
        --hr-primary-soft: rgba(79, 70, 229, 0.09);
        --hr-success: #10b981;
        --hr-success-soft: rgba(16, 185, 129, 0.09);
        --hr-danger: #ef4444;
        --hr-danger-soft: rgba(239, 68, 68, 0.09);
        --hr-amber: #d97706;
        --hr-amber-soft: rgba(217, 119, 6, 0.09);
    }

    /* ===== Page Header ===== */
    .hr-page-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        flex-wrap: wrap;
        gap: 1rem;
        margin-bottom: 1.75rem;
        padding-bottom: 1.25rem;
        border-bottom: 1px solid var(--hr-border);
    }

        .hr-page-header h4 {
            font-weight: 800;
            letter-spacing: -0.01em;
            color: var(--hr-ink);
            margin-bottom: 0.35rem;
        }

        .hr-page-header .breadcrumb {
            font-size: 0.8rem;
        }

        .hr-page-header .breadcrumb-item a {
            color: var(--hr-muted);
            font-weight: 500;
        }

        .hr-page-header .breadcrumb-item.active {
            color: var(--hr-primary);
            font-weight: 600;
        }

    .hr-live-chip {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: var(--hr-success-soft);
        color: var(--hr-success);
        border: 1px solid rgba(16, 185, 129, 0.25);
        font-size: 0.78rem;
        font-weight: 700;
        padding: 0.5rem 0.9rem;
        border-radius: 999px;
    }

        .hr-live-chip .dot {
            width: 7px;
            height: 7px;
            border-radius: 50%;
            background: var(--hr-success);
            box-shadow: 0 0 0 3px var(--hr-success-soft);
        }

    /* ===== KPI Cards ===== */
    .card-hr {
        position: relative;
        background: var(--hr-surface);
        border: 1px solid var(--hr-border);
        border-radius: 14px;
        padding: 1.35rem 1.4rem;
        display: flex;
        align-items: center;
        gap: 16px;
        height: 100%;
        overflow: hidden;
        transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
    }

        .card-hr::before {
            content: "";
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 3px;
            background: var(--bar-color, var(--hr-primary));
        }

        .card-hr:hover {
            transform: translateY(-3px);
            box-shadow: 0 12px 24px rgba(30, 41, 59, 0.07);
            border-color: transparent;
        }

    .hr-icon-wrap {
        width: 46px;
        height: 46px;
        min-width: 46px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.1rem;
    }

    .hr-icon-total {
        background: var(--hr-primary-soft);
        color: var(--hr-primary);
    }

    .hr-icon-active {
        background: var(--hr-success-soft);
        color: var(--hr-success);
    }

    .hr-icon-inactive {
        background: var(--hr-danger-soft);
        color: var(--hr-danger);
    }

    .hr-icon-locked {
        background: var(--hr-amber-soft);
        color: var(--hr-amber);
    }

    .card-hr.bar-total {
        --bar-color: var(--hr-primary);
    }

    .card-hr.bar-active {
        --bar-color: var(--hr-success);
    }

    .card-hr.bar-inactive {
        --bar-color: var(--hr-danger);
    }

    .card-hr.bar-locked {
        --bar-color: var(--hr-amber);
    }

    .hr-info {
        flex-grow: 1;
    }

    .hr-label {
        font-size: 0.7rem;
        color: var(--hr-muted);
        font-weight: 700;
        margin-bottom: 4px;
        text-transform: uppercase;
        letter-spacing: 0.6px;
    }

    .hr-val {
        font-size: 1.6rem;
        font-weight: 800;
        color: var(--hr-ink);
        line-height: 1;
        letter-spacing: -0.02em;
    }

    /* ===== Panels ===== */
    .hr-panel {
        background: var(--hr-surface);
        border: 1px solid var(--hr-border);
        border-radius: 14px;
        padding: 1.6rem;
        box-shadow: 0 1px 2px rgba(30, 41, 59, 0.03);
        height: 100%;
    }

    .panel-header-hr {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1.4rem;
    }

    .panel-eyebrow {
        font-size: 0.68rem;
        font-weight: 700;
        letter-spacing: 0.8px;
        text-transform: uppercase;
        color: var(--hr-muted);
        margin-bottom: 3px;
        display: block;
    }

    .panel-title-hr {
        font-size: 1.02rem;
        font-weight: 800;
        color: var(--hr-ink);
        margin-bottom: 0;
        letter-spacing: -0.01em;
    }

    .panel-icon-badge {
        width: 34px;
        height: 34px;
        border-radius: 9px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: var(--hr-bg-soft);
        color: var(--hr-muted);
        font-size: 0.85rem;
    }

    /* ===== Table ===== */
    .table-hr thead th {
        background-color: var(--hr-bg-soft) !important;
        font-size: 0.7rem;
        text-transform: uppercase;
        font-weight: 700;
        letter-spacing: 0.5px;
        color: var(--hr-muted);
        border-bottom: 1px solid var(--hr-border);
        padding: 0.9rem 1.25rem;
    }

    .table-hr td {
        font-size: 0.85rem;
        color: var(--hr-ink);
        border-bottom: 1px solid var(--hr-border);
        padding: 0.9rem 1.25rem;
        vertical-align: middle;
    }

    .table-hr tbody tr:hover {
        background-color: var(--hr-bg-soft);
    }

    .table-hr tbody tr:last-child td {
        border-bottom: none;
    }

    .badge-active {
        background-color: var(--hr-success-soft);
        color: var(--hr-success);
        font-weight: 700;
        border: 1px solid rgba(16, 185, 129, 0.25);
    }

    .badge-inactive {
        background-color: var(--hr-danger-soft);
        color: var(--hr-danger);
        font-weight: 700;
        border: 1px solid rgba(239, 68, 68, 0.25);
    }

    .badge-role-pill {
        background: var(--hr-bg-soft);
        color: var(--hr-ink);
        border: 1px solid var(--hr-border) !important;
        font-weight: 600;
    }

    .btn-action-warm {
        border: 1px solid var(--hr-border);
        background-color: var(--hr-surface);
        color: var(--hr-ink);
        font-size: 0.8rem;
        font-weight: 600;
        border-radius: 8px;
        transition: all 0.2s;
    }

        .btn-action-warm:hover {
            background-color: var(--hr-bg-soft);
            border-color: #cbd5e1;
            color: var(--hr-primary);
        }

    /* ===== Onboarding timeline ===== */
    .timeline-hr {
        display: flex;
        flex-direction: column;
        gap: 0.4rem;
    }

    .timeline-item {
        display: flex;
        gap: 14px;
        align-items: center;
        padding: 0.65rem 0.25rem;
        border-bottom: 1px solid var(--hr-border);
    }

        .timeline-item:last-child {
            border-bottom: none;
        }

    .timeline-avatar {
        width: 36px;
        height: 36px;
        border-radius: 10px;
        background-color: var(--hr-primary-soft);
        color: var(--hr-primary);
        font-weight: 800;
        font-size: 0.85rem;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .timeline-time {
        font-size: 0.72rem;
        font-weight: 600;
        color: var(--hr-muted);
        white-space: nowrap;
    }
</style>

<!-- Top Header -->
<div class="hr-page-header">
    <div>
        <h4>HR Operations Dashboard</h4>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item"><a href="/Dashboard" class="text-decoration-none">Dashboard</a></li>
                <li class="breadcrumb-item active" aria-current="page">HR Management</li>
            </ol>
        </nav>
    </div>

    <span class="hr-live-chip">
        <span class="dot"></span> Live Workforce Data
    </span>
</div>

<!-- KPI Metric Cards Grid -->
<div class="row g-4 mb-4">
    <!-- Total Staff -->
    <div class="col-xl-3 col-md-6">
        <div class="card-hr bar-total">
            <div class="hr-icon-wrap hr-icon-total"><i class="fa-solid fa-users-gear"></i></div>
            <div class="hr-info">
                <div class="hr-label">Total Staff</div>
                <div class="hr-val">@Model.TotalEmployees</div>
            </div>
        </div>
    </div>
    <!-- Active Employees -->
    <div class="col-xl-3 col-md-6">
        <div class="card-hr bar-active">
            <div class="hr-icon-wrap hr-icon-active"><i class="fa-solid fa-user-check"></i></div>
            <div class="hr-info">
                <div class="hr-label">Active Employees</div>
                <div class="hr-val">@Model.ActiveEmployees</div>
            </div>
        </div>
    </div>
    <!-- Inactive Employees -->
    <div class="col-xl-3 col-md-6">
        <div class="card-hr bar-inactive">
            <div class="hr-icon-wrap hr-icon-inactive"><i class="fa-solid fa-user-slash"></i></div>
            <div class="hr-info">
                <div class="hr-label">Inactive Employees</div>
                <div class="hr-val">@Model.InactiveEmployees</div>
            </div>
        </div>
    </div>
    <!-- Locked Accounts -->
    <div class="col-xl-3 col-md-6">
        <div class="card-hr bar-locked">
            <div class="hr-icon-wrap hr-icon-locked"><i class="fa-solid fa-user-lock"></i></div>
            <div class="hr-info">
                <div class="hr-label">Locked Accounts</div>
                <div class="hr-val">@Model.LockedAccounts</div>
            </div>
        </div>
    </div>
</div>

<!-- Middle Panels (Charts & Recent Onboardings) -->
<div class="row g-4 mb-4">
    <!-- Role & Department Distribution Chart -->
    <div class="col-lg-6">
        <div class="hr-panel">
            <div class="panel-header-hr">
                <div>
                    <span class="panel-eyebrow">Workforce Composition</span>
                    <h5 class="panel-title-hr">Staff Distribution by Role</h5>
                </div>
                <div class="panel-icon-badge"><i class="fa-solid fa-chart-pie"></i></div>
            </div>
            <div style="position: relative; height: 260px; width: 100%;">
                <canvas id="roleChart"></canvas>
            </div>
        </div>
    </div>

    <!-- Recent Onboardings List -->
    <div class="col-lg-6">
        <div class="hr-panel">
            <div class="panel-header-hr">
                <div>
                    <span class="panel-eyebrow">Latest Activity</span>
                    <h5 class="panel-title-hr">Recent Onboardings</h5>
                </div>
                <span class="badge bg-light text-dark border fw-bold" style="font-size: 0.7rem; border-color: var(--hr-border) !important;">Last 5 Hires</span>
            </div>

            <div class="timeline-hr">
                @if (Model.RecentHires != null && Model.RecentHires.Any())
                {
                    foreach (var hire in Model.RecentHires)
                    {
                        var timeDiff = DateTime.UtcNow - hire.CreatedAt.ToUniversalTime();
                        var timeStr = timeDiff.TotalMinutes < 60 ? $"{(int)timeDiff.TotalMinutes} min ago" :
                        timeDiff.TotalHours < 24 ? $"{(int)timeDiff.TotalHours} hour ago" :
                        $"{(int)timeDiff.TotalDays} days ago";

                        <div class="timeline-item">
                            <div class="timeline-avatar">
                                @hire.FullName.Substring(0, 1).ToUpper()
                            </div>
                            <div class="text-start flex-grow-1">
                                <div class="fw-bold text-dark mb-0" style="font-size: 0.85rem;">@hire.FullName</div>
                                <div class="text-muted" style="font-size: 0.78rem;">
                                    <code style="color: var(--hr-amber); font-weight: 700;">@hire.UserCode</code> &middot; <strong>@(hire.Role?.RoleName ?? "Employee")</strong>
                                </div>
                            </div>
                            <div class="timeline-time">@timeStr</div>
                        </div>
                    }
                }
                else
                {
                    <div class="text-center text-muted py-5">No recent hiring entries recorded.</div>
                }
            </div>
        </div>
    </div>
</div>

<!-- Active Staff Directory Table Panel -->
<div class="hr-panel p-0 overflow-hidden">
    <div class="panel-header-hr p-4 pb-3 mb-0" style="border-bottom: 1px solid var(--hr-border);">
        <div>
            <span class="panel-eyebrow">Employee Records</span>
            <h5 class="panel-title-hr">Staff Directory</h5>
        </div>
        <a href="/Users" class="btn btn-action-warm px-3 py-2">
            <i class="fa-solid fa-shield-halved me-2"></i>Manage Access
        </a>
    </div>

    <div class="table-responsive">
        <table class="table table-hr mb-0 border-0">
            <thead>
                <tr>
                    <th class="border-0">Employee Code</th>
                    <th class="border-0">Full Name</th>
                    <th class="border-0">Username</th>
                    <th class="border-0">Email</th>
                    <th class="border-0">Phone</th>
                    <th class="border-0">Role</th>
                    <th class="border-0 text-center">Status</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.EmployeesList != null && Model.EmployeesList.Any())
                {
                    foreach (var emp in Model.EmployeesList)
                    {
                        <tr>
                            <td class="fw-bold text-secondary">@emp.UserCode</td>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <div class="timeline-avatar" style="width:28px; height:28px; border-radius:8px; font-size:0.7rem;">
                                        @emp.FullName.Substring(0, 1).ToUpper()
                                    </div>
                                    <span class="fw-bold text-dark">@emp.FullName</span>
                                </div>
                            </td>
                            <td class="text-muted">@@@emp.UserName</td>
                            <td>@emp.Email</td>
                            <td>@(string.IsNullOrEmpty(emp.MobileNumber) ? "N/A" : emp.MobileNumber)</td>
                            <td>
                                <span class="badge badge-role-pill px-2.5 py-1.5" style="font-size: 0.75rem;">
                                    <i class="fa-solid fa-user-tag me-1" style="color: var(--hr-primary);"></i>
                                    @(emp.Role?.RoleName ?? "Employee")
                                </span>
                            </td>
                            <td class="text-center">
                                @if (emp.IsActive)
                                {
                                    <span class="badge rounded-pill px-2.5 py-1.5 badge-active" style="font-size: 0.75rem;">Active</span>
                                }
                                else
                                {
                                    <span class="badge rounded-pill px-2.5 py-1.5 badge-inactive" style="font-size: 0.75rem;">Inactive</span>
                                }
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="text-center text-muted py-5">No employee records recorded in the system.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script src="~/lib/chart.js/chart.umd.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", () => {
            const roleCtx = document.getElementById('roleChart').getContext('2d');

            const chartLabels = @Html.Raw(Json.Serialize(Model.RoleDistribution.Select(r => r.RoleName)));
            const chartData = @Html.Raw(Json.Serialize(Model.RoleDistribution.Select(r => r.Count)));

            const warmPalette = [
                '#4f46e5', '#10b981', '#d97706', '#ec4899',
                '#06b6d4', '#f43f5e', '#8b5cf6', '#7c8798'
            ];

            new Chart(roleCtx, {
                type: 'doughnut',
                data: {
                    labels: chartLabels,
                    datasets: [{
                        data: chartData,
                        backgroundColor: warmPalette.slice(0, chartLabels.length),
                        borderWidth: 2,
                        borderColor: '#ffffff',
                        hoverOffset: 6
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    cutout: '68%',
                    plugins: {
                        legend: {
                            position: 'right',
                            labels: {
                                usePointStyle: true,
                                pointStyle: 'circle',
                                boxWidth: 7,
                                padding: 14,
                                font: { size: 11, weight: '600' },
                                color: '#4b5563'
                            }
                        }
                    }
                }
            });
        });
    </script>
}
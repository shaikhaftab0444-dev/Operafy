@model ERP_System.Models.EmployeeDashboardViewModel

@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Employee Portal";
    var currentUser = Model.CurrentUser;
    var activityLogs = Model.ActivityLogs;
    var transactions = Model.Transactions;
    var inCulture = new System.Globalization.CultureInfo("en-IN");
}

<style>
    /* =========================================================
           EMPLOYEE PORTAL - PREMIUM ERP DESIGN
           ========================================================= */

    .employee-portal {
        animation: portalFadeIn 0.55s ease both;
    }

    @@keyframes portalFadeIn {
        from

    {
        opacity: 0;
        transform: translateY(10px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }

    }

    /* =========================================================
           WELCOME BANNER
           ========================================================= */

    .welcome-banner {
        position: relative;
        overflow: hidden;
        background: linear-gradient(135deg, #ffffff 0%, #f8fbff 55%, #f5f9ff 100%);
        border: 1px solid #e8edf5;
        border-radius: 20px;
        padding: 24px 26px;
        box-shadow: 0 10px 35px rgba(15, 23, 42, 0.055);
        animation: bannerSlide 0.65s ease both;
    }

    @@keyframes bannerSlide {
        from

    {
        opacity: 0;
        transform: translateY(-8px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }

    }

    .welcome-banner::before {
        content: "";
        position: absolute;
        width: 230px;
        height: 230px;
        border-radius: 50%;
        background: rgba(13, 110, 253, 0.055);
        right: -85px;
        top: -130px;
        pointer-events: none;
    }

    .welcome-banner::after {
        content: "";
        position: absolute;
        width: 120px;
        height: 120px;
        border-radius: 50%;
        background: rgba(13, 110, 253, 0.035);
        right: 150px;
        bottom: -80px;
        pointer-events: none;
    }

    .welcome-content {
        position: relative;
        z-index: 2;
    }

    .employee-avatar {
        width: 58px;
        height: 58px;
        min-width: 58px;
        border-radius: 17px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(135deg, #0d6efd, #4f8dfd);
        color: #fff;
        font-size: 1.45rem;
        font-weight: 750;
        border: 0;
        box-shadow: 0 10px 25px rgba(13, 110, 253, 0.22);
        animation: avatarFloat 3.2s ease-in-out infinite;
    }

    @@keyframes avatarFloat {
        0%, 100%

    {
        transform: translateY(0);
    }

    50% {
        transform: translateY(-4px);
    }

    }

    .welcome-title {
        color: #182233;
        font-size: 1.28rem;
        font-weight: 750;
        letter-spacing: -0.025em;
        margin-bottom: 5px;
    }

    .welcome-subtitle {
        color: #7b8799;
        font-size: 0.78rem;
        margin: 0;
    }

    .portal-status {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        background: #ecfdf3;
        color: #16834d;
        border: 1px solid #d6f4e2;
        border-radius: 30px;
        padding: 7px 11px;
        font-size: 0.7rem;
        font-weight: 700;
        white-space: nowrap;
    }

    .portal-status-dot {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: #20a464;
        box-shadow: 0 0 0 4px rgba(32, 164, 100, 0.08);
    }

    /* =========================================================
           COMMON CARD
           ========================================================= */

    .emp-card {
        height: 100%;
        background: #ffffff;
        border: 1px solid #e9edf3;
        border-radius: 18px;
        padding: 21px;
        box-shadow: 0 9px 30px rgba(15, 23, 42, 0.05);
        transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
        animation: cardRise 0.65s ease both;
    }

        .emp-card:hover {
            transform: translateY(-3px);
            border-color: #dde5f0;
            box-shadow: 0 15px 38px rgba(15, 23, 42, 0.075);
        }

    @@keyframes cardRise {
        from

    {
        opacity: 0;
        transform: translateY(12px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }

    }

    .section-heading {
        display: flex;
        align-items: center;
        gap: 11px;
    }

    .section-icon {
        width: 38px;
        height: 38px;
        min-width: 38px;
        border-radius: 11px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background: #eef5ff;
        color: #0d6efd;
        font-size: 14px;
    }

    .section-title {
        color: #202939;
        font-size: 0.98rem;
        font-weight: 750;
        margin: 0;
    }

    .section-subtitle {
        color: #929baa;
        font-size: 0.69rem;
        margin: 3px 0 0;
    }

    .section-divider {
        height: 1px;
        border: 0;
        background: #edf0f4;
        opacity: 1;
        margin: 18px 0;
    }

    /* =========================================================
           PROFILE CARD
           ========================================================= */

    .profile-card {
        animation-delay: 0.05s;
    }

    .profile-details {
        display: flex;
        flex-direction: column;
        gap: 0;
    }

    .profile-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 18px;
        padding: 12px 0;
        border-bottom: 1px solid #f0f2f5;
        transition: all 0.2s ease;
    }

        .profile-row:first-child {
            padding-top: 0;
        }

        .profile-row:last-child {
            border-bottom: 0;
            padding-bottom: 0;
        }

        .profile-row:hover {
            padding-left: 5px;
            padding-right: 5px;
            background: #fafcff;
        }

    .profile-label {
        color: #8a94a6;
        font-size: 0.67rem;
        font-weight: 750;
        text-transform: uppercase;
        letter-spacing: 0.045em;
        white-space: nowrap;
    }

    .profile-value {
        color: #273244;
        font-size: 0.78rem;
        font-weight: 600;
        text-align: right;
        word-break: break-word;
    }

    .employee-code {
        color: #0d6efd;
        background: #f0f6ff;
        border: 1px solid #dfebff;
        border-radius: 7px;
        padding: 4px 8px;
        font-size: 0.72rem;
        font-weight: 750;
    }

    .role-badge {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        background: #f8fafc;
        color: #475569;
        border: 1px solid #e5e9ef !important;
        border-radius: 8px;
        padding: 5px 8px;
        font-size: 0.69rem;
        font-weight: 700;
    }

        .role-badge i {
            color: #0d6efd !important;
        }

    .badge-active {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background-color: #ecfdf3;
        color: #16834d;
        font-weight: 700;
        border: 1px solid #d4f3e0;
        font-size: 0.69rem;
    }

        .badge-active::before {
            content: "";
            width: 6px;
            height: 6px;
            background: #20a464;
            border-radius: 50%;
        }

    /* =========================================================
           OPERATIONS BULLETIN
           ========================================================= */

    .activity-card {
        animation-delay: 0.12s;
    }

    .activity-list-emp {
        display: flex;
        flex-direction: column;
        gap: 0;
    }

    .activity-item-emp {
        position: relative;
        display: flex;
        gap: 12px;
        align-items: flex-start;
        padding: 12px 7px;
        border-bottom: 1px solid #f0f2f5;
        border-radius: 10px;
        transition: all 0.22s ease;
    }

        .activity-item-emp:first-child {
            padding-top: 0;
        }

        .activity-item-emp:last-child {
            border-bottom: 0;
            padding-bottom: 0;
        }

        .activity-item-emp:hover {
            background: #f9fbff;
            transform: translateX(3px);
            padding-left: 10px;
        }

    .activity-icon-emp {
        width: 36px;
        height: 36px;
        min-width: 36px;
        border-radius: 10px;
        background-color: #f1f5ff;
        color: #0d6efd;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.85rem;
        flex-shrink: 0;
        transition: transform 0.25s ease;
    }

    .activity-item-emp:hover .activity-icon-emp {
        transform: scale(1.08);
    }

    .activity-title {
        color: #273244;
        font-size: 0.79rem;
        font-weight: 700;
        margin-bottom: 3px;
    }

    .activity-description {
        color: #7c8798;
        font-size: 0.73rem;
        line-height: 1.45;
    }

    .activity-time {
        color: #a0a8b5;
        font-size: 0.67rem;
        white-space: nowrap;
        padding-top: 2px;
    }

    .empty-message {
        text-align: center;
        padding: 32px 15px;
        color: #98a2b3;
        font-size: 0.76rem;
    }

    .empty-message-icon {
        width: 45px;
        height: 45px;
        margin: 0 auto 10px;
        border-radius: 13px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #f6f8fa;
        color: #9ba5b3;
    }

    /* =========================================================
           TABLE CARDS
           ========================================================= */

    .table-card {
        padding: 0;
        overflow: hidden;
    }

    .table-card-header {
        padding: 20px 21px 16px;
        background: linear-gradient(180deg, #ffffff 0%, #fbfcfe 100%);
        border-bottom: 1px solid #edf0f4;
    }

    .table-responsive {
        scrollbar-width: thin;
    }

    .table-emp {
        min-width: 650px;
        margin-bottom: 0 !important;
        border-collapse: separate;
        border-spacing: 0;
    }

        .table-emp th {
            background-color: #f8fafc !important;
            font-size: 0.67rem;
            text-transform: uppercase;
            font-weight: 750;
            letter-spacing: 0.04em;
            color: #738095;
            border-bottom: 1px solid #e9edf3 !important;
            padding: 13px 16px;
            white-space: nowrap;
            vertical-align: middle;
        }

        .table-emp td {
            font-size: 0.76rem;
            color: #526071;
            border-bottom: 1px solid #f0f2f5;
            padding: 14px 16px;
            vertical-align: middle;
            background: #ffffff;
            transition: background 0.2s ease;
        }

        .table-emp tbody tr {
            transition: transform 0.2s ease;
        }

            .table-emp tbody tr:hover td {
                background: #f9fbff;
            }

            .table-emp tbody tr:last-child td {
                border-bottom: 0;
            }

    .transaction-type {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        color: #526071;
        font-weight: 600;
    }

        .transaction-type::before {
            content: "";
            width: 6px;
            height: 6px;
            border-radius: 50%;
            background: #94a3b8;
        }

    .transaction-number {
        color: #0d6efd;
        font-weight: 750;
        font-size: 0.75rem;
    }

    .amount-value {
        color: #263244;
        font-weight: 750;
        white-space: nowrap;
    }

    .salary-value {
        color: #16834d;
        font-weight: 750;
        white-space: nowrap;
    }

    .status-pill {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        border-radius: 30px;
        padding: 5px 9px;
        font-size: 0.66rem;
        font-weight: 700;
        white-space: nowrap;
    }

    .status-paid {
        background: #ecfdf3;
        color: #16834d;
        border: 1px solid #d5f3e1;
    }

    .status-pending {
        background: #fff8e7;
        color: #a66b00;
        border: 1px solid #ffedbd;
    }

    .print-btn {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        border-radius: 8px;
        font-size: 0.68rem;
        font-weight: 650;
        border-color: #dce2e9;
        color: #596579;
        background: #fff;
        transition: all 0.22s ease;
    }

        .print-btn:hover {
            color: #0d6efd;
            border-color: #b9d2fa;
            background: #f5f9ff;
            transform: translateY(-1px);
        }

    /* =========================================================
           BOTTOM CARDS
           ========================================================= */

    .ledger-card {
        animation-delay: 0.18s;
    }

    .payslip-card {
        animation-delay: 0.24s;
    }

    /* =========================================================
           RESPONSIVE
           ========================================================= */

    @@media (max-width: 1199.98px) {
        .welcome-banner

    {
        padding: 22px;
    }

    .profile-row {
        gap: 12px;
    }

    .profile-label {
        font-size: 0.63rem;
    }

    }

    @@media (max-width: 991.98px) {
        .welcome-banner

    {
        border-radius: 17px;
    }

    .welcome-title {
        font-size: 1.16rem;
    }

    .emp-card {
        border-radius: 16px;
    }

    .table-card-header {
        padding: 18px;
    }

    }

    @@media (max-width: 767.98px) {
        .employee-portal

    {
        padding-left: 1px;
        padding-right: 1px;
    }

    .welcome-banner {
        padding: 19px;
        border-radius: 15px;
    }

    .welcome-content {
        flex-wrap: wrap;
    }

    .employee-avatar {
        width: 50px;
        height: 50px;
        min-width: 50px;
        border-radius: 14px;
        font-size: 1.2rem;
    }

    .welcome-title {
        font-size: 1.02rem;
    }

    .welcome-subtitle {
        font-size: 0.7rem;
    }

    .portal-status {
        margin-left: 63px;
        margin-top: -4px;
    }

    .emp-card {
        padding: 18px;
        border-radius: 15px;
    }

    .profile-row {
        align-items: flex-start;
        flex-direction: column;
        gap: 5px;
    }

    .profile-value {
        text-align: left;
        width: 100%;
    }

    .profile-label {
        font-size: 0.63rem;
    }

    .activity-item-emp {
        gap: 9px;
    }

    .activity-time {
        display: none;
    }

    .table-card {
        padding: 0;
    }

    .table-card-header {
        padding: 17px;
    }

    .table-emp {
        min-width: 620px;
    }

        .table-emp th,
        .table-emp td {
            padding-left: 13px;
            padding-right: 13px;
        }

    }

    @@media (max-width: 575.98px) {
        .container-fluid.py-4

    {
        padding-top: 15px !important;
    }

    .welcome-banner {
        margin-bottom: 15px !important;
    }

    .welcome-content {
        align-items: flex-start !important;
    }

    .portal-status {
        margin-left: 0;
        width: fit-content;
    }

    .section-title {
        font-size: 0.9rem;
    }

    .section-subtitle {
        font-size: 0.65rem;
    }

    .section-icon {
        width: 34px;
        height: 34px;
        min-width: 34px;
    }

    .profile-row {
        padding: 10px 0;
    }

    .activity-icon-emp {
        width: 33px;
        height: 33px;
        min-width: 33px;
    }

    .activity-title {
        font-size: 0.75rem;
    }

    .activity-description {
        font-size: 0.68rem;
    }

    .table-card-header {
        padding: 16px;
    }

    }

    /* =========================================================
           REDUCED MOTION ACCESSIBILITY
           ========================================================= */

    @@media (prefers-reduced-motion: reduce) {
        .employee-portal, .welcome-banner, .emp-card, .employee-avatar

    {
        animation: none !important;
    }

    .emp-card,
    .activity-item-emp,
    .activity-icon-emp,
    .print-btn,
    .profile-row {
        transition: none !important;
    }

    }</style>


<div class="container-fluid py-4 text-start employee-portal">

    <!-- =========================================================
         WELCOME HEADER
         ========================================================= -->

    <div class="welcome-banner mb-4">

        <div class="d-flex align-items-center justify-content-between gap-3 welcome-content">

            <div class="d-flex align-items-center gap-3">

                <div class="employee-avatar">
                    @(currentUser != null && !string.IsNullOrEmpty(currentUser.FullName)
                                        ? currentUser.FullName.Substring(0, 1).ToUpper()
                                        : "E")
                </div>

                <div>
                    <h4 class="welcome-title">
                        Good day, @(currentUser != null ? currentUser.FullName : "Employee")!
                    </h4>

                    <p class="welcome-subtitle">
                        <i class="fa-solid fa-calendar-day me-1"></i>
                        Welcome back to your central operations panel.
                    </p>
                </div>

            </div>

            <div class="portal-status">
                <span class="portal-status-dot"></span>
                Employee Portal Active
            </div>

        </div>

    </div>


    <!-- =========================================================
         PROFILE + OPERATIONS
         ========================================================= -->

    <div class="row g-4 mb-4">

        <!-- Profile Card -->
        <div class="col-lg-5">

            <div class="emp-card profile-card text-start">

                <div class="section-heading">

                    <div class="section-icon">
                        <i class="fa-solid fa-user"></i>
                    </div>

                    <div>
                        <h5 class="section-title">
                            My Profile Summary
                        </h5>

                        <p class="section-subtitle">
                            Your employee account information
                        </p>
                    </div>

                </div>

                <hr class="section-divider" />

                @if (currentUser != null)
                {
                    <div class="profile-details">

                        <!-- Employee Code -->
                        <div class="profile-row">

                            <span class="profile-label">
                                Employee Code
                            </span>

                            <code class="employee-code">
                                @currentUser.UserCode
                            </code>

                        </div>

                        <!-- Username -->
                        <div class="profile-row">

                            <span class="profile-label">
                                System Username
                            </span>

                            <strong class="profile-value">
                                @@ @currentUser.UserName
                            </strong>

                        </div>

                        <!-- Email -->
                        <div class="profile-row">

                            <span class="profile-label">
                                Work Email
                            </span>

                            <span class="profile-value">
                                @currentUser.Email
                            </span>

                        </div>

                        <!-- Phone -->
                        <div class="profile-row">

                            <span class="profile-label">
                                Phone Connection
                            </span>

                            <span class="profile-value">
                                @(string.IsNullOrEmpty(currentUser.MobileNumber)
                                                            ? "N/A"
                                                            : currentUser.MobileNumber)
                        </span>

                        </div>

                        <!-- Role -->
                        <div class="profile-row">

                            <span class="profile-label">
                                Assigned Role
                            </span>

                            <span class="role-badge">
                                <i class="fa-solid fa-user-tag"></i>
                                @(currentUser.Role?.RoleName ?? "Employee")
                            </span>

                        </div>

                        <!-- Status -->
                        <div class="profile-row">

                            <span class="profile-label">
                                Access Status
                            </span>

                            <span class="badge rounded-pill px-2.5 py-1.5 badge-active">
                                Active Member
                            </span>

                        </div>

                    </div>
                                }
                else
                {
                    <div class="empty-message">
                        <div class="empty-message-icon">
                            <i class="fa-solid fa-user-slash"></i>
                        </div>

                        Unable to load employee profile records.
                    </div>
                }

            </div>

        </div>


        <!-- Operations Bulletin -->
        <div class="col-lg-7">

            <div class="emp-card activity-card text-start">

                <div class="section-heading">

                    <div class="section-icon">
                        <i class="fa-solid fa-bell"></i>
                    </div>

                    <div>
                        <h5 class="section-title">
                            Operations Bulletin
                        </h5>

                        <p class="section-subtitle">
                            Recent system activities and updates
                        </p>
                    </div>

                </div>

                <hr class="section-divider" />

                <div class="activity-list-emp">

                    @if (activityLogs != null && activityLogs.Any())
                    {
                        foreach (var activity in activityLogs)
                        {
                            var timeDiff = DateTime.UtcNow - activity.CreatedAt.ToUniversalTime();

                            var timeStr = timeDiff.TotalMinutes < 60
                            ? $"{(int)timeDiff.TotalMinutes}m ago"
                            : timeDiff.TotalHours < 24
                            ? $"{(int)timeDiff.TotalHours}h ago"
                            : $"{(int)timeDiff.TotalDays}d ago";

                            <div class="activity-item-emp">

                                <div class="activity-icon-emp @activity.ColorClass">
                                    <i class="fa-solid @activity.IconClass"></i>
                                </div>

                                <div class="flex-grow-1">

                                    <div class="activity-title">
                                        @activity.Title
                                    </div>

                                    <div class="activity-description">
                                        @activity.Description
                                    </div>

                                </div>

                                <div class="activity-time">
                                    @timeStr
                                </div>

                            </div>
                        }
                    }
                    else
                    {
                        <div class="empty-message">

                            <div class="empty-message-icon">
                                <i class="fa-solid fa-bell-slash"></i>
                            </div>

                            No recent update bulletins active.

                        </div>
                    }

                </div>

            </div>

        </div>

    </div>


    <!-- =========================================================
         BOTTOM ROW
         ========================================================= -->

    <div class="row g-4">

        <!-- =====================================================
             OPERATIONAL LEDGER
             ===================================================== -->

        <div class="col-lg-7">

            <div class="emp-card table-card ledger-card text-start">

                <div class="table-card-header">

                    <div class="section-heading">

                        <div class="section-icon">
                            <i class="fa-solid fa-receipt"></i>
                        </div>

                        <div>
                            <h5 class="section-title">
                                Operational Ledger Reference
                            </h5>

                            <p class="section-subtitle">
                                Recent transaction records
                            </p>
                        </div>

                    </div>

                </div>

                <div class="table-responsive">

                    <table class="table table-hover table-emp mb-0 border-0">

                        <thead>
                            <tr>
                                <th class="border-0">Type</th>
                                <th class="border-0">Order No.</th>
                                <th class="border-0">Date</th>
                                <th class="border-0">Amount</th>
                                <th class="border-0">Status</th>
                            </tr>
                        </thead>

                        <tbody>

                            @if (transactions != null && transactions.Any())
                            {
                                foreach (var tx in transactions)
                                {
                                    var statusClass = tx.Status == "Paid"
                                    ? "status-paid"
                                    : "status-pending";

                                    <tr>

                                        <td>
                                            <span class="transaction-type">
                                                @tx.Type
                                            </span>
                                        </td>

                                        <td>
                                            <span class="transaction-number">
                                                @tx.TransactionNo
                                            </span>
                                        </td>

                                        <td>
                                            @tx.Date.ToString("dd MMM yyyy")
                                        </td>

                                        <td>
                                            <span class="amount-value">
                                                @tx.Amount.ToString("C0", inCulture)
                                            </span>
                                        </td>

                                        <td>
                                            <span class="status-pill @statusClass">
                                                @tx.Status
                                            </span>
                                        </td>

                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>

                                    <td colspan="5">

                                        <div class="empty-message">

                                            <div class="empty-message-icon">
                                                <i class="fa-solid fa-receipt"></i>
                                            </div>

                                            No ledger records found in database.

                                        </div>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

            </div>

        </div>


        <!-- =====================================================
             MY PAYSLIPS
             ===================================================== -->

        <div class="col-lg-5">

            <div class="emp-card table-card payslip-card text-start">

                <div class="table-card-header">

                    <div class="section-heading">

                        <div class="section-icon">
                            <i class="fa-solid fa-file-invoice-dollar"></i>
                        </div>

                        <div>
                            <h5 class="section-title">
                                My Salary Slips
                            </h5>

                            <p class="section-subtitle">
                                Your recently generated payslips
                            </p>
                        </div>

                    </div>

                </div>

                <div class="table-responsive">

                    <table class="table table-hover table-emp mb-0 border-0">

                        <thead>

                            <tr>
                                <th class="border-0">Period</th>
                                <th class="border-0">Net Salary</th>
                                <th class="border-0 text-center">Action</th>
                            </tr>

                        </thead>

                        <tbody>

                            @{
                                var myPayslips = Model.RecentPayslips;
                            }

                            @if (myPayslips != null && myPayslips.Any())
                            {
                                foreach (var slip in myPayslips)
                                {
                                    <tr>

                                        <td class="fw-bold text-dark">
                                            @(slip.PayPeriod ?? "N/A")
                                        </td>

                                        <td>
                                            <span class="salary-value">
                                                @(slip.NetSalary?.ToString("C0", inCulture) ?? "₹0")
                                            </span>
                                        </td>

                                        <td class="text-center">

                                            <a href="/Payroll/ViewPayslip/@slip.PayslipId"
                                               target="_blank"
                                               class="btn btn-sm print-btn px-3 py-1">

                                                <i class="fa-solid fa-print"></i>
                                                Print

                                            </a>

                                        </td>

                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>

                                    <td colspan="3">

                                        <div class="empty-message">

                                            <div class="empty-message-icon">
                                                <i class="fa-solid fa-file-circle-xmark"></i>
                                            </div>

                                            No payslips generated for your profile.

                                        </div>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

            </div>

        </div>

    </div>

</div>
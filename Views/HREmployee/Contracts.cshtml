@model IEnumerable<ERP_System.Models.HRContract>
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Employee Contracts & Documents";
}

<div class="container-fluid py-4 text-start">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-bold mb-1"><i class="fa-solid fa-file-contract text-primary me-2"></i>Contracts & Documents</h4>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0 small">
                    <li class="breadcrumb-item"><a href="/HR" class="text-decoration-none">HR Dashboard</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Contracts & Documents</li>
                </ol>
            </nav>
        </div>
        <button class="btn btn-primary rounded-pill px-3 btn-sm shadow-sm" data-bs-toggle="modal" data-bs-target="#uploadDocumentModal">
            <i class="fa-solid fa-upload me-1.5"></i>Upload Document
        </button>
    </div>

    <!-- Contracts List -->
    <div class="bg-white border rounded-3 p-4 shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" style="font-size: 0.85rem;">
                <thead class="table-light">
                    <tr>
                        <th>Employee</th>
                        <th>Document Type</th>
                        <th>File Name</th>
                        <th>Expiry/Renewal Date</th>
                        <th>Signing Status</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var c in Model)
                        {
                            <tr>
                                <td class="fw-bold text-dark">@c.EmployeeName</td>
                                <td>@c.DocumentType</td>
                                <td>
                                    <span class="text-primary"><i class="fa-solid fa-file-pdf me-1.5 text-danger"></i>@c.FileName</span>
                                </td>
                                <td class="text-muted">@(c.ExpiryDate.HasValue ? c.ExpiryDate.Value.ToString("dd MMM yyyy") : "N/A")</td>
                                <td>
                                    @{
                                        var badgeClass = c.SigningStatus == "Signed" ? "bg-success-subtle text-success" : "bg-warning-subtle text-warning";
                                    }
                                    <span class="badge @badgeClass rounded-pill">@c.SigningStatus</span>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center py-4 text-muted">No contracts found in database.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Upload Document Modal -->
<div class="modal fade text-start" id="uploadDocumentModal" tabindex="-1" aria-labelledby="uploadDocumentModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form action="/HREmployee/CreateContract" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title fw-bold" id="uploadDocumentModalLabel">Upload & Link Document</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Employee Name</label>
                        <input type="text" name="EmployeeName" class="form-control" placeholder="e.g. Numan Sales Man" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Document Type</label>
                        <select name="DocumentType" class="form-select" required>
                            <option value="Employment Contract">Employment Contract</option>
                            <option value="Non-Disclosure Agreement">Non-Disclosure Agreement</option>
                            <option value="KYC Verification Form">KYC Verification Form</option>
                            <option value="Relieving Letter">Relieving Letter</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">File Name</label>
                        <input type="text" name="FileName" class="form-control" placeholder="e.g. agreement_numan.pdf" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Expiry Date</label>
                        <input type="date" name="ExpiryDate" class="form-control" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Signing Status</label>
                        <select name="SigningStatus" class="form-select" required>
                            <option value="Signed">Signed</option>
                            <option value="Pending Signature">Pending Signature</option>
                            <option value="Draft">Draft</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary rounded-pill px-3 btn-sm" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary rounded-pill px-3 btn-sm">Upload</button>
                </div>
            </form>
        </div>
    </div>
</div>

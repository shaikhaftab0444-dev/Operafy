@model IEnumerable<ERP_System.Models.HROffboarding>
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Offboarding & Exit Clearances";
}

<div class="container-fluid py-4 text-start">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-bold mb-1"><i class="fa-solid fa-user-xmark text-primary me-2"></i>Offboarding & Exits</h4>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0 small">
                    <li class="breadcrumb-item"><a href="/HR" class="text-decoration-none">HR Dashboard</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Offboarding & Exits</li>
                </ol>
            </nav>
        </div>
        <button class="btn btn-primary rounded-pill px-3 btn-sm shadow-sm" data-bs-toggle="modal" data-bs-target="#initiateExitModal">
            <i class="fa-solid fa-plus me-1.5"></i>Initiate Exit
        </button>
    </div>

    <!-- Offboarding Table -->
    <div class="bg-white border rounded-3 p-4 shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" style="font-size: 0.85rem;">
                <thead class="table-light">
                    <tr>
                        <th>Employee</th>
                        <th>Resignation Date</th>
                        <th>Last Working Day</th>
                        <th>Asset Return</th>
                        <th>IT Clearance</th>
                        <th>Finance Clearance</th>
                        <th>Exit Interview</th>
                        <th>F&F Status</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var o in Model)
                        {
                            <tr>
                                <td class="fw-bold text-dark">@o.EmployeeName</td>
                                <td class="text-muted">@o.ResignationDate.ToString("dd MMM yyyy")</td>
                                <td class="text-muted">@o.LastWorkingDay.ToString("dd MMM yyyy")</td>
                                <td>
                                    @{
                                        var assetClass = o.AssetReturn == "Returned" ? "bg-success-subtle text-success" : "bg-warning-subtle text-warning";
                                    }
                                    <span class="badge @assetClass">@o.AssetReturn</span>
                                </td>
                                <td>
                                    @{
                                        var itClass = o.ITClearance == "Cleared" ? "bg-success-subtle text-success" : "bg-warning-subtle text-warning";
                                    }
                                    <span class="badge @itClass">@o.ITClearance</span>
                                </td>
                                <td>
                                    @{
                                        var finClass = o.FinanceClearance.Contains("Cleared") ? "bg-success-subtle text-success" : "bg-warning-subtle text-warning";
                                    }
                                    <span class="badge @finClass">@o.FinanceClearance</span>
                                </td>
                                <td>
                                    @{
                                        var exitClass = o.ExitInterview == "Done" ? "bg-success-subtle text-success" : "bg-secondary-subtle text-secondary";
                                    }
                                    <span class="badge @exitClass">@o.ExitInterview</span>
                                </td>
                                <td>
                                    @{
                                        var ffClass = o.FfStatus == "Settled" ? "bg-success-subtle text-success" : "bg-secondary-subtle text-secondary";
                                    }
                                    <span class="badge @ffClass">@o.FfStatus</span>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="text-center py-4 text-muted">No exits recorded in database.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Initiate Exit Modal -->
<div class="modal fade text-start" id="initiateExitModal" tabindex="-1" aria-labelledby="initiateExitModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form action="/HREmployee/CreateOffboarding" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title fw-bold" id="initiateExitModalLabel">Initiate Employee Offboarding</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Employee Name</label>
                        <input type="text" name="EmployeeName" class="form-control" placeholder="e.g. Vikram Singh" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Resignation Submission Date</label>
                        <input type="date" name="ResignationDate" class="form-control" value="@DateTime.Now.ToString("yyyy-MM-dd")" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Last Working Day</label>
                        <input type="date" name="LastWorkingDay" class="form-control" value="@DateTime.Now.AddDays(30).ToString("yyyy-MM-dd")" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Asset Handover Status</label>
                        <select name="AssetReturn" class="form-select" required>
                            <option value="Pending">Pending</option>
                            <option value="Returned">Returned</option>
                            <option value="N/A">N/A</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">IT Clearance</label>
                        <select name="ITClearance" class="form-select" required>
                            <option value="Pending">Pending</option>
                            <option value="Cleared">Cleared</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Finance & HR Clearance</label>
                        <select name="FinanceClearance" class="form-select" required>
                            <option value="Pending">Pending</option>
                            <option value="Pending Review">Pending Review</option>
                            <option value="Cleared & Approved">Cleared & Approved</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Exit Interview Conducted</label>
                        <select name="ExitInterview" class="form-select" required>
                            <option value="Pending">Pending</option>
                            <option value="Done">Done</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Settlement & F&F Status</label>
                        <select name="FfStatus" class="form-select" required>
                            <option value="In Progress">In Progress</option>
                            <option value="Settled">Settled</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary rounded-pill px-3 btn-sm" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary rounded-pill px-3 btn-sm">Initiate Exit</button>
                </div>
            </form>
        </div>
    </div>
</div>

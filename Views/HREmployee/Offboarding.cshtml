@model IEnumerable<ERP_System.Models.HROffboarding>
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Offboarding & Exit Clearances";

    var totalExits = Model?.Count() ?? 0;
    var pendingExits = Model?.Count(o => o.FfStatus != "Settled") ?? 0;
    var settledExits = Model?.Count(o => o.FfStatus == "Settled") ?? 0;
}

<div class="offboarding-page container-fluid py-4 text-start">

    <!-- =========================================================
         PAGE HEADER
         ========================================================= -->

    <div class="offboarding-header d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-4">

        <div class="offboarding-title-section">

            <div class="offboarding-title-icon">
                <i class="fa-solid fa-user-xmark"></i>
            </div>

            <div>
                <h4 class="fw-bold mb-1">Offboarding & Exits</h4>

                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb mb-0 small">

                        <li class="breadcrumb-item">
                            <a href="/HR" class="text-decoration-none">
                                HR Dashboard
                            </a>
                        </li>

                        <li class="breadcrumb-item active" aria-current="page">
                            Offboarding & Exits
                        </li>

                    </ol>
                </nav>
            </div>

        </div>


        <button class="btn btn-primary rounded-pill px-3 btn-sm shadow-sm initiate-exit-btn"
                data-bs-toggle="modal"
                data-bs-target="#initiateExitModal">

            <i class="fa-solid fa-plus me-1"></i>
            Initiate Exit

        </button>

    </div>


    <!-- =========================================================
         SUMMARY CARDS
         ========================================================= -->

    <div class="offboarding-summary-row mb-4">

        <!-- Total -->
        <div class="offboarding-summary-card">

            <div class="summary-icon summary-primary">
                <i class="fa-solid fa-users"></i>
            </div>

            <div class="summary-content">

                <span class="summary-label">
                    Total Exit Cases
                </span>

                <strong class="summary-value">
                    @totalExits
                </strong>

            </div>

        </div>


        <!-- Pending -->
        <div class="offboarding-summary-card">

            <div class="summary-icon summary-warning">
                <i class="fa-solid fa-hourglass-half"></i>
            </div>

            <div class="summary-content">

                <span class="summary-label">
                    In Progress
                </span>

                <strong class="summary-value">
                    @pendingExits
                </strong>

            </div>

        </div>


        <!-- Settled -->
        <div class="offboarding-summary-card">

            <div class="summary-icon summary-success">
                <i class="fa-solid fa-circle-check"></i>
            </div>

            <div class="summary-content">

                <span class="summary-label">
                    Fully Settled
                </span>

                <strong class="summary-value">
                    @settledExits
                </strong>

            </div>

        </div>

    </div>


    <!-- =========================================================
         OFFBOARDING TABLE CARD
         ========================================================= -->

    <div class="offboarding-table-card bg-white border rounded-3 shadow-sm">

        <!-- Card Header -->

        <div class="offboarding-card-header">

            <div>

                <h5 class="fw-bold mb-1">
                    <i class="fa-solid fa-right-from-bracket me-2 text-primary"></i>
                    Employee Exit Management
                </h5>

                <p class="offboarding-subtitle mb-0">
                    Track exit clearance, asset handover, interviews and final settlement.
                </p>

            </div>


            <div class="offboarding-record-count">

                <i class="fa-solid fa-layer-group me-1"></i>

                @totalExits
                @(totalExits == 1 ? "Record" : "Records")

            </div>

        </div>


        <!-- Table -->

        <div class="table-responsive">

            <table class="table offboarding-table table-hover align-middle mb-0">

                <thead>

                    <tr>

                        <th>Employee</th>

                        <th>Resignation Date</th>

                        <th>Last Working Day</th>

                        <th>Asset Return</th>

                        <th>IT Clearance</th>

                        <th>Finance Clearance</th>

                        <th>Exit Interview</th>

                        <th>F&amp;F Status</th>

                    </tr>

                </thead>


                <tbody>

                    @if (Model != null && Model.Any())
                    {
                        @foreach (var o in Model)
                        {
                            var isAssetReturned = o.AssetReturn == "Returned";
                            var isITCleared = o.ITClearance == "Cleared";
                            var isFinanceCleared = !string.IsNullOrEmpty(o.FinanceClearance) && o.FinanceClearance.Contains("Cleared");
                            var isInterviewDone = o.ExitInterview == "Done";
                            var isSettled = o.FfStatus == "Settled";

                            <tr>

                                <!-- Employee -->

                                <td>

                                    <div class="employee-cell">

                                        <div class="employee-avatar">

                                            @if (!string.IsNullOrEmpty(o.EmployeeName))
                                            {
                                                @o.EmployeeName.Substring(0, 1).ToUpper()
                                            }
                                            else
                                            {
                                                <i class="fa-solid fa-user"></i>
                                            }

                                        </div>

                                        <div class="employee-info">

                                            <span class="employee-name">
                                                @o.EmployeeName
                                            </span>

                                            <small>
                                                Employee Exit Process
                                            </small>

                                        </div>

                                    </div>

                                </td>


                                <!-- Resignation Date -->

                                <td>

                                    <div class="date-cell">

                                        <i class="fa-regular fa-calendar"></i>

                                        <span>
                                            @o.ResignationDate.ToString("dd MMM yyyy")
                                        </span>

                                    </div>

                                </td>


                                <!-- Last Working Day -->

                                <td>

                                    <div class="date-cell">

                                        <i class="fa-solid fa-calendar-day"></i>

                                        <span>
                                            @o.LastWorkingDay.ToString("dd MMM yyyy")
                                        </span>

                                    </div>

                                </td>


                                <!-- Asset Return -->

                                <td>

                                    @if (isAssetReturned)
                                    {
                                        <span class="status-pill status-success">

                                            <i class="fa-solid fa-box-open"></i>

                                            @o.AssetReturn

                                        </span>
                                    }
                                    else
                                    {
                                        <span class="status-pill status-warning">

                                            <i class="fa-solid fa-clock"></i>

                                            @o.AssetReturn

                                        </span>
                                    }

                                </td>


                                <!-- IT Clearance -->

                                <td>

                                    @if (isITCleared)
                                    {
                                        <span class="status-pill status-success">

                                            <i class="fa-solid fa-laptop-code"></i>

                                            @o.ITClearance

                                        </span>
                                    }
                                    else
                                    {
                                        <span class="status-pill status-warning">

                                            <i class="fa-solid fa-hourglass-half"></i>

                                            @o.ITClearance

                                        </span>
                                    }

                                </td>


                                <!-- Finance Clearance -->

                                <td>

                                    @if (isFinanceCleared)
                                    {
                                        <span class="status-pill status-success">

                                            <i class="fa-solid fa-check"></i>

                                            @o.FinanceClearance

                                        </span>
                                    }
                                    else
                                    {
                                        <span class="status-pill status-warning">

                                            <i class="fa-solid fa-clock"></i>

                                            @o.FinanceClearance

                                        </span>
                                    }

                                </td>


                                <!-- Exit Interview -->

                                <td>

                                    @if (isInterviewDone)
                                    {
                                        <span class="status-pill status-success">

                                            <i class="fa-solid fa-comments"></i>

                                            @o.ExitInterview

                                        </span>
                                    }
                                    else
                                    {
                                        <span class="status-pill status-neutral">

                                            <i class="fa-regular fa-clock"></i>

                                            @o.ExitInterview

                                        </span>
                                    }

                                </td>


                                <!-- F&F Status -->

                                <td>

                                    @if (isSettled)
                                    {
                                        <span class="status-pill status-success">

                                            <i class="fa-solid fa-circle-check"></i>

                                            @o.FfStatus

                                        </span>
                                    }
                                    else
                                    {
                                        <span class="status-pill status-neutral">

                                            <i class="fa-solid fa-spinner"></i>

                                            @o.FfStatus

                                        </span>
                                    }

                                </td>

                            </tr>
                        }
                    }
                    else
                    {
                        <!-- Empty State -->

                        <tr>

                            <td colspan="8">

                                <div class="offboarding-empty-state">

                                    <div class="empty-state-icon">
                                        <i class="fa-solid fa-user-xmark"></i>
                                    </div>

                                    <h6>
                                        No Exit Cases Found
                                    </h6>

                                    <p>
                                        No employee offboarding or exit records have been added yet.
                                    </p>

                                    <button class="btn btn-primary btn-sm rounded-pill px-3"
                                            data-bs-toggle="modal"
                                            data-bs-target="#initiateExitModal">

                                        <i class="fa-solid fa-plus me-1"></i>
                                        Initiate First Exit

                                    </button>

                                </div>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>


<!-- =========================================================
     INITIATE EXIT MODAL
     ========================================================= -->

<div class="modal fade exit-modal text-start"
     id="initiateExitModal"
     tabindex="-1"
     aria-labelledby="initiateExitModalLabel"
     aria-hidden="true">

    <div class="modal-dialog modal-lg modal-dialog-centered">

        <div class="modal-content">

            <form action="/HREmployee/CreateOffboarding" method="post">

                @Html.AntiForgeryToken()


                <!-- Modal Header -->

                <div class="modal-header">

                    <div class="modal-title-wrapper">

                        <div class="modal-title-icon">
                            <i class="fa-solid fa-user-xmark"></i>
                        </div>

                        <div>

                            <h5 class="modal-title fw-bold mb-0"
                                id="initiateExitModalLabel">

                                Initiate Employee Offboarding

                            </h5>

                            <small>
                                Start the employee exit and clearance process
                            </small>

                        </div>

                    </div>


                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal"
                            aria-label="Close">
                    </button>

                </div>


                <!-- Modal Body -->

                <div class="modal-body">

                    <div class="exit-form-section-title">

                        <span class="section-number">1</span>

                        <div>

                            <strong>Employee &amp; Exit Details</strong>

                            <small>
                                Provide employee and exit schedule information.
                            </small>

                        </div>

                    </div>


                    <div class="row g-3 mb-4">

                        <!-- Employee Name -->

                        <div class="col-md-12">

                            <div class="form-field">

                                <label class="form-label small fw-semibold">

                                    Employee Name

                                    <span class="required-star">*</span>

                                </label>

                                <div class="input-with-icon">

                                    <i class="fa-solid fa-user"></i>

                                    <input type="text"
                                           name="EmployeeName"
                                           class="form-control"
                                           placeholder="e.g. Vikram Singh"
                                           required />

                                </div>

                            </div>

                        </div>


                        <!-- Resignation Date -->

                        <div class="col-md-6">

                            <div class="form-field">

                                <label class="form-label small fw-semibold">

                                    Resignation Submission Date

                                    <span class="required-star">*</span>

                                </label>

                                <div class="input-with-icon">

                                    <i class="fa-regular fa-calendar"></i>

                                    <input type="date"
                                           name="ResignationDate"
                                           class="form-control"
                                           value="@DateTime.Now.ToString("yyyy-MM-dd")"
                                           required />

                                </div>

                            </div>

                        </div>


                        <!-- Last Working Day -->

                        <div class="col-md-6">

                            <div class="form-field">

                                <label class="form-label small fw-semibold">

                                    Last Working Day

                                    <span class="required-star">*</span>

                                </label>

                                <div class="input-with-icon">

                                    <i class="fa-solid fa-calendar-day"></i>

                                    <input type="date"
                                           name="LastWorkingDay"
                                           class="form-control"
                                           value="@DateTime.Now.AddDays(30).ToString("yyyy-MM-dd")"
                                           required />

                                </div>

                            </div>

                        </div>

                    </div>


                    <div class="exit-form-section-title">

                        <span class="section-number">2</span>

                        <div>

                            <strong>Clearance &amp; Settlement Status</strong>

                            <small>
                                Record the current status of the exit process.
                            </small>

                        </div>

                    </div>


                    <div class="row g-3">

                        <!-- Asset -->

                        <div class="col-md-6">

                            <div class="form-field">

                                <label class="form-label small fw-semibold">
                                    Asset Handover Status
                                </label>

                                <div class="input-with-icon">

                                    <i class="fa-solid fa-box"></i>

                                    <select name="AssetReturn"
                                            class="form-select"
                                            required>

                                        <option value="Pending">
                                            Pending
                                        </option>

                                        <option value="Returned">
                                            Returned
                                        </option>

                                        <option value="N/A">
                                            N/A
                                        </option>

                                    </select>

                                </div>

                            </div>

                        </div>


                        <!-- IT -->

                        <div class="col-md-6">

                            <div class="form-field">

                                <label class="form-label small fw-semibold">
                                    IT Clearance
                                </label>

                                <div class="input-with-icon">

                                    <i class="fa-solid fa-laptop-code"></i>

                                    <select name="ITClearance"
                                            class="form-select"
                                            required>

                                        <option value="Pending">
                                            Pending
                                        </option>

                                        <option value="Cleared">
                                            Cleared
                                        </option>

                                    </select>

                                </div>

                            </div>

                        </div>


                        <!-- Finance -->

                        <div class="col-md-6">

                            <div class="form-field">

                                <label class="form-label small fw-semibold">
                                    Finance &amp; HR Clearance
                                </label>

                                <div class="input-with-icon">

                                    <i class="fa-solid fa-file-invoice-dollar"></i>

                                    <select name="FinanceClearance"
                                            class="form-select"
                                            required>

                                        <option value="Pending">
                                            Pending
                                        </option>

                                        <option value="Pending Review">
                                            Pending Review
                                        </option>

                                        <option value="Cleared &amp; Approved">
                                            Cleared &amp; Approved
                                        </option>

                                    </select>

                                </div>

                            </div>

                        </div>


                        <!-- Exit Interview -->

                        <div class="col-md-6">

                            <div class="form-field">

                                <label class="form-label small fw-semibold">
                                    Exit Interview Conducted
                                </label>

                                <div class="input-with-icon">

                                    <i class="fa-solid fa-comments"></i>

                                    <select name="ExitInterview"
                                            class="form-select"
                                            required>

                                        <option value="Pending">
                                            Pending
                                        </option>

                                        <option value="Done">
                                            Done
                                        </option>

                                    </select>

                                </div>

                            </div>

                        </div>


                        <!-- F&F -->

                        <div class="col-md-12">

                            <div class="form-field">

                                <label class="form-label small fw-semibold">
                                    Settlement &amp; F&amp;F Status
                                </label>

                                <div class="input-with-icon">

                                    <i class="fa-solid fa-money-bill-transfer"></i>

                                    <select name="FfStatus"
                                            class="form-select"
                                            required>

                                        <option value="In Progress">
                                            In Progress
                                        </option>

                                        <option value="Settled">
                                            Settled
                                        </option>

                                    </select>

                                </div>

                            </div>

                        </div>

                    </div>


                    <!-- Information Box -->

                    <div class="exit-info-box">

                        <div class="info-box-icon">

                            <i class="fa-solid fa-circle-info"></i>

                        </div>

                        <div>

                            <strong>
                                Offboarding Process
                            </strong>

                            <p class="mb-0">
                                Review employee clearance, company assets, IT access, finance approvals and final settlement before closing the exit process.
                            </p>

                        </div>

                    </div>

                </div>


                <!-- Modal Footer -->

                <div class="modal-footer">

                    <button type="button"
                            class="btn btn-outline-secondary rounded-pill px-3 btn-sm"
                            data-bs-dismiss="modal">

                        <i class="fa-solid fa-xmark me-1"></i>
                        Cancel

                    </button>


                    <button type="submit"
                            class="btn btn-primary rounded-pill px-3 btn-sm submit-exit-btn">

                        <i class="fa-solid fa-right-from-bracket me-1"></i>
                        Initiate Exit

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>


<!-- =========================================================
     OFFBOARDING PAGE CSS & ANIMATIONS
     ========================================================= -->

<style>

    /* =========================================================
           PAGE VARIABLES
           ========================================================= */

    .offboarding-page {
        --ob-primary: #0d6efd;
        --ob-primary-dark: #0a58ca;
        --ob-success: #198754;
        --ob-warning: #b7791f;
        --ob-danger: #dc3545;
        --ob-text: #27364b;
        --ob-muted: #667085;
        --ob-border: #e7ebf0;
        --ob-shadow: 0 10px 30px rgba(15, 23, 42, 0.055);
        --ob-shadow-hover: 0 16px 38px rgba(15, 23, 42, 0.09);
    }


    /* =========================================================
           PAGE ENTRANCE
           ========================================================= */

    .offboarding-page {
        animation: offboardingPageEnter 0.55s cubic-bezier(0.22, 1, 0.36, 1) both;
    }


    @@keyframes offboardingPageEnter {
        from

    {
        opacity: 0;
        transform: translateY(12px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }

    }


    /* =========================================================
           HEADER
           ========================================================= */

    .offboarding-header {
        animation: offboardingHeaderEnter 0.65s cubic-bezier(0.22, 1, 0.36, 1) both;
    }


    @@keyframes offboardingHeaderEnter {
        from

    {
        opacity: 0;
        transform: translateY(-10px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }

    }


    /* =========================================================
           TITLE
           ========================================================= */

    .offboarding-title-section {
        display: flex;
        align-items: center;
        gap: 13px;
    }


    .offboarding-title-icon {
        width: 46px;
        height: 46px;
        min-width: 46px;
        border-radius: 13px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--ob-primary);
        background: linear-gradient( 135deg, #edf5ff, #f7faff );
        border: 1px solid #dceaff;
        box-shadow: 0 6px 16px rgba(13, 110, 253, 0.09);
        transition: all 0.25s ease;
    }


    .offboarding-title-section:hover .offboarding-title-icon {
        transform: translateY(-2px) rotate(-4deg);
        box-shadow: 0 10px 22px rgba(13, 110, 253, 0.15);
    }


    .offboarding-title-section h4 {
        color: var(--ob-text);
    }


    .offboarding-page .breadcrumb-item a {
        color: #667085;
        transition: color 0.2s ease;
    }


        .offboarding-page .breadcrumb-item a:hover {
            color: var(--ob-primary) !important;
        }


    /* =========================================================
           INITIATE EXIT BUTTON
           ========================================================= */

    .initiate-exit-btn {
        box-shadow: 0 6px 16px rgba(13, 110, 253, 0.18) !important;
        transition: transform 0.2s ease, box-shadow 0.2s ease, background-color 0.2s ease;
    }


        .initiate-exit-btn:hover {
            transform: translateY(-2px);
            background-color: var(--ob-primary-dark);
            box-shadow: 0 10px 23px rgba(13, 110, 253, 0.26) !important;
        }


        .initiate-exit-btn:active {
            transform: scale(0.97);
        }


        .initiate-exit-btn .fa-plus {
            transition: transform 0.22s ease;
        }


        .initiate-exit-btn:hover .fa-plus {
            transform: rotate(90deg);
        }


    /* =========================================================
           SUMMARY CARDS
           ========================================================= */

    .offboarding-summary-row {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 16px;
        animation: summaryCardsEnter 0.65s cubic-bezier(0.22, 1, 0.36, 1) 0.1s both;
    }


    @@keyframes summaryCardsEnter {
        from

    {
        opacity: 0;
        transform: translateY(14px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }

    }


    .offboarding-summary-card {
        min-height: 94px;
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 17px 18px;
        background: #ffffff;
        border: 1px solid var(--ob-border);
        border-radius: 14px;
        box-shadow: 0 6px 20px rgba(15, 23, 42, 0.035);
        transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
    }


        .offboarding-summary-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 13px 30px rgba(15, 23, 42, 0.075);
            border-color: #dce5ef;
        }


    .summary-icon {
        width: 47px;
        height: 47px;
        min-width: 47px;
        border-radius: 13px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 17px;
        transition: transform 0.25s ease;
    }


    .offboarding-summary-card:hover .summary-icon {
        transform: scale(1.08) rotate(-3deg);
    }


    .summary-primary {
        color: #0d6efd;
        background: #edf5ff;
    }


    .summary-warning {
        color: #b7791f;
        background: #fff8e7;
    }


    .summary-success {
        color: #198754;
        background: #eaf8f1;
    }


    .summary-content {
        display: flex;
        flex-direction: column;
        gap: 2px;
    }


    .summary-label {
        color: var(--ob-muted);
        font-size: 0.75rem;
        font-weight: 500;
    }


    .summary-value {
        color: var(--ob-text);
        font-size: 1.3rem;
        line-height: 1.2;
    }


    /* =========================================================
           TABLE CARD
           ========================================================= */

    .offboarding-table-card {
        overflow: hidden;
        border-color: var(--ob-border) !important;
        box-shadow: var(--ob-shadow) !important;
        animation: tableCardEnter 0.7s cubic-bezier(0.22, 1, 0.36, 1) 0.18s both;
        transition: box-shadow 0.25s ease;
    }


    @@keyframes tableCardEnter {
        from

    {
        opacity: 0;
        transform: translateY(18px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }

    }


    .offboarding-table-card:hover {
        box-shadow: var(--ob-shadow-hover) !important;
    }


    /* =========================================================
           TABLE CARD HEADER
           ========================================================= */

    .offboarding-card-header {
        padding: 18px 22px;
        min-height: 80px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        border-bottom: 1px solid #edf0f4;
        background: linear-gradient( 180deg, #ffffff, #fbfcfe );
    }


        .offboarding-card-header h5 {
            color: var(--ob-text);
        }


    .offboarding-subtitle {
        color: #8a94a6;
        font-size: 0.78rem;
    }


    .offboarding-record-count {
        white-space: nowrap;
        padding: 6px 11px;
        border-radius: 999px;
        background: #f3f7fc;
        border: 1px solid #e4ebf3;
        color: #64748b;
        font-size: 0.72rem;
        font-weight: 600;
    }


        .offboarding-record-count i {
            color: var(--ob-primary);
        }


    /* =========================================================
           TABLE
           ========================================================= */

    .offboarding-table {
        font-size: 0.82rem;
        min-width: 1150px;
    }


        .offboarding-table thead th {
            padding: 13px 16px;
            background: #f8fafc;
            color: #667085;
            border-bottom: 1px solid #e7ebf0;

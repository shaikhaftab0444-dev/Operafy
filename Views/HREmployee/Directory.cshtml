@model IEnumerable<ERP_System.Models.User>

@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Employee Directory";

    var roles = ViewBag.Roles as IEnumerable<ERP_System.Models.Role>
                 ?? new List<ERP_System.Models.Role>();

    var employees = Model?.ToList()
                     ?? new List<ERP_System.Models.User>();

    var totalEmployees = employees.Count;
    var activeEmployees = employees.Count(e => e.IsActive);
    var inactiveEmployees = employees.Count(e => !e.IsActive);
    var assignedEmployees = employees.Count(e => e.Role != null);

    var activePercentage = totalEmployees > 0
        ? Math.Round((decimal)activeEmployees / totalEmployees * 100, 0)
        : 0;
}

<style>

    /* =========================================================
       EMPLOYEE DIRECTORY - PREMIUM UI
       ========================================================= */

    .employee-directory-page {
        animation: directoryPageIn .65s ease both;
    }

    @@keyframes directoryPageIn {
        from {
            opacity: 0;
            transform: translateY(16px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* =========================================================
       PAGE HEADER
       ========================================================= */

    .directory-header {
        margin-bottom: 24px;
    }

    .directory-title-wrapper {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .directory-title-icon {
        width: 46px;
        height: 46px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 14px;
        color: #fff;
        background: linear-gradient(135deg, #2563eb, #4f46e5);
        box-shadow: 0 10px 25px rgba(37, 99, 235, .22);
        flex-shrink: 0;
    }

    .directory-title {
        margin: 0;
        font-size: 1.55rem;
        font-weight: 800;
        letter-spacing: -.5px;
        color: #172033;
    }

    .directory-subtitle {
        margin: 3px 0 0;
        font-size: .78rem;
        color: #64748b;
    }

    .directory-breadcrumb {
        margin-top: 9px;
    }

    .directory-breadcrumb .breadcrumb {
        margin-bottom: 0;
    }

    .directory-breadcrumb .breadcrumb-item {
        font-size: .75rem;
    }

    .directory-breadcrumb a {
        color: #2563eb;
        font-weight: 600;
    }

    /* =========================================================
       ADD BUTTON
       ========================================================= */

    .add-employee-btn {
        border: 0;
        border-radius: 12px;
        padding: 10px 17px;
        font-size: .78rem;
        font-weight: 700;
        background: linear-gradient(135deg, #2563eb, #4f46e5);
        box-shadow: 0 8px 20px rgba(37, 99, 235, .20);
        transition: all .25s ease;
    }

    .add-employee-btn:hover {
        transform: translateY(-3px);
        box-shadow: 0 12px 26px rgba(37, 99, 235, .28);
    }

    /* =========================================================
       STAT CARDS
       ========================================================= */

    .employee-stat-card {
        position: relative;
        overflow: hidden;
        border: 1px solid #e8edf3;
        border-radius: 17px;
        background: #fff;
        padding: 18px;
        box-shadow: 0 8px 25px rgba(15, 23, 42, .055);
        transition: all .3s ease;
        animation: statCardIn .55s ease both;
    }

    .employee-stat-card:nth-child(1) {
        animation-delay: .05s;
    }

    .employee-stat-card:nth-child(2) {
        animation-delay: .1s;
    }

    .employee-stat-card:nth-child(3) {
        animation-delay: .15s;
    }

    .employee-stat-card:nth-child(4) {
        animation-delay: .2s;
    }

    @@keyframes statCardIn {
        from {
            opacity: 0;
            transform: translateY(15px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .employee-stat-card::after {
        content: "";
        position: absolute;
        width: 85px;
        height: 85px;
        border-radius: 50%;
        right: -30px;
        top: -35px;
        background: rgba(37, 99, 235, .045);
    }

    .employee-stat-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 15px 35px rgba(15, 23, 42, .09);
    }

    .stat-icon {
        width: 40px;
        height: 40px;
        border-radius: 12px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 12px;
        font-size: .9rem;
    }

    .stat-icon-blue {
        color: #2563eb;
        background: #eff6ff;
    }

    .stat-icon-green {
        color: #16a34a;
        background: #f0fdf4;
    }

    .stat-icon-red {
        color: #dc2626;
        background: #fef2f2;
    }

    .stat-icon-purple {
        color: #7c3aed;
        background: #f5f3ff;
    }

    .stat-number {
        display: block;
        color: #172033;
        font-size: 1.45rem;
        font-weight: 800;
        line-height: 1.1;
    }

    .stat-label {
        display: block;
        color: #64748b;
        font-size: .7rem;
        font-weight: 600;
        margin-top: 4px;
    }

    .stat-meta {
        display: block;
        color: #94a3b8;
        font-size: .63rem;
        margin-top: 6px;
    }

    /* =========================================================
       FILTER CARD
       ========================================================= */

    .directory-filter-card {
        border: 1px solid #e8edf3;
        border-radius: 18px;
        background: #fff;
        padding: 15px;
        box-shadow: 0 8px 25px rgba(15, 23, 42, .045);
    }

    .filter-label {
        display: block;
        margin-bottom: 6px;
        color: #64748b;
        font-size: .67rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: .5px;
    }

    .search-wrapper {
        position: relative;
    }

    .search-wrapper i {
        position: absolute;
        left: 14px;
        top: 50%;
        transform: translateY(-50%);
        color: #94a3b8;
        font-size: .78rem;
        pointer-events: none;
        transition: color .2s ease;
    }

    .search-wrapper:focus-within i {
        color: #2563eb;
    }

    .directory-filter-card .form-control,
    .directory-filter-card .form-select {
        height: 42px;
        border-radius: 11px;
        border: 1px solid #e2e8f0;
        background: #f8fafc;
        font-size: .76rem;
        padding-left: 39px;
        transition: all .2s ease;
    }

    .directory-filter-card .form-select {
        padding-left: 12px;
    }

    .directory-filter-card .form-control:focus,
    .directory-filter-card .form-select:focus {
        background: #fff;
        border-color: #93c5fd;
        box-shadow: 0 0 0 4px rgba(59, 130, 246, .08);
    }

    .filter-reset-btn {
        height: 42px;
        border-radius: 11px;
        font-size: .72rem;
        font-weight: 700;
        border: 1px solid #e2e8f0;
        background: #fff;
        color: #64748b;
        transition: all .2s ease;
    }

    .filter-reset-btn:hover {
        color: #2563eb;
        border-color: #bfdbfe;
        background: #eff6ff;
    }

    /* =========================================================
       DIRECTORY CARD
       ========================================================= */

    .directory-card {
        border: 1px solid #e8edf3;
        border-radius: 20px;
        background: #fff;
        overflow: hidden;
        box-shadow: 0 10px 30px rgba(15, 23, 42, .055);
    }

    .directory-card-header {
        padding: 18px 20px;
        border-bottom: 1px solid #edf1f5;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 15px;
    }

    .directory-card-title {
        margin: 0;
        font-size: .92rem;
        font-weight: 800;
        color: #172033;
    }

    .directory-card-description {
        margin: 3px 0 0;
        color: #94a3b8;
        font-size: .68rem;
    }

    .employee-count-badge {
        padding: 7px 11px;
        border-radius: 9px;
        color: #2563eb;
        background: #eff6ff;
        font-size: .67rem;
        font-weight: 800;
    }

    /* =========================================================
       TABLE
       ========================================================= */

    .directory-table-wrapper {
        overflow-x: auto;
    }

    .directory-table {
        min-width: 1000px;
        margin: 0;
        border-collapse: separate;
        border-spacing: 0;
    }

    .directory-table thead th {
        padding: 12px 18px;
        background: #f8fafc;
        border-bottom: 1px solid #e8edf3;
        color: #64748b;
        font-size: .64rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: .55px;
        white-space: nowrap;
    }

    .directory-table tbody td {
        padding: 13px 18px;
        border-bottom: 1px solid #f0f3f7;
        color: #475569;
        font-size: .73rem;
        vertical-align: middle;
        white-space: nowrap;
    }

    .directory-table tbody tr {
        transition: all .2s ease;
        animation: rowAppear .45s ease both;
    }

    .directory-table tbody tr:hover {
        background: #f8fbff;
    }

    .directory-table tbody tr:last-child td {
        border-bottom: 0;
    }

    @@keyframes rowAppear {
        from {
            opacity: 0;
            transform: translateY(7px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* =========================================================
       EMPLOYEE PROFILE CELL
       ========================================================= */

    .employee-profile {
        display: flex;
        align-items: center;
        min-width: 210px;
    }

    .employee-avatar {
        width: 39px;
        height: 39px;
        min-width: 39px;
        border-radius: 12px;
        object-fit: cover;
        margin-right: 11px;
        border: 2px solid #fff;
        box-shadow: 0 4px 12px rgba(15, 23, 42, .10);
    }

    .employee-avatar-fallback {
        width: 39px;
        height: 39px;
        min-width: 39px;
        border-radius: 12px;
        margin-right: 11px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        color: #fff;
        background: linear-gradient(135deg, #2563eb, #6366f1);
        font-size: .7rem;
        font-weight: 800;
        box-shadow: 0 5px 14px rgba(37, 99, 235, .18);
    }

    .employee-name {
        color: #172033;
        font-size: .75rem;
        font-weight: 800;
        max-width: 180px;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .employee-username {
        margin-top: 2px;
        color: #94a3b8;
        font-size: .61rem;
    }

    .employee-code {
        display: inline-flex;
        padding: 5px 8px;
        border-radius: 7px;
        color: #475569;
        background: #f1f5f9;
        font-family: monospace;
        font-size: .65rem;
        font-weight: 700;
    }

    .role-badge {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 6px 9px;
        border-radius: 8px;
        color: #4f46e5;
        background: #eef2ff;
        font-size: .63rem;
        font-weight: 700;
    }

    .employee-email {
        color: #475569;
        font-size: .69rem;
    }

    .employee-mobile {
        color: #64748b;
        font-size: .69rem;
    }

    .joining-date {
        color: #64748b;
        font-size: .68rem;
    }

    /* =========================================================
       STATUS
       ========================================================= */

    .status-badge {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 6px 9px;
        border-radius: 8px;
        font-size: .63rem;
        font-weight: 800;
    }

    .status-active {
        color: #15803d;
        background: #f0fdf4;
        border: 1px solid #bbf7d0;
    }

    .status-inactive {
        color: #dc2626;
        background: #fef2f2;
        border: 1px solid #fecaca;
    }

    .status-dot {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: currentColor;
    }

    .status-active .status-dot {
        animation: activePulse 1.8s infinite;
    }

    @@keyframes activePulse {
        0%, 100% {
            opacity: 1;
            transform: scale(1);
        }

        50% {
            opacity: .45;
            transform: scale(.75);
        }
    }

    /* =========================================================
       ACTION BUTTONS
       ========================================================= */

    .employee-action-btn {
        width: 33px;
        height: 33px;
        padding: 0;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 9px;
        border: 1px solid #e2e8f0;
        background: #fff;
        color: #64748b;
        transition: all .2s ease;
    }

    .employee-action-btn:hover {
        transform: translateY(-2px);
    }

    .employee-view-btn:hover {
        color: #2563eb;
        border-color: #bfdbfe;
        background: #eff6ff;
    }

    .employee-edit-btn:hover {
        color: #7c3aed;
        border-color: #ddd6fe;
        background: #f5f3ff;
    }

    /* =========================================================
       EMPTY STATE
       ========================================================= */

    .empty-directory {
        padding: 55px 20px;
        text-align: center;
    }

    .empty-icon {
        width: 65px;
        height: 65px;
        margin: 0 auto 15px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 18px;
        background: #f8fafc;
        color: #94a3b8;
        font-size: 1.35rem;
    }

    .empty-title {
        margin-bottom: 4px;
        color: #334155;
        font-size: .9rem;
        font-weight: 800;
    }

    .empty-text {
        margin: 0;
        color: #94a3b8;
        font-size: .7rem;
    }

    /* =========================================================
       MODALS
       ========================================================= */

    .premium-modal .modal-content {
        border: 0;
        border-radius: 20px;
        overflow: hidden;
        box-shadow: 0 25px 70px rgba(15, 23, 42, .20);
    }

    .premium-modal .modal-header {
        padding: 18px 20px;
        border-bottom: 1px solid #edf1f5;
        background: #fff;
    }

    .premium-modal .modal-title {
        color: #172033;
        font-size: .95rem;
        font-weight: 800;
    }

    .modal-title-icon {
        width: 34px;
        height: 34px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 9px;
        color: #2563eb;
        background: #eff6ff;
        margin-right: 8px;
    }

    .premium-modal .modal-body {
        padding: 22px;
    }

    .premium-modal .modal-footer {
        padding: 14px 20px;
        background: #f8fafc;
        border-top: 1px solid #edf1f5;
    }

    .premium-modal .form-label {
        margin-bottom: 6px;
        color: #475569;
        font-size: .68rem;
        font-weight: 800;
    }

    .premium-modal .form-control,
    .premium-modal .form-select {
        min-height: 42px;
        border-radius: 10px;
        border-color: #e2e8f0;
        background: #f8fafc;
        font-size: .74rem;
    }

    .premium-modal .form-control:focus,
    .premium-modal .form-select:focus {
        background: #fff;
        border-color: #93c5fd;
        box-shadow: 0 0 0 4px rgba(59, 130, 246, .08);
    }

    .modal-save-btn {
        border: 0;
        border-radius: 10px;
        padding: 9px 16px;
        background: linear-gradient(135deg, #2563eb, #4f46e5);
        font-size: .72rem;
        font-weight: 700;
    }

    /* =========================================================
       PROFILE MODAL
       ========================================================= */

    .profile-modal-header {
        padding: 28px 20px 20px;
        text-align: center;
        background:
            radial-gradient(circle at 50% -20%, rgba(37, 99, 235, .14), transparent 45%),
            #fff;
    }

    .profile-photo-wrapper {
        position: relative;
        width: 88px;
        height: 88px;
        margin: 0 auto 13px;
    }

    .profile-photo,
    .profile-avatar {
        width: 88px;
        height: 88px;
        border-radius: 24px;
        object-fit: cover;
        box-shadow: 0 10px 25px rgba(15, 23, 42, .14);
        border: 3px solid #fff;
    }

    .profile-avatar {
        display: flex;
        align-items: center;
        justify-content: center;
        color: #fff;
        background: linear-gradient(135deg, #2563eb, #6366f1);
        font-size: 1.55rem;
        font-weight: 800;
    }

    .profile-name {
        color: #172033;
        font-size: 1.05rem;
        font-weight: 800;
        margin-bottom: 5px;
    }

    .profile-role {
        display: inline-flex;
        padding: 6px 10px;
        border-radius: 8px;
        color: #4f46e5;
        background: #eef2ff;
        font-size: .65rem;
        font-weight: 700;
    }

    .profile-details {
        padding: 0 20px 20px;
    }

    .profile-detail-item {
        display: flex;
        align-items: center;
        gap: 11px;
        padding: 11px 0;
        border-bottom: 1px solid #f0f3f7;
    }

    .profile-detail-item:last-child {
        border-bottom: 0;
    }

    .profile-detail-icon {
        width: 32px;
        height: 32px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 9px;
        color: #2563eb;
        background: #eff6ff;
        font-size: .68rem;
        flex-shrink: 0;
    }

    .profile-detail-label {
        color: #94a3b8;
        font-size: .61rem;
        font-weight: 700;
        display: block;
    }

    .profile-detail-value {
        color: #334155;
        font-size: .7rem;
        font-weight: 700;
        display: block;
        margin-top: 2px;
        word-break: break-word;
    }

    /* =========================================================
       NO SEARCH RESULT
       ========================================================= */

    .no-search-result {
        display: none;
        padding: 45px 20px;
        text-align: center;
    }

    .no-search-result.show {
        display: block;
        animation: directoryPageIn .35s ease both;
    }

    .no-search-icon {
        width: 55px;
        height: 55px;
        margin: 0 auto 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 15px;
        color: #64748b;
        background: #f1f5f9;
    }

    /* =========================================================
       RESPONSIVE
       ========================================================= */

    @@media (max-width: 768px) {

        .directory-title {
            font-size: 1.3rem;
        }

        .directory-title-icon {
            width: 40px;
            height: 40px;
        }

        .directory-header {
            align-items: flex-start !important;
        }

        .add-employee-btn {
            padding: 9px 12px;
        }

        .directory-card-header {
            align-items: flex-start;
            flex-direction: column;
        }

    }

    @@media (max-width: 576px) {

        .directory-title-wrapper {
            gap: 9px;
        }

        .directory-subtitle {
            font-size: .68rem;
        }

        .stat-number {
            font-size: 1.25rem;
        }

        .directory-filter-card {
            padding: 12px;
        }

    }

</style>


<div class="container-fluid py-4 text-start employee-directory-page">

    <!-- =====================================================
         PAGE HEADER
         ===================================================== -->

    <div class="directory-header d-flex justify-content-between align-items-center">

        <div>

            <div class="directory-title-wrapper">

                <div class="directory-title-icon">
                    <i class="fa-solid fa-users"></i>
                </div>

                <div>

                    <h4 class="directory-title">
                        Employee Directory
                    </h4>

                    <p class="directory-subtitle">
                        Manage your organization's employees and workforce
                    </p>

                </div>

            </div>

            <div class="directory-breadcrumb">

                <nav aria-label="breadcrumb">

                    <ol class="breadcrumb">

                        <li class="breadcrumb-item">
                            <a href="/HR" class="text-decoration-none">
                                HR Dashboard
                            </a>
                        </li>

                        <li class="breadcrumb-item active"
                            aria-current="page">

                            Employee Directory

                        </li>

                    </ol>

                </nav>

            </div>

        </div>


        <button type="button"
                class="btn btn-primary add-employee-btn"
                data-bs-toggle="modal"
                data-bs-target="#addEmployeeModal">

            <i class="fa-solid fa-user-plus me-2"></i>

            Add Employee

        </button>

    </div>


    <!-- =====================================================
         STATISTICS
         ===================================================== -->

    <div class="row g-3 mb-4">

        <div class="col-6 col-xl-3">

            <div class="employee-stat-card h-100">

                <div class="stat-icon stat-icon-blue">
                    <i class="fa-solid fa-users"></i>
                </div>

                <span class="stat-number">
                    @totalEmployees
                </span>

                <span class="stat-label">
                    Total Employees
                </span>

                <span class="stat-meta">
                    Complete workforce
                </span>

            </div>

        </div>


        <div class="col-6 col-xl-3">

            <div class="employee-stat-card h-100">

                <div class="stat-icon stat-icon-green">
                    <i class="fa-solid fa-user-check"></i>
                </div>

                <span class="stat-number">
                    @activeEmployees
                </span>

                <span class="stat-label">
                    Active Employees
                </span>

                <span class="stat-meta">
                    @activePercentage% of workforce
                </span>

            </div>

        </div>


        <div class="col-6 col-xl-3">

            <div class="employee-stat-card h-100">

                <div class="stat-icon stat-icon-red">
                    <i class="fa-solid fa-user-slash"></i>
                </div>

                <span class="stat-number">
                    @inactiveEmployees
                </span>

                <span class="stat-label">
                    Inactive Employees
                </span>

                <span class="stat-meta">
                    Currently inactive
                </span>

            </div>

        </div>


        <div class="col-6 col-xl-3">

            <div class="employee-stat-card h-100">

                <div class="stat-icon stat-icon-purple">
                    <i class="fa-solid fa-id-badge"></i>
                </div>

                <span class="stat-number">
                    @assignedEmployees
                </span>

                <span class="stat-label">
                    Role Assigned
                </span>

                <span class="stat-meta">
                    Across @roles.Count() roles
                </span>

            </div>

        </div>

    </div>


    <!-- =====================================================
         SEARCH & FILTER
         ===================================================== -->

    <div class="directory-filter-card mb-4">

        <div class="row g-3 align-items-end">

            <div class="col-lg-6">

                <label class="filter-label">
                    Search Employees
                </label>

                <div class="search-wrapper">

                    <i class="fa-solid fa-magnifying-glass"></i>

                    <input type="text"
                           id="searchInput"
                           class="form-control"
                           autocomplete="off"
                           placeholder="Search by name, email, employee code or mobile..." />

                </div>

            </div>
            <div class="col-md-5 col-lg-3">

                <label class="filter-label">
                    Role / Designation
                </label>

                <select id="roleSelect"
                        class="form-select">

                    <option value="">
                        All Roles
                    </option>

                    @foreach (var role in roles)
                    {
                        <option value="@role.RoleId">
                            @role.RoleName
                        </option>
                    }

                </select>

            </div>


            <div class="col-md-5 col-lg-2">

                <label class="filter-label">
                    Employee Status
                </label>

                <select id="statusSelect"
                        class="form-select">

                    <option value="">
                        All Status
                    </option>

                    <option value="active">
                        Active
                    </option>

                    <option value="inactive">
                        Inactive
                    </option>

                </select>

            </div>


            <div class="col-md-2 col-lg-1">

                <button type="button"
                        id="resetFilters"
                        class="btn filter-reset-btn w-100"
                        title="Reset Filters">

                    <i class="fa-solid fa-rotate-left"></i>

                </button>

            </div>

        </div>

    </div>


    <!-- =====================================================
         EMPLOYEE DIRECTORY
         ===================================================== -->

    <div class="directory-card">

        <div class="directory-card-header">

            <div>

                <h5 class="directory-card-title">
                    Employee Directory
                </h5>

                <p class="directory-card-description">
                    View, manage and update employee information
                </p>

            </div>

            <span class="employee-count-badge">

                <i class="fa-solid fa-users me-1"></i>

                <span id="visibleEmployeeCount">
                    @totalEmployees
                </span>

                Employees

            </span>

        </div>


        <div class="directory-table-wrapper">

            @if (employees.Any())
            {
                <table class="table directory-table align-middle">

                    <thead>

                        <tr>

                            <th>
                                Employee
                            </th>

                            <th>
                                Code
                            </th>

                            <th>
                                Role
                            </th>

                            <th>
                                Email
                            </th>

                            <th>
                                Mobile
                            </th>

                            <th>
                                Joining Date
                            </th>

                            <th>
                                Status
                            </th>

                            <th class="text-end">
                                Actions
                            </th>

                        </tr>

                    </thead>


                    <tbody id="employeeTableBody">

                        @foreach (var emp in employees)
                        {
                            var initials =
                            !string.IsNullOrWhiteSpace(emp.FullName)
                            ? string.Join("",
                            emp.FullName
                            .Split(' ', StringSplitOptions.RemoveEmptyEntries)
                            .Take(2)
                            .Select(x => x[0]))
                            .ToUpper()
                            : "EM";

                            <tr class="employee-row"
                                data-role-id="@emp.RoleId"
                                data-status="@(emp.IsActive ? "active" : "inactive")">

                                <!-- EMPLOYEE -->

                                <td>

                                    <div class="employee-profile">

                                        @if (!string.IsNullOrWhiteSpace(emp.ProfilePhoto))
                                        {
                                            <img src="@emp.ProfilePhoto"
                                                 alt="@emp.FullName"
                                                 class="employee-avatar" />
                                        }
                                        else
                                        {
                                            <div class="employee-avatar-fallback">
                                                @initials
                                            </div>
                                        }

                                    <div>

                                        <div class="employee-name emp-name">
                                            @emp.FullName
                                        </div>

                                        <div class="employee-username">
                                            @@@emp.UserName
                                        </div>

                                    </div>

                                </div>

                            </td>


                            <!-- CODE -->

                            <td>

                                <span class="employee-code emp-code">
                                    @emp.UserCode
                                </span>

                            </td>


                            <!-- ROLE -->

                            <td>

                                <span class="role-badge">

                                    <i class="fa-solid fa-briefcase"></i>

                                    @(emp.Role != null
                                                                    ? emp.Role.RoleName
                                                                    : "Unassigned")

                                </span>

                            </td>


                            <!-- EMAIL -->

                            <td>

                                <span class="employee-email emp-email">

                                    @emp.Email

                                </span>

                            </td>


                            <!-- MOBILE -->

                            <td>

                                <span class="employee-mobile emp-mobile">

                                    @(string.IsNullOrWhiteSpace(emp.MobileNumber)
                                                                    ? "N/A"
                                                                    : emp.MobileNumber)

                            </span>

                                </td>


                                <!-- JOIN DATE -->

                                <td>

                                    <span class="joining-date">

                                        @emp.CreatedAt.ToString("dd MMM yyyy")

                                    </span>

                                </td>


                                <!-- STATUS -->

                                <td>

                            @if (emp.IsActive)
                                    {
                                        <span class="status-badge status-active">

                                            <span class="status-dot"></span>

                                            Active

                                        </span>
                                    }
                                    else
                                    {
                                        <span class="status-badge status-inactive">

                                            <span class="status-dot"></span>

                                            Inactive

                                        </span>
                                    }

                                </td>


                                <!-- ACTIONS -->

                                <td class="text-end">

                                    <div class="d-flex justify-content-end gap-1">

                                        <!-- VIEW -->

                                        <button type="button"
                                                class="employee-action-btn employee-view-btn view-btn"
                                                title="View Profile"
                                                data-code="@emp.UserCode"
                                                data-name="@emp.FullName"
                                                data-email="@emp.Email"
                                                data-mobile="@emp.MobileNumber"
                                                data-role="@(emp.Role != null ? emp.Role.RoleName : "Unassigned")"
                                                data-date="@emp.CreatedAt.ToString("dd MMM yyyy")"
                                                data-photo="@emp.ProfilePhoto"
                                                data-bs-toggle="modal"
                                                data-bs-target="#viewProfileModal">

                                            <i class="fa-regular fa-eye"></i>

                                        </button>


                                        <!-- EDIT -->

                                        <button type="button"
                                                class="employee-action-btn employee-edit-btn edit-btn"
                                                title="Edit Employee"
                                                data-id="@emp.UserId"
                                                data-name="@emp.FullName"
                                                data-user="@emp.UserName"
                                                data-email="@emp.Email"
                                                data-mobile="@emp.MobileNumber"
                                                data-role="@emp.RoleId"
                                                data-active="@emp.IsActive.ToString().ToLower()"
                                                data-bs-toggle="modal"
                                                data-bs-target="#editEmployeeModal">

                                            <i class="fa-solid fa-pen"></i>

                                        </button>

                                    </div>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>


                <!-- NO SEARCH RESULT -->

                <div id="noSearchResult"
                     class="no-search-result">

                    <div class="no-search-icon">

                        <i class="fa-solid fa-magnifying-glass"></i>

                    </div>

                    <div class="empty-title">
                        No employees found
                    </div>

                    <p class="empty-text">
                        Try changing your search or filter criteria.
                    </p>

                </div>
            }
            else
            {
                <div class="empty-directory">

                    <div class="empty-icon">

                        <i class="fa-solid fa-users-slash"></i>

                    </div>

                    <div class="empty-title">
                        No employees found
                    </div>

                    <p class="empty-text">
                        There are currently no employees in the directory.
                    </p>

                </div>
            }

        </div>

    </div>

</div>



<script>

    document.addEventListener("DOMContentLoaded", function () {

        /* =====================================================
           ELEMENTS
           ===================================================== */

        const searchInput =
            document.getElementById("searchInput");

        const roleSelect =
            document.getElementById("roleSelect");

        const statusSelect =
            document.getElementById("statusSelect");

        const resetFilters =
            document.getElementById("resetFilters");

        const employeeRows =
            Array.from(document.querySelectorAll(".employee-row"));

        const visibleEmployeeCount =
            document.getElementById("visibleEmployeeCount");

        const noSearchResult =
            document.getElementById("noSearchResult");


        /* =====================================================
           FILTERING
           ===================================================== */

        function filterEmployees() {

            const searchValue =
                (searchInput?.value || "")
                    .trim()
                    .toLowerCase();

            const roleValue =
                roleSelect?.value || "";

            const statusValue =
                statusSelect?.value || "";

            let visibleCount = 0;


            employeeRows.forEach(function (row) {

                const name =
                    row.querySelector(".emp-name")
                        ?.textContent
                        .toLowerCase() || "";

                const code =
                    row.querySelector(".emp-code")
                        ?.textContent
                        .toLowerCase() || "";

                const email =
                    row.querySelector(".emp-email")
                        ?.textContent
                        .toLowerCase() || "";

                const mobile =
                    row.querySelector(".emp-mobile")
                        ?.textContent
                        .toLowerCase() || "";

                const roleId =
                    row.getAttribute("data-role-id") || "";

                const status =
                    row.getAttribute("data-status") || "";


                const matchesSearch =
                    !searchValue ||
                    name.includes(searchValue) ||
                    code.includes(searchValue) ||
                    email.includes(searchValue) ||
                    mobile.includes(searchValue);


                const matchesRole =
                    !roleValue ||
                    roleId === roleValue;


                const matchesStatus =
                    !statusValue ||
                    status === statusValue;


                const shouldShow =
                    matchesSearch &&
                    matchesRole &&
                    matchesStatus;


                if (shouldShow) {

                    row.style.display = "";

                    visibleCount++;

                }
                else {

                    row.style.display = "none";

                }

            });


            if (visibleEmployeeCount) {

                visibleEmployeeCount.textContent =
                    visibleCount;

            }


            if (noSearchResult) {

                if (visibleCount === 0 && employeeRows.length > 0) {

                    noSearchResult.classList.add("show");

                }
                else {

                    noSearchResult.classList.remove("show");

                }

            }

        }


        /* =====================================================
           SEARCH EVENTS
           ===================================================== */

        if (searchInput) {

            searchInput.addEventListener(
                "input",
                filterEmployees
            );

        }


        if (roleSelect) {

            roleSelect.addEventListener(
                "change",
                filterEmployees
            );

        }


        if (statusSelect) {

            statusSelect.addEventListener(
                "change",
                filterEmployees
            );

        }


        /* =====================================================
           RESET
           ===================================================== */

        if (resetFilters) {

            resetFilters.addEventListener(
                "click",
                function () {

                    if (searchInput) {
                        searchInput.value = "";
                    }

                    if (roleSelect) {
                        roleSelect.value = "";
                    }

                    if (statusSelect) {
                        statusSelect.value = "";
                    }

                    filterEmployees();

                    if (searchInput) {
                        searchInput.focus();
                    }

                }
            );

        }


        /* =====================================================
           EDIT EMPLOYEE
           ===================================================== */

        document
            .querySelectorAll(".edit-btn")
            .forEach(function (button) {

                button.addEventListener(
                    "click",
                    function () {

                        const id =
                            this.getAttribute("data-id");

                        const name =
                            this.getAttribute("data-name") || "";

                        const username =
                            this.getAttribute("data-user") || "";

                        const email =
                            this.getAttribute("data-email") || "";

                        const mobile =
                            this.getAttribute("data-mobile") || "";

                        const role =
                            this.getAttribute("data-role") || "";

                        const active =
                            this.getAttribute("data-active") === "true";


                        document.getElementById("editUserId").value =
                            id;

                        document.getElementById("editFullName").value =
                            name;

                        document.getElementById("editUserName").value =
                            username;

                        document.getElementById("editEmail").value =
                            email;

                        document.getElementById("editMobileNumber").value =
                            mobile;

                        document.getElementById("editRoleId").value =
                            role;


                        document.getElementById("statusUserId").value =
                            id;

                        document.getElementById("deleteUserId").value =
                            id;


                        const statusButton =
                            document.getElementById("statusToggleBtn");


                        if (active) {

                            statusButton.className =
                                "btn btn-warning rounded-3 btn-sm px-3";

                            statusButton.innerHTML =
                                '<i class="fa-solid fa-user-slash me-1"></i> Deactivate';

                        }
                        else {

                            statusButton.className =
                                "btn btn-success rounded-3 btn-sm px-3";

                            statusButton.innerHTML =
                                '<i class="fa-solid fa-user-check me-1"></i> Activate';

                        }

                    }
                );

            });


        /* =====================================================
           STATUS TOGGLE
           ===================================================== */

        const statusToggleBtn =
            document.getElementById("statusToggleBtn");

        if (statusToggleBtn) {

            statusToggleBtn.addEventListener(
                "click",
                function () {

                    const employeeId =
                        document.getElementById("statusUserId").value;

                    if (!employeeId) {
                        return;
                    }


                    const isActivate =
                        this.classList.contains("btn-success");


                    const message =
                        isActivate
                            ? "Are you sure you want to activate this employee?"
                            : "Are you sure you want to deactivate this employee?";


                    if (typeof Swal !== "undefined") {

                        Swal.fire({

                            title: isActivate
                                ? "Activate Employee?"
                                : "Deactivate Employee?",

                            text: message,

                            icon: "warning",

                            showCancelButton: true,

                            confirmButtonText: isActivate
                                ? "Yes, Activate"
                                : "Yes, Deactivate",

                            cancelButtonText: "Cancel",

                            reverseButtons: true

                        }).then(function (result) {

                            if (result.isConfirmed) {

                                document
                                    .getElementById("statusToggleForm")
                                    .submit();

                            }

                        });

                    }
                    else {

                        if (confirm(message)) {

                            document
                                .getElementById("statusToggleForm")
                                .submit();

                        }

                    }

                }
            );

        }


        /* =====================================================
           DELETE EMPLOYEE
           ===================================================== */

        const deleteEmployeeBtn =
            document.getElementById("deleteEmployeeBtn");

        if (deleteEmployeeBtn) {

            deleteEmployeeBtn.addEventListener(
                "click",
                function () {

                    const employeeId =
                        document.getElementById("deleteUserId").value;

                    if (!employeeId) {
                        return;
                    }


                    function submitDelete() {

                        document
                            .getElementById("deleteForm")
                            .submit();

                    }


                    if (typeof Swal !== "undefined") {

                        Swal.fire({

                            title: "Delete Employee?",

                            text: "This action cannot be undone. Are you sure?",

                            icon: "warning",

                            showCancelButton: true,

                            confirmButtonColor: "#dc2626",

                            confirmButtonText: "Yes, Delete",

                            cancelButtonText: "Cancel",

                            reverseButtons: true

                        }).then(function (result) {

                            if (result.isConfirmed) {

                                submitDelete();

                            }

                        });

                    }
                    else {

                        if (confirm(
                            "Are you sure you want to delete this employee?"
                        )) {

                            submitDelete();

                        }

                    }

                }
            );

        }


        /* =====================================================
           VIEW PROFILE
           ===================================================== */

        document
            .querySelectorAll(".view-btn")
            .forEach(function (button) {

                button.addEventListener(
                    "click",
                    function () {

                        const code =
                            this.getAttribute("data-code") || "N/A";

                        const name =
                            this.getAttribute("data-name") || "Employee";

                        const email =
                            this.getAttribute("data-email") || "N/A";

                        const mobile =
                            this.getAttribute("data-mobile") || "N/A";

                        const role =
                            this.getAttribute("data-role") || "Unassigned";

                        const date =
                            this.getAttribute("data-date") || "N/A";

                        const photo =
                            (this.getAttribute("data-photo") || "").trim();


                        document.getElementById("viewCode").textContent =
                            code;

                        document.getElementById("viewName").textContent =
                            name;

                        document.getElementById("viewEmail").textContent =
                            email;

                        document.getElementById("viewMobile").textContent =
                            mobile;

                        document.getElementById("viewRole").textContent =
                            role;

                        document.getElementById("viewDate").textContent =
                            date;


                        const image =
                            document.getElementById("viewPhoto");

                        const avatar =
                            document.getElementById("viewAvatarCircle");


                        const initials =
                            name
                                .split(" ")
                                .filter(Boolean)
                                .slice(0, 2)
                                .map(function (word) {
                                    return word.charAt(0);
                                })
                                .join("")
                                .toUpperCase() || "EM";


                        if (photo) {

                            image.src = photo;

                            image.classList.remove("d-none");

                            avatar.classList.add("d-none");

                        }
                        else {

                            image.removeAttribute("src");

                            image.classList.add("d-none");

                            avatar.classList.remove("d-none");

                            avatar.textContent =
                                initials;

                        }

                    }
                );

            });


        /* =====================================================
           MODAL CLEANUP
           ===================================================== */

        const editModal =
            document.getElementById("editEmployeeModal");

        if (editModal) {

            editModal.addEventListener(
                "hidden.bs.modal",
                function () {

                    const form =
                        document.getElementById("editEmployeeForm");

                    if (form) {

                        const fileInput =
                            form.querySelector(
                                'input[type="file"]'
                            );

                        if (fileInput) {
                            fileInput.value = "";
                        }

                    }

                }
            );

        }


        /* =====================================================
           INITIAL FILTER
           ===================================================== */

        filterEmployees();

    });

</script>
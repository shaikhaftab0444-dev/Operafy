@model IEnumerable<ERP_System.Models.HRTransfer>

@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Transfers & Promotions";

    var transfers = Model?.ToList() ?? new List<ERP_System.Models.HRTransfer>();

    var totalTransactions = transfers.Count;
    var totalPromotions = transfers.Count(x => x.Type == "Promotion");
    var totalTransfers = transfers.Count(x => x.Type == "Transfer");
    var pendingTransactions = transfers.Count(x => x.ApprovalStatus == "Pending Approval");
}

<style>
    /* =========================================================
           TRANSFERS & PROMOTIONS - PREMIUM UI
           ========================================================= */

    .tp-page {
        animation: pageFadeIn .55s ease both;
    }

    @@keyframes pageFadeIn {
        from {
            opacity: 0;
            transform: translateY(12px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* Header */
    .tp-header {
        position: relative;
        overflow: hidden;
        border-radius: 18px;
        padding: 24px 26px;
        background: linear-gradient(135deg, #ffffff 0%, #f7faff 100%);
        border: 1px solid #e8edf5;
        box-shadow: 0 8px 30px rgba(15, 23, 42, .06);
    }

        .tp-header::before {
            content: "";
            position: absolute;
            width: 180px;
            height: 180px;
            right: -60px;
            top: -90px;
            border-radius: 50%;
            background: rgba(13, 110, 253, .07);
        }

    .tp-title-icon {
        width: 48px;
        height: 48px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 14px;
        background: linear-gradient(135deg, #0d6efd, #4f8dfd);
        color: white;
        font-size: 20px;
        box-shadow: 0 8px 20px rgba(13, 110, 253, .25);
        animation: iconFloat 3s ease-in-out infinite;
    }

    @@keyframes iconFloat {
        0%, 100% {
            transform: translateY(0);
        }

        50% {
            transform: translateY(-4px);
        }
    }

    .tp-title {
        font-size: 1.35rem;
        font-weight: 750;
        color: #172033;
        margin-bottom: 3px;
    }

    .tp-subtitle {
        color: #7b8495;
        font-size: .82rem;
    }

    .tp-action-btn {
        border: 0;
        padding: 10px 18px;
        font-weight: 600;
        background: linear-gradient(135deg, #0d6efd, #3d8bfd);
        box-shadow: 0 8px 20px rgba(13, 110, 253, .22);
        transition: all .25s ease;
    }

        .tp-action-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 12px 25px rgba(13, 110, 253, .30);
        }

    /* Statistic Cards */
    .tp-stat {
        position: relative;
        overflow: hidden;
        background: #fff;
        border: 1px solid #e9edf4;
        border-radius: 16px;
        padding: 18px;
        height: 100%;
        box-shadow: 0 6px 22px rgba(15, 23, 42, .045);
        transition: all .3s ease;
        animation: statSlide .6s ease both;
    }

        .tp-stat:hover {
            transform: translateY(-5px);
            box-shadow: 0 14px 30px rgba(15, 23, 42, .09);
        }

        .tp-stat::after {
            content: "";
            position: absolute;
            width: 90px;
            height: 90px;
            border-radius: 50%;
            right: -35px;
            bottom: -45px;
            background: rgba(13, 110, 253, .05);
        }

        .tp-stat:nth-child(1) {
            animation-delay: .05s;
        }

        .tp-stat:nth-child(2) {
            animation-delay: .1s;
        }

        .tp-stat:nth-child(3) {
            animation-delay: .15s;
        }

        .tp-stat:nth-child(4) {
            animation-delay: .2s;
        }

    @@keyframes statSlide {
        from {
            opacity: 0;
            transform: translateY(15px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .tp-stat-icon {
        width: 42px;
        height: 42px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 17px;
        margin-bottom: 12px;
    }

    .tp-icon-blue {
        background: #eaf2ff;
        color: #0d6efd;
    }

    .tp-icon-green {
        background: #eafaf0;
        color: #198754;
    }

    .tp-icon-purple {
        background: #f1ebff;
        color: #6f42c1;
    }

    .tp-icon-orange {
        background: #fff3df;
        color: #fd7e14;
    }

    .tp-stat-label {
        color: #7b8495;
        font-size: .75rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: .04em;
    }

    .tp-stat-value {
        font-size: 1.55rem;
        font-weight: 750;
        color: #172033;
        margin-top: 3px;
    }

    /* Main Card */
    .tp-card {
        background: #fff;
        border: 1px solid #e8edf4;
        border-radius: 18px;
        box-shadow: 0 8px 30px rgba(15, 23, 42, .055);
        overflow: hidden;
        animation: cardAppear .7s ease both;
    }

    @@keyframes cardAppear {
        from {
            opacity: 0;
            transform: translateY(18px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .tp-card-header {
        padding: 20px 22px;
        border-bottom: 1px solid #edf0f5;
    }

    .tp-section-title {
        font-size: .98rem;
        font-weight: 700;
        color: #172033;
    }

    .tp-section-subtitle {
        color: #8a93a3;
        font-size: .75rem;
        margin-top: 2px;
    }

    /* Filters */
    .tp-filter {
        border: 1px solid #e2e7ef;
        border-radius: 10px;
        min-height: 39px;
        font-size: .8rem;
        transition: all .2s ease;
    }

        .tp-filter:focus {
            border-color: #86b7fe;
            box-shadow: 0 0 0 .18rem rgba(13, 110, 253, .10);
        }

    .tp-search {
        position: relative;
    }

        .tp-search i {
            position: absolute;
            left: 13px;
            top: 50%;
            transform: translateY(-50%);
            color: #98a1b2;
            font-size: 13px;
            z-index: 2;
        }

        .tp-search input {
            padding-left: 36px;
        }

    /* Table */
    .tp-table {
        margin-bottom: 0;
    }

        .tp-table thead th {
            background: #f8fafc;
            color: #7c8798;
            font-size: .69rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: .045em;
            padding: 14px 18px;
            border-bottom: 1px solid #e9edf3;
            white-space: nowrap;
        }

        .tp-table tbody tr {
            transition: all .2s ease;
            animation: rowFade .5s ease both;
        }

            .tp-table tbody tr:hover {
                background: #f8fbff;
                transform: scale(1.002);
            }

        .tp-table tbody td {
            padding: 16px 18px;
            border-color: #f0f2f6;
            font-size: .82rem;
            vertical-align: middle;
        }

    @@keyframes rowFade {
        from {
            opacity: 0;
            transform: translateY(6px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .tp-employee {
        display: flex;
        align-items: center;
        gap: 11px;
    }

    .tp-avatar {
        width: 38px;
        height: 38px;
        border-radius: 11px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(135deg, #e9f2ff, #dceaff);
        color: #0d6efd;
        font-weight: 700;
        font-size: .8rem;
        flex-shrink: 0;
    }

    .tp-employee-name {
        color: #1c2536;
        font-weight: 650;
        font-size: .82rem;
    }

    .tp-employee-label {
        color: #99a1af;
        font-size: .68rem;
        margin-top: 2px;
    }

    /* Type badges */
    .tp-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        border-radius: 999px;
        padding: 6px 10px;
        font-size: .68rem;
        font-weight: 650;
        white-space: nowrap;
    }

    .tp-badge-promotion {
        background: #e9f8ef;
        color: #198754;
    }

    .tp-badge-transfer {
        background: #e8f2ff;
        color: #0d6efd;
    }

    .tp-badge-pending {
        background: #fff4dc;
        color: #b76e00;
    }

    .tp-badge-approved {
        background: #e8f8ef;
        color: #198754;
    }

    .tp-badge-rejected {
        background: #ffebee;
        color: #dc3545;
    }

    /* Movement */
    .tp-movement {
        display: flex;
        align-items: center;
        gap: 8px;
        min-width: 250px;
    }

    .tp-location {
        max-width: 125px;
    }

    .tp-location-label {
        color: #a0a7b4;
        font-size: .62rem;
        text-transform: uppercase;
        font-weight: 700;
    }

    .tp-location-value {
        color: #394255;
        font-size: .73rem;
        font-weight: 600;
        margin-top: 2px;
    }

    .tp-arrow {
        width: 28px;
        height: 28px;
        min-width: 28px;
        border-radius: 50%;
        background: #f1f5fa;
        color: #7d8797;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 11px;
    }

    .tp-date {
        color: #465063;
        font-weight: 600;
        white-space: nowrap;
    }

        .tp-date i {
            color: #8d98a9;
            margin-right: 6px;
        }

    /* Empty state */
    .tp-empty {
        padding: 65px 20px;
        text-align: center;
    }

    .tp-empty-icon {
        width: 72px;
        height: 72px;
        margin: 0 auto 15px;
        border-radius: 20px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #f1f5fa;
        color: #8c97a8;
        font-size: 27px;
    }

    .tp-empty h6 {
        font-weight: 700;
        color: #364052;
    }

    .tp-empty p {
        color: #929baa;
        font-size: .78rem;
    }

    /* Modal */
    .tp-modal .modal-content {
        border: 0;
        border-radius: 20px;
        overflow: hidden;
        box-shadow: 0 25px 70px rgba(15, 23, 42, .22);
    }

    .tp-modal-header {
        padding: 21px 23px;
        background: linear-gradient(135deg, #0d6efd, #438dfc);
        color: white;
    }

        .tp-modal-header h5 {
            font-weight: 700;
        }

        .tp-modal-header p {
            opacity: .8;
            font-size: .72rem;
            margin: 3px 0 0;
        }

        .tp-modal-header .btn-close {
            filter: brightness(0) invert(1);
            opacity: .85;
        }

    .tp-form-label {
        font-size: .73rem;
        font-weight: 650;
        color: #495366;
        margin-bottom: 6px;
    }

    .tp-form-control {
        border: 1px solid #dfe5ed;
        border-radius: 10px;
        min-height: 43px;
        font-size: .82rem;
        transition: all .2s ease;
    }

        .tp-form-control:focus {
            border-color: #0d6efd;
            box-shadow: 0 0 0 .2rem rgba(13, 110, 253, .09);
        }

    .tp-input-icon {
        position: relative;
    }

        .tp-input-icon i {
            position: absolute;
            left: 13px;
            top: 50%;
            transform: translateY(-50%);
            color: #99a3b2;
            font-size: 13px;
            z-index: 2;
        }

        .tp-input-icon .tp-form-control {
            padding-left: 37px;
        }

    .tp-modal-footer {
        background: #fafbfd;
        border-top: 1px solid #edf0f4;
        padding: 15px 22px;
    }

    /* Responsive */
    @@media (max-width: 768px) {
        .tp-header {
            padding: 18px;
        }

        .tp-action-btn {
            margin-top: 15px;
            width: 100%;
        }

        .tp-title {
            font-size: 1.15rem;
        }

        .tp-card-header {
            padding: 16px;
        }

        .tp-table thead th,
        .tp-table tbody td {
            padding: 12px;
        }

        .tp-filter {
            width: 100%;
        }
    }
</style>

<div class="container-fluid py-4 tp-page">

    <!-- =====================================================
         PAGE HEADER
         ===================================================== -->
    <div class="tp-header mb-4">

        <div class="row align-items-center">

            <div class="col-lg-8">

                <div class="d-flex align-items-center gap-3">

                    <div class="tp-title-icon">
                        <i class="fa-solid fa-arrows-spin"></i>
                    </div>

                    <div>
                        <div class="tp-title">
                            Transfers & Promotions
                        </div>

                        <div class="tp-subtitle">
                            Manage employee transfers, promotions and approval workflows
                        </div>

                        <nav aria-label="breadcrumb" class="mt-2">
                            <ol class="breadcrumb mb-0 small">
                                <li class="breadcrumb-item">
                                    <a href="/HR" class="text-decoration-none">
                                        HR Dashboard
                                    </a>
                                </li>

                                <li class="breadcrumb-item active">
                                    Transfers & Promotions
                                </li>
                            </ol>
                        </nav>
                    </div>

                </div>

            </div>

            <div class="col-lg-4 text-lg-end">

                <button type="button"
                        class="btn btn-primary rounded-pill tp-action-btn"
                        data-bs-toggle="modal"
                        data-bs-target="#logTransferModal">

                    <i class="fa-solid fa-plus me-2"></i>
                    Log Transaction

                </button>

            </div>

        </div>

    </div>


    <!-- =====================================================
         STATISTICS
         ===================================================== -->
    <div class="row g-3 mb-4">

        <!-- Total -->
        <div class="col-xl-3 col-md-6">

            <div class="tp-stat">

                <div class="tp-stat-icon tp-icon-blue">
                    <i class="fa-solid fa-arrows-left-right"></i>
                </div>

                <div class="tp-stat-label">
                    Total Transactions
                </div>

                <div class="tp-stat-value">
                    @totalTransactions
                </div>

            </div>

        </div>


        <!-- Promotions -->
        <div class="col-xl-3 col-md-6">

            <div class="tp-stat">

                <div class="tp-stat-icon tp-icon-green">
                    <i class="fa-solid fa-arrow-up-right-dots"></i>
                </div>

                <div class="tp-stat-label">
                    Promotions
                </div>

                <div class="tp-stat-value">
                    @totalPromotions
                </div>

            </div>

        </div>


        <!-- Transfers -->
        <div class="col-xl-3 col-md-6">

            <div class="tp-stat">

                <div class="tp-stat-icon tp-icon-purple">
                    <i class="fa-solid fa-right-left"></i>
                </div>

                <div class="tp-stat-label">
                    Transfers
                </div>

                <div class="tp-stat-value">
                    @totalTransfers
                </div>

            </div>

        </div>


        <!-- Pending -->
        <div class="col-xl-3 col-md-6">

            <div class="tp-stat">

                <div class="tp-stat-icon tp-icon-orange">
                    <i class="fa-solid fa-clock"></i>
                </div>

                <div class="tp-stat-label">
                    Pending Approval
                </div>

                <div class="tp-stat-value">
                    @pendingTransactions
                </div>

            </div>

        </div>

    </div>


    <!-- =====================================================
         MAIN TABLE CARD
         ===================================================== -->
    <div class="tp-card">

        <!-- Card Header -->
        <div class="tp-card-header">

            <div class="row align-items-center g-3">

                <div class="col-lg-4">

                    <div class="tp-section-title">
                        Employee Transactions
                    </div>

                    <div class="tp-section-subtitle">
                        View and manage employee movement history
                    </div>

                </div>


                <!-- Search -->
                <div class="col-lg-4">

                    <div class="tp-search">

                        <i class="fa-solid fa-magnifying-glass"></i>

                        <input type="text"
                               id="transferSearch"
                               class="form-control tp-filter"
                               placeholder="Search employee, department..." />

                    </div>

                </div>


                <!-- Filters -->
                <div class="col-lg-2">

                    <select id="typeFilter"
                            class="form-select tp-filter">

                        <option value="">All Types</option>
                        <option value="Promotion">Promotion</option>
                        <option value="Transfer">Transfer</option>

                    </select>

                </div>


                <div class="col-lg-2">

                    <select id="statusFilter"
                            class="form-select tp-filter">

                        <option value="">All Status</option>
                        <option value="Pending Approval">Pending</option>
                        <option value="Approved">Approved</option>
                        <option value="Rejected">Rejected</option>

                    </select>

                </div>

            </div>

        </div>


        <!-- Table -->
        <div class="table-responsive">

            <table class="table tp-table align-middle"
                   id="transferTable">

                <thead>

                    <tr>

                        <th>
                            Employee
                        </th>

                        <th>
                            Transaction
                        </th>

                        <th>
                            Movement
                        </th>

                        <th>
                            Effective Date
                        </th>

                        <th>
                            Approval
                        </th>

                    </tr>

                </thead>

                <tbody>

                    @if (transfers.Any())
                    {
                        var rowIndex = 0;

                        foreach (var t in transfers)
                        {
                            rowIndex++;

                            var type = t.Type ?? "";
                            var status = t.ApprovalStatus ?? "";

                            var typeClass =
                            type.Equals("Promotion", StringComparison.OrdinalIgnoreCase)
                            ? "tp-badge-promotion"
                            : "tp-badge-transfer";

                            var typeIcon =
                            type.Equals("Promotion", StringComparison.OrdinalIgnoreCase)
                            ? "fa-arrow-up"
                            : "fa-right-left";

                            var statusClass =
                            status.Equals("Approved", StringComparison.OrdinalIgnoreCase)
                            ? "tp-badge-approved"
                            : status.Equals("Rejected", StringComparison.OrdinalIgnoreCase)
                            ? "tp-badge-rejected"
                            : "tp-badge-pending";

                            var statusIcon =
                            status.Equals("Approved", StringComparison.OrdinalIgnoreCase)
                            ? "fa-circle-check"
                            : status.Equals("Rejected", StringComparison.OrdinalIgnoreCase)
                            ? "fa-circle-xmark"
                            : "fa-clock";

                            var employeeName = t.EmployeeName ?? "Unknown Employee";

                            var initials = string.Join(
                            "",
                            employeeName
                            .Split(' ', StringSplitOptions.RemoveEmptyEntries)
                            .Take(2)
                            .Select(x => x[0].ToString().ToUpper())
                            );

                            <tr class="transfer-row"
                                data-name="@employeeName"
                                data-type="@type"
                                data-status="@status"
                                style="animation-delay:@(rowIndex * 0.035)s">

                                <!-- Employee -->
                                <td>

                                    <div class="tp-employee">

                                        <div class="tp-avatar">
                                            @initials
                                        </div>

                                        <div>

                                            <div class="tp-employee-name">
                                                @employeeName
                                            </div>

                                            <div class="tp-employee-label">
                                                Employee Transaction
                                            </div>

                                        </div>

                                    </div>

                                </td>


                                <!-- Type -->
                                <td>

                                    <span class="tp-badge @typeClass">

                                        <i class="fa-solid @typeIcon"></i>

                                        @type

                                    </span>

                                </td>


                                <!-- Movement -->
                                <td>

                                    <div class="tp-movement">

                                        <div class="tp-location">

                                            <div class="tp-location-label">
                                                From
                                            </div>

                                            <div class="tp-location-value"
                                                 title="@t.FromDeptOrDesg">

                                                @t.FromDeptOrDesg

                                            </div>

                                        </div>


                                        <div class="tp-arrow">
                                            <i class="fa-solid fa-arrow-right"></i>
                                        </div>


                                        <div class="tp-location">

                                            <div class="tp-location-label">
                                                To
                                            </div>

                                            <div class="tp-location-value"
                                                 title="@t.ToDeptOrDesg">

                                                @t.ToDeptOrDesg

                                            </div>

                                        </div>

                                    </div>

                                </td>


                                <!-- Date -->
                                <td>

                                    <div class="tp-date">

                                        <i class="fa-regular fa-calendar"></i>

                                        @t.EffectiveDate.ToString("dd MMM yyyy")

                                    </div>

                                </td>


                                <!-- Status -->
                                <td>

                                    <span class="tp-badge @statusClass">

                                        <i class="fa-solid @statusIcon"></i>

                                        @status

                                    </span>

                                </td>

                            </tr>
                        }
                    }
                    else
                    {
                        <tr id="emptyDatabaseRow">

                            <td colspan="5">

                                <div class="tp-empty">

                                    <div class="tp-empty-icon">
                                        <i class="fa-solid fa-arrows-spin"></i>
                                    </div>

                                    <h6>
                                        No Transactions Found
                                    </h6>

                                    <p class="mb-3">
                                        There are currently no transfers or promotions recorded.
                                    </p>

                                    <button type="button"
                                            class="btn btn-primary btn-sm rounded-pill px-3"
                                            data-bs-toggle="modal"
                                            data-bs-target="#logTransferModal">

                                        <i class="fa-solid fa-plus me-1"></i>
                                        Log First Transaction

                                    </button>

                                </div>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>


        <!-- No Search Result -->
        <div id="noSearchResult"
             class="tp-empty d-none">

            <div class="tp-empty-icon">
                <i class="fa-solid fa-magnifying-glass"></i>
            </div>

            <h6>
                No Matching Transactions
            </h6>

            <p class="mb-0">
                Try changing your search or filters.
            </p>

        </div>

    </div>

</div>


<!-- =========================================================
     LOG TRANSACTION MODAL
     ========================================================= -->

<div class="modal fade tp-modal"
     id="logTransferModal"
     tabindex="-1"
     aria-labelledby="logTransferModalLabel"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered modal-lg">

        <div class="modal-content">

            <form action="/HREmployee/CreateTransfer"
                  method="post">

                @Html.AntiForgeryToken()

                <!-- Modal Header -->
                <div class="tp-modal-header">

                    <div class="d-flex align-items-center justify-content-between">

                        <div>

                            <h5 class="modal-title mb-0"
                                id="logTransferModalLabel">

                                <i class="fa-solid fa-arrows-spin me-2"></i>
                                Log Employee Transaction

                            </h5>

                            <p>
                                Record a promotion or employee transfer
                            </p>

                        </div>

                        <button type="button"
                                class="btn-close"
                                data-bs-dismiss="modal"
                                aria-label="Close">
                        </button>

                    </div>

                </div>


                <!-- Modal Body -->
                <div class="modal-body p-4">

                    <div class="row g-3">

                        <!-- Employee -->
                        <div class="col-md-7">

                            <label class="tp-form-label">
                                Employee Name
                            </label>

                            <div class="tp-input-icon">

                                <i class="fa-solid fa-user"></i>

                                <input type="text"
                                       name="EmployeeName"
                                       class="form-control tp-form-control"
                                       placeholder="e.g. Sunil Mehta"
                                       autocomplete="off"
                                       required />

                            </div>

                        </div>


                        <!-- Type -->
                        <div class="col-md-5">

                            <label class="tp-form-label">
                                Transaction Type
                            </label>

                            <select name="Type"
                                    class="form-select tp-form-control"
                                    required>

                                <option value="Promotion">
                                    Promotion
                                </option>

                                <option value="Transfer">
                                    Transfer
                                </option>

                            </select>

                        </div>


                        <!-- From -->
                        <div class="col-md-6">

                            <label class="tp-form-label">
                                From Department / Designation
                            </label>

                            <div class="tp-input-icon">

                                <i class="fa-solid fa-location-dot"></i>

                                <input type="text"
                                       name="FromDeptOrDesg"
                                       class="form-control tp-form-control"
                                       placeholder="e.g. Sales Executive"
                                       required />

                            </div>

                        </div>


                        <!-- To -->
                        <div class="col-md-6">

                            <label class="tp-form-label">
                                To Department / Designation
                            </label>

                            <div class="tp-input-icon">

                                <i class="fa-solid fa-location-arrow"></i>

                                <input type="text"
                                       name="ToDeptOrDesg"
                                       class="form-control tp-form-control"
                                       placeholder="e.g. Sales Manager"
                                       required />

                            </div>

                        </div>


                        <!-- Effective Date -->
                        <div class="col-md-6">

                            <label class="tp-form-label">
                                Effective Date
                            </label>

                            <div class="tp-input-icon">

                                <i class="fa-regular fa-calendar"></i>

                                <input type="date"
                                       name="EffectiveDate"
                                       class="form-control tp-form-control"
                                       value="@DateTime.Now.ToString("yyyy-MM-dd")"
                                       required />

                            </div>

                        </div>


                        <!-- Approval -->
                        <div class="col-md-6">

                            <label class="tp-form-label">
                                Approval Status
                            </label>

                            <select name="ApprovalStatus"
                                    class="form-select tp-form-control"
                                    required>

                                <option value="Pending Approval">
                                    Pending Approval
                                </option>

                                <option value="Approved">
                                    Approved
                                </option>

                                <option value="Rejected">
                                    Rejected
                                </option>

                            </select>

                        </div>

                    </div>

                </div>


                <!-- Modal Footer -->
                <div class="tp-modal-footer d-flex justify-content-end gap-2">

                    <button type="button"
                            class="btn btn-light border rounded-pill px-4"
                            data-bs-dismiss="modal">

                        Cancel

                    </button>

                    <button type="submit"
                            class="btn btn-primary rounded-pill px-4">

                        <i class="fa-solid fa-check me-2"></i>
                        Save Transaction

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>


<script>
    document.addEventListener("DOMContentLoaded", function () {

        const searchInput = document.getElementById("transferSearch");
        const typeFilter = document.getElementById("typeFilter");
        const statusFilter = document.getElementById("statusFilter");
        const rows = document.querySelectorAll(".transfer-row");
        const noResult = document.getElementById("noSearchResult");

        function filterTransactions() {

            const search = (searchInput?.value || "").toLowerCase().trim();
            const type = (typeFilter?.value || "").toLowerCase();
            const status = (statusFilter?.value || "").toLowerCase();

            let visibleCount = 0;

            rows.forEach(function (row) {

                const name = (row.dataset.name || "").toLowerCase();
                const rowType = (row.dataset.type || "").toLowerCase();
                const rowStatus = (row.dataset.status || "").toLowerCase();

                const matchesSearch =
                    name.includes(search) ||
                    row.textContent.toLowerCase().includes(search);

                const matchesType =
                    !type || rowType === type;

                const matchesStatus =
                    !status || rowStatus === status;

                const show =
                    matchesSearch &&
                    matchesType &&
                    matchesStatus;

                row.style.display = show ? "" : "none";

                if (show) {
                    visibleCount++;
                }

            });

            if (noResult) {

                noResult.classList.toggle(
                    "d-none",
                    visibleCount !== 0
                );

            }

        }

        searchInput?.addEventListener("input", filterTransactions);
        typeFilter?.addEventListener("change", filterTransactions);
        statusFilter?.addEventListener("change", filterTransactions);


        /* Modal entrance animation */
        const modal = document.getElementById("logTransferModal");

        if (modal) {

            modal.addEventListener("shown.bs.modal", function () {

                const firstInput =
                    modal.querySelector('input[name="EmployeeName"]');

                if (firstInput) {
                    setTimeout(() => firstInput.focus(), 150);
                }

            });

        }


        /* Prevent accidental empty spaces */
        document.querySelectorAll(
            '#logTransferModal input[type="text"]'
        ).forEach(function (input) {

            input.addEventListener("blur", function () {
                this.value = this.value.trim();
            });

        });

    });
</script>
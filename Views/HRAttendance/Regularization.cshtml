@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Attendance Regularization Requests";
}

<div class="container-fluid py-4 text-start">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-bold mb-1"><i class="fa-solid fa-envelope-open-text text-primary me-2"></i>Attendance Regularization</h4>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0 small">
                    <li class="breadcrumb-item"><a href="/HR" class="text-decoration-none">HR Dashboard</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Attendance Regularization</li>
                </ol>
            </nav>
        </div>
    </div>

    <!-- Regularization Requests Table -->
    <div class="bg-white border rounded-3 p-4 shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" style="font-size: 0.85rem;">
                <thead class="table-light">
                    <tr>
                        <th>Employee</th>
                        <th>Correction Date</th>
                        <th>Incorrect Punch</th>
                        <th>Requested Correct Time</th>
                        <th>Reason for Correction</th>
                        <th>Request Date</th>
                        <th>Status</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td class="fw-bold text-dark">Aftab Shaik</td>
                        <td>18 Aug 2026</td>
                        <td>Missing Check-out</td>
                        <td>06:00 PM Check-out</td>
                        <td>Internet connectivity failure during geo-punch</td>
                        <td>19 Aug 2026</td>
                        <td><span class="badge bg-warning-subtle text-warning">Pending Review</span></td>
                        <td>
                            <button class="btn btn-success btn-xs rounded-pill px-2.5">Approve</button>
                            <button class="btn btn-outline-danger btn-xs rounded-pill px-2.5">Reject</button>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

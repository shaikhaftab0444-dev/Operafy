@model ERP_System.Models.RegularizationViewModel
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Attendance Regularization Requests";
}

<div class="container-fluid py-4 text-start">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3 shadow-sm mb-4" role="alert">
            <i class="fa-solid fa-circle-check me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-3 shadow-sm mb-4" role="alert">
            <i class="fa-solid fa-triangle-exclamation me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Header & Action Controls -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <h4 class="fw-bold mb-1"><i class="fa-solid fa-envelope-open-text text-primary me-2"></i>Attendance Regularization</h4>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0 small">
                    <li class="breadcrumb-item"><a href="/HR" class="text-decoration-none">HR Dashboard</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Attendance Regularization</li>
                </ol>
            </nav>
        </div>
        <button type="button" class="btn btn-primary rounded-pill px-3 btn-sm shadow-sm" data-bs-toggle="modal" data-bs-target="#submitRequestModal">
            <i class="fa-solid fa-plus me-1.5"></i>Submit Regularization Request
        </button>
    </div>

    <!-- Regularization Stat Cards -->
    <div class="row g-3 mb-4">
        <div class="col-12 col-md-4">
            <div class="card border-0 shadow-sm rounded-3 bg-white p-3 border-start border-4 border-warning">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted small fw-semibold text-uppercase">Pending Review</div>
                        <h3 class="fw-bold text-dark mb-0 mt-1">@Model.PendingCount</h3>
                    </div>
                    <div class="rounded-circle bg-warning bg-opacity-10 p-3 text-warning">
                        <i class="fa-solid fa-clock-rotate-left fa-lg"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-12 col-md-4">
            <div class="card border-0 shadow-sm rounded-3 bg-white p-3 border-start border-4 border-success">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted small fw-semibold text-uppercase">Approved Requests</div>
                        <h3 class="fw-bold text-dark mb-0 mt-1">@Model.ApprovedCount</h3>
                    </div>
                    <div class="rounded-circle bg-success bg-opacity-10 p-3 text-success">
                        <i class="fa-solid fa-circle-check fa-lg"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-12 col-md-4">
            <div class="card border-0 shadow-sm rounded-3 bg-white p-3 border-start border-4 border-danger">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted small fw-semibold text-uppercase">Rejected Requests</div>
                        <h3 class="fw-bold text-dark mb-0 mt-1">@Model.RejectedCount</h3>
                    </div>
                    <div class="rounded-circle bg-danger bg-opacity-10 p-3 text-danger">
                        <i class="fa-solid fa-circle-xmark fa-lg"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Regularization Requests Table -->
    <div class="bg-white border rounded-3 p-4 shadow-sm">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h6 class="fw-bold mb-0 text-secondary">Attendance Correction & Regularization Requests</h6>
            <span class="badge bg-light text-dark border">@Model.Requests.Count Requests Total</span>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" style="font-size: 0.85rem;">
                <thead class="table-light">
                    <tr>
                        <th>Employee</th>
                        <th>Correction Date</th>
                        <th>Incorrect Punch</th>
                        <th>Requested Correct Time</th>
                        <th>Reason for Correction</th>
                        <th>Request Date</th>
                        <th>Status</th>
                        <th>HR Remarks</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Requests.Any())
                    {
                        foreach (var req in Model.Requests)
                        {
                            <tr>
                                <td class="fw-bold text-dark">@req.EmployeeName</td>
                                <td>@req.CorrectionDate.ToString("dd MMM yyyy")</td>
                                <td><span class="badge bg-danger-subtle text-danger">@req.IncorrectPunch</span></td>
                                <td><span class="fw-semibold text-primary">@req.RequestedCorrectTime</span></td>
                                <td class="text-muted small" style="max-width: 250px;">@req.Reason</td>
                                <td>@req.RequestDate.ToString("dd MMM yyyy")</td>
                                <td>
                                    @if (req.Status == "Approved")
                                    {
                                        <span class="badge bg-success-subtle text-success rounded-pill px-2.5">Approved</span>
                                    }
                                    else if (req.Status == "Rejected")
                                    {
                                        <span class="badge bg-danger-subtle text-danger rounded-pill px-2.5">Rejected</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning-subtle text-warning rounded-pill px-2.5">Pending Review</span>
                                    }
                                </td>
                                <td class="text-muted small">@(string.IsNullOrEmpty(req.AdminRemarks) ? "-" : req.AdminRemarks)</td>
                                <td>
                                    @if (req.Status == "Pending Review")
                                    {
                                        <div class="d-flex gap-1">
                                            <form asp-action="ApproveRequest" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="requestId" value="@req.RequestId" />
                                                <button type="submit" class="btn btn-success btn-xs rounded-pill px-2.5">
                                                    Approve
                                                </button>
                                            </form>
                                            <form asp-action="RejectRequest" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="requestId" value="@req.RequestId" />
                                                <button type="submit" class="btn btn-outline-danger btn-xs rounded-pill px-2.5">
                                                    Reject
                                                </button>
                                            </form>
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">Completed</span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="9" class="text-center py-4 text-muted">No attendance regularization requests found. Click "Submit Regularization Request" to create one.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Submit Request Modal -->
<div class="modal fade" id="submitRequestModal" tabindex="-1" aria-labelledby="submitRequestModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-3 border-0 shadow">
            <div class="modal-header bg-light border-bottom px-4 py-3">
                <h5 class="modal-title fw-bold" id="submitRequestModalLabel"><i class="fa-solid fa-pen-to-square text-primary me-2"></i>Submit Regularization Request</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="SubmitRequest" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label small fw-bold text-secondary">Select Employee</label>
                        <select name="userId" class="form-select" required>
                            <option value="">-- Choose Employee --</option>
                            @foreach (var emp in Model.Employees)
                            {
                                <option value="@emp.UserId">@emp.FullName</option>
                            }
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-bold text-secondary">Correction Date</label>
                        <input type="date" name="correctionDate" class="form-control" value="@DateTime.Today.AddDays(-1).ToString("yyyy-MM-dd")" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-bold text-secondary">Incorrect / Missing Punch Type</label>
                        <select name="incorrectPunch" class="form-select" required>
                            <option value="Missing Check-out">Missing Check-out</option>
                            <option value="Missing Check-in">Missing Check-in</option>
                            <option value="Device Misread Check-in">Device Misread Check-in</option>
                            <option value="Geo Location Misread">Geo Location Misread</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-bold text-secondary">Requested Correct Time</label>
                        <input type="text" name="requestedCorrectTime" class="form-control" placeholder="e.g. 06:00 PM Check-out" required />
                    </div>

                    <div class="mb-2">
                        <label class="form-label small fw-bold text-secondary">Reason for Correction</label>
                        <textarea name="reason" class="form-control" rows="3" placeholder="Provide detailed explanation for attendance regularization..." required></textarea>
                    </div>
                </div>
                <div class="modal-footer bg-light border-top px-4 py-2">
                    <button type="button" class="btn btn-secondary btn-sm rounded-pill" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary btn-sm rounded-pill px-4"><i class="fa-solid fa-paper-plane me-1"></i>Submit Request</button>
                </div>
            </form>
        </div>
    </div>
</div>

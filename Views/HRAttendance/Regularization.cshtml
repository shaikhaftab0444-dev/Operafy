@model ERP_System.Models.RegularizationViewModel
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Attendance Regularization Requests";
}

<style>
    /* =========================================================
           ATTENDANCE REGULARIZATION - PROFESSIONAL UI ANIMATIONS
           ========================================================= */

    .regularization-page {
        --reg-primary: var(--primary-warm, #0d6efd);
        --reg-primary-soft: rgba(13, 110, 253, 0.09);
        --reg-border: var(--border-warm, #e8ebef);
        --reg-text: var(--text-color, #252b36);
        --reg-muted: #6c757d;
        --reg-card-bg: #ffffff;
    }

    /* ---------------- Page Entrance ---------------- */

    .regularization-page {
        animation: regPageEnter 0.5s ease-out both;
    }

    @@keyframes regPageEnter {
        from

    {
        opacity: 0;
        transform: translateY(12px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }

    }

    .reg-page-header {
        animation: regFadeUp 0.55s ease-out both;
    }

    .reg-stat-card {
        animation: regFadeUp 0.55s ease-out both;
        animation-delay: calc(var(--delay, 0) * 0.08s);
    }

    .reg-table-card {
        animation: regFadeUp 0.6s ease-out both;
        animation-delay: 0.2s;
    }

    @@keyframes regFadeUp {
        from

    {
        opacity: 0;
        transform: translateY(18px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }

    }

    /* ---------------- Alerts ---------------- */

    .reg-alert {
        border: none;
        border-radius: 16px;
        box-shadow: 0 10px 30px rgba(20, 30, 50, 0.07);
        animation: regAlertEnter 0.45s ease-out both;
        transition: transform 0.25s ease, box-shadow 0.25s ease;
    }

        .reg-alert:hover {
            transform: translateY(-2px);
            box-shadow: 0 14px 35px rgba(20, 30, 50, 0.1);
        }

    @@keyframes regAlertEnter {
        from

    {
        opacity: 0;
        transform: translateY(-12px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }

    }

    /* ---------------- Header ---------------- */

    .reg-title {
        color: var(--reg-text);
        letter-spacing: -0.02em;
    }

    .reg-title-icon {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 38px;
        height: 38px;
        border-radius: 12px;
        background: var(--reg-primary-soft);
        color: var(--reg-primary);
        margin-right: 8px;
        transition: transform 0.3s ease, background 0.3s ease;
    }

    .reg-page-header:hover .reg-title-icon {
        transform: rotate(-5deg) scale(1.06);
        background: rgba(13, 110, 253, 0.14);
    }

    .reg-breadcrumb a {
        color: var(--reg-primary);
        transition: color 0.2s ease, opacity 0.2s ease;
    }

        .reg-breadcrumb a:hover {
            opacity: 0.75;
        }

    /* ---------------- Buttons ---------------- */

    .reg-btn-primary {
        position: relative;
        overflow: hidden;
        border: none;
        transition: transform 0.2s ease, box-shadow 0.25s ease, background-color 0.25s ease;
    }

        .reg-btn-primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 22px rgba(13, 110, 253, 0.25) !important;
        }

        .reg-btn-primary:active {
            transform: translateY(0) scale(0.97);
        }

        .reg-btn-primary::after {
            content: "";
            position: absolute;
            top: 0;
            left: -80%;
            width: 55%;
            height: 100%;
            background: linear-gradient( 90deg, transparent, rgba(255, 255, 255, 0.25), transparent );
            transform: skewX(-25deg);
            transition: left 0.55s ease;
        }

        .reg-btn-primary:hover::after {
            left: 130%;
        }

    .reg-action-btn {
        transition: transform 0.2s ease, box-shadow 0.2s ease, filter 0.2s ease;
    }

        .reg-action-btn:hover {
            transform: translateY(-1px);
            box-shadow: 0 5px 12px rgba(0, 0, 0, 0.08);
            filter: brightness(1.02);
        }

        .reg-action-btn:active {
            transform: scale(0.96);
        }

    /* ---------------- Statistics Cards ---------------- */

    .reg-stat-card {
        position: relative;
        overflow: hidden;
        background: var(--reg-card-bg);
        border-radius: 18px !important;
        border-top: 1px solid rgba(0, 0, 0, 0.03) !important;
        border-right: 1px solid rgba(0, 0, 0, 0.03) !important;
        border-bottom: 1px solid rgba(0, 0, 0, 0.03) !important;
        transition: transform 0.28s ease, box-shadow 0.28s ease;
    }

        .reg-stat-card::before {
            content: "";
            position: absolute;
            width: 130px;
            height: 130px;
            border-radius: 50%;
            top: -80px;
            right: -45px;
            background: currentColor;
            opacity: 0.035;
            transition: transform 0.35s ease;
        }

        .reg-stat-card:hover {
            transform: translateY(-6px);
            box-shadow: 0 16px 35px rgba(22, 34, 51, 0.1) !important;
        }

            .reg-stat-card:hover::before {
                transform: scale(1.25);
            }

    .reg-stat-icon {
        width: 54px;
        height: 54px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 17px;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

    .reg-stat-card:hover .reg-stat-icon {
        transform: rotate(-5deg) scale(1.08);
    }

    .reg-stat-number {
        letter-spacing: -0.04em;
        line-height: 1;
    }

    /* ---------------- Table Card ---------------- */

    .reg-table-card {
        position: relative;
        overflow: hidden;
        border-radius: 20px !important;
        border-color: var(--reg-border) !important;
        transition: transform 0.25s ease, box-shadow 0.25s ease;
    }

        .reg-table-card:hover {
            box-shadow: 0 16px 40px rgba(25, 35, 50, 0.07) !important;
        }

    .reg-table-heading {
        letter-spacing: -0.01em;
    }

    .reg-total-badge {
        border-radius: 999px;
        padding: 0.5rem 0.8rem;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

        .reg-total-badge:hover {
            transform: scale(1.04);
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.07);
        }

    /* ---------------- Table ---------------- */

    .reg-table {
        border-collapse: separate;
        border-spacing: 0;
    }

        .reg-table thead th {
            background: #f8f9fa;
            color: #707785;
            font-size: 0.72rem;
            font-weight: 700;
            letter-spacing: 0.045em;
            text-transform: uppercase;
            white-space: nowrap;
            padding: 0.95rem 0.85rem;
            border-bottom: 1px solid #edf0f3;
        }

            .reg-table thead th:first-child {
                border-radius: 12px 0 0 12px;
            }

            .reg-table thead th:last-child {
                border-radius: 0 12px 12px 0;
            }

        .reg-table tbody tr {
            opacity: 0;
            animation: regRowEnter 0.45s ease forwards;
            transition: transform 0.2s ease, background-color 0.2s ease, box-shadow 0.2s ease;
        }

            .reg-table tbody tr:nth-child(1) {
                animation-delay: 0.04s;
            }

            .reg-table tbody tr:nth-child(2) {
                animation-delay: 0.08s;
            }

            .reg-table tbody tr:nth-child(3) {
                animation-delay: 0.12s;
            }

            .reg-table tbody tr:nth-child(4) {
                animation-delay: 0.16s;
            }

            .reg-table tbody tr:nth-child(5) {
                animation-delay: 0.20s;
            }

            .reg-table tbody tr:nth-child(n+6) {
                animation-delay: 0.24s;
            }

    @@keyframes regRowEnter {
        from

    {
        opacity: 0;
        transform: translateY(8px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }

    }

    .reg-table tbody tr:hover {
        background: rgba(13, 110, 253, 0.025) !important;
        box-shadow: inset 3px 0 0 var(--reg-primary);
    }

    .reg-table tbody td {
        padding: 1rem 0.85rem;
        vertical-align: middle;
        border-bottom-color: #edf0f3;
    }

    .reg-employee {
        color: var(--reg-text);
        transition: color 0.2s ease;
    }

    .reg-table tbody tr:hover .reg-employee {
        color: var(--reg-primary);
    }

    .reg-reason {
        max-width: 250px;
        line-height: 1.5;
    }

    /* ---------------- Status Badges ---------------- */

    .reg-status-badge,
    .reg-punch-badge {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 0.42rem 0.72rem;
        border-radius: 999px;
        font-size: 0.74rem;
        font-weight: 700;
        white-space: nowrap;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

        .reg-status-badge:hover,
        .reg-punch-badge:hover {
            transform: translateY(-1px);
        }

    .reg-correct-time {
        display: inline-flex;
        align-items: center;
        padding: 0.35rem 0.6rem;
        border-radius: 8px;
        background: var(--reg-primary-soft);
        font-size: 0.78rem;
    }

    /* ---------------- Empty State ---------------- */

    .reg-empty-state {
        padding: 3rem 1rem !important;
    }

    .reg-empty-icon {
        width: 62px;
        height: 62px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 18px;
        background: #f1f3f5;
        color: #8a939f;
        font-size: 1.5rem;
        margin-bottom: 0.9rem;
        animation: regFloat 3.5s ease-in-out infinite;
    }

    @@keyframes regFloat {
        0%, 100%

    {
        transform: translateY(0);
    }

    50% {
        transform: translateY(-6px);
    }

    }

    /* ---------------- Modal ---------------- */

    .reg-modal .modal-content {
        border-radius: 20px !important;
        overflow: hidden;
        box-shadow: 0 24px 70px rgba(18, 30, 45, 0.18) !important;
        transform: translateY(10px) scale(0.98);
        transition: transform 0.25s ease, opacity 0.25s ease;
    }

    .reg-modal.show .modal-content {
        transform: translateY(0) scale(1);
    }

    .reg-modal .modal-header {
        background: linear-gradient( 135deg, rgba(13, 110, 253, 0.08), rgba(13, 110, 253, 0.025) );
    }

    .reg-modal-icon {
        width: 38px;
        height: 38px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 11px;
        background: var(--reg-primary-soft);
        color: var(--reg-primary);
    }

    /* ---------------- Forms ---------------- */

    .reg-modal .form-label {
        margin-bottom: 0.45rem;
        color: #5d6571;
        letter-spacing: 0.01em;
    }

    .reg-modal .form-control,
    .reg-modal .form-select {
        border-radius: 11px;
        min-height: 42px;
        border-color: #e2e6ea;
        transition: border-color 0.2s ease, box-shadow 0.2s ease, transform 0.2s ease, background-color 0.2s ease;
    }

    .reg-modal textarea.form-control {
        min-height: auto;
    }

    .reg-modal .form-control:hover,
    .reg-modal .form-select:hover {
        border-color: #c5ccd5;
    }

    .reg-modal .form-control:focus,
    .reg-modal .form-select:focus {
        border-color: rgba(13, 110, 253, 0.65);
        box-shadow: 0 0 0 0.22rem rgba(13, 110, 253, 0.1);
        transform: translateY(-1px);
    }

    .reg-modal .modal-footer {
        background: #fbfcfd;
    }

    /* ---------------- Scrollbar ---------------- */

    .reg-table-card ::-webkit-scrollbar {
        height: 7px;
    }

    .reg-table-card ::-webkit-scrollbar-track {
        background: #f1f3f5;
        border-radius: 10px;
    }

    .reg-table-card ::-webkit-scrollbar-thumb {
        background: #c8ced6;
        border-radius: 10px;
    }

        .reg-table-card ::-webkit-scrollbar-thumb:hover {
            background: #adb5bd;
        }

    /* ---------------- Responsive ---------------- */

    @@media (max-width: 767.98px) {
        .reg-title

    {
        font-size: 1.25rem;
    }

    .reg-stat-card {
        min-height: 112px;
    }

    .reg-table-card {
        padding: 1rem !important;
        border-radius: 16px !important;
    }

    .reg-table-heading {
        font-size: 0.82rem;
    }

    }

    /* ---------------- Reduced Motion ---------------- */

    @@media (prefers-reduced-motion: reduce) {
        *, *::before, *::after

    {
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.01ms !important;
        scroll-behavior: auto !important;
    }

    }
</style>

<div class="container-fluid py-4 text-start regularization-page">

    <!-- Success Message -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show reg-alert mb-4" role="alert">
            <i class="fa-solid fa-circle-check me-2"></i>
            @TempData["SuccessMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Close"></button>
        </div>
    }

    <!-- Error Message -->
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show reg-alert mb-4" role="alert">
            <i class="fa-solid fa-triangle-exclamation me-2"></i>
            @TempData["ErrorMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Close"></button>
        </div>
    }

    <!-- Header -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4 reg-page-header">

        <div>
            <h4 class="fw-bold mb-1 d-flex align-items-center reg-title">
                <span class="reg-title-icon">
                    <i class="fa-solid fa-envelope-open-text"></i>
                </span>
                Attendance Regularization
            </h4>

            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0 small reg-breadcrumb">
                    <li class="breadcrumb-item">
                        <a href="/HR" class="text-decoration-none">
                            HR Dashboard
                        </a>
                    </li>

                    <li class="breadcrumb-item active" aria-current="page">
                        Attendance Regularization
                    </li>
                </ol>
            </nav>
        </div>

        <button type="button"
                class="btn btn-primary rounded-pill px-3 btn-sm shadow-sm reg-btn-primary"
                data-bs-toggle="modal"
                data-bs-target="#submitRequestModal">
            <i class="fa-solid fa-plus me-1.5"></i>
            Submit Regularization Request
        </button>

    </div>

    <!-- Statistics Cards -->
    <div class="row g-3 mb-4">

        <!-- Pending -->
        <div class="col-12 col-md-4">
            <div class="card border-0 shadow-sm bg-white p-3 border-start border-4 border-warning reg-stat-card"
                 style="--delay: 1; color: #ffc107;">

                <div class="d-flex align-items-center justify-content-between">

                    <div>
                        <div class="text-muted small fw-semibold text-uppercase">
                            Pending Review
                        </div>

                        <h3 class="fw-bold text-dark mb-0 mt-1 reg-stat-number">
                            @Model.PendingCount
                        </h3>
                    </div>

                    <div class="reg-stat-icon bg-warning bg-opacity-10 text-warning">
                        <i class="fa-solid fa-clock-rotate-left fa-lg"></i>
                    </div>

                </div>

            </div>
        </div>

        <!-- Approved -->
        <div class="col-12 col-md-4">
            <div class="card border-0 shadow-sm bg-white p-3 border-start border-4 border-success reg-stat-card"
                 style="--delay: 2; color: #198754;">

                <div class="d-flex align-items-center justify-content-between">

                    <div>
                        <div class="text-muted small fw-semibold text-uppercase">
                            Approved Requests
                        </div>

                        <h3 class="fw-bold text-dark mb-0 mt-1 reg-stat-number">
                            @Model.ApprovedCount
                        </h3>
                    </div>

                    <div class="reg-stat-icon bg-success bg-opacity-10 text-success">
                        <i class="fa-solid fa-circle-check fa-lg"></i>
                    </div>

                </div>

            </div>
        </div>

        <!-- Rejected -->
        <div class="col-12 col-md-4">
            <div class="card border-0 shadow-sm bg-white p-3 border-start border-4 border-danger reg-stat-card"
                 style="--delay: 3; color: #dc3545;">

                <div class="d-flex align-items-center justify-content-between">

                    <div>
                        <div class="text-muted small fw-semibold text-uppercase">
                            Rejected Requests
                        </div>

                        <h3 class="fw-bold text-dark mb-0 mt-1 reg-stat-number">
                            @Model.RejectedCount
                        </h3>
                    </div>

                    <div class="reg-stat-icon bg-danger bg-opacity-10 text-danger">
                        <i class="fa-solid fa-circle-xmark fa-lg"></i>
                    </div>

                </div>

            </div>
        </div>

    </div>

    <!-- Requests Table -->
    <div class="bg-white border p-4 shadow-sm reg-table-card">

        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-2 mb-3">

            <div>
                <h6 class="fw-bold mb-1 text-dark reg-table-heading">
                    Attendance Correction & Regularization Requests
                </h6>

                <div class="small text-muted">
                    Review and manage employee attendance correction requests.
                </div>
            </div>

            <span class="badge bg-light text-dark border reg-total-badge">
                <i class="fa-solid fa-file-circle-check text-primary me-1"></i>
                @Model.Requests.Count Requests Total
            </span>

        </div>

        <div class="table-responsive">

            <table class="table table-hover align-middle mb-0 reg-table"
                   style="font-size: 0.85rem;">

                <thead>
                    <tr>
                        <th>Employee</th>
                        <th>Correction Date</th>
                        <th>Incorrect Punch</th>
                        <th>Requested Correct Time</th>
                        <th>Reason for Correction</th>
                        <th>Request Date</th>
                        <th>Status</th>
                        <th>HR Remarks</th>
                        <th>Action</th>
                    </tr>
                </thead>

                <tbody>

                    @if (Model.Requests.Any())
                    {
                        foreach (var req in Model.Requests)
                        {
                            <tr>

                                <!-- Employee -->
                                <td>
                                    <div class="d-flex align-items-center gap-2">

                                        <div class="rounded-circle bg-primary bg-opacity-10 text-primary d-flex align-items-center justify-content-center"
                                             style="width: 32px; height: 32px; min-width: 32px;">
                                            <i class="fa-solid fa-user"></i>
                                        </div>

                                        <span class="fw-bold reg-employee">
                                            @req.EmployeeName
                                        </span>

                                    </div>
                                </td>

                                <!-- Correction Date -->
                                <td class="text-muted">
                                    <i class="fa-regular fa-calendar me-1 text-secondary opacity-75"></i>
                                    @req.CorrectionDate.ToString("dd MMM yyyy")
                                </td>

                                <!-- Incorrect Punch -->
                                <td>
                                    <span class="reg-punch-badge bg-danger-subtle text-danger">
                                        <i class="fa-solid fa-triangle-exclamation"></i>
                                        @req.IncorrectPunch
                                    </span>
                                </td>

                                <!-- Requested Time -->
                                <td>
                                    <span class="fw-semibold text-primary reg-correct-time">
                                        <i class="fa-regular fa-clock me-1"></i>
                                        @req.RequestedCorrectTime
                                    </span>
                                </td>

                                <!-- Reason -->
                                <td class="text-muted small reg-reason">
                                    @req.Reason
                                </td>

                                <!-- Request Date -->
                                <td class="text-muted">
                                    @req.RequestDate.ToString("dd MMM yyyy")
                                </td>

                                <!-- Status -->
                                <td>

                                    @if (req.Status == "Approved")
                                    {
                                        <span class="reg-status-badge bg-success-subtle text-success">
                                            <i class="fa-solid fa-circle-check"></i>
                                            Approved
                                        </span>
                                    }
                                    else if (req.Status == "Rejected")
                                    {
                                        <span class="reg-status-badge bg-danger-subtle text-danger">
                                            <i class="fa-solid fa-circle-xmark"></i>
                                            Rejected
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="reg-status-badge bg-warning-subtle text-warning">
                                            <i class="fa-solid fa-hourglass-half"></i>
                                            Pending Review
                                        </span>
                                    }

                        </td>

                        <!-- HR Remarks -->
                        <td class="text-muted small">
                            @(string.IsNullOrEmpty(req.AdminRemarks)
                                                        ? "-"
                                                        : req.AdminRemarks)
                        </td>

                                <!-- Action -->
                                <td>

                            @if (req.Status == "Pending Review")
                                    {
                                        <div class="d-flex flex-wrap gap-1">

                                            <!-- Approve -->
                                            <form asp-action="ApproveRequest"
                                                  method="post"
                                                  class="d-inline">

                                                @Html.AntiForgeryToken()

                                                <input type="hidden"
                                                       name="requestId"
                                                       value="@req.RequestId" />

                                                <button type="submit"
                                                        class="btn btn-success btn-xs rounded-pill px-2.5 reg-action-btn">
                                                    <i class="fa-solid fa-check me-1"></i>
                                                    Approve
                                                </button>

                                            </form>

                                            <!-- Reject -->
                                            <form asp-action="RejectRequest"
                                                  method="post"
                                                  class="d-inline">

                                                @Html.AntiForgeryToken()

                                                <input type="hidden"
                                                       name="requestId"
                                                       value="@req.RequestId" />

                                                <button type="submit"
                                                        class="btn btn-outline-danger btn-xs rounded-pill px-2.5 reg-action-btn">
                                                    <i class="fa-solid fa-xmark me-1"></i>
                                                    Reject
                                                </button>

                                            </form>

                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">
                                            <i class="fa-solid fa-circle-check me-1 opacity-50"></i>
                                            Completed
                                        </span>
                                    }

                                </td>

                            </tr>
                        }
                    }
                    else
                    {
                        <tr>

                            <td colspan="9"
                                class="text-center text-muted reg-empty-state">

                                <div class="reg-empty-icon">
                                    <i class="fa-solid fa-calendar-check"></i>
                                </div>

                                <div class="fw-semibold text-dark mb-1">
                                    No regularization requests found
                                </div>

                                <div class="small text-muted">
                                    Click "Submit Regularization Request" to create one.
                                </div>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>


<!-- =========================================================
     SUBMIT REGULARIZATION REQUEST MODAL
     ========================================================= -->

<div class="modal fade reg-modal"
     id="submitRequestModal"
     tabindex="-1"
     aria-labelledby="submitRequestModalLabel"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content border-0">

            <!-- Modal Header -->
            <div class="modal-header border-bottom px-4 py-3">

                <h5 class="modal-title fw-bold d-flex align-items-center gap-2"
                    id="submitRequestModalLabel">

                    <span class="reg-modal-icon">
                        <i class="fa-solid fa-pen-to-square"></i>
                    </span>

                    Submit Regularization Request

                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Close"></button>

            </div>


            <!-- Form -->
            <form asp-action="SubmitRequest" method="post">

                @Html.AntiForgeryToken()

                <div class="modal-body p-4">

                    <!-- Employee -->
                    <div class="mb-3">

                        <label class="form-label small fw-bold">
                            Select Employee
                        </label>

                        <select name="userId"
                                class="form-select"
                                required>

                            <option value="">
                                -- Choose Employee --
                            </option>

                            @foreach (var emp in Model.Employees)
                            {
                                <option value="@emp.UserId">
                                    @emp.FullName
                                </option>
                            }

                        </select>

                    </div>


                    <!-- Correction Date -->
                    <div class="mb-3">

                        <label class="form-label small fw-bold">
                            Correction Date
                        </label>

                        <input type="date"
                               name="correctionDate"
                               class="form-control"
                               value="@DateTime.Today.AddDays(-1).ToString("yyyy-MM-dd")"
                               required />

                    </div>


                    <!-- Incorrect Punch -->
                    <div class="mb-3">

                        <label class="form-label small fw-bold">
                            Incorrect / Missing Punch Type
                        </label>

                        <select name="incorrectPunch"
                                class="form-select"
                                required>

                            <option value="Missing Check-out">
                                Missing Check-out
                            </option>

                            <option value="Missing Check-in">
                                Missing Check-in
                            </option>

                            <option value="Device Misread Check-in">
                                Device Misread Check-in
                            </option>

                            <option value="Geo Location Misread">
                                Geo Location Misread
                            </option>

                        </select>

                    </div>


                    <!-- Requested Correct Time -->
                    <div class="mb-3">

                        <label class="form-label small fw-bold">
                            Requested Correct Time
                        </label>

                        <input type="text"
                               name="requestedCorrectTime"
                               class="form-control"
                               placeholder="e.g. 06:00 PM Check-out"
                               required />

                    </div>


                    <!-- Reason -->
                    <div class="mb-2">

                        <label class="form-label small fw-bold">
                            Reason for Correction
                        </label>

                        <textarea name="reason"
                                  class="form-control"
                                  rows="3"
                                  placeholder="Provide detailed explanation for attendance regularization..."
                                  required></textarea>

                    </div>

                </div>


                <!-- Modal Footer -->
                <div class="modal-footer border-top px-4 py-3">

                    <button type="button"
                            class="btn btn-outline-secondary btn-sm rounded-pill px-3 reg-action-btn"
                            data-bs-dismiss="modal">
                        Cancel
                    </button>

                    <button type="submit"
                            class="btn btn-primary btn-sm rounded-pill px-4 reg-btn-primary">

                        <i class="fa-solid fa-paper-plane me-1"></i>
                        Submit Request

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Shift Scheduling & Rosters";
}

<div class="container-fluid py-4 text-start">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-bold mb-1"><i class="fa-solid fa-clock text-primary me-2"></i>Shift Scheduling & Rosters</h4>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0 small">
                    <li class="breadcrumb-item"><a href="/HR" class="text-decoration-none">HR Dashboard</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Shift Rosters</li>
                </ol>
            </nav>
        </div>
        <button class="btn btn-primary rounded-pill px-3 btn-sm shadow-sm"><i class="fa-solid fa-calendar-plus me-1.5"></i>Assign Shift</button>
    </div>

    <!-- Shifts Table -->
    <div class="bg-white border rounded-3 p-4 shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" style="font-size: 0.85rem;">
                <thead class="table-light">
                    <tr>
                        <th>Employee</th>
                        <th>Current Shift</th>
                        <th>Timings</th>
                        <th>Weekly Offs</th>
                        <th>Roster Effective Date</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td class="fw-bold text-dark">Numan Sales Man</td>
                        <td>General Shift (Day)</td>
                        <td>09:00 AM - 06:00 PM</td>
                        <td>Sunday</td>
                        <td>01 Aug 2026</td>
                        <td><button class="btn btn-outline-secondary btn-xs rounded-pill px-2.5">Edit Roster</button></td>
                    </tr>
                    <tr>
                        <td class="fw-bold text-dark">Rajesh Kumar</td>
                        <td>Night Shift</td>
                        <td>10:00 PM - 07:00 AM</td>
                        <td>Saturday, Sunday</td>
                        <td>15 Aug 2026</td>
                        <td><button class="btn btn-outline-secondary btn-xs rounded-pill px-2.5">Edit Roster</button></td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

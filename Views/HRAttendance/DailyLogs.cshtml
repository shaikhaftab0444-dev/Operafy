@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Daily Attendance Logs";
}

<div class="container-fluid py-4 text-start">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-bold mb-1"><i class="fa-solid fa-calendar-check text-primary me-2"></i>Daily Attendance Logs</h4>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0 small">
                    <li class="breadcrumb-item"><a href="/HR" class="text-decoration-none">HR Dashboard</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Daily Attendance Logs</li>
                </ol>
            </nav>
        </div>
        <input type="date" class="form-control form-control-sm w-auto" value="@DateTime.Now.ToString("yyyy-MM-dd")" />
    </div>

    <!-- Attendance Logs Grid -->
    <div class="bg-white border rounded-3 p-4 shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" style="font-size: 0.85rem;">
                <thead class="table-light">
                    <tr>
                        <th>Employee ID</th>
                        <th>Employee Name</th>
                        <th>Check-in Time</th>
                        <th>Check-out Time</th>
                        <th>Total Hours Worked</th>
                        <th>Punch Source</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td class="fw-bold text-dark">EMP-001</td>
                        <td>Numan Sales Man</td>
                        <td>09:05 AM</td>
                        <td>06:00 PM</td>
                        <td>8h 55m</td>
                        <td>Biometric Device 1</td>
                        <td><span class="badge bg-success-subtle text-success rounded-pill">Present (On Time)</span></td>
                    </tr>
                    <tr>
                        <td class="fw-bold text-dark">EMP-002</td>
                        <td>Aftab Shaik</td>
                        <td>09:12 AM</td>
                        <td>06:05 PM</td>
                        <td>8h 53m</td>
                        <td>Geo-Punch App</td>
                        <td><span class="badge bg-success-subtle text-success rounded-pill">Present (On Time)</span></td>
                    </tr>
                    <tr>
                        <td class="fw-bold text-dark">EMP-003</td>
                        <td>Rajesh Kumar</td>
                        <td>09:45 AM</td>
                        <td>06:00 PM</td>
                        <td>8h 15m</td>
                        <td>Manual Entry</td>
                        <td><span class="badge bg-warning-subtle text-warning rounded-pill">Late Check-in</span></td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

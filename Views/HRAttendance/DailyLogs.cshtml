@model ERP_System.Models.DailyLogsViewModel
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Daily Attendance Logs";
}

<div class="container-fluid py-4 text-start">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3 shadow-sm mb-4" role="alert">
            <i class="fa-solid fa-circle-check me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-3 shadow-sm mb-4" role="alert">
            <i class="fa-solid fa-triangle-exclamation me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Header & Action Controls -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <h4 class="fw-bold mb-1"><i class="fa-solid fa-calendar-check text-primary me-2"></i>Daily Attendance Logs</h4>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0 small">
                    <li class="breadcrumb-item"><a href="/HR" class="text-decoration-none">HR Dashboard</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Daily Attendance Logs</li>
                </ol>
            </nav>
        </div>
        <div class="d-flex align-items-center gap-2">
            <button type="button" class="btn btn-primary rounded-pill btn-sm px-3 shadow-sm" data-bs-toggle="modal" data-bs-target="#manualPunchModal">
                <i class="fa-solid fa-plus me-1.5"></i>Manual Punch / Log
            </button>
        </div>
    </div>

    <!-- Top Statistics Cards -->
    <div class="row g-3 mb-4">
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-3 bg-white p-3 border-start border-4 border-success">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted small fw-semibold text-uppercase">Present (On Time)</div>
                        <h3 class="fw-bold text-dark mb-0 mt-1">@Model.TotalPresent</h3>
                    </div>
                    <div class="rounded-circle bg-success bg-opacity-10 p-3 text-success">
                        <i class="fa-solid fa-user-check fa-lg"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-3 bg-white p-3 border-start border-4 border-warning">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted small fw-semibold text-uppercase">Late Check-ins</div>
                        <h3 class="fw-bold text-dark mb-0 mt-1">@Model.TotalLate</h3>
                    </div>
                    <div class="rounded-circle bg-warning bg-opacity-10 p-3 text-warning">
                        <i class="fa-solid fa-clock-rotate-left fa-lg"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-3 bg-white p-3 border-start border-4 border-info">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted small fw-semibold text-uppercase">On Leave</div>
                        <h3 class="fw-bold text-dark mb-0 mt-1">@Model.TotalOnLeave</h3>
                    </div>
                    <div class="rounded-circle bg-info bg-opacity-10 p-3 text-info">
                        <i class="fa-solid fa-umbrella-beach fa-lg"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-3 bg-white p-3 border-start border-4 border-danger">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted small fw-semibold text-uppercase">Absent</div>
                        <h3 class="fw-bold text-dark mb-0 mt-1">@Model.TotalAbsent</h3>
                    </div>
                    <div class="rounded-circle bg-danger bg-opacity-10 p-3 text-danger">
                        <i class="fa-solid fa-user-xmark fa-lg"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Filters Bar -->
    <div class="bg-white border rounded-3 p-3 shadow-sm mb-4">
        <form method="get" asp-action="DailyLogs" class="row g-2 align-items-center">
            <div class="col-12 col-md-3">
                <label class="form-label small fw-bold text-secondary mb-1">Filter Date</label>
                <input type="date" name="selectedDate" class="form-control form-control-sm" value="@Model.SelectedDate.ToString("yyyy-MM-dd")" onchange="this.form.submit()" />
            </div>
            <div class="col-12 col-md-4">
                <label class="form-label small fw-bold text-secondary mb-1">Search Employee</label>
                <div class="input-group input-group-sm">
                    <span class="input-group-text bg-light"><i class="fa-solid fa-magnifying-glass"></i></span>
                    <input type="text" name="searchTerm" class="form-control" placeholder="Search by name or code..." value="@Model.SearchTerm" />
                </div>
            </div>
            <div class="col-12 col-md-3">
                <label class="form-label small fw-bold text-secondary mb-1">Status</label>
                <select name="statusFilter" class="form-select form-select-sm" onchange="this.form.submit()">
                    <option value="All" selected="@(Model.StatusFilter == "All")">All Statuses</option>
                    <option value="Present (On Time)" selected="@(Model.StatusFilter == "Present (On Time)")">Present (On Time)</option>
                    <option value="Late Check-in" selected="@(Model.StatusFilter == "Late Check-in")">Late Check-in</option>
                    <option value="On Leave" selected="@(Model.StatusFilter == "On Leave")">On Leave</option>
                    <option value="Absent" selected="@(Model.StatusFilter == "Absent")">Absent</option>
                </select>
            </div>
            <div class="col-12 col-md-2 d-flex align-items-end pt-3">
                <button type="submit" class="btn btn-dark btn-sm w-100"><i class="fa-solid fa-filter me-1"></i>Filter</button>
            </div>
        </form>
    </div>

    <!-- Attendance Logs Table -->
    <div class="bg-white border rounded-3 p-4 shadow-sm">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h6 class="fw-bold mb-0 text-secondary">Attendance Logs for @Model.SelectedDate.ToString("dd MMMM yyyy")</h6>
            <span class="badge bg-light text-dark border">Total Records: @Model.Logs.Count</span>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" style="font-size: 0.85rem;">
                <thead class="table-light">
                    <tr>
                        <th>Employee ID</th>
                        <th>Employee Name</th>
                        <th>Check-in Time</th>
                        <th>Check-out Time</th>
                        <th>Total Hours Worked</th>
                        <th>Punch Source</th>
                        <th>Status</th>
                        <th>Remarks</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Logs.Any())
                    {
                        foreach (var log in Model.Logs)
                        {
                            <tr>
                                <td class="fw-bold text-dark">@log.EmployeeCode</td>
                                <td>@log.EmployeeName</td>
                                <td>@(log.CheckInTime.HasValue ? log.CheckInTime.Value.ToString("hh:mm tt") : "--:--")</td>
                                <td>@(log.CheckOutTime.HasValue ? log.CheckOutTime.Value.ToString("hh:mm tt") : "--:--")</td>
                                <td><span class="fw-semibold text-dark">@log.WorkHours</span></td>
                                <td><span class="badge bg-light text-secondary border">@log.PunchSource</span></td>
                                <td>
                                    @if (log.Status.StartsWith("Present"))
                                    {
                                        <span class="badge bg-success-subtle text-success rounded-pill px-2.5">@log.Status</span>
                                    }
                                    else if (log.Status.Contains("Late"))
                                    {
                                        <span class="badge bg-warning-subtle text-warning rounded-pill px-2.5">@log.Status</span>
                                    }
                                    else if (log.Status.Contains("Leave"))
                                    {
                                        <span class="badge bg-info-subtle text-info rounded-pill px-2.5">@log.Status</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger-subtle text-danger rounded-pill px-2.5">@log.Status</span>
                                    }
                                </td>
                                <td class="text-muted small">@(string.IsNullOrEmpty(log.Remarks) ? "-" : log.Remarks)</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="text-center py-4 text-muted">
                                <i class="fa-solid fa-inbox fa-2x mb-2 d-block opacity-50"></i>
                                No attendance records found for the selected date and filters.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Manual Punch Modal -->
<div class="modal fade" id="manualPunchModal" tabindex="-1" aria-labelledby="manualPunchModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-3 border-0 shadow">
            <div class="modal-header bg-light border-bottom px-4 py-3">
                <h5 class="modal-title fw-bold" id="manualPunchModalLabel"><i class="fa-solid fa-user-clock text-primary me-2"></i>Manual Attendance Punch</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="ManualPunch" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label small fw-bold text-secondary">Select Employee</label>
                        <select name="userId" class="form-select" required>
                            <option value="">-- Choose Employee --</option>
                            @foreach (var emp in Model.Employees)
                            {
                                <option value="@emp.UserId">@emp.FullName (@(string.IsNullOrEmpty(emp.UserCode) ? $"EMP-00{emp.UserId}" : emp.UserCode))</option>
                            }
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-bold text-secondary">Date</label>
                        <input type="date" name="date" class="form-control" value="@DateTime.Today.ToString("yyyy-MM-dd")" required />
                    </div>

                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label small fw-bold text-secondary">Check-in Time</label>
                            <input type="time" name="checkInTime" class="form-control" value="09:00" required />
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-bold text-secondary">Check-out Time</label>
                            <input type="time" name="checkOutTime" class="form-control" value="18:00" />
                        </div>
                    </div>

                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label small fw-bold text-secondary">Punch Source</label>
                            <select name="punchSource" class="form-select">
                                <option value="Manual Entry">Manual Entry</option>
                                <option value="Biometric Device 1">Biometric Device 1</option>
                                <option value="Geo-Punch App">Geo-Punch App</option>
                                <option value="RFID Gateway">RFID Gateway</option>
                            </select>
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-bold text-secondary">Status</label>
                            <select name="status" class="form-select">
                                <option value="Present (On Time)">Present (On Time)</option>
                                <option value="Late Check-in">Late Check-in</option>
                                <option value="Early Departure">Early Departure</option>
                                <option value="Half Day">Half Day</option>
                                <option value="Absent">Absent</option>
                                <option value="On Leave">On Leave</option>
                            </select>
                        </div>
                    </div>

                    <div class="mb-2">
                        <label class="form-label small fw-bold text-secondary">Remarks / Justification</label>
                        <textarea name="remarks" class="form-control" rows="2" placeholder="e.g. Approved manual correction by HR"></textarea>
                    </div>
                </div>
                <div class="modal-footer bg-light border-top px-4 py-2">
                    <button type="button" class="btn btn-secondary btn-sm rounded-pill" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary btn-sm rounded-pill px-4"><i class="fa-solid fa-save me-1"></i>Save Attendance Log</button>
                </div>
            </form>
        </div>
    </div>
</div>

@model ERP_System.Models.DailyLogsViewModel
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Daily Attendance Logs";
}

<style>
    /* =========================================
           DAILY ATTENDANCE LOGS - PREMIUM UI
           ========================================= */

    .attendance-page {
        --page-primary: var(--primary-warm, #0d6efd);
        --page-border: var(--border-warm, #e8e8e8);
        --page-text: var(--text-color, #212529);
        --page-muted: #6c757d;
        --page-bg: #f8fafc;
    }

        /* Page entrance */
        .attendance-page > * {
            animation: attendanceFadeUp .55s ease both;
        }

            .attendance-page > *:nth-child(1) {
                animation-delay: .03s;
            }

            .attendance-page > *:nth-child(2) {
                animation-delay: .08s;
            }

            .attendance-page > *:nth-child(3) {
                animation-delay: .13s;
            }

            .attendance-page > *:nth-child(4) {
                animation-delay: .18s;
            }

            .attendance-page > *:nth-child(5) {
                animation-delay: .23s;
            }

            .attendance-page > *:nth-child(6) {
                animation-delay: .28s;
            }

    @@keyframes attendanceFadeUp {
        from

    {
        opacity: 0;
        transform: translateY(14px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }

    }

    /* =========================================
           HEADER
           ========================================= */

    .attendance-page-header {
        position: relative;
    }

    .attendance-page-title {
        color: var(--page-text);
        letter-spacing: -.02em;
    }

    .attendance-title-icon {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 38px;
        height: 38px;
        border-radius: 12px;
        background: rgba(13, 110, 253, .10);
        color: var(--page-primary);
        margin-right: 10px;
        vertical-align: middle;
        transition: transform .25s ease, box-shadow .25s ease;
    }

    .attendance-page-header:hover .attendance-title-icon {
        transform: rotate(-6deg) scale(1.06);
        box-shadow: 0 8px 18px rgba(13, 110, 253, .14);
    }

    .attendance-page .breadcrumb-item a {
        color: var(--page-primary);
        transition: color .2s ease;
    }

        .attendance-page .breadcrumb-item a:hover {
            color: #084298;
        }

    /* =========================================
           BUTTONS
           ========================================= */

    .attendance-page .btn {
        transition: transform .2s ease, box-shadow .2s ease, background-color .2s ease, border-color .2s ease;
    }

        .attendance-page .btn:hover {
            transform: translateY(-2px);
        }

        .attendance-page .btn:active {
            transform: translateY(0) scale(.97);
        }

    .attendance-primary-btn {
        box-shadow: 0 8px 18px rgba(13, 110, 253, .16);
    }

        .attendance-primary-btn:hover {
            box-shadow: 0 12px 25px rgba(13, 110, 253, .24) !important;
        }

    /* =========================================
           ALERTS
           ========================================= */

    .attendance-alert {
        border: 1px solid rgba(0, 0, 0, .04);
        animation: attendanceFadeDown .45s ease both;
    }

    @@keyframes attendanceFadeDown {
        from

    {
        opacity: 0;
        transform: translateY(-10px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }

    }

    /* =========================================
           STATISTICS CARDS
           ========================================= */

    .attendance-stat-card {
        position: relative;
        overflow: hidden;
        border-radius: 16px !important;
        transition: transform .28s ease, box-shadow .28s ease;
    }

        .attendance-stat-card::before {
            content: "";
            position: absolute;
            top: 0;
            left: -110%;
            width: 60%;
            height: 100%;
            background: linear-gradient( 90deg, transparent, rgba(255, 255, 255, .65), transparent );
            transform: skewX(-18deg);
            transition: left .65s ease;
            pointer-events: none;
        }

        .attendance-stat-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 16px 32px rgba(15, 23, 42, .10) !important;
        }

            .attendance-stat-card:hover::before {
                left: 150%;
            }

        .attendance-stat-card:nth-child(1) {
            animation-delay: .12s;
        }

    .attendance-stat-label {
        letter-spacing: .045em;
    }

    .attendance-stat-number {
        letter-spacing: -.04em;
    }

    .attendance-stat-icon {
        width: 52px;
        height: 52px;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: transform .28s ease;
        flex-shrink: 0;
    }

    .attendance-stat-card:hover .attendance-stat-icon {
        transform: scale(1.08) rotate(-5deg);
    }

    /* =========================================
           FILTER PANEL
           ========================================= */

    .attendance-filter-panel {
        border: 1px solid var(--page-border) !important;
        border-radius: 16px !important;
        transition: box-shadow .25s ease;
    }

        .attendance-filter-panel:hover {
            box-shadow: 0 12px 30px rgba(15, 23, 42, .06) !important;
        }

    .attendance-filter-icon {
        width: 36px;
        height: 36px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 10px;
        background: rgba(13, 110, 253, .09);
        color: var(--page-primary);
    }

    .attendance-filter-heading {
        font-size: .82rem;
        letter-spacing: .03em;
    }

    /* =========================================
           FORM CONTROLS
           ========================================= */

    .attendance-page .form-control,
    .attendance-page .form-select,
    .attendance-page .input-group-text {
        border-color: var(--page-border);
    }

    .attendance-page .form-control,
    .attendance-page .form-select {
        transition: border-color .2s ease, box-shadow .2s ease, transform .2s ease;
    }

        .attendance-page .form-control:focus,
        .attendance-page .form-select:focus {
            border-color: rgba(13, 110, 253, .55);
            box-shadow: 0 0 0 .22rem rgba(13, 110, 253, .10);
        }

    .attendance-page .input-group:focus-within {
        border-radius: .375rem;
        box-shadow: 0 0 0 .22rem rgba(13, 110, 253, .08);
    }

        .attendance-page .input-group:focus-within .form-control,
        .attendance-page .input-group:focus-within .input-group-text {
            border-color: rgba(13, 110, 253, .55);
        }

    /* =========================================
           TABLE SECTION
           ========================================= */

    .attendance-table-card {
        border: 1px solid var(--page-border) !important;
        border-radius: 18px !important;
        overflow: hidden;
        transition: box-shadow .28s ease;
    }

        .attendance-table-card:hover {
            box-shadow: 0 15px 35px rgba(15, 23, 42, .07) !important;
        }

    .attendance-table-header {
        padding-bottom: 16px;
        border-bottom: 1px solid #f0f1f3;
    }

    .attendance-record-count {
        padding: .48rem .75rem;
        border-radius: 999px;
        transition: transform .2s ease;
    }

        .attendance-record-count:hover {
            transform: scale(1.04);
        }

    .attendance-page table {
        border-collapse: separate;
        border-spacing: 0;
    }

    .attendance-page .table thead th {
        white-space: nowrap;
        background: #f8fafc;
        color: #64748b;
        font-size: .73rem;
        letter-spacing: .04em;
        text-transform: uppercase;
        font-weight: 700;
        border-bottom: 1px solid #e9ecef;
        padding-top: .9rem;
        padding-bottom: .9rem;
    }

    .attendance-page .table tbody tr {
        transition: background-color .2s ease, transform .2s ease, box-shadow .2s ease;
    }

        .attendance-page .table tbody tr:not(.attendance-empty-row):hover {
            background: rgba(13, 110, 253, .025);
            transform: scale(1.002);
            box-shadow: inset 3px 0 0 var(--page-primary);
        }

    .attendance-page .table td {
        border-color: #f0f1f3;
        padding-top: .9rem;
        padding-bottom: .9rem;
        vertical-align: middle;
    }

    .attendance-employee-code {
        font-family: monospace;
        color: #334155;
        background: #f8fafc;
        padding: .35rem .55rem;
        border-radius: 8px;
        display: inline-block;
        border: 1px solid #eef0f2;
    }

    .attendance-time {
        font-variant-numeric: tabular-nums;
        white-space: nowrap;
    }

    .attendance-work-hours {
        display: inline-flex;
        align-items: center;
        gap: .35rem;
        padding: .35rem .6rem;
        background: #f8fafc;
        border: 1px solid #eef0f2;
        border-radius: 8px;
        font-size: .8rem;
    }

    /* =========================================
           BADGES
           ========================================= */

    .attendance-page .badge {
        font-weight: 600;
        transition: transform .18s ease;
    }

        .attendance-page .badge:hover {
            transform: translateY(-1px);
        }

    .attendance-status-badge {
        padding: .5rem .72rem;
        box-shadow: 0 2px 6px rgba(15, 23, 42, .04);
        white-space: nowrap;
    }

    .attendance-source-badge {
        padding: .45rem .65rem;
        white-space: nowrap;
    }

    /* =========================================
           EMPTY STATE
           ========================================= */

    .attendance-empty-state {
        padding: 3rem 1rem !important;
    }

    .attendance-empty-icon {
        width: 62px;
        height: 62px;
        margin: 0 auto 1rem;
        border-radius: 50%;
        background: #f8fafc;
        display: flex;
        align-items: center;
        justify-content: center;
        animation: attendanceFloat 3s ease-in-out infinite;
    }

    @@keyframes attendanceFloat {
        0%, 100%

    {
        transform: translateY(0);
    }

    50% {
        transform: translateY(-5px);
    }

    }

    /* =========================================
           MODAL
           ========================================= */

    .attendance-page-modal .modal-content {
        border-radius: 18px !important;
        overflow: hidden;
    }

    .attendance-page-modal .modal-dialog {
        transition: transform .25s ease;
    }

    .attendance-page-modal .modal-header {
        background: linear-gradient(135deg, #f8fafc, #ffffff) !important;
    }

    .attendance-page-modal .modal-footer {
        background: #fafbfc !important;
    }

    .attendance-page-modal .form-label {
        letter-spacing: .015em;
    }

    /* =========================================
           RESPONSIVE
           ========================================= */

    @@media (max-width: 767.98px) {
        .attendance-page

    {
        padding-top: 1rem !important;
    }

    .attendance-page-title {
        font-size: 1.2rem;
    }

    .attendance-title-icon {
        width: 34px;
        height: 34px;
        border-radius: 10px;
    }

    .attendance-stat-card {
        border-radius: 14px !important;
    }

    .attendance-filter-panel,
    .attendance-table-card {
        padding: 1rem !important;
        border-radius: 14px !important;
    }

    .attendance-table-header {
        align-items: flex-start !important;
        flex-direction: column;
        gap: .75rem;
    }

    }

    /* =========================================
           REDUCED MOTION ACCESSIBILITY
           ========================================= */

    @@media (prefers-reduced-motion: reduce) {
        *, *::before, *::after

    {
        animation-duration: .01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: .01ms !important;
        scroll-behavior: auto !important;
    }

    }
</style>

<div class="container-fluid py-4 text-start attendance-page">

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3 shadow-sm mb-4 attendance-alert" role="alert">
            <i class="fa-solid fa-circle-check me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-3 shadow-sm mb-4 attendance-alert" role="alert">
            <i class="fa-solid fa-triangle-exclamation me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Header -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4 attendance-page-header">
        <div>
            <h4 class="fw-bold mb-1 attendance-page-title">
                <span class="attendance-title-icon">
                    <i class="fa-solid fa-calendar-check"></i>
                </span>
                Daily Attendance Logs
            </h4>

            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0 small">
                    <li class="breadcrumb-item">
                        <a href="/HR" class="text-decoration-none">HR Dashboard</a>
                    </li>
                    <li class="breadcrumb-item active" aria-current="page">
                        Daily Attendance Logs
                    </li>
                </ol>
            </nav>
        </div>

        <div class="d-flex align-items-center gap-2">
            <button type="button"
                    class="btn btn-primary rounded-pill btn-sm px-3 attendance-primary-btn"
                    data-bs-toggle="modal"
                    data-bs-target="#manualPunchModal">
                <i class="fa-solid fa-plus me-1.5"></i>
                Manual Punch / Log
            </button>
        </div>
    </div>

    <!-- Statistics Cards -->
    <div class="row g-3 mb-4">

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm bg-white p-3 border-start border-4 border-success attendance-stat-card">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted small fw-semibold text-uppercase attendance-stat-label">
                            Present (On Time)
                        </div>
                        <h3 class="fw-bold text-dark mb-0 mt-1 attendance-stat-number">
                            @Model.TotalPresent
                        </h3>
                    </div>

                    <div class="rounded-circle bg-success bg-opacity-10 text-success attendance-stat-icon">
                        <i class="fa-solid fa-user-check fa-lg"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm bg-white p-3 border-start border-4 border-warning attendance-stat-card">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted small fw-semibold text-uppercase attendance-stat-label">
                            Late Check-ins
                        </div>
                        <h3 class="fw-bold text-dark mb-0 mt-1 attendance-stat-number">
                            @Model.TotalLate
                        </h3>
                    </div>

                    <div class="rounded-circle bg-warning bg-opacity-10 text-warning attendance-stat-icon">
                        <i class="fa-solid fa-clock-rotate-left fa-lg"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm bg-white p-3 border-start border-4 border-info attendance-stat-card">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted small fw-semibold text-uppercase attendance-stat-label">
                            On Leave
                        </div>
                        <h3 class="fw-bold text-dark mb-0 mt-1 attendance-stat-number">
                            @Model.TotalOnLeave
                        </h3>
                    </div>

                    <div class="rounded-circle bg-info bg-opacity-10 text-info attendance-stat-icon">
                        <i class="fa-solid fa-umbrella-beach fa-lg"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm bg-white p-3 border-start border-4 border-danger attendance-stat-card">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted small fw-semibold text-uppercase attendance-stat-label">
                            Absent
                        </div>
                        <h3 class="fw-bold text-dark mb-0 mt-1 attendance-stat-number">
                            @Model.TotalAbsent
                        </h3>
                    </div>

                    <div class="rounded-circle bg-danger bg-opacity-10 text-danger attendance-stat-icon">
                        <i class="fa-solid fa-user-xmark fa-lg"></i>
                    </div>
                </div>
            </div>
        </div>

    </div>

    <!-- Automatic Filters -->
    <div class="bg-white p-3 shadow-sm mb-4 attendance-filter-panel">

        <div class="d-flex align-items-center gap-2 mb-3">
            <div class="attendance-filter-icon">
                <i class="fa-solid fa-sliders"></i>
            </div>

            <div>
                <div class="fw-bold text-dark attendance-filter-heading">
                    Attendance Filters
                </div>
                <div class="text-muted small">
                    Results update automatically when filters are changed.
                </div>
            </div>
        </div>

        <form method="get"
              asp-action="DailyLogs"
              id="attendanceFilterForm"
              class="row g-3 align-items-end">

            <!-- Date -->
            <div class="col-12 col-md-3">
                <label class="form-label small fw-bold text-secondary mb-1">
                    Filter Date
                </label>

                <input type="date"
                       name="selectedDate"
                       class="form-control form-control-sm"
                       value="@Model.SelectedDate.ToString("yyyy-MM-dd")"
                       onchange="submitAttendanceFilters()" />
            </div>

            <!-- Search -->
            <div class="col-12 col-md-4">
                <label class="form-label small fw-bold text-secondary mb-1">
                    Search Employee
                </label>

                <div class="input-group input-group-sm">
                    <span class="input-group-text bg-light">
                        <i class="fa-solid fa-magnifying-glass text-muted"></i>
                    </span>

                    <input type="text"
                           id="attendanceSearchInput"
                           name="searchTerm"
                           class="form-control"
                           placeholder="Search by name or employee code..."
                           value="@Model.SearchTerm"
                           autocomplete="off" />
                </div>
            </div>

            <!-- Status -->
            <div class="col-12 col-md-3">
                <label class="form-label small fw-bold text-secondary mb-1">
                    Status
                </label>

                <select name="statusFilter"
                        class="form-select form-select-sm"
                        onchange="submitAttendanceFilters()">

                    <option value="All" selected="@(Model.StatusFilter == "All")">
                        All Statuses
                    </option>

                    <option value="Present (On Time)"
                            selected="@(Model.StatusFilter == "Present (On Time)")">
                        Present (On Time)
                    </option>

                    <option value="Late Check-in"
                            selected="@(Model.StatusFilter == "Late Check-in")">
                        Late Check-in
                    </option>

                    <option value="On Leave"
                            selected="@(Model.StatusFilter == "On Leave")">
                        On Leave
                    </option>

                    <option value="Absent"
                            selected="@(Model.StatusFilter == "Absent")">
                        Absent
                    </option>
                </select>
            </div>

            <!-- Filter Information -->
            <div class="col-12 col-md-2">
                <div class="small text-muted border-start ps-3">
                    <i class="fa-solid fa-bolt text-primary me-1"></i>
                    Auto filter enabled
                </div>
            </div>

        </form>
    </div>

    <!-- Attendance Table -->
    <div class="bg-white p-4 shadow-sm attendance-table-card">

        <div class="d-flex justify-content-between align-items-center mb-3 attendance-table-header">

            <div>
                <h6 class="fw-bold mb-1 text-dark">
                    Attendance Logs for
                    <span class="text-primary">
                        @Model.SelectedDate.ToString("dd MMMM yyyy")
                    </span>
                </h6>

                <div class="small text-muted">
                    Employee attendance, work hours and punch information.
                </div>
            </div>

            <span class="badge bg-light text-dark border attendance-record-count">
                <i class="fa-solid fa-list me-1 text-primary"></i>
                Total Records: @Model.Logs.Count
            </span>
        </div>

        <div class="table-responsive">

            <table class="table table-hover align-middle mb-0" style="font-size: 0.85rem;">

                <thead>
                    <tr>
                        <th>Employee ID</th>
                        <th>Employee Name</th>
                        <th>Check-in Time</th>
                        <th>Check-out Time</th>
                        <th>Total Hours Worked</th>
                        <th>Punch Source</th>
                        <th>Status</th>
                        <th>Remarks</th>
                    </tr>
                </thead>

                <tbody>

                    @if (Model.Logs.Any())
                    {
                        foreach (var log in Model.Logs)
                        {
                            <tr>

                                <td>
                                    <span class="attendance-employee-code fw-bold">
                                        @log.EmployeeCode
                                    </span>
                                </td>

                                <td class="fw-semibold text-dark">
                                    @log.EmployeeName
                                </td>

                                <td class="attendance-time">
                                    @if (log.CheckInTime.HasValue)
                                    {
                                        <span class="text-success fw-semibold">
                                            <i class="fa-solid fa-arrow-right-to-bracket me-1 small"></i>
                                            @log.CheckInTime.Value.ToString("hh:mm tt")
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">--:--</span>
                                    }
                                </td>

                                <td class="attendance-time">
                                    @if (log.CheckOutTime.HasValue)
                                    {
                                        <span class="text-danger fw-semibold">
                                            <i class="fa-solid fa-arrow-right-from-bracket me-1 small"></i>
                                            @log.CheckOutTime.Value.ToString("hh:mm tt")
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">--:--</span>
                                    }
                                </td>

                                <td>
                                    <span class="attendance-work-hours fw-semibold text-dark">
                                        <i class="fa-solid fa-hourglass-half text-primary small"></i>
                                        @log.WorkHours
                                    </span>
                                </td>

                                <td>
                                    <span class="badge bg-light text-secondary border attendance-source-badge">
                                        <i class="fa-solid fa-fingerprint me-1"></i>
                                        @log.PunchSource
                                    </span>
                                </td>

                                <td>
                                    @if (log.Status.StartsWith("Present"))
                                    {
                                        <span class="badge bg-success-subtle text-success rounded-pill attendance-status-badge">
                                            <i class="fa-solid fa-circle-check me-1"></i>
                                            @log.Status
                                        </span>
                                    }
                                    else if (log.Status.Contains("Late"))
                                    {
                                        <span class="badge bg-warning-subtle text-warning rounded-pill attendance-status-badge">
                                            <i class="fa-solid fa-clock me-1"></i>
                                            @log.Status
                                        </span>
                                    }
                                    else if (log.Status.Contains("Leave"))
                                    {
                                        <span class="badge bg-info-subtle text-info rounded-pill attendance-status-badge">
                                            <i class="fa-solid fa-umbrella-beach me-1"></i>
                                            @log.Status
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger-subtle text-danger rounded-pill attendance-status-badge">
                                            <i class="fa-solid fa-circle-xmark me-1"></i>
                                            @log.Status
                                        </span>
                                    }
                                </td>

                                <td class="text-muted small">
                                    @(string.IsNullOrEmpty(log.Remarks) ? "-" : log.Remarks)
                                </td>

                            </tr>
                        }
                    }
                    else
                    {
                        <tr class="attendance-empty-row">
                            <td colspan="8" class="text-center text-muted attendance-empty-state">

                                <div class="attendance-empty-icon">
                                    <i class="fa-solid fa-inbox fa-xl text-secondary opacity-50"></i>
                                </div>

                                <div class="fw-semibold text-dark mb-1">
                                    No Attendance Records Found
                                </div>

                                <div class="small text-muted">
                                    No attendance records are available for the selected date and filters.
                                </div>

                            </td>
                        </tr>
                    }

                </tbody>
            </table>

        </div>
    </div>

</div>

<!-- Manual Punch Modal -->
<div class="modal fade attendance-page-modal"
     id="manualPunchModal"
     tabindex="-1"
     aria-labelledby="manualPunchModalLabel"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content border-0 shadow">

            <div class="modal-header border-bottom px-4 py-3">

                <h5 class="modal-title fw-bold" id="manualPunchModalLabel">
                    <i class="fa-solid fa-user-clock text-primary me-2"></i>
                    Manual Attendance Punch
                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Close">
                </button>

            </div>

            <form asp-action="ManualPunch" method="post">

                @Html.AntiForgeryToken()

                <div class="modal-body p-4">

                    <div class="mb-3">
                        <label class="form-label small fw-bold text-secondary">
                            Select Employee
                        </label>

                        <select name="userId" class="form-select" required>
                            <option value="">-- Choose Employee --</option>

                            @foreach (var emp in Model.Employees)
                            {
                                <option value="@emp.UserId">
                                    @emp.FullName
                                    (@(string.IsNullOrEmpty(emp.UserCode) ? $"EMP-00{emp.UserId}" : emp.UserCode))
                                </option>
                            }
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-bold text-secondary">
                            Date
                        </label>

                        <input type="date"
                               name="date"
                               class="form-control"
                               value="@DateTime.Today.ToString("yyyy-MM-dd")"
                               required />
                    </div>

                    <div class="row g-3 mb-3">

                        <div class="col-12 col-sm-6">
                            <label class="form-label small fw-bold text-secondary">
                                Check-in Time
                            </label>

                            <input type="time"
                                   name="checkInTime"
                                   class="form-control"
                                   value="09:00"
                                   required />
                        </div>

                        <div class="col-12 col-sm-6">
                            <label class="form-label small fw-bold text-secondary">
                                Check-out Time
                            </label>

                            <input type="time"
                                   name="checkOutTime"
                                   class="form-control"
                                   value="18:00" />
                        </div>

                    </div>

                    <div class="row g-3 mb-3">

                        <div class="col-12 col-sm-6">

                            <label class="form-label small fw-bold text-secondary">
                                Punch Source
                            </label>

                            <select name="punchSource" class="form-select">

                                <option value="Manual Entry">
                                    Manual Entry
                                </option>

                                <option value="Biometric Device 1">
                                    Biometric Device 1
                                </option>

                                <option value="Geo-Punch App">
                                    Geo-Punch App
                                </option>

                                <option value="RFID Gateway">
                                    RFID Gateway
                                </option>

                            </select>

                        </div>

                        <div class="col-12 col-sm-6">

                            <label class="form-label small fw-bold text-secondary">
                                Status
                            </label>

                            <select name="status" class="form-select">

                                <option value="Present (On Time)">
                                    Present (On Time)
                                </option>

                                <option value="Late Check-in">
                                    Late Check-in
                                </option>

                                <option value="Early Departure">
                                    Early Departure
                                </option>

                                <option value="Half Day">
                                    Half Day
                                </option>

                                <option value="Absent">
                                    Absent
                                </option>

                                <option value="On Leave">
                                    On Leave
                                </option>

                            </select>

                        </div>

                    </div>

                    <div class="mb-2">

                        <label class="form-label small fw-bold text-secondary">
                            Remarks / Justification
                        </label>

                        <textarea name="remarks"
                                  class="form-control"
                                  rows="3"
                                  placeholder="e.g. Approved manual correction by HR">
                        </textarea>

                    </div>

                </div>

                <div class="modal-footer border-top px-4 py-3">

                    <button type="button"
                            class="btn btn-secondary btn-sm rounded-pill px-3"
                            data-bs-dismiss="modal">
                        Cancel
                    </button>

                    <button type="submit"
                            class="btn btn-primary btn-sm rounded-pill px-4 attendance-primary-btn">
                        <i class="fa-solid fa-save me-1"></i>
                        Save Attendance Log
                    </button>

                </div>

            </form>

        </div>
    </div>
</div>

<script>
    // Automatic filter form submission
    function submitAttendanceFilters() {
        document.getElementById("attendanceFilterForm").submit();
    }

    // Automatic search with small delay to avoid submitting on every key instantly
    document.addEventListener("DOMContentLoaded", function () {

        const searchInput = document.getElementById("attendanceSearchInput");
        let searchTimer;

        if (searchInput) {

            searchInput.addEventListener("input", function () {

                clearTimeout(searchTimer);

                searchTimer = setTimeout(function () {
                    submitAttendanceFilters();
                }, 600);

            });

        }

    });
</script>
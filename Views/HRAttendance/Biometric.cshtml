@model ERP_System.Models.BiometricViewModel
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Biometric & Geo-Punches";
}

<style>
    /* =========================================
           BIOMETRIC & GEO-PUNCHES - PREMIUM ERP UI
           ========================================= */

    :root {
        --bio-primary: var(--primary-warm, #0d6efd);
        --bio-primary-dark: #0b5ed7;
        --bio-border: var(--border-warm, #e8eaed);
        --bio-text: var(--text-color, #202124);
        --bio-muted: #6c757d;
        --bio-card: #ffffff;
        --bio-bg: #f8f9fa;
    }

    /* Page Entrance */
    .biometric-page {
        animation: biometricPageEnter .6s ease-out both;
    }

    @@keyframes biometricPageEnter {
        from {
            opacity: 0;
            transform: translateY(16px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* Header */
    .biometric-header {
        animation: biometricFadeUp .55s ease-out both;
    }

    .biometric-title {
        color: var(--bio-text);
        letter-spacing: -.4px;
    }

    .biometric-title-icon {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        transition: transform .3s ease;
    }

    .biometric-header:hover .biometric-title-icon {
        transform: scale(1.08) rotate(-4deg);
    }

    .breadcrumb-item a {
        color: var(--bio-primary);
        transition: color .2s ease;
    }

        .breadcrumb-item a:hover {
            color: var(--bio-primary-dark);
        }

    /* Buttons */
    .bio-btn {
        position: relative;
        overflow: hidden;
        transition: transform .2s ease, box-shadow .2s ease, background-color .2s ease, border-color .2s ease;
    }

        .bio-btn::before {
            content: "";
            position: absolute;
            top: 0;
            left: -130%;
            width: 55%;
            height: 100%;
            background: rgba(255, 255, 255, .20);
            transform: skewX(-25deg);
            transition: left .55s ease;
        }

        .bio-btn:hover::before {
            left: 150%;
        }

        .bio-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 7px 18px rgba(0, 0, 0, .10);
        }

        .bio-btn:active {
            transform: translateY(0) scale(.97);
        }

    .bio-btn-primary:hover {
        box-shadow: 0 8px 20px rgba(13, 110, 253, .22) !important;
    }

    /* Sync Button Animation */
    .bio-sync-icon {
        transition: transform .35s ease;
    }

    .bio-sync-btn:hover .bio-sync-icon {
        transform: rotate(180deg);
    }

    /* Alert */
    .bio-alert {
        border-color: var(--bio-border);
        animation: biometricAlertIn .45s ease-out both;
        transition: transform .2s ease, box-shadow .2s ease;
    }

        .bio-alert:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 24px rgba(0, 0, 0, .07) !important;
        }

    @@keyframes biometricAlertIn {
        from {
            opacity: 0;
            transform: translateY(-12px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* Statistics Cards */
    .bio-stat-card {
        position: relative;
        overflow: hidden;
        background: var(--bio-card);
        transition: transform .25s ease, box-shadow .25s ease, border-color .25s ease;
        animation: biometricFadeUp .55s ease-out both;
    }

        .bio-stat-card::after {
            content: "";
            position: absolute;
            width: 130px;
            height: 130px;
            border-radius: 50%;
            top: -65px;
            right: -65px;
            background: rgba(13, 110, 253, .025);
            transition: transform .45s ease;
        }

        .bio-stat-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 15px 32px rgba(0, 0, 0, .09) !important;
        }

            .bio-stat-card:hover::after {
                transform: scale(1.35);
            }

        .bio-stat-card:nth-child(1) {
            animation-delay: .05s;
        }

        .bio-stat-card:nth-child(2) {
            animation-delay: .1s;
        }

        .bio-stat-card:nth-child(3) {
            animation-delay: .15s;
        }

    .bio-stat-icon {
        position: relative;
        z-index: 2;
        transition: transform .25s ease;
    }

    .bio-stat-card:hover .bio-stat-icon {
        transform: scale(1.09) rotate(-4deg);
    }

    .bio-stat-number {
        letter-spacing: -.7px;
        transition: transform .25s ease;
    }

    .bio-stat-card:hover .bio-stat-number {
        transform: translateX(3px);
    }

    /* Status Dot */
    .bio-status-dot {
        position: relative;
        display: inline-block;
        width: 8px;
        height: 8px;
        margin-right: 5px;
        border-radius: 50%;
        background: currentColor;
        vertical-align: middle;
    }

        .bio-status-dot.online {
            animation: biometricPulse 1.8s ease-in-out infinite;
        }

    @@keyframes biometricPulse {
        0%,
        100% {
            box-shadow: 0 0 0 0 rgba(25, 135, 84, .35);
        }

        50% {
            box-shadow: 0 0 0 6px rgba(25, 135, 84, 0);
        }
    }

    /* Panels */
    .bio-panel {
        position: relative;
        background: var(--bio-card);
        border-color: var(--bio-border) !important;
        transition: box-shadow .25s ease, transform .25s ease;
        animation: biometricFadeUp .6s ease-out both;
    }

        .bio-panel:hover {
            box-shadow: 0 12px 30px rgba(0, 0, 0, .055) !important;
        }

    .bio-devices-panel {
        animation-delay: .18s;
    }

    .bio-live-panel {
        animation-delay: .25s;
    }

    @@keyframes biometricFadeUp {
        from {
            opacity: 0;
            transform: translateY(18px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* Panel Top Accent */
    .bio-panel-accent::before {
        content: "";
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 3px;
        background: linear-gradient( 90deg, var(--bio-primary), rgba(13, 110, 253, .35), transparent );
    }

    .bio-panel-title {
        color: var(--bio-text);
    }

    .bio-device-count {
        background: rgba(13, 110, 253, .05) !important;
        border-color: rgba(13, 110, 253, .14) !important;
        transition: transform .2s ease, box-shadow .2s ease;
    }

        .bio-device-count:hover {
            transform: translateY(-1px);
            box-shadow: 0 5px 12px rgba(13, 110, 253, .08);
        }

    /* Table */
    .bio-table {
        border-collapse: separate;
        border-spacing: 0;
    }

        .bio-table thead th {
            background: #f8f9fa;
            color: #68707a;
            font-size: .72rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: .45px;
            white-space: nowrap;
            padding-top: .9rem;
            padding-bottom: .9rem;
            border-bottom-color: var(--bio-border);
        }

        .bio-table tbody tr {
            transition: background-color .2s ease, transform .2s ease, box-shadow .2s ease;
            animation: biometricRowIn .4s ease-out both;
        }

            .bio-table tbody tr:nth-child(1) {
                animation-delay: .03s;
            }

            .bio-table tbody tr:nth-child(2) {
                animation-delay: .06s;
            }

            .bio-table tbody tr:nth-child(3) {
                animation-delay: .09s;
            }

            .bio-table tbody tr:nth-child(4) {
                animation-delay: .12s;
            }

            .bio-table tbody tr:nth-child(5) {
                animation-delay: .15s;
            }

            .bio-table tbody tr:nth-child(n+6) {
                animation-delay: .18s;
            }

    @@keyframes biometricRowIn {
        from {
            opacity: 0;
            transform: translateX(-8px);
        }

        to {
            opacity: 1;
            transform: translateX(0);
        }
    }

    .bio-table tbody tr:hover {
        background-color: rgba(13, 110, 253, .025);
        transform: translateX(2px);
        box-shadow: inset 3px 0 0 var(--bio-primary);
    }

    .bio-table td {
        padding-top: .9rem;
        padding-bottom: .9rem;
        vertical-align: middle;
        border-bottom-color: #f0f1f3;
    }

    /* Device Name */
    .bio-device-name {
        transition: color .2s ease;
    }

    .bio-table tbody tr:hover .bio-device-name {
        color: var(--bio-primary) !important;
    }

    .bio-device-icon {
        display: inline-flex;
        width: 28px;
        height: 28px;
        align-items: center;
        justify-content: center;
        border-radius: 8px;
        background: rgba(13, 110, 253, .08);
        transition: transform .25s ease, background-color .25s ease;
    }

    .bio-table tbody tr:hover .bio-device-icon {
        transform: rotate(-5deg) scale(1.08);
        background: rgba(13, 110, 253, .12);
    }

    /* Code */
    .bio-code {
        color: var(--bio-text);
        background: #f8f9fa;
        border: 1px solid #eef0f2;
        border-radius: 7px;
        padding: .22rem .45rem;
        transition: background-color .2s ease, border-color .2s ease;
    }

    .bio-table tbody tr:hover .bio-code {
        background: rgba(13, 110, 253, .05);
        border-color: rgba(13, 110, 253, .12);
    }

    /* Badges */
    .bio-status-badge,
    .bio-source-badge {
        white-space: nowrap;
        transition: transform .2s ease, box-shadow .2s ease;
    }

        .bio-status-badge:hover,
        .bio-source-badge:hover {
            transform: translateY(-1px) scale(1.03);
            box-shadow: 0 4px 10px rgba(0, 0, 0, .06);
        }

    /* Toggle Button */
    .bio-device-toggle {
        transition: transform .2s ease, box-shadow .2s ease, border-color .2s ease;
    }

        .bio-device-toggle:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 14px rgba(0, 0, 0, .08);
        }

        .bio-device-toggle:active {
            transform: scale(.97);
        }

    /* Live Stream Indicator */
    .bio-live-indicator {
        position: relative;
        display: inline-flex;
        align-items: center;
        gap: 7px;
        font-size: .73rem;
        font-weight: 600;
        color: #198754;
        background: rgba(25, 135, 84, .07);
        border: 1px solid rgba(25, 135, 84, .12);
        border-radius: 999px;
        padding: .3rem .65rem;
    }

        .bio-live-indicator::before {
            content: "";
            width: 7px;
            height: 7px;
            border-radius: 50%;
            background: #198754;
            animation: biometricLivePulse 1.6s ease-in-out infinite;
        }

    @@keyframes biometricLivePulse {
        0%,
        100% {
            opacity: 1;
            box-shadow: 0 0 0 0 rgba(25, 135, 84, .35);
        }

        50% {
            opacity: .7;
            box-shadow: 0 0 0 5px rgba(25, 135, 84, 0);
        }
    }

    /* Empty State */
    .bio-empty-state {
        padding: 2rem 1rem !important;
    }

    .bio-empty-state-icon {
        animation: biometricFloat 2.8s ease-in-out infinite;
    }

    @@keyframes biometricFloat {
        0%,
        100% {
            transform: translateY(0);
        }

        50% {
            transform: translateY(-6px);
        }
    }

    /* Modal */
    .bio-modal .modal-content {
        overflow: hidden;
        transition: box-shadow .25s ease;
    }

    .bio-modal.show .modal-dialog {
        animation: biometricModalIn .3s ease-out both;
    }

    @@keyframes biometricModalIn {
        from {
            opacity: 0;
            transform: translateY(-18px) scale(.98);
        }

        to {
            opacity: 1;
            transform: translateY(0) scale(1);
        }
    }

    .bio-modal .modal-header {
        background: linear-gradient( 135deg, rgba(13, 110, 253, .06), rgba(255, 255, 255, 1) );
    }

    .bio-modal .modal-footer {
        background: #fbfbfc;
    }

    .bio-modal .form-control {
        transition: border-color .2s ease, box-shadow .2s ease, transform .2s ease;
    }

        .bio-modal .form-control:focus {
            border-color: rgba(13, 110, 253, .55);
            box-shadow: 0 0 0 .2rem rgba(13, 110, 253, .10);
            transform: translateY(-1px);
        }

    /* Sync Loading */
    .biometric-page.is-syncing .bio-panel,
    .biometric-page.is-syncing .bio-stat-card {
        opacity: .72;
        transition: opacity .2s ease;
    }

    .bio-syncing-text {
        display: none;
    }

    .is-syncing .bio-sync-default {
        display: none;
    }

    .is-syncing .bio-syncing-text {
        display: inline-flex;
        align-items: center;
    }

    .is-syncing .bio-sync-icon {
        animation: biometricSpin .8s linear infinite;
    }

    @@keyframes biometricSpin {
        to {
            transform: rotate(360deg);
        }
    }

    /* Responsive */
    @@media (max-width: 767.98px) {
        .biometric-page {
            padding-top: 1.25rem !important;
        }

        .biometric-header .bio-actions {
            width: 100%;
        }

            .biometric-header .bio-actions > * {
                flex: 1;
            }

        .bio-stat-card:hover,
        .bio-table tbody tr:hover {
            transform: none;
        }

        .bio-panel {
            padding: 1rem !important;
        }

        .bio-table th,
        .bio-table td {
            white-space: nowrap;
        }
    }

    /* Reduced Motion Accessibility */
    @@media (prefers-reduced-motion: reduce) {
        *,
        *::before,
        *::after {
            animation-duration: .01ms !important;
            animation-iteration-count: 1 !important;
            transition-duration: .01ms !important;
            scroll-behavior: auto !important;
        }
    }
</style>

<div class="container-fluid py-4 text-start biometric-page" id="biometricPage">

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3 shadow-sm mb-4 bio-alert" role="alert">
            <i class="fa-solid fa-circle-check me-2"></i>@TempData["SuccessMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Close">
            </button>
        </div>
    }

    <!-- Header & Action Controls -->
    <div class="biometric-header d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">

        <div>
            <h4 class="biometric-title fw-bold mb-1">
                <i class="fa-solid fa-fingerprint biometric-title-icon text-primary me-2"></i>
                Biometric & Geo-Punches
            </h4>

            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0 small">
                    <li class="breadcrumb-item">
                        <a href="/HR" class="text-decoration-none">
                            HR Dashboard
                        </a>
                    </li>

                    <li class="breadcrumb-item active" aria-current="page">
                        Biometric & Geo-Punches
                    </li>
                </ol>
            </nav>
        </div>

        <div class="bio-actions d-flex align-items-center gap-2">

            <button type="button"
                    class="btn btn-outline-secondary rounded-pill btn-sm px-3 bio-btn"
                    data-bs-toggle="modal"
                    data-bs-target="#addDeviceModal">
                <i class="fa-solid fa-plus me-1"></i>
                Add Device
            </button>

            <form asp-action="SyncNow" method="post" class="d-inline bio-sync-form">
                @Html.AntiForgeryToken()

                <button type="submit"
                        class="btn btn-primary rounded-pill btn-sm px-3 shadow-sm bio-btn bio-btn-primary bio-sync-btn">

                    <span class="bio-sync-default">
                        <i class="fa-solid fa-arrows-rotate bio-sync-icon me-1.5"></i>
                        Sync Logs Now
                    </span>

                    <span class="bio-syncing-text">
                        <i class="fa-solid fa-arrows-rotate bio-sync-icon me-2"></i>
                        Syncing...
                    </span>

                </button>
            </form>

        </div>
    </div>

    <!-- Top Statistics Cards -->
    <div class="row g-3 mb-4">

        <div class="col-12 col-md-4">
            <div class="card bio-stat-card border-0 shadow-sm rounded-3 bg-white p-3 border-start border-4 border-primary">

                <div class="d-flex align-items-center justify-content-between">

                    <div>
                        <div class="text-muted small fw-semibold text-uppercase">
                            Active Devices
                        </div>

                        <h3 class="bio-stat-number fw-bold text-dark mb-0 mt-1">
                            @Model.ActiveDevicesCount / @Model.Devices.Count
                        </h3>
                    </div>

                    <div class="bio-stat-icon rounded-circle bg-primary bg-opacity-10 p-3 text-primary">
                        <i class="fa-solid fa-network-wired fa-lg"></i>
                    </div>

                </div>
            </div>
        </div>

        <div class="col-12 col-md-4">
            <div class="card bio-stat-card border-0 shadow-sm rounded-3 bg-white p-3 border-start border-4 border-success">

                <div class="d-flex align-items-center justify-content-between">

                    <div>
                        <div class="text-muted small fw-semibold text-uppercase">
                            Today's Synced Punches
                        </div>

                        <h3 class="bio-stat-number fw-bold text-dark mb-0 mt-1">
                            @Model.TotalPunchesToday
                        </h3>
                    </div>

                    <div class="bio-stat-icon rounded-circle bg-success bg-opacity-10 p-3 text-success">
                        <i class="fa-solid fa-id-card-clip fa-lg"></i>
                    </div>

                </div>
            </div>
        </div>

        <div class="col-12 col-md-4">
            <div class="card bio-stat-card border-0 shadow-sm rounded-3 bg-white p-3 border-start border-4 border-info">

                <div class="d-flex align-items-center justify-content-between">

                    <div>
                        <div class="text-muted small fw-semibold text-uppercase">
                            Geo-Punch Gateway
                        </div>

                        <h3 class="bio-stat-number fw-bold text-dark mb-0 mt-1">
                            Active (GPS)
                        </h3>
                    </div>

                    <div class="bio-stat-icon rounded-circle bg-info bg-opacity-10 p-3 text-info">
                        <i class="fa-solid fa-location-dot fa-lg"></i>
                    </div>

                </div>
            </div>
        </div>

    </div>

    <!-- Devices Status Grid -->
    <div class="bio-panel bio-panel-accent bio-devices-panel border rounded-3 p-4 shadow-sm mb-4">

        <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-2 mb-3">

            <h6 class="bio-panel-title fw-bold mb-0 text-secondary">
                <i class="fa-solid fa-server text-primary me-2"></i>
                Configured Biometric & Geo Hardware Terminals
            </h6>

            <span class="bio-device-count badge bg-light text-dark border rounded-pill px-3 py-2">
                @Model.Devices.Count Devices
            </span>

        </div>

        <div class="table-responsive">

            <table class="table bio-table table-hover align-middle mb-0"
                   style="font-size: 0.85rem;">

                <thead class="table-light">
                    <tr>
                        <th>Device Name</th>
                        <th>Device IP / Location</th>
                        <th>Connection Status</th>
                        <th>Last Log Sync</th>
                        <th>Synced Count Today</th>
                        <th class="text-center">Action</th>
                    </tr>
                </thead>

                <tbody>

                    @if (Model.Devices != null && Model.Devices.Any())
                    {
                        @foreach (var device in Model.Devices)
                        {
                            <tr>

                                <td class="bio-device-name fw-bold text-dark">
                                    <span class="bio-device-icon text-primary me-2">
                                        <i class="fa-solid fa-microchip"></i>
                                    </span>
                                    @device.DeviceName
                                </td>

                                <td>
                                    <code class="bio-code">
                                        @device.IpOrLocation
                                    </code>
                                </td>

                                <td>
                                    @if (device.ConnectionStatus == "Connected")
                                    {
                                        <span class="bio-status-badge badge bg-success-subtle text-success rounded-pill px-3 py-2">
                                            <span class="bio-status-dot online"></span>
                                            Connected
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="bio-status-badge badge bg-danger-subtle text-danger rounded-pill px-3 py-2">
                                            <span class="bio-status-dot"></span>
                                            Offline
                                        </span>
                                    }
                                </td>

                                <td class="text-muted">
                                    <i class="fa-regular fa-clock me-1"></i>
                                    @device.LastSyncTime.ToString("dd MMM yyyy hh:mm tt")
                                </td>

                                <td class="fw-semibold text-dark">
                                    <i class="fa-solid fa-arrows-rotate text-primary me-1 small"></i>
                                    @device.TodaySyncCount Punches
                                </td>

                                <td class="text-center">

                                    <form asp-action="ToggleDeviceStatus"
                                          method="post"
                                          class="d-inline">

                                        @Html.AntiForgeryToken()

                                        <input type="hidden"
                                               name="deviceId"
                                               value="@device.DeviceId" />

                                        <button type="submit"
                                                class="btn btn-outline-secondary btn-sm rounded-pill px-3 bio-device-toggle">
                                            <i class="fa-solid @(device.IsActive ? "fa-power-off" : "fa-plug-circle-check") me-1"></i>
                                            @(device.IsActive ? "Set Offline" : "Set Online")
                                        </button>

                                    </form>

                                </td>

                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6"
                                class="text-center text-muted bio-empty-state">

                                <i class="fa-solid fa-server fa-2x bio-empty-state-icon d-block mb-3 opacity-50"></i>

                                <strong class="d-block text-dark mb-1">
                                    No Biometric Devices Configured
                                </strong>

                                <span>
                                    Add a biometric or geo-punch device to begin syncing attendance data.
                                </span>

                            </td>
                        </tr>
                    }

                </tbody>

            </table>

        </div>
    </div>

    <!-- Live Punch Activity Log Stream -->
    <div class="bio-panel bio-panel-accent bio-live-panel border rounded-3 p-4 shadow-sm">

        <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-2 mb-3">

            <h6 class="bio-panel-title fw-bold mb-0 text-secondary">
                <i class="fa-solid fa-list-ol text-primary me-2"></i>
                Live Employee Punch Stream Today
            </h6>

            <span class="bio-live-indicator">
                Live Activity
            </span>

        </div>

        <div class="table-responsive">

            <table class="table bio-table table-hover align-middle mb-0"
                   style="font-size: 0.85rem;">

                <thead class="table-light">
                    <tr>
                        <th>Employee</th>
                        <th>Check-in Time</th>
                        <th>Check-out Time</th>
                        <th>Punch Source Terminal</th>
                        <th>Status</th>
                    </tr>
                </thead>

                <tbody>

                    @if (Model.LivePunches != null && Model.LivePunches.Any())
                    {
                        @foreach (var punch in Model.LivePunches)
                        {
                            <tr>

                                <td class="fw-bold text-dark">
                                    <i class="fa-solid fa-user text-primary me-2"></i>
                                    @punch.EmployeeName
                                </td>

                                <td>
                                    <span class="text-muted">
                                        <i class="fa-regular fa-clock me-1"></i>
                                        @(punch.CheckInTime.HasValue
                                                                        ? punch.CheckInTime.Value.ToString("hh:mm tt")
                                                                        : "--:--")
                                                                              </span>
                                                                          </td>

                                <td>
                                    <span class="text-muted">
                                        <i class="fa-regular fa-clock me-1"></i>
                                        @(punch.CheckOutTime.HasValue
                                                                        ? punch.CheckOutTime.Value.ToString("hh:mm tt")
                                                                        : "--:--")
                            </span>
                        </td>

                                <td>
                                    <span class="bio-source-badge badge bg-light text-secondary border px-3 py-2">
                                        <i class="fa-solid fa-fingerprint me-1"></i>
                                        @punch.PunchSource
                                    </span>
                                </td>

                                <td>

                            @if (punch.Status != null &&
                                                        punch.Status.Contains("Late"))
                                    {
                                        <span class="bio-status-badge badge bg-warning-subtle text-warning rounded-pill px-3 py-2">
                                            @punch.Status
                                        </span>
                                    }
                                    else if (punch.Status != null &&
                                    punch.Status.Contains("Absent"))
                                    {
                                        <span class="bio-status-badge badge bg-danger-subtle text-danger rounded-pill px-3 py-2">
                                            @punch.Status
                                        </span>
                                    }
                                    else if (punch.Status != null &&
                                    punch.Status.Contains("Leave"))
                                    {
                                        <span class="bio-status-badge badge bg-info-subtle text-info rounded-pill px-3 py-2">
                                            @punch.Status
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="bio-status-badge badge bg-success-subtle text-success rounded-pill px-3 py-2">
                                            <i class="fa-solid fa-circle-check me-1"></i>
                                            @punch.Status
                                        </span>
                                    }

                                </td>

                            </tr>
                        }
                    }
                    else
                    {
                        <tr>

                            <td colspan="5"
                                class="text-center text-muted bio-empty-state">

                                <i class="fa-solid fa-fingerprint fa-2x bio-empty-state-icon d-block mb-3 opacity-50"></i>

                                <strong class="d-block text-dark mb-1">
                                    No Live Punches Recorded Yet
                                </strong>

                                <span>
                                    Click "Sync Logs Now" above to fetch the latest biometric and geo-punch records.
                                </span>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>
    </div>

</div>

<!-- Add Device Modal -->
<div class="modal fade bio-modal"
     id="addDeviceModal"
     tabindex="-1"
     aria-labelledby="addDeviceModalLabel"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content rounded-3 border-0 shadow">

            <div class="modal-header border-bottom px-4 py-3">

                <h5 class="modal-title fw-bold" id="addDeviceModalLabel">
                    <i class="fa-solid fa-plus-circle text-primary me-2"></i>
                    Add Biometric Terminal
                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Close">
                </button>

            </div>

            <form asp-action="AddDevice" method="post">

                @Html.AntiForgeryToken()

                <div class="modal-body p-4">

                    <div class="mb-3">

                        <label class="form-label small fw-bold text-secondary">
                            Device Name
                        </label>

                        <input type="text"
                               name="deviceName"
                               class="form-control"
                               placeholder="e.g. Reception Facial Terminal"
                               required />

                    </div>

                    <div class="mb-2">

                        <label class="form-label small fw-bold text-secondary">
                            Device IP or Location Endpoint
                        </label>

                        <input type="text"
                               name="ipOrLocation"
                               class="form-control"
                               placeholder="e.g. 192.168.10.55 or Cloud API Gateway"
                               required />

                    </div>

                </div>

                <div class="modal-footer border-top px-4 py-3">

                    <button type="button"
                            class="btn btn-outline-secondary btn-sm rounded-pill px-3 bio-btn"
                            data-bs-dismiss="modal">
                        Cancel
                    </button>

                    <button type="submit"
                            class="btn btn-primary btn-sm rounded-pill px-4 bio-btn bio-btn-primary">

                        <i class="fa-solid fa-plug-circle-check me-1"></i>
                        Connect Device

                    </button>

                </div>

            </form>

        </div>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {

        const biometricPage = document.getElementById("biometricPage");
        const syncForm = document.querySelector(".bio-sync-form");
        const syncButton = document.querySelector(".bio-sync-btn");

        if (syncForm && syncButton) {
            syncForm.addEventListener("submit", function () {

                biometricPage.classList.add("is-syncing");

                syncButton.disabled = true;

            });
        }

    });
</script>
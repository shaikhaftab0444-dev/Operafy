@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Biometric & Geo-Punches";
}

<div class="container-fluid py-4 text-start">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-bold mb-1"><i class="fa-solid fa-fingerprint text-primary me-2"></i>Biometric & Geo-Punches</h4>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0 small">
                    <li class="breadcrumb-item"><a href="/HR" class="text-decoration-none">HR Dashboard</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Biometric & Geo-Punches</li>
                </ol>
            </nav>
        </div>
        <button class="btn btn-outline-primary btn-sm rounded-pill"><i class="fa-solid fa-arrows-rotate me-1.5"></i>Sync Logs Now</button>
    </div>

    <!-- Punch Sync Status Card -->
    <div class="bg-white border rounded-3 p-4 shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" style="font-size: 0.85rem;">
                <thead class="table-light">
                    <tr>
                        <th>Device Name</th>
                        <th>Device IP / Location</th>
                        <th>Connection Status</th>
                        <th>Last Log Sync</th>
                        <th>Synced Count Today</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td class="fw-bold text-dark">Floor 1 Fingerprint Reader</td>
                        <td>192.168.10.45</td>
                        <td><span class="badge bg-success-subtle text-success">Connected</span></td>
                        <td>20 Aug 2026 08:30 PM</td>
                        <td>145 Punches</td>
                    </tr>
                    <tr>
                        <td class="fw-bold text-dark">Floor 2 Facial Scanner</td>
                        <td>192.168.10.46</td>
                        <td><span class="badge bg-success-subtle text-success">Connected</span></td>
                        <td>20 Aug 2026 08:35 PM</td>
                        <td>88 Punches</td>
                    </tr>
                    <tr>
                        <td class="fw-bold text-dark">Mobile Geo-Punch Gateway</td>
                        <td>Cloud Services (GPS Bound)</td>
                        <td><span class="badge bg-success-subtle text-success">Connected</span></td>
                        <td>20 Aug 2026 08:45 PM</td>
                        <td>54 Punches</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

@model ERP_System.Models.OvertimeViewModel
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Overtime Tracker";
}

<style>
    /* =========================================================
           OVERTIME TRACKER - PREMIUM ERP UI
           ========================================================= */

    :root {
        --ot-primary: #2563eb;
        --ot-primary-dark: #1d4ed8;
        --ot-success: #10b981;
        --ot-warning: #f59e0b;
        --ot-danger: #ef4444;
        --ot-text: #172033;
        --ot-muted: #64748b;
        --ot-border: #e8edf5;
        --ot-soft: #f8fafc;
    }

    /* =========================================================
           PAGE ANIMATION
           ========================================================= */

    .overtime-page {
        animation: otPageEnter .6s cubic-bezier(.22,1,.36,1) both;
    }

    @@keyframes otPageEnter {
        from {
            opacity: 0;
            transform: translateY(20px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* =========================================================
           ALERTS
           ========================================================= */

    .ot-alert {
        position: relative;
        overflow: hidden;
        border: 0 !important;
        border-radius: 18px !important;
        animation: otAlertEnter .45s ease-out both;
    }

        .ot-alert::before {
            content: "";
            position: absolute;
            left: 0;
            top: 0;
            width: 5px;
            height: 100%;
            background: currentColor;
        }

    .ot-alert-success {
        color: #198754;
    }

    .ot-alert-danger {
        color: #dc3545;
    }

    @@keyframes otAlertEnter {
        from {
            opacity: 0;
            transform: translateY(-15px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* =========================================================
           HEADER
           ========================================================= */

    .ot-header {
        position: relative;
        animation: otHeaderEnter .6s ease-out both;
    }

    @@keyframes otHeaderEnter {
        from {
            opacity: 0;
            transform: translateY(-12px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .ot-title-wrapper {
        display: flex;
        align-items: center;
        gap: 14px;
    }

    .ot-title-icon {
        width: 52px;
        height: 52px;
        border-radius: 17px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.25rem;
        color: var(--ot-primary);
        background: linear-gradient( 135deg, rgba(37,99,235,.16), rgba(59,130,246,.05) );
        border: 1px solid rgba(37,99,235,.12);
        transition: all .3s ease;
    }

    .ot-header:hover .ot-title-icon {
        transform: rotate(-7deg) scale(1.08);
        box-shadow: 0 10px 25px rgba(37,99,235,.14);
    }

    .ot-page-title {
        margin: 0;
        font-size: 1.35rem;
        font-weight: 800;
        color: var(--ot-text);
        letter-spacing: -.5px;
    }

    .ot-page-subtitle {
        color: var(--ot-muted);
        font-size: .83rem;
        margin-top: 2px;
    }

    .ot-breadcrumb {
        margin-top: 4px !important;
    }

        .ot-breadcrumb a {
            color: var(--ot-muted);
            transition: color .2s ease;
        }

            .ot-breadcrumb a:hover {
                color: var(--ot-primary);
            }

    /* =========================================================
           TOP CONTROLS
           ========================================================= */

    .ot-month-select {
        border-radius: 12px !important;
        border-color: var(--ot-border);
        padding: .5rem 2.2rem .5rem .9rem;
        font-weight: 600;
        color: var(--ot-text);
        min-width: 175px;
        transition: all .25s ease;
    }

        .ot-month-select:hover,
        .ot-month-select:focus {
            border-color: rgba(37,99,235,.5);
            box-shadow: 0 0 0 .2rem rgba(37,99,235,.08);
        }

    .ot-primary-btn {
        position: relative;
        overflow: hidden;
        border-radius: 12px !important;
        background: linear-gradient(135deg, var(--ot-primary), #3b82f6);
        border: none;
        transition: all .25s ease;
    }

        .ot-primary-btn::before {
            content: "";
            position: absolute;
            top: 0;
            left: -120%;
            width: 55%;
            height: 100%;
            background: rgba(255,255,255,.22);
            transform: skewX(-25deg);
            transition: left .6s ease;
        }

        .ot-primary-btn:hover::before {
            left: 140%;
        }

        .ot-primary-btn:hover {
            transform: translateY(-3px);
            box-shadow: 0 12px 25px rgba(37,99,235,.25) !important;
        }

        .ot-primary-btn:active {
            transform: translateY(0) scale(.97);
        }

    /* =========================================================
           STATISTICS CARDS
           ========================================================= */

    .ot-stat-col {
        animation: otCardEnter .6s cubic-bezier(.22,1,.36,1) both;
    }

        .ot-stat-col:nth-child(1) {
            animation-delay: .08s;
        }

        .ot-stat-col:nth-child(2) {
            animation-delay: .16s;
        }

        .ot-stat-col:nth-child(3) {
            animation-delay: .24s;
        }

    @@keyframes otCardEnter {
        from {
            opacity: 0;
            transform: translateY(22px) scale(.97);
        }

        to {
            opacity: 1;
            transform: translateY(0) scale(1);
        }
    }

    .ot-stat-card {
        position: relative;
        min-height: 138px;
        overflow: hidden;
        border: 1px solid var(--ot-border) !important;
        border-radius: 20px !important;
        transition: transform .3s ease, box-shadow .3s ease, border-color .3s ease;
    }

        .ot-stat-card::before {
            content: "";
            position: absolute;
            width: 150px;
            height: 150px;
            border-radius: 50%;
            top: -80px;
            right: -60px;
            background: currentColor;
            opacity: .035;
            transition: transform .5s ease;
        }

        .ot-stat-card:hover {
            transform: translateY(-7px);
            box-shadow: 0 18px 40px rgba(15,23,42,.08) !important;
        }

            .ot-stat-card:hover::before {
                transform: scale(1.4);
            }

    .ot-stat-icon {
        width: 58px;
        height: 58px;
        border-radius: 18px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        transition: all .35s ease;
    }

    .ot-stat-card:hover .ot-stat-icon {
        transform: rotate(-6deg) scale(1.1);
    }

    .ot-stat-label {
        color: var(--ot-muted);
        font-size: .7rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .8px;
        margin-bottom: 7px;
    }

    .ot-stat-value {
        color: var(--ot-text);
        font-size: 1.55rem;
        font-weight: 800;
        letter-spacing: -.7px;
        margin: 0;
    }

    .ot-stat-description {
        color: #94a3b8;
        font-size: .73rem;
        margin-top: 5px;
    }

    /* =========================================================
           MAIN TABLE CARD
           ========================================================= */

    .ot-table-card {
        border: 1px solid var(--ot-border) !important;
        border-radius: 20px !important;
        overflow: hidden;
        animation: otTableEnter .65s ease-out .25s both;
        transition: box-shadow .3s ease;
    }

    @@keyframes otTableEnter {
        from {
            opacity: 0;
            transform: translateY(20px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .ot-table-card:hover {
        box-shadow: 0 18px 40px rgba(15,23,42,.06) !important;
    }

    .ot-table-header {
        padding-bottom: 20px;
        border-bottom: 1px solid var(--ot-border);
    }

    .ot-section-title {
        color: var(--ot-text);
        font-weight: 800;
        font-size: 1rem;
    }

    .ot-record-count {
        background: #f8fafc !important;
        border-color: var(--ot-border) !important;
        border-radius: 12px !important;
        color: var(--ot-muted) !important;
        font-weight: 600;
        transition: all .25s ease;
    }

    .ot-table-card:hover .ot-record-count {
        color: var(--ot-primary) !important;
        border-color: rgba(37,99,235,.25) !important;
        background: rgba(37,99,235,.04) !important;
    }

    /* =========================================================
           TABLE
           ========================================================= */

    .ot-table {
        margin-bottom: 0;
    }

        .ot-table thead th {
            background: #f8fafc;
            color: #64748b;
            border-bottom: 1px solid var(--ot-border);
            font-size: .68rem;
            font-weight: 800;
            letter-spacing: .7px;
            text-transform: uppercase;
            white-space: nowrap;
            padding: 15px 13px;
        }

        .ot-table tbody tr {
            animation: otRowEnter .4s ease-out both;
            transition: background-color .2s ease, box-shadow .2s ease;
        }

            .ot-table tbody tr:nth-child(1) {
                animation-delay: .08s;
            }

            .ot-table tbody tr:nth-child(2) {
                animation-delay: .12s;
            }

            .ot-table tbody tr:nth-child(3) {
                animation-delay: .16s;
            }

            .ot-table tbody tr:nth-child(4) {
                animation-delay: .20s;
            }

            .ot-table tbody tr:nth-child(5) {
                animation-delay: .24s;
            }

    @@keyframes otRowEnter {
        from {
            opacity: 0;
            transform: translateX(-10px);
        }

        to {
            opacity: 1;
            transform: translateX(0);
        }
    }

    .ot-table tbody tr:hover {
        background: rgba(37,99,235,.025);
    }

    .ot-table tbody td {
        padding: 16px 13px;
        border-color: #f0f3f7;
        vertical-align: middle;
    }

    .ot-employee {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .ot-employee-avatar {
        width: 36px;
        height: 36px;
        border-radius: 11px;
        background: rgba(37,99,235,.08);
        color: var(--ot-primary);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: .8rem;
        font-weight: 800;
        flex-shrink: 0;
        transition: all .25s ease;
    }

    .ot-table tbody tr:hover .ot-employee-avatar {
        transform: scale(1.08) rotate(-4deg);
        background: var(--ot-primary);
        color: #fff;
    }

    .ot-employee-name {
        font-weight: 700;
        color: var(--ot-text);
        transition: color .2s ease;
    }

    .ot-table tbody tr:hover .ot-employee-name {
        color: var(--ot-primary);
    }

    .ot-hours {
        color: var(--ot-success);
        font-weight: 800;
    }

    .ot-pay {
        color: var(--ot-text);
        font-weight: 800;
        white-space: nowrap;
    }

    .ot-multiplier {
        background: #f8fafc !important;
        color: #475569 !important;
        border: 1px solid var(--ot-border) !important;
        padding: 6px 10px;
        transition: all .2s ease;
    }

    .ot-table tbody tr:hover .ot-multiplier {
        transform: scale(1.05);
        border-color: rgba(37,99,235,.25) !important;
    }

    /* =========================================================
           STATUS BADGES
           ========================================================= */

    .ot-status {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        padding: 7px 11px;
        font-size: .72rem;
        font-weight: 700;
        transition: all .2s ease;
        white-space: nowrap;
    }

        .ot-status:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 14px rgba(15,23,42,.08);
        }

    /* =========================================================
           ACTION BUTTONS
           ========================================================= */

    .ot-action-btn {
        border-radius: 10px !important;
        font-weight: 600;
        transition: all .2s ease;
    }

        .ot-action-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 14px rgba(15,23,42,.1);
        }

        .ot-action-btn:active {
            transform: scale(.96);
        }

    .ot-processed {
        color: #94a3b8;
        font-size: .78rem;
        white-space: nowrap;
    }

    /* =========================================================
           EMPTY STATE
           ========================================================= */

    .ot-empty-state {
        padding: 55px 15px !important;
    }

    .ot-empty-icon {
        width: 65px;
        height: 65px;
        margin: 0 auto 15px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #f8fafc;
        color: #94a3b8;
        font-size: 1.5rem;
        animation: otEmptyFloat 3s ease-in-out infinite;
    }

    @@keyframes otEmptyFloat {
        0%, 100% {
            transform: translateY(0);
        }

        50% {
            transform: translateY(-7px);
        }
    }

    /* =========================================================
           MODAL
           ========================================================= */

    .ot-modal .modal-content {
        border-radius: 22px !important;
        overflow: hidden;
        border: 1px solid var(--ot-border) !important;
    }

    .ot-modal .modal-header {
        background: linear-gradient(135deg, #f8fafc, #ffffff);
    }

    .ot-modal .modal-footer {
        background: #fafcff;
    }

    .ot-modal-icon {
        width: 40px;
        height: 40px;
        border-radius: 13px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background: rgba(37,99,235,.1);
        color: var(--ot-primary);
        margin-right: 10px;
    }

    .ot-modal.fade .modal-dialog {
        transform: translateY(25px) scale(.96);
        transition: transform .3s cubic-bezier(.22,1,.36,1);
    }

    .ot-modal.show .modal-dialog {
        transform: translateY(0) scale(1);
    }

    /* =========================================================
           FORM CONTROLS
           ========================================================= */

    .ot-form-control {
        min-height: 43px;
        border-radius: 11px !important;
        border-color: var(--ot-border);
        transition: all .22s ease;
    }

        .ot-form-control:hover {
            border-color: #cbd5e1;
        }

        .ot-form-control:focus {
            border-color: rgba(37,99,235,.65);
            box-shadow: 0 0 0 .22rem rgba(37,99,235,.09);
            transform: translateY(-1px);
        }

    .ot-modal .form-label {
        color: #475569;
        letter-spacing: .1px;
        margin-bottom: 7px;
    }

    /* =========================================================
           RESPONSIVE
           ========================================================= */

    @@media (max-width: 767.98px) {

        .ot-header {
            align-items: flex-start !important;
        }

        .ot-title-icon {
            width: 46px;
            height: 46px;
        }

        .ot-page-title {
            font-size: 1.2rem;
        }

        .ot-stat-card {
            min-height: 115px;
        }

        .ot-stat-value {
            font-size: 1.3rem;
        }

        .ot-stat-icon {
            width: 48px;
            height: 48px;
        }

        .ot-table-card {
            padding: 1rem !important;
        }

        .ot-table-header {
            gap: 12px;
        }

        .ot-month-select {
            min-width: 145px;
        }
    }

    /* =========================================================
           REDUCED MOTION
           ========================================================= */

    @@media (prefers-reduced-motion: reduce) {

        *,
        *::before,
        *::after {
            animation-duration: .01ms !important;
            animation-iteration-count: 1 !important;
            transition-duration: .01ms !important;
            scroll-behavior: auto !important;
        }
    }
</style>

<div class="container-fluid py-4 text-start overtime-page">

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm mb-4 ot-alert ot-alert-success" role="alert">
            <i class="fa-solid fa-circle-check me-2"></i>
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm mb-4 ot-alert ot-alert-danger" role="alert">
            <i class="fa-solid fa-triangle-exclamation me-2"></i>
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- HEADER -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4 ot-header">

        <div>
            <div class="ot-title-wrapper">
                <div class="ot-title-icon">
                    <i class="fa-solid fa-business-time"></i>
                </div>

                <div>
                    <h4 class="ot-page-title">Overtime Tracker</h4>
                    <div class="ot-page-subtitle">
                        Monitor employee overtime and monthly approvals
                    </div>
                </div>
            </div>

            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0 small ot-breadcrumb mt-2">
                    <li class="breadcrumb-item">
                        <a href="/HR" class="text-decoration-none">
                            HR Dashboard
                        </a>
                    </li>
                    <li class="breadcrumb-item active">
                        Overtime Tracker
                    </li>
                </ol>
            </nav>
        </div>

        <div class="d-flex flex-wrap align-items-center gap-2">

            <form method="get" asp-action="Overtime">
                <select name="monthYear"
                        class="form-select form-select-sm ot-month-select"
                        onchange="this.form.submit()">

                    <option value="August 2026"
                            selected="@(Model.SelectedMonth == "August 2026")">
                        August 2026
                    </option>

                    <option value="July 2026"
                            selected="@(Model.SelectedMonth == "July 2026")">
                        July 2026
                    </option>

                    <option value="June 2026"
                            selected="@(Model.SelectedMonth == "June 2026")">
                        June 2026
                    </option>

                </select>
            </form>

            <button type="button"
                    class="btn btn-primary px-3 btn-sm shadow-sm ot-primary-btn"
                    data-bs-toggle="modal"
                    data-bs-target="#logOvertimeModal">

                <i class="fa-solid fa-plus me-1"></i>
                Log Overtime

            </button>

        </div>
    </div>

    <!-- STATISTICS -->
    <div class="row g-3 mb-4">

        <div class="col-12 col-md-4 ot-stat-col">
            <div class="card shadow-sm ot-stat-card p-3">

                <div class="d-flex align-items-center justify-content-between">

                    <div>
                        <div class="ot-stat-label">
                            Total Overtime Pay
                        </div>

                        <h3 class="ot-stat-value">
                            ₹@Model.TotalOvertimePay.ToString("N2")
                        </h3>

                        <div class="ot-stat-description">
                            @Model.SelectedMonth
                        </div>
                    </div>

                    <div class="ot-stat-icon bg-success bg-opacity-10 text-success">
                        <i class="fa-solid fa-indian-rupee-sign fa-lg"></i>
                    </div>

                </div>
            </div>
        </div>

        <div class="col-12 col-md-4 ot-stat-col">
            <div class="card shadow-sm ot-stat-card p-3">

                <div class="d-flex align-items-center justify-content-between">

                    <div>
                        <div class="ot-stat-label">
                            Pending Approvals
                        </div>

                        <h3 class="ot-stat-value">
                            @Model.PendingApprovalsCount
                        </h3>

                        <div class="ot-stat-description">
                            Awaiting monthly cycle
                        </div>
                    </div>

                    <div class="ot-stat-icon bg-warning bg-opacity-10 text-warning">
                        <i class="fa-solid fa-hourglass-half fa-lg"></i>
                    </div>

                </div>
            </div>
        </div>

        <div class="col-12 col-md-4 ot-stat-col">
            <div class="card shadow-sm ot-stat-card p-3">

                <div class="d-flex align-items-center justify-content-between">

                    <div>
                        <div class="ot-stat-label">
                            Total OT Hours
                        </div>

                        <h3 class="ot-stat-value">
                            +@Model.OvertimeRecords.Sum(r => r.OvertimeHours) hrs
                        </h3>

                        <div class="ot-stat-description">
                            Total logged overtime
                        </div>
                    </div>

                    <div class="ot-stat-icon bg-primary bg-opacity-10 text-primary">
                        <i class="fa-solid fa-clock fa-lg"></i>
                    </div>

                </div>
            </div>
        </div>

    </div>

    <!-- TABLE -->
    <div class="bg-white shadow-sm ot-table-card p-4">

        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-3 ot-table-header">

            <div>
                <h6 class="ot-section-title mb-1">
                    Overtime Calculations & Approvals
                </h6>

                <div class="small text-muted">
                    Monthly records for @Model.SelectedMonth
                </div>
            </div>

            <span class="badge border ot-record-count px-3 py-2">
                <i class="fa-solid fa-users me-1"></i>
                @Model.OvertimeRecords.Count Employees Logged
            </span>

        </div>

        <div class="table-responsive">

            <table class="table table-hover align-middle ot-table">

                <thead>
                    <tr>
                        <th>Employee</th>
                        <th>Month</th>
                        <th>Standard Hours</th>
                        <th>Hours Logged</th>
                        <th>Overtime</th>
                        <th>Multiplier</th>
                        <th>Hourly Rate</th>
                        <th>OT Pay</th>
                        <th>Status</th>
                        <th>Action</th>
                    </tr>
                </thead>

                <tbody>

                    @if (Model.OvertimeRecords.Any())
                    {
                        foreach (var item in Model.OvertimeRecords)
                        {
                            var initials = string.IsNullOrWhiteSpace(item.EmployeeName)
                            ? "EM"
                            : string.Concat(
                            item.EmployeeName
                            .Split(' ', StringSplitOptions.RemoveEmptyEntries)
                            .Take(2)
                            .Select(x => x.Substring(0, 1).ToUpper())
                            );

                            <tr>

                                <td>
                                    <div class="ot-employee">
                                        <div class="ot-employee-avatar">
                                            @initials
                                        </div>

                                        <div class="ot-employee-name">
                                            @item.EmployeeName
                                        </div>
                                    </div>
                                </td>

                                <td class="text-muted">
                                    @item.MonthYear
                                </td>

                                <td>
                                    @item.StandardHours hrs
                                </td>

                                <td>
                                    @item.HoursLogged hrs
                                </td>

                                <td class="ot-hours">
                                    +@item.OvertimeHours hrs
                                </td>

                                <td>
                                    <span class="badge ot-multiplier">
                                        @item.Multiplier
                                    </span>
                                </td>

                                <td class="text-muted">
                                    ₹@item.HourlyRate.ToString("N2")/hr
                                </td>

                                <td class="ot-pay">
                                    ₹@item.TotalOvertimePay.ToString("N2")
                                </td>

                                <td>

                                    @if (item.PayoutStatus == "Approved for Payroll")
                                    {
                                        <span class="badge bg-success-subtle text-success rounded-pill ot-status">
                                            <i class="fa-solid fa-circle-check"></i>
                                            Approved
                                        </span>
                                    }
                                    else if (item.PayoutStatus == "Rejected")
                                    {
                                        <span class="badge bg-danger-subtle text-danger rounded-pill ot-status">
                                            <i class="fa-solid fa-circle-xmark"></i>
                                            Rejected
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning-subtle text-warning rounded-pill ot-status">
                                            <i class="fa-solid fa-clock"></i>
                                            Pending
                                        </span>
                                    }

                                </td>

                                <td>

                                    @if (item.PayoutStatus == "Pending Monthly Cycle")
                                    {
                                        <div class="d-flex gap-1">

                                            <form asp-action="ApproveOvertime"
                                                  method="post"
                                                  class="d-inline">

                                                @Html.AntiForgeryToken()

                                                <input type="hidden"
                                                       name="overtimeId"
                                                       value="@item.OvertimeId" />

                                                <button type="submit"
                                                        class="btn btn-success btn-sm ot-action-btn">

                                                    <i class="fa-solid fa-check"></i>

                                                </button>

                                            </form>

                                            <form asp-action="RejectOvertime"
                                                  method="post"
                                                  class="d-inline">

                                                @Html.AntiForgeryToken()

                                                <input type="hidden"
                                                       name="overtimeId"
                                                       value="@item.OvertimeId" />

                                                <button type="submit"
                                                        class="btn btn-outline-danger btn-sm ot-action-btn">

                                                    <i class="fa-solid fa-xmark"></i>

                                                </button>

                                            </form>

                                        </div>
                                    }
                                    else
                                    {
                                        <span class="ot-processed">
                                            <i class="fa-solid fa-check-double me-1"></i>
                                            Processed
                                        </span>
                                    }

                                </td>

                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="10"
                                class="text-center text-muted ot-empty-state">

                                <div class="ot-empty-icon">
                                    <i class="fa-solid fa-business-time"></i>
                                </div>

                                <div class="fw-semibold mb-1">
                                    No overtime records found
                                </div>

                                <div class="small">
                                    No records available for @Model.SelectedMonth.
                                </div>

                            </td>
                        </tr>
                    }

                </tbody>

            </table>

        </div>
    </div>

</div>

<!-- LOG OVERTIME MODAL -->
<div class="modal fade ot-modal"
     id="logOvertimeModal"
     tabindex="-1"
     aria-labelledby="logOvertimeModalLabel"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content shadow">

            <div class="modal-header border-bottom px-4 py-3">

                <h5 class="modal-title fw-bold d-flex align-items-center"
                    id="logOvertimeModalLabel">

                    <span class="ot-modal-icon">
                        <i class="fa-solid fa-business-time"></i>
                    </span>

                    Log Employee Overtime

                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal">
                </button>

            </div>

            <form asp-action="LogOvertime" method="post">

                @Html.AntiForgeryToken()

                <div class="modal-body p-4">

                    <div class="mb-3">

                        <label class="form-label small fw-bold">
                            Select Employee
                        </label>

                        <select name="userId"
                                class="form-select ot-form-control"
                                required>

                            <option value="">
                                -- Choose Employee --
                            </option>

                            @foreach (var emp in Model.Employees)
                            {
                                <option value="@emp.UserId">
                                    @emp.FullName
                                </option>
                            }

                        </select>

                    </div>

                    <div class="mb-3">

                        <label class="form-label small fw-bold">
                            Month & Year
                        </label>

                        <input type="text"
                               name="monthYear"
                               class="form-control ot-form-control"
                               value="@Model.SelectedMonth"
                               required />

                    </div>

                    <div class="row g-3 mb-3">

                        <div class="col-md-6">

                            <label class="form-label small fw-bold">
                                Standard Monthly Hours
                            </label>

                            <input type="number"
                                   name="standardHours"
                                   class="form-control ot-form-control"
                                   value="160"
                                   required />

                        </div>

                        <div class="col-md-6">

                            <label class="form-label small fw-bold">
                                Total Logged Hours
                            </label>

                            <input type="number"
                                   name="hoursLogged"
                                   class="form-control ot-form-control"
                                   value="172"
                                   required />

                        </div>

                    </div>

                    <div class="row g-3">

                        <div class="col-md-6">

                            <label class="form-label small fw-bold">
                                OT Rate Multiplier
                            </label>

                            <select name="multiplier"
                                    class="form-select ot-form-control">

                                <option value="1.5x">
                                    1.5x - Standard
                                </option>

                                <option value="2.0x">
                                    2.0x - Double Time
                                </option>

                            </select>

                        </div>

                        <div class="col-md-6">

                            <label class="form-label small fw-bold">
                                Base Hourly Rate (₹)
                            </label>

                            <input type="number"
                                   step="0.01"
                                   name="hourlyRate"
                                   class="form-control ot-form-control"
                                   value="250.00"
                                   required />

                        </div>

                    </div>

                </div>

                <div class="modal-footer border-top px-4 py-3">

                    <button type="button"
                            class="btn btn-outline-secondary btn-sm px-3 ot-action-btn"
                            data-bs-dismiss="modal">

                        Cancel

                    </button>

                    <button type="submit"
                            class="btn btn-primary btn-sm px-4 ot-primary-btn">

                        <i class="fa-solid fa-save me-1"></i>
                        Calculate & Log OT

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Overtime Tracker";
}

<div class="container-fluid py-4 text-start">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-bold mb-1"><i class="fa-solid fa-business-time text-primary me-2"></i>Overtime Tracker</h4>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0 small">
                    <li class="breadcrumb-item"><a href="/HR" class="text-decoration-none">HR Dashboard</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Overtime Tracker</li>
                </ol>
            </nav>
        </div>
    </div>

    <!-- Overtime Table -->
    <div class="bg-white border rounded-3 p-4 shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" style="font-size: 0.85rem;">
                <thead class="table-light">
                    <tr>
                        <th>Employee</th>
                        <th>Month</th>
                        <th>Standard Hours</th>
                        <th>Hours Logged</th>
                        <th>Overtime Hours</th>
                        <th>Overtime Multiplier</th>
                        <th>Payout Status</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td class="fw-bold text-dark">Rajesh Kumar</td>
                        <td>August 2026</td>
                        <td>160 hrs</td>
                        <td>172 hrs</td>
                        <td class="fw-bold text-success">+12 hrs</td>
                        <td>1.5x</td>
                        <td><span class="badge bg-warning-subtle text-warning">Pending Monthly Cycle</span></td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

@model ERP_System.Models.OvertimeViewModel
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Overtime Tracker";
}

<div class="container-fluid py-4 text-start">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3 shadow-sm mb-4" role="alert">
            <i class="fa-solid fa-circle-check me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-3 shadow-sm mb-4" role="alert">
            <i class="fa-solid fa-triangle-exclamation me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Header & Action Controls -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <h4 class="fw-bold mb-1"><i class="fa-solid fa-business-time text-primary me-2"></i>Overtime Tracker</h4>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0 small">
                    <li class="breadcrumb-item"><a href="/HR" class="text-decoration-none">HR Dashboard</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Overtime Tracker</li>
                </ol>
            </nav>
        </div>
        <div class="d-flex align-items-center gap-2">
            <form method="get" asp-action="Overtime" class="d-flex align-items-center me-2">
                <select name="monthYear" class="form-select form-select-sm w-auto me-2" onchange="this.form.submit()">
                    <option value="August 2026" selected="@(Model.SelectedMonth == "August 2026")">August 2026</option>
                    <option value="July 2026" selected="@(Model.SelectedMonth == "July 2026")">July 2026</option>
                    <option value="June 2026" selected="@(Model.SelectedMonth == "June 2026")">June 2026</option>
                </select>
            </form>
            <button type="button" class="btn btn-primary rounded-pill px-3 btn-sm shadow-sm" data-bs-toggle="modal" data-bs-target="#logOvertimeModal">
                <i class="fa-solid fa-plus me-1.5"></i>Log Overtime
            </button>
        </div>
    </div>

    <!-- Overtime Stat Cards -->
    <div class="row g-3 mb-4">
        <div class="col-12 col-md-4">
            <div class="card border-0 shadow-sm rounded-3 bg-white p-3 border-start border-4 border-success">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted small fw-semibold text-uppercase">Total Overtime Pay (@Model.SelectedMonth)</div>
                        <h3 class="fw-bold text-dark mb-0 mt-1">₹@Model.TotalOvertimePay.ToString("N2")</h3>
                    </div>
                    <div class="rounded-circle bg-success bg-opacity-10 p-3 text-success">
                        <i class="fa-solid fa-indian-rupee-sign fa-lg"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-12 col-md-4">
            <div class="card border-0 shadow-sm rounded-3 bg-white p-3 border-start border-4 border-warning">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted small fw-semibold text-uppercase">Pending Monthly Approvals</div>
                        <h3 class="fw-bold text-dark mb-0 mt-1">@Model.PendingApprovalsCount</h3>
                    </div>
                    <div class="rounded-circle bg-warning bg-opacity-10 p-3 text-warning">
                        <i class="fa-solid fa-hourglass-half fa-lg"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-12 col-md-4">
            <div class="card border-0 shadow-sm rounded-3 bg-white p-3 border-start border-4 border-primary">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted small fw-semibold text-uppercase">Total OT Hours Logged</div>
                        <h3 class="fw-bold text-dark mb-0 mt-1">+@Model.OvertimeRecords.Sum(r => r.OvertimeHours) hrs</h3>
                    </div>
                    <div class="rounded-circle bg-primary bg-opacity-10 p-3 text-primary">
                        <i class="fa-solid fa-clock fa-lg"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Overtime Table -->
    <div class="bg-white border rounded-3 p-4 shadow-sm">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h6 class="fw-bold mb-0 text-secondary">Overtime Calculations & Approvals for @Model.SelectedMonth</h6>
            <span class="badge bg-light text-dark border">@Model.OvertimeRecords.Count Employees Logged</span>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" style="font-size: 0.85rem;">
                <thead class="table-light">
                    <tr>
                        <th>Employee</th>
                        <th>Month</th>
                        <th>Standard Hours</th>
                        <th>Hours Logged</th>
                        <th>Overtime Hours</th>
                        <th>Multiplier</th>
                        <th>Hourly Rate</th>
                        <th>Calculated OT Pay</th>
                        <th>Payout Status</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.OvertimeRecords.Any())
                    {
                        foreach (var item in Model.OvertimeRecords)
                        {
                            <tr>
                                <td class="fw-bold text-dark">@item.EmployeeName</td>
                                <td>@item.MonthYear</td>
                                <td>@item.StandardHours hrs</td>
                                <td>@item.HoursLogged hrs</td>
                                <td class="fw-bold text-success">+@item.OvertimeHours hrs</td>
                                <td><span class="badge bg-light text-dark border">@item.Multiplier</span></td>
                                <td>₹@item.HourlyRate.ToString("N2")/hr</td>
                                <td class="fw-bold text-dark">₹@item.TotalOvertimePay.ToString("N2")</td>
                                <td>
                                    @if (item.PayoutStatus == "Approved for Payroll")
                                    {
                                        <span class="badge bg-success-subtle text-success rounded-pill px-2.5">Approved for Payroll</span>
                                    }
                                    else if (item.PayoutStatus == "Rejected")
                                    {
                                        <span class="badge bg-danger-subtle text-danger rounded-pill px-2.5">Rejected</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning-subtle text-warning rounded-pill px-2.5">Pending Monthly Cycle</span>
                                    }
                                </td>
                                <td>
                                    @if (item.PayoutStatus == "Pending Monthly Cycle")
                                    {
                                        <div class="d-flex gap-1">
                                            <form asp-action="ApproveOvertime" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="overtimeId" value="@item.OvertimeId" />
                                                <button type="submit" class="btn btn-success btn-xs rounded-pill px-2.5">
                                                    Approve
                                                </button>
                                            </form>
                                            <form asp-action="RejectOvertime" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="overtimeId" value="@item.OvertimeId" />
                                                <button type="submit" class="btn btn-outline-danger btn-xs rounded-pill px-2.5">
                                                    Reject
                                                </button>
                                            </form>
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">Processed</span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="10" class="text-center py-4 text-muted">No overtime records found for @Model.SelectedMonth. Click "Log Overtime" to record entries.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Log Overtime Modal -->
<div class="modal fade" id="logOvertimeModal" tabindex="-1" aria-labelledby="logOvertimeModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-3 border-0 shadow">
            <div class="modal-header bg-light border-bottom px-4 py-3">
                <h5 class="modal-title fw-bold" id="logOvertimeModalLabel"><i class="fa-solid fa-business-time text-primary me-2"></i>Log Employee Overtime</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="LogOvertime" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label small fw-bold text-secondary">Select Employee</label>
                        <select name="userId" class="form-select" required>
                            <option value="">-- Choose Employee --</option>
                            @foreach (var emp in Model.Employees)
                            {
                                <option value="@emp.UserId">@emp.FullName</option>
                            }
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-bold text-secondary">Month & Year</label>
                        <input type="text" name="monthYear" class="form-control" value="@Model.SelectedMonth" required />
                    </div>

                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label small fw-bold text-secondary">Standard Monthly Hours</label>
                            <input type="number" name="standardHours" class="form-control" value="160" required />
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-bold text-secondary">Total Logged Hours</label>
                            <input type="number" name="hoursLogged" class="form-control" value="172" required />
                        </div>
                    </div>

                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label small fw-bold text-secondary">OT Rate Multiplier</label>
                            <select name="multiplier" class="form-select">
                                <option value="1.5x">1.5x (Standard Overtime)</option>
                                <option value="2.0x">2.0x (Holiday / Double Time)</option>
                            </select>
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-bold text-secondary">Base Hourly Rate (₹)</label>
                            <input type="number" step="0.01" name="hourlyRate" class="form-control" value="250.00" required />
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light border-top px-4 py-2">
                    <button type="button" class="btn btn-secondary btn-sm rounded-pill" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary btn-sm rounded-pill px-4"><i class="fa-solid fa-save me-1"></i>Calculate & Log OT</button>
                </div>
            </form>
        </div>
    </div>
</div>

@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Candidate Pipeline (ATS)";
}

<div class="container-fluid py-4 text-start">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-bold mb-1"><i class="fa-solid fa-users-viewfinder text-primary me-2"></i>Candidate Pipeline</h4>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0 small">
                    <li class="breadcrumb-item"><a href="/HR" class="text-decoration-none">HR Dashboard</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Candidate Pipeline</li>
                </ol>
            </nav>
        </div>
    </div>

    <!-- Pipeline List -->
    <div class="bg-white border rounded-3 p-4 shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" style="font-size: 0.85rem;">
                <thead class="table-light">
                    <tr>
                        <th>Candidate Name</th>
                        <th>Job Applied For</th>
                        <th>Current Stage</th>
                        <th>Match Score</th>
                        <th>Resume Link</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td class="fw-bold text-dark">Arun Kumar</td>
                        <td>Junior Sales Representative</td>
                        <td><span class="badge bg-primary-subtle text-primary">HR Screening</span></td>
                        <td class="fw-bold">85%</td>
                        <td><a href="#" class="text-decoration-none"><i class="fa-solid fa-file-lines me-1"></i>resume_arun.docx</a></td>
                        <td><button class="btn btn-outline-primary btn-xs rounded-pill px-2.5">Schedule Interview</button></td>
                    </tr>
                    <tr>
                        <td class="fw-bold text-dark">Pooja Patel</td>
                        <td>Lead Full-stack Developer</td>
                        <td><span class="badge bg-warning-subtle text-warning">Technical Round 1</span></td>
                        <td class="fw-bold">92%</td>
                        <td><a href="#" class="text-decoration-none"><i class="fa-solid fa-file-pdf me-1 text-danger"></i>pooja_cv.pdf</a></td>
                        <td><button class="btn btn-outline-primary btn-xs rounded-pill px-2.5">Evaluate</button></td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

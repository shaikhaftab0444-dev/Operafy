@model IEnumerable<ERP_System.Models.CandidateApplication>
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Candidate Pipeline (ATS)";
    var jobOpenings = ViewBag.JobOpenings as List<ERP_System.Models.JobOpening> ?? new List<ERP_System.Models.JobOpening>();
    var allJobs = ViewBag.AllJobs as List<ERP_System.Models.JobOpening> ?? new List<ERP_System.Models.JobOpening>();

    var stages = new[] {
        "Applied", "Screening", "Shortlisted", "HR Interview", "Technical Interview",
        "Manager Interview", "Final Interview", "Selected", "Offer Sent", "Offer Accepted", "Hired"
    };
}

<style>
    /* =========================================================
           CANDIDATE PIPELINE - PREMIUM ATS DESIGN
           ========================================================= */

    .candidate-pipeline-page {
        --ats-primary: #4f46e5;
        --ats-primary-dark: #3730a3;
        --ats-primary-soft: #eef2ff;
        --ats-success: #16a34a;
        --ats-success-soft: #ecfdf3;
        --ats-warning: #d97706;
        --ats-warning-soft: #fff7ed;
        --ats-danger: #dc2626;
        --ats-danger-soft: #fef2f2;
        --ats-info: #0284c7;
        --ats-info-soft: #eff6ff;
        --ats-text: #172033;
        --ats-muted: #718096;
        --ats-border: #e8ebf2;
        --ats-bg: #f7f8fc;
    }

    .candidate-pipeline-page {
        animation: atsPageEnter .45s ease both;
    }

    @@keyframes atsPageEnter {
        from {
            opacity: 0;
            transform: translateY(10px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* ================= HEADER ================= */

    .ats-page-header {
        position: relative;
        overflow: hidden;
        border-radius: 20px;
        padding: 24px 26px;
        margin-bottom: 20px;
        background: radial-gradient(circle at 100% 0%, rgba(99, 102, 241, .14), transparent 32%), linear-gradient(135deg, #ffffff 0%, #fafbff 100%);
        border: 1px solid var(--ats-border);
        box-shadow: 0 8px 30px rgba(31, 41, 55, .05);
    }

        .ats-page-header::before {
            content: "";
            position: absolute;
            width: 180px;
            height: 180px;
            right: -80px;
            top: -90px;
            border-radius: 50%;
            background: rgba(79, 70, 229, .06);
            pointer-events: none;
        }

    .ats-title-row {
        position: relative;
        z-index: 1;
    }

    .ats-title-icon {
        width: 48px;
        height: 48px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 14px;
        color: var(--ats-primary);
        background: var(--ats-primary-soft);
        box-shadow: inset 0 0 0 1px rgba(79, 70, 229, .08);
        animation: iconFloat 3.5s ease-in-out infinite;
    }

    @@keyframes iconFloat {
        0%, 100% {
            transform: translateY(0);
        }

        50% {
            transform: translateY(-3px);
        }
    }

    .ats-page-title {
        color: var(--ats-text);
        font-size: 1.45rem;
        font-weight: 750;
        letter-spacing: -.025em;
        margin: 0;
    }

    .ats-page-subtitle {
        color: var(--ats-muted);
        font-size: .82rem;
        margin-top: 3px;
    }

    .ats-breadcrumb {
        margin-top: 7px;
    }

        .ats-breadcrumb .breadcrumb-item {
            font-size: .74rem;
        }

        .ats-breadcrumb a {
            color: var(--ats-primary);
            font-weight: 600;
        }

    .ats-add-btn {
        position: relative;
        z-index: 2;
        border: 0;
        background: linear-gradient(135deg, #4f46e5, #6366f1);
        box-shadow: 0 8px 20px rgba(79, 70, 229, .22);
        transition: all .25s ease;
        font-weight: 650;
        padding: 10px 17px !important;
    }

        .ats-add-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 12px 25px rgba(79, 70, 229, .28);
            background: linear-gradient(135deg, #4338ca, #4f46e5);
        }

        .ats-add-btn:active {
            transform: translateY(0);
        }

    /* ================= ALERTS ================= */

    .ats-alert {
        border: 0;
        border-radius: 14px;
        padding: 13px 16px;
        font-size: .82rem;
        box-shadow: 0 5px 18px rgba(0, 0, 0, .04);
        animation: alertSlide .4s ease both;
    }

    @@keyframes alertSlide {
        from {
            opacity: 0;
            transform: translateY(-8px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .ats-alert-success {
        background: var(--ats-success-soft);
        color: #15803d;
    }

    .ats-alert-danger {
        background: var(--ats-danger-soft);
        color: #b91c1c;
    }

    /* ================= FILTER CARD ================= */

    .ats-filter-card {
        background: #fff;
        border: 1px solid var(--ats-border);
        border-radius: 18px;
        padding: 17px;
        margin-bottom: 20px;
        box-shadow: 0 8px 25px rgba(31, 41, 55, .045);
        transition: box-shadow .25s ease, transform .25s ease;
    }

        .ats-filter-card:hover {
            box-shadow: 0 12px 30px rgba(31, 41, 55, .065);
        }

    .ats-filter-label {
        display: block;
        font-size: .68rem;
        font-weight: 750;
        color: #667085;
        text-transform: uppercase;
        letter-spacing: .06em;
        margin-bottom: 6px;
    }

    .ats-input-group {
        border-radius: 11px;
        overflow: hidden;
        border: 1px solid #e4e7ec;
        transition: all .2s ease;
        background: #fff;
    }

        .ats-input-group:focus-within {
            border-color: rgba(79, 70, 229, .45);
            box-shadow: 0 0 0 3px rgba(79, 70, 229, .08);
        }

        .ats-input-group .input-group-text {
            border: 0;
            background: #f8f9fc;
            color: #98a2b3;
            padding-left: 12px;
            padding-right: 9px;
        }

        .ats-input-group .form-control {
            border: 0;
            box-shadow: none !important;
            font-size: .78rem;
            min-height: 38px;
        }

    .ats-filter-card .form-select {
        border: 1px solid #e4e7ec;
        border-radius: 11px;
        min-height: 38px;
        font-size: .78rem;
        color: #344054;
        box-shadow: none;
        transition: all .2s ease;
        cursor: pointer;
    }

        .ats-filter-card .form-select:focus {
            border-color: rgba(79, 70, 229, .45);
            box-shadow: 0 0 0 3px rgba(79, 70, 229, .08);
        }

    .ats-filter-btn {
        min-height: 38px;
        border-radius: 10px !important;
        font-weight: 650;
        font-size: .76rem;
        transition: all .2s ease;
    }

        .ats-filter-btn:hover {
            transform: translateY(-1px);
        }

    .ats-reset-btn {
        min-height: 38px;
        border-radius: 10px !important;
        font-size: .76rem;
        font-weight: 600;
    }

    /* ================= TABLE CARD ================= */

    .ats-table-card {
        background: #fff;
        border: 1px solid var(--ats-border);
        border-radius: 20px;
        overflow: hidden;
        box-shadow: 0 10px 30px rgba(31, 41, 55, .055);
    }

    .ats-table-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 15px;
        padding: 18px 20px;
        border-bottom: 1px solid var(--ats-border);
        background: linear-gradient(180deg, #fff, #fcfcfe);
    }

    .ats-table-heading {
        display: flex;
        align-items: center;
        gap: 11px;
    }

    .ats-heading-icon {
        width: 38px;
        height: 38px;
        border-radius: 11px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background: #f1f5ff;
        color: var(--ats-primary);
    }

    .ats-table-title {
        font-size: .95rem;
        font-weight: 750;
        color: var(--ats-text);
        margin: 0;
    }

    .ats-table-description {
        font-size: .7rem;
        color: var(--ats-muted);
        margin: 2px 0 0;
    }

    .ats-candidate-count {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 6px 10px;
        border-radius: 999px;
        background: #f8f9fc;
        border: 1px solid #eceef3;
        color: #667085;
        font-size: .7rem;
        font-weight: 700;
    }

    .ats-table-wrap {
        overflow-x: auto;
        scrollbar-width: thin;
    }

    .ats-table {
        min-width: 1120px;
        margin: 0;
        border-collapse: separate;
        border-spacing: 0;
    }

        .ats-table thead th {
            padding: 13px 16px;
            background: #f8f9fc;
            color: #667085;
            border-bottom: 1px solid #e9ecf2;
            font-size: .66rem;
            font-weight: 750;
            text-transform: uppercase;
            letter-spacing: .045em;
            white-space: nowrap;
        }

        .ats-table tbody td {
            padding: 15px 16px;
            border-bottom: 1px solid #f0f1f4;
            vertical-align: middle;
            color: #344054;
            font-size: .77rem;
        }

        .ats-table tbody tr {
            transition: all .22s ease;
        }

            .ats-table tbody tr:hover {
                background: #fafbff;
            }

            .ats-table tbody tr:last-child td {
                border-bottom: 0;
            }

    /* ================= CANDIDATE ================= */

    .ats-candidate-info {
        display: flex;
        align-items: center;
        gap: 11px;
        min-width: 220px;
    }

    .ats-avatar {
        width: 40px;
        height: 40px;
        min-width: 40px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 12px;
        background: linear-gradient(135deg, #eef2ff, #e0e7ff);
        color: var(--ats-primary);
        font-size: .78rem;
        font-weight: 800;
        box-shadow: inset 0 0 0 1px rgba(79, 70, 229, .08);
    }

    .ats-candidate-name {
        font-size: .8rem;
        font-weight: 750;
        color: #1d2939;
        margin-bottom: 3px;
    }

    .ats-contact {
        color: #98a2b3;
        font-size: .67rem;
        line-height: 1.7;
        white-space: nowrap;
    }

        .ats-contact i {
            width: 12px;
            text-align: center;
            margin-right: 2px;
        }

    /* ================= JOB ================= */

    .ats-job-title {
        font-weight: 700;
        color: #344054;
        font-size: .78rem;
        margin-bottom: 3px;
    }

    .ats-job-department {
        color: #98a2b3;
        font-size: .68rem;
    }

    /* ================= EXPERIENCE ================= */

    .ats-experience {
        font-weight: 650;
        color: #475467;
        font-size: .74rem;
        margin-bottom: 4px;
    }

        .ats-experience i {
            color: #98a2b3;
        }

    .ats-skills {
        max-width: 190px;
        color: #98a2b3;
        font-size: .67rem;
    }

    /* ================= MATCH SCORE ================= */

    .ats-match-wrapper {
        min-width: 110px;
    }

    .ats-match-top {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 8px;
        margin-bottom: 5px;
    }

    .ats-match-score {
        font-size: .72rem;
        font-weight: 800;
        color: #344054;
    }

    .ats-match-label {
        color: #98a2b3;
        font-size: .63rem;
    }

    .ats-progress {
        height: 6px;
        border-radius: 999px;
        overflow: hidden;
        background: #edf0f5;
    }

        .ats-progress .progress-bar {
            border-radius: 999px;
            background: linear-gradient(90deg, #22c55e, #16a34a);
            animation: progressLoad 1s ease both;
            transform-origin: left;
        }

    @@keyframes progressLoad {
        from {
            transform: scaleX(0);
        }

        to {
            transform: scaleX(1);
        }
    }

    /* ================= BADGES ================= */

    .ats-stage-badge,
    .ats-status-badge {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 6px 9px;
        border-radius: 999px;
        font-size: .65rem;
        font-weight: 750;
        white-space: nowrap;
        border: 1px solid transparent;
    }

    .ats-stage-primary {
        color: #4338ca;
        background: #eef2ff;
        border-color: #e0e7ff;
    }

    .ats-stage-success {
        color: #15803d;
        background: #ecfdf3;
        border-color: #d1fadf;
    }

    .ats-stage-warning {
        color: #b45309;
        background: #fffaeb;
        border-color: #fedf89;
    }

    .ats-stage-danger {
        color: #b91c1c;
        background: #fef2f2;
        border-color: #fee2e2;
    }

    .ats-stage-secondary {
        color: #475467;
        background: #f2f4f7;
        border-color: #eaecf0;
    }

    .ats-status-active {
        color: #15803d;
        background: #ecfdf3;
    }

    .ats-status-rejected {
        color: #b91c1c;
        background: #fef2f2;
    }

    .ats-status-other {
        color: #b45309;
        background: #fffaeb;
    }

    /* ================= RESUME ================= */

    .ats-resume-link {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        color: #4f46e5;
        font-size: .7rem;
        font-weight: 750;
        text-decoration: none;
        padding: 6px 9px;
        border-radius: 8px;
        background: #f8f9ff;
        transition: all .2s ease;
    }

        .ats-resume-link:hover {
            color: #3730a3;
            background: #eef2ff;
            transform: translateY(-1px);
        }

    .ats-no-resume {
        color: #98a2b3;
        font-size: .68rem;
    }

    /* ================= ACTIONS ================= */

    .ats-actions {
        display: inline-flex;
        align-items: center;
        gap: 5px;
    }

    .ats-stage-btn {
        border: 1px solid #dfe3eb;
        color: #4f46e5;
        background: #fff;
        font-size: .67rem;
        font-weight: 700;
        border-radius: 8px !important;
        padding: 6px 9px !important;
        transition: all .2s ease;
    }

        .ats-stage-btn:hover {
            color: #fff;
            background: #4f46e5;
            border-color: #4f46e5;
            transform: translateY(-1px);
            box-shadow: 0 5px 12px rgba(79, 70, 229, .18);
        }

    .ats-dropdown-btn {
        border: 1px solid #dfe3eb !important;
        color: #667085;
        background: #fff;
        border-radius: 8px !important;
        padding: 6px 8px !important;
    }

        .ats-dropdown-btn:hover {
            background: #f8f9fc;
            color: #344054;
        }

    .ats-dropdown {
        border: 1px solid #eaecf0;
        border-radius: 12px;
        padding: 6px;
        min-width: 210px;
        box-shadow: 0 15px 40px rgba(16, 24, 40, .12);
        animation: dropdownEnter .18s ease both;
    }

    @@keyframes dropdownEnter {
        from {
            opacity: 0;
            transform: translateY(-4px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .ats-dropdown .dropdown-item {
        border-radius: 8px;
        padding: 8px 10px;
        color: #475467;
        transition: all .15s ease;
    }

        .ats-dropdown .dropdown-item:hover {
            background: #f8f9fc;
            transform: translateX(2px);
        }

    .ats-dropdown .dropdown-divider {
        margin: 5px 0;
    }

    /* ================= EMPTY STATE ================= */

    .ats-empty-state {
        padding: 65px 20px !important;
        background: radial-gradient(circle at center, rgba(79, 70, 229, .035), transparent 48%);
    }

    .ats-empty-icon {
        width: 70px;
        height: 70px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 22px;
        background: #f2f4f7;
        color: #98a2b3;
        margin-bottom: 14px;
        animation: emptyFloat 3s ease-in-out infinite;
    }

    @@keyframes emptyFloat {
        0%, 100% {
            transform: translateY(0);
        }

        50% {
            transform: translateY(-5px);
        }
    }

    .ats-empty-title {
        color: #344054;
        font-size: .9rem;
        font-weight: 750;
        margin-bottom: 4px;
    }

    .ats-empty-text {
        color: #98a2b3;
        font-size: .74rem;
        margin: 0;
    }

    /* ================= MODALS ================= */

    .ats-modal .modal-content {
        border: 0;
        border-radius: 18px;
        overflow: hidden;
        box-shadow: 0 25px 70px rgba(16, 24, 40, .2);
    }

    .ats-modal .modal-header {
        border-bottom: 1px solid #eaecf0;
        padding: 17px 20px;
        background: radial-gradient(circle at 100% 0%, rgba(79, 70, 229, .08), transparent 35%), #fbfcff;
    }

    .ats-modal-title {
        color: #1d2939;
        font-size: .95rem;
        font-weight: 750;
    }

        .ats-modal-title i {
            width: 30px;
            height: 30px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border-radius: 9px;
            background: #eef2ff;
            color: #4f46e5;
        }

    .ats-modal .modal-body {
        padding: 20px;
    }

    .ats-modal .modal-footer {
        border-top: 1px solid #eaecf0;
        padding: 12px 20px;
        background: #fbfcff;
    }

    .ats-modal .form-label {
        color: #344054;
        font-size: .72rem;
        margin-bottom: 6px;
    }

    .ats-modal .form-control,
    .ats-modal .form-select {
        border: 1px solid #dfe3eb;
        border-radius: 10px;
        min-height: 39px;
        font-size: .76rem;
        color: #344054;
        box-shadow: none;
        transition: all .2s ease;
    }

    .ats-modal textarea.form-control {
        min-height: auto;
    }

    .ats-modal .form-control:focus,
    .ats-modal .form-select:focus {
        border-color: rgba(79, 70, 229, .5);
        box-shadow: 0 0 0 3px rgba(79, 70, 229, .08);
    }

    .ats-modal .form-control::placeholder {
        color: #a4acb9;
    }

    .ats-modal .btn {
        font-size: .73rem;
        font-weight: 700;
    }

    .ats-modal-info {
        padding: 11px 13px;
        border-radius: 11px;
        background: #f8f9fc;
        border: 1px solid #edf0f4;
        color: #667085;
        font-size: .72rem;
        margin-bottom: 18px;
    }

        .ats-modal-info strong {
            color: #344054;
        }

    .ats-cancel-btn {
        border-radius: 9px !important;
        padding: 7px 14px !important;
    }

    .ats-submit-btn {
        border: 0;
        border-radius: 9px !important;
        padding: 8px 16px !important;
        background: linear-gradient(135deg, #4f46e5, #6366f1);
        box-shadow: 0 6px 15px rgba(79, 70, 229, .18);
    }

        .ats-submit-btn:hover {
            background: linear-gradient(135deg, #4338ca, #4f46e5);
            transform: translateY(-1px);
        }

    /* ================= ADD CANDIDATE MODAL ================= */

    .ats-add-modal .modal-dialog {
        max-width: 820px;
    }

    .ats-form-section {
        position: relative;
        padding: 12px 14px 13px;
        margin-bottom: 2px;
        border-radius: 12px;
        background: #fafbfc;
        border: 1px solid #eef0f3;
    }

    .ats-form-section-title {
        display: flex;
        align-items: center;
        gap: 7px;
        color: #475467;
        font-size: .68rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: .06em;
        margin-bottom: 12px;
    }

        .ats-form-section-title i {
            color: #4f46e5;
        }

    /* ================= RESPONSIVE ================= */

    @@media (max-width: 991.98px) {
        .ats-page-header {
            padding: 20px;
        }

        .ats-filter-card {
            padding: 14px;
        }

        .ats-table-header {
            padding: 16px;
        }
    }

    @@media (max-width: 767.98px) {
        .candidate-pipeline-page {
            padding-left: 3px;
            padding-right: 3px;
        }

        .ats-page-header {
            padding: 17px;
            border-radius: 16px;
        }

        .ats-title-icon {
            width: 42px;
            height: 42px;
            border-radius: 12px;
        }

        .ats-page-title {
            font-size: 1.12rem;
        }

        .ats-page-subtitle {
            font-size: .72rem;
        }

        .ats-header-actions {
            width: 100%;
        }

        .ats-add-btn {
            width: 100%;
            justify-content: center;
        }

        .ats-filter-card {
            border-radius: 15px;
        }

            .ats-filter-card .row > div {
                margin-bottom: 2px;
            }

        .ats-filter-actions {
            display: flex;
            gap: 7px;
        }

            .ats-filter-actions .btn {
                flex: 1;
            }

        .ats-table-card {
            border-radius: 15px;
        }

        .ats-table-header {
            align-items: flex-start;
            flex-direction: column;
        }

        .ats-candidate-count {
            align-self: flex-start;
        }

        .ats-add-modal .modal-dialog {
            margin: 10px;
        }

        .ats-modal .modal-body {
            padding: 15px;
        }
    }

    @@media (max-width: 575.98px) {
        .ats-breadcrumb {
            display: none;
        }

        .ats-title-row {
            align-items: flex-start !important;
        }

        .ats-table-description {
            max-width: 250px;
        }

        .ats-empty-state {
            padding: 45px 15px !important;
        }
    }

    /* ================= REDUCED MOTION ================= */

    @@media (prefers-reduced-motion: reduce) {
        .candidate-pipeline-page,
        .ats-title-icon,
        .ats-progress .progress-bar,
        .ats-empty-icon,
        .ats-alert,
        .ats-dropdown {
            animation: none !important;
        }

        * {
            scroll-behavior: auto !important;
        }
    }
</style>

<div class="container-fluid py-4 text-start candidate-pipeline-page">

    <!-- ================= ALERTS ================= -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert ats-alert ats-alert-success alert-dismissible fade show mb-3" role="alert">
            <i class="fa-solid fa-circle-check me-2"></i>
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert ats-alert ats-alert-danger alert-dismissible fade show mb-3" role="alert">
            <i class="fa-solid fa-triangle-exclamation me-2"></i>
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- ================= HEADER ================= -->

    <div class="ats-page-header">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">

            <div class="d-flex align-items-center gap-3 ats-title-row">

                <div class="ats-title-icon">
                    <i class="fa-solid fa-users-viewfinder fa-lg"></i>
                </div>

                <div>
                    <h4 class="ats-page-title">
                        Candidate Pipeline
                    </h4>

                    <div class="ats-page-subtitle">
                        Manage candidates, recruitment stages and hiring progress
                    </div>

                    <nav aria-label="breadcrumb" class="ats-breadcrumb">
                        <ol class="breadcrumb mb-0">
                            <li class="breadcrumb-item">
                                <a href="/HR" class="text-decoration-none">
                                    HR Dashboard
                                </a>
                            </li>
                            <li class="breadcrumb-item active" aria-current="page">
                                Candidate Pipeline
                            </li>
                        </ol>
                    </nav>
                </div>

            </div>

            <div class="ats-header-actions">
                <button class="btn btn-primary rounded-pill ats-add-btn"
                        data-bs-toggle="modal"
                        data-bs-target="#addCandidateModal">
                    <i class="fa-solid fa-user-plus me-2"></i>
                    Add Candidate
                </button>
            </div>

        </div>
    </div>

    <!-- ================= FILTERS ================= -->

    <div class="ats-filter-card">

        <form method="get" action="/HRRecruitment/CandidatePipeline">

            <div class="row g-3 align-items-end">

                <div class="col-xl-3 col-lg-4 col-md-6">
                    <label class="ats-filter-label">
                        Search Candidate
                    </label>

                    <div class="input-group input-group-sm ats-input-group">
                        <span class="input-group-text">
                            <i class="fa-solid fa-magnifying-glass"></i>
                        </span>

                        <input type="text"
                               name="search"
                               class="form-control"
                               placeholder="Name, email or phone..."
                               value="@ViewBag.Search" />
                    </div>
                </div>

                <div class="col-xl-3 col-lg-4 col-md-6">
                    <label class="ats-filter-label">
                        Job Opening
                    </label>

                    <select name="jobId"
                            class="form-select form-select-sm"
                            onchange="this.form.submit()">

                        <option value="">
                            All Job Openings
                        </option>

                        @foreach (var j in allJobs)
                        {
                            <option value="@j.JobId"
                                    selected="@(ViewBag.SelectedJobId == j.JobId ? "selected" : null)">
                                @j.JobCode - @j.JobTitle
                            </option>
                        }
                    </select>
                </div>

                <div class="col-xl-2 col-lg-4 col-md-6">
                    <label class="ats-filter-label">
                        Pipeline Stage
                    </label>

                    <select name="stage"
                            class="form-select form-select-sm"
                            onchange="this.form.submit()">

                        <option value="All">
                            All Pipeline Stages
                        </option>

                        @foreach (var stg in stages)
                        {
                            <option value="@stg"
                                    selected="@(ViewBag.SelectedStage == stg ? "selected" : null)">
                                @stg
                            </option>
                        }
                    </select>
                </div>

                <div class="col-xl-2 col-lg-4 col-md-6">
                    <label class="ats-filter-label">
                        Status
                    </label>

                    <select name="status"
                            class="form-select form-select-sm"
                            onchange="this.form.submit()">

                        <option value="All">
                            All Statuses
                        </option>

                        <option value="Active"
                                selected="@(ViewBag.SelectedStatus == "Active" ? "selected" : null)">
                            Active
                        </option>

                        <option value="Rejected"
                                selected="@(ViewBag.SelectedStatus == "Rejected" ? "selected" : null)">
                            Rejected
                        </option>

                        <option value="On Hold"
                                selected="@(ViewBag.SelectedStatus == "On Hold" ? "selected" : null)">
                            On Hold
                        </option>

                        <option value="Withdrawn"
                                selected="@(ViewBag.SelectedStatus == "Withdrawn" ? "selected" : null)">
                            Withdrawn
                        </option>

                    </select>
                </div>

                <div class="col-xl-2 col-lg-4 col-md-6">
                    <div class="d-flex gap-2 ats-filter-actions">

                        <button type="submit"
                                class="btn btn-sm btn-outline-primary ats-filter-btn flex-grow-1">
                            <i class="fa-solid fa-filter me-1"></i>
                            Filter
                        </button>

                        <a href="/HRRecruitment/CandidatePipeline"
                           class="btn btn-sm btn-outline-secondary ats-reset-btn">
                            <i class="fa-solid fa-rotate-left"></i>
                        </a>

                    </div>
                </div>

            </div>

        </form>

    </div>

    <!-- ================= PIPELINE TABLE ================= -->

    <div class="ats-table-card">

        <div class="ats-table-header">

            <div class="ats-table-heading">

                <div class="ats-heading-icon">
                    <i class="fa-solid fa-list-check"></i>
                </div>

                <div>
                    <h6 class="ats-table-title">
                        Recruitment Pipeline
                    </h6>

                    <p class="ats-table-description">
                        Track candidates from application to hiring
                    </p>
                </div>

            </div>

            <div class="ats-candidate-count">
                <i class="fa-solid fa-users"></i>
                @(Model?.Count() ?? 0) Candidates
            </div>

        </div>

        <div class="ats-table-wrap">

            <table class="table ats-table align-middle">

                <thead>
                    <tr>
                        <th>Candidate</th>
                        <th>Applied Position</th>
                        <th>Experience & Skills</th>
                        <th>Match Score</th>
                        <th>Current Stage</th>
                        <th>Status</th>
                        <th>Resume</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>

                <tbody>

                    @if (Model != null && Model.Any())
                    {
                        foreach (var app in Model)
                        {
                            var cand = app.Candidate;
                            var job = app.JobOpening;

                            string stageBadge = app.Stage switch
                            {
                                "Selected" or "Hired" or "Offer Accepted" => "ats-stage-success",
                                "Offer Sent" => "ats-stage-warning",
                                "Rejected" => "ats-stage-danger",
                                "On Hold" => "ats-stage-secondary",
                                _ => "ats-stage-primary"
                            };

                            string statusBadge = app.Status switch
                            {
                                "Active" => "ats-status-active",
                                "Rejected" => "ats-status-rejected",
                                _ => "ats-status-other"
                            };

                            string candidateName = cand?.FullName ?? "N/A";

                            string initials = "NA";

                            if (!string.IsNullOrWhiteSpace(candidateName) &&
                            candidateName != "N/A")
                            {
                                var nameParts = candidateName
                                .Split(' ', StringSplitOptions.RemoveEmptyEntries);

                                if (nameParts.Length >= 2)
                                {
                                    initials =
                                    $"{nameParts[0][0]}{nameParts[^1][0]}".ToUpper();
                                }
                                else if (nameParts.Length == 1)
                                {
                                    initials = nameParts[0]
                                    .Substring(0, Math.Min(2, nameParts[0].Length))
                                    .ToUpper();
                                }
                            }

                            <tr>

                                <!-- Candidate -->
                                <td>
                                    <div class="ats-candidate-info">

                                        <div class="ats-avatar">
                                            @initials
                                        </div>

                                        <div>
                                            <div class="ats-candidate-name">
                                                @candidateName
                                            </div>

                                            <div class="ats-contact">
                                                <span>
                                                    <i class="fa-solid fa-envelope"></i>
                                                    @(cand?.Email ?? "No email")
                                                </span>
                                                <br />
                                                <span>
                                                    <i class="fa-solid fa-phone"></i>
                                                    @(cand?.Phone ?? "No phone")
                                                </span>
                                            </div>
                                        </div>

                                    </div>
                                </td>

                                <!-- Position -->
                                <td>
                                    <div class="ats-job-title">
                                        @(job?.JobTitle ?? "Unassigned")
                                    </div>

                                    <div class="ats-job-department">
                                        <i class="fa-solid fa-building me-1"></i>
                                        @(job?.Department?.DepartmentName ?? "Department N/A")
                                    </div>
                                </td>

                                <!-- Experience -->
                                <td>
                                    <div class="ats-experience">
                                        <i class="fa-solid fa-briefcase me-1"></i>
                                        @(cand?.Experience ?? "N/A")
                                    </div>

                                    <div class="ats-skills text-truncate">
                                        @(cand?.Skills ?? "N/A")
                                    </div>
                                </td>

                                <!-- Match Score -->
                                <td>

                                    <div class="ats-match-wrapper">

                                        <div class="ats-match-top">

                                            <span class="ats-match-label">
                                                Match
                                            </span>

                                            <span class="ats-match-score">
                                                @app.MatchScore%
                                            </span>

                                        </div>

                                        <div class="progress ats-progress">
                                            <div class="progress-bar"
                                                 role="progressbar"
                                                 style="width: @app.MatchScore%;"
                                                 aria-valuenow="@app.MatchScore"
                                                 aria-valuemin="0"
                                                 aria-valuemax="100">
                                            </div>
                                        </div>

                                    </div>

                                </td>

                                <!-- Stage -->
                                <td>
                                    <span class="ats-stage-badge @stageBadge">

                                        @if (app.Stage == "Selected" ||
                                                                        app.Stage == "Hired" ||
                                                                        app.Stage == "Offer Accepted")
                                        {
                                            <i class="fa-solid fa-circle-check"></i>
                                        }
                                        else if (app.Stage == "Offer Sent")
                                        {
                                            <i class="fa-solid fa-envelope"></i>
                                        }
                                        else if (app.Stage == "Rejected")
                                        {
                                            <i class="fa-solid fa-circle-xmark"></i>
                                        }
                                        else if (app.Stage == "On Hold")
                                        {
                                            <i class="fa-solid fa-pause"></i>
                                        }
                                        else
                                        {
                                            <i class="fa-solid fa-arrow-right"></i>
                                        }

                                        @app.Stage

                                    </span>
                                </td>

                                <!-- Status -->
                                <td>
                                    <span class="ats-status-badge @statusBadge">

                                        @if (app.Status == "Active")
                                        {
                                            <i class="fa-solid fa-circle"></i>
                                        }
                                        else if (app.Status == "Rejected")
                                        {
                                            <i class="fa-solid fa-circle-xmark"></i>
                                        }
                                        else
                                        {
                                            <i class="fa-solid fa-clock"></i>
                                        }

                                        @app.Status

                                    </span>
                                </td>

                                <!-- Resume -->
                                <td>
                                    @if (!string.IsNullOrEmpty(cand?.ResumePath))
                                    {
                                        <a href="@cand.ResumePath"
                                           target="_blank"
                                           class="ats-resume-link">

                                            <i class="fa-solid fa-file-pdf text-danger"></i>
                                            Resume

                                        </a>
                                    }
                                    else
                                    {
                                        <span class="ats-no-resume">
                                            <i class="fa-regular fa-file me-1"></i>
                                            No Resume
                                        </span>
                                    }
                                </td>

                                <!-- Actions -->
                                <td class="text-end">

                                    <div class="ats-actions">

                                        <button class="btn ats-stage-btn"
                                                data-bs-toggle="modal"
                                                data-bs-target="#moveStageModal_@app.ApplicationId">

                                            <i class="fa-solid fa-arrow-right me-1"></i>
                                            Stage

                                        </button>

                                        <button class="btn ats-dropdown-btn dropdown-toggle dropdown-toggle-split"
                                                data-bs-toggle="dropdown"
                                                aria-expanded="false">
                                            <span class="visually-hidden">
                                                Toggle Dropdown
                                            </span>
                                        </button>

                                        <ul class="dropdown-menu dropdown-menu-end ats-dropdown">

                                            <li>
                                                <a class="dropdown-item small"
                                                   href="/HRRecruitment/InterviewSchedules?search=@Uri.EscapeDataString(cand?.FullName ?? "")">

                                                    <i class="fa-solid fa-calendar-plus me-2 text-primary"></i>
                                                    Schedule Interview

                                                </a>
                                            </li>

                                            <li>
                                                <a class="dropdown-item small"
                                                   href="/HRRecruitment/OfferLetters?search=@Uri.EscapeDataString(cand?.FullName ?? "")">

                                                    <i class="fa-solid fa-envelope-open-text me-2 text-success"></i>
                                                    Create Offer Letter

                                                </a>
                                            </li>

                                            <li>
                                                <hr class="dropdown-divider" />
                                            </li>

                                            <li>
                                                <form method="post"
                                                      action="/HRRecruitment/ChangeCandidateStatus">

                                                    @Html.AntiForgeryToken()

                                                    <input type="hidden"
                                                           name="applicationId"
                                                           value="@app.ApplicationId" />

                                                    <input type="hidden"
                                                           name="status"
                                                           value="Rejected" />

                                                    <button type="submit"
                                                            class="dropdown-item small text-danger">

                                                        <i class="fa-solid fa-user-xmark me-2"></i>
                                                        Reject Candidate

                                                    </button>

                                                </form>
                                            </li>

                                            <li>
                                                <form method="post"
                                                      action="/HRRecruitment/ChangeCandidateStatus">

                                                    @Html.AntiForgeryToken()

                                                    <input type="hidden"
                                                           name="applicationId"
                                                           value="@app.ApplicationId" />

                                                    <input type="hidden"
                                                           name="status"
                                                           value="On Hold" />

                                                    <button type="submit"
                                                            class="dropdown-item small text-warning">

                                                        <i class="fa-solid fa-pause me-2"></i>
                                                        Put On Hold

                                                    </button>

                                                </form>
                                            </li>

                                        </ul>

                                    </div>

                                </td>

                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="ats-empty-state text-center">

                                <div class="ats-empty-icon">
                                    <i class="fa-solid fa-users-slash fa-xl"></i>
                                </div>

                                <div class="ats-empty-title">
                                    No Candidates Found
                                </div>

                                <p class="ats-empty-text">
                                    No candidates match the selected filters.
                                    Try changing your search or filter criteria.
                                </p>

                            </td>
                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>

<!-- =========================================================
     CHANGE STAGE MODALS
     ========================================================= -->
@if (Model != null && Model.Any())
{
    foreach (var app in Model)
    {
        var cand = app.Candidate;
        var job = app.JobOpening;

        <div class="modal fade ats-modal"
             id="moveStageModal_@app.ApplicationId"
             tabindex="-1"
             aria-hidden="true">

            <div class="modal-dialog modal-dialog-centered">

                <div class="modal-content">

                    <div class="modal-header">

                        <h6 class="modal-title ats-modal-title">

                            <i class="fa-solid fa-arrow-right-to-bracket me-2"></i>

                            Move Candidate Stage

                        </h6>

                        <button type="button"
                                class="btn-close"
                                data-bs-dismiss="modal"
                                aria-label="Close">
                        </button>

                    </div>

                    <form method="post"
                          action="/HRRecruitment/ChangeCandidateStage">

                        @Html.AntiForgeryToken()

                        <input type="hidden"
                               name="applicationId"
                               value="@app.ApplicationId" />

                        <div class="modal-body text-start">

                            <div class="ats-modal-info">

                                Updating stage for candidate

                                <strong>
                                    @cand?.FullName
                                </strong>

                                <span class="mx-1">•</span>

                                Job:

                                <strong>
                                    @job?.JobTitle
                                </strong>

                            </div>

                            <div class="mb-3">

                                <label class="form-label fw-semibold">
                                    New Pipeline Stage
                                </label>

                                <select name="newStage"
                                        class="form-select form-select-sm"
                                        required>

                                    @foreach (var s in stages)
                                    {
                                        <option value="@s"
                                                selected="@(app.Stage == s ? "selected" : null)">
                                            @s
                                        </option>
                                    }

                                </select>

                            </div>

                            <div class="mb-1">

                                <label class="form-label fw-semibold">
                                    Notes / Reason for transition
                                </label>

                                <textarea name="reasonNotes"
                                  class="form-control form-control-sm"
                                  rows="3"
                                  placeholder="e.g. Cleared HR interview successfully, scheduling technical evaluation..."></textarea>

                            </div>

                        </div>

                        <div class="modal-footer">

                            <button type="button"
                                    class="btn btn-secondary ats-cancel-btn"
                                    data-bs-dismiss="modal">

                                Cancel

                            </button>

                            <button type="submit"
                                    class="btn btn-primary ats-submit-btn">

                                <i class="fa-solid fa-check me-1"></i>
                                Update Stage

                            </button>

                        </div>

                    </form>

                </div>

            </div>

        </div>
    }
}

<!-- =========================================================
     ADD CANDIDATE MODAL
     ========================================================= -->

<div class="modal fade ats-modal ats-add-modal"
     id="addCandidateModal"
     tabindex="-1"
     aria-hidden="true">

    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">

        <div class="modal-content">

            <div class="modal-header">

                <h5 class="modal-title ats-modal-title">

                    <i class="fa-solid fa-user-plus me-2"></i>

                    Add New Candidate

                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Close">
                </button>

            </div>

            <form method="post"
                  action="/HRRecruitment/AddCandidate"
                  enctype="multipart/form-data">

                @Html.AntiForgeryToken()

                <div class="modal-body p-4 text-start">

                    <div class="row g-3">

                        <!-- ================= JOB DETAILS ================= -->

                        <div class="col-12">

                            <div class="ats-form-section">

                                <div class="ats-form-section-title">
                                    <i class="fa-solid fa-briefcase"></i>
                                    Recruitment Details
                                </div>

                                <div class="row g-3">

                                    <div class="col-md-6">

                                        <label class="form-label fw-semibold">
                                            Job Opening
                                            <span class="text-danger">*</span>
                                        </label>

                                        <select name="jobId"
                                                class="form-select form-select-sm"
                                                required>

                                            <option value="">
                                                -- Select Job Opening --
                                            </option>

                                            @foreach (var j in jobOpenings)
                                            {
                                                <option value="@j.JobId">
                                                    @j.JobCode - @j.JobTitle (@j.Department?.DepartmentName)
                                                </option>
                                            }

                                        </select>

                                    </div>

                                    <div class="col-md-6">

                                        <label class="form-label fw-semibold">
                                            Initial Stage
                                        </label>

                                        <select name="initialStage"
                                                class="form-select form-select-sm">

                                            @foreach (var s in stages)
                                            {
                                                <option value="@s">
                                                    @s
                                                </option>
                                            }

                                        </select>

                                    </div>

                                </div>

                            </div>

                        </div>

                        <!-- ================= PERSONAL DETAILS ================= -->

                        <div class="col-12">

                            <div class="ats-form-section">

                                <div class="ats-form-section-title">
                                    <i class="fa-solid fa-user"></i>
                                    Candidate Information
                                </div>

                                <div class="row g-3">

                                    <div class="col-md-6">

                                        <label class="form-label fw-semibold">
                                            Full Name
                                            <span class="text-danger">*</span>
                                        </label>

                                        <input type="text"
                                               name="FullName"
                                               class="form-control form-control-sm"
                                               required
                                               placeholder="e.g. Arun Kumar" />

                                    </div>

                                    <div class="col-md-6">

                                        <label class="form-label fw-semibold">
                                            Email Address
                                            <span class="text-danger">*</span>
                                        </label>

                                        <input type="email"
                                               name="Email"
                                               class="form-control form-control-sm"
                                               required
                                               placeholder="arun@example.com" />

                                    </div>

                                    <div class="col-md-6">

                                        <label class="form-label fw-semibold">
                                            Phone Number
                                            <span class="text-danger">*</span>
                                        </label>

                                        <input type="text"
                                               name="Phone"
                                               class="form-control form-control-sm"
                                               required
                                               placeholder="+91 9876543210" />

                                    </div>

                                    <div class="col-md-6">

                                        <label class="form-label fw-semibold">
                                            Total Experience
                                        </label>

                                        <input type="text"
                                               name="Experience"
                                               class="form-control form-control-sm"
                                               placeholder="e.g. 3.5 Years" />

                                    </div>

                                    <div class="col-md-6">

                                        <label class="form-label fw-semibold">
                                            Education Qualification
                                        </label>

                                        <input type="text"
                                               name="Education"
                                               class="form-control form-control-sm"
                                               placeholder="e.g. B.Tech Computer Science" />

                                    </div>

                                    <div class="col-md-6">

                                        <label class="form-label fw-semibold">
                                            Current Company
                                        </label>

                                        <input type="text"
                                               name="CurrentCompany"
                                               class="form-control form-control-sm"
                                               placeholder="e.g. InfoSys Ltd" />

                                    </div>

                                </div>

                            </div>

                        </div>

                        <!-- ================= COMPENSATION ================= -->

                        <div class="col-12">

                            <div class="ats-form-section">

                                <div class="ats-form-section-title">
                                    <i class="fa-solid fa-money-bill-trend-up"></i>
                                    Compensation & Availability
                                </div>

                                <div class="row g-3">

                                    <div class="col-md-4">

                                        <label class="form-label fw-semibold">
                                            Current Salary (CTC PA)
                                        </label>

                                        <input type="number"
                                               name="CurrentSalary"
                                               class="form-control form-control-sm"
                                               placeholder="e.g. 600000" />

                                    </div>

                                    <div class="col-md-4">

                                        <label class="form-label fw-semibold">
                                            Expected Salary (CTC PA)
                                        </label>

                                        <input type="number"
                                               name="ExpectedSalary"
                                               class="form-control form-control-sm"
                                               placeholder="e.g. 850000" />

                                    </div>

                                    <div class="col-md-4">

                                        <label class="form-label fw-semibold">
                                            Notice Period
                                        </label>

                                        <input type="text"
                                               name="NoticePeriod"
                                               class="form-control form-control-sm"
                                               placeholder="e.g. 30 Days / Immediate" />

                                    </div>

                                </div>

                            </div>

                        </div>

                        <!-- ================= SKILLS & RESUME ================= -->

                        <div class="col-12">

                            <div class="ats-form-section">

                                <div class="ats-form-section-title">
                                    <i class="fa-solid fa-file-lines"></i>
                                    Resume & Skills
                                </div>

                                <div class="row g-3">

                                    <div class="col-md-6">

                                        <label class="form-label fw-semibold">
                                            Upload Resume (PDF / DOCX)
                                        </label>

                                        <input type="file"
                                               name="resumeFile"
                                               class="form-control form-control-sm"
                                               accept=".pdf,.doc,.docx" />

                                    </div>

                                    <div class="col-md-6">

                                        <label class="form-label fw-semibold">
                                            Key Skills
                                        </label>

                                        <input type="text"
                                               name="Skills"
                                               class="form-control form-control-sm"

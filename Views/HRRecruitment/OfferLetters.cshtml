@model IEnumerable<ERP_System.Models.OfferLetter>

@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Offer Letter Generation (ATS)";

    var selectedCandidates = ViewBag.SelectedCandidates as List<ERP_System.Models.CandidateApplication> ?? new List<ERP_System.Models.CandidateApplication>();
    var jobOpenings = ViewBag.JobOpenings as List<ERP_System.Models.JobOpening> ?? new List<ERP_System.Models.JobOpening>();
    var designations = ViewBag.Designations as List<ERP_System.Models.Designation> ?? new List<ERP_System.Models.Designation>();
    var departments = ViewBag.Departments as List<ERP_System.Models.Department> ?? new List<ERP_System.Models.Department>();
    var managers = ViewBag.Managers as List<ERP_System.Models.User> ?? new List<ERP_System.Models.User>();
    var roles = ViewBag.Roles as List<ERP_System.Models.Role> ?? new List<ERP_System.Models.Role>();
}

<style>
    .offer-page {
        --offer-primary: #2563eb;
        --offer-primary-dark: #1d4ed8;
        --offer-primary-soft: #eff6ff;
        --offer-success: #16a34a;
        --offer-success-soft: #ecfdf3;
        --offer-warning: #d97706;
        --offer-danger: #dc2626;
        --offer-text: #172033;
        --offer-muted: #6b7280;
        --offer-border: #e7ebf2;
        --offer-bg: #f7f9fc;
        --offer-card: #ffffff;
        --offer-shadow: 0 12px 32px rgba(15, 23, 42, .06);
        --offer-radius: 18px;
    }

    .offer-page {
        color: var(--offer-text);
    }

        .offer-page .offer-alert {
            border: 0;
            border-radius: 14px;
            box-shadow: 0 8px 24px rgba(15, 23, 42, .06);
            font-size: .86rem;
        }

        /* =========================
           PAGE HEADER
        ========================== */

        .offer-page .offer-header {
            position: relative;
            overflow: hidden;
            background: linear-gradient(135deg, #ffffff 0%, #f8fbff 100%);
            border: 1px solid var(--offer-border);
            border-radius: var(--offer-radius);
            padding: 1.35rem 1.5rem;
            margin-bottom: 1.25rem;
            box-shadow: var(--offer-shadow);
        }

            .offer-page .offer-header::before {
                content: "";
                position: absolute;
                width: 260px;
                height: 260px;
                right: -100px;
                top: -145px;
                border-radius: 50%;
                background: radial-gradient(circle, rgba(37, 99, 235, .12), transparent 68%);
                pointer-events: none;
            }

            .offer-page .offer-header::after {
                content: "";
                position: absolute;
                width: 150px;
                height: 150px;
                right: 80px;
                bottom: -120px;
                border-radius: 50%;
                background: radial-gradient(circle, rgba(79, 70, 229, .08), transparent 70%);
                pointer-events: none;
            }

        .offer-page .offer-header-content {
            position: relative;
            z-index: 2;
        }

        .offer-page .offer-title-section {
            display: flex;
            align-items: center;
            gap: .9rem;
        }

        .offer-page .offer-header-icon {
            width: 50px;
            height: 50px;
            min-width: 50px;
            border-radius: 15px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            color: #ffffff;
            font-size: 1.2rem;
            background: linear-gradient(135deg, #2563eb, #4f46e5);
            box-shadow: 0 10px 22px rgba(37, 99, 235, .25);
        }

        .offer-page .offer-page-title {
            font-size: 1.3rem;
            font-weight: 800;
            letter-spacing: -.025em;
            margin: 0 0 .18rem;
            color: var(--offer-text);
        }

        .offer-page .breadcrumb {
            margin-bottom: 0;
        }

        .offer-page .breadcrumb-item,
        .offer-page .breadcrumb-item a {
            font-size: .78rem;
            color: var(--offer-muted);
        }

            .offer-page .breadcrumb-item a:hover {
                color: var(--offer-primary);
            }

        .offer-page .offer-create-btn {
            border: 0;
            border-radius: 12px;
            padding: .68rem 1rem;
            font-size: .82rem;
            font-weight: 700;
            background: linear-gradient(135deg, var(--offer-primary), #4f46e5);
            box-shadow: 0 9px 20px rgba(37, 99, 235, .22);
            transition: all .2s ease;
            white-space: nowrap;
        }

            .offer-page .offer-create-btn:hover {
                transform: translateY(-2px);
                box-shadow: 0 13px 26px rgba(37, 99, 235, .28);
            }

        /* =========================
           FILTER CARD
        ========================== */

        .offer-page .offer-filter-card {
            background: var(--offer-card);
            border: 1px solid var(--offer-border);
            border-radius: var(--offer-radius);
            padding: 1.15rem;
            margin-bottom: 1.25rem;
            box-shadow: var(--offer-shadow);
        }

        .offer-page .offer-section-heading {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 1rem;
            margin-bottom: 1rem;
        }

        .offer-page .offer-section-title {
            font-size: .92rem;
            font-weight: 800;
            margin: 0;
            color: var(--offer-text);
        }

        .offer-page .offer-section-subtitle {
            font-size: .74rem;
            color: var(--offer-muted);
            margin: .18rem 0 0;
        }

        .offer-page .offer-filter-label {
            display: block;
            font-size: .72rem;
            font-weight: 700;
            color: #475569;
            margin-bottom: .38rem;
        }

        .offer-page .offer-search {
            border: 1px solid var(--offer-border);
            border-radius: 12px;
            overflow: hidden;
            transition: all .2s ease;
        }

            .offer-page .offer-search:focus-within {
                border-color: rgba(37, 99, 235, .55);
                box-shadow: 0 0 0 .2rem rgba(37, 99, 235, .08);
            }

            .offer-page .offer-search .input-group-text {
                border: 0;
                background: #ffffff;
                color: #94a3b8;
            }

            .offer-page .offer-search .form-control {
                border: 0;
                box-shadow: none;
                font-size: .82rem;
                min-height: 40px;
            }

        .offer-page .offer-select {
            min-height: 40px;
            border: 1px solid var(--offer-border);
            border-radius: 12px;
            font-size: .82rem;
            color: #334155;
            transition: all .2s ease;
        }

            .offer-page .offer-select:focus {
                border-color: rgba(37, 99, 235, .55);
                box-shadow: 0 0 0 .2rem rgba(37, 99, 235, .08);
            }

        .offer-page .offer-filter-btn {
            min-height: 40px;
            border-radius: 11px;
            font-size: .8rem;
            font-weight: 700;
        }

        /* =========================
           TABLE CARD
        ========================== */

        .offer-page .offer-table-card {
            background: var(--offer-card);
            border: 1px solid var(--offer-border);
            border-radius: var(--offer-radius);
            box-shadow: var(--offer-shadow);
            overflow: hidden;
        }

        .offer-page .offer-table-top {
            padding: 1.1rem 1.25rem;
            border-bottom: 1px solid var(--offer-border);
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 1rem;
            flex-wrap: wrap;
        }

        .offer-page .offer-table-title {
            font-size: .95rem;
            font-weight: 800;
            margin: 0;
        }

        .offer-page .offer-count {
            display: inline-flex;
            align-items: center;
            gap: .4rem;
            padding: .42rem .72rem;
            background: var(--offer-primary-soft);
            color: var(--offer-primary);
            border-radius: 999px;
            font-size: .72rem;
            font-weight: 750;
        }

        .offer-page .offer-table {
            margin-bottom: 0;
            min-width: 1120px;
        }

            .offer-page .offer-table thead th {
                background: #f8fafc;
                color: #64748b;
                border-bottom: 1px solid var(--offer-border);
                font-size: .68rem;
                font-weight: 800;
                letter-spacing: .05em;
                text-transform: uppercase;
                padding: .95rem 1rem;
                white-space: nowrap;
            }

            .offer-page .offer-table tbody td {
                padding: 1rem;
                vertical-align: middle;
                border-color: #eef1f5;
                font-size: .82rem;
            }

            .offer-page .offer-table tbody tr {
                transition: background .2s ease;
            }

                .offer-page .offer-table tbody tr:hover {
                    background: #fafcff;
                }

        .offer-page .offer-code {
            display: inline-flex;
            align-items: center;
            gap: .45rem;
            padding: .42rem .7rem;
            border-radius: 10px;
            background: #f8fafc;
            border: 1px solid #e8edf4;
            color: #334155;
            font-weight: 800;
            font-size: .76rem;
            white-space: nowrap;
        }

        .offer-page .offer-candidate {
            display: flex;
            align-items: center;
            gap: .72rem;
            min-width: 190px;
        }

        .offer-page .offer-avatar {
            width: 40px;
            height: 40px;
            min-width: 40px;
            border-radius: 13px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: .8rem;
            font-weight: 800;
            color: var(--offer-primary);
            background: linear-gradient(135deg, #dbeafe, #ede9fe);
            text-transform: uppercase;
        }

        .offer-page .offer-name {
            color: #1e293b;
            font-weight: 750;
            margin-bottom: .14rem;
        }

        .offer-page .offer-meta {
            font-size: .71rem;
            color: var(--offer-muted);
            line-height: 1.45;
        }

        .offer-page .offer-job {
            font-weight: 750;
            color: #334155;
            margin-bottom: .16rem;
        }

        .offer-page .offer-ctc {
            font-weight: 800;
            color: var(--offer-success);
            white-space: nowrap;
        }

        .offer-page .offer-date {
            font-weight: 700;
            color: #475569;
            white-space: nowrap;
        }

        .offer-page .offer-status {
            display: inline-flex;
            align-items: center;
            gap: .35rem;
            border-radius: 999px;
            padding: .45rem .7rem;
            font-size: .7rem;
            font-weight: 750;
            white-space: nowrap;
        }

        .offer-page .offer-converted {
            display: inline-flex;
            align-items: center;
            gap: .35rem;
            margin-top: .35rem;
            padding: .32rem .55rem;
            border-radius: 999px;
            background: var(--offer-success-soft);
            color: var(--offer-success);
            font-size: .64rem;
            font-weight: 750;
            white-space: nowrap;
        }

        .offer-page .offer-action-btn {
            border-radius: 10px;
            padding: .48rem .7rem;
            font-size: .72rem;
            font-weight: 700;
            white-space: nowrap;
        }

        .offer-page .dropdown-menu {
            border: 1px solid var(--offer-border);
            border-radius: 13px;
            padding: .4rem;
            min-width: 225px;
        }

        .offer-page .dropdown-item {
            border-radius: 9px;
            padding: .58rem .7rem;
            font-size: .78rem;
        }

        /* =========================
           EMPTY STATE
        ========================== */

        .offer-page .offer-empty {
            text-align: center;
            padding: 3.5rem 1rem;
        }

        .offer-page .offer-empty-icon {
            width: 62px;
            height: 62px;
            border-radius: 18px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            background: #f1f5f9;
            color: #94a3b8;
            font-size: 1.45rem;
            margin-bottom: .9rem;
        }

    /* =========================
           MODALS
        ========================== */

    .offer-modal .modal-content {
        border: 0;
        border-radius: 20px;
        overflow: hidden;
        box-shadow: 0 24px 60px rgba(15, 23, 42, .18);
    }

    .offer-modal .modal-header {
        padding: 1rem 1.3rem;
        border-bottom: 1px solid var(--offer-border);
        background: linear-gradient(135deg, #ffffff, #f8fbff);
    }

    .offer-modal .modal-title {
        font-size: 1rem;
        font-weight: 800;
        color: #1e293b;
    }

    .offer-modal .modal-footer {
        padding: .9rem 1.3rem;
        border-top: 1px solid var(--offer-border);
        background: #fafbfc;
    }

    .offer-modal .form-label {
        font-size: .74rem;
        font-weight: 750;
        color: #475569;
        margin-bottom: .38rem;
    }

    .offer-modal .form-control,
    .offer-modal .form-select {
        min-height: 40px;
        border: 1px solid var(--offer-border);
        border-radius: 11px;
        font-size: .82rem;
        transition: all .2s ease;
    }

    .offer-modal textarea.form-control {
        min-height: auto;
    }

    .offer-modal .form-control:focus,
    .offer-modal .form-select:focus {
        border-color: rgba(37, 99, 235, .55);
        box-shadow: 0 0 0 .2rem rgba(37, 99, 235, .08);
    }

    .offer-modal .offer-info-box {
        padding: 1rem;
        border: 1px solid #e4ebf6;
        border-radius: 14px;
        background: linear-gradient(135deg, #f8fbff, #f8fafc);
    }

        .offer-modal .offer-info-box p {
            font-size: .79rem;
            line-height: 1.65;
            margin-bottom: 0;
            color: #64748b;
        }

    .offer-modal .btn {
        border-radius: 10px;
        font-size: .8rem;
        font-weight: 700;
    }

    .offer-modal .offer-success-header {
        background: linear-gradient(135deg, #15803d, #16a34a);
        color: #ffffff;
        border-bottom: 0;
    }

    /* =========================
           RESPONSIVE
        ========================== */

    @@media (max-width: 991.98px) {
        .offer-page .offer-header {
            padding: 1.2rem;
        }

        .offer-page .offer-filter-card {
            padding: 1rem;
        }
    }

    @@media (max-width: 767.98px) {
        .offer-page {
            padding-top: .75rem !important;
        }

            .offer-page .offer-header {
                padding: 1rem;
                border-radius: 15px;
            }

            .offer-page .offer-header-content {
                flex-direction: column;
                align-items: stretch !important;
            }

            .offer-page .offer-create-btn {
                width: 100%;
                justify-content: center;
            }

            .offer-page .offer-filter-card,
            .offer-page .offer-table-card {
                border-radius: 15px;
            }

            .offer-page .offer-section-heading {
                align-items: flex-start;
                flex-direction: column;
            }

            .offer-page .offer-table-top {
                padding: 1rem;
            }

        .offer-modal .modal-dialog {
            margin: .75rem;
        }
    }

    @@media (max-width: 575.98px) {
        .offer-page .offer-title-section {
            align-items: flex-start;
        }

        .offer-page .offer-header-icon {
            width: 44px;
            height: 44px;
            min-width: 44px;
            border-radius: 13px;
            font-size: 1rem;
        }

        .offer-page .offer-page-title {
            font-size: 1.08rem;
        }

        .offer-page .offer-filter-actions {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: .5rem;
        }

            .offer-page .offer-filter-actions .btn {
                width: 100%;
            }
    }
</style>

<div class="container-fluid py-4 text-start offer-page">

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show offer-alert" role="alert">
            <i class="fa-solid fa-circle-check me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show offer-alert" role="alert">
            <i class="fa-solid fa-triangle-exclamation me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Header Section -->
    <div class="offer-header">
        <div class="offer-header-content d-flex justify-content-between align-items-center gap-3">
            <div class="offer-title-section">
                <div class="offer-header-icon">
                    <i class="fa-solid fa-envelope-open-text"></i>
                </div>

                <div>
                    <h4 class="offer-page-title">Offer Letter Generation</h4>

                    <nav aria-label="breadcrumb">
                        <ol class="breadcrumb">
                            <li class="breadcrumb-item">
                                <a href="/HR" class="text-decoration-none">HR Dashboard</a>
                            </li>
                            <li class="breadcrumb-item active" aria-current="page">Offer Letters</li>
                        </ol>
                    </nav>
                </div>
            </div>

            <button class="btn btn-primary offer-create-btn d-inline-flex align-items-center"
                    data-bs-toggle="modal"
                    data-bs-target="#generateOfferModal">
                <i class="fa-solid fa-file-signature me-2"></i>
                Generate Offer
            </button>
        </div>
    </div>

    <!-- Filters Bar -->
    <div class="offer-filter-card">

        <div class="offer-section-heading">
            <div>
                <h6 class="offer-section-title">
                    <i class="fa-solid fa-sliders me-2 text-primary"></i>
                    Search & Filter Offers
                </h6>
                <p class="offer-section-subtitle">
                    Find offer letters by offer code, candidate, job opening, or current status.
                </p>
            </div>
        </div>

        <form method="get" action="/HRRecruitment/OfferLetters" class="row g-3 align-items-end">

            <div class="col-xl-4 col-md-6">
                <label class="offer-filter-label">Search</label>

                <div class="input-group offer-search">
                    <span class="input-group-text">
                        <i class="fa-solid fa-magnifying-glass"></i>
                    </span>

                    <input type="text"
                           name="search"
                           class="form-control"
                           placeholder="Offer code, candidate, job..."
                           value="@ViewBag.Search" />
                </div>
            </div>

            <div class="col-xl-3 col-md-6">
                <label class="offer-filter-label">Job Opening</label>

                <select name="jobId" class="form-select offer-select" onchange="this.form.submit()">
                    <option value="">All Job Openings</option>

                    @foreach (var j in jobOpenings)
                    {
                        <option value="@j.JobId" selected="@(ViewBag.SelectedJobId == j.JobId ? "selected" : null)">
                            @j.JobCode - @j.JobTitle
                        </option>
                    }
                </select>
            </div>

            <div class="col-xl-3 col-md-6">
                <label class="offer-filter-label">Offer Status</label>

                <select name="status" class="form-select offer-select" onchange="this.form.submit()">
                    <option value="All">All Offer Statuses</option>
                    <option value="Approved" selected="@(ViewBag.SelectedStatus == "Approved" ? "selected" : null)">Approved</option>
                    <option value="Sent" selected="@(ViewBag.SelectedStatus == "Sent" ? "selected" : null)">Sent (Pending)</option>
                    <option value="Accepted" selected="@(ViewBag.SelectedStatus == "Accepted" ? "selected" : null)">Accepted</option>
                    <option value="Rejected" selected="@(ViewBag.SelectedStatus == "Rejected" ? "selected" : null)">Rejected</option>
                    <option value="Draft" selected="@(ViewBag.SelectedStatus == "Draft" ? "selected" : null)">Draft</option>
                </select>
            </div>

            <div class="col-xl-2 col-md-6">
                <div class="offer-filter-actions d-flex gap-2 justify-content-md-end">
                    <button type="submit" class="btn btn-primary offer-filter-btn px-3 flex-grow-1">
                        <i class="fa-solid fa-filter me-1"></i>
                        Filter
                    </button>

                    <a href="/HRRecruitment/OfferLetters"
                       class="btn btn-outline-secondary offer-filter-btn px-3">
                        <i class="fa-solid fa-rotate-left"></i>
                    </a>
                </div>
            </div>

        </form>
    </div>

    <!-- Offers List -->
    <div class="offer-table-card">

        <div class="offer-table-top">
            <div>
                <h6 class="offer-table-title">
                    <i class="fa-solid fa-envelope-circle-check me-2 text-primary"></i>
                    Offer Letter Management
                </h6>

                <div class="offer-section-subtitle">
                    Review, manage, print, approve, and convert accepted candidates into employees.
                </div>
            </div>

            <div class="offer-count">
                <i class="fa-solid fa-list"></i>
                @(Model?.Count() ?? 0) Offers
            </div>
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle offer-table">
                <thead>
                    <tr>
                        <th>Offer Code</th>
                        <th>Candidate</th>
                        <th>Job Title</th>
                        <th>CTC Offered</th>
                        <th>Joining Date</th>
                        <th>Expiry Date</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>

                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var offer in Model)
                        {
                            string badgeClass = offer.Status switch
                            {
                                "Accepted" => "bg-success-subtle text-success",
                                "Sent" => "bg-warning-subtle text-warning",
                                "Approved" => "bg-primary-subtle text-primary",
                                "Rejected" => "bg-danger-subtle text-danger",
                                "Draft" => "bg-secondary-subtle text-secondary",
                                _ => "bg-light text-dark"
                            };

                            bool isConverted = offer.ConvertedToEmployeeId.HasValue;

                            var candidateName = offer.Candidate?.FullName ?? "N/A";
                            var candidateInitials = string.Join("",
                            candidateName
                            .Split(' ', StringSplitOptions.RemoveEmptyEntries)
                            .Take(2)
                            .Select(x => x.Substring(0, 1))
                            ).ToUpper();

                            <tr>
                                <td>
                                    <span class="offer-code">
                                        <i class="fa-solid fa-hashtag text-primary"></i>
                                        @offer.OfferCode
                                    </span>
                                </td>

                                <td>
                                    <div class="offer-candidate">
                                        <div class="offer-avatar">
                                            @(string.IsNullOrEmpty(candidateInitials) ? "NA" : candidateInitials)
                                        </div>

                                        <div>
                                            <div class="offer-name">
                                                @(offer.Candidate?.FullName ?? "N/A")
                                            </div>

                                            <div class="offer-meta">
                                                <i class="fa-solid fa-envelope me-1"></i>
                                                @(offer.Candidate?.Email)
                                            </div>
                                        </div>
                                    </div>
                                </td>

                                <td>
                                    <div class="offer-job">
                                        @(offer.JobOpening?.JobTitle ?? "N/A")
                                    </div>

                                    <div class="offer-meta">
                                        <i class="fa-solid fa-building me-1"></i>
                                        @(offer.Department?.DepartmentName)
                                    </div>
                                </td>

                                <td>
                                    <div class="offer-ctc">
                                        <i class="fa-solid fa-indian-rupee-sign me-1"></i>
                                        @offer.OfferedCTC.ToString("N0")
                                    </div>

                                    <div class="offer-meta">
                                        Annual CTC
                                    </div>
                                </td>

                                <td>
                                    <div class="offer-date">
                                        <i class="fa-solid fa-calendar-check me-1 text-success"></i>
                                        @offer.ProposedJoiningDate.ToString("dd MMM yyyy")
                                    </div>
                                </td>

                                <td>
                                    <div class="offer-date">
                                        <i class="fa-solid fa-calendar-xmark me-1 text-danger"></i>
                                        @offer.OfferExpiryDate.ToString("dd MMM yyyy")
                                    </div>
                                </td>

                                <td>
                                    <span class="offer-status @badgeClass">
                                        <i class="fa-solid fa-circle-dot"></i>
                                        @offer.Status
                                    </span>

                                    @if (isConverted)
                                    {
                                        <div class="offer-converted">
                                            <i class="fa-solid fa-user-check"></i>
                                            Converted Employee
                                        </div>
                                    }
                                </td>

                                <td class="text-end">
                                    <div class="btn-group btn-group-sm">

                                        <a href="/HRRecruitment/PrintOffer?offerId=@offer.OfferId"
                                           target="_blank"
                                           class="btn btn-outline-primary offer-action-btn">
                                            <i class="fa-solid fa-print me-1"></i>
                                            View / Print
                                        </a>

                                        @if (offer.Status == "Accepted" && !isConverted)
                                        {
                                            <button class="btn btn-success offer-action-btn ms-1"
                                                    data-bs-toggle="modal"
                                                    data-bs-target="#convertModal_@offer.OfferId">
                                                <i class="fa-solid fa-user-plus me-1"></i>
                                                Convert
                                            </button>
                                        }

                                        <button class="btn btn-outline-secondary offer-action-btn dropdown-toggle dropdown-toggle-split"
                                                data-bs-toggle="dropdown"
                                                aria-expanded="false">
                                        </button>

                                        <ul class="dropdown-menu dropdown-menu-end shadow-sm">

                                            @if (offer.Status == "Approved" || offer.Status == "Draft")
                                            {
                                                <li>
                                                    <form method="post" action="/HRRecruitment/ChangeOfferStatus">
                                                        @Html.AntiForgeryToken()

                                                        <input type="hidden" name="offerId" value="@offer.OfferId" />
                                                        <input type="hidden" name="status" value="Sent" />

                                                        <button type="submit" class="dropdown-item text-primary">
                                                            <i class="fa-solid fa-paper-plane me-2"></i>
                                                            Mark Sent to Candidate
                                                        </button>
                                                    </form>
                                                </li>
                                            }

                                            @if (offer.Status == "Sent")
                                            {
                                                <li>
                                                    <form method="post" action="/HRRecruitment/ChangeOfferStatus">
                                                        @Html.AntiForgeryToken()

                                                        <input type="hidden" name="offerId" value="@offer.OfferId" />
                                                        <input type="hidden" name="status" value="Accepted" />

                                                        <button type="submit" class="dropdown-item text-success">
                                                            <i class="fa-solid fa-circle-check me-2"></i>
                                                            Mark Candidate Accepted
                                                        </button>
                                                    </form>
                                                </li>

                                                <li>
                                                    <form method="post" action="/HRRecruitment/ChangeOfferStatus">
                                                        @Html.AntiForgeryToken()

                                                        <input type="hidden" name="offerId" value="@offer.OfferId" />
                                                        <input type="hidden" name="status" value="Rejected" />

                                                        <button type="submit" class="dropdown-item text-danger">
                                                            <i class="fa-solid fa-circle-xmark me-2"></i>
                                                            Mark Candidate Rejected
                                                        </button>
                                                    </form>
                                                </li>
                                            }

                                            <li><hr class="dropdown-divider" /></li>

                                            <li>
                                                <form method="post" action="/HRRecruitment/ChangeOfferStatus">
                                                    @Html.AntiForgeryToken()

                                                    <input type="hidden" name="offerId" value="@offer.OfferId" />
                                                    <input type="hidden" name="status" value="Withdrawn" />

                                                    <button type="submit" class="dropdown-item text-secondary">
                                                        <i class="fa-solid fa-ban me-2"></i>
                                                        Revoke / Withdraw Offer
                                                    </button>
                                                </form>
                                            </li>

                                        </ul>
                                    </div>
                                </td>
                            </tr>

                            <!-- Modal: Convert Accepted Candidate to Employee -->
                            <div class="modal fade offer-modal"
                                 id="convertModal_@offer.OfferId"
                                 tabindex="-1"
                                 aria-hidden="true">

                                <div class="modal-dialog modal-dialog-centered">
                                    <div class="modal-content">

                                        <div class="modal-header offer-success-header">
                                            <h6 class="modal-title text-white">
                                                <i class="fa-solid fa-user-check me-2"></i>
                                                Convert Candidate to Employee
                                            </h6>

                                            <button type="button"
                                                    class="btn-close btn-close-white"
                                                    data-bs-dismiss="modal"
                                                    aria-label="Close">
                                            </button>
                                        </div>

                                        <form method="post" action="/HRRecruitment/ConvertCandidateToEmployee">
                                            @Html.AntiForgeryToken()

                                            <input type="hidden" name="offerId" value="@offer.OfferId" />

                                            <div class="modal-body p-4 text-start">

                                                <div class="offer-info-box mb-4">
                                                    <p>
                                                        <strong>@offer.Candidate?.FullName</strong>
                                                        (@offer.Candidate?.Email) will be registered in the ERP Employee Directory,
                                                        assigned a unique Employee Code, provided default credentials, and the
                                                        candidate pipeline stage will be updated to <strong>Hired</strong>.
                                                    </p>
                                                </div>

                                                <div class="mb-3">
                                                    <label class="form-label">
                                                        Assign Employee Role
                                                        <span class="text-danger">*</span>
                                                    </label>

                                                    <select name="roleId" class="form-select" required>
                                                        @foreach (var r in roles)
                                                        {
                                                            <option value="@r.RoleId"
                                                                    selected="@(r.RoleName == "Employee" ? "selected" : null)">
                                                                @r.RoleName
                                                            </option>
                                                        }
                                                    </select>
                                                </div>
                                            </div>

                                            <div class="modal-footer">
                                                <button type="button"
                                                        class="btn btn-light border px-3"
                                                        data-bs-dismiss="modal">
                                                    Cancel
                                                </button>

                                                <button type="submit" class="btn btn-success px-4">
                                                    <i class="fa-solid fa-check me-1"></i>
                                                    Confirm & Create Employee
                                                </button>
                                            </div>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8">
                                <div class="offer-empty">
                                    <div class="offer-empty-icon">
                                        <i class="fa-solid fa-envelope-circle-check"></i>
                                    </div>

                                    <h6 class="fw-bold mb-2">
                                        No Offer Letters Found
                                    </h6>

                                    <p class="text-muted small mb-0">
                                        No offer letters found matching the selected filters.
                                    </p>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal: Generate Offer Letter -->
<div class="modal fade offer-modal"
     id="generateOfferModal"
     tabindex="-1"
     aria-hidden="true">

    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">
                    <i class="fa-solid fa-file-signature text-primary me-2"></i>
                    Generate Offer Letter
                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Close">
                </button>
            </div>

            <form method="post" action="/HRRecruitment/CreateOffer">
                @Html.AntiForgeryToken()

                <div class="modal-body p-4 text-start">

                    <div class="row g-3">

                        <div class="col-md-12">
                            <label class="form-label">
                                Selected Candidate
                                <span class="text-danger">*</span>
                            </label>

                            <select name="applicationId" class="form-select" required>
                                <option value="">-- Select Selected Candidate --</option>

                                @foreach (var cand in selectedCandidates)
                                {
                                    <option value="@cand.ApplicationId">
                                        @cand.Candidate?.FullName - @cand.JobOpening?.JobTitle (Stage: @cand.Stage)
                                    </option>
                                }
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">
                                Offered CTC (Annual INR)
                                <span class="text-danger">*</span>
                            </label>

                            <input type="number"
                                   name="offeredCTC"
                                   class="form-control"
                                   required
                                   placeholder="e.g. 850000" />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">
                                Proposed Joining Date
                                <span class="text-danger">*</span>
                            </label>

                            <input type="date"
                                   name="proposedJoiningDate"
                                   class="form-control"
                                   value="@DateTime.Now.AddDays(15).ToString("yyyy-MM-dd")"
                                   required />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">
                                Offer Expiry Date
                            </label>

                            <input type="date"
                                   name="offerExpiryDate"
                                   class="form-control"
                                   value="@DateTime.Now.AddDays(7).ToString("yyyy-MM-dd")"
                                   required />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">
                                Reporting Manager
                            </label>

                            <select name="reportingManagerId" class="form-select">
                                <option value="">-- Select Manager --</option>

                                @foreach (var m in managers)
                                {
                                    <option value="@m.UserId">
                                        @m.FullName (@m.UserName)
                                    </option>
                                }
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">
                                Designation
                            </label>

                            <select name="designationId" class="form-select">
                                <option value="">-- Auto-detect from Job --</option>

                                @foreach (var d in designations)
                                {
                                    <option value="@d.DesignationId">
                                        @d.JobTitle
                                    </option>
                                }
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">
                                Department
                            </label>

                            <select name="departmentId" class="form-select">
                                <option value="">-- Auto-detect from Job --</option>

                                @foreach (var dept in departments)
                                {
                                    <option value="@dept.DepartmentId">
                                        @dept.DepartmentName
                                    </option>
                                }
                            </select>
                        </div>

                        <div class="col-md-12">
                            <label class="form-label">
                                Salary Structure Breakdown
                            </label>

                            <textarea name="salaryStructure"
                                      class="form-control"
                                      rows="3"
                                      placeholder="Basic: 50%, HRA: 25%, Special Allowance: 25%"></textarea>
                        </div>

                        <div class="col-md-12">
                            <label class="form-label">
                                Terms & Conditions
                            </label>

                            <textarea name="termsAndConditions"
                                      class="form-control"
                                      rows="4"
                                      placeholder="Standard employment contract terms, probation period, notice period requirements..."></textarea>
                        </div>

                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button"
                            class="btn btn-light border px-3"
                            data-bs-dismiss="modal">
                        Cancel
                    </button>

                    <button type="submit"
                            class="btn btn-primary px-4">
                        <i class="fa-solid fa-file-circle-plus me-1"></i>
                        Generate Offer
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
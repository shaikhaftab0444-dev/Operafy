@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Offer Letter Generation";
}

<div class="container-fluid py-4 text-start">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-bold mb-1"><i class="fa-solid fa-envelope-open-text text-primary me-2"></i>Offer Letter Generation</h4>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0 small">
                    <li class="breadcrumb-item"><a href="/HR" class="text-decoration-none">HR Dashboard</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Offer Letters</li>
                </ol>
            </nav>
        </div>
        <button class="btn btn-primary rounded-pill px-3 btn-sm shadow-sm"><i class="fa-solid fa-plus me-1.5"></i>Generate Offer</button>
    </div>

    <!-- Offers List -->
    <div class="bg-white border rounded-3 p-4 shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" style="font-size: 0.85rem;">
                <thead class="table-light">
                    <tr>
                        <th>Candidate</th>
                        <th>Job Title</th>
                        <th>CTC Offered</th>
                        <th>Offer Date</th>
                        <th>Expiry Date</th>
                        <th>Status</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td class="fw-bold text-dark">Ravi Teja</td>
                        <td>Software Engineer</td>
                        <td>₹8,50,000 PA</td>
                        <td>12 Aug 2026</td>
                        <td>19 Aug 2026</td>
                        <td><span class="badge bg-success-subtle text-success">Accepted</span></td>
                        <td><button class="btn btn-outline-secondary btn-xs rounded-pill px-2.5">View Acceptance</button></td>
                    </tr>
                    <tr>
                        <td class="fw-bold text-dark">Sanjay Dutt</td>
                        <td>Sales Executive</td>
                        <td>₹4,50,000 PA</td>
                        <td>18 Aug 2026</td>
                        <td>25 Aug 2026</td>
                        <td><span class="badge bg-warning-subtle text-warning">Sent (Pending Response)</span></td>
                        <td><button class="btn btn-outline-secondary btn-xs rounded-pill px-2.5">Revoke</button></td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

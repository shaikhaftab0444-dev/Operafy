@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Interview Schedules";
}

<div class="container-fluid py-4 text-start">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-bold mb-1"><i class="fa-solid fa-calendar-days text-primary me-2"></i>Interview Schedules</h4>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0 small">
                    <li class="breadcrumb-item"><a href="/HR" class="text-decoration-none">HR Dashboard</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Interview Schedules</li>
                </ol>
            </nav>
        </div>
        <button class="btn btn-primary rounded-pill px-3 btn-sm shadow-sm"><i class="fa-solid fa-calendar-plus me-1.5"></i>Schedule Round</button>
    </div>

    <!-- Schedules Table -->
    <div class="bg-white border rounded-3 p-4 shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" style="font-size: 0.85rem;">
                <thead class="table-light">
                    <tr>
                        <th>Candidate</th>
                        <th>Position</th>
                        <th>Round Name</th>
                        <th>Interviewer(s)</th>
                        <th>Date & Time</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td class="fw-bold text-dark">Arun Kumar</td>
                        <td>Junior Sales Representative</td>
                        <td>HR Interview</td>
                        <td>Aftab Shaik (HR)</td>
                        <td>21 Aug 2026, 03:00 PM</td>
                        <td><span class="badge bg-primary-subtle text-primary">Scheduled</span></td>
                    </tr>
                    <tr>
                        <td class="fw-bold text-dark">Pooja Patel</td>
                        <td>Lead Full-stack Developer</td>
                        <td>Technical Round 1</td>
                        <td>Rajesh Kumar (Tech)</td>
                        <td>22 Aug 2026, 11:30 AM</td>
                        <td><span class="badge bg-primary-subtle text-primary">Scheduled</span></td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

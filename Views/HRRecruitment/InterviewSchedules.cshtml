@model IEnumerable<ERP_System.Models.InterviewSchedule>

@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Interview Schedules (ATS)";

    var activeApplications = ViewBag.ActiveApplications as List<ERP_System.Models.CandidateApplication> ?? new List<ERP_System.Models.CandidateApplication>();
    var interviewers = ViewBag.Interviewers as List<ERP_System.Models.User> ?? new List<ERP_System.Models.User>();
    var jobOpenings = ViewBag.JobOpenings as List<ERP_System.Models.JobOpening> ?? new List<ERP_System.Models.JobOpening>();
}

<style>
    .ats-interview-page {
        --ats-primary: #2563eb;
        --ats-primary-dark: #1d4ed8;
        --ats-primary-light: #eff6ff;
        --ats-surface: #ffffff;
        --ats-bg: #f5f7fb;
        --ats-border: #e7ebf3;
        --ats-text: #172033;
        --ats-muted: #6b7280;
        --ats-radius: 18px;
        --ats-shadow: 0 10px 30px rgba(15, 23, 42, .06);
        color: var(--ats-text);
    }

        .ats-interview-page .ats-alert {
            border: 0;
            border-radius: 14px;
            box-shadow: 0 8px 22px rgba(15, 23, 42, .06);
        }

        .ats-interview-page .ats-page-header {
            background: linear-gradient(135deg, #ffffff 0%, #f8fbff 100%);
            border: 1px solid var(--ats-border);
            border-radius: var(--ats-radius);
            padding: 1.35rem 1.5rem;
            margin-bottom: 1.25rem;
            box-shadow: var(--ats-shadow);
            position: relative;
            overflow: hidden;
        }

            .ats-interview-page .ats-page-header::after {
                content: "";
                position: absolute;
                width: 220px;
                height: 220px;
                right: -100px;
                top: -130px;
                border-radius: 50%;
                background: radial-gradient(circle, rgba(37, 99, 235, .10), transparent 68%);
                pointer-events: none;
            }

        .ats-interview-page .ats-header-content {
            position: relative;
            z-index: 1;
        }

        .ats-interview-page .ats-title-wrap {
            display: flex;
            align-items: center;
            gap: .9rem;
        }

        .ats-interview-page .ats-title-icon {
            width: 48px;
            height: 48px;
            min-width: 48px;
            border-radius: 15px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            background: linear-gradient(135deg, #2563eb, #4f46e5);
            color: #fff;
            font-size: 1.15rem;
            box-shadow: 0 8px 18px rgba(37, 99, 235, .24);
        }

        .ats-interview-page .ats-page-title {
            font-size: 1.28rem;
            font-weight: 800;
            margin: 0 0 .2rem;
            letter-spacing: -.02em;
        }

        .ats-interview-page .breadcrumb {
            margin: 0;
        }

        .ats-interview-page .breadcrumb-item,
        .ats-interview-page .breadcrumb-item a {
            font-size: .78rem;
            color: var(--ats-muted);
        }

            .ats-interview-page .breadcrumb-item a:hover {
                color: var(--ats-primary);
            }

        .ats-interview-page .ats-primary-btn {
            border: 0;
            border-radius: 12px;
            padding: .68rem 1rem;
            font-size: .82rem;
            font-weight: 700;
            background: linear-gradient(135deg, var(--ats-primary), #4f46e5);
            box-shadow: 0 8px 18px rgba(37, 99, 235, .20);
            transition: transform .2s ease, box-shadow .2s ease;
            white-space: nowrap;
        }

            .ats-interview-page .ats-primary-btn:hover {
                transform: translateY(-2px);
                box-shadow: 0 12px 24px rgba(37, 99, 235, .28);
            }

        .ats-interview-page .ats-filter-card,
        .ats-interview-page .ats-table-card {
            background: var(--ats-surface);
            border: 1px solid var(--ats-border);
            border-radius: var(--ats-radius);
            box-shadow: var(--ats-shadow);
        }

        .ats-interview-page .ats-filter-card {
            padding: 1.15rem;
            margin-bottom: 1.25rem;
        }

        .ats-interview-page .ats-section-top {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: .75rem;
            margin-bottom: 1rem;
        }

        .ats-interview-page .ats-section-title {
            font-size: .9rem;
            font-weight: 800;
            margin: 0;
            color: var(--ats-text);
        }

        .ats-interview-page .ats-section-subtitle {
            font-size: .73rem;
            color: var(--ats-muted);
            margin: .15rem 0 0;
        }

        .ats-interview-page .ats-filter-label {
            font-size: .73rem;
            font-weight: 700;
            color: #4b5563;
            margin-bottom: .35rem;
        }

        .ats-interview-page .ats-search-group {
            border: 1px solid var(--ats-border);
            border-radius: 12px;
            overflow: hidden;
            transition: border-color .2s ease, box-shadow .2s ease;
        }

            .ats-interview-page .ats-search-group:focus-within {
                border-color: rgba(37, 99, 235, .55);
                box-shadow: 0 0 0 .2rem rgba(37, 99, 235, .08);
            }

            .ats-interview-page .ats-search-group .input-group-text {
                background: #fff;
                border: 0;
                color: #9ca3af;
            }

            .ats-interview-page .ats-search-group .form-control {
                border: 0;
                box-shadow: none;
                padding-top: .62rem;
                padding-bottom: .62rem;
            }

        .ats-interview-page .ats-filter-select,
        .ats-interview-page .ats-form-control {
            border: 1px solid var(--ats-border);
            border-radius: 12px;
            font-size: .82rem;
            min-height: 39px;
            transition: all .2s ease;
        }

            .ats-interview-page .ats-filter-select:focus,
            .ats-interview-page .ats-form-control:focus {
                border-color: rgba(37, 99, 235, .55);
                box-shadow: 0 0 0 .2rem rgba(37, 99, 235, .09);
            }

        .ats-interview-page .ats-filter-btn {
            border-radius: 11px;
            font-size: .8rem;
            font-weight: 700;
            min-height: 39px;
        }

        .ats-interview-page .ats-table-card {
            overflow: hidden;
        }

        .ats-interview-page .ats-table-header {
            padding: 1.1rem 1.25rem;
            border-bottom: 1px solid var(--ats-border);
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 1rem;
            flex-wrap: wrap;
        }

        .ats-interview-page .ats-table-title {
            font-size: .95rem;
            font-weight: 800;
            margin: 0;
        }

        .ats-interview-page .ats-record-count {
            display: inline-flex;
            align-items: center;
            gap: .35rem;
            padding: .38rem .7rem;
            border-radius: 999px;
            background: var(--ats-primary-light);
            color: var(--ats-primary);
            font-size: .72rem;
            font-weight: 700;
        }

        .ats-interview-page .ats-table {
            margin: 0;
            min-width: 1050px;
        }

            .ats-interview-page .ats-table thead th {
                background: #f8fafc;
                color: #64748b;
                border-bottom: 1px solid var(--ats-border);
                font-size: .69rem;
                font-weight: 800;
                letter-spacing: .04em;
                text-transform: uppercase;
                padding: .9rem 1rem;
                white-space: nowrap;
            }

            .ats-interview-page .ats-table tbody td {
                border-color: #eef1f6;
                padding: 1rem;
                vertical-align: middle;
                font-size: .82rem;
            }

            .ats-interview-page .ats-table tbody tr {
                transition: background .2s ease, transform .2s ease;
            }

                .ats-interview-page .ats-table tbody tr:hover {
                    background: #fafcff;
                }

        .ats-interview-page .ats-candidate-cell {
            display: flex;
            align-items: center;
            gap: .75rem;
            min-width: 180px;
        }

        .ats-interview-page .ats-avatar {
            width: 40px;
            height: 40px;
            min-width: 40px;
            border-radius: 13px;
            background: linear-gradient(135deg, #dbeafe, #ede9fe);
            color: #2563eb;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-weight: 800;
            font-size: .84rem;
            text-transform: uppercase;
        }

        .ats-interview-page .ats-name {
            font-weight: 750;
            color: #1e293b;
            margin-bottom: .15rem;
        }

        .ats-interview-page .ats-meta {
            color: var(--ats-muted);
            font-size: .72rem;
            line-height: 1.45;
        }

        .ats-interview-page .ats-job-name {
            font-weight: 700;
            color: #334155;
            margin-bottom: .15rem;
        }

        .ats-interview-page .ats-round-badge,
        .ats-interview-page .ats-mode-badge,
        .ats-interview-page .ats-status-badge {
            display: inline-flex;
            align-items: center;
            gap: .35rem;
            border-radius: 999px;
            padding: .42rem .65rem;
            font-size: .7rem;
            font-weight: 700;
            white-space: nowrap;
        }

        .ats-interview-page .ats-round-badge {
            background: #f8fafc;
            border: 1px solid #e5e7eb;
            color: #475569;
        }

        .ats-interview-page .ats-mode-badge {
            background: #f8fafc;
            border: 1px solid #e5e7eb;
            color: #475569;
        }

        .ats-interview-page .ats-date {
            font-weight: 750;
            color: #334155;
            white-space: nowrap;
        }

        .ats-interview-page .ats-time {
            color: var(--ats-muted);
            font-size: .72rem;
            margin-top: .18rem;
            white-space: nowrap;
        }

        .ats-interview-page .ats-status-badge {
            padding: .45rem .72rem;
        }

        .ats-interview-page .ats-action-btn {
            border-radius: 10px;
            font-size: .72rem;
            font-weight: 700;
            padding: .48rem .7rem;
        }

        .ats-interview-page .ats-rating-badge {
            display: inline-flex;
            align-items: center;
            gap: .35rem;
            border-radius: 10px;
            padding: .45rem .7rem;
            font-size: .72rem;
            font-weight: 750;
        }

        .ats-interview-page .dropdown-menu {
            border: 1px solid var(--ats-border);
            border-radius: 12px;
            padding: .4rem;
            min-width: 220px;
        }

        .ats-interview-page .dropdown-item {
            border-radius: 8px;
            padding: .58rem .7rem;
            font-size: .78rem;
        }

        .ats-interview-page .ats-empty-state {
            padding: 3.5rem 1rem;
            text-align: center;
        }

        .ats-interview-page .ats-empty-icon {
            width: 60px;
            height: 60px;
            border-radius: 18px;
            background: #f1f5f9;
            color: #94a3b8;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 1.4rem;
            margin-bottom: .8rem;
        }

    .ats-modal .modal-content {
        border: 0;
        border-radius: 20px;
        overflow: hidden;
        box-shadow: 0 24px 60px rgba(15, 23, 42, .18);
    }

    .ats-modal .modal-header {
        border-bottom: 1px solid var(--ats-border);
        padding: 1rem 1.25rem;
        background: linear-gradient(135deg, #ffffff, #f8fbff);
    }

    .ats-modal .modal-footer {
        border-top: 1px solid var(--ats-border);
        background: #fafbfc;
        padding: .9rem 1.25rem;
    }

    .ats-modal .modal-title {
        font-weight: 800;
        font-size: 1rem;
        color: #1e293b;
    }

    .ats-modal .form-label {
        font-size: .75rem;
        font-weight: 750;
        color: #475569;
        margin-bottom: .38rem;
    }

    .ats-modal .form-control,
    .ats-modal .form-select {
        border: 1px solid var(--ats-border);
        border-radius: 10px;
        font-size: .82rem;
        min-height: 39px;
    }

    .ats-modal textarea.form-control {
        min-height: auto;
    }

    .ats-modal .form-control:focus,
    .ats-modal .form-select:focus {
        border-color: rgba(37, 99, 235, .55);
        box-shadow: 0 0 0 .2rem rgba(37, 99, 235, .09);
    }

    .ats-modal .ats-info-panel {
        background: linear-gradient(135deg, #f8fbff, #f8fafc);
        border: 1px solid #e4ebf7;
        border-radius: 14px;
        padding: 1rem;
    }

    .ats-modal .ats-info-row {
        display: flex;
        align-items: center;
        gap: .55rem;
        font-size: .78rem;
        color: #64748b;
        margin-bottom: .45rem;
    }

        .ats-modal .ats-info-row:last-child {
            margin-bottom: 0;
        }

        .ats-modal .ats-info-row strong {
            color: #334155;
        }

    .ats-modal .btn {
        border-radius: 10px;
        font-size: .8rem;
        font-weight: 700;
    }

    @@media (max-width: 991.98px) {
        .ats-interview-page .ats-page-header {
            padding: 1.15rem;
        }

        .ats-interview-page .ats-filter-card {
            padding: 1rem;
        }
    }

    @@media (max-width: 767.98px) {
        .ats-interview-page {
            padding-top: .5rem !important;
        }

            .ats-interview-page .ats-page-header {
                border-radius: 15px;
            }

            .ats-interview-page .ats-header-content {
                flex-direction: column;
                align-items: stretch !important;
            }

            .ats-interview-page .ats-title-wrap {
                align-items: flex-start;
            }

            .ats-interview-page .ats-primary-btn {
                width: 100%;
                justify-content: center;
            }

            .ats-interview-page .ats-filter-card,
            .ats-interview-page .ats-table-card {
                border-radius: 15px;
            }

            .ats-interview-page .ats-section-top {
                align-items: flex-start;
                flex-direction: column;
            }

            .ats-interview-page .ats-table-header {
                padding: 1rem;
            }

        .ats-modal .modal-dialog {
            margin: .75rem;
        }
    }

    @@media (max-width: 575.98px) {
        .ats-interview-page .ats-title-icon {
            width: 42px;
            height: 42px;
            min-width: 42px;
            border-radius: 13px;
        }

        .ats-interview-page .ats-page-title {
            font-size: 1.08rem;
        }

        .ats-interview-page .ats-filter-actions {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: .5rem;
        }

            .ats-interview-page .ats-filter-actions .btn {
                width: 100%;
            }
    }
</style>

<div class="container-fluid py-4 text-start ats-interview-page">

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show ats-alert" role="alert">
            <i class="fa-solid fa-circle-check me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show ats-alert" role="alert">
            <i class="fa-solid fa-triangle-exclamation me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Header Section -->
    <div class="ats-page-header">
        <div class="ats-header-content d-flex justify-content-between align-items-center gap-3">
            <div class="ats-title-wrap">
                <div class="ats-title-icon">
                    <i class="fa-solid fa-calendar-days"></i>
                </div>

                <div>
                    <h4 class="ats-page-title">Interview Schedules</h4>
                    <nav aria-label="breadcrumb">
                        <ol class="breadcrumb">
                            <li class="breadcrumb-item">
                                <a href="/HR" class="text-decoration-none">HR Dashboard</a>
                            </li>
                            <li class="breadcrumb-item active" aria-current="page">Interview Schedules</li>
                        </ol>
                    </nav>
                </div>
            </div>

            <button class="btn btn-primary ats-primary-btn d-inline-flex align-items-center" data-bs-toggle="modal" data-bs-target="#scheduleInterviewModal">
                <i class="fa-solid fa-calendar-plus me-2"></i>
                Schedule Round
            </button>
        </div>
    </div>

    <!-- Filters Section -->
    <div class="ats-filter-card">
        <div class="ats-section-top">
            <div>
                <h6 class="ats-section-title">
                    <i class="fa-solid fa-sliders me-2 text-primary"></i>Search & Filter Interviews
                </h6>
                <p class="ats-section-subtitle">Quickly find schedules by candidate, job opening, or interview status.</p>
            </div>
        </div>

        <form method="get" action="/HRRecruitment/InterviewSchedules" class="row g-3 align-items-end">

            <div class="col-xl-4 col-md-6">
                <label class="ats-filter-label">Search</label>
                <div class="input-group ats-search-group">
                    <span class="input-group-text">
                        <i class="fa-solid fa-magnifying-glass"></i>
                    </span>
                    <input type="text"
                           name="search"
                           class="form-control"
                           placeholder="Candidate, job or interviewer..."
                           value="@ViewBag.Search" />
                </div>
            </div>

            <div class="col-xl-3 col-md-6">
                <label class="ats-filter-label">Job Opening</label>
                <select name="jobId" class="form-select ats-filter-select" onchange="this.form.submit()">
                    <option value="">All Job Openings</option>
                    @foreach (var j in jobOpenings)
                    {
                        <option value="@j.JobId" selected="@(ViewBag.SelectedJobId == j.JobId ? "selected" : null)">
                            @j.JobCode - @j.JobTitle
                        </option>
                    }
                </select>
            </div>

            <div class="col-xl-3 col-md-6">
                <label class="ats-filter-label">Interview Status</label>
                <select name="status" class="form-select ats-filter-select" onchange="this.form.submit()">
                    <option value="All">All Statuses</option>
                    <option value="Scheduled" selected="@(ViewBag.SelectedStatus == "Scheduled" ? "selected" : null)">Scheduled</option>
                    <option value="Confirmed" selected="@(ViewBag.SelectedStatus == "Confirmed" ? "selected" : null)">Confirmed</option>
                    <option value="Completed" selected="@(ViewBag.SelectedStatus == "Completed" ? "selected" : null)">Completed</option>
                    <option value="Rescheduled" selected="@(ViewBag.SelectedStatus == "Rescheduled" ? "selected" : null)">Rescheduled</option>
                    <option value="Cancelled" selected="@(ViewBag.SelectedStatus == "Cancelled" ? "selected" : null)">Cancelled</option>
                </select>
            </div>

            <div class="col-xl-2 col-md-6">
                <div class="ats-filter-actions d-flex gap-2 justify-content-md-end">
                    <button type="submit" class="btn btn-primary ats-filter-btn px-3 flex-grow-1">
                        <i class="fa-solid fa-filter me-1"></i>Filter
                    </button>
                    <a href="/HRRecruitment/InterviewSchedules" class="btn btn-outline-secondary ats-filter-btn px-3">
                        <i class="fa-solid fa-rotate-left"></i>
                    </a>
                </div>
            </div>

        </form>
    </div>

    <!-- Interview Schedules Table -->
    <div class="ats-table-card">

        <div class="ats-table-header">
            <div>
                <h6 class="ats-table-title">
                    <i class="fa-solid fa-calendar-check me-2 text-primary"></i>Scheduled Interviews
                </h6>
                <div class="ats-section-subtitle">Manage upcoming, completed, and candidate interview rounds.</div>
            </div>

            <div class="ats-record-count">
                <i class="fa-solid fa-list"></i>
                @(Model?.Count() ?? 0) Records
            </div>
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle ats-table">
                <thead>
                    <tr>
                        <th>Candidate</th>
                        <th>Position</th>
                        <th>Round</th>
                        <th>Mode</th>
                        <th>Interviewer(s)</th>
                        <th>Date & Time</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>

                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var interview in Model)
                        {
                            string badgeClass = interview.Status switch
                            {
                                "Scheduled" => "bg-primary-subtle text-primary",
                                "Confirmed" => "bg-info-subtle text-info",
                                "Completed" => "bg-success-subtle text-success",
                                "Rescheduled" => "bg-warning-subtle text-warning",
                                "Cancelled" => "bg-danger-subtle text-danger",
                                _ => "bg-light text-dark"
                            };

                            var feedback = interview.Feedbacks?.FirstOrDefault();

                            var candidateName = interview.Candidate?.FullName ?? "N/A";
                            var candidateInitials = string.Join("",
                            candidateName
                            .Split(' ', StringSplitOptions.RemoveEmptyEntries)
                            .Take(2)
                            .Select(x => x.Substring(0, 1))
                            ).ToUpper();

                            <tr>
                                <td>
                                    <div class="ats-candidate-cell">
                                        <div class="ats-avatar">
                                            @(string.IsNullOrEmpty(candidateInitials) ? "NA" : candidateInitials)
                                        </div>

                                        <div>
                                            <div class="ats-name">@candidateName</div>
                                            <div class="ats-meta">
                                                <i class="fa-solid fa-envelope me-1"></i>@(interview.Candidate?.Email)
                                            </div>
                                        </div>
                                    </div>
                                </td>

                                <td>
                                    <div class="ats-job-name">@(interview.JobOpening?.JobTitle ?? "N/A")</div>
                                    <div class="ats-meta">
                                        <i class="fa-solid fa-briefcase me-1"></i>@interview.JobOpening?.JobCode
                                    </div>
                                </td>

                                <td>
                                    <span class="ats-round-badge">
                                        <i class="fa-solid fa-layer-group"></i>
                                        @interview.InterviewRound
                                    </span>
                                </td>

                                <td>
                                    <span class="ats-mode-badge">
                                        <i class="fa-solid @(interview.InterviewMode == "Online" ? "fa-video" : "fa-building")"></i>
                                        @interview.InterviewMode
                                    </span>
                                </td>

                                <td>
                                    <div class="fw-semibold text-dark small">
                                        @(string.IsNullOrEmpty(interview.InterviewerNames) ? "Assigned HR/Tech" : interview.InterviewerNames)
                                    </div>
                                </td>

                                <td>
                                    <div class="ats-date">
                                        <i class="fa-solid fa-calendar me-1 text-primary"></i>
                                        @interview.ScheduledDate.ToString("dd MMM yyyy")
                                    </div>

                                    <div class="ats-time">
                                        <i class="fa-solid fa-clock me-1"></i>
                                        @interview.StartTime - @interview.EndTime
                                    </div>
                                </td>

                                <td>
                                    <span class="ats-status-badge @badgeClass">
                                        <i class="fa-solid fa-circle-dot"></i>
                                        @interview.Status
                                    </span>
                                </td>

                                <td class="text-end">
                                    <div class="btn-group btn-group-sm">

                                        @if (interview.Status != "Completed")
                                        {
                                            <button class="btn btn-outline-primary ats-action-btn"
                                                    data-bs-toggle="modal"
                                                    data-bs-target="#feedbackModal_@interview.InterviewId">
                                                <i class="fa-solid fa-comment-dots me-1"></i>Feedback
                                            </button>
                                        }
                                        else
                                        {
                                            <span class="ats-rating-badge bg-success-subtle text-success">
                                                <i class="fa-solid fa-star"></i>
                                                @(feedback != null ? $"{feedback.OverallRating} / 5.0" : "Done")
                                            </span>
                                        }

                                        <button class="btn btn-outline-secondary ats-action-btn dropdown-toggle dropdown-toggle-split"
                                                data-bs-toggle="dropdown"
                                                aria-expanded="false">
                                        </button>

                                        <ul class="dropdown-menu dropdown-menu-end shadow-sm">

                                            @if (!string.IsNullOrEmpty(interview.MeetingLink))
                                            {
                                                <li>
                                                    <a class="dropdown-item" href="@interview.MeetingLink" target="_blank">
                                                        <i class="fa-solid fa-video me-2 text-primary"></i>
                                                        Join Online Meeting
                                                    </a>
                                                </li>
                                            }

                                            <li>
                                                <form method="post" action="/HRRecruitment/ChangeInterviewStatus">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="interviewId" value="@interview.InterviewId" />
                                                    <input type="hidden" name="status" value="Confirmed" />

                                                    <button type="submit" class="dropdown-item">
                                                        <i class="fa-solid fa-circle-check me-2 text-info"></i>
                                                        Mark Confirmed
                                                    </button>
                                                </form>
                                            </li>

                                            <li><hr class="dropdown-divider" /></li>

                                            <li>
                                                <form method="post" action="/HRRecruitment/ChangeInterviewStatus">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="interviewId" value="@interview.InterviewId" />
                                                    <input type="hidden" name="status" value="Cancelled" />

                                                    <button type="submit" class="dropdown-item text-danger">
                                                        <i class="fa-solid fa-ban me-2"></i>
                                                        Cancel Interview
                                                    </button>
                                                </form>
                                            </li>

                                        </ul>
                                    </div>
                                </td>
                            </tr>

                            <!-- Modal: Submit Interview Feedback -->
                            <div class="modal fade ats-modal" id="feedbackModal_@interview.InterviewId" tabindex="-1" aria-hidden="true">
                                <div class="modal-dialog modal-lg modal-dialog-centered">
                                    <div class="modal-content">

                                        <div class="modal-header">
                                            <h6 class="modal-title">
                                                <i class="fa-solid fa-clipboard-check text-primary me-2"></i>
                                                Interview Feedback & Rating
                                            </h6>

                                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                        </div>

                                        <form method="post" action="/HRRecruitment/SubmitInterviewFeedback">
                                            @Html.AntiForgeryToken()

                                            <input type="hidden" name="interviewId" value="@interview.InterviewId" />

                                            <div class="modal-body p-4 text-start">

                                                <div class="ats-info-panel mb-4">
                                                    <div class="ats-info-row">
                                                        <i class="fa-solid fa-user text-primary"></i>
                                                        <span><strong>Candidate:</strong> @interview.Candidate?.FullName</span>
                                                    </div>

                                                    <div class="ats-info-row">
                                                        <i class="fa-solid fa-briefcase text-primary"></i>
                                                        <span><strong>Position:</strong> @interview.JobOpening?.JobTitle</span>
                                                    </div>

                                                    <div class="ats-info-row">
                                                        <i class="fa-solid fa-layer-group text-primary"></i>
                                                        <span><strong>Round:</strong> @interview.InterviewRound</span>
                                                    </div>
                                                </div>

                                                <div class="row g-3">

                                                    <div class="col-md-4">
                                                        <label class="form-label">Technical Skills (1-5)</label>
                                                        <select name="technicalRating" class="form-select">
                                                            <option value="5">5 - Outstanding</option>
                                                            <option value="4" selected>4 - Exceeds Expectations</option>
                                                            <option value="3">3 - Meets Expectations</option>
                                                            <option value="2">2 - Below Expectations</option>
                                                            <option value="1">1 - Poor</option>
                                                        </select>
                                                    </div>

                                                    <div class="col-md-4">
                                                        <label class="form-label">Communication (1-5)</label>
                                                        <select name="communicationRating" class="form-select">
                                                            <option value="5">5 - Outstanding</option>
                                                            <option value="4" selected>4 - Exceeds Expectations</option>
                                                            <option value="3">3 - Meets Expectations</option>
                                                            <option value="2">2 - Below Expectations</option>
                                                            <option value="1">1 - Poor</option>
                                                        </select>
                                                    </div>

                                                    <div class="col-md-4">
                                                        <label class="form-label">Problem Solving (1-5)</label>
                                                        <select name="problemSolvingRating" class="form-select">
                                                            <option value="5">5 - Outstanding</option>
                                                            <option value="4" selected>4 - Exceeds Expectations</option>
                                                            <option value="3">3 - Meets Expectations</option>
                                                            <option value="2">2 - Below Expectations</option>
                                                            <option value="1">1 - Poor</option>
                                                        </select>
                                                    </div>

                                                    <div class="col-md-6">
                                                        <label class="form-label">
                                                            Overall Recommendation
                                                            <span class="text-danger">*</span>
                                                        </label>

                                                        <select name="recommendation" class="form-select" required>
                                                            <option value="Strongly Recommend">Strongly Recommend</option>
                                                            <option value="Recommend" selected>Recommend</option>
                                                            <option value="Neutral">Neutral</option>
                                                            <option value="Do Not Recommend">Do Not Recommend</option>
                                                            <option value="Strongly Do Not Recommend">Strongly Do Not Recommend</option>
                                                        </select>
                                                    </div>

                                                    <div class="col-md-6">
                                                        <label class="form-label">Cultural Fit & Attitude (1-5)</label>

                                                        <select name="culturalFitRating" class="form-select">
                                                            <option value="5">5 - Outstanding</option>
                                                            <option value="4" selected>4 - Exceeds Expectations</option>
                                                            <option value="3">3 - Meets Expectations</option>
                                                        </select>
                                                    </div>

                                                    <div class="col-md-6">
                                                        <label class="form-label">Key Strengths</label>

                                                        <textarea name="strengths"
                                                          class="form-control"
                                                          rows="3"
                                                          placeholder="e.g. Excellent domain knowledge, confident communicator..."></textarea>
                                                    </div>

                                                    <div class="col-md-6">
                                                        <label class="form-label">Areas of Improvement / Weaknesses</label>

                                                        <textarea name="weaknesses"
                                                          class="form-control"
                                                          rows="3"
                                                          placeholder="e.g. Needs deeper hands-on practice with microservices..."></textarea>
                                                    </div>

                                                    <div class="col-md-12">
                                                        <label class="form-label">Detailed Evaluation Comments</label>

                                                        <textarea name="comments"
                                                          class="form-control"
                                                          rows="4"
                                                          placeholder="Detailed interviewer remarks..."></textarea>
                                                    </div>

                                                </div>
                                            </div>

                                            <div class="modal-footer">
                                                <button type="button"
                                                        class="btn btn-light border px-3"
                                                        data-bs-dismiss="modal">
                                                    Cancel
                                                </button>

                                                <button type="submit" class="btn btn-success px-4">
                                                    <i class="fa-solid fa-check me-1"></i>
                                                    Submit Evaluation
                                                </button>
                                            </div>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8">
                                <div class="ats-empty-state">
                                    <div class="ats-empty-icon">
                                        <i class="fa-solid fa-calendar-xmark"></i>
                                    </div>

                                    <h6 class="fw-bold mb-2">No Interview Schedules Found</h6>

                                    <p class="text-muted small mb-0">
                                        No interview schedules found matching the selected filters.
                                    </p>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal: Schedule Interview -->
<div class="modal fade ats-modal" id="scheduleInterviewModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">
                    <i class="fa-solid fa-calendar-plus text-primary me-2"></i>
                    Schedule Interview Round
                </h5>

                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <form method="post" action="/HRRecruitment/CreateInterview">
                @Html.AntiForgeryToken()

                <div class="modal-body p-4 text-start">

                    <div class="row g-3">

                        <div class="col-md-12">
                            <label class="form-label">
                                Select Candidate Application
                                <span class="text-danger">*</span>
                            </label>

                            <select name="applicationId" class="form-select" required>
                                <option value="">-- Select Active Candidate Application --</option>

                                @foreach (var app in activeApplications)
                                {
                                    <option value="@app.ApplicationId">
                                        @app.Candidate?.FullName - @app.JobOpening?.JobTitle (Stage: @app.Stage)
                                    </option>
                                }
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">
                                Interview Round Name
                                <span class="text-danger">*</span>
                            </label>

                            <select name="interviewRound" class="form-select" required>
                                <option value="HR Interview">HR Interview</option>
                                <option value="Technical Round 1">Technical Round 1</option>
                                <option value="Technical Round 2">Technical Round 2</option>
                                <option value="Managerial Interview">Managerial Interview</option>
                                <option value="Final Round">Final Round</option>
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">Interview Mode</label>

                            <select name="interviewMode" class="form-select">
                                <option value="Online">Online (Video Call)</option>
                                <option value="In-Person">In-Person (Office)</option>
                                <option value="Phone">Phone Screening</option>
                            </select>
                        </div>

                        <div class="col-md-4">
                            <label class="form-label">
                                Scheduled Date
                                <span class="text-danger">*</span>
                            </label>

                            <input type="date"
                                   name="scheduledDate"
                                   class="form-control"
                                   value="@DateTime.Now.AddDays(1).ToString("yyyy-MM-dd")"
                                   required />
                        </div>

                        <div class="col-md-4">
                            <label class="form-label">Start Time</label>

                            <input type="text"
                                   name="startTime"
                                   class="form-control"
                                   value="10:00 AM"
                                   placeholder="10:00 AM" />
                        </div>

                        <div class="col-md-4">
                            <label class="form-label">End Time</label>

                            <input type="text"
                                   name="endTime"
                                   class="form-control"
                                   value="11:00 AM"
                                   placeholder="11:00 AM" />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">Assigned Interviewer</label>

                            <select name="interviewerId" class="form-select">
                                <option value="">-- Select Interviewer --</option>

                                @foreach (var u in interviewers)
                                {
                                    <option value="@u.UserId">
                                        @u.FullName (@u.UserName)
                                    </option>
                                }
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">Online Meeting Link (Google Meet / Teams / Zoom)</label>

                            <input type="url"
                                   name="meetingLink"
                                   class="form-control"
                                   placeholder="https://meet.google.com/xyz-uvwx-rst" />
                        </div>

                        <div class="col-md-12">
                            <label class="form-label">Location / Additional Instructions</label>

                            <textarea name="notes"
                                      class="form-control"
                                      rows="3"
                                      placeholder="e.g. Conference Room A, Head Office, Hyderabad"></textarea>
                        </div>

                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button"
                            class="btn btn-light border px-3"
                            data-bs-dismiss="modal">
                        Cancel
                    </button>

                    <button type="submit" class="btn btn-primary px-4">
                        <i class="fa-solid fa-calendar-check me-1"></i>
                        Confirm Schedule
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
@model IEnumerable<ERP_System.Models.JobOpening>

@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Job Openings (ATS)";

    var departments = ViewBag.Departments as List<ERP_System.Models.Department>
                      ?? new List<ERP_System.Models.Department>();

    var designations = ViewBag.Designations as List<ERP_System.Models.Designation>
                       ?? new List<ERP_System.Models.Designation>();

    var users = ViewBag.Users as List<ERP_System.Models.User>
                ?? new List<ERP_System.Models.User>();

    var jobs = Model?.ToList() ?? new List<ERP_System.Models.JobOpening>();

    var totalJobs = jobs.Count;
    var openJobs = jobs.Count(j => j.Status == "Open");
    var onHoldJobs = jobs.Count(j => j.Status == "On Hold");
    var closedJobs = jobs.Count(j => j.Status == "Closed");

    var totalVacancies = jobs.Sum(j => j.Vacancies);

    var totalApplicants = jobs.Sum(j => j.Applications?.Count ?? 0);

    var remoteJobs = jobs.Count(j =>
        j.WorkMode == "Remote" ||
        j.WorkMode == "Hybrid");

    var fillRate = totalVacancies > 0
        ? Math.Min(100, (totalApplicants * 100) / totalVacancies)
        : 0;
}


@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Job Openings (ATS)";
}

<div class="container-fluid py-4 text-start">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-bold mb-1"><i class="fa-solid fa-briefcase text-primary me-2"></i>Job Openings</h4>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0 small">
                    <li class="breadcrumb-item"><a href="/HR" class="text-decoration-none">HR Dashboard</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Job Openings</li>
                </ol>
            </nav>
        </div>
        <button class="btn btn-primary rounded-pill px-3 btn-sm shadow-sm"><i class="fa-solid fa-plus me-1.5"></i>Create Opening</button>
    </div>

    <!-- Openings Table -->
    <div class="bg-white border rounded-3 p-4 shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" style="font-size: 0.85rem;">
                <thead class="table-light">
                    <tr>
                        <th>Job Code</th>
                        <th>Job Title</th>
                        <th>Department</th>
                        <th>Experience Required</th>
                        <th>Applicants</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td class="fw-bold text-dark">JOB-1021</td>
                        <td>Junior Sales Representative</td>
                        <td>Sales & Marketing</td>
                        <td>1-2 Years</td>
                        <td>14 Candidates</td>
                        <td><span class="badge bg-success-subtle text-success">Open & Active</span></td>
                    </tr>
                    <tr>
                        <td class="fw-bold text-dark">JOB-1022</td>
                        <td>Lead Full-stack Developer</td>
                        <td>Software Engineering</td>
                        <td>5+ Years</td>
                        <td>8 Candidates</td>
                        <td><span class="badge bg-success-subtle text-success">Open & Active</span></td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

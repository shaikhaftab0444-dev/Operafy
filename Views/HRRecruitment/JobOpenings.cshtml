            padding: 16px;
        }

        .ats-table-header {
            align-items: flex-start;
            flex-direction: column;
        }

        .ats-opening-count {
            width: 100%;
            justify-content: center;
        }
    }

    @@media (max-width: 575.98px) {

        .ats-header {
            gap: 16px;
        }

        .ats-stat-card {
            min-height: 135px;
            padding: 16px;
        }

        .ats-modal .modal-body,
        .ats-modal .modal-footer {
            padding: 18px;
        }

        .ats-modal .modal-footer {
            flex-direction: column-reverse;
        }

            .ats-modal .modal-footer .btn {
                width: 100%;
            }
    }

    @@media (prefers-reduced-motion: reduce) {

        .ats-page *,
        .ats-page *::before,
        .ats-page *::after {
            animation-duration: .01ms !important;
            animation-iteration-count: 1 !important;
            transition-duration: .01ms !important;
        }
    }
</style>


<div class="container-fluid py-4 text-start ats-page">

    <!-- =====================================================
         ALERTS
    ====================================================== -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert ats-alert ats-alert-success alert-dismissible fade show" role="alert">

            <i class="fa-solid fa-circle-check fs-5"></i>

            <span>
                @TempData["SuccessMessage"]
            </span>

            <button type="button"
                    class="btn-close ms-auto"
                    data-bs-dismiss="alert"
                    aria-label="Close">
            </button>

        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert ats-alert ats-alert-danger alert-dismissible fade show" role="alert">

            <i class="fa-solid fa-triangle-exclamation fs-5"></i>

            <span>
                @TempData["ErrorMessage"]
            </span>

            <button type="button"
                    class="btn-close ms-auto"
                    data-bs-dismiss="alert"
                    aria-label="Close">
            </button>

        </div>
    }


    <!-- =====================================================
         PAGE HEADER
    ====================================================== -->

    <div class="ats-header">

        <div>

            <div class="ats-breadcrumb">

                <a href="/HR">
                    HR Dashboard
                </a>

                <span class="ats-breadcrumb-separator">
                    <i class="fa-solid fa-chevron-right"></i>
                </span>

                <span class="ats-breadcrumb-current">
                    Recruitment
                </span>

                <span class="ats-breadcrumb-separator">
                    <i class="fa-solid fa-chevron-right"></i>
                </span>

                <span class="ats-breadcrumb-current">
                    Job Openings
                </span>

            </div>


            <div class="ats-title-row">

                <div class="ats-title-icon">
                    <i class="fa-solid fa-briefcase"></i>
                </div>


                <div>

                    <h1 class="ats-page-title">
                        Job Openings
                    </h1>

                    <p class="ats-page-subtitle">
                        Manage active positions, vacancies and candidate recruitment pipelines.
                    </p>

                </div>

            </div>

        </div>


        <button type="button"
                class="btn ats-create-btn"
                data-bs-toggle="modal"
                data-bs-target="#createJobModal">

            <i class="fa-solid fa-plus me-2"></i>
            Create Opening

        </button>

    </div>


    <!-- =====================================================
         KPI CARDS
    ====================================================== -->

    <div class="row g-3 mb-4">

        <!-- Total Openings -->
        <div class="col-12 col-sm-6 col-xl-3">

            <div class="ats-stat-card ats-stat-blue ats-stat-delay-1">

                <div class="ats-stat-top">

                    <span class="ats-stat-label">
                        Total Openings
                    </span>

                    <div class="ats-stat-icon ats-icon-blue">
                        <i class="fa-solid fa-briefcase"></i>
                    </div>

                </div>

                <h3 class="ats-stat-value">
                    @totalJobs
                </h3>

                <div class="ats-stat-meta">
                    <span class="ats-stat-highlight">
                        @openJobs Active
                    </span>
                    recruitment position@(openJobs == 1 ? "" : "s")
                </div>

            </div>

        </div>


        <!-- Vacancies -->
        <div class="col-12 col-sm-6 col-xl-3">

            <div class="ats-stat-card ats-stat-purple ats-stat-delay-2">

                <div class="ats-stat-top">

                    <span class="ats-stat-label">
                        Total Vacancies
                    </span>

                    <div class="ats-stat-icon ats-icon-purple">
                        <i class="fa-solid fa-user-plus"></i>
                    </div>

                </div>

                <h3 class="ats-stat-value">
                    @totalVacancies
                </h3>

                <div class="ats-stat-meta">
                    <span class="ats-mini-badge">
                        <i class="fa-solid fa-people-group"></i>
                        @totalApplicants Applicants
                    </span>
                </div>

            </div>

        </div>


        <!-- Applicants -->
        <div class="col-12 col-sm-6 col-xl-3">

            <div class="ats-stat-card ats-stat-success ats-stat-delay-3">

                <div class="ats-stat-top">

                    <span class="ats-stat-label">
                        Talent Pipeline
                    </span>

                    <div class="ats-stat-icon ats-icon-success">
                        <i class="fa-solid fa-users"></i>
                    </div>

                </div>

                <h3 class="ats-stat-value">
                    @totalApplicants
                </h3>

                <div class="ats-stat-meta">
                    Total candidates across all openings
                </div>

                <div class="progress ats-progress">

                    <div class="progress-bar"
                         role="progressbar"
                         style="width: @fillRate%">
                    </div>

                </div>

            </div>

        </div>


        <!-- On Hold -->
        <div class="col-12 col-sm-6 col-xl-3">

            <div class="ats-stat-card ats-stat-warning ats-stat-delay-4">

                <div class="ats-stat-top">

                    <span class="ats-stat-label">
                        Recruitment Status
                    </span>

                    <div class="ats-stat-icon ats-icon-warning">
                        <i class="fa-solid fa-chart-pie"></i>
                    </div>

                </div>

                <h3 class="ats-stat-value">
                    @onHoldJobs
                </h3>

                <div class="ats-stat-meta">
                    <span class="ats-stat-highlight">
                        @closedJobs Closed
                    </span>
                    &nbsp;•&nbsp;
                    @remoteJobs Remote / Hybrid
                </div>

            </div>

        </div>

    </div>


    <!-- =====================================================
         FILTERS
    ====================================================== -->

    <div class="ats-filter-card">

        <div class="ats-filter-title-row">

            <div class="ats-filter-title-icon">
                <i class="fa-solid fa-sliders"></i>
            </div>

            <div>

                <h6 class="ats-filter-title">
                    Search & Filter Openings
                </h6>

                <p class="ats-filter-subtitle">
                    Find positions quickly using department, status or employment filters.
                </p>

            </div>

        </div>


        <form method="get"
              action="/HRRecruitment/JobOpenings"
              class="row g-3 align-items-end">


            <!-- Search -->
            <div class="col-xl-3 col-md-6">

                <div class="ats-search-wrap">

                    <i class="fa-solid fa-magnifying-glass ats-search-icon"></i>

                    <input type="text"
                           name="search"
                           class="form-control ats-search-input"
                           placeholder="Search title or job code..."
                           value="@ViewBag.Search" />

                </div>

            </div>


            <!-- Department -->
            <div class="col-xl-2 col-md-6">

                <select name="departmentId"
                        class="form-select"
                        onchange="this.form.submit()">

                    <option value="">
                        All Departments
                    </option>

                    @foreach (var d in departments)
                    {
                        <option value="@d.DepartmentId"
                                selected="@(ViewBag.SelectedDepartmentId == d.DepartmentId ? "selected" : null)">
                            @d.DepartmentName
                        </option>
                    }

                </select>

            </div>


            <!-- Status -->
            <div class="col-xl-2 col-md-6">

                <select name="status"
                        class="form-select"
                        onchange="this.form.submit()">

                    <option value="All">
                        All Statuses
                    </option>

                    <option value="Open"
                            selected="@(ViewBag.SelectedStatus == "Open" ? "selected" : null)">
                        Open & Active
                    </option>

                    <option value="On Hold"
                            selected="@(ViewBag.SelectedStatus == "On Hold" ? "selected" : null)">
                        On Hold
                    </option>

                    <option value="Closed"
                            selected="@(ViewBag.SelectedStatus == "Closed" ? "selected" : null)">
                        Closed
                    </option>

                    <option value="Draft"
                            selected="@(ViewBag.SelectedStatus == "Draft" ? "selected" : null)">
                        Draft
                    </option>

                    <option value="Archived"
                            selected="@(ViewBag.SelectedStatus == "Archived" ? "selected" : null)">
                        Archived
                    </option>

                </select>

            </div>


            <!-- Employment -->
            <div class="col-xl-2 col-md-6">

                <select name="employmentType"
                        class="form-select"
                        onchange="this.form.submit()">

                    <option value="All">
                        All Employment Types
                    </option>

                    <option value="Full-Time"
                            selected="@(ViewBag.SelectedEmploymentType == "Full-Time" ? "selected" : null)">
                        Full-Time
                    </option>

                    <option value="Part-Time"
                            selected="@(ViewBag.SelectedEmploymentType == "Part-Time" ? "selected" : null)">
                        Part-Time
                    </option>

                    <option value="Contract"
                            selected="@(ViewBag.SelectedEmploymentType == "Contract" ? "selected" : null)">
                        Contract
                    </option>

                    <option value="Internship"
                            selected="@(ViewBag.SelectedEmploymentType == "Internship" ? "selected" : null)">
                        Internship
                    </option>

                </select>

            </div>


            <!-- Buttons -->
            <div class="col-xl-3 col-md-12">

                <div class="d-flex gap-2">

                    <button type="submit"
                            class="btn ats-filter-btn flex-grow-1">

                        <i class="fa-solid fa-filter me-1"></i>
                        Apply Filters

                    </button>

                    <a href="/HRRecruitment/JobOpenings"
                       class="btn ats-reset-btn">

                        <i class="fa-solid fa-rotate-left"></i>

                    </a>

                </div>

            </div>

        </form>

    </div>


    <!-- =====================================================
         OPENINGS TABLE
    ====================================================== -->

    <div class="ats-table-card">

        <div class="ats-table-header">

            <div class="ats-table-title-wrap">

                <div class="ats-table-title-icon">
                    <i class="fa-solid fa-list-check"></i>
                </div>

                <div>

                    <h5 class="ats-table-title">
                        Recruitment Positions
                    </h5>

                    <p class="ats-table-subtitle">
                        Track job openings, candidates and recruitment progress.
                    </p>

                </div>

            </div>


            <div class="ats-opening-count">

                <i class="fa-solid fa-briefcase"></i>

                @totalJobs Opening@(totalJobs == 1 ? "" : "s")

            </div>

        </div>


        @if (jobs.Any())
        {
            <div class="table-responsive">

                <table class="table ats-table align-middle">

                    <thead>

                        <tr>

                            <th>Job Code</th>
                            <th>Position</th>
                            <th>Department</th>
                            <th>Vacancies</th>
                            <th>Experience</th>
                            <th>Work Mode</th>
                            <th>Candidates</th>
                            <th>Status</th>
                            <th class="text-end">Actions</th>

                        </tr>

                    </thead>


                    <tbody>

                        @foreach (var job in jobs)
                        {
                            int applicantCount = job.Applications?.Count ?? 0;

                            string statusClass = job.Status switch
                            {
                                "Open" => "ats-status-open",
                                "On Hold" => "ats-status-hold",
                                "Closed" => "ats-status-closed",
                                "Draft" => "ats-status-draft",
                                "Archived" => "ats-status-archived",
                                _ => "ats-status-closed"
                            };

                            <tr>

                                <!-- Job Code -->
                                <td>

                                    <span class="ats-job-code">
                                        @job.JobCode
                                    </span>

                                </td>


                                <!-- Position -->
                                <td>

                                    <div class="ats-job-title">
                                        @job.JobTitle
                                    </div>

                                    <div class="ats-job-meta">

                                        <i class="fa-solid fa-location-dot me-1"></i>

                                        @job.JobLocation

                                        <span class="mx-1">•</span>

                                        @job.EmploymentType

                                    </div>

                                </td>


                                <!-- Department -->
                                <td>

                                    <span class="ats-department-name">
                                        @(job.Department?.DepartmentName ?? "N/A")
                                    </span>

                                </td>


                                <!-- Vacancies -->
                                <td>

                                    <span class="ats-vacancy-badge">

                                        <i class="fa-solid fa-user-plus"></i>

                                        @job.Vacancies Open

                                    </span>

                                </td>


                                <!-- Experience -->
                                <td>

                                    @(string.IsNullOrEmpty(job.ExperienceRequired)
                                                                ? "1-3 Years"
                                                                : job.ExperienceRequired)

                        </td>


                                <!-- Work Mode -->
                                <td>

                                    <span class="ats-work-mode">

                                @if (job.WorkMode == "Remote")
                                        {
                                            <i class="fa-solid fa-laptop-house"></i>
                                        }
                                        else if (job.WorkMode == "Hybrid")
                                        {
                                            <i class="fa-solid fa-house-laptop"></i>
                                        }
                                        else
                                        {
                                            <i class="fa-solid fa-building"></i>
                                        }

                                        @job.WorkMode

                                    </span>

                                </td>


                                <!-- Candidates -->
                                <td>

                                    <a href="/HRRecruitment/CandidatePipeline?jobId=@job.JobId"
                                       class="ats-candidate-link">

                                        <i class="fa-solid fa-users"></i>

                                        @applicantCount Candidate@(applicantCount == 1 ? "" : "s")

                                    </a>

                                </td>


                                <!-- Status -->
                                <td>

                                    <span class="ats-status @statusClass">

                                        <span class="ats-status-dot"></span>

                                        @job.Status

                                    </span>

                                </td>


                                <!-- Actions -->
                                <td class="text-end">

                                    <div class="dropdown">

                                        <button class="btn ats-action-btn"
                                                type="button"
                                                data-bs-toggle="dropdown"
                                                aria-expanded="false">

                                            <i class="fa-solid fa-ellipsis-vertical"></i>

                                        </button>


                                        <ul class="dropdown-menu dropdown-menu-end ats-dropdown">

                                            <li>

                                                <a class="dropdown-item"
                                                   href="#"
                                                   onclick="viewJobDetails(@job.JobId)">

                                                    <i class="fa-solid fa-eye me-2 text-info"></i>
                                                    View Details

                                                </a>

                                            </li>


                                            <li>

                                                <a class="dropdown-item"
                                                   href="/HRRecruitment/CandidatePipeline?jobId=@job.JobId">

                                                    <i class="fa-solid fa-users me-2 text-primary"></i>
                                                    View Candidates (@applicantCount)

                                                </a>

                                            </li>


                                            <li>

                                                <hr class="dropdown-divider">

                                            </li>


                                            <li>

                                                <form method="post"
                                                      action="/HRRecruitment/DuplicateJobOpening">

                                                    @Html.AntiForgeryToken()

                                                    <input type="hidden"
                                                           name="jobId"
                                                           value="@job.JobId" />

                                                    <button type="submit"
                                                            class="dropdown-item">

                                                        <i class="fa-solid fa-copy me-2 text-warning"></i>
                                                        Duplicate Opening

                                                    </button>

                                                </form>

                                            </li>


                                            @if (job.Status == "Open")
                                            {
                                                <li>

                                                    <form method="post"
                                                          action="/HRRecruitment/ChangeJobStatus">

                                                        @Html.AntiForgeryToken()

                                                        <input type="hidden"
                                                               name="jobId"
                                                               value="@job.JobId" />

                                                        <input type="hidden"
                                                               name="status"
                                                               value="On Hold" />

                                                        <button type="submit"
                                                                class="dropdown-item">

                                                            <i class="fa-solid fa-pause me-2 text-warning"></i>
                                                            Put On Hold

                                                        </button>

                                                    </form>

                                                </li>


                                                <li>

                                                    <form method="post"
                                                          action="/HRRecruitment/ChangeJobStatus">

                                                        @Html.AntiForgeryToken()

                                                        <input type="hidden"
                                                               name="jobId"
                                                               value="@job.JobId" />

                                                        <input type="hidden"
                                                               name="status"
                                                               value="Closed" />

                                                        <button type="submit"
                                                                class="dropdown-item">

                                                            <i class="fa-solid fa-lock me-2 text-secondary"></i>
                                                            Close Opening

                                                        </button>

                                                    </form>

                                                </li>
                                            }
                                            else
                                            {
                                                <li>

                                                    <form method="post"
                                                          action="/HRRecruitment/ChangeJobStatus">

                                                        @Html.AntiForgeryToken()

                                                        <input type="hidden"
                                                               name="jobId"
                                                               value="@job.JobId" />

                                                        <input type="hidden"
                                                               name="status"
                                                               value="Open" />

                                                        <button type="submit"
                                                                class="dropdown-item">

                                                            <i class="fa-solid fa-play me-2 text-success"></i>
                                                            Reopen Position

                                                        </button>

                                                    </form>

                                                </li>
                                            }


                                            <li>

                                                <hr class="dropdown-divider">

                                            </li>


                                            <li>

                                                <form method="post"
                                                      action="/HRRecruitment/DeleteJobOpening"
                                                      onsubmit="return confirm('Are you sure you want to delete this Job Opening?');">

                                                    @Html.AntiForgeryToken()

                                                    <input type="hidden"
                                                           name="jobId"
                                                           value="@job.JobId" />

                                                    <button type="submit"
                                                            class="dropdown-item text-danger">

                                                        <i class="fa-solid fa-trash me-2"></i>
                                                        Delete Opening

                                                    </button>

                                                </form>

                                            </li>

                                        </ul>

                                    </div>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }
        else
        {
            <div class="ats-empty-state">

                <div class="ats-empty-icon">
                    <i class="fa-solid fa-folder-open"></i>
                </div>

                <h6 class="ats-empty-title">
                    No Job Openings Found
                </h6>

                <p class="ats-empty-text">
                    No job openings are available for the selected search and filters.
                </p>

            </div>
        }

    </div>

</div>


<!-- =========================================================
     CREATE JOB OPENING MODAL
========================================================== -->

<div class="modal fade ats-modal"
     id="createJobModal"
     tabindex="-1"
     aria-hidden="true">

    <div class="modal-dialog modal-lg modal-dialog-centered">

        <div class="modal-content">


            <!-- Modal Header -->

            <div class="ats-modal-header">

                <div>

                    <h5 class="ats-modal-title">

                        <i class="fa-solid fa-plus-circle me-2"></i>

                        Create New Job Opening

                    </h5>

                    <p class="ats-modal-subtitle">
                        Configure a new position and publish it to your recruitment pipeline.
                    </p>

                </div>


                <button type="button"
                        class="btn-close btn-close-white position-relative"
                        style="z-index:3;"
                        data-bs-dismiss="modal"
                        aria-label="Close">
                </button>

            </div>


            <!-- Form -->

            <form method="post"
                  action="/HRRecruitment/CreateJobOpening">

                @Html.AntiForgeryToken()


                <div class="modal-body text-start">

                    <div class="row g-3">


                        <!-- Job Title -->

                        <div class="col-md-8">

                            <label class="form-label">

                                Job Title
                                <span class="text-danger">*</span>

                            </label>

                            <input type="text"
                                   name="JobTitle"
                                   class="form-control"
                                   required
                                   placeholder="e.g. Senior Software Engineer" />

                        </div>


                        <!-- Job Code -->

                        <div class="col-md-4">

                            <label class="form-label">
                                Job Code
                            </label>

                            <input type="text"
                                   name="JobCode"
                                   class="form-control"
                                   placeholder="e.g. JOB-1025" />

                        </div>


                        <!-- Department -->

                        <div class="col-md-6">

                            <label class="form-label">

                                Department
                                <span class="text-danger">*</span>

                            </label>

                            <select name="DepartmentId"
                                    class="form-select"
                                    required>

                                <option value="">
                                    -- Select Department --
                                </option>

                                @foreach (var d in departments)
                                {
                                    <option value="@d.DepartmentId">
                                        @d.DepartmentName
                                    </option>
                                }

                            </select>

                        </div>


                        <!-- Designation -->

                        <div class="col-md-6">

                            <label class="form-label">
                                Designation
                            </label>

                            <select name="DesignationId"
                                    class="form-select">

                                <option value="">
                                    -- Select Designation --
                                </option>

                                @foreach (var desg in designations)
                                {
                                    <option value="@desg.DesignationId">
                                        @desg.JobTitle
                                    </option>
                                }

                            </select>

                        </div>


                        <!-- Employment -->

                        <div class="col-md-4">

                            <label class="form-label">
                                Employment Type
                            </label>

                            <select name="EmploymentType"
                                    class="form-select">

                                <option value="Full-Time">
                                    Full-Time
                                </option>

                                <option value="Part-Time">
                                    Part-Time
                                </option>

                                <option value="Contract">
                                    Contract
                                </option>

                                <option value="Internship">
                                    Internship
                                </option>

                            </select>

                        </div>


                        <!-- Work Mode -->

                        <div class="col-md-4">

                            <label class="form-label">
                                Work Mode
                            </label>

                            <select name="WorkMode"
                                    class="form-select">

                                <option value="On-site">
                                    On-site
                                </option>

                                <option value="Remote">
                                    Remote
                                </option>

                                <option value="Hybrid">
                                    Hybrid
                                </option>

                            </select>

                        </div>


                        <!-- Vacancies -->

                        <div class="col-md-4">

                            <label class="form-label">
                                Vacancies
                            </label>

                            <input type="number"
                                   name="Vacancies"
                                   class="form-control"
                                   value="1"
                                   min="1"
                                   required />

                        </div>


                        <!-- Experience -->

                        <div class="col-md-6">

                            <label class="form-label">
                                Experience Required
                            </label>

                            <input type="text"
                                   name="ExperienceRequired"
                                   class="form-control"
                                   placeholder="e.g. 2-5 Years" />

                        </div>


                        <!-- Location -->

                        <div class="col-md-6">

                            <label class="form-label">
                                Job Location
                            </label>

                            <input type="text"
                                   name="JobLocation"
                                   class="form-control"
                                   value="Headquarters" />

                        </div>


                        <!-- Minimum Salary -->

                        <div class="col-md-6">

                            <label class="form-label">
                                Minimum Salary (CTC PA)
                            </label>

                            <input type="number"
                                   name="MinimumSalary"
                                   class="form-control"
                                   placeholder="e.g. 400000" />

                        </div>


                        <!-- Maximum Salary -->

                        <div class="col-md-6">

                            <label class="form-label">
                                Maximum Salary (CTC PA)
                            </label>

                            <input type="number"
                                   name="MaximumSalary"
                                   class="form-control"
                                   placeholder="e.g. 800000" />

                        </div>


                        <!-- Skills -->

                        <div class="col-md-12">

                            <label class="form-label">
                                Required Skills
                            </label>

                            <input type="text"
                                   name="RequiredSkills"
                                   class="form-control"
                                   placeholder="e.g. C#, ASP.NET Core, SQL Server, Communication" />

                        </div>


                        <!-- Description -->

                        <div class="col-md-12">

                            <label class="form-label">
                                Job Description
                            </label>

                            <textarea name="JobDescription"
                                      class="form-control"
                                      rows="4"
                                      placeholder="Provide an overview of the role, responsibilities and requirements..."></textarea>

                        </div>

                    </div>

                </div>


                <!-- Modal Footer -->

                <div class="modal-footer">

                    <button type="button"
                            class="btn btn-light border ats-modal-cancel"

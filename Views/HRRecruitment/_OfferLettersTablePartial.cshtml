@model IEnumerable<ERP_System.Models.OfferLetter>
<table class="table table-hover align-middle offer-table">
    <thead>
        <tr>
            <th>Offer Code</th>
            <th>Candidate</th>
            <th>Job Title</th>
            <th>CTC Offered</th>
            <th>Joining Date</th>
            <th>Expiry Date</th>
            <th>Status</th>
            <th class="text-end">Actions</th>
        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.Any())
        {
            foreach (var offer in Model)
            {
                string badgeClass = offer.Status switch
                {
                    "Accepted" => "bg-success-subtle text-success",
                    "Sent" => "bg-warning-subtle text-warning",
                    "Approved" => "bg-primary-subtle text-primary",
                    "Rejected" => "bg-danger-subtle text-danger",
                    "Draft" => "bg-secondary-subtle text-secondary",
                    _ => "bg-light text-dark"
                };

                bool isConverted = offer.ConvertedToEmployeeId.HasValue;

                var candidateName = offer.Candidate?.FullName ?? "N/A";
                var candidateInitials = string.Join("",
                candidateName
                .Split(' ', StringSplitOptions.RemoveEmptyEntries)
                .Take(2)
                .Select(x => x.Substring(0, 1))
                ).ToUpper();

                <tr>
                    <td>
                        <span class="offer-code">
                            <i class="fa-solid fa-hashtag text-primary"></i>
                            @offer.OfferCode
                        </span>
                    </td>
                    <td>
                        <div class="offer-candidate">
                            <div class="offer-avatar">
                                @(string.IsNullOrEmpty(candidateInitials) ? "NA" : candidateInitials)
                            </div>
                            <div>
                                <div class="offer-name">
                                    @(offer.Candidate?.FullName ?? "N/A")
                                </div>
                                <div class="offer-meta">
                                    <i class="fa-solid fa-envelope me-1"></i>
                                    @(offer.Candidate?.Email)
                                </div>
                            </div>
                        </div>
                    </td>
                    <td>
                        <div class="offer-job">
                            @(offer.JobOpening?.JobTitle ?? "N/A")
                        </div>
                        <div class="offer-meta">
                            <i class="fa-solid fa-building me-1"></i>
                            @(offer.Department?.DepartmentName)
                        </div>
                    </td>
                    <td>
                        <div class="offer-ctc">
                            <i class="fa-solid fa-indian-rupee-sign me-1"></i>
                            @offer.OfferedCTC.ToString("N0")
                        </div>
                        <div class="offer-meta">
                            Annual CTC
                        </div>
                    </td>
                    <td>
                        <div class="offer-date">
                            <i class="fa-solid fa-calendar-check me-1 text-success"></i>
                            @offer.ProposedJoiningDate.ToString("dd MMM yyyy")
                        </div>
                    </td>
                    <td>
                        <div class="offer-date">
                            <i class="fa-solid fa-calendar-xmark me-1 text-danger"></i>
                            @offer.OfferExpiryDate.ToString("dd MMM yyyy")
                        </div>
                    </td>
                    <td>
                        <div class="badge-status @badgeClass" id="status-badge-@offer.OfferCode">
                            @offer.Status
                        </div>
                    </td>
                    <td class="text-end">
                        <div class="dropdown d-inline-block">
                            <button class="btn btn-light btn-sm rounded-circle shadow-sm" type="button" data-bs-toggle="dropdown">
                                <i class="fa-solid fa-ellipsis-vertical"></i>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end shadow border-0" style="min-width: 200px;">
                                <li>
                                    <a class="dropdown-item" href="@Url.Action("PrintOffer", "HRRecruitment", new { offerId = offer.OfferId })" target="_blank">
                                        <i class="fa-solid fa-print text-primary me-2"></i> Print Offer
                                    </a>
                                </li>
                                <li><hr class="dropdown-divider"></li>
                                @if (offer.Status == "Accepted" && !isConverted)
                                {
                                    <li>
                                        <form asp-action="ConvertToEmployee" asp-controller="HRRecruitment" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="offerId" value="@offer.OfferId" />
                                            <button type="submit" class="dropdown-item text-success fw-bold" onclick="return confirm('Are you sure you want to convert this candidate to an employee?');">
                                                <i class="fa-solid fa-user-plus me-2"></i> Convert to Employee
                                            </button>
                                        </form>
                                    </li>
                                }
                                else if (isConverted)
                                {
                                    <li>
                                        <span class="dropdown-item text-muted disabled">
                                            <i class="fa-solid fa-user-check me-2"></i> Converted
                                        </span>
                                    </li>
                                }
                                else
                                {
                                    @if (offer.Status == "Approved" || offer.Status == "Draft")
                                    {
                                        <li>
                                            <button type="button" class="dropdown-item text-primary" onclick="updateOfferStatus(@offer.OfferId, 'Sent')">
                                                <i class="fa-solid fa-paper-plane me-2"></i>
                                                Mark Sent to Candidate
                                            </button>
                                        </li>
                                    }

                                    @if (offer.Status == "Sent" || offer.Status == "Pending")
                                    {
                                        <li>
                                            <button type="button" class="dropdown-item text-primary" onclick="resendOfferEmail(@offer.OfferId)">
                                                <i class="fa-solid fa-paper-plane me-2"></i>
                                                Resend Offer Email
                                            </button>
                                        </li>
                                    }

                                    @if (offer.Status == "Sent")
                                    {
                                        <li>
                                            <button type="button" class="dropdown-item text-success" onclick="updateOfferStatus(@offer.OfferId, 'Accepted')">
                                                <i class="fa-solid fa-circle-check me-2"></i>
                                                Mark Candidate Accepted
                                            </button>
                                        </li>

                                        <li>
                                            <button type="button" class="dropdown-item text-danger" onclick="updateOfferStatus(@offer.OfferId, 'Rejected')">
                                                <i class="fa-solid fa-circle-xmark me-2"></i>
                                                Mark Candidate Rejected
                                            </button>
                                        </li>
                                    }

                                    <li><hr class="dropdown-divider" /></li>

                                    @if (offer.Status != "Withdrawn" && offer.Status != "Declined" && offer.Status != "Rejected")
                                    {
                                        <li>
                                            <button type="button" class="dropdown-item text-secondary" onclick="revokeOffer(@offer.OfferId)">
                                                <i class="fa-solid fa-ban me-2"></i>
                                                Revoke / Withdraw Offer
                                            </button>
                                        </li>
                                    }
                                }
                            </ul>
                        </div>
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="8">
                    <div class="empty-state text-center p-5">
                        <i class="fa-solid fa-file-signature text-muted mb-3" style="font-size: 3rem; opacity: .5;"></i>
                        <h5 class="fw-bold text-dark mb-1">No Offers Found</h5>
                        <p class="text-muted small mb-0">Try adjusting your search criteria or generate a new offer.</p>
                    </div>
                </td>
            </tr>
        }
    </tbody>
</table>

@model ERP_System.Models.AccountsViewModel
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Accounts & Financial Management";
    var inCulture = new System.Globalization.CultureInfo("en-IN");
}

<style>
    /* =========================================================
           ACCOUNTS & FINANCIAL MANAGEMENT
           PREMIUM ERP UI REDESIGN
           UI ONLY — EXISTING RAZOR / BACKEND / ROUTES PRESERVED
           ========================================================= */

    :root {
        --acc-primary: #2563eb;
        --acc-primary-dark: #1d4ed8;
        --acc-primary-light: #3b82f6;
        --acc-primary-soft: #eff6ff;
        --acc-success: #059669;
        --acc-success-soft: #ecfdf5;
        --acc-danger: #dc2626;
        --acc-danger-soft: #fef2f2;
        --acc-warning: #d97706;
        --acc-warning-soft: #fffbeb;
        --acc-info: #0284c7;
        --acc-info-soft: #f0f9ff;
        --acc-purple: #7c3aed;
        --acc-purple-soft: #f5f3ff;
        --acc-text: #172033;
        --acc-text-dark: #0f172a;
        --acc-muted: #64748b;
        --acc-light-muted: #94a3b8;
        --acc-border: #e5e7eb;
        --acc-border-light: #edf1f5;
        --acc-surface: #ffffff;
        --acc-surface-soft: #f8fafc;
        --acc-radius: 16px;
        --acc-radius-sm: 12px;
        --acc-shadow: 0 8px 28px rgba(15, 23, 42, 0.055);
        --acc-shadow-hover: 0 16px 38px rgba(15, 23, 42, 0.105);
    }

    /* =========================================================
           BASE
           ========================================================= */

    .accounts-page {
        width: 100%;
        max-width: 100%;
        animation: accPageIn .5s ease both;
        color: var(--acc-text);
    }

        .accounts-page *,
        .accounts-page *::before,
        .accounts-page *::after {
            box-sizing: border-box;
        }

        .accounts-page a,
        .accounts-page button,
        .accounts-page .nav-link,
        .accounts-page .bank-card,
        .accounts-page .kpi-card-acc,
        .accounts-page .accounts-mini-card,
        .accounts-page .fiscal-year-card {
            -webkit-tap-highlight-color: transparent;
        }

    /* =========================================================
           PAGE HEADER
           ========================================================= */

    .accounts-page-header {
        position: relative;
        padding: 1.15rem 1.2rem;
        border: 1px solid var(--acc-border);
        border-radius: 16px;
        background: radial-gradient(circle at 90% 15%, rgba(37, 99, 235, .075), transparent 25%), linear-gradient(135deg, #ffffff 0%, #f8fbff 100%);
        box-shadow: var(--acc-shadow);
        overflow: hidden;
        margin-bottom: 1.25rem;
    }

        .accounts-page-header::before {
            content: "";
            position: absolute;
            left: 0;
            top: 0;
            bottom: 0;
            width: 4px;
            background: linear-gradient( 180deg, var(--acc-primary), #60a5fa, #93c5fd );
        }

        .accounts-page-header::after {
            content: "";
            position: absolute;
            width: 180px;
            height: 180px;
            right: -80px;
            top: -100px;
            border-radius: 50%;
            border: 1px solid rgba(37, 99, 235, .08);
            box-shadow: 0 0 0 24px rgba(37, 99, 235, .025), 0 0 0 48px rgba(37, 99, 235, .018);
            pointer-events: none;
        }

    .accounts-page-header-content {
        position: relative;
        z-index: 2;
    }

    .accounts-page .breadcrumb {
        margin-bottom: .45rem !important;
    }

    .accounts-page .breadcrumb-item {
        font-size: .76rem;
    }

        .accounts-page .breadcrumb-item + .breadcrumb-item::before {
            color: #94a3b8;
        }

    .accounts-page .breadcrumb a {
        transition: color .2s ease;
    }

        .accounts-page .breadcrumb a:hover {
            color: var(--acc-primary) !important;
        }

    .accounts-page-title {
        font-size: 1.45rem;
        font-weight: 800;
        letter-spacing: -.035em;
        color: var(--acc-text-dark);
        margin-bottom: .25rem;
    }

    .accounts-page-subtitle {
        color: var(--acc-muted);
        font-size: .82rem;
        line-height: 1.55;
        max-width: 760px;
        margin: 0;
    }

    .accounts-title-icon {
        width: 42px;
        height: 42px;
        min-width: 42px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 12px;
        background: linear-gradient( 135deg, #eff6ff, #dbeafe );
        color: var(--acc-primary);
        border: 1px solid #dbeafe;
        box-shadow: 0 5px 14px rgba(37, 99, 235, .08);
    }

    .top-page-actions {
        position: relative;
        z-index: 3;
    }

    /* =========================================================
           BUTTONS
           ========================================================= */

    .btn-primary-warm {
        position: relative;
        overflow: hidden;
        background: linear-gradient( 135deg, var(--acc-primary), var(--acc-primary-light) );
        color: #fff;
        font-weight: 700;
        border: 0;
        border-radius: 10px;
        min-height: 40px;
        box-shadow: 0 5px 14px rgba(37, 99, 235, .18);
        transition: transform .22s ease, box-shadow .22s ease, background .22s ease;
    }

        .btn-primary-warm::before {
            content: "";
            position: absolute;
            top: 0;
            left: -120%;
            width: 70%;
            height: 100%;
            background: linear-gradient( 90deg, transparent, rgba(255,255,255,.22), transparent );
            transform: skewX(-20deg);
            transition: left .55s ease;
        }

        .btn-primary-warm:hover::before {
            left: 140%;
        }

        .btn-primary-warm:hover,
        .btn-primary-warm:focus {
            background: linear-gradient( 135deg, var(--acc-primary-dark), var(--acc-primary) );
            color: #fff;
            transform: translateY(-2px);
            box-shadow: 0 9px 20px rgba(37, 99, 235, .24);
        }

        .btn-primary-warm:active {
            transform: translateY(0);
        }

    .btn-outline-warm {
        border: 1px solid #d5dce6;
        background: rgba(255,255,255,.92);
        color: #334155;
        font-weight: 700;
        border-radius: 10px;
        min-height: 40px;
        transition: transform .2s ease, border-color .2s ease, background .2s ease, box-shadow .2s ease;
    }

        .btn-outline-warm:hover,
        .btn-outline-warm:focus {
            background: #f8fafc;
            border-color: #aeb9c8;
            color: #0f172a;
            transform: translateY(-2px);
            box-shadow: 0 5px 14px rgba(15,23,42,.07);
        }

    /* =========================================================
           ALERTS
           ========================================================= */

    .accounts-page .alert {
        border-radius: 12px;
        padding: .85rem 1rem;
        border: 1px solid transparent !important;
        animation: accSlideDown .4s ease both;
    }

    .accounts-page .alert-success {
        background: linear-gradient(135deg, #f0fdf4, #ecfdf5);
        color: #047857;
        border-color: #bbf7d0 !important;
    }

    .accounts-page .alert-danger {
        background: linear-gradient(135deg, #fef2f2, #fff1f2);
        color: #b91c1c;
        border-color: #fecaca !important;
    }

    /* =========================================================
           KPI GRID / CARDS
           ========================================================= */

    .accounts-kpi-grid {
        display: grid;
        grid-template-columns: repeat(5, minmax(0, 1fr));
        gap: 1rem;
        margin-bottom: 1.25rem;
    }

    .kpi-card-acc {
        min-height: 126px;
        height: 100%;
        position: relative;
        display: flex;
        align-items: center;
        gap: .9rem;
        padding: 1rem;
        background: linear-gradient( 145deg, #ffffff 0%, #fbfdff 100% );
        border: 1px solid var(--acc-border);
        border-radius: 15px;
        box-shadow: 0 4px 17px rgba(15, 23, 42, .045);
        overflow: hidden;
        transition: transform .28s ease, box-shadow .28s ease, border-color .28s ease;
        animation: accCardIn .5s ease both;
    }

        .kpi-card-acc:nth-child(1) {
            animation-delay: .04s;
        }

        .kpi-card-acc:nth-child(2) {
            animation-delay: .08s;
        }

        .kpi-card-acc:nth-child(3) {
            animation-delay: .12s;
        }

        .kpi-card-acc:nth-child(4) {
            animation-delay: .16s;
        }

        .kpi-card-acc:nth-child(5) {
            animation-delay: .20s;
        }

        .kpi-card-acc::before {
            content: "";
            position: absolute;
            left: 0;
            top: 14px;
            bottom: 14px;
            width: 3px;
            border-radius: 0 5px 5px 0;
            background: var(--acc-primary);
            opacity: .75;
        }

        .kpi-card-acc::after {
            content: "";
            position: absolute;
            width: 115px;
            height: 115px;
            right: -65px;
            bottom: -65px;
            border-radius: 50%;
            background: rgba(37, 99, 235, .035);
            pointer-events: none;
            transition: transform .3s ease;
        }

        .kpi-card-acc:hover {
            transform: translateY(-5px);
            border-color: #d4dce8;
            box-shadow: var(--acc-shadow-hover);
        }

            .kpi-card-acc:hover::after {
                transform: scale(1.25);
            }

    .kpi-icon-acc {
        width: 51px;
        height: 51px;
        min-width: 51px;
        border-radius: 14px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 1.12rem;
        flex-shrink: 0;
        border: 1px solid rgba(255,255,255,.7);
        box-shadow: inset 0 0 0 1px rgba(255,255,255,.55), 0 5px 13px rgba(15,23,42,.05);
        transition: transform .25s ease;
    }

    .kpi-card-acc:hover .kpi-icon-acc {
        transform: scale(1.06) rotate(-2deg);
    }

    .kpi-card-acc h5 {
        font-size: 1.08rem;
        letter-spacing: -.02em;
        line-height: 1.2;
        word-break: break-word;
    }

    .kpi-card-acc .kpi-label {
        font-size: .71rem;
        text-transform: uppercase;
        letter-spacing: .045em;
        color: var(--acc-muted);
    }

    .kpi-card-acc .kpi-helper {
        font-size: .69rem;
        line-height: 1.35;
        color: var(--acc-light-muted);
    }

    /* =========================================================
           MAIN PANEL
           ========================================================= */

    .panel-accounts {
        width: 100%;
        background: var(--acc-surface);
        border: 1px solid var(--acc-border);
        border-radius: 17px;
        box-shadow: var(--acc-shadow);
        overflow: hidden;
        animation: accPanelIn .55s ease both;
    }

    .accounts-panel-header {
        padding: 1rem 1.15rem 0;
    }

    /* =========================================================
           TABS
           ========================================================= */

    .nav-tabs-accounts {
        display: flex;
        flex-wrap: nowrap;
        gap: .3rem;
        padding: .35rem;
        margin: 0 0 1.15rem !important;
        background: #f7f9fc;
        border: 1px solid #e8edf3;
        border-radius: 12px;
        overflow-x: auto;
        scrollbar-width: thin;
        scrollbar-color: #cbd5e1 transparent;
    }

        .nav-tabs-accounts::-webkit-scrollbar {
            height: 5px;
        }

        .nav-tabs-accounts::-webkit-scrollbar-thumb {
            background: #cbd5e1;
            border-radius: 10px;
        }

        .nav-tabs-accounts .nav-item {
            flex: 0 0 auto;
        }

        .nav-tabs-accounts .nav-link {
            position: relative;
            display: flex;
            align-items: center;
            gap: 8px;
            white-space: nowrap;
            border: 1px solid transparent;
            color: #64748b;
            background: transparent;
            font-weight: 700;
            font-size: .82rem;
            padding: .72rem .9rem;
            border-radius: 9px;
            transition: color .2s ease, background .2s ease, border-color .2s ease, box-shadow .2s ease, transform .2s ease;
        }

            .nav-tabs-accounts .nav-link:hover {
                color: #1e293b;
                background: #fff;
                border-color: #e2e8f0;
                transform: translateY(-1px);
            }

            .nav-tabs-accounts .nav-link.active {
                color: var(--acc-primary);
                background: #fff;
                border-color: #dbeafe;
                box-shadow: 0 4px 12px rgba(15, 23, 42, .06);
            }

                .nav-tabs-accounts .nav-link.active::after {
                    content: "";
                    position: absolute;
                    left: 20%;
                    right: 20%;
                    bottom: -1px;
                    height: 2px;
                    border-radius: 5px;
                    background: var(--acc-primary);
                    animation: accTabLine .25s ease both;
                }

            .nav-tabs-accounts .nav-link i {
                font-size: .86rem;
            }

    /* =========================================================
           SECTION HEADINGS
           ========================================================= */

    .accounts-section-heading {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        margin-bottom: 1rem;
    }

    .accounts-section-heading-left {
        display: flex;
        align-items: center;
        gap: .75rem;
        min-width: 0;
    }

    .acc-section-heading-icon {
        width: 38px;
        height: 38px;
        min-width: 38px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 11px;
        background: linear-gradient( 135deg, #eff6ff, #dbeafe );
        color: var(--acc-primary);
        border: 1px solid #dbeafe;
        box-shadow: 0 4px 12px rgba(37,99,235,.08);
    }

    .accounts-section-heading h6 {
        font-size: .96rem;
        font-weight: 800;
        letter-spacing: -.015em;
        margin: 0;
        color: var(--acc-text-dark);
    }

    .accounts-section-heading p {
        margin: .15rem 0 0;
        font-size: .72rem;
        color: var(--acc-muted);
    }

    .accounts-live-label {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: .38rem .65rem;
        border-radius: 999px;
        background: #f0fdf4;
        border: 1px solid #bbf7d0;
        color: #047857;
        font-size: .66rem;
        font-weight: 800;
        white-space: nowrap;
    }

        .accounts-live-label::before {
            content: "";
            width: 7px;
            height: 7px;
            border-radius: 50%;
            background: #10b981;
            box-shadow: 0 0 0 4px rgba(16,185,129,.12);
            animation: accPulse 1.8s infinite;
        }

    /* =========================================================
           BANK CARDS
           ========================================================= */

    .bank-card {
        height: 100%;
        min-height: 190px;
        position: relative;
        background: linear-gradient( 145deg, #ffffff 0%, #fbfdff 100% );
        border: 1px solid var(--acc-border);
        border-radius: 15px;
        padding: 1.1rem;
        overflow: hidden;
        transition: transform .27s ease, box-shadow .27s ease, border-color .27s ease;
    }

        .bank-card::before {
            content: "";
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 3px;
            background: linear-gradient( 90deg, #2563eb, #60a5fa, #93c5fd );
            transform: scaleX(0);
            transform-origin: left;
            transition: transform .35s ease;
        }

        .bank-card::after {
            content: "";
            position: absolute;
            width: 90px;
            height: 90px;
            right: -40px;
            top: -45px;
            border-radius: 50%;
            background: rgba(37,99,235,.035);
            transition: transform .35s ease;
        }

        .bank-card:hover {
            border-color: #bfdbfe;
            transform: translateY(-4px);
            box-shadow: 0 14px 30px rgba(37, 99, 235, .09);
        }

            .bank-card:hover::before {
                transform: scaleX(1);
            }

            .bank-card:hover::after {
                transform: scale(1.35);
            }

        .bank-card .bank-icon {
            position: relative;
            z-index: 2;
        }

        .bank-card .font-monospace {
            font-size: .73rem;
            letter-spacing: .025em;
        }

    .bank-balance {
        font-size: 1rem;
        letter-spacing: -.02em;
    }

    /* =========================================================
           MINI CARDS / BREAKDOWN
           ========================================================= */

    .accounts-section-box {
        height: 100%;
        background: linear-gradient( 145deg, #f8fafc 0%, #ffffff 100% );
        border: 1px solid #e7ecf2 !important;
        border-radius: 14px !important;
        padding: 1rem !important;
        position: relative;
        overflow: hidden;
    }

        .accounts-section-box::after {
            content: "";
            position: absolute;
            width: 130px;
            height: 130px;
            right: -80px;
            bottom: -80px;
            border-radius: 50%;
            border: 1px solid rgba(37,99,235,.055);
            pointer-events: none;
        }

    .accounts-mini-card {
        height: 100%;
        min-height: 92px;
        position: relative;
        background: #fff;
        border: 1px solid #e5eaf0;
        border-radius: 11px;
        padding: .72rem;
        transition: transform .22s ease, box-shadow .22s ease, border-color .22s ease;
    }

        .accounts-mini-card:hover {
            transform: translateY(-3px);
            border-color: #d7e1ed;
            box-shadow: 0 8px 20px rgba(15,23,42,.07);
        }

        .accounts-mini-card h5 {
            font-size: 1.1rem;
        }

    /* =========================================================
           FILTER AREAS
           ========================================================= */

    .accounts-filter {
        background: linear-gradient( 135deg, #f8fafc, #ffffff );
        border: 1px solid #e7ecf2;
        border-radius: 13px;
        padding: .75rem;
        box-shadow: 0 3px 12px rgba(15,23,42,.025);
    }

        .accounts-filter .filter-label {
            font-size: .68rem;
            font-weight: 800;
            color: #64748b;
            text-transform: uppercase;
            letter-spacing: .04em;
        }

    .accounts-page .form-control,
    .accounts-page .form-select {
        min-height: 40px;
        border-color: #dbe2ea;
        color: #1e293b;
        background-color: #fff;
        border-radius: 9px;
        font-size: .82rem;
        box-shadow: none;
        transition: border-color .2s ease, box-shadow .2s ease, transform .2s ease;
    }

        .accounts-page .form-control:hover,
        .accounts-page .form-select:hover {
            border-color: #c4cedb;
        }

        .accounts-page .form-control:focus,
        .accounts-page .form-select:focus {
            border-color: #93c5fd;
            box-shadow: 0 0 0 .2rem rgba(37, 99, 235, .09);
            transform: translateY(-1px);
        }

    .accounts-page .input-group-text {
        border-color: #dbe2ea;
        border-radius: 9px 0 0 9px;
    }

    /* =========================================================
           TABLES
           ========================================================= */

    .accounts-table-wrapper {
        width: 100%;
        border: 1px solid #e8edf3;
        border-radius: 13px;
        background: #fff;
        overflow: hidden;
        box-shadow: 0 3px 13px rgba(15,23,42,.025);
    }

    .table-responsive {
        border: 0;
        border-radius: 0;
        background: #fff;
    }

    .table-accounts {
        min-width: 820px;
        margin-bottom: 0;
    }

        .table-accounts th {
            background: linear-gradient( 180deg, #f8fafc, #f5f7fa ) !important;
            font-size: .67rem;
            text-transform: uppercase;
            letter-spacing: .06em;
            font-weight: 800;
            color: #64748b;
            border-bottom: 1px solid #e2e8f0;
            padding: .85rem 1rem;
            white-space: nowrap;
        }

        .table-accounts td {
            font-size: .82rem;
            color: var(--acc-text);
            border-bottom: 1px solid #edf1f5;
            padding: .9rem 1rem;
            vertical-align: middle;
        }

        .table-accounts tbody tr {
            transition: background-color .2s ease, transform .2s ease;
        }

            .table-accounts tbody tr:hover {
                background: #f8fbff;
            }

            .table-accounts tbody tr:last-child td {
                border-bottom: 0;
            }

        .table-accounts .font-monospace {
            font-size: .76rem;
        }

        .table-accounts .description-cell {
            max-width: 260px;
        }

        .table-accounts .voucher-code,
        .table-accounts .head-code {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: .25rem .45rem;
            border-radius: 7px;
            background: #f8fafc;
            border: 1px solid #e8edf3;
        }

    /* =========================================================
           BADGES
           ========================================================= */

    .badge-type-asset,
    .badge-type-liability,
    .badge-type-equity,
    .badge-type-revenue,
    .badge-type-expense,
    .badge-status-paid,
    .badge-status-pending,
    .badge-status-cancelled {
        font-weight: 700;
        border-width: 1px;
        border-style: solid;
    }

    .badge-type-asset {
        background-color: #eff6ff;
        color: #1d4ed8;
        border-color: #bfdbfe;
    }

    .badge-type-liability {
        background-color: #fff7ed;
        color: #c2410c;
        border-color: #fed7aa;
    }

    .badge-type-equity {
        background-color: #faf5ff;
        color: #7e22ce;
        border-color: #e9d5ff;
    }

    .badge-type-revenue {
        background-color: #f0fdf4;
        color: #15803d;
        border-color: #bbf7d0;
    }

    .badge-type-expense {
        background-color: #fef2f2;
        color: #b91c1c;
        border-color: #fecaca;
    }

    .badge-status-paid {
        background-color: rgba(16,185,129,.10);
        color: #047857;
        border-color: rgba(16,185,129,.20);
    }

    .badge-status-pending {
        background-color: rgba(245,158,11,.10);
        color: #b45309;
        border-color: rgba(245,158,11,.20);
    }

    .badge-status-cancelled {
        background-color: rgba(239,68,68,.10);
        color: #b91c1c;
        border-color: rgba(239,68,68,.20);
    }

    /* =========================================================
           FISCAL YEAR CARDS
           ========================================================= */

    .fiscal-year-card {
        height: 100%;
        min-height: 145px;
        position: relative;
        border-radius: 14px !important;
        border: 1px solid #e5eaf0 !important;
        background: linear-gradient( 145deg, #ffffff, #fbfdff );
        overflow: hidden;
        transition: transform .25s ease, box-shadow .25s ease, border-color .25s ease;
    }

        .fiscal-year-card::before {
            content: "";
            position: absolute;
            left: 0;
            top: 0;
            width: 3px;
            height: 100%;
            background: linear-gradient( 180deg, #2563eb, #60a5fa );
            transform: scaleY(0);
            transform-origin: bottom;
            transition: transform .3s ease;
        }

        .fiscal-year-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 12px 28px rgba(15,23,42,.075) !important;
            border-color: #bfdbfe !important;
        }

            .fiscal-year-card:hover::before {
                transform: scaleY(1);
            }

    /* =========================================================
           EMPTY STATE
           ========================================================= */

    .accounts-empty-state {
        padding: 3rem 1rem !important;
        background: radial-gradient( circle at center, #f8fafc 0%, #ffffff 62% );
    }

    .accounts-empty-icon {
        width: 58px;
        height: 58px;
        margin: 0 auto .8rem;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background: #f1f5f9;
        border: 1px solid #e2e8f0;
        border-radius: 16px;
        color: #94a3b8;
        animation: accFloat 3s ease-in-out infinite;
    }

    /* =========================================================
           MODALS
           ========================================================= */

    .accounts-page .modal-content {
        border-radius: 18px !important;
        overflow: hidden;
        border: 1px solid #e5e7eb !important;
        box-shadow: 0 28px 80px rgba(15,23,42,.22) !important;
        animation: accModalIn .28s ease both;
    }

    .accounts-page .modal-header {
        position: relative;
        background: linear-gradient( 180deg, #ffffff, #f8fafc );
        padding: 1rem 1.15rem;
    }

        .accounts-page .modal-header::before {
            content: "";
            position: absolute;
            left: 0;
            top: 0;
            bottom: 0;
            width: 3px;
            background: linear-gradient( 180deg, var(--acc-primary), #60a5fa );
        }

    .modal-title-icon {
        width: 36px;
        height: 36px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 10px;
        background: #eff6ff;
        color: var(--acc-primary);
        border: 1px solid #dbeafe;
    }

    .accounts-page .modal-body {
        padding: 1.2rem;
    }

    .accounts-page .modal-footer {
        background: #f8fafc;
        padding: .85rem 1.15rem;
    }

    .accounts-page .form-label {
        margin-bottom: .42rem;
        letter-spacing: .01em;
        color: #334155;
    }

    .accounts-page textarea.form-control {
        resize: vertical;
        min-height: 90px;
    }

    /* =========================================================
           TAB PANE
           ========================================================= */

    .accounts-page .tab-pane {
        animation: accTabIn .28s ease both;
    }

    /* =========================================================
           CUSTOM UTILITY
           ========================================================= */

    .col-xl-2-4 {
        width: 20%;
        flex: 0 0 auto;
    }

    .accounts-page .text-truncate {
        max-width: 100%;
    }

    .accounts-content-pad {
        padding: 0 1.15rem 1.15rem;
    }

    /* =========================================================
           RESPONSIVE — LARGE TABLETS
           ========================================================= */

    @@media (max-width: 1399.98px) {

        .accounts-kpi-grid {
            grid-template-columns: repeat(3, minmax(0, 1fr));
        }

        .col-xl-2-4 {
            width: 33.333333%;
        }

        .kpi-card-acc {
            min-height: 118px;
        }
    }

    /* =========================================================
           RESPONSIVE — TABLETS
           ========================================================= */

    @@media (max-width: 991.98px) {

        .accounts-page-header {
            padding: 1rem;
        }

        .accounts-page-title {
            font-size: 1.28rem;
        }

        .accounts-kpi-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .col-xl-2-4 {
            width: 50%;
        }

        .panel-accounts {
            border-radius: 14px;
        }

        .accounts-content-pad {
            padding: 0 .9rem .9rem;
        }

        .nav-tabs-accounts {
            margin-left: -.15rem;
            margin-right: -.15rem;
        }

        .accounts-section-heading {
            align-items: flex-start;
        }

        .bank-card {
            min-height: 180px;
            padding: 1rem;
        }
    }

    /* =========================================================
           RESPONSIVE — MOBILE
           ========================================================= */

    @@media (max-width: 767.98px) {

        .accounts-page {
            overflow-x: hidden;
        }

        .accounts-page-header {
            padding: .95rem;
            border-radius: 13px;
        }

            .accounts-page-header::after {
                opacity: .5;
            }

        .accounts-title-icon {
            width: 38px;
            height: 38px;
            min-width: 38px;
        }

        .accounts-page-title {
            font-size: 1.15rem;
        }

        .accounts-page-subtitle {
            font-size: .75rem;
        }

        .top-page-actions {
            width: 100%;
            display: grid !important;
            grid-template-columns: 1fr 1fr;
        }

            .top-page-actions .btn {
                width: 100%;
                min-width: 0;
            }

        .accounts-kpi-grid {
            grid-template-columns: 1fr 1fr;
            gap: .75rem;
        }

        .col-xl-2-4 {
            width: 100%;
        }

        .kpi-card-acc {
            min-height: 106px;
            padding: .85rem;
            gap: .7rem;
            border-radius: 13px;
        }

        .kpi-icon-acc {
            width: 43px;
            height: 43px;
            min-width: 43px;
            font-size: .98rem;
            border-radius: 11px;
        }

        .kpi-card-acc h5 {
            font-size: .92rem;
        }

        .kpi-card-acc .kpi-label {
            font-size: .62rem;
        }

        .kpi-card-acc .kpi-helper {
            font-size: .64rem;
        }

        .panel-accounts {
            border-radius: 13px;
        }

        .accounts-content-pad {
            padding: 0 .75rem .75rem;
        }

        .nav-tabs-accounts {
            flex-wrap: nowrap;
            padding: .3rem;
            border-radius: 10px;
        }

            .nav-tabs-accounts .nav-link {
                font-size: .75rem;
                padding: .62rem .7rem;
            }

        .accounts-section-heading {
            flex-direction: column;
            gap: .65rem;
        }

        .accounts-section-heading-right {
            width: 100%;
        }

        .accounts-live-label {
            width: fit-content;
        }

        .accounts-filter {
            padding: .65rem;
        }

        .accounts-table-wrapper {
            border-radius: 10px;
        }

        .table-responsive {
            border-radius: 10px;
        }

        .table-accounts {
            min-width: 760px;
        }

            .table-accounts th {
                padding: .75rem .8rem;
            }

            .table-accounts td {
                padding: .8rem;
            }

        .accounts-page .modal-dialog {
            margin: .65rem;
        }

        .accounts-page .modal-header,
        .accounts-page .modal-body,
        .accounts-page .modal-footer {
            padding-left: .9rem;
            padding-right: .9rem;
        }
    }

    /* =========================================================
           RESPONSIVE — SMALL MOBILE
           ========================================================= */

    @@media (max-width: 575.98px) {

        .accounts-page-title {
            font-size: 1.05rem;
        }

        .accounts-page-subtitle {
            font-size: .71rem;
            line-height: 1.45;
        }

        .top-page-actions {
            grid-template-columns: 1fr;
        }

        .accounts-kpi-grid {
            grid-template-columns: 1fr;
        }

        .kpi-card-acc {
            min-height: 96px;
        }

        .accounts-page .breadcrumb-item {
            font-size: .68rem;
        }

        .acc-section-heading-icon {
            width: 35px;
            height: 35px;
            min-width: 35px;
            border-radius: 10px;
        }

        .accounts-section-heading h6 {
            font-size: .88rem;
        }

        .accounts-section-heading p {
            font-size: .67rem;
        }

        .accounts-mini-card {
            min-height: 82px;
        }

        .accounts-page .modal-footer {
            flex-wrap: wrap;
            gap: .5rem;
        }

            .accounts-page .modal-footer .btn {
                flex: 1 1 auto;
            }
    }

    /* =========================================================
           REDUCED MOTION
           ========================================================= */

    @@media (prefers-reduced-motion: reduce) {

        .accounts-page *,
        .accounts-page *::before,
        .accounts-page *::after {
            animation-duration: .01ms !important;
            animation-iteration-count: 1 !important;
            transition-duration: .01ms !important;
            scroll-behavior: auto !important;
        }
    }

    /* =========================================================
           ANIMATIONS
           ========================================================= */

    @@keyframes accPageIn {
        from {
            opacity: 0;
            transform: translateY(10px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@keyframes accPanelIn {
        from {
            opacity: 0;
            transform: translateY(14px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@keyframes accCardIn {
        from {
            opacity: 0;
            transform: translateY(14px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@keyframes accSlideDown {
        from {
            opacity: 0;
            transform: translateY(-9px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@keyframes accModalIn {
        from {
            opacity: 0;
            transform: translateY(10px) scale(.985);
        }

        to {
            opacity: 1;
            transform: translateY(0) scale(1);
        }
    }

    @@keyframes accTabIn {
        from {
            opacity: 0;
            transform: translateY(5px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@keyframes accTabLine {
        from {
            transform: scaleX(.5);
            opacity: .3;
        }

        to {
            transform: scaleX(1);
            opacity: 1;
        }
    }

    @@keyframes accPulse {
        0%, 100% {
            transform: scale(1);
            opacity: 1;
        }

        50% {
            transform: scale(.72);
            opacity: .65;
        }
    }

    @@keyframes accFloat {
        0%, 100% {
            transform: translateY(0);
        }

        50% {
            transform: translateY(-4px);
        }
    }
</style>

<div class="accounts-page">

    <!-- =====================================================
         PAGE HEADER
         ===================================================== -->

    <div class="accounts-page-header">

        <div class="accounts-page-header-content">

            <div class="d-flex flex-column flex-lg-row justify-content-between align-items-start gap-3">

                <div class="d-flex align-items-start gap-3">

                    <div class="accounts-title-icon d-none d-sm-flex">
                        <i class="fa-solid fa-chart-line"></i>
                    </div>

                    <div>

                        <nav aria-label="breadcrumb">

                            <ol class="breadcrumb mb-1 small">

                                <li class="breadcrumb-item">
                                    <a href="/Dashboard"
                                       class="text-decoration-none text-muted">
                                        Dashboard
                                    </a>
                                </li>

                                <li class="breadcrumb-item active fw-semibold text-primary"
                                    aria-current="page">
                                    Accounting & Financials
                                </li>

                            </ol>

                        </nav>

                        <h4 class="accounts-page-title">
                            Accounts & Financial Management
                        </h4>

                        <p class="accounts-page-subtitle">
                            Manage Chart of Accounts, General Ledger vouchers,
                            cash balances, and overall financial health from one
                            centralized accounting workspace.
                        </p>

                    </div>

                </div>

                <div class="d-flex gap-2 top-page-actions">

                    <button type="button"
                            class="btn btn-outline-warm btn-sm px-3 py-2"
                            data-bs-toggle="modal"
                            data-bs-target="#createVoucherModal">

                        <i class="fa-solid fa-receipt me-1 text-primary"></i>

                        + Record Voucher

                    </button>

                    <button type="button"
                            class="btn btn-primary-warm btn-sm px-3 py-2"
                            data-bs-toggle="modal"
                            data-bs-target="#addAccountHeadModal">

                        <i class="fa-solid fa-plus me-1"></i>

                        + Add Account Head

                    </button>

                </div>

            </div>

        </div>

    </div>

    <!-- =====================================================
         TEMPDATA ALERTS
         ===================================================== -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm mb-4"
             role="alert">

            <i class="fa-solid fa-circle-check me-2"></i>

            @TempData["SuccessMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Close">
            </button>

        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm mb-4"
             role="alert">

            <i class="fa-solid fa-triangle-exclamation me-2"></i>

            @TempData["ErrorMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Close">
            </button>

        </div>
    }

    <!-- =====================================================
         KPI CARDS
         ===================================================== -->

    <div class="accounts-kpi-grid">

        <!-- Total Assets -->
        <div class="kpi-card-acc">

            <div class="kpi-icon-acc bg-primary-subtle text-primary">
                <i class="fa-solid fa-vault"></i>
            </div>

            <div class="min-w-0">

                <span class="kpi-label d-block fw-semibold">
                    Total Assets
                </span>

                <h5 class="fw-bold mb-0 text-dark">
                    ₹@Model.TotalAssets.ToString("N0", inCulture)
                </h5>

                <span class="badge bg-success-subtle text-success mt-1"
                      style="font-size:0.65rem;">

                    <i class="fa-solid fa-arrow-trend-up me-1"></i>

                    Healthy Position

                </span>

            </div>

        </div>

        <!-- Total Revenue -->
        <div class="kpi-card-acc">

            <div class="kpi-icon-acc bg-success-subtle text-success">
                <i class="fa-solid fa-arrow-down-left"></i>
            </div>

            <div class="min-w-0">

                <span class="kpi-label d-block fw-semibold">
                    Total Revenue
                </span>

                <h5 class="fw-bold mb-0 text-dark">
                    ₹@Model.TotalRevenue.ToString("N0", inCulture)
                </h5>

                <span class="kpi-helper d-block mt-1">
                    @Model.RevenueHeadsCount Revenue Heads
                </span>

            </div>

        </div>

        <!-- Total Expenses -->
        <div class="kpi-card-acc">

            <div class="kpi-icon-acc bg-danger-subtle text-danger">
                <i class="fa-solid fa-arrow-up-right"></i>
            </div>

            <div class="min-w-0">

                <span class="kpi-label d-block fw-semibold">
                    Total Expenses
                </span>

                <h5 class="fw-bold mb-0 text-dark">
                    ₹@Model.TotalExpenses.ToString("N0", inCulture)
                </h5>

                <span class="kpi-helper d-block mt-1">
                    @Model.ExpenseHeadsCount Expense Heads
                </span>

            </div>

        </div>

        <!-- Net Cash Flow -->
        <div class="kpi-card-acc">

            <div class="kpi-icon-acc bg-info-subtle text-info">
                <i class="fa-solid fa-scale-balanced"></i>
            </div>

            <div class="min-w-0">

                <span class="kpi-label d-block fw-semibold">
                    Net Cash Flow
                </span>

                <h5 class="fw-bold mb-0 @(Model.NetCashFlow >= 0 ? "text-success" : "text-danger")">
                    ₹@Model.NetCashFlow.ToString("N0", inCulture)
                </h5>

                <span class="kpi-helper d-block mt-1">
                    Operating Balance
                </span>

            </div>

        </div>

        <!-- Account Heads -->
        <div class="kpi-card-acc">

            <div class="kpi-icon-acc bg-warning-subtle text-warning">
                <i class="fa-solid fa-list-check"></i>
            </div>

            <div class="min-w-0">

                <span class="kpi-label d-block fw-semibold">
                    Account Heads
                </span>

                <h5 class="fw-bold mb-0 text-dark">
                    @Model.ActiveAccountHeadsCount / @Model.TotalAccountHeads
                </h5>

                <span class="kpi-helper d-block mt-1">
                    Active Ledger Heads
                </span>

            </div>

        </div>

    </div>

    <!-- =====================================================
         MAIN ACCOUNTS PANEL
         ===================================================== -->

    <div class="panel-accounts">

        <div class="accounts-content-pad pt-3">

            <!-- =================================================
                 TABS
                 ================================================= -->

            <ul class="nav nav-tabs nav-tabs-accounts"
                id="accountsTab"
                role="tablist">

                <li class="nav-item"
                    role="presentation">

                    <button class="nav-link @(Model.ActiveTab == "overview" ? "active" : "")"
                            id="overview-tab"
                            data-bs-toggle="tab"
                            data-bs-target="#overview-pane"
                            type="button"
                            role="tab">

                        <i class="fa-solid fa-chart-pie"></i>

                        Overview & Cash/Bank

                    </button>

                </li>

                <li class="nav-item"
                    role="presentation">

                    <button class="nav-link @(Model.ActiveTab == "chart-of-accounts" ? "active" : "")"
                            id="chart-tab"
                            data-bs-toggle="tab"
                            data-bs-target="#chart-pane"
                            type="button"
                            role="tab">

                        <i class="fa-solid fa-sitemap"></i>

                        Chart of Accounts (@Model.TotalAccountHeads)

                    </button>

                </li>

                <li class="nav-item"
                    role="presentation">

                    <button class="nav-link @(Model.ActiveTab == "journal" ? "active" : "")"
                            id="journal-tab"
                            data-bs-toggle="tab"
                            data-bs-target="#journal-pane"
                            type="button"
                            role="tab">

                        <i class="fa-solid fa-file-invoice-dollar"></i>

                        General Ledger Vouchers (@Model.Transactions.Count)

                    </button>

                </li>

                <li class="nav-item"
                    role="presentation">

                    <button class="nav-link @(Model.ActiveTab == "fiscal-years" ? "active" : "")"
                            id="fiscal-tab"
                            data-bs-toggle="tab"
                            data-bs-target="#fiscal-pane"
                            type="button"
                            role="tab">

                        <i class="fa-solid fa-calendar-days"></i>

                        Financial Years

                    </button>

                </li>

            </ul>

            <!-- =================================================
                 TAB CONTENT
                 ================================================= -->

            <div class="tab-content"
                 id="accountsTabContent">

                <!-- =================================================
                     TAB 1 — OVERVIEW
                     ================================================= -->

                <div class="tab-pane fade @(Model.ActiveTab == "overview" ? "show active" : "")"
                     id="overview-pane"
                     role="tabpanel">

                    <div class="accounts-section-heading">

                        <div class="accounts-section-heading-left">

                            <span class="acc-section-heading-icon">
                                <i class="fa-solid fa-building-columns text-primary"></i>
                            </span>

                            <div>

                                <h6>
                                    Cash & Commercial Bank Accounts
                                </h6>

                                <p>
                                    Monitor real-time liquidity across connected accounts
                                </p>

                            </div>

                        </div>

                        <div class="accounts-section-heading-right">

                            <span class="accounts-live-label">
                                Live Account Liquidity
                            </span>

                        </div>

                    </div>

                    <!-- Bank Accounts -->

                    <div class="row g-3 mb-4">

                        @foreach (var bank in Model.BankAccounts)
                        {
                            <div class="col-12 col-md-6 col-xl-3">

                                <div class="bank-card">

                                    <div class="d-flex justify-content-between align-items-start mb-3">

                                        <div class="kpi-icon-acc bank-icon @bank.BadgeClass">

                                            <i class="fa-solid @bank.IconClass"></i>

                                        </div>

                                        <span class="badge @bank.BadgeClass rounded-pill px-2 py-1"
                                              style="font-size:0.65rem;">

                                            @bank.Status

                                        </span>

                                    </div>

                                    <span class="text-muted small d-block mb-1">
                                        @bank.BankName
                                    </span>

                                    <h6 class="fw-bold text-dark text-truncate mb-1">
                                        @bank.AccountName
                                    </h6>

                                    <p class="text-muted font-monospace small mb-3">
                                        Acc: @bank.AccountNumber
                                    </p>

                                    <div class="pt-2 border-top d-flex justify-content-between align-items-center gap-2">

                                        <span class="text-muted small">
                                            Available Balance
                                        </span>

                                        <span class="fw-bold text-dark bank-balance">
                                            ₹@bank.Balance.ToString("N0", inCulture)
                                        </span>

                                    </div>

                                </div>

                            </div>
                        }

                    </div>

                    <!-- Ledger Breakdown -->

                    <div class="row g-3">

                        <!-- Distribution -->

                        <div class="col-12 col-lg-7">

                            <div class="accounts-section-box">

                                <div class="accounts-section-heading mb-3">

                                    <div class="accounts-section-heading-left">

                                        <span class="acc-section-heading-icon">
                                            <i class="fa-solid fa-chart-simple text-info"></i>
                                        </span>

                                        <div>

                                            <h6>
                                                Chart of Accounts Type Distribution
                                            </h6>

                                            <p>
                                                Current ledger head classification
                                            </p>

                                        </div>

                                    </div>

                                </div>

                                <div class="row g-2 text-center">

                                    <div class="col-6 col-sm">

                                        <div class="accounts-mini-card">

                                            <span class="badge badge-type-asset mb-1">
                                                Asset
                                            </span>

                                            <h5 class="fw-bold text-dark mb-0">
                                                @Model.AssetHeadsCount
                                            </h5>

                                            <span class="text-muted small"
                                                  style="font-size:.67rem;">
                                                Heads
                                            </span>

                                        </div>

                                    </div>

                                    <div class="col-6 col-sm">

                                        <div class="accounts-mini-card">

                                            <span class="badge badge-type-liability mb-1">
                                                Liability
                                            </span>

                                            <h5 class="fw-bold text-dark mb-0">
                                                @Model.LiabilityHeadsCount
                                            </h5>

                                            <span class="text-muted small"
                                                  style="font-size:.67rem;">
                                                Heads
                                            </span>

                                        </div>

                                    </div>

                                    <div class="col-6 col-sm">

                                        <div class="accounts-mini-card">

                                            <span class="badge badge-type-equity mb-1">
                                                Equity
                                            </span>

                                            <h5 class="fw-bold text-dark mb-0">
                                                @Model.EquityHeadsCount
                                            </h5>

                                            <span class="text-muted small"
                                                  style="font-size:.67rem;">
                                                Heads
                                            </span>

                                        </div>

                                    </div>

                                    <div class="col-6 col-sm">

                                        <div class="accounts-mini-card">

                                            <span class="badge badge-type-revenue mb-1">
                                                Revenue
                                            </span>

                                            <h5 class="fw-bold text-dark mb-0">
                                                @Model.RevenueHeadsCount
                                            </h5>

                                            <span class="text-muted small"
                                                  style="font-size:.67rem;">
                                                Heads
                                            </span>

                                        </div>

                                    </div>

                                    <div class="col-12 col-sm">

                                        <div class="accounts-mini-card">

                                            <span class="badge badge-type-expense mb-1">
                                                Expense
                                            </span>

                                            <h5 class="fw-bold text-dark mb-0">
                                                @Model.ExpenseHeadsCount
                                            </h5>

                                            <span class="text-muted small"
                                                  style="font-size:.67rem;">
                                                Heads
                                            </span>

                                        </div>

                                    </div>

                                </div>

                            </div>

                        </div>

                        <!-- Pending Actions -->

                        <div class="col-12 col-lg-5">

                            <div class="accounts-section-box d-flex flex-column justify-content-between">

                                <div>

                                    <div class="accounts-section-heading mb-2">

                                        <div class="accounts-section-heading-left">

                                            <span class="acc-section-heading-icon"
                                                  style="background:#fffbeb;border-color:#fde68a;color:#d97706;">

                                                <i class="fa-solid fa-clock"></i>

                                            </span>

                                            <div>

                                                <h6>
                                                    Pending Action Items
                                                </h6>

                                                <p>
                                                    Items requiring accountant review
                                                </p>

                                            </div>

                                        </div>

                                    </div>

                                    <div class="d-flex align-items-center justify-content-between gap-3 p-3 bg-white border rounded-3 mb-2">

                                        <div class="min-w-0">

                                            <span class="fw-semibold text-dark d-block">
                                                Pending Vouchers
                                            </span>

                                            <span class="text-muted small">
                                                @Model.PendingVouchersCount Vouchers Awaiting Approval
                                            </span>

                                        </div>

                                        <span class="badge bg-warning-subtle text-warning fw-bold px-3 py-2">
                                            ₹@Model.PendingVouchersAmount.ToString("N0", inCulture)
                                        </span>

                                    </div>

                                </div>

                                <button type="button"
                                        class="btn btn-outline-warm btn-sm w-100 mt-2"
                                        onclick="document.getElementById('journal-tab').click();">

                                    View All Journal Entries

                                    <i class="fa-solid fa-arrow-right ms-1"></i>

                                </button>

                            </div>

                        </div>

                    </div>

                </div>

                <!-- =================================================
                     TAB 2 — CHART OF ACCOUNTS
                     ================================================= -->

                <div class="tab-pane fade @(Model.ActiveTab == "chart-of-accounts" ? "show active" : "")"
                     id="chart-pane"
                     role="tabpanel">

                    <div class="accounts-section-heading">

                        <div class="accounts-section-heading-left">

                            <span class="acc-section-heading-icon">
                                <i class="fa-solid fa-sitemap"></i>
                            </span>

                            <div>

                                <h6>
                                    Chart of Accounts
                                </h6>

                                <p>
                                    Manage and monitor your financial ledger heads
                                </p>

                            </div>

                        </div>

                    </div>

                    <!-- Filter -->

                    <form method="get"
                          asp-action="Index"
                          class="row g-2 mb-3 align-items-center accounts-filter">

                        <input type="hidden"
                               name="tab"
                               value="chart-of-accounts" />

                        <div class="col-12 col-md-5">

                            <div class="input-group input-group-sm">

                                <span class="input-group-text bg-white text-muted border-end-0">

                                    <i class="fa-solid fa-magnifying-glass"></i>

                                </span>

                                <input type="text"
                                       name="search"
                                       value="@Model.SearchTerm"
                                       class="form-control border-start-0"
                                       placeholder="Search Head Code, Name, or Description..." />

                            </div>

                        </div>

                        <div class="col-12 col-md-4">

                            <select name="accountType"
                                    class="form-select form-select-sm">

                                <option value="">
                                    -- Filter by Account Type --
                                </option>

                                <option value="Asset"
                                        selected="@(Model.SelectedAccountType == "Asset")">
                                    Asset
                                </option>

                                <option value="Liability"
                                        selected="@(Model.SelectedAccountType == "Liability")">
                                    Liability
                                </option>

                                <option value="Equity"
                                        selected="@(Model.SelectedAccountType == "Equity")">
                                    Equity
                                </option>

                                <option value="Revenue"
                                        selected="@(Model.SelectedAccountType == "Revenue")">
                                    Revenue
                                </option>

                                <option value="Expense"
                                        selected="@(Model.SelectedAccountType == "Expense")">
                                    Expense
                                </option>

                            </select>

                        </div>

                        <div class="col-12 col-md-3 d-flex gap-2">

                            <button type="submit"
                                    class="btn btn-primary-warm btn-sm px-3 flex-grow-1">

                                <i class="fa-solid fa-filter me-1"></i>

                                Filter

                            </button>

                            <a href="/Accounts?tab=chart-of-accounts"
                               class="btn btn-outline-warm btn-sm px-3">

                                Reset

                            </a>

                        </div>

                    </form>

                    <div class="accounts-table-wrapper">

                        <div class="table-responsive">

                            <table class="table table-accounts align-middle mb-0">

                                <thead>

                                    <tr>

                                        <th>Head Code</th>

                                        <th>Account Head Name</th>

                                        <th>Account Type</th>

                                        <th>Description</th>

                                        <th>Created Date</th>

                                        <th>Status</th>

                                        <th class="text-end">
                                            Action
                                        </th>

                                    </tr>

                                </thead>

                                <tbody>

                                    @if (Model.AccountHeads.Any())
                                    {
                                        @foreach (var head in Model.AccountHeads)
                                        {
                                            string badgeStyle = head.AccountType switch
                                            {
                                                "Asset" => "badge-type-asset",
                                                "Liability" => "badge-type-liability",
                                                "Equity" => "badge-type-equity",
                                                "Revenue" => "badge-type-revenue",
                                                "Expense" => "badge-type-expense",
                                                _ => "bg-secondary-subtle text-secondary"
                                            };

                                            <tr>

                                                <td>

                                                    <span class="font-monospace fw-bold text-dark head-code">

                                                        <i class="fa-solid fa-hashtag text-muted"
                                                           style="font-size:.65rem;"></i>

                                                        @head.HeadCode

                                                    </span>

                                                </td>

                                                <td>

                                                    <span class="fw-semibold text-dark">
                                                        @head.HeadName
                                                    </span>

                                                </td>

                                                <td>

                                                    <span class="badge @badgeStyle rounded-pill px-2 py-1">

                                                        @head.AccountType

                                                    </span>

                                                </td>

                                                <td class="text-muted small description-cell">

                                                    @(string.IsNullOrEmpty(head.Description)
                                                                                                ? "-"
                                                                                                : head.Description)

                                        </td>

                                                <td class="text-muted small">

                                                    <i class="fa-regular fa-calendar me-1"></i>

                                                    @head.CreatedAt.ToString("MMM dd, yyyy")

                                                </td>

                                                <td>

                                            @if (head.IsActive)
                                                    {
                                                        <span class="badge bg-success-subtle text-success rounded-pill px-2 py-1">

                                                            <i class="fa-solid fa-circle me-1"
                                                               style="font-size:.45rem;"></i>

                                                            Active

                                                        </span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-secondary-subtle text-secondary rounded-pill px-2 py-1">

                                                            <i class="fa-solid fa-circle me-1"
                                                               style="font-size:.45rem;"></i>

                                                            Inactive

                                                        </span>
                                                    }

                                                </td>

                                                <td class="text-end">

                                                    <form method="post"
                                                          asp-action="ToggleHeadStatus"
                                                          asp-route-id="@head.AccountHeadId"
                                                          class="d-inline">

                                                        @Html.AntiForgeryToken()

                                                        <button type="submit"
                                                                class="btn btn-sm @(head.IsActive ? "btn-outline-danger" : "btn-outline-success") py-1 px-2"
                                                                style="font-size:.72rem;">

                                                            <i class="fa-solid @(head.IsActive ? "fa-ban" : "fa-check") me-1"></i>

                                                            @(head.IsActive ? "Deactivate" : "Activate")

                                                        </button>

                                                    </form>

                                                </td>

                                            </tr>
                                        }
                                    }
                                    else
                                    {
                                        <tr>

                                            <td colspan="7"
                                                class="text-center text-muted accounts-empty-state">

                                                <span class="accounts-empty-icon">
                                                    <i class="fa-solid fa-folder-open fs-4"></i>
                                                </span>

                                                <div class="fw-semibold text-dark mb-1">
                                                    No Account Heads Found
                                                </div>

                                                <div class="small text-muted">
                                                    No account heads match the selected criteria.
                                                </div>

                                            </td>

                                        </tr>
                                    }

                                </tbody>

                            </table>

                        </div>

                    </div>

                </div>

                <!-- =================================================
                     TAB 3 — GENERAL LEDGER
                     ================================================= -->

                <div class="tab-pane fade @(Model.ActiveTab == "journal" ? "show active" : "")"
                     id="journal-pane"
                     role="tabpanel">

                    <div class="accounts-section-heading">

                        <div class="accounts-section-heading-left">

                            <span class="acc-section-heading-icon">
                                <i class="fa-solid fa-file-invoice-dollar"></i>
                            </span>

                            <div>

                                <h6>
                                    General Ledger Vouchers
                                </h6>

                                <p>
                                    Review financial transactions and voucher status
                                </p>

                            </div>

                        </div>

                    </div>

                    <!-- Filter -->

                    <form method="get"
                          asp-action="Index"
                          class="row g-2 mb-3 align-items-center accounts-filter">

                        <input type="hidden"
                               name="tab"
                               value="journal" />

                        <div class="col-12 col-md-5">

                            <div class="input-group input-group-sm">

                                <span class="input-group-text bg-white text-muted border-end-0">

                                    <i class="fa-solid fa-magnifying-glass"></i>

                                </span>

                                <input type="text"
                                       name="search"
                                       value="@Model.SearchTerm"
                                       class="form-control border-start-0"
                                       placeholder="Search Voucher No, Party Name..." />

                            </div>

                        </div>

                        <div class="col-12 col-md-4">

                            <select name="voucherType"
                                    class="form-select form-select-sm">

                                <option value="">
                                    -- Filter by Voucher Type --
                                </option>

                                <option value="Sales Invoice"
                                        selected="@(Model.SelectedVoucherType == "Sales Invoice")">
                                    Sales Invoice
                                </option>

                                <option value="Purchase Order"
                                        selected="@(Model.SelectedVoucherType == "Purchase Order")">
                                    Purchase Order
                                </option>

                                <option value="Expense Entry"
                                        selected="@(Model.SelectedVoucherType == "Expense Entry")">
                                    Expense Entry
                                </option>

                                <option value="Payment Voucher"
                                        selected="@(Model.SelectedVoucherType == "Payment Voucher")">
                                    Payment Voucher
                                </option>

                                <option value="Receipt Voucher"
                                        selected="@(Model.SelectedVoucherType == "Receipt Voucher")">
                                    Receipt Voucher
                                </option>

                            </select>

                        </div>

                        <div class="col-12 col-md-3 d-flex gap-2">

                            <button type="submit"
                                    class="btn btn-primary-warm btn-sm px-3 flex-grow-1">

                                <i class="fa-solid fa-filter me-1"></i>

                                Filter

                            </button>

                            <a href="/Accounts?tab=journal"
                               class="btn btn-outline-warm btn-sm px-3">

                                Reset

                            </a>

                        </div>

                    </form>

                    <div class="accounts-table-wrapper">

                        <div class="table-responsive">

                            <table class="table table-accounts align-middle mb-0">

                                <thead>

                                    <tr>

                                        <th>Voucher No</th>

                                        <th>Date</th>

                                        <th>Type</th>

                                        <th>Party / Description</th>

                                        <th>Amount</th>

                                        <th>Status</th>

                                    </tr>

                                </thead>

                                <tbody>

                                    @if (Model.Transactions.Any())
                                    {
                                        @foreach (var tx in Model.Transactions)
                                        {
                                            string statusBadge = tx.Status switch
                                            {
                                                "Paid" => "badge-status-paid",
                                                "Pending" => "badge-status-pending",
                                                _ => "badge-status-cancelled"
                                            };

                                            <tr>

                                                <td>

                                                    <span class="font-monospace fw-bold text-dark voucher-code">

                                                        <i class="fa-solid fa-receipt text-primary"
                                                           style="font-size:.68rem;"></i>

                                                        @tx.TransactionNo

                                                    </span>

                                                </td>

                                                <td class="text-muted small">

                                                    <i class="fa-regular fa-calendar me-1"></i>

                                                    @tx.Date.ToString("MMM dd, yyyy")

                                                </td>

                                                <td>

                                                    <span class="badge bg-secondary-subtle text-dark border px-2 py-1">

                                                        @tx.Type

                                                    </span>

                                                </td>

                                                <td>

                                                    <span class="fw-semibold text-dark">
                                                        @tx.PartyName
                                                    </span>

                                                </td>

                                                <td>

                                                    <span class="fw-bold text-dark">

                                                        ₹@tx.Amount.ToString("N2", inCulture)

                                                    </span>

                                                </td>

                                                <td>

                                                    <span class="badge @statusBadge rounded-pill px-2 py-1">

                                                        @tx.Status

                                                    </span>

                                                </td>

                                            </tr>
                                        }
                                    }
                                    else
                                    {
                                        <tr>

                                            <td colspan="6"
                                                class="text-center text-muted accounts-empty-state">

                                                <span class="accounts-empty-icon">

                                                    <i class="fa-solid fa-receipt fs-4"></i>

                                                </span>

                                                <div class="fw-semibold text-dark mb-1">
                                                    No Financial Vouchers Found
                                                </div>

                                                <div class="small text-muted">
                                                    No vouchers match the selected search or filter.
                                                </div>

                                            </td>

                                        </tr>
                                    }

                                </tbody>

                            </table>

                        </div>

                    </div>

                </div>

                <!-- =================================================
                     TAB 4 — FINANCIAL YEARS
                     ================================================= -->

                <div class="tab-pane fade @(Model.ActiveTab == "fiscal-years" ? "show active" : "")"
                     id="fiscal-pane"
                     role="tabpanel">

                    <div class="accounts-section-heading">

                        <div class="accounts-section-heading-left">

                            <span class="acc-section-heading-icon">
                                <i class="fa-solid fa-calendar-days"></i>
                            </span>

                            <div>

                                <h6>
                                    Fiscal Financial Periods
                                </h6>

                                <p>
                                    Manage ERP accounting cycles and financial year status
                                </p>

                            </div>

                        </div>

                    </div>

                    <div class="row g-3">

                        @foreach (var year in Model.FinancialYears)
                        {
                            <div class="col-12 col-md-4">

                                <div class="fiscal-year-card p-3 shadow-sm @(year.IsCurrent ? "border-primary" : "")">

                                    <div class="d-flex justify-content-between align-items-center gap-2 mb-3">

                                        <div class="d-flex align-items-center gap-2">

                                            <span class="acc-section-heading-icon"
                                                  style="width:34px;height:34px;min-width:34px;border-radius:9px;">

                                                <i class="fa-solid fa-calendar"></i>

                                            </span>

                                            <h6 class="fw-bold text-dark m-0">
                                                @year.YearName
                                            </h6>

                                        </div>

                                        @if (year.IsCurrent)
                                        {
                                            <span class="badge bg-primary rounded-pill px-2 py-1"
                                                  style="font-size:.62rem;">
                                                Active Fiscal Year
                                            </span>
                                        }
                                        else if (year.IsActive)
                                        {
                                            <span class="badge bg-secondary-subtle text-dark rounded-pill px-2 py-1"
                                                  style="font-size:.62rem;">
                                                Open
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-light text-muted border rounded-pill px-2 py-1"
                                                  style="font-size:.62rem;">
                                                Closed / Archived
                                            </span>
                                        }

                                    </div>

                                    <div class="small text-muted">

                                        <div class="d-flex align-items-center gap-2 mb-2">

                                            <i class="fa-solid fa-calendar-day text-primary"
                                               style="width:15px;"></i>

                                            <span>
                                                Start:
                                                <strong class="text-dark">
                                                    @year.StartDate.ToString("MMM dd, yyyy")
                                                </strong>
                                            </span>

                                        </div>

                                        <div class="d-flex align-items-center gap-2">

                                            <i class="fa-solid fa-calendar-check text-success"
                                               style="width:15px;"></i>

                                            <span>
                                                End:
                                                <strong class="text-dark">
                                                    @year.EndDate.ToString("MMM dd, yyyy")
                                                </strong>
                                            </span>

                                        </div>

                                    </div>

                                </div>

                            </div>
                        }

                    </div>

                </div>

            </div>

        </div>

    </div>

    <!-- =====================================================
         MODAL 1 — ADD ACCOUNT HEAD
         ===================================================== -->

    <div class="modal fade"
         id="addAccountHeadModal"
         tabindex="-1"
         aria-labelledby="addAccountHeadModalLabel"
         aria-hidden="true">

        <div class="modal-dialog modal-dialog-centered">

            <div class="modal-content border-0 shadow">

                <form method="post"
                      asp-action="CreateAccountHead">

                    @Html.AntiForgeryToken()

                    <div class="modal-header border-bottom">

                        <h5 class="modal-title fw-bold text-dark d-flex align-items-center gap-2"
                            id="addAccountHeadModalLabel">

                            <span class="modal-title-icon">

                                <i class="fa-solid fa-plus"></i>

                            </span>

                            Add New Account Head

                        </h5>

                        <button type="button"
                                class="btn-close"
                                data-bs-dismiss="modal"
                                aria-label="Close">
                        </button>

                    </div>

                    <div class="modal-body">

                        <div class="mb-3">

                            <label class="form-label small fw-semibold">

                                Head Code

                                <span class="text-danger">*</span>

                            </label>

                            <input type="text"
                                   name="headCode"
                                   class="form-control"
                                   placeholder="e.g. AC-1006"
                                   required />

                        </div>

                        <div class="mb-3">

                            <label class="form-label small fw-semibold">

                                Head Name

                                <span class="text-danger">*</span>

                            </label>

                            <input type="text"
                                   name="headName"
                                   class="form-control"
                                   placeholder="e.g. Petty Cash Reserve"
                                   required />

                        </div>

                        <div class="mb-3">

                            <label class="form-label small fw-semibold">

                                Account Type

                                <span class="text-danger">*</span>

                            </label>

                            <select name="accountType"
                                    class="form-select"
                                    required>

                                <option value="">
                                    -- Select Type --
                                </option>

                                <option value="Asset">
                                    Asset
                                </option>

                                <option value="Liability">
                                    Liability
                                </option>

                                <option value="Equity">
                                    Equity
                                </option>

                                <option value="Revenue">
                                    Revenue
                                </option>

                                <option value="Expense">
                                    Expense
                                </option>

                            </select>

                        </div>

                        <div class="mb-3">

                            <label class="form-label small fw-semibold">
                                Description
                            </label>

                            <textarea name="description"
                                      class="form-control"
                                      rows="2"
                                      placeholder="Brief details about this account head..."></textarea>

                        </div>

                    </div>

                    <div class="modal-footer border-top">

                        <button type="button"
                                class="btn btn-outline-warm btn-sm px-3"
                                data-bs-dismiss="modal">

                            Cancel

                        </button>

                        <button type="submit"
                                class="btn btn-primary-warm btn-sm px-4">

                            <i class="fa-solid fa-check me-1"></i>

                            Create Account Head

                        </button>

                    </div>

                </form>

            </div>

        </div>

    </div>

    <!-- =====================================================
         MODAL 2 — RECORD FINANCIAL VOUCHER
         ===================================================== -->

    <div class="modal fade"
         id="createVoucherModal"
         tabindex="-1"
         aria-labelledby="createVoucherModalLabel"
         aria-hidden="true">

        <div class="modal-dialog modal-dialog-centered">

            <div class="modal-content border-0 shadow">

                <form method="post"
                      asp-action="CreateVoucher">

                    @Html.AntiForgeryToken()

                    <div class="modal-header border-bottom">

                        <h5 class="modal-title fw-bold text-dark d-flex align-items-center gap-2"
                            id="createVoucherModalLabel">

                            <span class="modal-title-icon">

                                <i class="fa-solid fa-receipt"></i>

                            </span>

                            Record Financial Voucher

                        </h5>

                        <button type="button"
                                class="btn-close"
                                data-bs-dismiss="modal"
                                aria-label="Close">
                        </button>

                    </div>

                    <div class="modal-body">

                        <div class="mb-3">

                            <label class="form-label small fw-semibold">

                                Voucher Type

                                <span class="text-danger">*</span>

                            </label>

                            <select name="voucherType"
                                    class="form-select"
                                    required>

                                <option value="Payment Voucher">
                                    Payment Voucher
                                </option>

                                <option value="Receipt Voucher">
                                    Receipt Voucher
                                </option>

                                <option value="Expense Entry">
                                    Expense Entry
                                </option>

                                <option value="Sales Invoice">
                                    Sales Invoice
                                </option>

                                <option value="Purchase Order">
                                    Purchase Order
                                </option>

                            </select>

                        </div>

                        <div class="mb-3">

                            <label class="form-label small fw-semibold">

                                Party / Account Name

                                <span class="text-danger">*</span>

                            </label>

                            <input type="text"
                                   name="partyName"
                                   class="form-control"
                                   placeholder="e.g. ABC Suppliers Ltd / Office Supplies"
                                   required />

                        </div>

                        <div class="mb-3">

                            <label class="form-label small fw-semibold">

                                Amount (INR)

                                <span class="text-danger">*</span>

                            </label>

                            <div class="input-group">

                                <span class="input-group-text bg-light">
                                    ₹
                                </span>

                                <input type="number"
                                       step="0.01"
                                       name="amount"
                                       class="form-control"
                                       placeholder="0.00"
                                       required />

                            </div>

                        </div>

                        <div class="mb-3">

                            <label class="form-label small fw-semibold">

                                Status

                                <span class="text-danger">*</span>

                            </label>

                            <select name="status"
                                    class="form-select"
                                    required>

                                <option value="Paid">
                                    Paid
                                </option>

                                <option value="Pending">
                                    Pending
                                </option>

                            </select>

                        </div>

                    </div>

                    <div class="modal-footer border-top">

                        <button type="button"
                                class="btn btn-outline-warm btn-sm px-3"
                                data-bs-dismiss="modal">

                            Cancel

                        </button>

                        <button type="submit"
                                class="btn btn-primary-warm btn-sm px-4">

                            <i class="fa-solid fa-check me-1"></i>

                            Record Voucher

                        </button>

                    </div>

                </form>

            </div>

        </div>

    </div>

</div>
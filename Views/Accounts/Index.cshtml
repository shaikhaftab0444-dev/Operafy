@model ERP_System.Models.AccountsViewModel
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Accounts & Financial Management";
    var inCulture = new System.Globalization.CultureInfo("en-IN");
}

<style>
    /* =========================================================
           ACCOUNTS & FINANCIAL MANAGEMENT — PREMIUM ERP UI
           UI/UX only: existing Razor, forms, routes and JS preserved
           ========================================================= */

    :root {
        --acc-primary: #2563eb;
        --acc-primary-dark: #1d4ed8;
        --acc-primary-soft: #eff6ff;
        --acc-success: #059669;
        --acc-success-soft: #ecfdf5;
        --acc-danger: #dc2626;
        --acc-danger-soft: #fef2f2;
        --acc-warning: #d97706;
        --acc-warning-soft: #fffbeb;
        --acc-info: #0284c7;
        --acc-info-soft: #f0f9ff;
        --acc-purple: #7c3aed;
        --acc-purple-soft: #f5f3ff;
        --acc-text: #172033;
        --acc-muted: #64748b;
        --acc-border: #e5e7eb;
        --acc-surface: #ffffff;
        --acc-surface-soft: #f8fafc;
        --acc-radius: 16px;
        --acc-shadow: 0 8px 28px rgba(15, 23, 42, 0.055);
        --acc-shadow-hover: 0 14px 34px rgba(15, 23, 42, 0.10);
    }

    .accounts-page {
        width: 100%;
        animation: accPageIn .45s ease both;
    }

    .panel-accounts {
        background: var(--acc-surface);
        border: 1px solid var(--acc-border);
        border-radius: var(--acc-radius);
        box-shadow: var(--acc-shadow);
        overflow: hidden;
    }

    /* Header */
    .accounts-page .breadcrumb {
        margin-bottom: .5rem !important;
    }

    .accounts-page .breadcrumb-item {
        font-size: .78rem;
    }

        .accounts-page .breadcrumb-item + .breadcrumb-item::before {
            color: #94a3b8;
        }

    .accounts-page h4 {
        letter-spacing: -.025em;
    }

    .accounts-page .page-subtitle {
        max-width: 760px;
        line-height: 1.6;
    }

    /* KPI cards */
    .kpi-card-acc {
        height: 100%;
        min-height: 116px;
        background: linear-gradient(145deg, #ffffff 0%, #fbfdff 100%);
        border: 1px solid var(--acc-border);
        border-radius: 14px;
        padding: 1.1rem;
        box-shadow: 0 3px 14px rgba(15, 23, 42, .035);
        display: flex;
        align-items: center;
        gap: 1rem;
        position: relative;
        overflow: hidden;
        transition: transform .25s ease, box-shadow .25s ease, border-color .25s ease;
        animation: accCardIn .5s ease both;
    }

        .kpi-card-acc::after {
            content: "";
            position: absolute;
            width: 78px;
            height: 78px;
            right: -30px;
            bottom: -34px;
            border-radius: 50%;
            background: rgba(37, 99, 235, .035);
            pointer-events: none;
        }

        .kpi-card-acc:hover {
            transform: translateY(-4px);
            border-color: #d6deeb;
            box-shadow: var(--acc-shadow-hover);
        }

    .kpi-icon-acc {
        width: 50px;
        height: 50px;
        min-width: 50px;
        border-radius: 13px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 1.15rem;
        flex-shrink: 0;
        box-shadow: inset 0 0 0 1px rgba(255,255,255,.55);
    }

    .kpi-card-acc h5 {
        font-size: 1.05rem;
        letter-spacing: -.015em;
    }

    /* Buttons */
    .btn-primary-warm {
        background: linear-gradient(135deg, var(--acc-primary), #3b82f6);
        color: #fff;
        font-weight: 700;
        border: 0;
        border-radius: 9px;
        min-height: 38px;
        box-shadow: 0 4px 12px rgba(37, 99, 235, .16);
        transition: transform .2s ease, box-shadow .2s ease, background .2s ease;
    }

        .btn-primary-warm:hover,
        .btn-primary-warm:focus {
            background: linear-gradient(135deg, var(--acc-primary-dark), var(--acc-primary));
            color: #fff;
            transform: translateY(-1px);
            box-shadow: 0 7px 16px rgba(37, 99, 235, .22);
        }

        .btn-primary-warm:active {
            transform: translateY(0);
        }

    .btn-outline-warm {
        border: 1px solid #d5dce6;
        background: #fff;
        color: #334155;
        font-weight: 700;
        border-radius: 9px;
        min-height: 38px;
        transition: all .2s ease;
    }

        .btn-outline-warm:hover,
        .btn-outline-warm:focus {
            background: #f8fafc;
            border-color: #aeb9c8;
            color: #0f172a;
            transform: translateY(-1px);
        }

    /* Tabs */
    .nav-tabs-accounts {
        border-bottom: 1px solid var(--acc-border);
        gap: .25rem;
        padding: .35rem;
        background: #f8fafc;
        border-radius: 12px;
        overflow-x: auto;
        scrollbar-width: thin;
    }

        .nav-tabs-accounts .nav-item {
            flex: 0 0 auto;
        }

        .nav-tabs-accounts .nav-link {
            border: 1px solid transparent;
            color: #64748b;
            background: transparent;
            font-weight: 700;
            font-size: .86rem;
            padding: .72rem .95rem;
            border-radius: 9px;
            transition: all .2s ease;
            display: flex;
            align-items: center;
            gap: 8px;
            white-space: nowrap;
        }

            .nav-tabs-accounts .nav-link:hover {
                color: #1e293b;
                background: #fff;
                border-color: #e2e8f0;
            }

            .nav-tabs-accounts .nav-link.active {
                color: var(--acc-primary);
                background: #fff;
                border-color: #dbeafe;
                box-shadow: 0 3px 10px rgba(15, 23, 42, .055);
            }

            .nav-tabs-accounts .nav-link i {
                font-size: .88rem;
            }

    /* Bank cards */
    .bank-card {
        height: 100%;
        background: linear-gradient(145deg, #ffffff 0%, #fbfdff 100%);
        border: 1px solid var(--acc-border);
        border-radius: 14px;
        padding: 1.15rem;
        position: relative;
        overflow: hidden;
        transition: all .25s ease;
    }

        .bank-card::before {
            content: "";
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 3px;
            background: linear-gradient(90deg, #2563eb, #60a5fa);
            opacity: .75;
            transform: scaleX(0);
            transform-origin: left;
            transition: transform .3s ease;
        }

        .bank-card:hover {
            border-color: #bfdbfe;
            transform: translateY(-3px);
            box-shadow: 0 12px 28px rgba(37, 99, 235, .09);
        }

            .bank-card:hover::before {
                transform: scaleX(1);
            }

        .bank-card .font-monospace {
            font-size: .74rem;
            letter-spacing: .02em;
        }

    /* Type & status badges */
    .badge-type-asset,
    .badge-type-liability,
    .badge-type-equity,
    .badge-type-revenue,
    .badge-type-expense,
    .badge-status-paid,
    .badge-status-pending,
    .badge-status-cancelled {
        font-weight: 700;
        border-width: 1px;
        border-style: solid;
    }

    .badge-type-asset {
        background-color: #eff6ff;
        color: #1d4ed8;
        border-color: #bfdbfe;
    }

    .badge-type-liability {
        background-color: #fff7ed;
        color: #c2410c;
        border-color: #fed7aa;
    }

    .badge-type-equity {
        background-color: #faf5ff;
        color: #7e22ce;
        border-color: #e9d5ff;
    }

    .badge-type-revenue {
        background-color: #f0fdf4;
        color: #15803d;
        border-color: #bbf7d0;
    }

    .badge-type-expense {
        background-color: #fef2f2;
        color: #b91c1c;
        border-color: #fecaca;
    }

    .badge-status-paid {
        background-color: rgba(16,185,129,.10);
        color: #047857;
        border-color: rgba(16,185,129,.20);
    }

    .badge-status-pending {
        background-color: rgba(245,158,11,.10);
        color: #b45309;
        border-color: rgba(245,158,11,.20);
    }

    .badge-status-cancelled {
        background-color: rgba(239,68,68,.10);
        color: #b91c1c;
        border-color: rgba(239,68,68,.20);
    }

    /* Filter areas */
    .accounts-filter {
        background: #f8fafc;
        border: 1px solid #e8edf3;
        border-radius: 12px;
        padding: .75rem;
    }

    .accounts-page .form-control,
    .accounts-page .form-select {
        min-height: 40px;
        border-color: #dbe2ea;
        color: #1e293b;
        border-radius: 9px;
        font-size: .84rem;
        box-shadow: none;
        transition: border-color .2s ease, box-shadow .2s ease;
    }

        .accounts-page .form-control:focus,
        .accounts-page .form-select:focus {
            border-color: #93c5fd;
            box-shadow: 0 0 0 .2rem rgba(37, 99, 235, .09);
        }

    .accounts-page .input-group-text {
        border-color: #dbe2ea;
        border-radius: 9px 0 0 9px;
    }

    /* Tables */
    .table-responsive {
        border: 1px solid #e8edf3;
        border-radius: 12px;
        background: #fff;
    }

    .table-accounts {
        min-width: 820px;
        margin-bottom: 0;
    }

        .table-accounts th {
            background: #f8fafc !important;
            font-size: .7rem;
            text-transform: uppercase;
            letter-spacing: .055em;
            font-weight: 800;
            color: #64748b;
            border-bottom: 1px solid #e2e8f0;
            padding: .85rem 1rem;
            white-space: nowrap;
        }

        .table-accounts td {
            font-size: .84rem;
            color: var(--acc-text);
            border-bottom: 1px solid #edf1f5;
            padding: .9rem 1rem;
            vertical-align: middle;
        }

        .table-accounts tbody tr {
            transition: background-color .18s ease;
        }

            .table-accounts tbody tr:hover {
                background: #f8fbff;
            }

            .table-accounts tbody tr:last-child td {
                border-bottom: 0;
            }

        .table-accounts .font-monospace {
            font-size: .78rem;
        }

    /* Overview mini cards */
    .accounts-mini-card {
        height: 100%;
        background: #fff;
        border: 1px solid #e5eaf0;
        border-radius: 11px;
        padding: .75rem;
        transition: transform .2s ease, box-shadow .2s ease, border-color .2s ease;
    }

        .accounts-mini-card:hover {
            transform: translateY(-2px);
            border-color: #d7e1ed;
            box-shadow: 0 7px 18px rgba(15,23,42,.06);
        }

    .accounts-section-box {
        background: linear-gradient(145deg, #f8fafc, #ffffff);
        border: 1px solid #e7ecf2 !important;
        border-radius: 13px !important;
    }

    /* Fiscal year cards */
    .fiscal-year-card {
        height: 100%;
        border-radius: 13px !important;
        transition: transform .22s ease, box-shadow .22s ease, border-color .22s ease;
    }

        .fiscal-year-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 10px 24px rgba(15,23,42,.07) !important;
        }

    /* Alerts */
    .accounts-page .alert {
        border-radius: 11px;
        padding: .8rem 1rem;
        animation: accSlideDown .35s ease both;
    }

    /* Modals */
    .accounts-page .modal-content {
        border-radius: 17px !important;
        overflow: hidden;
        box-shadow: 0 24px 70px rgba(15,23,42,.20) !important;
        animation: accModalIn .25s ease both;
    }

    .accounts-page .modal-header {
        background: linear-gradient(180deg, #ffffff, #f8fafc);
        padding: 1rem 1.15rem;
    }

    .accounts-page .modal-body {
        padding: 1.15rem;
    }

    .accounts-page .modal-footer {
        background: #f8fafc;
        padding: .85rem 1.15rem;
    }

    .accounts-page .form-label {
        margin-bottom: .4rem;
        letter-spacing: .01em;
    }

    .accounts-page textarea.form-control {
        resize: vertical;
        min-height: 82px;
    }

    /* Empty state */
    .accounts-empty-state {
        padding: 2.5rem 1rem !important;
    }

        .accounts-empty-state i {
            width: 52px;
            height: 52px;
            margin: 0 auto .75rem;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            background: #f1f5f9;
            border-radius: 50%;
        }

    /* Utility */
    .accounts-page .text-truncate {
        max-width: 100%;
    }

    .accounts-page .tab-pane {
        animation: accTabIn .25s ease both;
    }

    /* Responsive */
    @@media (min-width: 1200px) {
        .col-xl-2-4

    {
        flex: 0 0 auto;
        width: 20%;
    }

    }

    @@media (max-width: 1199.98px) {
        .kpi-card-acc

    {
        min-height: 108px;
    }

    }

    @@media (max-width: 991.98px) {
        .panel-accounts

    {
        border-radius: 13px;
    }

    .nav-tabs-accounts {
        margin-left: -.25rem;
        margin-right: -.25rem;
    }

    .accounts-page .page-subtitle {
        max-width: 100%;
    }

    .bank-card {
        padding: 1rem;
    }

    }

    @@media (max-width: 767.98px) {
        .accounts-page

    {
        overflow-x: hidden;
    }

    .accounts-page .top-page-actions {
        width: 100%;
    }

        .accounts-page .top-page-actions .btn {
            flex: 1 1 0;
            min-width: 0;
        }

    .kpi-card-acc {
        min-height: 100px;
        padding: .95rem;
        gap: .8rem;
    }

    .kpi-icon-acc {
        width: 44px;
        height: 44px;
        min-width: 44px;
        font-size: 1rem;
        border-radius: 11px;
    }

    .kpi-card-acc h5 {
        font-size: .98rem;
    }

    .nav-tabs-accounts {
        flex-wrap: nowrap;
        padding: .3rem;
    }

        .nav-tabs-accounts .nav-link {
            font-size: .78rem;
            padding: .65rem .75rem;
        }

    .panel-accounts.p-3 {
        padding: .8rem !important;
    }

    .accounts-filter {
        padding: .65rem;
    }

    .table-responsive {
        border-radius: 10px;
    }

    .modal-dialog {
        margin: .7rem;
    }

    }

    @@media (max-width: 575.98px) {
        .accounts-page h4

    {
        font-size: 1.18rem;
    }

    .accounts-page .breadcrumb-item {
        font-size: .72rem;
    }

    .accounts-page .page-subtitle {
        font-size: .76rem !important;
    }

    .accounts-page .top-page-actions {
        flex-direction: column;
    }

        .accounts-page .top-page-actions .btn {
            width: 100%;
        }

    .kpi-card-acc {
        min-height: 92px;
    }

        .kpi-card-acc .text-muted.small {
            font-size: .68rem !important;
        }

    .nav-tabs-accounts .nav-link {
        padding: .6rem .68rem;
    }

    .accounts-page .modal-header,
    .accounts-page .modal-body,
    .accounts-page .modal-footer {
        padding-left: .9rem;
        padding-right: .9rem;
    }

    .accounts-page .modal-footer {
        flex-wrap: wrap;
    }

        .accounts-page .modal-footer .btn {
            flex: 1 1 auto;
        }

    }

    @@media (prefers-reduced-motion: reduce) {
        .accounts-page *, .accounts-page *::before, .accounts-page *::after

    {
        animation-duration: .01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: .01ms !important;
        scroll-behavior: auto !important;
    }

    }

    /* Animations */
    @@keyframes accPageIn {
        from

    {
        opacity: 0;
        transform: translateY(8px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }

    }

    @@keyframes accCardIn {
        from

    {
        opacity: 0;
        transform: translateY(10px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }

    }

    @@keyframes accSlideDown {
        from

    {
        opacity: 0;
        transform: translateY(-8px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }

    }

    @@keyframes accModalIn {
        from

    {
        opacity: 0;
        transform: translateY(8px) scale(.985);
    }

    to {
        opacity: 1;
        transform: translateY(0) scale(1);
    }

    }

    @@keyframes accTabIn {
        from

    {
        opacity: 0;
        transform: translateY(4px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }

    }</style>

<div class="accounts-page">

    ```
    <!-- Top Header & Breadcrumbs -->
    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-3 mb-4 text-start">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1 small">
                    <li class="breadcrumb-item">
                        <a href="/Dashboard" class="text-decoration-none text-muted">Dashboard</a>
                    </li>
                    <li class="breadcrumb-item active fw-semibold text-primary" aria-current="page">
                        Accounting & Financials
                    </li>
                </ol>
            </nav>

            <h4 class="fw-bold m-0 text-dark">Accounts & Financial Management</h4>

            <p class="text-muted small m-0 page-subtitle">
                Manage Chart of Accounts, General Ledger vouchers, cash balances, and financial health.
            </p>
        </div>

        <div class="d-flex gap-2 top-page-actions">
            <button type="button"
                    class="btn btn-outline-warm btn-sm px-3 py-2"
                    data-bs-toggle="modal"
                    data-bs-target="#createVoucherModal">
                <i class="fa-solid fa-receipt me-1 text-primary"></i>
                + Record Voucher
            </button>

            <button type="button"
                    class="btn btn-primary-warm btn-sm px-3 py-2"
                    data-bs-toggle="modal"
                    data-bs-target="#addAccountHeadModal">
                <i class="fa-solid fa-plus me-1"></i>
                + Add Account Head
            </button>
        </div>
    </div>

    <!-- TempData Success / Error Toast Alerts -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm mb-4" role="alert">
            <i class="fa-solid fa-circle-check me-2"></i>
            @TempData["SuccessMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Close">
            </button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm mb-4" role="alert">
            <i class="fa-solid fa-triangle-exclamation me-2"></i>
            @TempData["ErrorMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Close">
            </button>
        </div>
    }

    <!-- KPI Cards Overview Row -->
    <div class="row g-3 mb-4">

        <div class="col-12 col-sm-6 col-xl-2-4">
            <div class="kpi-card-acc">
                <div class="kpi-icon-acc bg-primary-subtle text-primary">
                    <i class="fa-solid fa-vault"></i>
                </div>

                <div>
                    <span class="text-muted small d-block fw-semibold">Total Assets</span>

                    <h5 class="fw-bold mb-0 text-dark">
                        ₹@Model.TotalAssets.ToString("N0", inCulture)
                    </h5>

                    <span class="badge bg-success-subtle text-success mt-1"
                          style="font-size: 0.7rem;">
                        <i class="fa-solid fa-arrow-trend-up me-1"></i>
                        Healthy Position
                    </span>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-2-4">
            <div class="kpi-card-acc">
                <div class="kpi-icon-acc bg-success-subtle text-success">
                    <i class="fa-solid fa-arrow-down-left"></i>
                </div>

                <div>
                    <span class="text-muted small d-block fw-semibold">Total Revenue</span>

                    <h5 class="fw-bold mb-0 text-dark">
                        ₹@Model.TotalRevenue.ToString("N0", inCulture)
                    </h5>

                    <span class="text-muted small"
                          style="font-size: 0.72rem;">
                        @Model.RevenueHeadsCount Revenue Heads
                    </span>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-2-4">
            <div class="kpi-card-acc">
                <div class="kpi-icon-acc bg-danger-subtle text-danger">
                    <i class="fa-solid fa-arrow-up-right"></i>
                </div>

                <div>
                    <span class="text-muted small d-block fw-semibold">Total Expenses</span>

                    <h5 class="fw-bold mb-0 text-dark">
                        ₹@Model.TotalExpenses.ToString("N0", inCulture)
                    </h5>

                    <span class="text-muted small"
                          style="font-size: 0.72rem;">
                        @Model.ExpenseHeadsCount Expense Heads
                    </span>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-2-4">
            <div class="kpi-card-acc">
                <div class="kpi-icon-acc bg-info-subtle text-info">
                    <i class="fa-solid fa-scale-balanced"></i>
                </div>

                <div>
                    <span class="text-muted small d-block fw-semibold">Net Cash Flow</span>

                    <h5 class="fw-bold mb-0 @(Model.NetCashFlow >= 0 ? "text-success" : "text-danger")">
                        ₹@Model.NetCashFlow.ToString("N0", inCulture)
                    </h5>

                    <span class="text-muted small"
                          style="font-size: 0.72rem;">
                        Operating Balance
                    </span>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-2-4">
            <div class="kpi-card-acc">
                <div class="kpi-icon-acc bg-warning-subtle text-warning">
                    <i class="fa-solid fa-list-check"></i>
                </div>

                <div>
                    <span class="text-muted small d-block fw-semibold">Account Heads</span>

                    <h5 class="fw-bold mb-0 text-dark">
                        @Model.ActiveAccountHeadsCount / @Model.TotalAccountHeads
                    </h5>

                    <span class="text-muted small"
                          style="font-size: 0.72rem;">
                        Active Ledger Heads
                    </span>
                </div>
            </div>
        </div>

    </div>

    <!-- Main Tabs Section -->
    <div class="panel-accounts p-3 mb-4">

        <ul class="nav nav-tabs nav-tabs-accounts mb-4"
            id="accountsTab"
            role="tablist">

            <li class="nav-item" role="presentation">
                <button class="nav-link @(Model.ActiveTab == "overview" ? "active" : "")"
                        id="overview-tab"
                        data-bs-toggle="tab"
                        data-bs-target="#overview-pane"
                        type="button"
                        role="tab">
                    <i class="fa-solid fa-chart-pie"></i>
                    Overview & Cash/Bank
                </button>
            </li>

            <li class="nav-item" role="presentation">
                <button class="nav-link @(Model.ActiveTab == "chart-of-accounts" ? "active" : "")"
                        id="chart-tab"
                        data-bs-toggle="tab"
                        data-bs-target="#chart-pane"
                        type="button"
                        role="tab">
                    <i class="fa-solid fa-sitemap"></i>
                    Chart of Accounts (@Model.TotalAccountHeads)
                </button>
            </li>

            <li class="nav-item" role="presentation">
                <button class="nav-link @(Model.ActiveTab == "journal" ? "active" : "")"
                        id="journal-tab"
                        data-bs-toggle="tab"
                        data-bs-target="#journal-pane"
                        type="button"
                        role="tab">
                    <i class="fa-solid fa-file-invoice-dollar"></i>
                    General Ledger Vouchers (@Model.Transactions.Count)
                </button>
            </li>

            <li class="nav-item" role="presentation">
                <button class="nav-link @(Model.ActiveTab == "fiscal-years" ? "active" : "")"
                        id="fiscal-tab"
                        data-bs-toggle="tab"
                        data-bs-target="#fiscal-pane"
                        type="button"
                        role="tab">
                    <i class="fa-solid fa-calendar-days"></i>
                    Financial Years
                </button>
            </li>

        </ul>

        <div class="tab-content" id="accountsTabContent">

            <!-- TAB 1: OVERVIEW & CASH/BANK -->
            <div class="tab-pane fade @(Model.ActiveTab == "overview" ? "show active" : "")"
                 id="overview-pane"
                 role="tabpanel">

                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h6 class="fw-bold text-dark m-0">
                        <i class="fa-solid fa-building-columns text-primary me-2"></i>
                        Cash & Commercial Bank Accounts
                    </h6>

                    <span class="text-muted small">
                        Real-time Account Liquidity
                    </span>
                </div>

                <div class="row g-3 mb-4">

                    @foreach (var bank in Model.BankAccounts)
                    {
                        <div class="col-12 col-md-6 col-xl-3">

                            <div class="bank-card">

                                <div class="d-flex justify-content-between align-items-start mb-3">

                                    <div class="kpi-icon-acc @bank.BadgeClass">
                                        <i class="fa-solid @bank.IconClass"></i>
                                    </div>

                                    <span class="badge @bank.BadgeClass rounded-pill px-2.5 py-1"
                                          style="font-size: 0.7rem;">
                                        @bank.Status
                                    </span>

                                </div>

                                <span class="text-muted small d-block mb-1">
                                    @bank.BankName
                                </span>

                                <h6 class="fw-bold text-dark text-truncate mb-1">
                                    @bank.AccountName
                                </h6>

                                <p class="text-muted font-monospace small mb-3">
                                    Acc: @bank.AccountNumber
                                </p>

                                <div class="pt-2 border-top d-flex justify-content-between align-items-center">
                                    <span class="text-muted small">
                                        Available Balance
                                    </span>

                                    <span class="fw-bold text-dark">
                                        ₹@bank.Balance.ToString("N0", inCulture)
                                    </span>
                                </div>

                            </div>

                        </div>
                    }

                </div>

                <!-- Ledger Breakdown Grid -->
                <div class="row g-3">

                    <div class="col-12 col-lg-7">

                        <div class="accounts-section-box border rounded-3 p-3 bg-light-subtle">

                            <h6 class="fw-bold text-dark mb-3">
                                <i class="fa-solid fa-chart-simple me-2 text-info"></i>
                                Chart of Accounts Type Distribution
                            </h6>

                            <div class="row g-2 text-center">

                                <div class="col">
                                    <div class="accounts-mini-card p-2 border bg-white rounded">
                                        <span class="badge badge-type-asset mb-1">
                                            Asset
                                        </span>

                                        <h5 class="fw-bold text-dark mb-0">
                                            @Model.AssetHeadsCount
                                        </h5>

                                        <span class="text-muted small"
                                              style="font-size: 0.7rem;">
                                            Heads
                                        </span>
                                    </div>
                                </div>

                                <div class="col">
                                    <div class="accounts-mini-card p-2 border bg-white rounded">
                                        <span class="badge badge-type-liability mb-1">
                                            Liability
                                        </span>

                                        <h5 class="fw-bold text-dark mb-0">
                                            @Model.LiabilityHeadsCount
                                        </h5>

                                        <span class="text-muted small"
                                              style="font-size: 0.7rem;">
                                            Heads
                                        </span>
                                    </div>
                                </div>

                                <div class="col">
                                    <div class="accounts-mini-card p-2 border bg-white rounded">
                                        <span class="badge badge-type-equity mb-1">
                                            Equity
                                        </span>

                                        <h5 class="fw-bold text-dark mb-0">
                                            @Model.EquityHeadsCount
                                        </h5>

                                        <span class="text-muted small"
                                              style="font-size: 0.7rem;">
                                            Heads
                                        </span>
                                    </div>
                                </div>

                                <div class="col">
                                    <div class="accounts-mini-card p-2 border bg-white rounded">
                                        <span class="badge badge-type-revenue mb-1">
                                            Revenue
                                        </span>

                                        <h5 class="fw-bold text-dark mb-0">
                                            @Model.RevenueHeadsCount
                                        </h5>

                                        <span class="text-muted small"
                                              style="font-size: 0.7rem;">
                                            Heads
                                        </span>
                                    </div>
                                </div>

                                <div class="col">
                                    <div class="accounts-mini-card p-2 border bg-white rounded">
                                        <span class="badge badge-type-expense mb-1">
                                            Expense
                                        </span>

                                        <h5 class="fw-bold text-dark mb-0">
                                            @Model.ExpenseHeadsCount
                                        </h5>

                                        <span class="text-muted small"
                                              style="font-size: 0.7rem;">
                                            Heads
                                        </span>
                                    </div>
                                </div>

                            </div>

                        </div>

                    </div>

                    <div class="col-12 col-lg-5">

                        <div class="accounts-section-box border rounded-3 p-3 bg-light-subtle h-100 d-flex flex-column justify-content-between">

                            <div>

                                <h6 class="fw-bold text-dark mb-2">
                                    <i class="fa-solid fa-clock-history me-2 text-warning"></i>
                                    Pending Action Items
                                </h6>

                                <p class="text-muted small mb-3">
                                    Unsettled or pending vouchers requiring accountant review.
                                </p>

                                <div class="d-flex align-items-center justify-content-between p-2.5 bg-white border rounded mb-2">

                                    <div>
                                        <span class="fw-semibold text-dark d-block">
                                            Pending Vouchers
                                        </span>

                                        <span class="text-muted small">
                                            @Model.PendingVouchersCount Vouchers Awaiting Approval
                                        </span>
                                    </div>

                                    <span class="badge bg-warning-subtle text-warning fw-bold fs-6">
                                        ₹@Model.PendingVouchersAmount.ToString("N0", inCulture)
                                    </span>

                                </div>

                            </div>

                            <button type="button"
                                    class="btn btn-outline-warm btn-sm w-100 mt-2"
                                    onclick="document.getElementById('journal-tab').click();">
                                View All Journal Entries
                                <i class="fa-solid fa-arrow-right ms-1"></i>
                            </button>

                        </div>

                    </div>

                </div>

            </div>

            <!-- TAB 2: CHART OF ACCOUNTS -->
            <div class="tab-pane fade @(Model.ActiveTab == "chart-of-accounts" ? "show active" : "")"
                 id="chart-pane"
                 role="tabpanel">

                <!-- Filter Bar -->
                <form method="get"
                      asp-action="Index"
                      class="row g-2 mb-3 align-items-center accounts-filter">

                    <input type="hidden"
                           name="tab"
                           value="chart-of-accounts" />

                    <div class="col-12 col-md-5">

                        <div class="input-group input-group-sm">

                            <span class="input-group-text bg-white text-muted border-end-0">
                                <i class="fa-solid fa-magnifying-glass"></i>
                            </span>

                            <input type="text"
                                   name="search"
                                   value="@Model.SearchTerm"
                                   class="form-control border-start-0"
                                   placeholder="Search Head Code, Name, or Description..." />

                        </div>

                    </div>

                    <div class="col-12 col-md-4">

                        <select name="accountType"
                                class="form-select form-select-sm">

                            <option value="">
                                -- Filter by Account Type --
                            </option>

                            <option value="Asset"
                                    selected="@(Model.SelectedAccountType == "Asset")">
                                Asset
                            </option>

                            <option value="Liability"
                                    selected="@(Model.SelectedAccountType == "Liability")">
                                Liability
                            </option>

                            <option value="Equity"
                                    selected="@(Model.SelectedAccountType == "Equity")">
                                Equity
                            </option>

                            <option value="Revenue"
                                    selected="@(Model.SelectedAccountType == "Revenue")">
                                Revenue
                            </option>

                            <option value="Expense"
                                    selected="@(Model.SelectedAccountType == "Expense")">
                                Expense
                            </option>

                        </select>

                    </div>

                    <div class="col-12 col-md-3 d-flex gap-2">

                        <button type="submit"
                                class="btn btn-primary-warm btn-sm px-3 flex-grow-1">
                            Filter
                        </button>

                        <a href="/Accounts?tab=chart-of-accounts"
                           class="btn btn-outline-warm btn-sm px-3">
                            Reset
                        </a>

                    </div>

                </form>

                <div class="table-responsive">

                    <table class="table table-accounts align-middle mb-0">

                        <thead>
                            <tr>
                                <th>Head Code</th>
                                <th>Account Head Name</th>
                                <th>Account Type</th>
                                <th>Description</th>
                                <th>Created Date</th>
                                <th>Status</th>
                                <th class="text-end">Action</th>
                            </tr>
                        </thead>

                        <tbody>

                            @if (Model.AccountHeads.Any())
                            {
                                @foreach (var head in Model.AccountHeads)
                                {
                                    string badgeStyle = head.AccountType switch
                                    {
                                        "Asset" => "badge-type-asset",
                                        "Liability" => "badge-type-liability",
                                        "Equity" => "badge-type-equity",
                                        "Revenue" => "badge-type-revenue",
                                        "Expense" => "badge-type-expense",
                                        _ => "bg-secondary-subtle text-secondary"
                                    };

                                    <tr>

                                        <td>
                                            <span class="font-monospace fw-bold text-dark">
                                                @head.HeadCode
                                            </span>
                                        </td>

                                        <td>
                                            <span class="fw-semibold text-dark">
                                                @head.HeadName
                                            </span>
                                        </td>

                                        <td>
                                            <span class="badge @badgeStyle rounded-pill px-2.5 py-1">
                                                @head.AccountType
                                            </span>
                                        </td>

                                        <td class="text-muted small"
                                            style="max-width: 250px;">
                                            @(string.IsNullOrEmpty(head.Description)
                                                                                ? "-"
                                                                                : head.Description)
                                </td>

                                        <td class="text-muted small">
                                            @head.CreatedAt.ToString("MMM dd, yyyy")
                                        </td>

                                        <td>

                                    @if (head.IsActive)
                                            {
                                                <span class="badge bg-success-subtle text-success rounded-pill px-2 py-1">
                                                    <i class="fa-solid fa-circle me-1 small"
                                                       style="font-size:0.5rem;"></i>
                                                    Active
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary-subtle text-secondary rounded-pill px-2 py-1">
                                                    <i class="fa-solid fa-circle me-1 small"
                                                       style="font-size:0.5rem;"></i>
                                                    Inactive
                                                </span>
                                            }

                                        </td>

                                        <td class="text-end">

                                            <form method="post"
                                                  asp-action="ToggleHeadStatus"
                                                  asp-route-id="@head.AccountHeadId"
                                                  class="d-inline">

                                                @Html.AntiForgeryToken()

                                                <button type="submit"
                                                        class="btn btn-sm @(head.IsActive ? "btn-outline-danger" : "btn-outline-success") py-0 px-2"
                                                        style="font-size: 0.75rem;">
                                                    @(head.IsActive ? "Deactivate" : "Activate")
                                                </button>

                                            </form>

                                        </td>

                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="7"
                                        class="text-center py-4 text-muted accounts-empty-state">

                                        <i class="fa-solid fa-folder-open d-block fs-3 mb-2 text-secondary"></i>

                                        No Account Heads found matching the criteria.

                                    </td>
                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

            </div>

            <!-- TAB 3: GENERAL LEDGER VOUCHERS -->
            <div class="tab-pane fade @(Model.ActiveTab == "journal" ? "show active" : "")"
                 id="journal-pane"
                 role="tabpanel">

                <!-- Filter Bar -->
                <form method="get"
                      asp-action="Index"
                      class="row g-2 mb-3 align-items-center accounts-filter">

                    <input type="hidden"
                           name="tab"
                           value="journal" />

                    <div class="col-12 col-md-5">

                        <div class="input-group input-group-sm">

                            <span class="input-group-text bg-white text-muted border-end-0">
                                <i class="fa-solid fa-magnifying-glass"></i>
                            </span>

                            <input type="text"
                                   name="search"
                                   value="@Model.SearchTerm"
                                   class="form-control border-start-0"
                                   placeholder="Search Voucher No, Party Name..." />

                        </div>

                    </div>

                    <div class="col-12 col-md-4">

                        <select name="voucherType"
                                class="form-select form-select-sm">

                            <option value="">
                                -- Filter by Voucher Type --
                            </option>

                            <option value="Sales Invoice"
                                    selected="@(Model.SelectedVoucherType == "Sales Invoice")">
                                Sales Invoice
                            </option>

                            <option value="Purchase Order"
                                    selected="@(Model.SelectedVoucherType == "Purchase Order")">
                                Purchase Order
                            </option>

                            <option value="Expense Entry"
                                    selected="@(Model.SelectedVoucherType == "Expense Entry")">
                                Expense Entry
                            </option>

                            <option value="Payment Voucher"
                                    selected="@(Model.SelectedVoucherType == "Payment Voucher")">
                                Payment Voucher
                            </option>

                            <option value="Receipt Voucher"
                                    selected="@(Model.SelectedVoucherType == "Receipt Voucher")">
                                Receipt Voucher
                            </option>

                        </select>

                    </div>

                    <div class="col-12 col-md-3 d-flex gap-2">

                        <button type="submit"
                                class="btn btn-primary-warm btn-sm px-3 flex-grow-1">
                            Filter
                        </button>

                        <a href="/Accounts?tab=journal"
                           class="btn btn-outline-warm btn-sm px-3">
                            Reset
                        </a>

                    </div>

                </form>

                <div class="table-responsive">

                    <table class="table table-accounts align-middle mb-0">

                        <thead>
                            <tr>
                                <th>Voucher No</th>
                                <th>Date</th>
                                <th>Type</th>
                                <th>Party / Description</th>
                                <th>Amount</th>
                                <th>Status</th>
                            </tr>
                        </thead>

                        <tbody>

                            @if (Model.Transactions.Any())
                            {
                                @foreach (var tx in Model.Transactions)
                                {
                                    string statusBadge = tx.Status switch
                                    {
                                        "Paid" => "badge-status-paid",
                                        "Pending" => "badge-status-pending",
                                        _ => "badge-status-cancelled"
                                    };

                                    <tr>

                                        <td>
                                            <span class="font-monospace fw-bold text-dark">
                                                @tx.TransactionNo
                                            </span>
                                        </td>

                                        <td class="text-muted small">
                                            @tx.Date.ToString("MMM dd, yyyy")
                                        </td>

                                        <td>
                                            <span class="badge bg-secondary-subtle text-dark border px-2 py-1">
                                                @tx.Type
                                            </span>
                                        </td>

                                        <td>
                                            <span class="fw-semibold text-dark">
                                                @tx.PartyName
                                            </span>
                                        </td>

                                        <td>
                                            <span class="fw-bold text-dark">
                                                ₹@tx.Amount.ToString("N2", inCulture)
                                            </span>
                                        </td>

                                        <td>
                                            <span class="badge @statusBadge rounded-pill px-2.5 py-1">
                                                @tx.Status
                                            </span>
                                        </td>

                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="6"
                                        class="text-center py-4 text-muted accounts-empty-state">

                                        <i class="fa-solid fa-receipt d-block fs-3 mb-2 text-secondary"></i>

                                        No financial vouchers found.

                                    </td>
                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

            </div>

            <!-- TAB 4: FINANCIAL YEARS -->
            <div class="tab-pane fade @(Model.ActiveTab == "fiscal-years" ? "show active" : "")"
                 id="fiscal-pane"
                 role="tabpanel">

                <div class="d-flex justify-content-between align-items-center mb-3">

                    <h6 class="fw-bold text-dark m-0">
                        <i class="fa-solid fa-calendar-days text-primary me-2"></i>
                        Fiscal Financial Periods
                    </h6>

                    <span class="text-muted small">
                        ERP Accounting Cycles
                    </span>

                </div>

                <div class="row g-3">

                    @foreach (var year in Model.FinancialYears)
                    {
                        <div class="col-12 col-md-4">

                            <div class="fiscal-year-card border rounded-3 p-3 bg-white shadow-sm @(year.IsCurrent ? "border-primary" : "")">

                                <div class="d-flex justify-content-between align-items-center mb-2">

                                    <h6 class="fw-bold text-dark m-0">
                                        @year.YearName
                                    </h6>

                                    @if (year.IsCurrent)
                                    {
                                        <span class="badge bg-primary rounded-pill px-2.5 py-1">
                                            Active Fiscal Year
                                        </span>
                                    }
                                    else if (year.IsActive)
                                    {
                                        <span class="badge bg-secondary-subtle text-dark rounded-pill px-2 py-1">
                                            Open
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-light text-muted border rounded-pill px-2 py-1">
                                            Closed / Archived
                                        </span>
                                    }

                                </div>

                                <div class="small text-muted mb-2">

                                    <div>
                                        <i class="fa-solid fa-calendar-day me-2"></i>
                                        Start:
                                        <strong>
                                            @year.StartDate.ToString("MMM dd, yyyy")
                                        </strong>
                                    </div>

                                    <div>
                                        <i class="fa-solid fa-calendar-check me-2"></i>
                                        End:
                                        <strong>
                                            @year.EndDate.ToString("MMM dd, yyyy")
                                        </strong>
                                    </div>

                                </div>

                            </div>

                        </div>
                    }

                </div>

            </div>

        </div>

    </div>

    <!-- MODAL 1: ADD ACCOUNT HEAD -->
    <div class="modal fade"
         id="addAccountHeadModal"
         tabindex="-1"
         aria-labelledby="addAccountHeadModalLabel"
         aria-hidden="true">

        <div class="modal-dialog modal-dialog-centered">

            <div class="modal-content border-0 shadow">

                <form method="post"
                      asp-action="CreateAccountHead">

                    @Html.AntiForgeryToken()

                    <div class="modal-header border-bottom">

                        <h5 class="modal-title fw-bold text-dark"
                            id="addAccountHeadModalLabel">

                            <i class="fa-solid fa-plus-circle text-primary me-2"></i>
                            Add New Account Head

                        </h5>

                        <button type="button"
                                class="btn-close"
                                data-bs-dismiss="modal"
                                aria-label="Close">
                        </button>

                    </div>

                    <div class="modal-body">

                        <div class="mb-3">

                            <label class="form-label small fw-semibold text-dark">
                                Head Code
                                <span class="text-danger">*</span>
                            </label>

                            <input type="text"
                                   name="headCode"
                                   class="form-control"
                                   placeholder="e.g. AC-1006"
                                   required />

                        </div>

                        <div class="mb-3">

                            <label class="form-label small fw-semibold text-dark">
                                Head Name
                                <span class="text-danger">*</span>
                            </label>

                            <input type="text"
                                   name="headName"
                                   class="form-control"
                                   placeholder="e.g. Petty Cash Reserve"
                                   required />

                        </div>

                        <div class="mb-3">

                            <label class="form-label small fw-semibold text-dark">
                                Account Type
                                <span class="text-danger">*</span>
                            </label>

                            <select name="accountType"
                                    class="form-select"
                                    required>

                                <option value="">
                                    -- Select Type --
                                </option>

                                <option value="Asset">
                                    Asset
                                </option>

                                <option value="Liability">
                                    Liability
                                </option>

                                <option value="Equity">
                                    Equity
                                </option>

                                <option value="Revenue">
                                    Revenue
                                </option>

                                <option value="Expense">
                                    Expense
                                </option>

                            </select>

                        </div>

                        <div class="mb-3">

                            <label class="form-label small fw-semibold text-dark">
                                Description
                            </label>

                            <textarea name="description"
                                      class="form-control"
                                      rows="2"
                                      placeholder="Brief details about this account head..."></textarea>

                        </div>

                    </div>

                    <div class="modal-footer border-top">

                        <button type="button"
                                class="btn btn-outline-warm btn-sm px-3"
                                data-bs-dismiss="modal">
                            Cancel
                        </button>

                        <button type="submit"
                                class="btn btn-primary-warm btn-sm px-4">
                            Create Account Head
                        </button>

                    </div>

                </form>

            </div>

        </div>

    </div>

    <!-- MODAL 2: RECORD FINANCIAL VOUCHER -->
    <div class="modal fade"
         id="createVoucherModal"
         tabindex="-1"
         aria-labelledby="createVoucherModalLabel"
         aria-hidden="true">

        <div class="modal-dialog modal-dialog-centered">

            <div class="modal-content border-0 shadow">

                <form method="post"
                      asp-action="CreateVoucher">

                    @Html.AntiForgeryToken()

                    <div class="modal-header border-bottom">

                        <h5 class="modal-title fw-bold text-dark"
                            id="createVoucherModalLabel">

                            <i class="fa-solid fa-receipt text-primary me-2"></i>
                            Record Financial Voucher

                        </h5>

                        <button type="button"
                                class="btn-close"
                                data-bs-dismiss="modal"
                                aria-label="Close">
                        </button>

                    </div>

                    <div class="modal-body">

                        <div class="mb-3">

                            <label class="form-label small fw-semibold text-dark">
                                Voucher Type
                                <span class="text-danger">*</span>
                            </label>

                            <select name="voucherType"
                                    class="form-select"
                                    required>

                                <option value="Payment Voucher">
                                    Payment Voucher
                                </option>

                                <option value="Receipt Voucher">
                                    Receipt Voucher
                                </option>

                                <option value="Expense Entry">
                                    Expense Entry
                                </option>

                                <option value="Sales Invoice">
                                    Sales Invoice
                                </option>

                                <option value="Purchase Order">
                                    Purchase Order
                                </option>

                            </select>

                        </div>

                        <div class="mb-3">

                            <label class="form-label small fw-semibold text-dark">
                                Party / Account Name
                                <span class="text-danger">*</span>
                            </label>

                            <input type="text"
                                   name="partyName"
                                   class="form-control"
                                   placeholder="e.g. ABC Suppliers Ltd / Office Supplies"
                                   required />

                        </div>

                        <div class="mb-3">

                            <label class="form-label small fw-semibold text-dark">
                                Amount (INR)
                                <span class="text-danger">*</span>
                            </label>

                            <input type="number"
                                   step="0.01"
                                   name="amount"
                                   class="form-control"
                                   placeholder="0.00"
                                   required />

                        </div>

                        <div class="mb-3">

                            <label class="form-label small fw-semibold text-dark">
                                Status
                                <span class="text-danger">*</span>
                            </label>

                            <select name="status"
                                    class="form-select"
                                    required>

                                <option value="Paid">
                                    Paid
                                </option>

                                <option value="Pending">
                                    Pending
                                </option>

                            </select>

                        </div>

                    </div>

                    <div class="modal-footer border-top">

                        <button type="button"
                                class="btn btn-outline-warm btn-sm px-3"
                                data-bs-dismiss="modal">
                            Cancel
                        </button>

                        <button type="submit"
                                class="btn btn-primary-warm btn-sm px-4">
                            Record Voucher
                        </button>

                    </div>

                </form>

            </div>

        </div>

    </div>

</div>
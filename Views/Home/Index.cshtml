@{
    Layout = "_LandingLayout";
    ViewData["Title"] = "Enterprise Resource Planning Portal";
}

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap');

    /* =====================================================
           CLEAN ERP LANDING PAGE - OPTION 3
           White / Blue / Purple Professional Theme
        ====================================================== */

    .ops-landing {
        --primary: #2563eb;
        --primary-dark: #1d4ed8;
        --primary-light: #eff6ff;
        --purple: #7c3aed;
        --purple-light: #f5f3ff;
        --cyan: #06b6d4;
        --success: #10b981;
        --page-bg: #f8fafc;
        --card-bg: #ffffff;
        --text-main: #0f172a;
        --text-secondary: #64748b;
        --border-color: #e2e8f0;
        min-height: 100vh;
        overflow: hidden;
        background: radial-gradient(circle at 15% 5%, rgba(37, 99, 235, 0.07), transparent 30%), radial-gradient(circle at 90% 30%, rgba(124, 58, 237, 0.06), transparent 28%), var(--page-bg);
        color: var(--text-main);
        font-family: 'Inter', sans-serif;
    }

        .ops-landing h1,
        .ops-landing h2,
        .ops-landing h3,
        .ops-landing h4,
        .ops-landing h5,
        .ops-landing h6 {
            font-family: 'Plus Jakarta Sans', sans-serif;
        }

    /* =====================================================
           ANIMATIONS
        ====================================================== */

    @@keyframes pageFadeUp {
        from {
            opacity: 0;
            transform: translateY(24px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@keyframes floatSoft {
        0%, 100% {
            transform: translateY(0);
        }

        50% {
            transform: translateY(-10px);
        }
    }

    @@keyframes graphFloat {
        0%, 100% {
            transform: translateY(0);
        }

        50% {
            transform: translateY(-16px);
        }
    }

    @@keyframes graphFloatTwo {
        0%, 100% {
            transform: translateY(0);
        }

        50% {
            transform: translateY(12px);
        }
    }

    @@keyframes drawLine {
        from {
            stroke-dashoffset: 1200;
        }

        to {
            stroke-dashoffset: 0;
        }
    }

    @@keyframes movingLine {
        from {
            stroke-dashoffset: 100;
        }

        to {
            stroke-dashoffset: 0;
        }
    }

    @@keyframes pulseDot {
        0%, 100% {
            transform: scale(1);
            opacity: 1;
        }

        50% {
            transform: scale(1.25);
            opacity: 0.65;
        }
    }

    @@keyframes floatOrb {
        0%, 100% {
            transform: translate(0, 0);
        }

        50% {
            transform: translate(18px, -22px);
        }
    }

    @@keyframes buttonShine {
        from {
            transform: translateX(-140%);
        }

        to {
            transform: translateX(180%);
        }
    }

    @@keyframes softGlow {
        0%, 100% {
            opacity: 0.45;
            transform: scale(1);
        }

        50% {
            opacity: 0.8;
            transform: scale(1.08);
        }
    }

    @@keyframes cardRise {
        from {
            opacity: 0;
            transform: translateY(22px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .ops-landing .reveal {
        opacity: 0;
        animation: pageFadeUp 0.65s ease forwards;
    }

    .ops-landing .reveal-1 {
        animation-delay: 0.05s;
    }

    .ops-landing .reveal-2 {
        animation-delay: 0.12s;
    }

    .ops-landing .reveal-3 {
        animation-delay: 0.20s;
    }

    .ops-landing .reveal-4 {
        animation-delay: 0.28s;
    }

    .ops-landing .reveal-5 {
        animation-delay: 0.36s;
    }

    /* =====================================================
           HERO
        ====================================================== */

    .ops-landing .hero-section {
        position: relative;
        min-height: 680px;
        padding: 6rem 0 5rem;
        overflow: hidden;
    }

    .ops-landing .hero-bg-video {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        z-index: 0;
        pointer-events: none;
    }

    .ops-landing .hero-bg-overlay {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(255, 255, 255, 0.4);
        z-index: 1;
        pointer-events: none;
    }

    .ops-landing .hero-grid {
        position: absolute;
        inset: 0;
        background-image: linear-gradient( rgba(37, 99, 235, 0.045) 1px, transparent 1px ), linear-gradient( 90deg, rgba(37, 99, 235, 0.045) 1px, transparent 1px );
        background-size: 48px 48px;
        mask-image: radial-gradient( ellipse at center, black 20%, transparent 75% );
        -webkit-mask-image: radial-gradient( ellipse at center, black 20%, transparent 75% );
        pointer-events: none;
    }

    .ops-landing .hero-orb-one,
    .ops-landing .hero-orb-two {
        position: absolute;
        border-radius: 50%;
        filter: blur(2px);
        pointer-events: none;
    }

    .ops-landing .hero-orb-one {
        width: 420px;
        height: 420px;
        top: -160px;
        left: -140px;
        background: radial-gradient( circle, rgba(37, 99, 235, 0.13), transparent 70% );
        animation: floatOrb 13s ease-in-out infinite;
    }

    .ops-landing .hero-orb-two {
        width: 400px;
        height: 400px;
        right: -150px;
        top: 120px;
        background: radial-gradient( circle, rgba(124, 58, 237, 0.10), transparent 70% );
        animation: floatOrb 16s ease-in-out infinite reverse;
    }

    .ops-landing .hero-section > .container {
        position: relative;
        z-index: 2;
    }

    .ops-landing .badge-console {
        display: inline-flex;
        align-items: center;
        color: var(--primary) !important;
        background: rgba(37, 99, 235, 0.07) !important;
        border: 1px solid rgba(37, 99, 235, 0.16) !important;
        border-radius: 999px;
        font-size: 0.78rem;
        font-weight: 700;
        letter-spacing: 0.03em;
        transition: transform 0.25s ease, box-shadow 0.25s ease;
    }

        .ops-landing .badge-console:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(37, 99, 235, 0.10);
        }

    .ops-landing .hero-title {
        color: var(--text-main);
        letter-spacing: -0.055em;
        line-height: 1.08;
    }

    .ops-landing .hero-gradient-text {
        background: linear-gradient( 135deg, var(--primary), var(--purple) );
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
    }

    .ops-landing .hero-subtitle {
        max-width: 650px;
        color: var(--text-secondary);
    }

    /* =====================================================
           PRIMARY BUTTON
        ====================================================== */

    .ops-landing .btn-console-cta {
        position: relative;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        min-height: 56px;
        color: white;
        text-decoration: none;
        background: linear-gradient( 135deg, var(--primary), var(--primary-dark) );
        border: 0;
        border-radius: 12px;
        box-shadow: 0 14px 30px rgba(37, 99, 235, 0.20);
        transition: transform 0.22s ease, box-shadow 0.22s ease, filter 0.22s ease;
    }

        .ops-landing .btn-console-cta:hover {
            color: white;
            transform: translateY(-3px);
            filter: brightness(1.04);
            box-shadow: 0 20px 38px rgba(37, 99, 235, 0.28);
        }

        .ops-landing .btn-console-cta:active {
            transform: translateY(0) scale(0.98);
        }

        .ops-landing .btn-console-cta::after {
            content: "";
            position: absolute;
            top: 0;
            bottom: 0;
            width: 45%;
            background: linear-gradient( 90deg, transparent, rgba(255, 255, 255, 0.35), transparent );
            transform: translateX(-150%);
        }

        .ops-landing .btn-console-cta:hover::after {
            animation: buttonShine 0.85s ease;
        }

    /* =====================================================
           HERO STATS
        ====================================================== */

    .ops-landing .hero-stats {
        border-top: 1px solid var(--border-color);
    }

    .ops-landing .stat-number {
        color: var(--text-main);
        font-weight: 800;
        letter-spacing: -0.04em;
    }

    .ops-landing .stat-text {
        color: var(--text-secondary);
    }

    .ops-landing .stat-live-dot {
        width: 7px;
        height: 7px;
        display: inline-block;
        margin-right: 7px;
        background: var(--success);
        border-radius: 50%;
        box-shadow: 0 0 0 5px rgba(16, 185, 129, 0.09);
        animation: pulseDot 2s ease-in-out infinite;
    }

    /* =====================================================
           ANIMATED GRAPH PANEL
        ====================================================== */

    .ops-landing .graph-panel {
        position: relative;
        min-height: 490px;
        padding: 1.35rem;
        overflow: hidden;
        background: linear-gradient( 145deg, rgba(255, 255, 255, 0.98), rgba(248, 250, 252, 0.96) );
        border: 1px solid rgba(148, 163, 184, 0.22);
        border-radius: 26px;
        box-shadow: 0 28px 65px rgba(15, 23, 42, 0.10);
        animation: graphFloat 7s ease-in-out infinite;
        transition: transform 0.4s ease, box-shadow 0.4s ease;
    }

        .ops-landing .graph-panel:hover {
            transform: translateY(-8px);
            box-shadow: 0 36px 80px rgba(37, 99, 235, 0.15);
        }

        .ops-landing .graph-panel::before {
            content: "";
            position: absolute;
            width: 250px;
            height: 250px;
            top: -100px;
            right: -100px;
            background: radial-gradient( circle, rgba(37, 99, 235, 0.13), transparent 70% );
            pointer-events: none;
            animation: softGlow 7s ease-in-out infinite;
        }

    .ops-landing .graph-panel-header {
        position: relative;
        z-index: 3;
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding-bottom: 1rem;
        border-bottom: 1px solid var(--border-color);
    }

    .ops-landing .graph-dots {
        display: flex;
        gap: 6px;
    }

        .ops-landing .graph-dots span {
            width: 9px;
            height: 9px;
            border-radius: 50%;
        }

            .ops-landing .graph-dots span:nth-child(1) {
                background: #fb7185;
            }

            .ops-landing .graph-dots span:nth-child(2) {
                background: #fbbf24;
            }

            .ops-landing .graph-dots span:nth-child(3) {
                background: #34d399;
            }

    .ops-landing .live-system {
        color: var(--success);
        background: rgba(16, 185, 129, 0.09);
        border: 1px solid rgba(16, 185, 129, 0.15);
        border-radius: 999px;
        font-size: 0.68rem;
        font-weight: 700;
        letter-spacing: 0.04em;
    }

    .ops-landing .chart-title {
        color: var(--text-main);
        font-weight: 700;
    }

    .ops-landing .chart-subtitle {
        color: var(--text-secondary);
        font-size: 0.76rem;
    }

    .ops-landing .animated-chart-wrap {
        position: relative;
        height: 270px;
        margin-top: 1rem;
        overflow: hidden;
        border-radius: 18px;
        background: linear-gradient( 180deg, #ffffff, #f8fbff );
        border: 1px solid rgba(226, 232, 240, 0.9);
    }

    /* Grid lines */

    .ops-landing .chart-grid {
        position: absolute;
        inset: 0;
        background-image: linear-gradient( rgba(37, 99, 235, 0.08) 1px, transparent 1px ), linear-gradient( 90deg, rgba(37, 99, 235, 0.06) 1px, transparent 1px );
        background-size: 100% 54px, 80px 100%;
    }

    /* Main graph moving group */

    .ops-landing .mountain-main {
        animation: graphFloat 5.5s ease-in-out infinite;
    }

    .ops-landing .mountain-secondary {
        animation: graphFloatTwo 6.5s ease-in-out infinite;
    }

    .ops-landing .mountain-path-main {
        fill: none;
        stroke: var(--primary);
        stroke-width: 4;
        stroke-linecap: round;
        stroke-linejoin: round;
        stroke-dasharray: 1000;
        animation: drawLine 2.5s ease forwards;
    }

    .ops-landing .mountain-path-secondary {
        fill: none;
        stroke: var(--purple);
        stroke-width: 2.5;
        stroke-linecap: round;
        stroke-linejoin: round;
        stroke-dasharray: 12 10;
        animation: movingLine 3s linear infinite;
    }

    .ops-landing .graph-area-main {
        fill: url(#mainGraphGradient);
    }

    .ops-landing .graph-point {
        fill: white;
        stroke: var(--primary);
        stroke-width: 4;
        animation: pulseDot 2.2s ease-in-out infinite;
    }

    .ops-landing .graph-point-small {
        fill: var(--purple);
        animation: pulseDot 2.8s ease-in-out infinite;
    }

    /* Moving floating graph labels */

    .ops-landing .floating-graph-label {
        position: absolute;
        display: flex;
        align-items: center;
        gap: 7px;
        padding: 8px 12px;
        color: var(--text-main);
        background: rgba(255, 255, 255, 0.94);
        border: 1px solid rgba(226, 232, 240, 0.9);
        border-radius: 10px;
        box-shadow: 0 12px 25px rgba(15, 23, 42, 0.08);
        font-size: 0.72rem;
        font-weight: 700;
        backdrop-filter: blur(10px);
        z-index: 5;
    }

    .ops-landing .label-one {
        top: 32px;
        right: 30px;
        animation: floatSoft 4.5s ease-in-out infinite;
    }

    .ops-landing .label-two {
        left: 30px;
        bottom: 24px;
        animation: graphFloatTwo 5s ease-in-out infinite;
    }

    .ops-landing .label-dot {
        width: 8px;
        height: 8px;
        background: var(--success);
        border-radius: 50%;
        animation: pulseDot 1.8s ease-in-out infinite;
    }

    /* =====================================================
           GRAPH METRICS
        ====================================================== */

    .ops-landing .graph-metrics {
        position: relative;
        z-index: 2;
        margin-top: 1rem;
    }

    .ops-landing .mini-metric {
        padding: 0.85rem;
        background: #ffffff;
        border: 1px solid var(--border-color);
        border-radius: 14px;
        transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
    }

        .ops-landing .mini-metric:hover {
            transform: translateY(-4px);
            border-color: rgba(37, 99, 235, 0.25);
            box-shadow: 0 14px 28px rgba(15, 23, 42, 0.07);
        }

    .ops-landing .mini-metric-label {
        color: var(--text-secondary);
        font-size: 0.68rem;
        font-weight: 700;
        letter-spacing: 0.04em;
    }

    .ops-landing .mini-metric-value {
        margin-top: 3px;
        color: var(--text-main);
        font-family: 'Plus Jakarta Sans', sans-serif;
        font-size: 1.05rem;
        font-weight: 800;
    }

    /* =====================================================
           SECTIONS
        ====================================================== */

    .ops-landing .section-light {
        position: relative;
        background: #ffffff;
        border-top: 1px solid var(--border-color);
    }

    .ops-landing .section-soft {
        background: linear-gradient( 180deg, #f8fafc, #ffffff );
        border-top: 1px solid var(--border-color);
        border-bottom: 1px solid var(--border-color);
    }

    .ops-landing .section-heading {
        color: var(--text-main);
        font-weight: 800;
        letter-spacing: -0.035em;
    }

    .ops-landing .section-description {
        color: var(--text-secondary);
    }

    .ops-landing .section-icon {
        color: var(--primary);
    }

    /* =====================================================
           FEATURE CARDS
        ====================================================== */

    .ops-landing .glass-card {
        position: relative;
        height: 100%;
        padding: 1.7rem;
        overflow: hidden;
        background: var(--card-bg);
        border: 1px solid var(--border-color);
        border-radius: 20px;
        box-shadow: 0 10px 30px rgba(15, 23, 42, 0.035);
        transition: transform 0.3s ease, box-shadow 0.3s ease, border-color 0.3s ease;
    }

        .ops-landing .glass-card::before {
            content: "";
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 3px;
            background: linear-gradient( 90deg, var(--primary), var(--purple) );
            transform: scaleX(0);
            transform-origin: left;
            transition: transform 0.35s ease;
        }

        .ops-landing .glass-card:hover {
            transform: translateY(-8px);
            border-color: rgba(37, 99, 235, 0.22);
            box-shadow: 0 25px 50px rgba(15, 23, 42, 0.09);
        }

            .ops-landing .glass-card:hover::before {
                transform: scaleX(1);
            }

    .ops-landing .module-icon-wrap {
        width: 52px;
        height: 52px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 1.2rem;
        border-radius: 16px;
        font-size: 1.2rem;
        transition: transform 0.35s cubic-bezier( 0.34, 1.56, 0.64, 1 );
    }

    .ops-landing .glass-card:hover .module-icon-wrap {
        transform: rotate(-8deg) scale(1.1);
    }

    .ops-landing .icon-blue {
        color: var(--primary);
        background: rgba(37, 99, 235, 0.10);
    }

    .ops-landing .icon-purple {
        color: var(--purple);
        background: rgba(124, 58, 237, 0.10);
    }

    .ops-landing .feature-title {
        color: var(--text-main);
        font-weight: 700;
    }

    .ops-landing .feature-text,
    .ops-landing .feature-list {
        color: var(--text-secondary);
    }

        .ops-landing .feature-list li {
            transition: transform 0.2s ease, color 0.2s ease;
        }

            .ops-landing .feature-list li:hover {
                color: var(--text-main);
                transform: translateX(3px);
            }

    /* =====================================================
           ROLE TABLE
        ====================================================== */

    .ops-landing .role-table-wrap {
        overflow: hidden;
        background: #ffffff;
        border: 1px solid var(--border-color);
        border-radius: 20px;
        box-shadow: 0 14px 35px rgba(15, 23, 42, 0.04);
    }

    .ops-landing .role-table {
        margin-bottom: 0;
    }

        .ops-landing .role-table thead {
            background: #f8fafc;
        }

        .ops-landing .role-table th {
            padding: 1rem 1.4rem;
            color: #475569;
            font-size: 0.72rem;
            font-weight: 800;
            letter-spacing: 0.05em;
            text-transform: uppercase;
        }

        .ops-landing .role-table td {
            padding: 1.15rem 1.4rem;
            color: var(--text-secondary);
            vertical-align: middle;
            border-color: #eef2f7;
        }

        .ops-landing .role-table tbody tr {
            transition: background 0.2s ease, transform 0.2s ease;
        }

            .ops-landing .role-table tbody tr:hover {
                background: #f8fbff;
                transform: translateX(3px);
            }

    .ops-landing .role-name {
        color: var(--text-main);
        font-weight: 700;
    }

    .ops-landing .security-level {
        color: var(--text-main);
        font-weight: 700;
    }

    .ops-landing .badge-scope-full,
    .ops-landing .badge-scope-partial,
    .ops-landing .badge-scope-readonly {
        padding: 0.45rem 0.75rem;
        border-radius: 999px;
        font-weight: 600;
    }

    .ops-landing .badge-scope-full {
        color: #059669;
        background: rgba(16, 185, 129, 0.10);
    }

    .ops-landing .badge-scope-partial {
        color: var(--primary);
        background: rgba(37, 99, 235, 0.09);
    }

    .ops-landing .badge-scope-readonly {
        color: #7c3aed;
        background: rgba(124, 58, 237, 0.09);
    }

    /* =====================================================
           ARCHITECTURE
        ====================================================== */

    .ops-landing .architecture-card {
        height: 100%;
        padding: 1.7rem;
        background: white;
        border: 1px solid var(--border-color);
        border-radius: 18px;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

        .ops-landing .architecture-card:hover {
            transform: translateY(-6px);
            box-shadow: 0 22px 42px rgba(15, 23, 42, 0.08);
        }

    /* =====================================================
           REDUCED MOTION
        ====================================================== */

    @@media (prefers-reduced-motion: reduce) {

        *,
        *::before,
        *::after {
            animation-duration: 0.01ms !important;
            animation-iteration-count: 1 !important;
            transition-duration: 0.01ms !important;
            scroll-behavior: auto !important;
        }
    }

    /* =====================================================
           RESPONSIVE
        ====================================================== */

    @@media (max-width: 991.98px) {

        .ops-landing .hero-section {
            min-height: auto;
            padding-top: 4rem;
        }

        .ops-landing .hero-title {
            font-size: 3.1rem !important;
        }

        .ops-landing .graph-panel {
            margin-top: 1rem;
        }
    }

    @@media (max-width: 575.98px) {

        .ops-landing .hero-section {
            padding: 3rem 0 3.5rem;
        }

        .ops-landing .hero-title {
            font-size: 2.45rem !important;
        }

        .ops-landing .hero-subtitle {
            font-size: 0.98rem !important;
        }

        .ops-landing .graph-panel {
            padding: 0.9rem;
            border-radius: 20px;
        }

        .ops-landing .animated-chart-wrap {
            height: 230px;
        }

        .ops-landing .role-table th,
        .ops-landing .role-table td {
            padding: 0.9rem;
        }
    }

    /* Staggered page load fade-up for Hero */
    .hero-reveal {
        opacity: 0;
        transform: translateY(20px);
        transition: opacity 0.65s cubic-bezier(0.16, 1, 0.3, 1), transform 0.65s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .hero-reveal.active {
        opacity: 1;
        transform: translateY(0);
    }
    
    /* Scroll reveal animation for other sections */
    .scroll-reveal {
        opacity: 0;
        transform: translateY(30px);
        transition: opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1), transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .scroll-reveal.active {
        opacity: 1;
        transform: translateY(0);
    }

    /* Button hover styles */
    .ops-landing .btn-console-cta, .ops-landing .btn-glass-secondary {
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }
    .ops-landing .btn-console-cta:hover, .ops-landing .btn-glass-secondary:hover {
        transform: scale(1.03) translateY(-2px);
    }
    
    /* Industry logos carousel/track styles */
    .logos-track {
        display: flex;
        justify-content: space-around;
        align-items: center;
        flex-wrap: wrap;
        gap: 2rem;
        opacity: 0.65;
    }
    .logo-item {
        font-size: 1.5rem;
        font-weight: 700;
        color: #64748b;

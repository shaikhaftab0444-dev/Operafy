@{
    Layout = "_LandingLayout";
    ViewData["Title"] = "Enterprise Resource Planning Portal";
}

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600;700&display=swap');

    .ops-landing {
        --ink: #0d1424;
        --ink-soft: #16203a;
        --ink-line: rgba(238, 241, 246, 0.08);
        --text-onink: #eef1f6;
        --sub-onink: #8f9ebb;
        --amber: #f5a623;
        --teal: #2dd4bf;
        font-family: 'Inter', sans-serif;
    }

        .ops-landing h1,
        .ops-landing h2,
        .ops-landing h4,
        .ops-landing h5,
        .ops-landing h6 {
            font-family: 'Space Grotesk', sans-serif;
        }

    @@keyframes ops-rise-in {
        from {
            opacity: 0;
            transform: translateY(16px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@keyframes ops-pulse-dot {
        0% {
            box-shadow: 0 0 0 0 rgba(45, 212, 191, 0.55);
        }

        70% {
            box-shadow: 0 0 0 8px rgba(45, 212, 191, 0);
        }

        100% {
            box-shadow: 0 0 0 0 rgba(45, 212, 191, 0);
        }
    }

    @@keyframes ops-blink {
        0%, 100% {
            opacity: 1;
        }

        50% {
            opacity: 0;
        }
    }

    @@keyframes ops-glow-drift {
        0%, 100% {
            transform: translate(0, 0) scale(1);
        }

        50% {
            transform: translate(35px, 25px) scale(1.08);
        }
    }

    .ops-landing .reveal {
        opacity: 0;
        animation: ops-rise-in 0.65s ease forwards;
    }

    .ops-landing .reveal-1 {
        animation-delay: 0.05s;
    }

    .ops-landing .reveal-2 {
        animation-delay: 0.15s;
    }

    .ops-landing .reveal-3 {
        animation-delay: 0.25s;
    }

    .ops-landing .reveal-4 {
        animation-delay: 0.35s;
    }

    .ops-landing .reveal-5 {
        animation-delay: 0.45s;
    }

    /* ---- Hero ---- */
    .ops-landing .hero-section {
        position: relative;
        overflow: hidden;
        padding: 5rem 0;
    }

    .ops-landing .hero-grid {
        position: absolute;
        inset: 0;
        background-image: linear-gradient(var(--ink-line) 1px, transparent 1px), linear-gradient(90deg, var(--ink-line) 1px, transparent 1px);
        background-size: 42px 42px;
        mask-image: radial-gradient(circle at 20% 25%, black 0%, transparent 70%);
        -webkit-mask-image: radial-gradient(circle at 20% 25%, black 0%, transparent 70%);
        pointer-events: none;
        z-index: 0;
    }

    .ops-landing .hero-glow {
        position: absolute;
        width: 520px;
        height: 520px;
        border-radius: 50%;
        background: radial-gradient(circle, rgba(45, 212, 191, 0.14) 0%, rgba(13,20,36,0) 70%);
        top: -160px;
        left: -120px;
        animation: ops-glow-drift 15s ease-in-out infinite;
        pointer-events: none;
        z-index: 0;
    }

    .ops-landing .hero-section > .container {
        position: relative;
        z-index: 1;
    }

    .ops-landing .badge-console {
        background: rgba(45, 212, 191, 0.12) !important;
        color: var(--teal) !important;
        border: 1px solid rgba(45, 212, 191, 0.3) !important;
        font-weight: 600;
        letter-spacing: 0.02em;
    }

    .ops-landing .hero-gradient-text {
        background: linear-gradient(120deg, var(--teal) 0%, var(--amber) 100%);
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
    }

    .ops-landing .btn-console-cta {
        display: inline-flex;
        align-items: center;
        background: linear-gradient(135deg, var(--amber) 0%, #ffc25c 100%);
        color: #17130a;
        border: none;
        border-radius: 8px;
        font-weight: 700;
        position: relative;
        overflow: hidden;
        text-decoration: none;
        transition: transform 0.2s ease, box-shadow 0.25s ease;
        box-shadow: 0 10px 26px rgba(245, 166, 35, 0.22);
    }

        .ops-landing .btn-console-cta::after {
            content: "";
            position: absolute;
            inset: 0;
            background: linear-gradient(120deg, rgba(255,255,255,0) 30%, rgba(255,255,255,0.45) 50%, rgba(255,255,255,0) 70%);
            transform: translateX(-120%);
            transition: transform 0.7s ease;
        }

        .ops-landing .btn-console-cta:hover {
            transform: translateY(-2px);
            box-shadow: 0 14px 32px rgba(245, 166, 35, 0.3);
            color: #17130a;
        }

            .ops-landing .btn-console-cta:hover::after {
                transform: translateX(120%);
            }

    .ops-landing .stat-live-dot {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: var(--teal);
        display: inline-block;
        margin-right: 6px;
        animation: ops-pulse-dot 2.2s ease-out infinite;
    }

    /* ---- Dashboard mockup ---- */
    .ops-landing .sim-dashboard {
        border: 1px solid var(--ink-line);
        border-radius: 16px;
        padding: 1.5rem;
        backdrop-filter: blur(6px);
        transition: transform 0.4s ease, box-shadow 0.4s ease;
    }

        .ops-landing .sim-dashboard:hover {
            transform: translateY(-4px);
            box-shadow: 0 24px 48px rgba(0,0,0,0.28);
        }

    .ops-landing .sim-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 1.25rem;
    }

    .ops-landing .dot {
        width: 9px;
        height: 9px;
        border-radius: 50%;
        display: inline-block;
    }

    .ops-landing .dot-red {
        background: #ef4444;
    }

    .ops-landing .dot-yellow {
        background: #f5c542;
    }

    .ops-landing .dot-green {
        background: var(--teal);
    }

    .ops-landing .sim-stat-card {
        border: 1px solid var(--ink-line);
        border-radius: 10px;
        padding: 0.85rem 1rem;
        background: rgba(255,255,255,0.02);
        transition: border-color 0.25s ease, transform 0.25s ease;
    }

        .ops-landing .sim-stat-card:hover {
            transform: translateY(-2px);
            border-color: rgba(45, 212, 191, 0.4);
        }

    .ops-landing .sim-stat-label {
        font-size: 0.68rem;
        font-weight: 700;
        letter-spacing: 0.04em;
        color: var(--sub-onink);
        margin-bottom: 4px;
    }

    .ops-landing .sim-stat-val {
        font-family: 'Space Grotesk', sans-serif;
        font-size: 1.15rem;
        font-weight: 600;
    }

    .ops-landing .sim-stat-trend {
        font-size: 0.75rem;
        font-weight: 600;
    }

    .ops-landing .terminal-block {
        border: 1px solid var(--ink-line) !important;
        background: rgba(255,255,255,0.015) !important;
    }

        .ops-landing .terminal-block .tag-ok {
            color: var(--teal) !important;
        }

    .ops-landing .terminal-cursor {
        display: inline-block;
        width: 6px;
        height: 12px;
        background: var(--teal);
        margin-left: 4px;
        vertical-align: middle;
        animation: ops-blink 1s step-end infinite;
    }

    /* ---- Pillars ---- */
    .ops-landing .glass-card {
        border: 1px solid var(--ink-line);
        border-radius: 14px;
        transition: transform 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
    }

        .ops-landing .glass-card:hover {
            transform: translateY(-4px);
            border-color: rgba(45, 212, 191, 0.35);
            box-shadow: 0 20px 40px rgba(0,0,0,0.22);
        }

    .ops-landing .module-icon-wrap {
        width: 44px;
        height: 44px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.1rem;
        margin-bottom: 1rem;
        transition: transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
    }

    .ops-landing .glass-card:hover .module-icon-wrap {
        transform: rotate(-8deg) scale(1.08);
    }

    .ops-landing .icon-teal {
        background: rgba(45, 212, 191, 0.14);
        color: var(--teal);
    }

    .ops-landing .icon-amber {
        background: rgba(245, 166, 35, 0.14);
        color: var(--amber);
    }

    /* ---- Role matrix table ---- */
    .ops-landing .role-table-wrap {
        border: 1px solid var(--ink-line);
        border-radius: 14px;
    }

        .ops-landing .role-table-wrap table thead {
            background: rgba(255,255,255,0.02);
        }

        .ops-landing .role-table-wrap table tbody tr {
            border-bottom: 1px solid var(--ink-line);
            transition: background 0.2s ease;
        }

            .ops-landing .role-table-wrap table tbody tr:hover {
                background: rgba(45, 212, 191, 0.04);
            }

    .ops-landing .badge-scope-full {
        background: rgba(45, 212, 191, 0.12);
        color: var(--teal);
    }

    .ops-landing .badge-scope-partial {
        background: rgba(255,255,255,0.06);
        color: var(--text-onink);
    }

    .ops-landing .badge-scope-readonly {
        background: rgba(245, 166, 35, 0.12);
        color: var(--amber);
    }

    /* ---- Architecture cards ---- */
    .ops-landing .arch-icon {
        color: var(--teal);
    }
</style>

<div class="ops-landing">

    <!-- Hero Section -->
    <section class="hero-section text-center text-lg-start">
        <div class="hero-grid"></div>
        <div class="hero-glow"></div>
        <div class="container">
            <div class="row align-items-center g-5">
                <div class="col-lg-6">
                    <span class="badge badge-console px-3 py-2 mb-3 reveal reveal-1">
                        <i class="fa-solid fa-shield-halved me-2"></i>Enterprise Security Certified
                    </span>
                    <h1 class="hero-title mb-3 reveal reveal-2" style="font-size: 3rem; font-weight: 600;">
                        Enterprise Operations, <span class="hero-gradient-text">Unified.</span>
                    </h1>
                    <p class="hero-subtitle reveal reveal-3" style="font-size: 1.05rem; line-height: 1.7;">
                        A comprehensive, modular ERP software designed to consolidate financial accounts, manage global supply chains, track warehouse inventories, and streamline employee human resources under one secure, relational SQL Server backend.
                    </p>
                    <div class="d-flex justify-content-center justify-content-lg-start reveal reveal-4">
                        <a href="/Account/Login" class="btn btn-console-cta px-5 py-3" style="font-size: 1.05rem;">
                            <i class="fa-solid fa-lock-open me-2"></i>Access Administrative Portal
                        </a>
                    </div>

                    <!-- Quick stats -->
                    <div class="row mt-5 pt-4 border-top reveal reveal-5" style="border-color: rgba(255,255,255,0.08) !important;">
                        <div class="col-4">
                            <h4 class="fw-bold mb-0 text-white">12</h4>
                            <small class="text-secondary"><span class="stat-live-dot"></span>Granular Roles</small>
                        </div>
                        <div class="col-4">
                            <h4 class="fw-bold mb-0 text-white">14</h4>
                            <small class="text-secondary"><span class="stat-live-dot"></span>Enterprise Modules</small>
                        </div>
                        <div class="col-4">
                            <h4 class="fw-bold mb-0 text-white">SQL Server</h4>
                            <small class="text-secondary"><span class="stat-live-dot"></span>Relational DB</small>
                        </div>
                    </div>
                </div>

                <div class="col-lg-6 reveal reveal-3">
                    <!-- Static CSS-based Premium Dashboard Graphics Mockup -->
                    <!-- TODO: swap for a real product screenshot once assets are ready -->
                    <div class="sim-dashboard" style="background: rgba(17, 24, 39, 0.55);">
                        <div class="sim-header">
                            <div class="d-flex gap-1.5 align-items-center">
                                <span class="dot dot-red"></span>
                                <span class="dot dot-yellow mx-1"></span>
                                <span class="dot dot-green"></span>
                                <span class="text-secondary small ms-2" style="font-size: 0.75rem;">System Interface Preview</span>
                            </div>
                            <span class="badge badge-console small py-1">
                                <i class="fa-solid fa-server me-1"></i>PRODUCTION
                            </span>
                        </div>

                        <!-- Replicating the metric layouts in a premium static mockup -->
                        <div class="row g-3 mb-3">
                            <div class="col-6">
                                <div class="sim-stat-card">
                                    <div class="sim-stat-label"><i class="fa-solid fa-chart-line me-1" style="color: var(--teal);"></i>TOTAL SALES</div>
                                    <div class="sim-stat-val text-white">₹12,45,000</div>
                                    <div class="sim-stat-trend text-success"><i class="fa-solid fa-arrow-up me-1"></i>+12.5%</div>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="sim-stat-card">
                                    <div class="sim-stat-label"><i class="fa-solid fa-cart-shopping me-1" style="color: var(--amber);"></i>TOTAL PURCHASE</div>
                                    <div class="sim-stat-val text-white">₹8,75,000</div>
                                    <div class="sim-stat-trend text-success"><i class="fa-solid fa-arrow-up me-1"></i>+8.3%</div>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="sim-stat-card">
                                    <div class="sim-stat-label"><i class="fa-solid fa-users me-1" style="color: var(--teal);"></i>TOTAL CUSTOMERS</div>
                                    <div class="sim-stat-val text-white">1,245</div>
                                    <div class="sim-stat-trend text-success"><i class="fa-solid fa-arrow-up me-1"></i>+15.2%</div>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="sim-stat-card">
                                    <div class="sim-stat-label"><i class="fa-solid fa-database me-1" style="color: var(--amber);"></i>STOCK VALUE</div>
                                    <div class="sim-stat-val text-white">₹18,65,000</div>
                                    <div class="sim-stat-trend text-danger"><i class="fa-solid fa-arrow-down me-1"></i>-2.4%</div>
                                </div>
                            </div>
                        </div>

                        <div class="terminal-block p-3 text-start" style="border-radius: 12px;">
                            <div class="d-flex align-items-center justify-content-between mb-2">
                                <h6 class="small fw-bold text-white mb-0"><i class="fa-solid fa-network-wired me-2 text-secondary"></i>Database Seed Integrity</h6>
                                <span class="badge badge-console small" style="font-size:0.7rem;">Active</span>
                            </div>
                            <div style="font-family: monospace; font-size:0.75rem;" class="text-secondary">
                                <div class="mb-1"><span class="tag-ok">[SUCCESS]</span> Seeded 12 system roles into [dbo].[Roles]</div>
                                <div class="mb-1"><span class="tag-ok">[SUCCESS]</span> Generated relational index IX_Users_role_id</div>
                                <div><span class="tag-ok">[SUCCESS]</span> Connected local SQLEXPRESS Express instance<span class="terminal-cursor"></span></div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Business Pillars Section -->
    <section id="features" class="py-5" style="border-top: 1px solid var(--ink-line);">
        <div class="container py-4">
            <div class="text-center mb-5">
                <h2 class="fw-bold text-white"><i class="fa-solid fa-layer-group me-3" style="color: var(--teal);"></i>Enterprise Product Pillars</h2>
                <p class="text-secondary col-lg-6 mx-auto">Discover the four core operational segments designed to handle commercial logistics, HR records, financial books, and security parameters.</p>
            </div>

            <div class="row g-4">
                <!-- Finance -->
                <div class="col-lg-3 col-sm-6">
                    <div class="glass-card h-100 p-4">
                        <div class="module-icon-wrap icon-teal"><i class="fa-solid fa-coins"></i></div>
                        <h5 class="text-white fw-bold">Financial Consolidation</h5>
                        <p class="text-secondary small mb-3">Implements double-entry ledger bookkeeping, tracks administrative expense entries, and matches purchase receipts automatically.</p>
                        <ul class="list-unstyled text-secondary small mb-0 d-flex flex-column gap-1">
                            <li><i class="fa-solid fa-circle-check me-2" style="color: var(--teal);"></i>General Ledger accounts</li>
                            <li><i class="fa-solid fa-circle-check me-2" style="color: var(--teal);"></i>Expense recording ledgers</li>
                            <li><i class="fa-solid fa-circle-check me-2" style="color: var(--teal);"></i>Automated audits</li>
                        </ul>
                    </div>
                </div>
                <!-- Supply Chain -->
                <div class="col-lg-3 col-sm-6">
                    <div class="glass-card h-100 p-4">
                        <div class="module-icon-wrap icon-amber"><i class="fa-solid fa-boxes-stacked"></i></div>
                        <h5 class="text-white fw-bold">Logistics &amp; Supply Chain</h5>
                        <p class="text-secondary small mb-3">Audits stock count levels across warehouses, handles product catalog SKUs, and drafts supplier procurement purchase orders.</p>
                        <ul class="list-unstyled text-secondary small mb-0 d-flex flex-column gap-1">
                            <li><i class="fa-solid fa-circle-check me-2" style="color: var(--amber);"></i>Warehouse Stock Counts</li>
                            <li><i class="fa-solid fa-circle-check me-2" style="color: var(--amber);"></i>Vendor Supplier registry</li>
                            <li><i class="fa-solid fa-circle-check me-2" style="color: var(--amber);"></i>Low stock threshold warnings</li>
                        </ul>
                    </div>
                </div>
                <!-- HR Operations -->
                <div class="col-lg-3 col-sm-6">
                    <div class="glass-card h-100 p-4">
                        <div class="module-icon-wrap icon-teal"><i class="fa-solid fa-user-tie"></i></div>
                        <h5 class="text-white fw-bold">Human Resources</h5>
                        <p class="text-secondary small mb-3">Maintains central employee data logs, tracks payroll structures, structures departments, and handles employee profile updates.</p>
                        <ul class="list-unstyled text-secondary small mb-0 d-flex flex-column gap-1">
                            <li><i class="fa-solid fa-circle-check me-2" style="color: var(--teal);"></i>Central employee registry</li>
                            <li><i class="fa-solid fa-circle-check me-2" style="color: var(--teal);"></i>Dynamic payroll setup</li>
                            <li><i class="fa-solid fa-circle-check me-2" style="color: var(--teal);"></i>Role authorization setups</li>
                        </ul>
                    </div>
                </div>
                <!-- Sales & CRM -->
                <div class="col-lg-3 col-sm-6">
                    <div class="glass-card h-100 p-4">
                        <div class="module-icon-wrap icon-amber"><i class="fa-solid fa-handshake"></i></div>
                        <h5 class="text-white fw-bold">Sales &amp; Client Relations</h5>
                        <p class="text-secondary small mb-3">Generates professional retail sales invoices, keeps track of customer account credit limits, and compiles revenue statistics.</p>
                        <ul class="list-unstyled text-secondary small mb-0 d-flex flex-column gap-1">
                            <li><i class="fa-solid fa-circle-check me-2" style="color: var(--amber);"></i>Automated sales billing</li>
                            <li><i class="fa-solid fa-circle-check me-2" style="color: var(--amber);"></i>Client database profiles</li>
                            <li><i class="fa-solid fa-circle-check me-2" style="color: var(--amber);"></i>Top-selling product tracking</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Role Compliance Grid Section -->
    <section id="roles" class="py-5" style="background: rgba(17, 24, 39, 0.3); border-top: 1px solid var(--ink-line); border-bottom: 1px solid var(--ink-line);">
        <div class="container py-4">
            <div class="text-center mb-5">
                <h2 class="fw-bold text-white"><i class="fa-solid fa-shield-halved me-3" style="color: var(--amber);"></i>Role-Based Security Matrix</h2>
                <p class="text-secondary col-lg-6 mx-auto">The platform contains 12 built-in, granular roles linked directly to SQL Server database mapping, ensuring strict segregation of duties.</p>
            </div>

            <div class="table-responsive role-table-wrap p-0 overflow-hidden" style="background: rgba(17, 24, 39, 0.6);">
                <table class="table table-hover mb-0 text-start" style="color: var(--sub-onink);">
                    <thead>
                        <tr>
                            <th class="border-0 px-4 py-3" style="color: white; font-weight:700;">Role Designation</th>
                            <th class="border-0 px-4 py-3" style="color: white; font-weight:700;">Functional Description</th>
                            <th class="border-0 px-4 py-3" style="color: white; font-weight:700;">Dashboard Visibility Scope</th>
                            <th class="border-0 px-4 py-3" style="color: white; font-weight:700;">Security Level</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td class="px-4 py-3 fw-bold text-white"><i class="fa-solid fa-crown me-2" style="color: var(--amber);"></i>Super Admin</td>
                            <td class="px-4 py-3 small text-secondary">Full system override capabilities. Administers general database indexes, security setups, and software parameters.</td>
                            <td class="px-4 py-3 small"><span class="badge badge-scope-full">All 14 Modules Enabled</span></td>
                            <td class="px-4 py-3 small text-white fw-bold">Level 10 (Full System Override)</td>
                        </tr>
                        <tr>
                            <td class="px-4 py-3 fw-bold text-white"><i class="fa-solid fa-users-rectangle me-2" style="color: var(--amber);"></i>HR Administrator</td>
                            <td class="px-4 py-3 small text-secondary">Manages employee profiles, handles shifts and monthly salary structures, and logs HR requests.</td>
                            <td class="px-4 py-3 small"><span class="badge badge-scope-partial">HR &amp; Employees, Company Profiles</span></td>
                            <td class="px-4 py-3 small text-white fw-bold">Level 6 (HR Operations)</td>
                        </tr>
                        <tr>
                            <td class="px-4 py-3 fw-bold text-white"><i class="fa-solid fa-calculator me-2" style="color: var(--teal);"></i>Accountant</td>
                            <td class="px-4 py-3 small text-secondary">Fills ledgers, logs company travel and administrative costs, audits invoices, and tracks business assets.</td>
                            <td class="px-4 py-3 small"><span class="badge badge-scope-partial">Accounting, Expenses, Invoicing, Reports</span></td>
                            <td class="px-4 py-3 small text-white fw-bold">Level 7 (Financial Entries)</td>
                        </tr>
                        <tr>
                            <td class="px-4 py-3 fw-bold text-white"><i class="fa-solid fa-boxes-stacked me-2" style="color: var(--teal);"></i>Inventory Manager</td>
                            <td class="px-4 py-3 small text-secondary">Coordinates warehouse product levels, logs product categories, and raises procurement vendor lists.</td>
                            <td class="px-4 py-3 small"><span class="badge badge-scope-partial">Products, Inventory, Suppliers</span></td>
                            <td class="px-4 py-3 small text-white fw-bold">Level 5 (Logistics Operations)</td>
                        </tr>
                        <tr>
                            <td class="px-4 py-3 fw-bold text-white"><i class="fa-solid fa-magnifying-glass-chart me-2 text-secondary"></i>Auditor</td>
                            <td class="px-4 py-3 small text-secondary">Strict read-only access to corporate ledger accounts, transaction journals, and audit compliance metrics.</td>
                            <td class="px-4 py-3 small"><span class="badge badge-scope-readonly">Read-only (Ledger &amp; Reports)</span></td>
                            <td class="px-4 py-3 small text-white fw-bold">Level 4 (Audit Review)</td>
                        </tr>
                    </tbody>
                </table>
            </div>

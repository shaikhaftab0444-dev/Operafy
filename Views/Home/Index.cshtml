@{
    Layout = "_LandingLayout";
    ViewData["Title"] = "Enterprise Resource Planning Portal";
}

<!-- Hero Section -->
<section class="hero-section text-center text-lg-start">
    <div class="container">
        <div class="row align-items-center g-5">
            <div class="col-lg-6">
                <span class="badge px-3 py-2 mb-3" style="background: rgba(79, 70, 229, 0.15); color: #a5b4fc; border: 1px solid rgba(79, 70, 229, 0.3);">
                    <i class="fa-solid fa-shield-halved me-2"></i>Enterprise Security Certified
                </span>
                <h1 class="hero-title mb-3" style="font-size: 3rem;">
                    Enterprise Operations, <span class="hero-gradient-text">Unified.</span>
                </h1>
                <p class="hero-subtitle" style="font-size: 1.05rem; line-height: 1.7;">
                    A comprehensive, modular ERP software designed to consolidate financial accounts, manage global supply chains, track warehouse inventories, and streamline employee human resources under one secure, relational SQL Server backend.
                </p>
                <div class="d-flex justify-content-center justify-content-lg-start">
                    <a href="/Account/Login" class="btn btn-glass-primary px-5 py-3 fw-bold" style="font-size: 1.05rem;">
                        <i class="fa-solid fa-lock-open me-2"></i>Access Administrative Portal
                    </a>
                </div>
                
                <!-- Quick stats -->
                <div class="row mt-5 pt-4 border-top" style="border-color: rgba(255,255,255,0.05) !important;">
                    <div class="col-4">
                        <h4 class="fw-bold mb-0 text-white">12</h4>
                        <small class="text-secondary">Granular Roles</small>
                    </div>
                    <div class="col-4">
                        <h4 class="fw-bold mb-0 text-white">14</h4>
                        <small class="text-secondary">Enterprise Modules</small>
                    </div>
                    <div class="col-4">
                        <h4 class="fw-bold mb-0 text-white">SQL Server</h4>
                        <small class="text-secondary">Relational DB</small>
                    </div>
                </div>
            </div>
            
            <div class="col-lg-6">
                <!-- Static CSS-based Premium Dashboard Graphics Mockup -->
                <div class="sim-dashboard" style="background: rgba(17, 24, 39, 0.55); border-color: rgba(255,255,255,0.08);">
                    <div class="sim-header">
                        <div class="d-flex gap-1.5 align-items-center">
                            <span class="dot dot-red"></span>
                            <span class="dot dot-yellow mx-1"></span>
                            <span class="dot dot-green"></span>
                            <span class="text-secondary small ms-2" style="font-size: 0.75rem;">System Interface Preview</span>
                        </div>
                        <span class="badge bg-primary bg-opacity-10 text-primary small py-1">
                            <i class="fa-solid fa-server me-1"></i>PRODUCTION
                        </span>
                    </div>
                    
                    <!-- Replicating the metric layouts in a premium static mockup -->
                    <div class="row g-3 mb-3">
                        <div class="col-6">
                            <div class="sim-stat-card" style="border-color: rgba(79, 70, 229, 0.15);">
                                <div class="sim-stat-label"><i class="fa-solid fa-chart-line text-primary me-1"></i>TOTAL SALES</div>
                                <div class="sim-stat-val text-white">₹12,45,000</div>
                                <div class="sim-stat-trend text-success"><i class="fa-solid fa-arrow-up me-1"></i>+12.5%</div>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="sim-stat-card" style="border-color: rgba(16, 185, 129, 0.15);">
                                <div class="sim-stat-label"><i class="fa-solid fa-cart-shopping text-success me-1"></i>TOTAL PURCHASE</div>
                                <div class="sim-stat-val text-white">₹8,75,000</div>
                                <div class="sim-stat-trend text-success"><i class="fa-solid fa-arrow-up me-1"></i>+8.3%</div>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="sim-stat-card" style="border-color: rgba(139, 92, 246, 0.15);">
                                <div class="sim-stat-label"><i class="fa-solid fa-users text-purple me-1"></i>TOTAL CUSTOMERS</div>
                                <div class="sim-stat-val text-white">1,245</div>
                                <div class="sim-stat-trend text-success"><i class="fa-solid fa-arrow-up me-1"></i>+15.2%</div>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="sim-stat-card" style="border-color: rgba(244, 63, 94, 0.15);">
                                <div class="sim-stat-label"><i class="fa-solid fa-database text-danger me-1"></i>STOCK VALUE</div>
                                <div class="sim-stat-val text-white">₹18,65,000</div>
                                <div class="sim-stat-trend text-danger"><i class="fa-solid fa-arrow-down me-1"></i>-2.4%</div>
                            </div>
                        </div>
                    </div>

                    <div class="glass-card p-3 text-start" style="background: rgba(255,255,255,0.01); border-radius: 12px; border-color: rgba(255,255,255,0.04);">
                        <div class="d-flex align-items-center justify-content-between mb-2">
                            <h6 class="small fw-bold text-white mb-0"><i class="fa-solid fa-network-wired me-2 text-secondary"></i>Database Seed Integrity</h6>
                            <span class="badge bg-success bg-opacity-10 text-success small" style="font-size:0.7rem;">Active</span>
                        </div>
                        <div style="font-family: monospace; font-size:0.75rem;" class="text-secondary">
                            <div class="mb-1"><span style="color: #6366f1;">[SUCCESS]</span> Seeded 12 system roles into [dbo].[Roles]</div>
                            <div class="mb-1"><span style="color: #10b981;">[SUCCESS]</span> Generated relational index IX_Users_role_id</div>
                            <div><span style="color: #06b6d4;">[SUCCESS]</span> Connected local SQLEXPRESS Express instance</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Business Pillars Section -->
<section id="features" class="py-5" style="border-top: 1px solid var(--glass-border);">
    <div class="container py-4">
        <div class="text-center mb-5">
            <h2 class="fw-bold text-white"><i class="fa-solid fa-layer-group me-3 text-primary"></i>Enterprise Product Pillars</h2>
            <p class="text-secondary col-lg-6 mx-auto">Discover the four core operational segments designed to handle commercial logistics, HR records, financial books, and security parameters.</p>
        </div>
        
        <div class="row g-4">
            <!-- Finance -->
            <div class="col-lg-3 col-sm-6">
                <div class="glass-card h-100 p-4">
                    <div class="module-icon-wrap" style="background: rgba(79, 70, 229, 0.15); color: #818cf8;"><i class="fa-solid fa-coins"></i></div>
                    <h5 class="text-white fw-bold">Financial Consolidation</h5>
                    <p class="text-secondary small mb-3">Implements double-entry ledger bookkeeping, tracks administrative expense entries, and matches purchase receipts automatically.</p>
                    <ul class="list-unstyled text-secondary small mb-0 d-flex flex-column gap-1">
                        <li><i class="fa-solid fa-circle-check text-success me-2"></i>General Ledger accounts</li>
                        <li><i class="fa-solid fa-circle-check text-success me-2"></i>Expense recording ledgers</li>
                        <li><i class="fa-solid fa-circle-check text-success me-2"></i>Automated audits</li>
                    </ul>
                </div>
            </div>
            <!-- Supply Chain -->
            <div class="col-lg-3 col-sm-6">
                <div class="glass-card h-100 p-4">
                    <div class="module-icon-wrap" style="background: rgba(6, 182, 212, 0.15); color: #22d3ee;"><i class="fa-solid fa-boxes-stacked"></i></div>
                    <h5 class="text-white fw-bold">Logistics & Supply Chain</h5>
                    <p class="text-secondary small mb-3">Audits stock count levels across warehouses, handles product catalog SKUs, and drafts supplier procurement purchase orders.</p>
                    <ul class="list-unstyled text-secondary small mb-0 d-flex flex-column gap-1">
                        <li><i class="fa-solid fa-circle-check text-success me-2"></i>Warehouse Stock Counts</li>
                        <li><i class="fa-solid fa-circle-check text-success me-2"></i>Vendor Supplier registry</li>
                        <li><i class="fa-solid fa-circle-check text-success me-2"></i>Low stock threshold warnings</li>
                    </ul>
                </div>
            </div>
            <!-- HR Operations -->
            <div class="col-lg-3 col-sm-6">
                <div class="glass-card h-100 p-4">
                    <div class="module-icon-wrap" style="background: rgba(245, 158, 11, 0.15); color: #fbbf24;"><i class="fa-solid fa-user-tie"></i></div>
                    <h5 class="text-white fw-bold">Human Resources</h5>
                    <p class="text-secondary small mb-3">Maintains central employee data logs, tracks payroll structures, structures departments, and handles employee profile updates.</p>
                    <ul class="list-unstyled text-secondary small mb-0 d-flex flex-column gap-1">
                        <li><i class="fa-solid fa-circle-check text-success me-2"></i>Central employee registry</li>
                        <li><i class="fa-solid fa-circle-check text-success me-2"></i>Dynamic payroll setup</li>
                        <li><i class="fa-solid fa-circle-check text-success me-2"></i>Role authorization setups</li>
                    </ul>
                </div>
            </div>
            <!-- Sales & CRM -->
            <div class="col-lg-3 col-sm-6">
                <div class="glass-card h-100 p-4">
                    <div class="module-icon-wrap" style="background: rgba(244, 63, 94, 0.15); color: #fb7185;"><i class="fa-solid fa-handshake"></i></div>
                    <h5 class="text-white fw-bold">Sales & Client Relations</h5>
                    <p class="text-secondary small mb-3">Generates professional retail sales invoices, keeps track of customer account credit limits, and compiles revenue statistics.</p>
                    <ul class="list-unstyled text-secondary small mb-0 d-flex flex-column gap-1">
                        <li><i class="fa-solid fa-circle-check text-success me-2"></i>Automated sales billing</li>
                        <li><i class="fa-solid fa-circle-check text-success me-2"></i>Client database profiles</li>
                        <li><i class="fa-solid fa-circle-check text-success me-2"></i>Top-selling product tracking</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Role Compliance Grid Section -->
<section id="roles" class="py-5" style="background: rgba(17, 24, 39, 0.3); border-top: 1px solid var(--glass-border); border-bottom: 1px solid var(--glass-border);">
    <div class="container py-4">
        <div class="text-center mb-5">
            <h2 class="fw-bold text-white"><i class="fa-solid fa-shield-halved me-3 text-secondary"></i>Role-Based Security Matrix</h2>
            <p class="text-secondary col-lg-6 mx-auto">The platform contains 12 built-in, granular roles linked directly to SQL Server database mapping, ensuring strict segregation of duties.</p>
        </div>
        
        <div class="table-responsive glass-card p-0 overflow-hidden" style="background: rgba(17, 24, 39, 0.6); border-radius: 12px;">
            <table class="table table-hover mb-0 text-start" style="color: var(--text-secondary);">
                <thead style="background: rgba(255,255,255,0.02); color: white;">
                    <tr>
                        <th class="border-0 px-4 py-3" style="color: white; font-weight:700;">Role Designation</th>
                        <th class="border-0 px-4 py-3" style="color: white; font-weight:700;">Functional Description</th>
                        <th class="border-0 px-4 py-3" style="color: white; font-weight:700;">Dashboard Visibility Scope</th>
                        <th class="border-0 px-4 py-3" style="color: white; font-weight:700;">Security Level</th>
                    </tr>
                </thead>
                <tbody style="border-top: 1px solid rgba(255,255,255,0.05);">
                    <tr style="border-bottom: 1px solid rgba(255,255,255,0.04);">
                        <td class="px-4 py-3 fw-bold text-white"><i class="fa-solid fa-crown text-primary me-2"></i>Super Admin</td>
                        <td class="px-4 py-3 small text-secondary">Full system override capabilities. Administers general database indexes, security setups, and software parameters.</td>
                        <td class="px-4 py-3 small"><span class="badge bg-success bg-opacity-10 text-success">All 14 Modules Enabled</span></td>
                        <td class="px-4 py-3 small text-white font-weight-bold">Level 10 (Full System Override)</td>
                    </tr>
                    <tr style="border-bottom: 1px solid rgba(255,255,255,0.04);">
                        <td class="px-4 py-3 fw-bold text-white"><i class="fa-solid fa-users-rectangle text-warning me-2"></i>HR Administrator</td>
                        <td class="px-4 py-3 small text-secondary">Manages employee profiles, handles shifts and monthly salary structures, and logs HR requests.</td>
                        <td class="px-4 py-3 small"><span class="badge bg-secondary bg-opacity-10 text-white">HR & Employees, Company Profiles</span></td>
                        <td class="px-4 py-3 small text-white font-weight-bold">Level 6 (HR Operations)</td>
                    </tr>
                    <tr style="border-bottom: 1px solid rgba(255,255,255,0.04);">
                        <td class="px-4 py-3 fw-bold text-white"><i class="fa-solid fa-calculator text-info me-2"></i>Accountant</td>
                        <td class="px-4 py-3 small text-secondary">Fills ledgers, logs company travel and administrative costs, audits invoices, and tracks business assets.</td>
                        <td class="px-4 py-3 small"><span class="badge bg-secondary bg-opacity-10 text-white">Accounting, Expenses, Invoicing, Reports</span></td>
                        <td class="px-4 py-3 small text-white font-weight-bold">Level 7 (Financial Entries)</td>
                    </tr>
                    <tr style="border-bottom: 1px solid rgba(255,255,255,0.04);">
                        <td class="px-4 py-3 fw-bold text-white"><i class="fa-solid fa-boxes-stacked text-success me-2"></i>Inventory Manager</td>
                        <td class="px-4 py-3 small text-secondary">Coordinates warehouse product levels, logs product categories, and raises procurement vendor lists.</td>
                        <td class="px-4 py-3 small"><span class="badge bg-secondary bg-opacity-10 text-white">Products, Inventory, Suppliers</span></td>
                        <td class="px-4 py-3 small text-white font-weight-bold">Level 5 (Logistics Operations)</td>
                    </tr>
                    <tr>
                        <td class="px-4 py-3 fw-bold text-white"><i class="fa-solid fa-magnifying-glass-chart text-muted me-2"></i>Auditor</td>
                        <td class="px-4 py-3 small text-secondary">Strict read-only access to corporate ledger accounts, transaction journals, and audit compliance metrics.</td>
                        <td class="px-4 py-3 small"><span class="badge bg-danger bg-opacity-10 text-danger">Read-only (Ledger & Reports)</span></td>
                        <td class="px-4 py-3 small text-white font-weight-bold">Level 4 (Audit Review)</td>
                    </tr>
                </tbody>
            </table>
        </div>
        <div class="text-center mt-4">
            <span class="text-secondary small"><i class="fa-solid fa-circle-info me-2 text-info"></i>Looking to test other profiles? The system includes pre-defined configurations for 12 distinct roles.</span>
        </div>
    </div>
</section>

<!-- Technology Architecture Section -->
<section id="about" class="py-5">
    <div class="container py-4">
        <div class="text-center mb-5">
            <h2 class="fw-bold text-white"><i class="fa-solid fa-server me-3 text-secondary" style="color:#06b6d4 !important;"></i>Enterprise-Grade Architecture</h2>
            <p class="text-secondary col-lg-6 mx-auto">Engineered to support modern business scales with reliability, relational integrity, and robust authentication.</p>
        </div>
        
        <div class="row g-4">
            <div class="col-md-4">
                <div class="glass-card p-4 h-100">
                    <h5 class="text-white fw-bold mb-3"><i class="fa-solid fa-database text-primary me-2"></i>Relational Durability</h5>
                    <p class="text-secondary small mb-0">Built directly on top of SQL Server with strict foreign keys, relational indices, and constraint verification to guarantee double-entry accounting integrity.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="glass-card p-4 h-100">
                    <h5 class="text-white fw-bold mb-3"><i class="fa-solid fa-user-lock text-success me-2"></i>Secure Authentication</h5>
                    <p class="text-secondary small mb-0">Implements cryptographically hashed user passwords and ASP.NET Core cookie-based sessions, restricting page loads according to strict security filters.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="glass-card p-4 h-100">
                    <h5 class="text-white fw-bold mb-3"><i class="fa-solid fa-arrows-spin text-info me-2"></i>Unified Workflow</h5>
                    <p class="text-secondary small mb-0">Eliminates information silos by automatically sharing data between departments (e.g. Sales Invoicing automatically updates stock count and general ledger balances).</p>
                </div>
            </div>
        </div>
    </div>
</section>

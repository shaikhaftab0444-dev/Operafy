@model List<ERP_System.Models.CompanyBankAccount>
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Company Bank Master";
    var primaryAccount = Model.FirstOrDefault(b => b.IsPrimaryAccount);
    var totalBalance = Model.Sum(b => b.CurrentBalance);
    var activeCount = Model.Count(b => b.IsActive);
}

<style>
    :root {
        --bank-primary: #1e3a8a;
        --bank-accent: #3b82f6;
        --bank-gold: #f59e0b;
        --bank-success: #10b981;
    }

    .bank-hero-card {
        background: linear-gradient(135deg, #0f172a 0%, #1e293b 60%, #1e3a8a 100%);
        border-radius: 16px;
        color: #ffffff;
        padding: 1.75rem 2rem;
        box-shadow: 0 10px 25px -5px rgba(15, 23, 42, 0.3), 0 8px 10px -6px rgba(15, 23, 42, 0.2);
        position: relative;
        overflow: hidden;
        border: 1px solid rgba(255, 255, 255, 0.1);
    }

    .bank-hero-card::after {
        content: '';
        position: absolute;
        top: -30px;
        right: -30px;
        width: 160px;
        height: 160px;
        background: radial-gradient(circle, rgba(59, 130, 246, 0.25) 0%, transparent 70%);
        border-radius: 50%;
        pointer-events: none;
    }

    .stat-card-3d {
        background: #ffffff;
        border-radius: 14px;
        border: 1px solid var(--border-warm, #e2e8f0);
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.04), 0 2px 4px -2px rgba(0, 0, 0, 0.04);
        transition: transform 0.2s ease, box-shadow 0.2s ease;
        overflow: hidden;
        position: relative;
    }

    .stat-card-3d:hover {
        transform: translateY(-3px);
        box-shadow: 0 12px 20px -5px rgba(0, 0, 0, 0.08);
    }

    .stat-icon-wrap {
        width: 48px;
        height: 48px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.35rem;
    }

    .bank-table-card {
        background: #ffffff;
        border-radius: 16px;
        border: 1px solid var(--border-warm, #e2e8f0);
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.04);
        overflow: hidden;
    }

    .bank-avatar {
        width: 42px;
        height: 42px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        font-size: 1.1rem;
        background: linear-gradient(135deg, #e0e7ff 0%, #c7d2fe 100%);
        color: #3730a3;
    }

    .badge-primary-acc {
        background: linear-gradient(135deg, #fef3c7 0%, #fde68a 100%);
        color: #92400e;
        border: 1px solid #fcd34d;
        font-weight: 700;
        font-size: 0.72rem;
        padding: 0.35rem 0.65rem;
        border-radius: 20px;
        display: inline-flex;
        align-items: center;
        gap: 4px;
    }

    .type-pill {
        font-size: 0.72rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        padding: 0.3rem 0.6rem;
        border-radius: 6px;
    }

    .type-Current { background: rgba(59, 130, 246, 0.12); color: #1d4ed8; }
    .type-Savings { background: rgba(16, 185, 129, 0.12); color: #047857; }
    .type-Overdraft { background: rgba(245, 158, 11, 0.12); color: #b45309; }
    .type-Escrow { background: rgba(139, 92, 246, 0.12); color: #6d28d9; }

    .switch-custom .form-check-input {
        width: 2.5rem;
        height: 1.3rem;
        cursor: pointer;
    }
    .switch-custom .form-check-input:checked {
        background-color: #10b981;
        border-color: #10b981;
    }
</style>

<div class="container-fluid py-4 px-3 px-md-4">
    <!-- Breadcrumb & Top Action -->
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1 text-muted small">
                    <li class="breadcrumb-item"><a href="@Url.Action("Index", "Dashboard")" class="text-decoration-none text-muted">Super Admin</a></li>
                    <li class="breadcrumb-item">Master Data Setup</li>
                    <li class="breadcrumb-item active text-dark fw-semibold" aria-current="page">Company Bank Master</li>
                </ol>
            </nav>
            <h4 class="fw-bold mb-0 text-dark">
                <i class="fa-solid fa-building-columns text-primary me-2"></i>Corporate Bank Account Master
            </h4>
        </div>
        <button type="button" class="btn btn-primary px-3 shadow-sm d-flex align-items-center gap-2" data-bs-toggle="modal" data-bs-target="#bankAccountModal" onclick="openCreateModal()">
            <i class="fa-solid fa-plus"></i>
            <span>Add Bank Account</span>
        </button>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm border-0 d-flex align-items-center gap-2" role="alert">
            <i class="fa-solid fa-circle-check fs-5 text-success"></i>
            <div>@TempData["SuccessMessage"]</div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm border-0 d-flex align-items-center gap-2" role="alert">
            <i class="fa-solid fa-circle-exclamation fs-5 text-danger"></i>
            <div>@TempData["ErrorMessage"]</div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Top 4 Summary Cards -->
    <div class="row g-3 mb-4">
        <!-- Card 1: Total Liquid Treasury Balance -->
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="stat-card-3d p-3.5 h-100">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="text-muted text-uppercase fw-bold" style="font-size: 0.72rem; letter-spacing: 0.5px;">Corporate Treasury</span>
                        <h4 class="fw-bolder text-dark mb-0 mt-1">₹ @totalBalance.ToString("N2")</h4>
                        <div class="text-success small fw-semibold mt-1">
                            <i class="fa-solid fa-vault me-1"></i> Across All Bank Vaults
                        </div>
                    </div>
                    <div class="stat-icon-wrap bg-primary bg-opacity-10 text-primary">
                        <i class="fa-solid fa-wallet"></i>
                    </div>
                </div>
            </div>
        </div>

        <!-- Card 2: Primary Disbursal Account -->
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="stat-card-3d p-3.5 h-100">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="text-muted text-uppercase fw-bold" style="font-size: 0.72rem; letter-spacing: 0.5px;">Primary Disbursal</span>
                        <h5 class="fw-bolder text-dark mb-0 mt-1 text-truncate" style="max-width: 170px;">
                            @(primaryAccount?.BankName ?? "Not Configured")
                        </h5>
                        <div class="text-secondary small font-monospace mt-1">
                            @(primaryAccount != null ? "A/C: " + primaryAccount.AccountNumber : "No primary account")
                        </div>
                    </div>
                    <div class="stat-icon-wrap bg-warning bg-opacity-10 text-warning">
                        <i class="fa-solid fa-star"></i>
                    </div>
                </div>
            </div>
        </div>

        <!-- Card 3: Active Corporate Accounts -->
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="stat-card-3d p-3.5 h-100">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="text-muted text-uppercase fw-bold" style="font-size: 0.72rem; letter-spacing: 0.5px;">Active Accounts</span>
                        <h4 class="fw-bolder text-dark mb-0 mt-1">@activeCount / @Model.Count</h4>
                        <div class="text-info small fw-semibold mt-1">
                            <i class="fa-solid fa-shield-halved me-1"></i> KYC & Compliance Verified
                        </div>
                    </div>
                    <div class="stat-icon-wrap bg-info bg-opacity-10 text-info">
                        <i class="fa-solid fa-landmark"></i>
                    </div>
                </div>
            </div>
        </div>

        <!-- Card 4: Default Payroll & Invoicing Status -->
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="stat-card-3d p-3.5 h-100">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="text-muted text-uppercase fw-bold" style="font-size: 0.72rem; letter-spacing: 0.5px;">Payout Linkage</span>
                        <h4 class="fw-bolder text-dark mb-0 mt-1">
                            @(primaryAccount != null ? "Connected" : "Unset")
                        </h4>
                        <div class="text-success small fw-semibold mt-1">
                            <i class="fa-solid fa-link me-1"></i> Auto-routed in Payroll
                        </div>
                    </div>
                    <div class="stat-icon-wrap bg-success bg-opacity-10 text-success">
                        <i class="fa-solid fa-money-bill-transfer"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Main Bank Table Card -->
    <div class="bank-table-card">
        <div class="p-3 border-bottom d-flex flex-wrap justify-content-between align-items-center gap-3 bg-light-subtle">
            <div class="d-flex align-items-center gap-2">
                <i class="fa-solid fa-building-columns text-primary"></i>
                <span class="fw-bold small text-secondary">Configured Bank Accounts:</span>
                <span class="badge bg-primary rounded-pill">@Model.Count</span>
            </div>
            <div class="d-flex align-items-center gap-2">
                <div class="input-group input-group-sm" style="max-width: 280px;">
                    <span class="input-group-text bg-white border-end-0"><i class="fa-solid fa-search text-muted"></i></span>
                    <input type="text" id="bankSearchInput" class="form-control border-start-0" placeholder="Search bank, account #, IFSC..." onkeyup="filterBankAccounts()" />
                </div>
            </div>
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" id="bankAccountsTable">
                <thead class="table-light">
                    <tr class="small text-uppercase text-muted">
                        <th>Bank / Institution</th>
                        <th>Account Details</th>
                        <th>IFSC & Branch</th>
                        <th>Account Type</th>
                        <th>Current Balance</th>
                        <th>Primary For Operations</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="8" class="text-center py-5 text-muted">
                                <i class="fa-solid fa-building-columns fs-1 d-block mb-3 text-secondary opacity-50"></i>
                                <h6 class="fw-bold text-dark">No Corporate Bank Accounts Configured</h6>
                                <p class="small text-muted mb-3">Add your corporate bank accounts to enable payroll disbursal, billing reconciliation, and treasury tracking.</p>
                                <button type="button" class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#bankAccountModal" onclick="openCreateModal()">
                                    <i class="fa-solid fa-plus me-1"></i> Add First Bank Account
                                </button>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var account in Model)
                        {
                            <tr class="bank-row">
                                <td>
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="bank-avatar">
                                            <i class="fa-solid fa-building-columns"></i>
                                        </div>
                                        <div>
                                            <div class="fw-bold text-dark bank-name">@account.BankName</div>
                                            <div class="text-muted extra-small">Added on @account.CreatedAt.ToString("dd MMM yyyy")</div>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="font-monospace fw-bold text-dark bank-acc">@account.AccountNumber</span>
                                        <button class="btn btn-sm btn-light border-0 p-1 text-muted" title="Copy Account Number" onclick="copyToClipboard('@account.AccountNumber')">
                                            <i class="fa-regular fa-copy"></i>
                                        </button>
                                    </div>
                                    <span class="text-muted extra-small">Opening: ₹ @account.OpeningBalance.ToString("N2")</span>
                                </td>
                                <td>
                                    <div class="fw-semibold text-secondary font-monospace small bank-ifsc">@account.IFSCCode</div>
                                    <div class="text-muted extra-small bank-branch">@(string.IsNullOrWhiteSpace(account.BranchName) ? "Main Branch" : account.BranchName)</div>
                                </td>
                                <td>
                                    <span class="type-pill type-@account.AccountType">@account.AccountType</span>
                                </td>
                                <td>
                                    <div class="fw-bold text-dark">₹ @account.CurrentBalance.ToString("N2")</div>
                                </td>
                                <td>
                                    @if (account.IsPrimaryAccount)
                                    {
                                        <span class="badge-primary-acc">
                                            <i class="fa-solid fa-star text-warning"></i> Primary Disbursal
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">Secondary Account</span>
                                    }
                                </td>
                                <td>
                                    <div class="form-check form-switch switch-custom">
                                        <input class="form-check-input" type="checkbox" role="switch" @(account.IsActive ? "checked" : "") onchange="toggleAccountStatus(@account.Id, this)" />
                                    </div>
                                </td>
                                <td class="text-end">
                                    <div class="d-flex justify-content-end gap-1">
                                        <button type="button" class="btn btn-sm btn-outline-primary" title="Edit Account" onclick="openEditModal(@account.Id)">
                                            <i class="fa-solid fa-pen-to-square"></i>
                                        </button>
                                        @if (!account.IsPrimaryAccount)
                                        {
                                            <form action="@Url.Action("Delete", "BankMaster", new { id = account.Id })" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to remove this corporate bank account?');">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete Account">
                                                    <i class="fa-solid fa-trash-can"></i>
                                                </button>
                                            </form>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- MODAL: ADD / EDIT COMPANY BANK ACCOUNT -->
<div class="modal fade" id="bankAccountModal" tabindex="-1" aria-labelledby="bankAccountModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 16px;">
            <div class="modal-header bg-dark text-white px-4 py-3">
                <h6 class="modal-title fw-bold" id="bankAccountModalLabel">
                    <i class="fa-solid fa-building-columns me-2 text-primary"></i> <span id="modalTitleText">Add Company Bank Account</span>
                </h6>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form action="@Url.Action("CreateOrEdit", "BankMaster")" method="post" id="bankAccountForm">
                @Html.AntiForgeryToken()
                <input type="hidden" name="Id" id="account_Id" value="0" />

                <div class="modal-body p-4">
                    <div class="row g-3">
                        <div class="col-12">
                            <label class="form-label small fw-bold">Bank Name <span class="text-danger">*</span></label>
                            <input type="text" name="BankName" id="account_BankName" class="form-control" required placeholder="e.g. HDFC Bank Ltd, State Bank of India" />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label small fw-bold">Account Number <span class="text-danger">*</span></label>
                            <input type="text" name="AccountNumber" id="account_AccountNumber" class="form-control font-monospace" required placeholder="e.g. 50200012345678" />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label small fw-bold">IFSC Code <span class="text-danger">*</span></label>
                            <input type="text" name="IFSCCode" id="account_IFSCCode" class="form-control font-monospace text-uppercase" required placeholder="e.g. HDFC0000123" />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label small fw-bold">Branch Name</label>
                            <input type="text" name="BranchName" id="account_BranchName" class="form-control" placeholder="e.g. BKC Complex, Mumbai" />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label small fw-bold">Account Type</label>
                            <select name="AccountType" id="account_AccountType" class="form-select">
                                <option value="Current" selected>Current Account</option>
                                <option value="Savings">Savings Account</option>
                                <option value="Overdraft">Overdraft (OD) Account</option>
                                <option value="Escrow">Escrow Account</option>
                            </select>
                        </div>

                        <div class="col-12" id="openingBalanceWrapper">
                            <label class="form-label small fw-bold">Opening Balance (₹)</label>
                            <input type="number" step="0.01" name="OpeningBalance" id="account_OpeningBalance" class="form-control" placeholder="0.00" value="0.00" />
                            <small class="text-muted">Initial liquidity balance registered in company books.</small>
                        </div>

                        <div class="col-12 mt-2">
                            <div class="p-3 bg-light rounded-3 border">
                                <div class="form-check form-switch mb-2">
                                    <input class="form-check-input" type="checkbox" name="IsPrimaryAccount" id="account_IsPrimaryAccount" value="true" />
                                    <label class="form-check-label small fw-bold text-dark" for="account_IsPrimaryAccount">
                                        Set as Primary Account for Disbursals
                                    </label>
                                    <div class="text-muted extra-small">Used by default for employee salary disbursal and client invoices.</div>
                                </div>

                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" name="IsActive" id="account_IsActive" value="true" checked />
                                    <label class="form-check-label small fw-bold text-dark" for="account_IsActive">
                                        Active / Operational Account
                                    </label>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer px-4 py-3 bg-light border-top">
                    <button type="button" class="btn btn-secondary px-3" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary px-4 shadow-sm" id="saveBankBtn">
                        <i class="fa-solid fa-floppy-disk me-1"></i> Save Bank Account
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function openCreateModal() {
            document.getElementById('modalTitleText').innerText = "Add Company Bank Account";
            document.getElementById('account_Id').value = "0";
            document.getElementById('account_BankName').value = "";
            document.getElementById('account_AccountNumber').value = "";
            document.getElementById('account_IFSCCode').value = "";
            document.getElementById('account_BranchName').value = "";
            document.getElementById('account_AccountType').value = "Current";
            document.getElementById('account_OpeningBalance').value = "0.00";
            document.getElementById('openingBalanceWrapper').style.display = "block";
            document.getElementById('account_IsPrimaryAccount').checked = false;
            document.getElementById('account_IsActive').checked = true;
        }

        function openEditModal(id) {
            fetch('@Url.Action("GetAccount", "BankMaster")?id=' + id)
                .then(response => response.json())
                .then(res => {
                    if (res.success && res.data) {
                        const acc = res.data;
                        document.getElementById('modalTitleText').innerText = "Edit Company Bank Account";
                        document.getElementById('account_Id').value = acc.id;
                        document.getElementById('account_BankName').value = acc.bankName;
                        document.getElementById('account_AccountNumber').value = acc.accountNumber;
                        document.getElementById('account_IFSCCode').value = acc.ifscCode;
                        document.getElementById('account_BranchName').value = acc.branchName || '';
                        document.getElementById('account_AccountType').value = acc.accountType;
                        document.getElementById('account_OpeningBalance').value = acc.openingBalance;
                        document.getElementById('openingBalanceWrapper').style.display = "none";
                        document.getElementById('account_IsPrimaryAccount').checked = acc.isPrimaryAccount;
                        document.getElementById('account_IsActive').checked = acc.isActive;

                        const modal = new bootstrap.Modal(document.getElementById('bankAccountModal'));
                        modal.show();
                    } else {
                        if (typeof toastr !== 'undefined') {
                            toastr.error(res.message || 'Failed to fetch account details.');
                        } else {
                            alert(res.message || 'Failed to fetch account details.');
                        }
                    }
                })
                .catch(err => {
                    console.error(err);
                    alert('Error loading bank account details.');
                });
        }

        function toggleAccountStatus(id, switchEl) {
            fetch('@Url.Action("ToggleStatus", "BankMaster")', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                    'X-Requested-With': 'XMLHttpRequest'
                },
                body: 'id=' + id
            })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    if (typeof toastr !== 'undefined') {
                        toastr.success(data.message || 'Status updated successfully.');
                    }
                } else {
                    switchEl.checked = !switchEl.checked;
                    if (typeof toastr !== 'undefined') {
                        toastr.error('Failed to update status.');
                    } else {
                        alert('Failed to update status.');
                    }
                }
            })
            .catch(err => {
                switchEl.checked = !switchEl.checked;
                console.error(err);
            });
        }

        function filterBankAccounts() {
            const query = document.getElementById('bankSearchInput').value.toLowerCase();
            const rows = document.querySelectorAll('#bankAccountsTable tbody tr.bank-row');

            rows.forEach(row => {
                const name = row.querySelector('.bank-name')?.innerText.toLowerCase() || '';
                const acc = row.querySelector('.bank-acc')?.innerText.toLowerCase() || '';
                const ifsc = row.querySelector('.bank-ifsc')?.innerText.toLowerCase() || '';
                const branch = row.querySelector('.bank-branch')?.innerText.toLowerCase() || '';

                if (name.includes(query) || acc.includes(query) || ifsc.includes(query) || branch.includes(query)) {
                    row.style.display = '';
                } else {
                    row.style.display = 'none';
                }
            });
        }

        function copyToClipboard(text) {
            navigator.clipboard.writeText(text).then(() => {
                if (typeof toastr !== 'undefined') {
                    toastr.info('Account number copied to clipboard.');
                }
            });
        }
    </script>
}

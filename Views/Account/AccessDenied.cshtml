@{
    Layout = null;
    ViewData["Title"] = "Access Denied - ERP Portal";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/landing.css" asp-append-version="true" />
    <style>
        body {
            background-color: var(--dark-bg);
            height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0;
        }
        .denied-card {
            width: 100%;
            max-width: 500px;
            background: rgba(17, 24, 39, 0.65);
            border: 1px solid rgba(244, 63, 94, 0.2);
            border-radius: 16px;
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            box-shadow: 0 20px 50px rgba(0,0,0,0.5), 0 0 30px rgba(244, 63, 94, 0.05);
            padding: 3rem 2rem;
            text-align: center;
        }
        .denied-icon {
            font-size: 4rem;
            color: var(--accent);
            margin-bottom: 1.5rem;
            animation: pulse 2s infinite;
        }
        @@keyframes pulse {
            0% { transform: scale(1); }
            50% { transform: scale(1.05); opacity: 0.8; }
            100% { transform: scale(1); }
        }
    </style>
</head>
<body>
    <div class="bg-glow" style="width: 400px; height: 400px; top: 10%; right: 10%; background: radial-gradient(circle, rgba(244, 63, 94, 0.15) 0%, rgba(0,0,0,0) 70%);"></div>

    <div class="denied-card">
        <div class="denied-icon">
            <i class="fa-solid fa-triangle-exclamation"></i>
        </div>
        
        <h3 class="text-white fw-bold mb-3">Access Denied</h3>
        <p class="text-secondary mb-4">Your current role does not have authorization to view this module. Please contact your system administrator for permission extensions.</p>

        <div class="d-flex justify-content-center gap-3">
            <a href="/Dashboard" class="btn btn-glass-primary">
                <i class="fa-solid fa-gauge me-2"></i>Go to Dashboard
            </a>
            <a href="/Account/Logout" class="btn btn-glass-secondary">
                <i class="fa-solid fa-right-from-bracket me-2"></i>Logout
            </a>
        </div>
    </div>
</body>
</html>

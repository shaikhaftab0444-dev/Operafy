@{
    Layout = null;
    ViewData["Title"] = "Reset Password - ERP Portal";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/fontawesome-free/css/all.min.css" />

    <style>
        @@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap');

        :root {
            --primary: #4f5bd5;
            --primary-dark: #3f49b8;
            --teal: #22b8a7;
            --page-bg: #f7f8fb;
            --white: #ffffff;
            --text-dark: #172033;
            --text-muted: #737b8c;
            --border: #e5e8ef;
        }

        body {
            font-family: 'Inter', sans-serif;
            background: radial-gradient(circle at 15% 10%, rgba(34, 184, 167, 0.06), transparent 30%),
                        radial-gradient(circle at 85% 10%, rgba(79, 91, 213, 0.06), transparent 30%),
                        #f8f9fc;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 2rem;
            margin: 0;
        }

        .forgot-container {
            width: 100%;
            max-width: 480px;
            background: rgba(255, 255, 255, 0.85);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border: 1px solid rgba(226, 232, 240, 0.8);
            border-radius: 20px;
            padding: 2.5rem;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.04);
        }

        .brand-logo {
            font-family: 'Space Grotesk', sans-serif;
            font-weight: 700;
            color: var(--primary);
            text-decoration: none;
            font-size: 1.5rem;
            display: inline-flex;
            align-items: center;
            gap: 8px;
        }

        .input-shell {
            position: relative;
            margin-bottom: 1.25rem;
        }

        .input-shell .input-icon {
            position: absolute;
            left: 16px;
            top: 50%;
            transform: translateY(-50%);
            color: var(--text-muted);
            font-size: 1rem;
        }

        .form-control-custom {
            height: 52px;
            padding-left: 46px;
            border-radius: 12px;
            border: 1px solid var(--border);
            font-size: 0.95rem;
            transition: all 0.2s ease;
            background-color: var(--white);
        }

        .form-control-custom:focus {
            border-color: var(--primary);
            box-shadow: 0 0 0 4px rgba(79, 91, 213, 0.12);
            outline: none;
        }

        .btn-primary-custom {
            height: 50px;
            background: linear-gradient(135deg, var(--primary) 0%, var(--primary-dark) 100%);
            border: none;
            color: var(--white);
            font-weight: 600;
            border-radius: 12px;
            transition: all 0.2s ease;
            box-shadow: 0 4px 12px rgba(79, 91, 213, 0.2);
        }

        .btn-primary-custom:hover {
            transform: translateY(-1px);
            box-shadow: 0 6px 16px rgba(79, 91, 213, 0.3);
        }

        .link-back {
            color: var(--text-muted);
            font-size: 0.9rem;
            text-decoration: none;
            font-weight: 500;
            transition: color 0.2s ease;
        }

        .link-back:hover {
            color: var(--primary);
        }

        .policy-list {
            list-style: none;
            padding: 0;
            margin: 0 0 1.5rem 0;
            font-size: 0.8rem;
        }

        .policy-list li {
            display: flex;
            align-items: center;
            gap: 6px;
            margin-bottom: 4px;
        }
    </style>
</head>
<body>

    <div class="forgot-container text-start">
        <div class="text-center mb-4">
            <a href="/Account/Login" class="brand-logo mb-2">
                <i class="fa-solid fa-layer-group"></i>
                <span>Operafy<span style="color:var(--teal)">.</span></span>
            </a>
            <h5 class="fw-bold text-dark mt-3 mb-1">Set New Password</h5>
            <p class="text-secondary small">Set your secure login password. Make sure it conforms to active identity protection protocols.</p>
        </div>

        <div class="card bg-light border p-3 rounded-3 mb-3">
            <span class="small fw-bold text-secondary d-block"><i class="fa-solid fa-user-shield text-teal me-1"></i>Identity Context:</span>
            <span class="small font-monospace text-dark d-block">@ViewBag.Email</span>
        </div>

        @if (!ViewData.ModelState.IsValid && ViewData.ModelState.Values.SelectMany(v => v.Errors).Any())
        {
            <div class="alert alert-danger border-0 small py-2.5 px-3 rounded-3" role="alert">
                <i class="fa-solid fa-circle-exclamation me-1.5"></i>
                @Html.ValidationSummary(true, "", new { @class = "text-danger m-0 p-0" })
            </div>
        }

        <form action="/Account/ResetPassword" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="token" value="@ViewBag.Token" />

            <div class="input-shell">
                <span class="input-icon"><i class="fa-solid fa-key"></i></span>
                <input type="password" name="password" id="password" class="form-control form-control-custom" placeholder="New Secure Password" required autofocus />
            </div>

            <div class="input-shell">
                <span class="input-icon"><i class="fa-solid fa-key"></i></span>
                <input type="password" name="confirmPassword" id="confirmPassword" class="form-control form-control-custom" placeholder="Confirm New Password" required />
            </div>

            <span class="small fw-bold text-secondary d-block mb-2">Password Compliance Checklist:</span>
            <ul class="policy-list text-secondary">
                <li id="ruleLength"><i class="fa-solid fa-circle text-muted" style="font-size: 0.5rem;"></i> Minimum 8 characters long</li>
                <li id="ruleUpper"><i class="fa-solid fa-circle text-muted" style="font-size: 0.5rem;"></i> At least 1 uppercase letter</li>
                <li id="ruleDigit"><i class="fa-solid fa-circle text-muted" style="font-size: 0.5rem;"></i> At least 1 numerical digit</li>
                <li id="ruleSpecial"><i class="fa-solid fa-circle text-muted" style="font-size: 0.5rem;"></i> At least 1 special character</li>
            </ul>

            <button type="submit" class="btn btn-primary-custom w-100 mb-3">Update credentials</button>
        </form>

        <div class="text-center mt-2">
            <a href="/Account/Login" class="link-back"><i class="fa-solid fa-arrow-left me-1.5"></i>Cancel reset</a>
        </div>
    </div>

    <script>
        const passwordInput = document.getElementById("password");
        const confirmInput = document.getElementById("confirmPassword");

        const ruleLength = document.getElementById("ruleLength");
        const ruleUpper = document.getElementById("ruleUpper");
        const ruleDigit = document.getElementById("ruleDigit");
        const ruleSpecial = document.getElementById("ruleSpecial");

        passwordInput.addEventListener("input", function() {
            const val = passwordInput.value;

            // Length
            updateRuleState(ruleLength, val.length >= 8);
            // Upper
            updateRuleState(ruleUpper, /[A-Z]/.test(val));
            // Digit
            updateRuleState(ruleDigit, /[0-9]/.test(val));
            // Special
            updateRuleState(ruleSpecial, /[^A-Za-z0-9]/.test(val));
        });

        function updateRuleState(el, success) {
            const icon = el.querySelector("i");
            if (success) {
                icon.className = "fa-solid fa-circle-check text-success";
                el.className = "text-success fw-bold";
            } else {
                icon.className = "fa-solid fa-circle text-muted";
                icon.style.fontSize = "0.5rem";
                el.className = "text-secondary";
            }
        }
    </script>

</body>
</html>

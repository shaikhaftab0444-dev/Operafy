@{
    Layout = null;
    ViewData["Title"] = "Forgot Password - ERP Portal";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/fontawesome-free/css/all.min.css" />

    <style>
        @@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap');

        :root {
            --primary: #4f5bd5;
            --primary-dark: #3f49b8;
            --teal: #22b8a7;
            --page-bg: #f7f8fb;
            --white: #ffffff;
            --text-dark: #172033;
            --text-muted: #737b8c;
            --border: #e5e8ef;
        }

        body {
            font-family: 'Inter', sans-serif;
            background: radial-gradient(circle at 15% 10%, rgba(34, 184, 167, 0.06), transparent 30%),
                        radial-gradient(circle at 85% 10%, rgba(79, 91, 213, 0.06), transparent 30%),
                        #f8f9fc;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 2rem;
            margin: 0;
        }

        .forgot-container {
            width: 100%;
            max-width: 480px;
            background: rgba(255, 255, 255, 0.85);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border: 1px solid rgba(226, 232, 240, 0.8);
            border-radius: 20px;
            padding: 2.5rem;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.04);
        }

        .brand-logo {
            font-family: 'Space Grotesk', sans-serif;
            font-weight: 700;
            color: var(--primary);
            text-decoration: none;
            font-size: 1.5rem;
            display: inline-flex;
            align-items: center;
            gap: 8px;
        }

        .input-shell {
            position: relative;
            margin-bottom: 1.25rem;
        }

        .input-shell .input-icon {
            position: absolute;
            left: 16px;
            top: 50%;
            transform: translateY(-50%);
            color: var(--text-muted);
            font-size: 1rem;
        }

        .form-control-custom {
            height: 52px;
            padding-left: 46px;
            border-radius: 12px;
            border: 1px solid var(--border);
            font-size: 0.95rem;
            transition: all 0.2s ease;
            background-color: var(--white);
        }

        .form-control-custom:focus {
            border-color: var(--primary);
            box-shadow: 0 0 0 4px rgba(79, 91, 213, 0.12);
            outline: none;
        }

        .btn-primary-custom {
            height: 50px;
            background: linear-gradient(135deg, var(--primary) 0%, var(--primary-dark) 100%);
            border: none;
            color: var(--white);
            font-weight: 600;
            border-radius: 12px;
            transition: all 0.2s ease;
            box-shadow: 0 4px 12px rgba(79, 91, 213, 0.2);
        }

        .btn-primary-custom:hover {
            transform: translateY(-1px);
            box-shadow: 0 6px 16px rgba(79, 91, 213, 0.3);
        }

        .link-back {
            color: var(--text-muted);
            font-size: 0.9rem;
            text-decoration: none;
            font-weight: 500;
            transition: color 0.2s ease;
        }

        .link-back:hover {
            color: var(--primary);
        }
    </style>
</head>
<body>

    <div class="forgot-container text-center">
        <div class="mb-4">
            <a href="/Account/Login" class="brand-logo mb-2">
                <i class="fa-solid fa-layer-group"></i>
                <span>Operafy<span style="color:var(--teal)">.</span></span>
            </a>
            <h5 class="fw-bold text-dark mt-3 mb-1">Reset Password</h5>
            <p class="text-secondary small">Enter your registered email or username below and we will help you recover your access credentials.</p>
        </div>

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger border-0 small text-start py-2.5 px-3 rounded-3" role="alert">
                <i class="fa-solid fa-circle-exclamation me-1.5"></i>@TempData["ErrorMessage"]
            </div>
        }

        @if (!ViewData.ModelState.IsValid && ViewData.ModelState.Values.SelectMany(v => v.Errors).Any())
        {
            <div class="alert alert-danger border-0 small text-start py-2.5 px-3 rounded-3" role="alert">
                <i class="fa-solid fa-circle-exclamation me-1.5"></i>
                @Html.ValidationSummary(true, "", new { @class = "text-danger m-0 p-0" })
            </div>
        }

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success border-0 small text-start py-2.5 px-3 rounded-3 mb-3" role="alert">
                <i class="fa-solid fa-circle-check text-success me-1.5"></i>@TempData["SuccessMessage"]
            </div>

            @if (TempData["ResetLink"] != null)
            {
                <div class="card bg-light border p-3 rounded-3 mb-4 text-start">
                    <span class="small fw-bold text-secondary d-block mb-1.5"><i class="fa-solid fa-envelope-open-text text-primary me-1"></i>Reset Link (SSPR OTP Simulation):</span>
                    <a href="@TempData["ResetLink"]" class="small font-monospace text-break text-primary fw-bold">@TempData["ResetLink"]</a>
                    <hr class="my-2">
                    <span class="text-muted small" style="font-size: 0.75rem;">Copy or click the magic link above to simulate loading SSPR token recovery in testing environments.</span>
                </div>
            }
        }
        else
        {
            <form action="/Account/ForgotPassword" method="post">
                @Html.AntiForgeryToken()
                <div class="input-shell text-start">
                    <span class="input-icon"><i class="fa-solid fa-envelope"></i></span>
                    <input type="text" name="emailOrUsername" class="form-control form-control-custom" placeholder="Email Address or Username" required autofocus />
                </div>

                <button type="submit" class="btn btn-primary-custom w-100 mb-3">Send Reset link</button>
            </form>
        }

        <div class="mt-3">
            <a href="/Account/Login" class="link-back"><i class="fa-solid fa-arrow-left me-1.5"></i>Back to Sign In</a>
        </div>
    </div>

</body>
</html>

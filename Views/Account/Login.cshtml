@model ERP_System.Models.LoginViewModel

@{
    Layout = null;
    ViewData["Title"] = "Sign In - ERP Portal";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/fontawesome-free/css/all.min.css" />

    <style>
        @@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap');

        :root {
            --primary: #4f5bd5;
            --primary-dark: #3f49b8;
            --teal: #22b8a7;
            --teal-deep: #169b8d;
            --amber: #e7a638;

            --page-bg: #f7f8fb;
            --white: #ffffff;

            --text-dark: #172033;
            --text-muted: #737b8c;

            --border: #e5e8ef;
            --danger: #dc5d59;
        }

        * {
            box-sizing: border-box;
        }

        html,
        body {
            width: 100%;
            height: 100%;
            margin: 0;
            overflow: hidden;
        }

        body {
            font-family: 'Inter', sans-serif;
            background: var(--page-bg);
        }

        /* =========================================
           MAIN PAGE
        ========================================= */

        .login-shell {
            position: relative;
            display: flex;
            width: 100%;
            height: 100vh;
            min-height: 100vh;
            overflow: hidden;
            background:
                radial-gradient(
                    circle at 15% 10%,
                    rgba(34, 184, 167, 0.06),
                    transparent 30%
                ),
                radial-gradient(
                    circle at 85% 10%,
                    rgba(79, 91, 213, 0.06),
                    transparent 30%
                ),
                #f8f9fc;
        }

        /* =========================================
           LEFT OPERATIONS PANEL
        ========================================= */

        .operations-panel {
            position: relative;
            width: 55%;
            height: 100vh;
            overflow: hidden;

            padding: 2.8rem 4.5rem 2rem;

            display: flex;
            flex-direction: column;

            background:
                linear-gradient(
                    135deg,
                    #ffffff 0%,
                    #f8fafc 100%
                );

            border-right: 1px solid var(--border);
        }

        /* =========================================
           BACKGROUND GRID
        ========================================= */

        .operations-grid {
            position: absolute;
            inset: 0;
            pointer-events: none;

            background-image:
                linear-gradient(
                    rgba(35, 45, 65, 0.055) 1px,
                    transparent 1px
                ),
                linear-gradient(
                    90deg,
                    rgba(35, 45, 65, 0.055) 1px,
                    transparent 1px
                );

            background-size: 48px 48px;

            opacity: 0.9;

            -webkit-mask-image:
                linear-gradient(
                    to bottom,
                    rgba(0,0,0,0.85),
                    rgba(0,0,0,0.45),
                    transparent
                );

            mask-image:
                linear-gradient(
                    to bottom,
                    rgba(0,0,0,0.85),
                    rgba(0,0,0,0.45),
                    transparent
                );
        }

        /* =========================================
           SOFT BACKGROUND GLOW
        ========================================= */

        .soft-glow {
            position: absolute;

            width: 560px;
            height: 560px;

            top: -280px;
            left: -230px;

            border-radius: 50%;
            pointer-events: none;

            background:
                radial-gradient(
                    circle,
                    rgba(34, 184, 167, 0.13),
                    rgba(34, 184, 167, 0.045),
                    transparent 70%
                );

            animation: softGlowMove 14s ease-in-out infinite;
        }

        .operations-panel > *:not(.operations-grid):not(.soft-glow) {
            position: relative;
            z-index: 2;
        }

        /* =========================================
           BRAND
        ========================================= */

        .brand {
            display: inline-flex;
            align-items: center;
            gap: 0.75rem;

            width: fit-content;

            font-family: 'Space Grotesk', sans-serif;
            font-size: 1.22rem;
            font-weight: 700;

            color: var(--text-dark);

            opacity: 0;

            animation:
                brandEnter 0.7s cubic-bezier(0.16, 1, 0.3, 1) forwards;
        }

        .brand-icon {
            width: 40px;
            height: 40px;

            display: flex;
            align-items: center;
            justify-content: center;

            border-radius: 12px;

            color: var(--primary);

            background:
                linear-gradient(
                    135deg,
                    rgba(79, 91, 213, 0.12),
                    rgba(34, 184, 167, 0.10)
                );

            border:
                1px solid rgba(79, 91, 213, 0.12);

            transition:
                transform 0.3s ease,
                box-shadow 0.3s ease;
        }

        .brand:hover .brand-icon {
            transform:
                rotate(-6deg)
                translateY(-2px)
                scale(1.05);

            box-shadow:
                0 8px 18px rgba(79, 91, 213, 0.12);
        }

        .brand-accent {
            color: var(--primary);
        }

        /* =========================================
           MAIN LEFT CONTENT
        ========================================= */

        .operations-content {
            width: 100%;
            max-width: 670px;

            margin-top: clamp(4rem, 7vh, 7rem);
        }

        .security-badge {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;

            padding: 0.58rem 0.95rem;
            margin-bottom: 1.45rem;

            border-radius: 10px;

            color: var(--teal-deep);

            background:
                rgba(34, 184, 167, 0.09);

            border:
                1px solid rgba(34, 184, 167, 0.18);

            font-size: 0.72rem;
            font-weight: 700;
            letter-spacing: 0.08em;
            text-transform: uppercase;

            opacity: 0;

            animation:
                contentReveal 0.7s ease forwards;

            animation-delay: 0.12s;
        }

        .security-badge i {
            animation:
                badgeShield 4s ease-in-out infinite;
        }

        .operations-content h1 {
            margin: 0;

            color: var(--text-dark);

            font-family: 'Space Grotesk', sans-serif;

            font-size: clamp(2.6rem, 4vw, 4.4rem);
            line-height: 1.08;

            letter-spacing: -0.045em;
            font-weight: 600;

            opacity: 0;

            animation:
                contentReveal 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;

            animation-delay: 0.2s;
        }

        .gradient-text {
            background:
                linear-gradient(
                    100deg,
                    var(--primary),
                    var(--teal),
                    var(--amber)
                );

            -webkit-background-clip: text;
            background-clip: text;

            -webkit-text-fill-color: transparent;
        }

        .operations-description {
            max-width: 590px;

            margin: 1.45rem 0 0;

            color: var(--text-muted);

            font-size: 0.98rem;
            line-height: 1.8;

            opacity: 0;

            animation:
                contentReveal 0.75s ease forwards;

            animation-delay: 0.32s;
        }

        /* =========================================
           LIVE SYSTEM STATUS
        ========================================= */

        .system-status {
            display: inline-flex;
            align-items: center;
            gap: 0.7rem;

            margin-top: 1.75rem;

            color: #667084;

            font-size: 0.83rem;

            opacity: 0;

            animation:
                contentReveal 0.7s ease forwards;

            animation-delay: 0.42s;
        }

        .live-dot {
            width: 8px;
            height: 8px;

            border-radius: 50%;

            background: var(--teal);

            box-shadow:
                0 0 0 0 rgba(34, 184, 167, 0.45);

            animation:
                livePulse 2.2s ease-out infinite;
        }

        /* =========================================
           LIVE OPERATIONS GRAPH
        ========================================= */

        .live-graph {
            position: relative;

            width: 100%;
            max-width: 700px;

            height: clamp(170px, 24vh, 240px);

            margin-top: 1.15rem;

            overflow: hidden;

            opacity: 0;

            animation:
                graphReveal 0.9s cubic-bezier(0.16, 1, 0.3, 1) forwards;

            animation-delay: 0.52s;
        }

        /* Grid inside graph */

        .graph-grid {
            position: absolute;
            inset: 15px 0 28px;

            background-image:
                linear-gradient(
                    rgba(79, 91, 213, 0.055) 1px,
                    transparent 1px
                ),
                linear-gradient(
                    90deg,
                    rgba(79, 91, 213, 0.05) 1px,
                    transparent 1px
                );

            background-size:
                100% 38px,
                72px 100%;

            border-bottom:
                1px solid rgba(30, 40, 60, 0.10);

            pointer-events: none;
        }

        /*
           GRAPH TRACK

           Two identical SVG graphs are placed side by side.

           Because both graphs have the SAME start and end level,
           movement from -50% to 0% becomes visually seamless.
        */

        .graph-track {
            position: absolute;
            inset: 0;

            display: flex;

            width: 200%;
            height: 100%;

            will-change: transform;

            animation:
                graphFlow 12s linear infinite;
        }

        .graph-svg {
            flex: 0 0 50%;

            width: 50%;
            height: 100%;

            overflow: visible;
        }

        /*
           GENTLE VERTICAL BREATHING

           This makes the entire mountain graph
           naturally move up and down.
        */

        .graph-wave {
            transform-box: fill-box;
            transform-origin: center;

            animation:
                graphBreathing 4.8s ease-in-out infinite;
        }

        .graph-fill {
            opacity: 0.75;
        }

        .graph-line-shadow {
            fill: none;

            stroke:
                rgba(34, 184, 167, 0.16);

            stroke-width: 11;

            stroke-linecap: round;
            stroke-linejoin: round;

            filter:
                blur(6px);
        }

        .graph-line {
            fill: none;

            stroke-width: 4;

            stroke-linecap: round;
            stroke-linejoin: round;

            filter:
                drop-shadow(
                    0 5px 7px rgba(34, 184, 167, 0.18)
                );
        }

        /*
           Flowing highlight dash
        */

        .graph-flow-line {
            fill: none;

            stroke:
                rgba(255, 255, 255, 0.92);

            stroke-width: 2.2;

            stroke-linecap: round;

            stroke-dasharray:
                10 26;

            opacity: 0.75;

            animation:
                lineEnergy 2.8s linear infinite;
        }

        /* =========================================
           DATA POINTS
        ========================================= */

        .data-point {
            fill: #ffffff;

            stroke: var(--teal);

            stroke-width: 4;

            filter:
                drop-shadow(
                    0 0 7px rgba(34, 184, 167, 0.42)
                );

            animation:
                dataPointPulse 2.5s ease-in-out infinite;
        }

        .data-point.amber {
            stroke: var(--amber);

            animation-delay: 0.5s;
        }

        .data-point.blue {
            stroke: var(--primary);

            animation-delay: 1s;
        }

        /* =========================================
           GRAPH LABEL
        ========================================= */

        .graph-label {
            position: absolute;

            top: 8px;
            left: 0;

            display: inline-flex;
            align-items: center;
            gap: 0.48rem;

            padding: 0.48rem 0.72rem;

            border-radius: 9px;

            background:
                rgba(255, 255, 255, 0.82);

            border:
                1px solid rgba(229, 232, 239, 0.95);

            color: var(--text-muted);

            font-size: 0.7rem;
            font-weight: 700;
            letter-spacing: 0.05em;
            text-transform: uppercase;

            box-shadow:
                0 6px 18px rgba(30, 40, 60, 0.05);

            backdrop-filter:
                blur(12px);

            z-index: 3;
        }

        .graph-label i {
            color: var(--teal);

            animation:
                chartIconPulse 2.8s ease-in-out infinite;
        }

        /* =========================================
           FOOTER
        ========================================= */

        .operations-footer {
            margin-top: auto;
            padding-top: 1rem;

            opacity: 0;

            animation:
                footerReveal 0.8s ease forwards;

            animation-delay: 0.7s;
        }

        .footer-line {
            width: 100%;
            height: 1px;

            margin-bottom: 1rem;

            background:
                linear-gradient(
                    90deg,
                    var(--border),
                    transparent
                );
        }

        .footer-text {
            margin: 0;

            color: #9aa1ae;

            font-size: 0.72rem;
        }

        /* =========================================
           RIGHT LOGIN PANEL
        ========================================= */

        .login-panel {
            position: relative;

            width: 45%;
            height: 100vh;

            display: flex;
            justify-content: center;
            align-items: flex-start;

            /*
               Form is intentionally higher.
            */

            padding:
                clamp(4.5rem, 9vh, 7.5rem)
                4rem
                2rem;

            overflow: hidden;

            background:
                linear-gradient(
                    135deg,
                    #fbfcfe 0%,
                    #f4f6fa 100%
                );
        }

        .login-panel::before {
            content: "";

            position: absolute;

            width: 460px;
            height: 460px;

            top: -230px;
            right: -220px;

            border-radius: 50%;

            background:
                radial-gradient(
                    circle,
                    rgba(79, 91, 213, 0.08),
                    transparent 70%
                );

            animation:
                rightGlowMove 14s ease-in-out infinite;

            pointer-events: none;
        }

        .login-panel::after {
            content: "";

            position: absolute;

            width: 240px;
            height: 240px;

            right: -100px;
            bottom: -100px;

            border-radius: 50%;

            background:
                radial-gradient(
                    circle,
                    rgba(34, 184, 167, 0.07),
                    transparent 70%
                );

            pointer-events: none;
        }

        /* =========================================
           LOGIN CARD
        ========================================= */

        .login-card {
            position: relative;
            z-index: 2;

            width: 100%;
            max-width: 430px;

            opacity: 0;

            animation:
                loginCardEnter
                0.9s
                cubic-bezier(0.16, 1, 0.3, 1)
                forwards;

            animation-delay: 0.16s;
        }

        .login-eyebrow {
            margin-bottom: 0.7rem;

            color: var(--amber);

            font-size: 0.72rem;
            font-weight: 700;

            letter-spacing: 0.12em;
            text-transform: uppercase;
        }

        .login-card h2 {
            margin: 0;

            color: var(--text-dark);

            font-family:
                'Space Grotesk',
                sans-serif;

            font-size: 2.1rem;
            font-weight: 600;

            letter-spacing: -0.04em;
        }

        .login-subtitle {
            margin: 0.7rem 0 2rem;

            color: var(--text-muted);

            font-size: 0.9rem;
            line-height: 1.6;
        }

        /* =========================================
           FORM
        ========================================= */

        .field-block {
            margin-bottom: 1.2rem;
        }

        .field-label-row {
            display: flex;
            align-items: center;
            justify-content: space-between;

            margin-bottom: 0.5rem;
        }

        .form-label-custom {
            margin: 0;

            color: #454d5c;

            font-size: 0.73rem;
            font-weight: 700;

            letter-spacing: 0.05em;
            text-transform: uppercase;
        }

        .forgot-link {
            color: #717988;

            font-size: 0.76rem;
            font-weight: 600;

            text-decoration: none;

            transition:
                color 0.25s ease;
        }

        .forgot-link:hover {
            color: var(--primary);
        }

        .input-shell {
            display: flex;
            align-items: center;

            min-height: 54px;

            overflow: hidden;

            border:
                1px solid var(--border);

            border-radius: 12px;

            background:
                rgba(255, 255, 255, 0.82);

            transition:
                border-color 0.25s ease,
                box-shadow 0.25s ease,
                transform 0.25s ease,
                background 0.25s ease;
        }

        .input-shell:hover {
            border-color: #d6dbe5;
        }

        .input-shell:focus-within {
            transform:
                translateY(-2px);

            background:
                var(--white);

            border-color:
                var(--primary);

            box-shadow:
                0 0 0 4px rgba(79, 91, 213, 0.08),
                0 8px 18px rgba(30, 40, 60, 0.05);
        }

        .input-icon {
            width: 52px;

            display: flex;
            align-items: center;
            justify-content: center;

            color: #9098a6;

            transition:
                color 0.25s ease,
                transform 0.25s ease;
        }

        .input-shell:focus-within .input-icon {
            color: var(--primary);

            transform:
                scale(1.1);
        }

        .form-control-custom {
            flex: 1;

            height: 52px;

            padding:
                0.7rem
                0.85rem
                0.7rem
                0 !important;

            border: none !important;
            outline: none !important;

            background: transparent !important;

            box-shadow: none !important;

            color: var(--text-dark) !important;

            font-size: 0.9rem !important;
        }

        .form-control-custom::placeholder {
            color: #afb5c0;
        }

        .password-toggle {
            width: 48px;
            height: 48px;

            border: none;

            background: transparent;

            color: #949ba8;

            cursor: pointer;

            transition:
                color 0.25s ease,
                transform 0.2s ease;
        }

        .password-toggle:hover {
            color: var(--primary);

            transform: scale(1.08);
        }

        .password-toggle:active {
            transform: scale(0.95);
        }

        /* =========================================
           REMEMBER ME
        ========================================= */

        .remember-row {
            display: flex;
            align-items: center;
            gap: 0.65rem;

            margin: 1.35rem 0 1.55rem;
        }

        .remember-row input {
            width: 17px;
            height: 17px;

            margin: 0;

            cursor: pointer;

            accent-color: var(--primary);
        }

        .remember-row label {
            margin: 0;

            color: var(--text-muted);

            font-size: 0.82rem;

            cursor: pointer;
        }

        /* =========================================
           LOGIN BUTTON
        ========================================= */

        .login-button {
            position: relative;

            width: 100%;

            padding: 0.92rem 1.25rem;

            overflow: hidden;

            border: none;
            border-radius: 12px;

            color: var(--white);

            background:
                linear-gradient(
                    135deg,
                    var(--primary),
                    #6976e8
                );

            box-shadow:
                0 14px 28px rgba(79, 91, 213, 0.22);

            font-size: 0.92rem;
            font-weight: 700;

            cursor: pointer;

            transition:
                transform 0.22s ease,
                box-shadow 0.22s ease,
                background 0.22s ease;
        }

        .login-button::before {
            content: "";

            position: absolute;

            top: 0;
            left: -140%;

            width: 65%;
            height: 100%;

            background:
                linear-gradient(
                    100deg,
                    transparent,
                    rgba(255, 255, 255, 0.25),
                    transparent
                );

            transform:
                skewX(-22deg);

            transition:
                left 0.7s ease;
        }

        .login-button:hover {
            transform: translateY(-2px);

            box-shadow:
                0 18px 34px rgba(79, 91, 213, 0.28);
        }

        .login-button:hover::before {
            left: 150%;
        }

        .login-button:active {
            transform:
                translateY(0)
                scale(0.99);
        }

        /* =========================================
           BACK HOME
        ========================================= */

        .back-home {
            display: inline-flex;
            align-items: center;
            gap: 0.55rem;

            margin-top: 1.5rem;

            color: #78808e;

            text-decoration: none;

            font-size: 0.82rem;

            transition:
                color 0.25s ease;
        }

        .back-home i {
            transition:
                transform 0.25s ease;
        }

        .back-home:hover {
            color: var(--text-dark);
        }

        .back-home:hover i {
            transform:
                translateX(-4px);
        }

        .text-danger-custom {
            display: block;

            margin-top: 0.45rem;

            color: var(--danger);

            font-size: 0.78rem;
        }

        /* =========================================
           ANIMATIONS
        ========================================= */

        @@keyframes brandEnter {

            from {
                opacity: 0;
                transform:
                    translateY(-14px);
            }

            to {
                opacity: 1;
                transform:
                    translateY(0);
            }
        }

        @@keyframes contentReveal {

            from {
                opacity: 0;
                transform:
                    translateY(22px);
            }

            to {
                opacity: 1;
                transform:
                    translateY(0);
            }
        }

        @@keyframes footerReveal {

            from {
                opacity: 0;
            }

            to {
                opacity: 1;
            }
        }

        @@keyframes softGlowMove {

            0%,
            100% {
                transform:
                    translate(0, 0)
                    scale(1);
            }

            50% {
                transform:
                    translate(55px, 35px)
                    scale(1.08);
            }
        }

        @@keyframes rightGlowMove {

            0%,
            100% {
                transform:
                    translate(0, 0);
            }

            50% {
                transform:
                    translate(-45px, 40px);
            }
        }

        @@keyframes badgeShield {

            0%,
            100% {
                transform:
                    translateY(0);
            }

            50% {
                transform:
                    translateY(-2px);
            }
        }

        @@keyframes livePulse {

            0% {
                box-shadow:
                    0 0 0 0 rgba(34, 184, 167, 0.45);
            }

            70% {
                box-shadow:
                    0 0 0 10px rgba(34, 184, 167, 0);
            }

            100% {
                box-shadow:
                    0 0 0 0 rgba(34, 184, 167, 0);
            }
        }

        /*
           CONTINUOUS HORIZONTAL MOVEMENT
        */

        @@keyframes graphFlow {

            from {
                transform:
                    translateX(0);
            }

            to {
                transform:
                    translateX(-50%);
            }
        }

        /*
           SMOOTH UP AND DOWN MOVEMENT
        */

        @@keyframes graphBreathing {

            0%,
            100% {
                transform:
                    translateY(5px);
            }

            50% {
                transform:
                    translateY(-8px);
            }
        }

        /*
           Moving energy through graph line
        */

        @@keyframes lineEnergy {

            from {
                stroke-dashoffset: 0;
            }

            to {
                stroke-dashoffset: -72;
            }
        }

        @@keyframes dataPointPulse {

            0%,
            100% {
                opacity: 0.8;
            }

            50% {
                opacity: 1;
            }
        }

        @@keyframes chartIconPulse {

            0%,
            100% {
                transform:
                    translateY(0);
            }

            50% {
                transform:
                    translateY(-2px);
            }
        }

        @@keyframes graphReveal {

            from {
                opacity: 0;
                transform:
                    translateY(28px);
            }

            to {
                opacity: 1;
                transform:
                    translateY(0);
            }
        }

        @@keyframes loginCardEnter {

            from {
                opacity: 0;

                transform:
                    translateY(28px)
                    scale(0.985);
            }

            to {
                opacity: 1;

                transform:
                    translateY(0)
                    scale(1);
            }
        }

        /* =========================================
           RESPONSIVE
        ========================================= */

        @@media (max-width: 1100px) {

            .operations-panel {
                padding-left: 3rem;
                padding-right: 3rem;
            }

            .login-panel {
                padding-left: 2.5rem;
                padding-right: 2.5rem;
            }

            .operations-content h1 {
                font-size: 3.2rem;
            }
        }

        @@media (max-width: 991.98px) {

            html,
            body {
                height: auto;
                overflow-y: auto;
            }

            .login-shell {
                height: auto;
                min-height: 100vh;

                flex-direction: column;

                overflow: visible;
            }

            .operations-panel,
            .login-panel {
                width: 100%;
                height: auto;
                min-height: auto;
            }

            .operations-panel {
                padding:
                    2.5rem
                    2rem;
            }

            .operations-content {
                margin-top:
                    4rem;
            }

            .live-graph {
                height:
                    190px;
            }

            .operations-footer {
                margin-top:
                    3rem;
            }

            .login-panel {
                padding:
                    3rem
                    1.5rem;
            }
        }

        @@media (max-width: 575.98px) {

            .operations-panel {
                padding:
                    1.5rem
                    1.1rem;
            }

            .operations-content {
                margin-top:
                    3rem;
            }

            .operations-content h1 {
                font-size:
                    2.3rem;
            }

            .operations-description {
                font-size:
                    0.88rem;
            }

            .live-graph {
                height:
                    155px;
            }

            .login-panel {
                padding:
                    2.5rem
                    1.1rem;
            }

            .login-card h2 {
                font-size:
                    1.8rem;
            }
        }

        /* =========================================
           REDUCED MOTION
        ========================================= */

        @@media (prefers-reduced-motion: reduce) {

            *,
            *::before,
            *::after {

                animation-duration:
                    0.01ms !important;

                animation-iteration-count:
                    1 !important;

                transition-duration:
                    0.01ms !important;
            }
        }

    </style>
</head>

<body>

    <div class="login-shell">

        <!-- =====================================
             LEFT OPERATIONS SIDE
        ====================================== -->

        <section class="operations-panel">

            <div class="operations-grid"></div>
            <div class="soft-glow"></div>


            <!-- BRAND -->

            <div class="brand">

                <div class="brand-icon">
                    <i class="fa-solid fa-cubes"></i>
                </div>

                <span>
                    ERP<span class="brand-accent">System</span>
                </span>

            </div>


            <!-- MAIN CONTENT -->

            <div class="operations-content">

                <div class="security-badge">

                    <i class="fa-solid fa-shield-halved"></i>

                    Enterprise Security

                </div>


                <h1>

                    Every department,<br />

                    <span class="gradient-text">
                        one live system.
                    </span>

                </h1>


                <p class="operations-description">

                    Finance, HR, inventory and procurement connected in
                    real time — one secure platform for your complete
                    business operations.

                </p>


                <!-- SYSTEM STATUS -->

                <div class="system-status">

                    <span class="live-dot"></span>

                    <span>
                        All systems operational
                    </span>

                </div>


                <!-- LIVE OPERATIONS GRAPH -->

                <div class="live-graph">

                    <div class="graph-grid"></div>


                    <div class="graph-label">

                        <i class="fa-solid fa-chart-line"></i>

                        Live Operations

                    </div>


                    <div class="graph-track">


                        <!-- =====================================
                             FIRST GRAPH
                        ====================================== -->

                        <svg class="graph-svg"
                             viewBox="0 0 700 220"
                             preserveAspectRatio="none"
                             aria-hidden="true">

                            <defs>

                                <linearGradient id="graphLineOne"
                                                x1="0"
                                                y1="0"
                                                x2="1"
                                                y2="0">

                                    <stop offset="0%"
                                          stop-color="#4f5bd5" />

                                    <stop offset="50%"
                                          stop-color="#22b8a7" />

                                    <stop offset="100%"
                                          stop-color="#e7a638" />

                                </linearGradient>


                                <linearGradient id="graphFillOne"
                                                x1="0"
                                                y1="0"
                                                x2="0"
                                                y2="1">

                                    <stop offset="0%"
                                          stop-color="#22b8a7"
                                          stop-opacity="0.22" />

                                    <stop offset="100%"
                                          stop-color="#22b8a7"
                                          stop-opacity="0" />

                                </linearGradient>

                            </defs>


                            <g class="graph-wave">


                                <!-- FILL -->

                                <path class="graph-fill"
                                      fill="url(#graphFillOne)"
                                      d="
                                      M0 150
                                      C35 132, 70 92, 105 118
                                      S170 185, 215 125
                                      S275 45, 325 92
                                      S390 178, 440 122
                                      S505 55, 550 95
                                      S625 175, 700 150
                                      L700 220
                                      L0 220
                                      Z" />


                                <!-- GLOW SHADOW -->

                                <path class="graph-line-shadow"
                                      d="
                                      M0 150
                                      C35 132, 70 92, 105 118
                                      S170 185, 215 125
                                      S275 45, 325 92
                                      S390 178, 440 122
                                      S505 55, 550 95
                                      S625 175, 700 150" />


                                <!-- MAIN LINE -->

                                <path class="graph-line"
                                      stroke="url(#graphLineOne)"
                                      d="
                                      M0 150
                                      C35 132, 70 92, 105 118
                                      S170 185, 215 125
                                      S275 45, 325 92
                                      S390 178, 440 122
                                      S505 55, 550 95
                                      S625 175, 700 150" />


                                <!-- FLOWING ENERGY -->

                                <path class="graph-flow-line"
                                      d="
                                      M0 150
                                      C35 132, 70 92, 105 118
                                      S170 185, 215 125
                                      S275 45, 325 92
                                      S390 178, 440 122
                                      S505 55, 550 95
                                      S625 175, 700 150" />


                                <!-- DATA POINTS -->

                                <circle class="data-point blue"
                                        cx="105"
                                        cy="118"
                                        r="5" />

                                <circle class="data-point amber"
                                        cx="325"
                                        cy="92"
                                        r="5" />

                                <circle class="data-point"
                                        cx="550"
                                        cy="95"
                                        r="5" />

                            </g>

                        </svg>


                        <!-- =====================================
                             SECOND GRAPH
                             IDENTICAL COPY FOR SEAMLESS LOOP
                        ====================================== -->

                        <svg class="graph-svg"
                             viewBox="0 0 700 220"
                             preserveAspectRatio="none"
                             aria-hidden="true">

                            <defs>

                                <linearGradient id="graphLineTwo"
                                                x1="0"
                                                y1="0"
                                                x2="1"
                                                y2="0">

                                    <stop offset="0%"
                                          stop-color="#4f5bd5" />

                                    <stop offset="50%"
                                          stop-color="#22b8a7" />

                                    <stop offset="100%"
                                          stop-color="#e7a638" />

                                </linearGradient>


                                <linearGradient id="graphFillTwo"
                                                x1="0"
                                                y1="0"
                                                x2="0"
                                                y2="1">

                                    <stop offset="0%"
                                          stop-color="#22b8a7"
                                          stop-opacity="0.22" />

                                    <stop offset="100%"
                                          stop-color="#22b8a7"
                                          stop-opacity="0" />

                                </linearGradient>

                            </defs>


                            <g class="graph-wave">


                                <!-- FILL -->

                                <path class="graph-fill"
                                      fill="url(#graphFillTwo)"
                                      d="
                                      M0 150
                                      C35 132, 70 92, 105 118
                                      S170 185, 215 125
                                      S275 45, 325 92
                                      S390 178, 440 122
                                      S505 55, 550 95
                                      S625 175, 700 150
                                      L700 220
                                      L0 220
                                      Z" />


                                <!-- GLOW -->

                                <path class="graph-line-shadow"
                                      d="
                                      M0 150
                                      C35 132, 70 92, 105 118
                                      S170 185, 215 125
                                      S275 45, 325 92
                                      S390 178, 440 122
                                      S505 55, 550 95
                                      S625 175, 700 150" />


                                <!-- MAIN LINE -->

                                <path class="graph-line"
                                      stroke="url(#graphLineTwo)"
                                      d="
                                      M0 150
                                      C35 132, 70 92, 105 118
                                      S170 185, 215 125
                                      S275 45, 325 92
                                      S390 178, 440 122
                                      S505 55, 550 95
                                      S625 175, 700 150" />


                                <!-- FLOWING ENERGY -->

                                <path class="graph-flow-line"
                                      d="
                                      M0 150
                                      C35 132, 70 92, 105 118
                                      S170 185, 215 125
                                      S275 45, 325 92
                                      S390 178, 440 122
                                      S505 55, 550 95
                                      S625 175, 700 150" />


                                <!-- DATA POINTS -->

                                <circle class="data-point blue"
                                        cx="105"
                                        cy="118"
                                        r="5" />

                                <circle class="data-point amber"
                                        cx="325"
                                        cy="92"
                                        r="5" />

                                <circle class="data-point"
                                        cx="550"
                                        cy="95"
                                        r="5" />

                            </g>

                        </svg>

                    </div>

                </div>

            </div>


            <!-- FOOTER -->

            <div class="operations-footer">

                <div class="footer-line"></div>

                <p class="footer-text">

                    &copy; @DateTime.Now.Year ERP System
                    · Internal Operations Platform

                </p>

            </div>

        </section>


        <!-- =====================================
             RIGHT LOGIN SIDE
        ====================================== -->

        <section class="login-panel">

            <div class="login-card">


                <p class="login-eyebrow">
                    Secure Access
                </p>


                <h2>
                    Sign in
                </h2>


                <p class="login-subtitle">

                    Enter your credentials to access your
                    enterprise operations dashboard.

                </p>


                <form asp-action="Login" method="post">

                    @Html.AntiForgeryToken()


                    <div asp-validation-summary="ModelOnly"
                         class="text-danger-custom mb-3">
                    </div>


                    <!-- EMAIL -->

                    <div class="field-block">

                        <div class="field-label-row">

                            <label asp-for="Email"
                                   class="form-label-custom">

                                Email Address

                            </label>

                        </div>


                        <div class="input-shell">

                            <span class="input-icon">

                                <i class="fa-regular fa-envelope"></i>

                            </span>


                            <input asp-for="Email"
                                   class="form-control form-control-custom"
                                   placeholder="name@company.com"
                                   autocomplete="username" />

                        </div>


                        <span asp-validation-for="Email"
                              class="text-danger-custom">
                        </span>

                    </div>


                    <!-- PASSWORD -->

                    <div class="field-block">

                        <div class="field-label-row">

                            <label asp-for="Password"
                                   class="form-label-custom">

                                Password

                            </label>


                            <a href="#"
                               class="forgot-link">

                                Forgot?

                            </a>

                        </div>


                        <div class="input-shell">

                            <span class="input-icon">

                                <i class="fa-solid fa-lock"></i>

                            </span>


                            <input asp-for="Password"
                                   id="passwordInput"
                                   type="password"
                                   class="form-control form-control-custom"
                                   placeholder="••••••••"
                                   autocomplete="current-password" />


                            <button type="button"
                                    class="password-toggle"
                                    id="passwordToggle"
                                    aria-label="Show password">

                                <i class="fa-regular fa-eye"></i>

                            </button>

                        </div>


                        <span asp-validation-for="Password"
                              class="text-danger-custom">
                        </span>

                    </div>


                    <!-- REMEMBER -->

                    <div class="remember-row">

                        <input asp-for="RememberMe"
                               type="checkbox"
                               id="rememberMe" />


                        <label asp-for="RememberMe"
                               for="rememberMe">

                            Remember this device

                        </label>

                    </div>


                    <!-- LOGIN BUTTON -->

                    <button type="submit"
                            class="login-button">

                        <i class="fa-solid fa-shield-halved me-2"></i>

                        Authenticate Session

                    </button>

                </form>


                <!-- BACK HOME -->

                <a href="/"
                   class="back-home">

                    <i class="fa-solid fa-arrow-left"></i>

                    Back to Homepage

                </a>

            </div>

        </section>

    </div>


    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>


    <script>

        document.addEventListener("DOMContentLoaded", function () {

            const passwordInput =
                document.getElementById("passwordInput");

            const passwordToggle =
                document.getElementById("passwordToggle");


            if (passwordInput && passwordToggle) {

                passwordToggle.addEventListener(
                    "click",
                    function () {

                        const icon =
                            this.querySelector("i");


                        if (passwordInput.type === "password") {

                            passwordInput.type = "text";

                            icon.classList.remove("fa-eye");
                            icon.classList.add("fa-eye-slash");

                            this.setAttribute(
                                "aria-label",
                                "Hide password"
                            );

                        }
                        else {

                            passwordInput.type = "password";

                            icon.classList.remove("fa-eye-slash");
                            icon.classList.add("fa-eye");

                            this.setAttribute(
                                "aria-label",
                                "Show password"
                            );

                        }

                    }
                );

            }

        });

    </script>

</body>
</html>
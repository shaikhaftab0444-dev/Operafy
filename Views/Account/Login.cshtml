@model ERP_System.Models.LoginViewModel
@{
    Layout = null; // Independent clean layout
    ViewData["Title"] = "Sign In - ERP Portal";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/fontawesome-free/css/all.min.css" />
    <style>
        @@import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap');

        :root {
            --warm-bg: #faf8f5;
            --card-bg: #ffffff;
            --text-main: #2d251e;
            --text-sub: #7c7267;
            --border-warm: #e6dfd5;
            --primary-warm: #4f46e5;
            --primary-hover: #4338ca;
            --accent-warm: #d97706;
        }

        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background-color: var(--warm-bg);
            height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0;
            overflow: hidden;
            position: relative;
        }

        /* Soft warm blurs in background */
        .ambient-glow-1 {
            position: absolute;
            width: 500px;
            height: 500px;
            border-radius: 50%;
            background: radial-gradient(circle, rgba(217, 119, 6, 0.05) 0%, rgba(255,255,255,0) 70%);
            top: -100px;
            left: -100px;
            z-index: 1;
            pointer-events: none;
        }
        .ambient-glow-2 {
            position: absolute;
            width: 600px;
            height: 600px;
            border-radius: 50%;
            background: radial-gradient(circle, rgba(79, 70, 229, 0.04) 0%, rgba(255,255,255,0) 70%);
            bottom: -150px;
            right: -100px;
            z-index: 1;
            pointer-events: none;
        }

        .login-wrapper {
            position: relative;
            z-index: 10;
            width: 100%;
            padding: 1.5rem;
            display: flex;
            justify-content: center;
        }

        .login-card {
            width: 100%;
            max-width: 440px;
            background-color: var(--card-bg);
            border: 1px solid var(--border-warm);
            border-radius: 16px;
            box-shadow: 0 20px 40px rgba(45, 37, 30, 0.04), 0 1px 3px rgba(45, 37, 30, 0.02);
            padding: 3rem 2.5rem;
            transition: all 0.3s ease;
        }

        .auth-logo {
            font-size: 1.8rem;
            font-weight: 800;
            color: var(--text-main);
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 1.5rem;
        }
        .auth-logo i {
            color: var(--primary-warm);
        }

        .form-label-warm {
            font-size: 0.8rem;
            font-weight: 700;
            color: var(--text-main);
            margin-bottom: 6px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .input-group-warm {
            border: 1px solid #d4cbbd;
            border-radius: 8px;
            background-color: #fcfbf9;
            transition: all 0.2s ease-in-out;
            overflow: hidden;
            display: flex;
            align-items: center;
            width: 100%;
        }
        .input-group-warm:focus-within {
            border-color: var(--primary-warm);
            box-shadow: 0 0 0 4px rgba(79, 70, 229, 0.08);
            background-color: #ffffff;
        }

        .input-icon-warm {
            padding: 0.75rem 0.25rem 0.75rem 1rem;
            color: var(--text-sub);
            font-size: 0.95rem;
            display: flex;
            align-items: center;
        }

        .form-control-warm {
            border: none !important;
            box-shadow: none !important;
            background: transparent !important;
            color: var(--text-main) !important;
            font-size: 0.9rem !important;
            padding: 0.75rem 1rem !important;
            width: 100%;
        }
        .form-control-warm::placeholder {
            color: #a3988b;
        }

        .btn-warm-primary {
            background: linear-gradient(135deg, var(--primary-warm) 0%, #6366f1 100%);
            color: #ffffff;
            border: none;
            padding: 0.75rem 1.5rem;
            border-radius: 8px;
            font-weight: 600;
            font-size: 0.95rem;
            box-shadow: 0 4px 14px rgba(79, 70, 229, 0.25);
            transition: all 0.2s ease;
        }
        .btn-warm-primary:hover {
            transform: translateY(-1px);
            box-shadow: 0 6px 18px rgba(79, 70, 229, 0.35);
            color: #ffffff;
        }

        .credentials-notice {
            background-color: #faf6f0;
            border: 1px dashed #e6dfd5;
            border-radius: 8px;
            padding: 1rem;
            margin-top: 1.5rem;
            margin-bottom: 1.5rem;
            text-align: left;
        }

        .text-danger-custom {
            color: #dc2626;
            font-size: 0.8rem;
            margin-top: 4px;
            font-weight: 500;
        }

        .back-to-home {
            color: var(--text-sub);
            text-decoration: none;
            font-size: 0.85rem;
            font-weight: 500;
            display: inline-flex;
            align-items: center;
            gap: 6px;
            margin-top: 1.5rem;
            transition: color 0.2s;
        }
        .back-to-home:hover {
            color: var(--primary-warm);
        }
    </style>
</head>

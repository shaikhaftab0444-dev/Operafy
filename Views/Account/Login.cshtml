@model ERP_System.Models.LoginViewModel
@{
    Layout = null; // Independent clean layout
    ViewData["Title"] = "Sign In - ERP Portal";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/fontawesome-free/css/all.min.css" />
    <style>
        @@import url('https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600;700&display=swap');

        :root {
            --ink: #0d1424;
            --ink-soft: #16203a;
            --ink-line: rgba(238, 241, 246, 0.08);
            --paper: #fbfaf7;
            --card: #ffffff;
            --text-onink: #eef1f6;
            --sub-onink: #8f9ebb;
            --text-main: #171310;
            --sub-onpaper: #837a6d;
            --border-paper: #e8e2d6;
            --amber: #f5a623;
            --teal: #2dd4bf;
            --danger: #e0524a;
        }

        * {
            box-sizing: border-box;
        }

        html, body {
            height: 100%;
        }

        body {
            margin: 0;
            font-family: 'Inter', sans-serif;
            background: var(--paper);
            overflow: hidden;
        }

        .split-shell {
            display: flex;
            min-height: 100vh;
        }

        /* ============ LEFT: OPERATIONS PANEL ============ */
        .ops-panel {
            position: relative;
            flex: 1 1 54%;
            background: var(--ink);
            color: var(--text-onink);
            padding: 3.5rem 3.5rem 3rem;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            overflow: hidden;
        }

        .ops-grid {
            position: absolute;
            inset: 0;
            background-image: linear-gradient(var(--ink-line) 1px, transparent 1px), linear-gradient(90deg, var(--ink-line) 1px, transparent 1px);
            background-size: 42px 42px;
            mask-image: radial-gradient(circle at 30% 30%, black 0%, transparent 75%);
            opacity: 0.9;
        }

        .ops-glow {
            position: absolute;
            width: 480px;
            height: 480px;
            border-radius: 50%;
            background: radial-gradient(circle, rgba(45, 212, 191, 0.16) 0%, rgba(13,20,36,0) 70%);
            top: -120px;
            left: -80px;
            animation: glow-drift 14s ease-in-out infinite;
            pointer-events: none;
        }

        @@keyframes glow-drift {
            0%, 100% {
                transform: translate(0,0) scale(1);
            }

            50% {
                transform: translate(40px, 30px) scale(1.1);
            }
        }

        .ops-brand {
            position: relative;
            z-index: 2;
            display: flex;
            align-items: center;
            gap: 10px;
            font-family: 'Space Grotesk', sans-serif;
            font-weight: 700;
            font-size: 1.15rem;
            letter-spacing: 0.02em;
            opacity: 0;
            animation: rise-in 0.6s ease forwards;
            animation-delay: 0.1s;
        }

            .ops-brand i {
                color: var(--teal);
            }

        .ops-headline {
            position: relative;
            z-index: 2;
            margin: 2.5rem 0 0;
        }

            .ops-headline h1 {
                font-family: 'Space Grotesk', sans-serif;
                font-weight: 600;
                font-size: 2.5rem;
                line-height: 1.15;
                margin: 0 0 1rem;
                max-width: 480px;
                opacity: 0;
                animation: rise-in 0.65s ease forwards;
                animation-delay: 0.22s;
            }

            .ops-headline p {
                color: var(--sub-onink);
                font-size: 0.95rem;
                max-width: 380px;
                line-height: 1.6;
                margin: 0;
                opacity: 0;
                animation: rise-in 0.65s ease forwards;
                animation-delay: 0.32s;
            }

        @@keyframes rise-in {
            from {
                opacity: 0;
                transform: translateY(14px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        /* Status readout */
        .status-row {
            position: relative;
            z-index: 2;
            display: flex;
            align-items: center;
            gap: 10px;
            margin-top: 2.2rem;
            font-size: 0.82rem;
            color: var(--sub-onink);
            opacity: 0;
            animation: rise-in 0.6s ease forwards;
            animation-delay: 0.42s;
        }

        .status-dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: var(--teal);
            box-shadow: 0 0 0 0 rgba(45, 212, 191, 0.6);
            animation: pulse-dot 2.2s ease-out infinite;
        }

        @@keyframes pulse-dot {
            0% {
                box-shadow: 0 0 0 0 rgba(45, 212, 191, 0.55);
            }

            70% {
                box-shadow: 0 0 0 8px rgba(45, 212, 191, 0);
            }

            100% {
                box-shadow: 0 0 0 0 rgba(45, 212, 191, 0);
            }
        }

        /* Mini bar chart */
        .ops-chart {
            position: relative;
            z-index: 2;
            display: flex;
            align-items: flex-end;
            gap: 7px;
            height: 64px;
            margin-top: 1.6rem;
            opacity: 0;
            animation: rise-in 0.6s ease forwards;
            animation-delay: 0.5s;
        }

            .ops-chart .bar {
                width: 9px;
                border-radius: 3px 3px 0 0;
                background: linear-gradient(180deg, var(--teal) 0%, rgba(45,212,191,0.35) 100%);
                transform-origin: bottom;
                animation: bar-breathe 3.6s ease-in-out infinite;
            }

                .ops-chart .bar:nth-child(1) {
                    height: 28px;
                    animation-delay: 0s;
                }

                .ops-chart .bar:nth-child(2) {
                    height: 46px;
                    animation-delay: 0.2s;
                }

                .ops-chart .bar:nth-child(3) {
                    height: 34px;
                    animation-delay: 0.4s;
                }

                .ops-chart .bar:nth-child(4) {
                    height: 58px;
                    animation-delay: 0.6s;
                    background: linear-gradient(180deg, var(--amber) 0%, rgba(245,166,35,0.3) 100%);
                }

                .ops-chart .bar:nth-child(5) {
                    height: 40px;
                    animation-delay: 0.8s;
                }

                .ops-chart .bar:nth-child(6) {
                    height: 50px;
                    animation-delay: 1s;
                }

                .ops-chart .bar:nth-child(7) {
                    height: 30px;
                    animation-delay: 1.2s;
                }

        @@keyframes bar-breathe {
            0%, 100% {
                transform: scaleY(1);
            }

            50% {
                transform: scaleY(1.18);
            }
        }

        /* Module ticker */
        .ops-ticker {
            position: relative;
            z-index: 2;
            margin-top: 2.4rem;
            overflow: hidden;
            -webkit-mask-image: linear-gradient(90deg, transparent, black 8%, black 92%, transparent);
            mask-image: linear-gradient(90deg, transparent, black 8%, black 92%, transparent);
            opacity: 0;
            animation: rise-in 0.6s ease forwards;
            animation-delay: 0.6s;
        }

        .ticker-track {
            display: flex;
            gap: 10px;
            width: max-content;
            animation: ticker-scroll 22s linear infinite;
        }

        .ticker-chip {
            border: 1px solid var(--ink-line);
            border-radius: 999px;
            padding: 0.35rem 0.9rem;
            font-size: 0.75rem;
            color: var(--sub-onink);
            white-space: nowrap;
        }

        @@keyframes ticker-scroll {
            from {
                transform: translateX(0);
            }

            to {
                transform: translateX(-50%);
            }
        }

        .ops-footnote {
            position: relative;
            z-index: 2;
            font-size: 0.75rem;
            color: var(--sub-onink);
            opacity: 0;
            animation: rise-in 0.6s ease forwards;
            animation-delay: 0.7s;
        }

        /* ============ RIGHT: FORM PANEL ============ */
        .form-panel {
            flex: 1 1 46%;
            background: var(--paper);
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 2rem;
            overflow-y: auto;
        }

        .form-inner {
            width: 100%;
            max-width: 380px;
            opacity: 0;
            transform: translateY(16px);
            animation: card-in 0.7s cubic-bezier(0.16, 1, 0.3, 1) forwards;
            animation-delay: 0.15s;
        }

        @@keyframes card-in {
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .form-inner > * {
            opacity: 0;
            transform: translateY(8px);
            animation: field-in 0.5s ease forwards;
        }

            .form-inner > *:nth-child(1) {
                animation-delay: 0.3s;
            }

            .form-inner > *:nth-child(2) {
                animation-delay: 0.36s;
            }

            .form-inner > *:nth-child(3) {
                animation-delay: 0.42s;
            }

            .form-inner > *:nth-child(4) {
                animation-delay: 0.48s;
            }

            .form-inner > *:nth-child(5) {
                animation-delay: 0.54s;
            }

        @@keyframes field-in {
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .form-eyebrow {
            font-size: 0.75rem;
            font-weight: 700;
            letter-spacing: 0.08em;
            text-transform: uppercase;
            color: var(--amber);
            margin: 0 0 0.6rem;
        }

        .form-inner h4 {
            font-family: 'Space Grotesk', sans-serif;
            font-weight: 600;
            font-size: 1.6rem;
            color: var(--text-main);
            margin: 0 0 0.4rem;
        }

        .form-inner > p.form-sub {
            color: var(--sub-onpaper);
            font-size: 0.88rem;
            margin: 0 0 2rem;
        }

        .field-block {
            margin-bottom: 1.1rem;
        }

        .form-label-warm {
            font-size: 0.76rem;
            font-weight: 700;
            color: var(--text-main);
            margin-bottom: 6px;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            display: block;
        }

        .input-group-warm {
            border: 1px solid var(--border-paper);
            border-radius: 8px;
            background-color: #ffffff;
            transition: border-color 0.25s ease, box-shadow 0.25s ease, transform 0.2s ease;
            overflow: hidden;
            display: flex;
            align-items: center;
            width: 100%;
        }

            .input-group-warm:focus-within {
                border-color: var(--ink);
                box-shadow: 0 0 0 3px rgba(13, 20, 36, 0.08);
                transform: translateY(-1px);
            }

        .input-icon-warm {
            padding: 0.7rem 0.25rem 0.7rem 1rem;
            color: var(--sub-onpaper);
            font-size: 0.9rem;
            display: flex;
            align-items: center;
            transition: color 0.2s ease;
        }

        .input-group-warm:focus-within .input-icon-warm {
            color: var(--amber);
        }

        .form-control-warm {
            border: none !important;
            box-shadow: none !important;
            background: transparent !important;
            color: var(--text-main) !important;
            font-size: 0.9rem !important;
            padding: 0.7rem 1rem !important;
            width: 100%;
        }

            .form-control-warm::placeholder {
                color: #b8ae9d;
            }

        .row-between {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 0.35rem;
        }

            .row-between a {
                font-size: 0.78rem;
                font-weight: 600;
                color: var(--ink);
                text-decoration: none;
                border-bottom: 1px solid transparent;
                transition: border-color 0.2s ease;
            }

                .row-between a:hover {
                    border-color: var(--amber);
                }

        .remember-row {
            display: flex;
            align-items: center;
            gap: 8px;
            margin-bottom: 1.4rem;
        }

            .remember-row input[type="checkbox"] {
                width: 16px;
                height: 16px;
                accent-color: var(--ink);
                cursor: pointer;
            }

            .remember-row label {
                font-size: 0.83rem;
                color: var(--sub-onpaper);
                font-weight: 500;
                cursor: pointer;
                margin: 0;
            }

        .btn-console {
            width: 100%;
            background: var(--ink);
            color: #ffffff;
            border: none;
            padding: 0.8rem 1.5rem;
            border-radius: 8px;
            font-weight: 600;
            font-size: 0.92rem;
            letter-spacing: 0.01em;
            cursor: pointer;
            position: relative;
            overflow: hidden;
            transition: background 0.25s ease, transform 0.2s ease, box-shadow 0.25s ease;
            box-shadow: 0 10px 24px rgba(13, 20, 36, 0.18);
        }

            .btn-console::after {
                content: "";
                position: absolute;
                inset: 0;
                background: linear-gradient(120deg, rgba(255,255,255,0) 30%, rgba(245,166,35,0.35) 50%, rgba(255,255,255,0) 70%);
                transform: translateX(-120%);
                transition: transform 0.7s ease;
            }

            .btn-console:hover {
                background: var(--ink-soft);
                transform: translateY(-2px);
                box-shadow: 0 14px 30px rgba(13, 20, 36, 0.24);
            }

                .btn-console:hover::after {
                    transform: translateX(120%);
                }

            .btn-console:active {
                transform: translateY(0);
            }

        .credentials-notice {
            background-color: #fdf6e9;
            border: 1px dashed #ecd9ad;
            border-radius: 8px;
            padding: 0.9rem 1rem;
            margin-top: 1.4rem;
            font-size: 0.78rem;
            transition: border-color 0.2s ease, background-color 0.2s ease;
        }

            .credentials-notice:hover {
                border-color: var(--amber);
                background-color: #fcf0d8;
            }

            .credentials-notice .cred-label {
                font-weight: 700;
                color: var(--text-main);
                display: block;
                margin-bottom: 3px;
                text-transform: uppercase;
                letter-spacing: 0.04em;
                font-size: 0.7rem;
            }

            .credentials-notice code {
                color: #b5730a;
                font-weight: 700;
                font-size: 0.82rem;
            }

        .text-danger-custom {
            color: var(--danger);
            font-size: 0.8rem;
            margin-top: 4px;
            font-weight: 500;
        }

        .back-to-home {
            color: var(--sub-onpaper);
            text-decoration: none;
            font-size: 0.83rem;
            font-weight: 500;
            display: inline-flex;
            align-items: center;
            gap: 6px;
            margin-top: 1.4rem;
            transition: color 0.2s ease;
        }

            .back-to-home i {
                transition: transform 0.2s ease;
            }

            .back-to-home:hover {
                color: var(--ink);
            }

                .back-to-home:hover i {
                    transform: translateX(-3px);
                }

        input:focus {
            outline: none;
        }

        /* ============ RESPONSIVE ============ */
        @@media (max-width: 960px) {
            body {
                overflow-y: auto;
            }

            .split-shell {
                flex-direction: column;
                min-height: auto;
            }

            .ops-panel {
                flex: none;
                padding: 2.2rem 1.75rem;
            }

            .ops-headline h1 {
                font-size: 1.7rem;
            }

            .ops-chart {
                height: 48px;
            }

            .form-panel {
                flex: none;
                padding: 2.5rem 1.5rem 3rem;
            }
        }

        @@media (prefers-reduced-motion: reduce) {
            *, *::before, *::after {
                animation: none !important;
                transition: none !important;
                opacity: 1 !important;
                transform: none !important;
            }
        }
    </style>
</head>
<body>
    <div class="split-shell">

        <!-- ============ LEFT: LIVE OPERATIONS PANEL ============ -->
        <div class="ops-panel">
            <div class="ops-grid"></div>
            <div class="ops-glow"></div>

            <div class="ops-brand">
                <i class="fa-solid fa-cubes"></i>
                <span>ERP System</span>
            </div>

            <div class="ops-headline">
                <h1>Every department,<br />one live system.</h1>
                <p>Finance, HR, inventory and procurement running in sync &mdash; sign in to your central operations dashboard.</p>

                <div class="status-row">
                    <span class="status-dot"></span>
                    <span>All systems operational</span>
                </div>

                <div class="ops-chart">
                    <div class="bar"></div>
                    <div class="bar"></div>
                    <div class="bar"></div>
                    <div class="bar"></div>
                    <div class="bar"></div>
                    <div class="bar"></div>
                    <div class="bar"></div>
                </div>
            </div>

            <div>
                <div class="ops-ticker">
                    <div class="ticker-track">
                        <span class="ticker-chip">Finance</span>
                        <span class="ticker-chip">HR</span>
                        <span class="ticker-chip">Inventory</span>
                        <span class="ticker-chip">Procurement</span>
                        <span class="ticker-chip">Sales</span>
                        <span class="ticker-chip">Manufacturing</span>
                        <span class="ticker-chip">Analytics</span>
                        <span class="ticker-chip">Finance</span>
                        <span class="ticker-chip">HR</span>
                        <span class="ticker-chip">Inventory</span>
                        <span class="ticker-chip">Procurement</span>
                        <span class="ticker-chip">Sales</span>
                        <span class="ticker-chip">Manufacturing</span>
                        <span class="ticker-chip">Analytics</span>
                    </div>
                </div>
                <p class="ops-footnote">&copy; @DateTime.Now.Year ERP System &middot; Internal operations platform</p>
            </div>
        </div>

        <!-- ============ RIGHT: SIGN-IN FORM ============ -->
        <div class="form-panel">
            <div class="form-inner">
                <p class="form-eyebrow">Secure access</p>
                <h4>Sign in</h4>
                <p class="form-sub">Enter your credentials to reach the console.</p>

                <form asp-action="Login" method="post">
                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly" class="text-danger-custom mb-3"></div>

                    <!-- Email -->
                    <div class="field-block">
                        <label asp-for="Email" class="form-label-warm">Email Address</label>
                        <div class="input-group-warm">
                            <span class="input-icon-warm">
                                <i class="fa-regular fa-envelope"></i>
                            </span>
                            <input asp-for="Email" class="form-control form-control-warm" placeholder="name@company.com" autocomplete="username" />
                        </div>
                        <span asp-validation-for="Email" class="text-danger-custom d-block"></span>
                    </div>

                    <!-- Password -->
                    <div class="field-block">
                        <div class="row-between">
                            <label asp-for="Password" class="form-label-warm mb-0">Password</label>
                            <a href="#">Forgot?</a>
                        </div>
                        <div class="input-group-warm">
                            <span class="input-icon-warm">
                                <i class="fa-solid fa-lock"></i>
                            </span>
                            <input asp-for="Password" type="password" class="form-control form-control-warm" placeholder="••••••••" autocomplete="current-password" />
                        </div>
                        <span asp-validation-for="Password" class="text-danger-custom d-block"></span>
                    </div>

                    <!-- Remember Me -->
                    <div class="remember-row">
                        <input asp-for="RememberMe" type="checkbox" id="rememberMe" />
                        <label asp-for="RememberMe" for="rememberMe">Remember this device</label>
                    </div>

                    <!-- Submit -->
                    <button type="submit" class="btn-console">Authenticate Session</button>
                </form>

                <a href="/" class="back-to-home">
                    <i class="fa-solid fa-arrow-left"></i> Back to Homepage
                </a>
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
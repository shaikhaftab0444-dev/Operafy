@model ERP_System.Models.LoginViewModel
@{
    Layout = null; // Independent clean layout
    ViewData["Title"] = "Sign In - ERP Portal";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/fontawesome-free/css/all.min.css" />
    <link rel="stylesheet" href="~/css/landing.css" asp-append-version="true" />
    <style>
        body {
            background-color: var(--dark-bg);
            height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0;
        }
        .login-card {
            width: 100%;
            max-width: 450px;
            background: rgba(17, 24, 39, 0.65);
            border: 1px solid var(--glass-border);
            border-radius: 16px;
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            box-shadow: 0 20px 50px rgba(0,0,0,0.5);
            padding: 2.5rem;
        }
        .form-control-glass {
            background: rgba(255, 255, 255, 0.03) !important;
            border: 1px solid rgba(255, 255, 255, 0.08) !important;
            color: #ffffff !important;
            border-radius: 8px !important;
            padding: 0.75rem 1rem !important;
        }
        .form-control-glass:focus {
            background: rgba(255, 255, 255, 0.05) !important;
            border-color: var(--primary) !important;
            box-shadow: 0 0 10px rgba(79, 70, 229, 0.2) !important;
        }
        .text-danger-custom {
            color: #f43f5e;
            font-size: 0.85rem;
            margin-top: 0.25rem;
        }
        .auth-logo {
            font-size: 1.75rem;
            font-weight: 800;
            color: white;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 1.5rem;
        }
    </style>
</head>
<body>
    <div class="bg-glow" style="width: 400px; height: 400px; top: 10%; right: 10%;"></div>
    <div class="bg-glow-2" style="width: 400px; height: 400px; bottom: 10%; left: 10%;"></div>

    <div class="login-card text-center">
        <a class="auth-logo" href="/">
            <i class="fa-solid fa-cubes text-primary" style="color: #6366f1;"></i>
            <span>ERP <span style="color: #6366f1;">System</span></span>
        </a>
        
        <h4 class="text-white fw-bold mb-2">Welcome Back</h4>
        <p class="text-secondary small mb-4">Enter credentials to access your operation modules</p>

        <form asp-action="Login" method="post" class="text-start">
            @Html.AntiForgeryToken()
            
            <div asp-validation-summary="ModelOnly" class="text-danger-custom mb-3"></div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label text-white small fw-bold">Email Address</label>
                <div class="input-group">
                    <span class="input-group-text bg-transparent text-secondary border-secondary border-opacity-10" style="border-right: none !important; border-top-left-radius: 8px; border-bottom-left-radius: 8px;">
                        <i class="fa-regular fa-envelope"></i>
                    </span>
                    <input asp-for="Email" class="form-control form-control-glass" style="border-left: none !important; border-top-left-radius: 0; border-bottom-left-radius: 0;" placeholder="name@company.com" autocomplete="username" />
                </div>
                <span asp-validation-for="Email" class="text-danger-custom d-block"></span>
            </div>

            <div class="mb-4">
                <div class="d-flex justify-content-between align-items-center">
                    <label asp-for="Password" class="form-label text-white small fw-bold mb-1">Password</label>
                    <a href="#" class="text-decoration-none small text-secondary">Forgot?</a>
                </div>
                <div class="input-group">
                    <span class="input-group-text bg-transparent text-secondary border-secondary border-opacity-10" style="border-right: none !important; border-top-left-radius: 8px; border-bottom-left-radius: 8px;">
                        <i class="fa-solid fa-lock"></i>
                    </span>
                    <input asp-for="Password" type="password" class="form-control form-control-glass" style="border-left: none !important; border-top-left-radius: 0; border-bottom-left-radius: 0;" placeholder="••••••••" autocomplete="current-password" />
                </div>
                <span asp-validation-for="Password" class="text-danger-custom d-block"></span>
            </div>

            <div class="mb-4 d-flex justify-content-between align-items-center">
                <div class="form-check">
                    <input asp-for="RememberMe" class="form-check-input bg-transparent border-secondary" type="checkbox" style="cursor: pointer;" />
                    <label asp-for="RememberMe" class="form-check-label text-secondary small" style="cursor: pointer;">Remember me</label>
                </div>
            </div>

            <button type="submit" class="btn btn-glass-primary w-100 py-2.5 fw-bold mb-3">
                Sign In
            </button>
        </form>

        <p class="text-secondary small mb-4">
            Default seeded credentials: <br/>
            <code class="text-indigo" style="color:#a5b4fc;">admin@erp.com</code> / <code class="text-indigo" style="color:#a5b4fc;">Admin@123</code>
        </p>


    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>

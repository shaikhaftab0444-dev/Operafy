@model IEnumerable<ERP_System.Models.Role>
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "User Types (Roles)";
    var userCounts = (Dictionary<int, int>)ViewBag.UserCounts;
}

<style>
    .panel-roles {
        background: #ffffff;
        border: 1px solid var(--border-warm);
        border-radius: 12px;
        box-shadow: 0 1px 3px rgba(45,37,30,0.03);
    }
    
    .table-roles th {
        background-color: #fcfbfa !important;
        font-size: 0.75rem;
        text-transform: uppercase;
        font-weight: 700;
        color: #7c7267;
        border-bottom: 1px solid var(--border-warm);
        padding: 1rem 1.25rem;
    }
    
    .table-roles td {
        font-size: 0.875rem;
        color: var(--text-color);
        border-bottom: 1px solid var(--border-warm);
        padding: 1rem 1.25rem;
        vertical-align: middle;
    }

    .badge-role-active {
        background-color: rgba(16, 185, 129, 0.08);
        color: #10b981;
        font-weight: 600;
        border: 1px solid rgba(16, 185, 129, 0.2);
    }
    .badge-role-inactive {
        background-color: rgba(239, 68, 68, 0.08);
        color: #ef4444;
        font-weight: 600;
        border: 1px solid rgba(239, 68, 68, 0.2);
    }
</style>

<!-- Top Breadcrumbs & Page Header -->
<div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-3 mb-4 text-start">
    <div>
        <h4 class="fw-bold mb-1" style="color: var(--text-color);">User Types & Roles</h4>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0 small">
                <li class="breadcrumb-item"><a href="/Dashboard" class="text-decoration-none">Dashboard</a></li>
                <li class="breadcrumb-item"><a href="/UserAccounts" class="text-decoration-none">User Accounts</a></li>
                <li class="breadcrumb-item active" aria-current="page">User Types</li>
            </ol>
        </nav>
    </div>
</div>

<!-- Roles Grid -->
<div class="panel-roles overflow-hidden">
    <div class="table-responsive">
        <table class="table table-hover table-roles mb-0 border-0 text-start">
            <thead>
                <tr>
                    <th class="border-0">Role ID</th>
                    <th class="border-0">User Type / Role Name</th>
                    <th class="border-0">Default Description</th>
                    <th class="border-0 text-center">Assigned Users</th>
                    <th class="border-0 text-center">Status</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var role in Model)
                    {
                        var count = userCounts.ContainsKey(role.RoleId) ? userCounts[role.RoleId] : 0;
                        <tr>
                            <td class="fw-bold text-secondary">ROLE#@role.RoleId.ToString("D2")</td>
                            <td class="fw-bold text-dark">@role.RoleName</td>
                            <td>
                                @if (role.RoleName == "Super Admin")
                                {
                                    <span class="text-secondary">Root developer access. Full authority over operations, companies, settings, and tables.</span>
                                }
                                else if (role.RoleName == "Admin")
                                {
                                    <span class="text-secondary">System Administrator. General administration, company settings, and accounting heads management.</span>
                                }
                                else if (role.RoleName == "HR")
                                {
                                    <span class="text-secondary">Human Resources. Payroll structures configuration, employee management, and payslips generation.</span>
                                }
                                else if (role.RoleName == "Manager")
                                {
                                    <span class="text-secondary">Operations Manager. Operational dashboards access, products inventory, and transaction reports.</span>
                                }
                                else
                                {
                                    <span class="text-secondary">General staff member. Restricted dashboards and view-only operational privileges.</span>
                                }
                            </td>
                            <td class="text-center fw-bold text-secondary">
                                <span class="badge bg-light text-dark border px-2.5 py-1.5" style="font-size: 0.8rem;">
                                    <i class="fa-solid fa-users me-1 text-muted"></i> @count Users
                                </span>
                            </td>
                            <td class="text-center">
                                @if (role.IsActive)
                                {
                                    <span class="badge rounded-pill px-2.5 py-1.5 badge-role-active" style="font-size: 0.75rem;">Active</span>
                                }
                                else
                                {
                                    <span class="badge rounded-pill px-2.5 py-1.5 badge-role-inactive" style="font-size: 0.75rem;">Inactive</span>
                                }
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" class="text-center text-muted py-5">No user type roles registered.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

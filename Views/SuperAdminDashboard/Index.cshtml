@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Global Control Center";
    var totalCompanies = ViewBag.TotalCompanies;
    var totalBranches = ViewBag.TotalBranches;
    var totalUsers = ViewBag.TotalUsers;
    var activeUsers = ViewBag.ActiveUsers;
    var recentLogs = ViewBag.RecentLogs as IEnumerable<ERP_System.Models.ActivityLog> ?? new List<ERP_System.Models.ActivityLog>();
}

<div class="container-fluid py-4 text-start">
    <div class="mb-4">
        <h4 class="fw-bold mb-1"><i class="fa-solid fa-server text-primary me-2"></i>Global Control Center</h4>
        <p class="text-muted small">Super Admin Dashboard</p>
    </div>

    <!-- Platform Stats Cards -->
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="p-3 bg-white border rounded shadow-sm">
                <div class="text-muted small fw-semibold">Platform Uptime</div>
                <h4 class="fw-bold text-success mt-1">99.98%</h4>
                <div class="small text-muted">All systems normal</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="p-3 bg-white border rounded shadow-sm">
                <div class="text-muted small fw-semibold">Aggregated Financials</div>
                <h4 class="fw-bold text-dark mt-1">₹14.82 Lakhs</h4>
                <div class="small text-muted">Across all entities</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="p-3 bg-white border rounded shadow-sm">
                <div class="text-muted small fw-semibold">Platform Active Users</div>
                <h4 class="fw-bold text-primary mt-1">@activeUsers / @totalUsers</h4>
                <div class="small text-muted">Logged in users</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="p-3 bg-white border rounded shadow-sm">
                <div class="text-muted small fw-semibold">Total Organizations</div>
                <h4 class="fw-bold text-dark mt-1">@totalCompanies Companies</h4>
                <div class="small text-muted">@totalBranches Operating branches</div>
            </div>
        </div>
    </div>

    <!-- Global Activity Feed -->
    <div class="bg-white border rounded-3 p-4 shadow-sm mb-4">
        <h5 class="fw-bold mb-3"><i class="fa-solid fa-list-ul text-primary me-2"></i>Global System Activity Feed</h5>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" style="font-size: 0.85rem;">
                <thead class="table-light">
                    <tr>
                        <th>Date & Time</th>
                        <th>Module / Area</th>
                        <th>Action Log Details</th>
                    </tr>
                </thead>
                <tbody>
                    @if (recentLogs.Any())
                    {
                        @foreach (var log in recentLogs)
                        {
                            <tr>
                                <td class="text-muted">@log.CreatedAt.ToString("dd MMM yyyy hh:mm tt")</td>
                                <td><span class="badge bg-secondary-subtle text-secondary">@log.Title</span></td>
                                <td>@log.Description</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Master Tax Slabs";
}

<div class="container-fluid py-4 text-start">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-bold mb-1"><i class="fa-solid fa-calculator text-primary me-2"></i>Master Tax Slabs</h4>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0 small">
                    <li class="breadcrumb-item"><a href="/SuperAdminDashboard" class="text-decoration-none">Dashboard</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Tax Slabs</li>
                </ol>
            </nav>
        </div>
    </div>

    <!-- Tax Slabs Table -->
    <div class="bg-white border rounded-3 p-4 shadow-sm" style="max-width: 600px;">
        <h5 class="fw-bold mb-3">Global Tax Regulations</h5>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" style="font-size: 0.85rem;">
                <thead class="table-light">
                    <tr>
                        <th>Tax Code</th>
                        <th>Rate (%)</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td class="fw-bold text-dark">GST-18</td>
                        <td>18.00 %</td>
                        <td><span class="badge bg-success-subtle text-success">Active</span></td>
                    </tr>
                    <tr>
                        <td class="fw-bold text-dark">VAT-15</td>
                        <td>15.00 %</td>
                        <td><span class="badge bg-success-subtle text-success">Active</span></td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

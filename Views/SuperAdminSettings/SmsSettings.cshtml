@model IEnumerable<ERP_System.Models.SuperAdminIntegration>
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "SMS & WhatsApp API Integrations";
}

<div class="container-fluid py-4 text-start">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-bold mb-1"><i class="fa-solid fa-comments text-primary me-2"></i>SMS & WhatsApp API Integrations</h4>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0 small">
                    <li class="breadcrumb-item"><a href="/SuperAdminDashboard" class="text-decoration-none">Dashboard</a></li>
                    <li class="breadcrumb-item active" aria-current="page">SMS & WhatsApp APIs</li>
                </ol>
            </nav>
        </div>
        <button class="btn btn-primary rounded-pill px-3 btn-sm shadow-sm" data-bs-toggle="modal" data-bs-target="#smsModal">
            <i class="fa-solid fa-plus me-1.5"></i>Add Integration
        </button>
    </div>

    <!-- Integrations Table -->
    <div class="bg-white border rounded-3 p-4 shadow-sm" style="max-width: 800px;">
        <h5 class="fw-bold mb-3">API Gateways</h5>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" style="font-size: 0.85rem;">
                <thead class="table-light">
                    <tr>
                        <th>Provider Name</th>
                        <th>API URL</th>
                        <th>API Key Preview</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var api in Model)
                        {
                            <tr>
                                <td class="fw-bold text-dark">@api.ProviderName</td>
                                <td><code>@api.ApiUrl</code></td>
                                <td class="text-muted"><code>@(api.ApiKey.Length > 10 ? api.ApiKey.Substring(0, 8) + "..." : api.ApiKey)</code></td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- SMS Modal -->
<div class="modal fade text-start" id="smsModal" tabindex="-1" aria-labelledby="smsModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form action="/SuperAdminSettings/SaveIntegration" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title fw-bold" id="smsModalLabel">Add API Gateway Integration</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Provider / Gateway Name</label>
                        <input type="text" name="ProviderName" class="form-control" placeholder="e.g. Twilio SMS" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">API Endpoint URL</label>
                        <input type="text" name="ApiUrl" class="form-control" placeholder="e.g. api.twilio.com" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">API Key / Token</label>
                        <input type="password" name="ApiKey" class="form-control" placeholder="••••••••" required />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary rounded-pill px-3 btn-sm" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary rounded-pill px-3 btn-sm">Save Gateway</button>
                </div>
            </form>
        </div>
    </div>
</div>

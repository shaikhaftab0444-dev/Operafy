@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Payment Gateway Credentials";
}

<div class="container-fluid py-4 text-start" style="max-width: 700px;">
    <div class="mb-4">
        <h4 class="fw-bold mb-1"><i class="fa-solid fa-credit-card text-primary me-2"></i>Payment Gateway Credentials</h4>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0 small">
                <li class="breadcrumb-item"><a href="/SuperAdminDashboard" class="text-decoration-none">Dashboard</a></li>
                <li class="breadcrumb-item active" aria-current="page">Payment Gateways</li>
            </ol>
        </nav>
    </div>

    <!-- Gateway Form -->
    <div class="bg-white border rounded-3 p-4 shadow-sm">
        <h5 class="fw-bold mb-3">Merchant Integrations</h5>
        <form>
            <div class="mb-3">
                <label class="form-label small fw-semibold">Payment Gateway Provider</label>
                <select class="form-select">
                    <option>Razorpay API Standard</option>
                    <option>Stripe Payments</option>
                </select>
            </div>
            <div class="mb-3">
                <label class="form-label small fw-semibold">Merchant ID</label>
                <input type="text" class="form-control" value="mid_90418290" required />
            </div>
            <div class="mb-3">
                <label class="form-label small fw-semibold">API Key ID</label>
                <input type="text" class="form-control" value="rzp_live_A1B2C3D4" required />
            </div>
            <div class="mb-4">
                <label class="form-label small fw-semibold">API Secret Key</label>
                <input type="password" class="form-control" value="••••••••" required />
            </div>
            <button type="button" class="btn btn-primary rounded-pill px-4" onclick="alert('Payment settings updated successfully!')">Save Merchant Credentials</button>
        </form>
    </div>
</div>

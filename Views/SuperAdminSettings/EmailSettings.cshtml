@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "System Email / SMTP Gateways";
}

<div class="container-fluid py-4 text-start" style="max-width: 700px;">
    <div class="mb-4">
        <h4 class="fw-bold mb-1"><i class="fa-solid fa-envelope text-primary me-2"></i>System Email / SMTP Gateways</h4>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0 small">
                <li class="breadcrumb-item"><a href="/SuperAdminDashboard" class="text-decoration-none">Dashboard</a></li>
                <li class="breadcrumb-item active" aria-current="page">Email SMTP Settings</li>
            </ol>
        </nav>
    </div>

    <!-- SMTP Form -->
    <div class="bg-white border rounded-3 p-4 shadow-sm">
        <h5 class="fw-bold mb-3">SMTP Host Configurations</h5>
        <form>
            <div class="row g-3">
                <div class="col-md-8">
                    <label class="form-label small fw-semibold">SMTP Host Address</label>
                    <input type="text" class="form-control" value="smtp.sendgrid.net" required />
                </div>
                <div class="col-md-4">
                    <label class="form-label small fw-semibold">Port</label>
                    <input type="number" class="form-control" value="587" required />
                </div>
                <div class="col-md-6">
                    <label class="form-label small fw-semibold">Username / API Key Name</label>
                    <input type="text" class="form-control" value="apikey" required />
                </div>
                <div class="col-md-6">
                    <label class="form-label small fw-semibold">API Key Value / Password</label>
                    <input type="password" class="form-control" value="SG.A1B2C3D4E5F6G7H8I9J0" required />
                </div>
            </div>
            <hr class="my-4" />
            <div class="d-flex justify-content-end gap-2">
                <button type="button" class="btn btn-outline-secondary rounded-pill px-4" onclick="alert('Sending test email to admin...')">Test Connection</button>
                <button type="button" class="btn btn-primary rounded-pill px-4" onclick="alert('SMTP configuration saved successfully!')">Save Settings</button>
            </div>
        </form>
    </div>
</div>

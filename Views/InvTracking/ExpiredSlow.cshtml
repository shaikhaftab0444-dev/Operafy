@model IEnumerable<ERP_System.Models.Product>
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Expired & Slow-Moving Stock";
}

<div class="container-fluid py-4 text-start">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-bold mb-1"><i class="fa-solid fa-clock text-primary me-2"></i>Expired & Slow-Moving Stock</h4>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0 small">
                    <li class="breadcrumb-item"><a href="/InventoryDashboard" class="text-decoration-none">Inventory Dashboard</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Expired & Slow Stock</li>
                </ol>
            </nav>
        </div>
    </div>

    <!-- Expired/Slow Grid -->
    <div class="bg-white border rounded-3 p-4 shadow-sm">
        <h5 class="fw-bold mb-3">Inactive Inventory Items</h5>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" style="font-size: 0.85rem;">
                <thead class="table-light">
                    <tr>
                        <th>Item Description</th>
                        <th>Available Quantity</th>
                        <th>Sold Quantity (YTD)</th>
                        <th>Days Since Last Movement</th>
                        <th>Category</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var p in Model)
                        {
                            <tr>
                                <td class="fw-bold text-dark">@p.ProductName</td>
                                <td>@p.StockQty Units</td>
                                <td>@p.SoldQty Units</td>
                                <td>@(p.SoldQty == 0 ? "180+ Days" : "90 Days")</td>
                                <td><span class="badge bg-secondary-subtle text-secondary">@p.Category</span></td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center py-4 text-muted">No slow-moving inventory logs recorded.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

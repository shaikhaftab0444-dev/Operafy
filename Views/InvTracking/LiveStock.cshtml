@model IEnumerable<ERP_System.Models.Product>
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Live Stock Balance";
}

<div class="container-fluid py-4 text-start">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-bold mb-1"><i class="fa-solid fa-chart-simple text-primary me-2"></i>Live Stock Balance</h4>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0 small">
                    <li class="breadcrumb-item"><a href="/InventoryDashboard" class="text-decoration-none">Inventory Dashboard</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Live Stock</li>
                </ol>
            </nav>
        </div>
    </div>

    <!-- Live Stock Grid -->
    <div class="bg-white border rounded-3 p-4 shadow-sm">
        <h5 class="fw-bold mb-3">Inventory Balance Sheet</h5>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" style="font-size: 0.85rem;">
                <thead class="table-light">
                    <tr>
                        <th>Item Description</th>
                        <th>Category</th>
                        <th>Physical Qty on Hand</th>
                        <th>Branch / Facility</th>
                        <th>Alert Status</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var p in Model)
                        {
                            <tr>
                                <td class="fw-bold text-dark">@p.ProductName</td>
                                <td>@p.Category</td>
                                <td>@p.StockQty Units</td>
                                <td>@(p.Branch != null ? p.Branch.BranchName : "Head Office")</td>
                                <td>
                                    @if (p.StockQty > 50)
                                    {
                                        <span class="badge bg-success-subtle text-success rounded-pill">Healthy</span>
                                    }
                                    else if (p.StockQty > 0)
                                    {
                                        <span class="badge bg-warning-subtle text-warning">Low</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger-subtle text-danger rounded-pill">Out of Stock</span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center py-4 text-muted">No items in inventory catalog.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

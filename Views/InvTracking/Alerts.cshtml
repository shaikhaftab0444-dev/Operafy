@model IEnumerable<ERP_System.Models.Product>
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Low Stock & Reorder Alerts";
}

<div class="container-fluid py-4 text-start">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-bold mb-1"><i class="fa-solid fa-triangle-exclamation text-primary me-2"></i>Low Stock & Reorder Alerts</h4>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0 small">
                    <li class="breadcrumb-item"><a href="/InventoryDashboard" class="text-decoration-none">Inventory Dashboard</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Low Stock Alerts</li>
                </ol>
            </nav>
        </div>
    </div>

    <!-- Alerts Table -->
    <div class="bg-white border rounded-3 p-4 shadow-sm">
        <h5 class="fw-bold mb-3"><i class="fa-solid fa-circle-exclamation text-danger me-2"></i>Items Requiring Reorder</h5>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" style="font-size: 0.85rem;">
                <thead class="table-light">
                    <tr>
                        <th>Item Name</th>
                        <th>Current Quantity</th>
                        <th>Reorder Level</th>
                        <th>Suggested Reorder Qty</th>
                        <th>Alert Priority</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var p in Model)
                        {
                            var priority = p.StockQty == 0 ? "High" : "Medium";
                            var priorityClass = p.StockQty == 0 ? "bg-danger-subtle text-danger" : "bg-warning-subtle text-warning";
                            <tr>
                                <td class="fw-bold text-dark">@p.ProductName</td>
                                <td class="text-danger fw-bold">@p.StockQty Units</td>
                                <td>30 Units</td>
                                <td>150 Units</td>
                                <td>
                                    <span class="badge @priorityClass rounded-pill">@priority</span>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center py-4 text-success fw-bold"><i class="fa-solid fa-circle-check me-1.5"></i>All item stocks are currently healthy!</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

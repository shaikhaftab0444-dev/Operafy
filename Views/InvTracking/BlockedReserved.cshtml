@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Blocked & Reserved Stock";
}

<div class="container-fluid py-4 text-start">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-bold mb-1"><i class="fa-solid fa-lock text-primary me-2"></i>Blocked / Reserved Stock</h4>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0 small">
                    <li class="breadcrumb-item"><a href="/InventoryDashboard" class="text-decoration-none">Inventory Dashboard</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Blocked & Reserved</li>
                </ol>
            </nav>
        </div>
    </div>

    <!-- Reserved Items Table -->
    <div class="bg-white border rounded-3 p-4 shadow-sm" style="max-width: 700px;">
        <h5 class="fw-bold mb-3">Locked Stock Units</h5>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" style="font-size: 0.85rem;">
                <thead class="table-light">
                    <tr>
                        <th>Item Name</th>
                        <th>Reserved Quantity</th>
                        <th>Reserved For (Order No)</th>
                        <th>Expiration Date</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td class="fw-bold text-dark">Dell Wired Keyboard</td>
                        <td>15 Units</td>
                        <td><code>SO-2026-9041</code></td>
                        <td>25 Aug 2026</td>
                    </tr>
                    <tr>
                        <td class="fw-bold text-dark">Logitech Wireless Mouse</td>
                        <td>8 Units</td>
                        <td><code>SO-2026-9042</code></td>
                        <td>28 Aug 2026</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

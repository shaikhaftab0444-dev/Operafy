@model ERP_System.Models.Branch
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Add New Branch";
}

<style>
    .panel-form {
        background: #ffffff;
        border: 1px solid var(--border-warm);
        border-radius: 12px;
        box-shadow: 0 1px 3px rgba(45,37,30,0.03);
        padding: 2.5rem;
        max-width: 800px;
        margin: 0 auto;
    }

    .form-label-warm {
        font-size: 0.8rem;
        font-weight: 700;
        color: var(--text-color);
        margin-bottom: 6px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .input-group-warm {
        border: 1px solid #d4cbbd;
        border-radius: 8px;
        background-color: #fcfbfa;
        transition: all 0.2s ease-in-out;
        overflow: hidden;
        display: flex;
        align-items: center;
        width: 100%;
    }
    .input-group-warm:focus-within {
        border-color: var(--primary-warm);
        box-shadow: 0 0 0 4px rgba(79, 70, 229, 0.08);
        background-color: #ffffff;
    }

    .input-icon-warm {
        padding: 0.75rem 0.25rem 0.75rem 1rem;
        color: var(--sidebar-color);
        font-size: 0.95rem;
        display: flex;
        align-items: center;
    }

    .form-control-warm {
        border: none !important;
        box-shadow: none !important;
        background: transparent !important;
        color: var(--text-color) !important;
        font-size: 0.9rem !important;
        padding: 0.75rem 1rem !important;
        width: 100%;
    }

    .btn-primary-warm {
        background: linear-gradient(135deg, var(--primary-warm) 0%, #6366f1 100%);
        color: #ffffff;
        border: none;
        padding: 0.75rem 2rem;
        border-radius: 8px;
        font-weight: 600;
        font-size: 0.9rem;
        box-shadow: 0 4px 10px rgba(79, 70, 229, 0.2);
        transition: all 0.2s;
    }
    .btn-primary-warm:hover {
        transform: translateY(-1px);
        box-shadow: 0 6px 14px rgba(79, 70, 229, 0.3);
        color: #ffffff;
    }

    .btn-secondary-warm {
        border: 1px solid var(--border-warm);
        background-color: #ffffff;
        color: var(--text-color);
        padding: 0.75rem 2rem;
        border-radius: 8px;
        font-weight: 600;
        font-size: 0.9rem;
        transition: all 0.2s;
    }
    .btn-secondary-warm:hover {
        background-color: #faf8f5;
        border-color: #cbd5e1;
    }
</style>

<!-- Breadcrumbs & Header -->
<div class="mb-4 text-center">
    <h4 class="fw-bold mb-1" style="color: var(--text-color);">Add New Branch</h4>
    <p class="text-muted small">Configure sub-branch contact, billing, and address information.</p>
    <nav aria-label="breadcrumb" class="d-inline-block">
        <ol class="breadcrumb mb-0 small">
            <li class="breadcrumb-item"><a href="/Dashboard" class="text-decoration-none">Dashboard</a></li>
            <li class="breadcrumb-item"><a href="/Branches" class="text-decoration-none">Branches</a></li>
            <li class="breadcrumb-item active" aria-current="page">New Branch</li>
        </ol>
    </nav>
</div>

<!-- Form Card -->
<div class="panel-form">
    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="CompanyId" />

        <div class="row g-3 text-start">
            <!-- General Info -->
            <div class="col-md-6">
                <label asp-for="BranchName" class="form-label-warm">Branch Name</label>
                <div class="input-group-warm">
                    <span class="input-icon-warm"><i class="fa-solid fa-building"></i></span>
                    <input asp-for="BranchName" class="form-control-warm" placeholder="e.g. London Office" required />
                </div>
            </div>
            <div class="col-md-6">
                <label asp-for="BranchCode" class="form-label-warm">Branch Code</label>
                <div class="input-group-warm">
                    <span class="input-icon-warm"><i class="fa-solid fa-barcode"></i></span>
                    <input asp-for="BranchCode" class="form-control-warm" placeholder="e.g. BR-LDN" required />
                </div>
            </div>

            <!-- Contacts -->
            <div class="col-md-4">
                <label asp-for="Email" class="form-label-warm">Contact Email</label>
                <div class="input-group-warm">
                    <span class="input-icon-warm"><i class="fa-regular fa-envelope"></i></span>
                    <input asp-for="Email" type="email" class="form-control-warm" placeholder="branch@example.com" />
                </div>
            </div>
            <div class="col-md-4">
                <label asp-for="Phone" class="form-label-warm">Telephone</label>
                <div class="input-group-warm">
                    <span class="input-icon-warm"><i class="fa-solid fa-phone"></i></span>
                    <input asp-for="Phone" class="form-control-warm" placeholder="+44..." />
                </div>
            </div>
            <div class="col-md-4">
                <label asp-for="GSTNumber" class="form-label-warm">GST / VAT Number</label>
                <div class="input-group-warm">
                    <span class="input-icon-warm"><i class="fa-solid fa-receipt"></i></span>
                    <input asp-for="GSTNumber" class="form-control-warm" placeholder="Tax Registration ID" />
                </div>
            </div>

            <!-- Address -->
            <div class="col-12">
                <label asp-for="AddressLine1" class="form-label-warm">Street Address</label>
                <div class="input-group-warm">
                    <span class="input-icon-warm"><i class="fa-solid fa-location-dot"></i></span>
                    <input asp-for="AddressLine1" class="form-control-warm" placeholder="Suite, floor, street..." required />
                </div>
            </div>

            <div class="col-md-3">
                <label asp-for="City" class="form-label-warm">City</label>
                <input asp-for="City" class="form-control form-control-warm border" style="border: 1px solid #d4cbbd !important; border-radius: 8px !important;" placeholder="City" required />
            </div>
            <div class="col-md-3">
                <label asp-for="State" class="form-label-warm">State / Province</label>
                <input asp-for="State" class="form-control form-control-warm border" style="border: 1px solid #d4cbbd !important; border-radius: 8px !important;" placeholder="State" required />
            </div>
            <div class="col-md-3">
                <label asp-for="Country" class="form-label-warm">Country</label>
                <input asp-for="Country" class="form-control form-control-warm border" style="border: 1px solid #d4cbbd !important; border-radius: 8px !important;" placeholder="Country" required />
            </div>
            <div class="col-md-3">
                <label asp-for="PostalCode" class="form-label-warm">Postal / ZIP Code</label>
                <input asp-for="PostalCode" class="form-control form-control-warm border" style="border: 1px solid #d4cbbd !important; border-radius: 8px !important;" placeholder="ZIP" />
            </div>
        </div>

        <!-- Form Buttons -->
        <div class="d-flex justify-content-end gap-3 mt-4">
            <a href="/Branches" class="btn btn-secondary-warm">Cancel</a>
            <button type="submit" class="btn btn-primary-warm">Register Branch</button>
        </div>
    </form>
</div>

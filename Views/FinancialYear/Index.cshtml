@model IEnumerable<ERP_System.Models.FinancialYear>
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Financial Years Calendar";
}

<style>
    .panel-calendar {
        background: #ffffff;
        border: 1px solid var(--border-warm);
        border-radius: 12px;
        box-shadow: 0 1px 3px rgba(45,37,30,0.03);
    }
    
    .table-calendar th {
        background-color: #fcfbfa !important;
        font-size: 0.75rem;
        text-transform: uppercase;
        font-weight: 700;
        color: #7c7267;
        border-bottom: 1px solid var(--border-warm);
        padding: 1rem 1.25rem;
    }
    
    .table-calendar td {
        font-size: 0.875rem;
        color: var(--text-color);
        border-bottom: 1px solid var(--border-warm);
        padding: 1rem 1.25rem;
        vertical-align: middle;
    }

    .badge-fy-active {
        background-color: rgba(16, 185, 129, 0.08);
        color: #10b981;
        font-weight: 600;
        border: 1px solid rgba(16, 185, 129, 0.2);
    }
    .badge-fy-inactive {
        background-color: rgba(239, 68, 68, 0.08);
        color: #ef4444;
        font-weight: 600;
        border: 1px solid rgba(239, 68, 68, 0.2);
    }
    
    .badge-fy-current {
        background-color: rgba(79, 70, 229, 0.08);
        color: var(--primary-warm);
        font-weight: 700;
        border: 1px solid rgba(79, 70, 229, 0.2);
    }
</style>

<!-- Top Breadcrumbs & Page Header -->
<div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-3 mb-4 text-start">
    <div>
        <h4 class="fw-bold mb-1" style="color: var(--text-color);">Financial Year Settings</h4>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0 small">
                <li class="breadcrumb-item"><a href="/Dashboard" class="text-decoration-none">Dashboard</a></li>
                <li class="breadcrumb-item active" aria-current="page">Financial Years</li>
            </ol>
        </nav>
    </div>
    
    <a href="/FinancialYear/Create" class="btn btn-primary-warm px-4 py-2">
        <i class="fa-solid fa-plus me-2"></i> Register New FY
    </a>
</div>

<!-- Alerts -->
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success border-0 shadow-sm alert-dismissible fade show mb-4 small text-start" role="alert" style="background-color: #f0fdf4; color: #15803d; border-left: 4px solid #16a34a !important;">
        <i class="fa-solid fa-circle-check me-2"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger border-0 shadow-sm alert-dismissible fade show mb-4 small text-start" role="alert" style="background-color: #fef2f2; color: #b91c1c; border-left: 4px solid #dc2626 !important;">
        <i class="fa-solid fa-circle-xmark me-2"></i> @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Financial Years Table -->
<div class="panel-calendar overflow-hidden">
    <div class="table-responsive">
        <table class="table table-hover table-calendar mb-0 border-0 text-start">
            <thead>
                <tr>
                    <th class="border-0">FY ID</th>
                    <th class="border-0">Financial Year Name</th>
                    <th class="border-0">Start Date</th>
                    <th class="border-0">End Date</th>
                    <th class="border-0 text-center">Status</th>
                    <th class="border-0 text-center">Current Operational</th>
                    <th class="border-0 text-center">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var year in Model)
                    {
                        <tr>
                            <td class="fw-bold text-secondary">FY#@year.FinancialYearId.ToString("D2")</td>
                            <td class="fw-bold text-dark">@year.YearName</td>
                            <td>@year.StartDate.ToString("dd MMM yyyy")</td>
                            <td>@year.EndDate.ToString("dd MMM yyyy")</td>
                            <td class="text-center">
                                @if (year.IsActive)
                                {
                                    <span class="badge rounded-pill px-2.5 py-1.5 badge-fy-active" style="font-size: 0.75rem;">Active</span>
                                }
                                else
                                {
                                    <span class="badge rounded-pill px-2.5 py-1.5 badge-fy-inactive" style="font-size: 0.75rem;">Inactive</span>
                                }
                            </td>
                            <td class="text-center">
                                @if (year.IsCurrent)
                                {
                                    <span class="badge rounded-pill px-3 py-1.5 badge-fy-current" style="font-size: 0.75rem;">
                                        <i class="fa-solid fa-circle-check me-1.5"></i> Active Operational FY
                                    </span>
                                }
                                else
                                {
                                    <form asp-action="SetCurrent" asp-route-id="@year.FinancialYearId" method="post" style="display:inline;">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-secondary btn-sm-custom px-3 py-1 text-uppercase" style="font-size: 0.7rem; font-weight:700;">
                                            Set Operational
                                        </button>
                                    </form>
                                }
                            </td>
                            <td class="text-center">
                                <form asp-action="ToggleActive" asp-route-id="@year.FinancialYearId" method="post" style="display:inline;">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-sm-custom px-3 py-1 @(year.IsActive ? "btn-outline-danger" : "btn-outline-success")">
                                        <i class="fa-solid @(year.IsActive ? "fa-ban" : "fa-circle-check") me-1"></i>
                                        @(year.IsActive ? "Deactivate" : "Activate")
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="text-center text-muted py-5">No financial years registered in system.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

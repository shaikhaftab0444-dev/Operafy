@model ERP_System.Models.FinancialYear
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Register Financial Year";
}

<style>
    .panel-form {
        background: #ffffff;
        border: 1px solid var(--border-warm);
        border-radius: 12px;
        box-shadow: 0 1px 3px rgba(45,37,30,0.03);
        padding: 2.5rem;
        max-width: 600px;
        margin: 0 auto;
    }

    .form-label-warm {
        font-size: 0.8rem;
        font-weight: 700;
        color: var(--text-color);
        margin-bottom: 6px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .input-group-warm {
        border: 1px solid #d4cbbd;
        border-radius: 8px;
        background-color: #fcfbfa;
        transition: all 0.2s ease-in-out;
        overflow: hidden;
        display: flex;
        align-items: center;
        width: 100%;
    }
    .input-group-warm:focus-within {
        border-color: var(--primary-warm);
        box-shadow: 0 0 0 4px rgba(79, 70, 229, 0.08);
        background-color: #ffffff;
    }

    .input-icon-warm {
        padding: 0.75rem 0.25rem 0.75rem 1rem;
        color: var(--sidebar-color);
        font-size: 0.95rem;
        display: flex;
        align-items: center;
    }

    .form-control-warm {
        border: none !important;
        box-shadow: none !important;
        background: transparent !important;
        color: var(--text-color) !important;
        font-size: 0.9rem !important;
        padding: 0.75rem 1rem !important;
        width: 100%;
    }
</style>

<!-- Breadcrumbs & Header -->
<div class="mb-4 text-center">
    <h4 class="fw-bold mb-1" style="color: var(--text-color);">Register Financial Year</h4>
    <p class="text-muted small">Register a new fiscal calendar cycle into the accounting tables.</p>
    <nav aria-label="breadcrumb" class="d-inline-block">
        <ol class="breadcrumb mb-0 small">
            <li class="breadcrumb-item"><a href="/Dashboard" class="text-decoration-none">Dashboard</a></li>
            <li class="breadcrumb-item"><a href="/FinancialYear" class="text-decoration-none">Financial Years</a></li>
            <li class="breadcrumb-item active" aria-current="page">Register FY</li>
        </ol>
    </nav>
</div>

<!-- Form Card -->
<div class="panel-form">
    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()

        <div class="row g-3 text-start">
            <!-- Year Name -->
            <div class="col-12">
                <label asp-for="YearName" class="form-label-warm">Financial Year Label</label>
                <div class="input-group-warm">
                    <span class="input-icon-warm"><i class="fa-regular fa-calendar-check"></i></span>
                    <input asp-for="YearName" class="form-control-warm" placeholder="e.g. FY 2026-27" required />
                </div>
                <span asp-validation-for="YearName" class="text-danger small"></span>
            </div>

            <!-- Start Date -->
            <div class="col-md-6">
                <label asp-for="StartDate" class="form-label-warm">Starting Date</label>
                <div class="input-group-warm">
                    <span class="input-icon-warm"><i class="fa-regular fa-calendar"></i></span>
                    <input asp-for="StartDate" type="date" class="form-control-warm" required />
                </div>
                <span asp-validation-for="StartDate" class="text-danger small"></span>
            </div>

            <!-- End Date -->
            <div class="col-md-6">
                <label asp-for="EndDate" class="form-label-warm">Closing Date</label>
                <div class="input-group-warm">
                    <span class="input-icon-warm"><i class="fa-solid fa-calendar"></i></span>
                    <input asp-for="EndDate" type="date" class="form-control-warm" required />
                </div>
                <span asp-validation-for="EndDate" class="text-danger small"></span>
            </div>

            <!-- Is Current -->
            <div class="col-12 mt-3">
                <div class="form-check">
                    <input asp-for="IsCurrent" type="checkbox" class="form-check-input" style="cursor: pointer;" id="isCurrentFY" />
                    <label class="form-check-label small fw-bold text-dark" for="isCurrentFY" style="cursor: pointer;">
                        Set as Active Operational Financial Year immediately
                    </label>
                </div>
            </div>
        </div>

        <!-- Form Buttons -->
        <div class="d-flex justify-content-end gap-3 mt-4">
            <a href="/FinancialYear" class="btn btn-secondary-warm" style="border: 1px solid var(--border-warm); background-color: #ffffff; color: var(--text-color); padding: 0.75rem 2rem; border-radius: 8px; font-weight: 600; font-size: 0.9rem; text-decoration: none;">Cancel</a>
            <button type="submit" class="btn btn-primary-warm" style="background: linear-gradient(135deg, var(--primary-warm) 0%, #6366f1 100%); color: #ffffff; border: none; padding: 0.75rem 2rem; border-radius: 8px; font-weight: 600; font-size: 0.9rem; box-shadow: 0 4px 10px rgba(79, 70, 229, 0.2);">Register FY</button>
        </div>
    </form>
</div>

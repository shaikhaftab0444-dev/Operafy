@model IEnumerable<ERP_System.Models.HRHoliday>
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Company Holiday Calendar";
}

<div class="container-fluid py-4 text-start">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-bold mb-1"><i class="fa-solid fa-calendar-days text-primary me-2"></i>Company Holiday Calendar</h4>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0 small">
                    <li class="breadcrumb-item"><a href="/Dashboard" class="text-decoration-none">Admin Dashboard</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Holiday Calendar</li>
                </ol>
            </nav>
        </div>
    </div>

    <!-- Holidays Table -->
    <div class="bg-white border rounded-3 p-4 shadow-sm" style="max-width: 700px;">
        <h5 class="fw-bold mb-3">Holiday Calendar</h5>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" style="font-size: 0.85rem;">
                <thead class="table-light">
                    <tr>
                        <th>Holiday Name</th>
                        <th>Holiday Date</th>
                        <th>Type</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var h in Model)
                        {
                            <tr>
                                <td class="fw-bold text-dark">@h.HolidayName</td>
                                <td class="text-muted">@h.Date.ToString("dd MMM yyyy")</td>
                                <td><span class="badge bg-secondary-subtle text-secondary">National Holiday</span></td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="3" class="text-center py-4 text-muted">No holidays seeded.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@model ERP_System.Models.DepartmentViewModel
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Department Master";
}

<div class="container-fluid py-4 text-start">
    <!-- Header controls -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-4">
        <div>
            <h4 class="fw-bold mb-1"><i class="fa-solid fa-sitemap text-primary me-2"></i>Department Master</h4>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0 small">
                    <li class="breadcrumb-item"><a href="/Dashboard" class="text-decoration-none">Dashboard</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Department Master</li>
                </ol>
            </nav>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <!-- Filter & Search Controls -->
            <form action="/AdminMaster/Departments" method="get" class="d-flex flex-wrap gap-2 align-items-center">
                <div class="input-group input-group-sm" style="width: 220px;">
                    <span class="input-group-text bg-light text-secondary border-end-0 small fw-semibold">Branch</span>
                    <select name="branchId" class="form-select border-start-0" onchange="this.form.submit()">
                        <option value="0" selected="@(Model.SelectedBranchId == 0 ? "selected" : null)">All Branches</option>
                        @foreach (var b in Model.Branches)
                        {
                            <option value="@b.BranchId" selected="@(Model.SelectedBranchId == b.BranchId ? "selected" : null)">@b.BranchName</option>
                        }
                    </select>
                </div>
                <div class="input-group input-group-sm" style="width: 220px;">
                    <span class="input-group-text bg-white border-end-0"><i class="fa-solid fa-magnifying-glass text-muted"></i></span>
                    <input type="text" name="search" class="form-control border-start-0 ps-0" placeholder="Search departments..." value="@Model.SearchTerm" />
                    <button type="submit" class="btn btn-outline-primary">Go</button>
                </div>
            </form>

            <button class="btn btn-primary rounded-pill px-3 btn-sm shadow-sm" data-bs-toggle="modal" data-bs-target="#addDeptModal">
                <i class="fa-solid fa-plus me-1.5"></i>Add Department
            </button>
        </div>
    </div>

    <!-- Alert Notifications -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show small py-2" role="alert" style="max-width: 900px;">
            <i class="fa-solid fa-circle-check me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close py-2" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show small py-2" role="alert" style="max-width: 900px;">
            <i class="fa-solid fa-triangle-exclamation me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close py-2" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Departments Data Table -->
    <div class="bg-white border rounded-3 p-4 shadow-sm" style="max-width: 1100px;">
        <h5 class="fw-bold mb-3">Enterprise Departments</h5>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" style="font-size: 0.85rem;">
                <thead class="table-light text-uppercase fw-bold text-secondary" style="font-size: 0.75rem; letter-spacing: 0.5px;">
                    <tr>
                        <th>Dept Code</th>
                        <th>Department Name</th>
                        <th>Assigned Branch</th>
                        <th>Department HOD</th>
                        <th>Parent Hierarchy</th>
                        <th>Staff Count</th>
                        <th>Status</th>
                        <th class="text-center">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Departments != null && Model.Departments.Any())
                    {
                        @foreach (var d in Model.Departments)
                        {
                            var random = new Random(d.DepartmentId);
                            var staffCount = random.Next(4, 18); // Mocked employee count per Dynamics 365 dashboard standard
                            
                            <tr>
                                <td class="fw-bold text-dark"><code>@d.DepartmentCode</code></td>
                                <td>@d.DepartmentName</td>
                                <td><span class="text-secondary"><i class="fa-solid fa-building me-1.5 small text-muted"></i>@(d.Branch != null ? d.Branch.BranchName : "Head Office")</span></td>
                                <td>
                                    @if (d.HOD != null)
                                    {
                                        <div class="d-flex align-items-center">
                                            <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center me-2" style="width: 28px; height: 28px; font-size: 0.75rem;">
                                                <i class="fa-solid fa-user-tie"></i>
                                            </div>
                                            <div>
                                                <div class="fw-semibold">@d.HOD.FullName</div>
                                                <div class="text-muted small" style="font-size: 0.7rem;">@d.HOD.Email</div>
                                            </div>
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">Not Assigned</span>
                                    }
                                </td>
                                <td>
                                    @if (d.ParentDepartment != null)
                                    {
                                        <span class="badge bg-light text-secondary border">@d.ParentDepartment.DepartmentName</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">-</span>
                                    }
                                </td>
                                <td>
                                    <span class="badge bg-primary-subtle text-primary border rounded-pill px-2.5">@staffCount Employees</span>
                                </td>
                                <td>
                                    @if (d.IsActive)
                                    {
                                        <span class="badge bg-success-subtle text-success rounded-pill px-2.5">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger-subtle text-danger rounded-pill px-2.5">Inactive</span>
                                    }
                                </td>
                                <td class="text-center">
                                    <div class="d-flex justify-content-center gap-1">
                                        <!-- Toggle Status -->
                                        <form action="/AdminMaster/ToggleDepartmentStatus" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@d.DepartmentId" />
                                            <button type="submit" class="btn btn-sm btn-outline-warning py-1 px-2.5 rounded-pill" title="Toggle Status">
                                                <i class="fa-solid @(d.IsActive ? "fa-ban" : "fa-check")"></i>
                                            </button>
                                        </form>

                                        <!-- Delete -->
                                        <form action="/AdminMaster/DeleteDepartment" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this department?')">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@d.DepartmentId" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger py-1 px-2.5 rounded-pill" title="Delete">
                                                <i class="fa-solid fa-trash-can"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Add Department Modal -->
<div class="modal fade text-start" id="addDeptModal" tabindex="-1" aria-labelledby="addDeptLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form action="/AdminMaster/CreateDepartment" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title fw-bold" id="addDeptLabel">Add Department</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Department Code</label>
                        <input type="text" name="DepartmentCode" class="form-control text-uppercase" placeholder="e.g. HR-DEPT" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Department Name</label>
                        <input type="text" name="DepartmentName" class="form-control" placeholder="e.g. Human Resources" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Assigned Branch</label>
                        <select name="BranchId" class="form-select" required>
                            @foreach (var b in Model.Branches)
                            {
                                <option value="@b.BranchId">@b.BranchName</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Head of Department (HOD)</label>
                        <select name="HODId" class="form-select">
                            <option value="">-- Select HOD --</option>
                            @foreach (var u in Model.StaffList)
                            {
                                <option value="@u.UserId">@u.FullName (@u.Email)</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Parent Department (For Hierarchy)</label>
                        <select name="ParentDepartmentId" class="form-select">
                            <option value="">-- No Parent (Top Level) --</option>
                            @foreach (var d in Model.Departments ?? new List<ERP_System.Models.Department>())
                            {
                                <option value="@d.DepartmentId">@d.DepartmentName (@d.DepartmentCode)</option>
                            }
                        </select>
                    </div>
                    <div class="form-check form-switch mb-3">
                        <input class="form-check-input" type="checkbox" name="IsActive" value="true" checked id="isActiveDept">
                        <label class="form-check-label small fw-semibold" for="isActiveDept">Active Department</label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary rounded-pill px-3 btn-sm" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary rounded-pill px-3 btn-sm">Save Department</button>
                </div>
            </form>
        </div>
    </div>
</div>

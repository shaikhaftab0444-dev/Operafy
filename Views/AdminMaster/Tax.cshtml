@model ERP_System.Models.TaxViewModel

@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Tax Slabs & GST/VAT Master";

    var taxSlabs = Model.TaxSlabs ?? new List<ERP_System.Models.TaxSlab>();

    var totalSlabs = taxSlabs.Count;
    var activeSlabs = taxSlabs.Count(x => x.IsActive);
    var inactiveSlabs = totalSlabs - activeSlabs;
    var gstSlabs = taxSlabs.Count(x => x.Category == "GST");
}

<style>
    /* =========================================================
           TAX MASTER - PREMIUM ERP UI
           ========================================================= */

    :root {
        --tax-primary: #4f46e5;
        --tax-primary-dark: #3730a3;
        --tax-primary-soft: #eef2ff;
        --tax-success: #10b981;
        --tax-success-soft: #ecfdf5;
        --tax-warning: #f59e0b;
        --tax-warning-soft: #fffbeb;
        --tax-danger: #ef4444;
        --tax-danger-soft: #fef2f2;
        --tax-info: #06b6d4;
        --tax-info-soft: #ecfeff;
        --tax-text: #172033;
        --tax-muted: #64748b;
        --tax-border: #e7ebf2;
        --tax-bg: #f6f8fc;
        --tax-card: #ffffff;
    }

    /* Page */
    .tax-page {
        min-height: 100vh;
        background: radial-gradient(circle at 0% 0%, rgba(79, 70, 229, .07), transparent 28%), radial-gradient(circle at 100% 0%, rgba(6, 182, 212, .05), transparent 24%), var(--tax-bg);
        padding-bottom: 40px;
    }

    /* Animation */
    .tax-animate {
        opacity: 0;
        transform: translateY(18px);
        animation: taxFadeUp .55s cubic-bezier(.22, .61, .36, 1) forwards;
    }

    .tax-delay-1 {
        animation-delay: .08s;
    }

    .tax-delay-2 {
        animation-delay: .16s;
    }

    .tax-delay-3 {
        animation-delay: .24s;
    }

    .tax-delay-4 {
        animation-delay: .32s;
    }

    @@keyframes taxFadeUp {
        to

    {
        opacity: 1;
        transform: translateY(0);
    }

    }

    @@keyframes taxFadeIn {
        from

    {
        opacity: 0;
    }

    to {
        opacity: 1;
    }

    }

    @@keyframes taxPulse {
        0%, 100%

    {
        transform: scale(1);
    }

    50% {
        transform: scale(1.06);
    }

    }

    @@keyframes taxShine {
        0%

    {
        transform: translateX(-120%);
    }

    100% {
        transform: translateX(120%);
    }

    }

    /* Header */
    .tax-header {
        position: relative;
        overflow: hidden;
        background: linear-gradient(135deg, #ffffff 0%, #f8faff 100%);
        border: 1px solid var(--tax-border);
        border-radius: 22px;
        padding: 22px 24px;
        box-shadow: 0 10px 30px rgba(15, 23, 42, .05);
    }

        .tax-header::after {
            content: "";
            position: absolute;
            width: 180px;
            height: 180px;
            right: -80px;
            top: -100px;
            background: rgba(79, 70, 229, .07);
            border-radius: 50%;
            pointer-events: none;
        }

    .tax-title-wrap {
        display: flex;
        align-items: center;
        gap: 14px;
    }

    .tax-title-icon {
        width: 50px;
        height: 50px;
        flex: 0 0 50px;
        border-radius: 15px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        background: linear-gradient(135deg, var(--tax-primary), #7c3aed);
        box-shadow: 0 9px 22px rgba(79, 70, 229, .24);
        animation: taxPulse 3s ease-in-out infinite;
    }

    .tax-page-title {
        color: var(--tax-text);
        font-size: 1.35rem;
        font-weight: 750;
        letter-spacing: -.35px;
        margin: 0;
    }

    .tax-subtitle {
        color: var(--tax-muted);
        font-size: .78rem;
        margin-top: 3px;
    }

    .tax-breadcrumb {
        margin-top: 8px;
    }

        .tax-breadcrumb .breadcrumb-item {
            font-size: .74rem;
        }

        .tax-breadcrumb a {
            color: var(--tax-primary);
            font-weight: 600;
        }

    /* Buttons */
    .tax-btn-primary {
        position: relative;
        overflow: hidden;
        border: 0;
        color: #fff;
        font-weight: 650;
        background: linear-gradient(135deg, var(--tax-primary), #6366f1);
        box-shadow: 0 7px 18px rgba(79, 70, 229, .20);
        transition: all .25s ease;
    }

        .tax-btn-primary::before {
            content: "";
            position: absolute;
            inset: 0 auto 0 0;
            width: 40%;
            background: linear-gradient(90deg, transparent, rgba(255,255,255,.25), transparent);
            transform: translateX(-120%);
        }

        .tax-btn-primary:hover::before {
            animation: taxShine .8s ease;
        }

        .tax-btn-primary:hover {
            color: #fff;
            transform: translateY(-2px);
            box-shadow: 0 11px 24px rgba(79, 70, 229, .30);
        }

        .tax-btn-primary:active {
            transform: translateY(0);
        }

    .tax-regime-group {
        border: 1px solid var(--tax-border);
        border-radius: 999px;
        overflow: hidden;
        background: #fff;
        box-shadow: 0 5px 15px rgba(15, 23, 42, .04);
    }

        .tax-regime-group .input-group-text {
            border: 0;
            background: #f8fafc;
            color: var(--tax-muted);
        }

        .tax-regime-group .form-select {
            min-width: 135px;
            border: 0;
            box-shadow: none;
        }

    /* Alerts */
    .tax-alert {
        border: 0;
        border-radius: 14px;
        box-shadow: 0 6px 18px rgba(15, 23, 42, .05);
        animation: taxFadeIn .4s ease;
    }

    /* Statistics */
    .tax-stat-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 15px;
        margin-bottom: 20px;
    }

    .tax-stat-card {
        position: relative;
        overflow: hidden;
        min-height: 112px;
        padding: 18px;
        background: var(--tax-card);
        border: 1px solid var(--tax-border);
        border-radius: 17px;
        box-shadow: 0 7px 22px rgba(15, 23, 42, .045);
        transition: transform .25s ease, box-shadow .25s ease, border-color .25s ease;
    }

        .tax-stat-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 15px 30px rgba(15, 23, 42, .09);
            border-color: rgba(79, 70, 229, .18);
        }

        .tax-stat-card::after {
            content: "";
            position: absolute;
            width: 90px;
            height: 90px;
            right: -35px;
            bottom: -45px;
            border-radius: 50%;
            background: rgba(79, 70, 229, .05);
        }

    .tax-stat-icon {
        width: 42px;
        height: 42px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 12px;
        font-size: 1rem;
        margin-bottom: 12px;
    }

        .tax-stat-icon.primary {
            color: var(--tax-primary);
            background: var(--tax-primary-soft);
        }

        .tax-stat-icon.success {
            color: var(--tax-success);
            background: var(--tax-success-soft);
        }

        .tax-stat-icon.warning {
            color: var(--tax-warning);
            background: var(--tax-warning-soft);
        }

        .tax-stat-icon.info {
            color: var(--tax-info);
            background: var(--tax-info-soft);
        }

    .tax-stat-value {
        color: var(--tax-text);
        font-size: 1.45rem;
        line-height: 1;
        font-weight: 750;
    }

    .tax-stat-label {
        color: var(--tax-muted);
        font-size: .73rem;
        font-weight: 600;
        margin-top: 5px;
    }

    /* Main card */
    .tax-main-card {
        background: #fff;
        border: 1px solid var(--tax-border);
        border-radius: 20px;
        overflow: hidden;
        box-shadow: 0 9px 28px rgba(15, 23, 42, .055);
    }

    .tax-card-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 15px;
        padding: 20px 22px;
        border-bottom: 1px solid var(--tax-border);
        background: linear-gradient(180deg, #fff, #fbfcff);
    }

    .tax-section-title {
        color: var(--tax-text);
        font-size: .98rem;
        font-weight: 750;
        margin: 0;
    }

    .tax-section-subtitle {
        color: var(--tax-muted);
        font-size: .72rem;
        margin-top: 3px;
    }

    .tax-count-pill {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 6px 10px;
        border-radius: 999px;
        color: var(--tax-primary);
        background: var(--tax-primary-soft);
        font-size: .7rem;
        font-weight: 700;
        white-space: nowrap;
    }

    /* Table */
    .tax-table-wrap {
        overflow-x: auto;
    }

    .tax-table {
        width: 100%;
        min-width: 1050px;
        margin: 0;
        border-collapse: separate;
        border-spacing: 0;
    }

        .tax-table thead th {
            padding: 13px 15px;
            color: #64748b;
            background: #f8fafc;
            border-bottom: 1px solid var(--tax-border);
            font-size: .67rem;
            font-weight: 750;
            text-transform: uppercase;
            letter-spacing: .55px;
            white-space: nowrap;
        }

        .tax-table tbody td {
            padding: 15px;
            color: #334155;
            border-bottom: 1px solid #eef1f5;
            font-size: .78rem;
            vertical-align: middle;
        }

        .tax-table tbody tr {
            transition: background .2s ease, transform .2s ease;
        }

            .tax-table tbody tr:hover {
                background: #fafbff;
            }

            .tax-table tbody tr:last-child td {
                border-bottom: 0;
            }

    .tax-code {
        display: inline-flex;
        align-items: center;
        padding: 5px 8px;
        border-radius: 7px;
        color: var(--tax-primary-dark);
        background: var(--tax-primary-soft);
        font-size: .72rem;
        font-weight: 750;
        letter-spacing: .2px;
    }

    .tax-description {
        color: var(--tax-text);
        font-weight: 650;
        margin-bottom: 3px;
    }

    .tax-meta {
        color: var(--tax-muted);
        font-size: .69rem;
    }

    .tax-rate {
        color: var(--tax-text);
        font-size: .95rem;
        font-weight: 800;
        white-space: nowrap;
    }

    .tax-rate-symbol {
        color: var(--tax-muted);
        font-size: .72rem;
        font-weight: 600;
    }

    /* Badges */
    .tax-badge {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        padding: 5px 8px;
        border: 1px solid transparent;
        border-radius: 7px;
        font-size: .64rem;
        font-weight: 700;
        margin: 2px;
        white-space: nowrap;
    }

    .tax-badge-primary {
        color: #4338ca;
        background: #eef2ff;
        border-color: #dfe5ff;
    }

    .tax-badge-info {
        color: #0891b2;
        background: #ecfeff;
        border-color: #cffafe;
    }

    .tax-badge-warning {
        color: #b45309;
        background: #fffbeb;
        border-color: #fef3c7;
    }

    .tax-badge-secondary {
        color: #475569;
        background: #f8fafc;
        border-color: #e2e8f0;
    }

    .tax-status {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 5px 9px;
        border-radius: 999px;
        font-size: .66rem;
        font-weight: 750;
        white-space: nowrap;
    }

        .tax-status::before {
            content: "";
            width: 6px;
            height: 6px;
            border-radius: 50%;
            background: currentColor;
        }

    .tax-status-active {
        color: #059669;
        background: #ecfdf5;
    }

    .tax-status-inactive {
        color: #dc2626;
        background: #fef2f2;
    }

    /* Action buttons */
    .tax-action-btn {
        width: 34px;
        height: 34px;
        padding: 0;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 10px !important;
        transition: all .22s ease;
    }

        .tax-action-btn:hover {
            transform: translateY(-2px);
        }

    .tax-action-warning:hover {
        color: #b45309;
        background: #fffbeb;
        border-color: #fcd34d;
    }

    .tax-action-danger:hover {
        color: #dc2626;
        background: #fef2f2;
        border-color: #fca5a5;
    }

    /* Empty state */
    .tax-empty {
        padding: 55px 20px !important;
        text-align: center;
    }

    .tax-empty-icon {
        width: 65px;
        height: 65px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 14px;
        border-radius: 18px;
        color: #94a3b8;
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        font-size: 1.4rem;
    }

    .tax-empty-title {
        color: var(--tax-text);
        font-weight: 700;
        font-size: .92rem;
    }

    .tax-empty-text {
        color: var(--tax-muted);
        font-size: .75rem;
        margin-top: 4px;
    }

    /* Modal */
    .tax-modal .modal-dialog {
        max-width: 720px;
    }

    .tax-modal .modal-content {
        border: 0;
        border-radius: 22px;
        overflow: hidden;
        box-shadow: 0 25px 70px rgba(15, 23, 42, .22);
        animation: taxModalIn .3s ease;
    }

    @@keyframes taxModalIn {
        from

    {
        opacity: 0;
        transform: translateY(20px) scale(.97);
    }

    to {
        opacity: 1;
        transform: translateY(0) scale(1);
    }

    }

    .tax-modal-header {
        padding: 20px 22px;
        color: #fff;
        border: 0;
        background: linear-gradient(135deg, var(--tax-primary), #7c3aed);
    }

    .tax-modal-icon {
        width: 40px;
        height: 40px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        margin-right: 10px;
        border-radius: 11px;
        color: #fff;
        background: rgba(255,255,255,.16);
    }

    .tax-modal .btn-close {
        filter: brightness(0) invert(1);
        opacity: .85;
    }

    .tax-modal-title {
        display: flex;
        align-items: center;
        color: #fff;
        font-size: 1rem;
        font-weight: 750;
    }

    .tax-modal-subtitle {
        color: rgba(255,255,255,.72);
        font-size: .7rem;
        margin-top: 2px;
    }

    .tax-modal-body {
        padding: 24px;
        background: #fff;
    }

    .tax-form-section {
        padding: 16px;
        margin-bottom: 16px;
        border: 1px solid var(--tax-border);
        border-radius: 15px;
        background: #fbfcff;
    }

        .tax-form-section:last-child {
            margin-bottom: 0;
        }

    .tax-form-section-title {
        display: flex;
        align-items: center;
        gap: 7px;
        color: var(--tax-text);
        font-size: .78rem;
        font-weight: 750;
        margin-bottom: 13px;
    }

        .tax-form-section-title i {
            color: var(--tax-primary);
        }

    .tax-form-label {
        display: block;
        color: #475569;
        font-size: .69rem;
        font-weight: 700;
        margin-bottom: 6px;
    }

    .tax-required {
        color: #ef4444;
    }

    .tax-modal .form-control,
    .tax-modal .form-select {
        min-height: 39px;
        border: 1px solid #dfe4ec;
        border-radius: 10px;
        font-size: .78rem;
        box-shadow: none;
        transition: all .2s ease;
    }

    .tax-modal textarea.form-control {
        min-height: auto;
    }

    .tax-modal .form-control:focus,
    .tax-modal .form-select:focus {
        border-color: #818cf8;
        box-shadow: 0 0 0 3px rgba(99,102,241,.10);
        transform: translateY(-1px);
    }

    .tax-gst-box {
        padding: 15px;
        border: 1px solid #dfe5ff;
        border-radius: 13px;
        background: linear-gradient(135deg, #f7f8ff, #fbfcff);
    }

    .tax-gst-title {
        color: var(--tax-primary-dark);
        font-size: .73rem;
        font-weight: 750;
        margin-bottom: 11px;
    }

    .tax-readonly {
        background: #f1f5f9 !important;
        color: #64748b;
        font-weight: 700;
    }

    .tax-modal-footer {
        padding: 16px 22px;
        border-top: 1px solid var(--tax-border);
        background: #f8fafc;
    }

    /* Switch */
    .tax-switch .form-check-input {
        width: 2.25em;
        height: 1.2em;
        cursor: pointer;
    }

        .tax-switch .form-check-input:checked {
            background-color: var(--tax-primary);
            border-color: var(--tax-primary);
        }

    .tax-switch .form-check-label {
        color: #475569;
        font-size: .72rem;
        font-weight: 650;
        cursor: pointer;
    }

    /* Responsive */
    @@media (max-width: 992px) {
        .tax-stat-grid

    {
        grid-template-columns: repeat(2, 1fr);
    }

    .tax-card-header {
        align-items: flex-start;
    }

    }

    @@media (max-width: 768px) {
        .tax-page

    {
        padding-top: 10px;
    }

    .tax-header {
        padding: 18px;
        border-radius: 17px;
    }

    .tax-title-wrap {
        align-items: flex-start;
    }

    .tax-title-icon {
        width: 43px;
        height: 43px;
        flex-basis: 43px;
    }

    .tax-page-title {
        font-size: 1.12rem;
    }

    .tax-header-actions {
        width: 100%;
    }

    .tax-regime-group {
        width: 100%;
    }

        .tax-regime-group .form-select {
            flex: 1;
        }

    .tax-btn-primary {
        width: 100%;
    }

    .tax-stat-grid {
        grid-template-columns: repeat(2, 1fr);
        gap: 10px;
    }

    .tax-stat-card {
        min-height: 105px;
        padding: 14px;
    }

    .tax-main-card {
        border-radius: 16px;
    }

    .tax-card-header {
        padding: 16px;
        flex-direction: column;
    }

    .tax-count-pill {
        align-self: flex-start;
    }

    /*
                Mobile table becomes card-like rows.
                This keeps all existing data usable without tiny text.
            */
    .tax-table-wrap {
        overflow: visible;
    }

    .tax-table,
    .tax-table tbody,
    .tax-table tr,
    .tax-table td {
        display: block;
        width: 100%;
    }

    .tax-table {
        min-width: 0;
    }

        .tax-table thead {
            display: none;
        }

        .tax-table tbody {
            padding: 12px;
        }

            .tax-table tbody tr {
                margin-bottom: 12px;
                border: 1px solid var(--tax-border);
                border-radius: 15px;
                overflow: hidden;
                background: #fff;
                box-shadow: 0 5px 15px rgba(15,23,42,.035);
            }

                .tax-table tbody tr:hover {
                    transform: translateY(-2px);
                    background: #fff;
                }

            .tax-table tbody td {
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: 15px;
                padding: 10px 13px;
                border-bottom: 1px solid #f0f2f5;
                text-align: right;
            }

                .tax-table tbody td:last-child {
                    border-bottom: 0;
                }

                .tax-table tbody td::before {
                    content: attr(data-label);
                    flex: 0 0 auto;
                    color: #64748b;
                    font-size: .65rem;
                    font-weight: 750;
                    text-transform: uppercase;
                    letter-spacing: .4px;
                    text-align: left;
                }

                .tax-table tbody td[data-label="Tax Code"],
                .tax-table tbody td[data-label="Description"] {
                    align-items: flex-start;
                }

                .tax-table tbody td[data-label="Description"] {
                    flex-direction: column;
                    gap: 4px;
                    text-align: left;
                }

                    .tax-table tbody td[data-label="Description"]::before {
                        width: 100%;
                    }

                .tax-table tbody td[data-label="Tax Breakdown"] {
                    flex-wrap: wrap;
                }

                    .tax-table tbody td[data-label="Tax Breakdown"]::before {
                        width: 100%;
                    }

                .tax-table tbody td[data-label="Actions"] {
                    justify-content: flex-end;
                    background: #fafbff;
                }

                    .tax-table tbody td[data-label="Actions"]::before {
                        margin-right: auto;
                    }

    .tax-modal-body {
        padding: 17px;
    }

    .tax-form-section {
        padding: 13px;
    }

    }

    @@media (max-width: 480px) {
        .tax-stat-grid

    {
        grid-template-columns: 1fr 1fr;
    }

    .tax-stat-value {
        font-size: 1.2rem;
    }

    .tax-stat-label {
        font-size: .66rem;
    }

    .tax-stat-icon {
        width: 36px;
        height: 36px;
        margin-bottom: 9px;
    }

    .tax-page-title {
        font-size: 1rem;
    }

    .tax-title-icon {
        width: 39px;
        height: 39px;
        flex-basis: 39px;
    }

    .tax-table tbody td {
        font-size: .73rem;
    }

    }

    /* Reduced motion accessibility */
    @@media (prefers-reduced-motion: reduce) {
        *, *::before, *::after

    {
        animation-duration: .01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: .01ms !important;
    }

    }
</style>

<div class="container-fluid py-4 text-start tax-page">

    <!-- =====================================================
         HEADER
         ===================================================== -->
    <div class="tax-header tax-animate">

        <div class="d-flex flex-column flex-lg-row justify-content-between align-items-start align-items-lg-center gap-3">

            <div class="tax-title-wrap">

                <div class="tax-title-icon">
                    <i class="fa-solid fa-percent"></i>
                </div>

                <div>
                    <h1 class="tax-page-title">
                        Tax Slabs & GST / VAT Master
                    </h1>

                    <div class="tax-subtitle">
                        Manage corporate tax rules, GST components and tax configurations
                    </div>

                    <nav aria-label="breadcrumb" class="tax-breadcrumb">
                        <ol class="breadcrumb mb-0">
                            <li class="breadcrumb-item">
                                <a href="/Dashboard" class="text-decoration-none">
                                    <i class="fa-solid fa-house me-1"></i>Dashboard
                                </a>
                            </li>

                            <li class="breadcrumb-item active" aria-current="page">
                                Tax Slabs
                            </li>
                        </ol>
                    </nav>
                </div>

            </div>

            <div class="tax-header-actions d-flex flex-wrap gap-2">

                <!-- Regime Filter -->
                <form action="/AdminMaster/Tax" method="get">
                    <div class="input-group input-group-sm tax-regime-group">

                        <span class="input-group-text">
                            <i class="fa-solid fa-filter me-2"></i>
                            Tax Regime
                        </span>

                        <select name="regime"
                                class="form-select"
                                onchange="this.form.submit()">

                            <option value="All"
                                    selected="@(Model.SelectedRegime == "All" ? "selected" : null)">
                                All Regimes
                            </option>

                            <option value="GST India"
                                    selected="@(Model.SelectedRegime == "GST India" ? "selected" : null)">
                                GST India
                            </option>

                            <option value="VAT"
                                    selected="@(Model.SelectedRegime == "VAT" ? "selected" : null)">
                                VAT Regime
                            </option>

                            <option value="Sales Tax"
                                    selected="@(Model.SelectedRegime == "Sales Tax" ? "selected" : null)">
                                Sales Tax
                            </option>

                        </select>

                    </div>
                </form>

                <!-- Add Button -->
                <button type="button"
                        class="btn tax-btn-primary rounded-pill px-4 btn-sm"
                        data-bs-toggle="modal"
                        data-bs-target="#addTaxSlabModal">

                    <i class="fa-solid fa-plus me-2"></i>
                    Add Tax Slab

                </button>

            </div>

        </div>

    </div>


    <!-- =====================================================
         ALERTS
         ===================================================== -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success tax-alert alert-dismissible fade show small py-3 mt-3 tax-animate tax-delay-1"
             role="alert">

            <i class="fa-solid fa-circle-check me-2"></i>
            @TempData["SuccessMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Close"></button>

        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger tax-alert alert-dismissible fade show small py-3 mt-3 tax-animate tax-delay-1"
             role="alert">

            <i class="fa-solid fa-triangle-exclamation me-2"></i>
            @TempData["ErrorMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Close"></button>

        </div>
    }


    <!-- =====================================================
         STATISTICS
         ===================================================== -->

    <div class="tax-stat-grid mt-4">

        <!-- Total -->
        <div class="tax-stat-card tax-animate tax-delay-1">

            <div class="tax-stat-icon primary">
                <i class="fa-solid fa-layer-group"></i>
            </div>

            <div class="tax-stat-value">
                @totalSlabs
            </div>

            <div class="tax-stat-label">
                Total Tax Slabs
            </div>

        </div>


        <!-- Active -->
        <div class="tax-stat-card tax-animate tax-delay-2">

            <div class="tax-stat-icon success">
                <i class="fa-solid fa-circle-check"></i>
            </div>

            <div class="tax-stat-value">
                @activeSlabs
            </div>

            <div class="tax-stat-label">
                Active Tax Rules
            </div>

        </div>


        <!-- GST -->
        <div class="tax-stat-card tax-animate tax-delay-3">

            <div class="tax-stat-icon info">
                <i class="fa-solid fa-receipt"></i>
            </div>

            <div class="tax-stat-value">
                @gstSlabs
            </div>

            <div class="tax-stat-label">
                GST Configurations
            </div>

        </div>


        <!-- Inactive -->
        <div class="tax-stat-card tax-animate tax-delay-4">

            <div class="tax-stat-icon warning">
                <i class="fa-solid fa-clock-rotate-left"></i>
            </div>

            <div class="tax-stat-value">
                @inactiveSlabs
            </div>

            <div class="tax-stat-label">
                Inactive Rules
            </div>

        </div>

    </div>


    <!-- =====================================================
         TAX TABLE
         ===================================================== -->

    <div class="tax-main-card tax-animate tax-delay-2">

        <div class="tax-card-header">

            <div>
                <h2 class="tax-section-title">
                    <i class="fa-solid fa-scale-balanced text-primary me-2"></i>
                    Corporate Tax Rules
                </h2>

                <div class="tax-section-subtitle">
                    Configure and maintain tax slabs used throughout the ERP
                </div>
            </div>

            <div class="tax-count-pill">
                <i class="fa-solid fa-list"></i>
                @totalSlabs Rules
            </div>

        </div>


        <div class="tax-table-wrap">

            <table class="tax-table">

                <thead>
                    <tr>
                        <th>Tax Code</th>
                        <th>Description</th>
                        <th>Regime / Category</th>
                        <th>Rate</th>
                        <th>Tax Breakdown</th>
                        <th>Effective Date</th>
                        <th>Status</th>
                        <th class="text-center">Actions</th>
                    </tr>
                </thead>


                <tbody>

                    @if (taxSlabs.Any())
                    {
                        foreach (var slab in taxSlabs)
                        {
                            <tr>

                                <!-- Tax Code -->
                                <td data-label="Tax Code">

                                    <span class="tax-code">
                                        <i class="fa-solid fa-hashtag me-1"></i>
                                        @slab.TaxCode
                                    </span>

                                </td>


                                <!-- Description -->
                                <td data-label="Description">

                                    <div class="tax-description">
                                        @slab.Description
                                    </div>

                                    @if (slab.IsRcmActive)
                                    {
                                        <span class="tax-badge tax-badge-warning">
                                            <i class="fa-solid fa-rotate"></i>
                                            RCM Active
                                        </span>
                                    }

                                </td>


                                <!-- Regime -->
                                <td data-label="Regime">

                                    <div class="fw-semibold text-dark">
                                        @slab.Regime
                                    </div>

                                    <div class="tax-meta">
                                        <i class="fa-solid fa-tag me-1"></i>
                                        @slab.Category
                                    </div>

                                </td>


                                <!-- Rate -->
                                <td data-label="Rate">

                                    <span class="tax-rate">
                                        @slab.CombinedRate.ToString("F2")
                                        <span class="tax-rate-symbol">%</span>
                                    </span>

                                </td>


                                <!-- Breakdown -->
                                <td data-label="Tax Breakdown">

                                    @if (slab.Category == "GST")
                                    {
                                        <span class="tax-badge tax-badge-primary">
                                            CGST @slab.CGST.ToString("F1")%
                                        </span>

                                        <span class="tax-badge tax-badge-primary">
                                            SGST @slab.SGST.ToString("F1")%
                                        </span>

                                        <span class="tax-badge tax-badge-info">
                                            IGST @slab.IGST.ToString("F1")%
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="tax-badge tax-badge-secondary">
                                            <i class="fa-solid fa-equals"></i>
                                            Flat conversion
                                        </span>
                                    }

                                </td>


                                <!-- Effective Date -->
                                <td data-label="Effective Date">

                                    <div class="fw-semibold text-dark">
                                        @slab.EffectiveDate.ToString("dd MMM yyyy")
                                    </div>

                                </td>


                                <!-- Status -->
                                <td data-label="Status">

                                    @if (slab.IsActive)
                                    {
                                        <span class="tax-status tax-status-active">
                                            Active
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="tax-status tax-status-inactive">
                                            Inactive
                                        </span>
                                    }

                                </td>


                                <!-- Actions -->
                                <td data-label="Actions">

                                    <div class="d-flex justify-content-center gap-2">

                                        <!-- Toggle -->
                                        <form action="/AdminMaster/ToggleTaxSlabStatus"
                                              method="post"
                                              class="d-inline">

                                            @Html.AntiForgeryToken()

                                            <input type="hidden"
                                                   name="id"
                                                   value="@slab.TaxSlabId" />

                                            <button type="submit"
                                                    class="btn btn-sm btn-outline-warning tax-action-btn tax-action-warning"
                                                    title="@(slab.IsActive ? "Deactivate" : "Activate")">

                                                <i class="fa-solid @(slab.IsActive ? "fa-ban" : "fa-check")"></i>

                                            </button>

                                        </form>


                                        <!-- Delete -->
                                        <form action="/AdminMaster/DeleteTaxSlab"
                                              method="post"
                                              class="d-inline"
                                              onsubmit="return confirm('Are you sure you want to delete this tax slab?');">

                                            @Html.AntiForgeryToken()

                                            <input type="hidden"
                                                   name="id"
                                                   value="@slab.TaxSlabId" />

                                            <button type="submit"
                                                    class="btn btn-sm btn-outline-danger tax-action-btn tax-action-danger"
                                                    title="Delete">

                                                <i class="fa-solid fa-trash-can"></i>

                                            </button>

                                        </form>

                                    </div>

                                </td>

                            </tr>
                        }
                    }
                    else
                    {
                        <tr>

                            <td colspan="8" class="tax-empty">

                                <div class="tax-empty-icon">
                                    <i class="fa-solid fa-folder-open"></i>
                                </div>

                                <div class="tax-empty-title">
                                    No Tax Slabs Found
                                </div>

                                <div class="tax-empty-text">
                                    There are no tax rules matching the selected regime.
                                </div>

                                <button type="button"
                                        class="btn tax-btn-primary btn-sm rounded-pill px-3 mt-3"
                                        data-bs-toggle="modal"
                                        data-bs-target="#addTaxSlabModal">

                                    <i class="fa-solid fa-plus me-1"></i>
                                    Create First Tax Slab

                                </button>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>


<!-- =========================================================
     ADD TAX SLAB MODAL
     ========================================================= -->

<div class="modal fade tax-modal"
     id="addTaxSlabModal"
     tabindex="-1"
     aria-labelledby="addTaxSlabLabel"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered modal-lg">

        <div class="modal-content">

            <form action="/AdminMaster/CreateTaxSlab" method="post">

                @Html.AntiForgeryToken()


                <!-- Modal Header -->
                <div class="modal-header tax-modal-header">

                    <div>

                        <div class="tax-modal-title">

                            <span class="tax-modal-icon">
                                <i class="fa-solid fa-plus"></i>
                            </span>

                            <div>
                                <div id="addTaxSlabLabel">
                                    Add Tax Slab & Rule
                                </div>

                                <div class="tax-modal-subtitle">
                                    Create a new tax configuration for your ERP
                                </div>
                            </div>

                        </div>

                    </div>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal"
                            aria-label="Close"></button>

                </div>


                <!-- Modal Body -->
                <div class="tax-modal-body">


                    <!-- Basic Information -->
                    <div class="tax-form-section">

                        <div class="tax-form-section-title">
                            <i class="fa-solid fa-circle-info"></i>
                            Basic Information
                        </div>


                        <div class="row g-3">

                            <!-- Tax Code -->
                            <div class="col-md-4">

                                <label class="tax-form-label">
                                    Tax Code
                                    <span class="tax-required">*</span>
                                </label>

                                <input type="text"
                                       name="TaxCode"
                                       class="form-control text-uppercase"
                                       placeholder="e.g. GST-18"
                                       required />

                            </div>


                            <!-- Description -->
                            <div class="col-md-8">

                                <label class="tax-form-label">
                                    Description
                                    <span class="tax-required">*</span>
                                </label>

                                <input type="text"
                                       name="Description"
                                       class="form-control"
                                       placeholder="e.g. Goods & Services Tax (Standard)"
                                       required />

                            </div>

                        </div>

                    </div>


                    <!-- Classification -->
                    <div class="tax-form-section">

                        <div class="tax-form-section-title">
                            <i class="fa-solid fa-layer-group"></i>
                            Tax Classification
                        </div>


                        <div class="row g-3">

                            <!-- Regime -->
                            <div class="col-md-6">

                                <label class="tax-form-label">
                                    Regime
                                </label>

                                <select name="Regime"
                                        id="modalRegime"
                                        class="form-select">

                                    <option value="GST India">
                                        GST India
                                    </option>

                                    <option value="VAT">
                                        VAT
                                    </option>

                                    <option value="Sales Tax">
                                        Sales Tax
                                    </option>

                                </select>

                            </div>


                            <!-- Category -->
                            <div class="col-md-6">

                                <label class="tax-form-label">
                                    Category
                                </label>

                                <select name="Category"
                                        id="modalCategory"
                                        class="form-select">

                                    <option value="GST">
                                        GST
                                    </option>

                                    <option value="VAT">
                                        VAT
                                    </option>

                                    <option value="Cess">
                                        Cess
                                    </option>

                                    <option value="Zero-Rated">
                                        Zero-Rated
                                    </option>

                                </select>

                            </div>

                        </div>

                    </div>


                    <!-- Rate -->
                    <div class="tax-form-section">

                        <div class="tax-form-section-title">
                            <i class="fa-solid fa-percent"></i>
                            Tax Rate
                        </div>


                        <div class="row g-3">

                            <div class="col-md-6">

                                <label class="tax-form-label">
                                    Combined Rate (%)
                                    <span class="tax-required">*</span>
                                </label>

                                <div class="input-group">

                                    <input type="number"
                                           step="0.01"
                                           name="CombinedRate"
                                           id="modalCombinedRate"
                                           class="form-control"
                                           placeholder="e.g. 18.00"
                                           required />

                                    <span class="input-group-text">
                                        %
                                    </span>

                                </div>

                            </div>

                        </div>

                    </div>


                    <!-- GST Breakdown -->
                    <div id="gstSplitFields"
                         class="tax-gst-box mb-3">

                        <div class="tax-gst-title">
                            <i class="fa-solid fa-diagram-project me-1"></i>
                            GST Components Breakdown
                        </div>


                        <div class="row g-3">

                            <!-- CGST -->
                            <div class="col-md-4">

                                <label class="tax-form-label">
                                    CGST (%)
                                </label>

                                <input type="number"
                                       step="0.01"
                                       name="CGST"
                                       id="modalCGST"
                                       class="form-control tax-readonly"
                                       readonly />

                            </div>


                            <!-- SGST -->
                            <div class="col-md-4">

                                <label class="tax-form-label">
                                    SGST (%)
                                </label>

                                <input type="number"
                                       step="0.01"
                                       name="SGST"
                                       id="modalSGST"
                                       class="form-control tax-readonly"
                                       readonly />

                            </div>


                            <!-- IGST -->
                            <div class="col-md-4">

                                <label class="tax-form-label">
                                    IGST (%)
                                </label>

                                <input type="number"
                                       step="0.01"
                                       name="IGST"
                                       id="modalIGST"
                                       class="form-control tax-readonly"
                                       readonly />

                            </div>

                        </div>

                    </div>


                    <!-- Date & Status -->
                    <div class="tax-form-section">

                        <div class="tax-form-section-title">
                            <i class="fa-solid fa-calendar-check"></i>
                            Validity & Status
                        </div>


                        <div class="row g-3">

                            <!-- Effective Date -->
                            <div class="col-md-6">

                                <label class="tax-form-label">
                                    Effective Date
                                </label>

                                <input type="date"
                                       name="EffectiveDate"
                                       class="form-control"
                                       value="@DateTime.Today.ToString("yyyy-MM-dd")"
                                       required />

                            </div>


                            <!-- RCM -->
                            <div class="col-md-3 d-flex align-items-end">

                                <div class="form-check form-switch tax-switch mb-1">

                                    <input class="form-check-input"
                                           type="checkbox"
                                           name="IsRcmActive"
                                           value="true"
                                           id="rcmSwitch">

                                    <label class="form-check-label"
                                           for="rcmSwitch">

                                        RCM Active

                                    </label>

                                </div>

                            </div>


                            <!-- Active -->
                            <div class="col-md-3 d-flex align-items-end">

                                <div class="form-check form-switch tax-switch mb-1">

                                    <input class="form-check-input"
                                           type="checkbox"
                                           name="IsActive"
                                           value="true"
                                           checked
                                           id="isActiveSlab">

                                    <label class="form-check-label"
                                           for="isActiveSlab">

                                        Active Slab

                                    </label>

                                </div>

                            </div>

                        </div>

                    </div>

                </div>


                <!-- Footer -->
                <div class="modal-footer tax-modal-footer">

                    <button type="button"
                            class="btn btn-outline-secondary btn-sm rounded-pill px-4"
                            data-bs-dismiss="modal">

                        Cancel

                    </button>

                    <button type="submit"
                            class="btn tax-btn-primary btn-sm rounded-pill px-4">

                        <i class="fa-solid fa-floppy-disk me-2"></i>
                        Save Tax Slab

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>


<!-- =========================================================
     JAVASCRIPT
     ========================================================= -->

<script>

    document.addEventListener("DOMContentLoaded", function () {

        const modalCategory =
            document.getElementById("modalCategory");

        const modalRegime =
            document.getElementById("modalRegime");

        const modalCombinedRate =
            document.getElementById("modalCombinedRate");

        const gstSplitFields =
            document.getElementById("gstSplitFields");

        const inputCGST =
            document.getElementById("modalCGST");

        const inputSGST =
            document.getElementById("modalSGST");

        const inputIGST =
            document.getElementById("modalIGST");


        /* -----------------------------------------------------
           GST AUTO CALCULATION
           ----------------------------------------------------- */

        function updateGSTSplit() {

            const combinedVal =
                parseFloat(modalCombinedRate.value) || 0;

            const categoryVal =
                modalCategory.value;


            if (categoryVal === "GST") {

                gstSplitFields.style.display = "";

                inputCGST.value =
                    (combinedVal / 2).toFixed(2);

                inputSGST.value =
                    (combinedVal / 2).toFixed(2);

                inputIGST.value =
                    combinedVal.toFixed(2);

            }
            else {

                gstSplitFields.style.display = "none";

                inputCGST.value = "0.00";
                inputSGST.value = "0.00";
                inputIGST.value = "0.00";

            }

        }


        /* -----------------------------------------------------
           RATE INPUT
           ----------------------------------------------------- */

        modalCombinedRate.addEventListener(
            "input",
            updateGSTSplit
        );


        /* -----------------------------------------------------
           CATEGORY CHANGE
           ----------------------------------------------------- */

        modalCategory.addEventListener(
            "change",
            function () {

                if (modalCategory.value === "GST") {

                    modalRegime.value = "GST India";

                }
                else if (modalCategory.value === "VAT") {

                    modalRegime.value = "VAT";

                }

                updateGSTSplit();

            }
        );


        /* -----------------------------------------------------
           MODAL OPEN ANIMATION RESET
           ----------------------------------------------------- */

        const taxModal =
            document.getElementById("addTaxSlabModal");

        if (taxModal) {

            taxModal.addEventListener(
                "shown.bs.modal",
                function () {

                    const firstInput =
                        taxModal.querySelector(
                            "input[name='TaxCode']"
                        );

                    if (firstInput) {
                        setTimeout(
                            () => firstInput.focus(),
                            250
                        );
                    }

                }
            );

        }


        /* -----------------------------------------------------
           INITIAL STATE
           ----------------------------------------------------- */

        updateGSTSplit();

    });

</script>
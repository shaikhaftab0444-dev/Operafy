@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Tax Slabs & GST / VAT Master";
}

<div class="container-fluid py-4 text-start">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-bold mb-1"><i class="fa-solid fa-percent text-primary me-2"></i>Tax Slabs & GST / VAT Master</h4>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0 small">
                    <li class="breadcrumb-item"><a href="/Dashboard" class="text-decoration-none">Admin Dashboard</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Tax Slabs</li>
                </ol>
            </nav>
        </div>
    </div>

    <!-- Tax Slabs Table -->
    <div class="bg-white border rounded-3 p-4 shadow-sm" style="max-width: 600px;">
        <h5 class="fw-bold mb-3">Active Tax Rules</h5>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" style="font-size: 0.85rem;">
                <thead class="table-light">
                    <tr>
                        <th>Tax Code</th>
                        <th>Tax Description</th>
                        <th>Rate (%)</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td class="fw-bold text-dark">GST-18</td>
                        <td>Goods & Services Tax (Standard)</td>
                        <td>18.00 %</td>
                    </tr>
                    <tr>
                        <td class="fw-bold text-dark">GST-5</td>
                        <td>Goods & Services Tax (Reduced)</td>
                        <td>5.00 %</td>
                    </tr>
                    <tr>
                        <td class="fw-bold text-dark">VAT-15</td>
                        <td>Value Added Tax</td>
                        <td>15.00 %</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

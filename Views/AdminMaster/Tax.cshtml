@model ERP_System.Models.TaxViewModel
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Tax Slabs & GST/VAT Master";
}

<div class="container-fluid py-4 text-start">
    <!-- Header with Breadcrumb and Actions -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-4">
        <div>
            <h4 class="fw-bold mb-1"><i class="fa-solid fa-percent text-primary me-2"></i>Tax Slabs & GST / VAT Master</h4>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0 small">
                    <li class="breadcrumb-item"><a href="/Dashboard" class="text-decoration-none">Dashboard</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Tax Slabs</li>
                </ol>
            </nav>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <!-- Regime Filter Dropdown -->
            <form action="/AdminMaster/Tax" method="get" class="d-inline-block">
                <div class="input-group input-group-sm">
                    <span class="input-group-text bg-light text-secondary border-end-0 small fw-semibold">Tax Regime</span>
                    <select name="regime" class="form-select border-start-0" onchange="this.form.submit()">
                        <option value="All" selected="@(Model.SelectedRegime == "All" ? "selected" : null)">All Regimes</option>
                        <option value="GST India" selected="@(Model.SelectedRegime == "GST India" ? "selected" : null)">GST India</option>
                        <option value="VAT" selected="@(Model.SelectedRegime == "VAT" ? "selected" : null)">VAT Regime</option>
                        <option value="Sales Tax" selected="@(Model.SelectedRegime == "Sales Tax" ? "selected" : null)">Sales Tax</option>
                    </select>
                </div>
            </form>

            <!-- Trigger Add Modal -->
            <button class="btn btn-primary rounded-pill px-3 btn-sm shadow-sm" data-bs-toggle="modal" data-bs-target="#addTaxSlabModal">
                <i class="fa-solid fa-plus me-1.5"></i>Add New Tax Slab
            </button>
        </div>
    </div>

    <!-- Alert Notifications -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show small py-2" role="alert" style="max-width: 900px;">
            <i class="fa-solid fa-circle-check me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close py-2" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show small py-2" role="alert" style="max-width: 900px;">
            <i class="fa-solid fa-triangle-exclamation me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close py-2" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Tax Slabs Table -->
    <div class="bg-white border rounded-3 p-4 shadow-sm" style="max-width: 1000px;">
        <h5 class="fw-bold mb-3">Active Corporate Tax Rules</h5>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" style="font-size: 0.85rem;">
                <thead class="table-light text-uppercase fw-bold text-secondary" style="font-size: 0.75rem; letter-spacing: 0.5px;">
                    <tr>
                        <th>Tax Code</th>
                        <th>Description</th>
                        <th>Regime / Category</th>
                        <th>Rate (%)</th>
                        <th>Tax Breakdown Badges</th>
                        <th>Effective Date</th>
                        <th>Status</th>
                        <th class="text-center">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.TaxSlabs != null && Model.TaxSlabs.Any())
                    {
                        @foreach (var slab in Model.TaxSlabs)
                        {
                            <tr>
                                <td class="fw-bold text-dark"><code>@slab.TaxCode</code></td>
                                <td>
                                    @slab.Description
                                    @if (slab.IsRcmActive)
                                    {
                                        <span class="badge bg-warning-subtle text-warning border ms-1.5" style="font-size: 0.65rem;">RCM Active</span>
                                    }
                                </td>
                                <td>@slab.Regime / <span class="text-muted">@slab.Category</span></td>
                                <td class="fw-bold text-dark">@slab.CombinedRate.ToString("F2") %</td>
                                <td>
                                    @if (slab.Category == "GST")
                                    {
                                        <span class="badge bg-primary-subtle text-primary border me-1">CGST: @slab.CGST.ToString("F1")%</span>
                                        <span class="badge bg-primary-subtle text-primary border me-1">SGST: @slab.SGST.ToString("F1")%</span>
                                        <span class="badge bg-info-subtle text-info border">IGST: @slab.IGST.ToString("F1")%</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary border">Flat conversion</span>
                                    }
                                </td>
                                <td class="text-muted">@slab.EffectiveDate.ToString("dd MMM yyyy")</td>
                                <td>
                                    @if (slab.IsActive)
                                    {
                                        <span class="badge bg-success-subtle text-success rounded-pill px-2.5">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger-subtle text-danger rounded-pill px-2.5">Inactive</span>
                                    }
                                </td>
                                <td class="text-center">
                                    <div class="d-flex justify-content-center gap-1">
                                        <!-- Toggle active -->
                                        <form action="/AdminMaster/ToggleTaxSlabStatus" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@slab.TaxSlabId" />
                                            <button type="submit" class="btn btn-sm btn-outline-warning py-1 px-2.5 rounded-pill" title="Toggle Status">
                                                <i class="fa-solid @(slab.IsActive ? "fa-ban" : "fa-check")"></i>
                                            </button>
                                        </form>

                                        <!-- Delete -->
                                        <form action="/AdminMaster/DeleteTaxSlab" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this tax slab?')">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@slab.TaxSlabId" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger py-1 px-2.5 rounded-pill" title="Delete">
                                                <i class="fa-solid fa-trash-can"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Add Tax Slab Modal -->
<div class="modal fade text-start" id="addTaxSlabModal" tabindex="-1" aria-labelledby="addTaxSlabLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form action="/AdminMaster/CreateTaxSlab" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title fw-bold" id="addTaxSlabLabel">Add Tax Slab & Rule</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Tax Code</label>
                        <input type="text" name="TaxCode" class="form-control text-uppercase" placeholder="e.g. GST-18" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Description</label>
                        <input type="text" name="Description" class="form-control" placeholder="e.g. Goods & Services Tax (Standard)" required />
                    </div>
                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label small fw-semibold">Regime</label>
                            <select name="Regime" id="modalRegime" class="form-select">
                                <option value="GST India">GST India</option>
                                <option value="VAT">VAT</option>
                                <option value="Sales Tax">Sales Tax</option>
                            </select>
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-semibold">Category</label>
                            <select name="Category" id="modalCategory" class="form-select">
                                <option value="GST">GST</option>
                                <option value="VAT">VAT</option>
                                <option value="Cess">Cess</option>
                                <option value="Zero-Rated">Zero-Rated</option>
                            </select>
                        </div>
                    </div>
                    
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Combined Rate (%)</label>
                        <input type="number" step="0.01" name="CombinedRate" id="modalCombinedRate" class="form-control" placeholder="e.g. 18.00" required />
                    </div>

                    <!-- Auto-splitting breakdowns -->
                    <div id="gstSplitFields" class="p-3 bg-light border rounded mb-3">
                        <div class="text-muted small fw-bold mb-2">GST Components Breakdown (Auto-Splits)</div>
                        <div class="row g-2">
                            <div class="col-4">
                                <label class="form-label text-secondary small" style="font-size: 0.75rem;">CGST (%)</label>
                                <input type="number" step="0.01" name="CGST" id="modalCGST" class="form-control form-control-sm bg-white" readonly />
                            </div>
                            <div class="col-4">
                                <label class="form-label text-secondary small" style="font-size: 0.75rem;">SGST (%)</label>
                                <input type="number" step="0.01" name="SGST" id="modalSGST" class="form-control form-control-sm bg-white" readonly />
                            </div>
                            <div class="col-4">
                                <label class="form-label text-secondary small" style="font-size: 0.75rem;">IGST (%)</label>
                                <input type="number" step="0.01" name="IGST" id="modalIGST" class="form-control form-control-sm bg-white" readonly />
                            </div>
                        </div>
                    </div>

                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label small fw-semibold">Effective Date</label>
                            <input type="date" name="EffectiveDate" class="form-control" value="@DateTime.Today.ToString("yyyy-MM-dd")" required />
                        </div>
                        <div class="col-6 mt-4 pt-1">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" name="IsRcmActive" value="true" id="rcmSwitch">
                                <label class="form-check-label small fw-semibold" for="rcmSwitch">Is RCM Active</label>
                            </div>
                        </div>
                    </div>

                    <div class="form-check form-switch mb-3">
                        <input class="form-check-input" type="checkbox" name="IsActive" value="true" checked id="isActiveSlab">
                        <label class="form-check-label small fw-semibold" for="isActiveSlab">Active Slab</label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary rounded-pill px-3 btn-sm" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary rounded-pill px-3 btn-sm">Save Slab</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const modalCategory = document.getElementById("modalCategory");
        const modalRegime = document.getElementById("modalRegime");
        const modalCombinedRate = document.getElementById("modalCombinedRate");
        const gstSplitFields = document.getElementById("gstSplitFields");

        const inputCGST = document.getElementById("modalCGST");
        const inputSGST = document.getElementById("modalSGST");
        const inputIGST = document.getElementById("modalIGST");

        function updateGSTSplit() {
            const combinedVal = parseFloat(modalCombinedRate.value) || 0;
            const categoryVal = modalCategory.value;

            if (categoryVal === "GST") {
                gstSplitFields.style.display = "";
                inputCGST.value = (combinedVal / 2).toFixed(2);
                inputSGST.value = (combinedVal / 2).toFixed(2);
                inputIGST.value = combinedVal.toFixed(2);
            } else {
                gstSplitFields.style.display = "none";
                inputCGST.value = "0.00";
                inputSGST.value = "0.00";
                inputIGST.value = "0.00";
            }
        }

        modalCombinedRate.addEventListener("input", updateGSTSplit);
        modalCategory.addEventListener("change", function() {
            if (modalCategory.value === "GST") {
                modalRegime.value = "GST India";
            } else if (modalCategory.value === "VAT") {
                modalRegime.value = "VAT";
            }
            updateGSTSplit();
        });
        
        updateGSTSplit();
    });
</script>

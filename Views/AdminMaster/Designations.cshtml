        .designation-page

    {
        padding: 18px 0 35px;
    }

    .dm-page-header {
        margin-bottom: 20px;
    }

        .dm-page-header > .d-flex {
            align-items: flex-start !important;
        }

    .dm-title-row {
        gap: 10px;
    }

    .dm-title-icon {
        width: 42px;
        height: 42px;
        flex-basis: 42px;

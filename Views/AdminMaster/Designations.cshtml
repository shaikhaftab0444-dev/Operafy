    /* =========================================================
           REDUCED MOTION
        ========================================================= */

    @@media (prefers-reduced-motion: reduce) {
        *, *::before, *::after

    {
        animation-duration: .01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: .01ms !important;
        scroll-behavior: auto !important;
    }

    }
</style>


<div class="designation-page">
    <div class="container-fluid designation-wrapper">

        <!-- =====================================================
             PAGE HEADER
        ====================================================== -->

        <div class="dm-page-header">
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3">

                <div>
                    <div class="dm-breadcrumb">
                        <a href="/Dashboard">
                            <i class="fa-solid fa-house me-1"></i>
                            Admin Dashboard
                        </a>

                        <i class="fa-solid fa-chevron-right" style="font-size:7px;"></i>

                        <span>Master Setup</span>

                        <i class="fa-solid fa-chevron-right" style="font-size:7px;"></i>

                        <span>Designation Master</span>
                    </div>

                    <div class="dm-title-row">
                        <div class="dm-title-icon">
                            <i class="fa-solid fa-id-card"></i>
                        </div>

                        <div>
                            <h1 class="dm-title">Designation Master</h1>
                            <div class="dm-subtitle">
                                Manage job titles, hierarchy levels, salary bands and active designations.
                            </div>
                        </div>
                    </div>
                </div>

                <button type="button"
                        class="btn btn-primary dm-add-btn"
                        data-bs-toggle="modal"
                        data-bs-target="#addDesignationModal">

                    <i class="fa-solid fa-plus me-2"></i>
                    Add New Designation
                </button>

            </div>
        </div>


        <!-- =====================================================
             SUMMARY CARDS
        ====================================================== -->

        <div class="dm-summary-grid">

            <div class="dm-summary-card">
                <div class="dm-summary-content">
                    <div class="dm-stat-icon blue">
                        <i class="fa-solid fa-layer-group"></i>
                    </div>

                    <div>
                        <div class="dm-stat-label">Total Designations</div>
                        <div class="dm-stat-value">@totalDesignations</div>
                    </div>
                </div>
            </div>


            <div class="dm-summary-card">
                <div class="dm-summary-content">
                    <div class="dm-stat-icon green">
                        <i class="fa-solid fa-circle-check"></i>
                    </div>

                    <div>
                        <div class="dm-stat-label">Active</div>
                        <div class="dm-stat-value">@activeDesignations</div>
                    </div>
                </div>
            </div>


            <div class="dm-summary-card">
                <div class="dm-summary-content">
                    <div class="dm-stat-icon red">
                        <i class="fa-solid fa-circle-xmark"></i>
                    </div>

                    <div>
                        <div class="dm-stat-label">Inactive</div>
                        <div class="dm-stat-value">@inactiveDesignations</div>
                    </div>
                </div>
            </div>


            <div class="dm-summary-card">
                <div class="dm-summary-content">
                    <div class="dm-stat-icon purple">
                        <i class="fa-solid fa-building"></i>
                    </div>

                    <div>
                        <div class="dm-stat-label">Departments</div>
                        <div class="dm-stat-value">@totalDepartments</div>
                    </div>
                </div>
            </div>

        </div>


        <!-- =====================================================
             ALERTS
        ====================================================== -->
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success dm-alert alert-dismissible fade show small mb-3"
                 role="alert">

                <i class="fa-solid fa-circle-check me-2"></i>
                @TempData["SuccessMessage"]

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="alert"
                        aria-label="Close">
                </button>
            </div>
        }


        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger dm-alert alert-dismissible fade show small mb-3"
                 role="alert">

                <i class="fa-solid fa-triangle-exclamation me-2"></i>
                @TempData["ErrorMessage"]

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="alert"
                        aria-label="Close">
                </button>
            </div>
        }


        <!-- =====================================================
             FILTER PANEL
        ====================================================== -->

        <div class="dm-filter-panel">

            <div class="dm-filter-head">
                <h2 class="dm-filter-title">
                    <span class="dm-filter-title-icon">
                        <i class="fa-solid fa-sliders"></i>
                    </span>

                    Search & Filter
                </h2>

                <span class="text-muted" style="font-size:.68rem;">
                    <i class="fa-solid fa-bolt text-warning me-1"></i>
                    Quick Lookup
                </span>
            </div>


            <form method="get"
                  action="/AdminMaster/Designations"
                  id="filterForm">

                <div class="row g-3 align-items-end">

                    <!-- Department -->
                    <div class="col-lg-4 col-md-5">

                        <label class="dm-filter-label">
                            Department
                        </label>

                        <select class="form-select dm-form-select"
                                name="departmentId"
                                onchange="this.form.submit()">

                            <option value="0">
                                All Departments
                            </option>

                            @foreach (var d in Model.Departments ?? new List<ERP_System.Models.Department>())
                            {
                                <option value="@d.DepartmentId"
                                        selected="@(Model.SelectedDepartmentId == d.DepartmentId ? "selected" : null)">
                                    @d.DepartmentName
                                </option>
                            }

                        </select>

                    </div>


                    <!-- Search -->
                    <div class="col-lg-6 col-md-5">

                        <label class="dm-filter-label">
                            Search Designation
                        </label>

                        <div class="dm-search-group">

                            <i class="fa-solid fa-magnifying-glass dm-search-icon"></i>

                            <input type="text"
                                   class="form-control dm-form-control dm-search-input"
                                   id="designationSearch"
                                   name="search"
                                   value="@Model.SearchQuery"
                                   placeholder="Search by designation code or job title..." />

                        </div>

                    </div>


                    <!-- Buttons -->
                    <div class="col-lg-2 col-md-2">

                        <div class="d-flex gap-2">

                            <button type="submit"
                                    class="btn btn-primary dm-reset-btn flex-grow-1">

                                <i class="fa-solid fa-magnifying-glass me-1"></i>
                                Search

                            </button>

                            @if (!string.IsNullOrEmpty(Model.SearchQuery) ||
                                                        Model.SelectedDepartmentId > 0)
                            {
                                <a href="/AdminMaster/Designations"
                                   class="btn btn-outline-secondary dm-reset-btn"
                                   title="Reset filters">

                                    <i class="fa-solid fa-rotate-left"></i>

                                </a>
                            }

                        </div>

                    </div>

                </div>

            </form>

        </div>


        <!-- =====================================================
             DESIGNATION TABLE
        ====================================================== -->

        <div class="dm-table-panel">

            <div class="dm-table-header">

                <div>
                    <h2 class="dm-table-heading">
                        <i class="fa-solid fa-list-check text-primary me-2"></i>
                        Organization Designations
                    </h2>

                    <p class="dm-table-description">
                        Configure and maintain your organization's job hierarchy.
                    </p>
                </div>

                <div class="dm-record-count">
                    <i class="fa-solid fa-database"></i>
                    @totalDesignations Records
                </div>

            </div>


            <div class="dm-table-wrapper">

                <table class="table dm-table align-middle text-start">

                    <thead>
                        <tr>

                            <th style="width:12%;">
                                Designation Code
                            </th>

                            <th style="width:25%;">
                                Job Title & Level
                            </th>

                            <th style="width:17%;">
                                Department
                            </th>

                            <th class="text-center" style="width:12%;">
                                Active Staff
                            </th>

                            <th style="width:14%;">
                                CTC Band
                            </th>

                            <th style="width:10%;">
                                Status
                            </th>

                            <th class="text-center" style="width:10%;">
                                Actions
                            </th>

                        </tr>
                    </thead>


                    <tbody>

                        @if (Model.Designations == null || !Model.Designations.Any())
                        {
                            <tr>

                                <td colspan="7" class="dm-empty-state">

                                    <div class="dm-empty-icon">
                                        <i class="fa-solid fa-folder-open"></i>
                                    </div>

                                    <h3 class="dm-empty-title">
                                        No Designations Found
                                    </h3>

                                    <p class="dm-empty-text">
                                        No designations match the current search or department filter.
                                    </p>

                                </td>

                            </tr>
                        }
                        else
                        {
                            var rowIndex = 0;

                            foreach (var d in Model.Designations)
                            {
                                rowIndex++;

                                var hierarchyValue = d.HierarchyLevel ?? "";
                                var levelCode = hierarchyValue.Contains(" ")
                                ? hierarchyValue.Split(' ')[0]
                                : hierarchyValue;

                                if (string.IsNullOrWhiteSpace(levelCode))
                                {
                                    levelCode = "L1";
                                }

                                var staffCount =
                                counts.TryGetValue(d.DesignationId, out var count)
                                ? count
                                : 1;

                                var gradeIcon = "fa-user-tie";

                                if (levelCode == "L1")
                                    gradeIcon = "fa-seedling";
                                else if (levelCode == "L2")
                                    gradeIcon = "fa-user-astronaut";
                                else if (levelCode == "L3")
                                    gradeIcon = "fa-user-gear";
                                else if (levelCode == "L4")
                                    gradeIcon = "fa-award";
                                else if (levelCode == "L5")
                                    gradeIcon = "fa-user-shield";

                                <tr class="designation-row"
                                    style="animation-delay:@(Math.Min(rowIndex * 0.035, 0.5))s;">

                                    <!-- CODE -->
                                    <td>
                                        <span class="dm-code">
                                            @d.DesignationCode
                                        </span>
                                    </td>


                                    <!-- TITLE -->
                                    <td>

                                        <div class="dm-designation-info">

                                            <div class="dm-grade-icon">
                                                <i class="fa-solid @gradeIcon"></i>
                                            </div>

                                            <div>

                                                <div class="dm-designation-title designation-title">
                                                    @d.JobTitle
                                                </div>

                                                <span class="dm-grade-badge grade-@levelCode">
                                                    @d.HierarchyLevel
                                                </span>

                                            </div>

                                        </div>

                                    </td>


                                    <!-- DEPARTMENT -->
                                    <td>

                                        <span class="dm-department">

                                            <i class="fa-solid fa-folder-tree"></i>

                                            @(d.Department?.DepartmentName ?? "General Operations")

                                        </span>

                                    </td>


                                    <!-- STAFF -->
                                    <td class="text-center">

                                        <span class="dm-staff-badge">

                                            <i class="fa-solid fa-users"></i>

                                            @staffCount

                                            <span>Staff</span>

                                        </span>

                                    </td>


                                    <!-- CTC -->
                                    <td>

                                        <div class="dm-ctc">

                                            ₹ @((d.MinCTC / 100000m).ToString("F1"))L
                                            -
                                            @((d.MaxCTC / 100000m).ToString("F1"))L

                                        </div>

                                        <span class="dm-ctc-label">
                                            Annual CTC Range
                                        </span>

                                    </td>


                                    <!-- STATUS -->
                                    <td>

                                        @if (d.IsActive)
                                        {
                                            <span class="dm-status active">

                                                <span class="dm-status-dot"></span>

                                                Active

                                            </span>
                                        }
                                        else
                                        {
                                            <span class="dm-status inactive">

                                                <span class="dm-status-dot"></span>

                                                Inactive

                                            </span>
                                        }

                                    </td>


                                    <!-- ACTIONS -->
                                    <td>

                                        <div class="dm-actions">

                                            <!-- EDIT -->

                                            <button type="button"
                                                    class="btn dm-action-btn dm-edit-btn"
                                                    title="Edit Designation"
                                                    onclick="openEditModal(this)"
                                                    data-id="@d.DesignationId"
                                                    data-code="@d.DesignationCode"
                                                    data-title="@d.JobTitle"
                                                    data-dept-id="@d.DepartmentId"
                                                    data-level="@d.HierarchyLevel"
                                                    data-min-ctc="@d.MinCTC"
                                                    data-max-ctc="@d.MaxCTC"
                                                    data-description="@d.JobDescription"
                                                    data-active="@d.IsActive">

                                                <i class="fa-solid fa-pencil"></i>

                                            </button>


                                            <!-- STATUS SWITCH -->

                                            <form method="post"
                                                  action="/AdminMaster/ToggleDesignationStatus"
                                                  class="d-inline">

                                                @Html.AntiForgeryToken()

                                                <input type="hidden"
                                                       name="id"
                                                       value="@d.DesignationId" />

                                                <div class="form-check form-switch dm-switch">

                                                    <input class="form-check-input"
                                                           type="checkbox"
                                                           role="switch"
                                                           checked="@(d.IsActive ? "checked" : null)"
                                                           onchange="this.form.submit()"
                                                           title="Toggle Status" />

                                                </div>

                                            </form>


                                            <!-- DELETE -->

                                            <form method="post"
                                                  action="/AdminMaster/DeleteDesignation"
                                                  class="d-inline delete-form">

                                                @Html.AntiForgeryToken()

                                                <input type="hidden"
                                                       name="id"
                                                       value="@d.DesignationId" />

                                                <button type="button"
                                                        class="btn dm-action-btn dm-delete-btn"
                                                        onclick="confirmDelete(this)"
                                                        title="Delete Designation">

                                                    <i class="fa-solid fa-trash-can"></i>

                                                </button>

                                            </form>

                                        </div>

                                    </td>

                                </tr>
                            }
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>
</div>


<!-- =========================================================
     ADD DESIGNATION MODAL
========================================================= -->

<div class="modal fade dm-modal"
     id="addDesignationModal"
     tabindex="-1"
     aria-labelledby="addModalTitle"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered modal-lg">

        <div class="modal-content">

            <div class="dm-modal-header">

                <div class="dm-modal-title-wrap">

                    <div class="dm-modal-icon">
                        <i class="fa-solid fa-plus"></i>
                    </div>

                    <div>
                        <h5 class="dm-modal-title" id="addModalTitle">
                            Create Designation
                        </h5>

                        <p class="dm-modal-subtitle">
                            Add a new job title to your organization structure.
                        </p>
                    </div>

                </div>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Close">
                </button>

            </div>


            <form method="post"
                  action="/AdminMaster/CreateDesignation"
                  id="addForm">

                @Html.AntiForgeryToken()

                <div class="dm-modal-body">

                    <!-- BASIC INFORMATION -->

                    <div class="dm-form-section">

                        <div class="dm-section-label">
                            <i class="fa-solid fa-circle-info"></i>
                            Basic Information
                        </div>

                        <div class="row g-3">

                            <div class="col-md-4">

                                <label class="dm-field-label">
                                    Designation Code
                                    <span class="dm-required">*</span>
                                </label>

                                <input type="text"
                                       asp-for="Designation.DesignationCode"
                                       class="form-control text-uppercase"
                                       placeholder="e.g. HR-MGR"
                                       maxlength="8"
                                       required
                                       oninput="this.value = this.value.toUpperCase();" />

                                <span asp-validation-for="Designation.DesignationCode"
                                      class="text-danger small">
                                </span>

                            </div>


                            <div class="col-md-8">

                                <label class="dm-field-label">
                                    Job Title
                                    <span class="dm-required">*</span>
                                </label>

                                <input type="text"
                                       asp-for="Designation.JobTitle"
                                       class="form-control"
                                       placeholder="e.g. Human Resources Manager"
                                       required />

                                <span asp-validation-for="Designation.JobTitle"
                                      class="text-danger small">
                                </span>

                            </div>


                            <div class="col-md-6">

                                <label class="dm-field-label">
                                    Department
                                    <span class="dm-required">*</span>
                                </label>

                                <select asp-for="Designation.DepartmentId"
                                        class="form-select"
                                        required>

                                    <option value="">
                                        -- Choose Department --
                                    </option>

                                    @foreach (var d in Model.Departments ?? new List<ERP_System.Models.Department>())
                                    {
                                        <option value="@d.DepartmentId">
                                            @d.DepartmentName
                                        </option>
                                    }

                                </select>

                                <span asp-validation-for="Designation.DepartmentId"
                                      class="text-danger small">
                                </span>

                            </div>


                            <div class="col-md-6">

                                <label class="dm-field-label">
                                    Hierarchy Level / Grade
                                    <span class="dm-required">*</span>
                                </label>

                                <select asp-for="Designation.HierarchyLevel"
                                        class="form-select"
                                        required>

                                    <option value="">
                                        -- Choose Level --
                                    </option>

                                    <option value="L1 - Entry Level">
                                        L1 - Entry Level
                                    </option>

                                    <option value="L2 - Junior Associate">
                                        L2 - Junior Associate
                                    </option>

                                    <option value="L3 - Mid-Level">
                                        L3 - Mid-Level
                                    </option>

                                    <option value="L4 - Senior Specialist">
                                        L4 - Senior Specialist
                                    </option>

                                    <option value="L5 - Management / Executive">
                                        L5 - Management / Executive
                                    </option>

                                </select>

                                <span asp-validation-for="Designation.HierarchyLevel"
                                      class="text-danger small">
                                </span>

                            </div>

                        </div>

                    </div>


                    <!-- SALARY -->

                    <div class="dm-form-section">

                        <div class="dm-section-label">
                            <i class="fa-solid fa-indian-rupee-sign"></i>
                            Compensation
                        </div>

                        <div class="row g-3">

                            <div class="col-md-6">

                                <label class="dm-field-label">
                                    Minimum CTC
                                    <span class="dm-required">*</span>
                                </label>

                                <input type="number"
                                       asp-for="Designation.MinCTC"
                                       class="form-control"
                                       placeholder="e.g. 450000"
                                       min="0"
                                       required />

                                <span asp-validation-for="Designation.MinCTC"
                                      class="text-danger small">
                                </span>

                            </div>


                            <div class="col-md-6">

                                <label class="dm-field-label">
                                    Maximum CTC
                                    <span class="dm-required">*</span>
                                </label>

                                <input type="number"
                                       asp-for="Designation.MaxCTC"
                                       class="form-control"
                                       placeholder="e.g. 700000"
                                       min="0"
                                       required />

                                <span asp-validation-for="Designation.MaxCTC"
                                      class="text-danger small">
                                </span>

                            </div>

                        </div>

                    </div>


                    <!-- DESCRIPTION -->

                    <div class="dm-form-section">

                        <div class="dm-section-label">
                            <i class="fa-solid fa-align-left"></i>
                            Role Description
                        </div>

                        <label class="dm-field-label">
                            Job Description & Responsibilities
                        </label>

                        <textarea asp-for="Designation.JobDescription"
                                  class="form-control"
                                  rows="4"
                                  placeholder="Enter key duties, skill expectations, responsibilities and operational scope..."></textarea>

                        <span asp-validation-for="Designation.JobDescription"
                              class="text-danger small">
                        </span>

                    </div>


                    <!-- ACTIVE -->

                    <div class="dm-publish-box">

                        <div class="form-check form-switch dm-switch">

                            <input class="form-check-input"
                                   type="checkbox"
                                   asp-for="Designation.IsActive"
                                   checked />

                        </div>

                        <div>

                            <div class="dm-publish-title">
                                Publish Designation
                            </div>

                            <div class="dm-publish-text">
                                Enable this designation for active organization use.
                            </div>

                        </div>

                    </div>

                </div>


                <div class="dm-modal-footer d-flex justify-content-end gap-2">

                    <button type="button"
                            class="btn btn-outline-secondary dm-cancel-btn"
                            data-bs-dismiss="modal">

                        Cancel

                    </button>

                    <button type="submit"
                            class="btn btn-primary dm-save-btn">

                        <i class="fa-solid fa-check me-2"></i>
                        Save Designation

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>


<!-- =========================================================
     EDIT DESIGNATION MODAL
========================================================= -->

<div class="modal fade dm-modal"
     id="editDesignationModal"
     tabindex="-1"
     aria-labelledby="editModalTitle"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered modal-lg">

        <div class="modal-content">

            <div class="dm-modal-header">

                <div class="dm-modal-title-wrap">

                    <div class="dm-modal-icon">
                        <i class="fa-solid fa-pen-to-square"></i>
                    </div>

                    <div>

                        <h5 class="dm-modal-title" id="editModalTitle">
                            Edit Designation
                        </h5>

                        <p class="dm-modal-subtitle">
                            Update designation details and organization settings.
                        </p>

                    </div>

                </div>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Close">
                </button>

            </div>


            <form method="post"
                  action="/AdminMaster/EditDesignation"
                  id="editForm">

                @Html.AntiForgeryToken()

                <input type="hidden"
                       asp-for="Designation.DesignationId"
                       id="editDesignationId" />


                <div class="dm-modal-body">

                    <!-- BASIC INFORMATION -->

                    <div class="dm-form-section">

                        <div class="dm-section-label">
                            <i class="fa-solid fa-circle-info"></i>
                            Designation Information
                        </div>

                        <div class="row g-3">

                            <div class="col-md-4">

                                <label class="dm-field-label">
                                    Designation Code
                                </label>

                                <input type="text"
                                       asp-for="Designation.DesignationCode"
                                       id="editDesignationCode"
                                       class="form-control text-uppercase"
                                       readonly />

                            </div>


                            <div class="col-md-8">

                                <label class="dm-field-label">
                                    Job Title
                                    <span class="dm-required">*</span>
                                </label>

                                <input type="text"
                                       asp-for="Designation.JobTitle"
                                       id="editJobTitle"
                                       class="form-control"
                                       placeholder="e.g. Human Resources Manager"
                                       required />

                                <span asp-validation-for="Designation.JobTitle"
                                      class="text-danger small">
                                </span>

                            </div>


                            <div class="col-md-6">

                                <label class="dm-field-label">
                                    Department
                                    <span class="dm-required">*</span>
                                </label>

                                <select asp-for="Designation.DepartmentId"
                                        id="editDepartmentId"
                                        class="form-select"
                                        required>

                                    @foreach (var d in Model.Departments ?? new List<ERP_System.Models.Department>())
                                    {
                                        <option value="@d.DepartmentId">
                                            @d.DepartmentName
                                        </option>
                                    }

                                </select>

                                <span asp-validation-for="Designation.DepartmentId"
                                      class="text-danger small">
                                </span>

                            </div>


                            <div class="col-md-6">

                                <label class="dm-field-label">
                                    Hierarchy Level / Grade
                                    <span class="dm-required">*</span>
                                </label>

                                <select asp-for="Designation.HierarchyLevel"
                                        id="editHierarchyLevel"
                                        class="form-select"
                                        required>

                                    <option value="L1 - Entry Level">
                                        L1 - Entry Level
                                    </option>

                                    <option value="L2 - Junior Associate">
                                        L2 - Junior Associate
                                    </option>

                                    <option value="L3 - Mid-Level">
                                        L3 - Mid-Level
                                    </option>

                                    <option value="L4 - Senior Specialist">
                                        L4 - Senior Specialist
                                    </option>

                                    <option value="L5 - Management / Executive">
                                        L5 - Management / Executive
                                    </option>

                                </select>

                                <span asp-validation-for="Designation.HierarchyLevel"
                                      class="text-danger small">
                                </span>

                            </div>

                        </div>

                    </div>


                    <!-- SALARY -->

                    <div class="dm-form-section">

                        <div class="dm-section-label">
                            <i class="fa-solid fa-indian-rupee-sign"></i>
                            Compensation
                        </div>

                        <div class="row g-3">

                            <div class="col-md-6">

                                <label class="dm-field-label">
                                    Minimum CTC
                                    <span class="dm-required">*</span>
                                </label>

                                <input type="number"
                                       asp-for="Designation.MinCTC"
                                       id="editMinCTC"
                                       class="form-control"
                                       min="0"
                                       required />

                                <span asp-validation-for="Designation.MinCTC"
                                      class="text-danger small">
                                </span>

                            </div>


                            <div class="col-md-6">

                                <label class="dm-field-label">
                                    Maximum CTC
                                    <span class="dm-required">*</span>
                                </label>

                                <input type="number"
                                       asp-for="Designation.MaxCTC"
                                       id="editMaxCTC"
                                       class="form-control"
                                       min="0"
                                       required />

                                <span asp-validation-for="Designation.MaxCTC"
                                      class="text-danger small">
                                </span>

                            </div>

                        </div>

                    </div>


                    <!-- DESCRIPTION -->

                    <div class="dm-form-section">

                        <div class="dm-section-label">
                            <i class="fa-solid fa-align-left"></i>
                            Role Description
                        </div>

                        <label class="dm-field-label">
                            Job Description & Responsibilities
                        </label>

                        <textarea asp-for="Designation.JobDescription"
                                  id="editJobDescription"
                                  class="form-control"
                                  rows="4"
                                  placeholder="Enter responsibilities and operational scope..."></textarea>

                        <span asp-validation-for="Designation.JobDescription"
                              class="text-danger small">
                        </span>

                    </div>


                    <!-- ACTIVE -->

                    <div class="dm-publish-box">

                        <div class="form-check form-switch dm-switch">

                            <input class="form-check-input"
                                   type="checkbox"
                                   asp-for="Designation.IsActive"
                                   id="editIsActive" />

                        </div>

                        <div>

                            <div class="dm-publish-title">
                                Active Designation
                            </div>

                            <div class="dm-publish-text">
                                Turn off to mark this designation as inactive.
                            </div>

                        </div>

                    </div>

                </div>


                <div class="dm-modal-footer d-flex justify-content-end gap-2">

                    <button type="button"
                            class="btn btn-outline-secondary dm-cancel-btn"
                            data-bs-dismiss="modal">

                        Cancel

                    </button>

                    <button type="submit"
                            class="btn btn-primary dm-save-btn">

                        <i class="fa-solid fa-floppy-disk me-2"></i>
                        Apply Changes

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>


<!-- =========================================================
     JAVASCRIPT
========================================================= -->

<script>

    document.addEventListener("DOMContentLoaded", function () {

        /* =====================================================
           LIVE SEARCH
        ===================================================== */

        const searchInput = document.getElementById("designationSearch");

        if (searchInput) {

            searchInput.addEventListener("input", function () {

                const query = this.value
                    .toLowerCase()
                    .trim();

                const rows = document.querySelectorAll(".designation-row");

                rows.forEach(function (row) {

                    const titleElement =
                        row.querySelector(".designation-title");

                    const codeElement =
                        row.querySelector(".dm-code");

                    const titleText =
                        titleElement
                            ? titleElement.textContent.toLowerCase()
                            : "";

                    const codeText =
                        codeElement
                            ? codeElement.textContent.toLowerCase()
                            : "";

                    const match =
                        titleText.includes(query) ||
                        codeText.includes(query);

                    if (match) {

                        row.style.display = "";

                        row.animate(
                            [
                                {
                                    opacity: 0.35,
                                    transform: "translateY(4px)"
                                },
                                {
                                    opacity: 1,
                                    transform: "translateY(0)"
                                }
                            ],
                            {
                                duration: 180,
                                easing: "ease-out"
                            }
                        );

                    } else {

                        row.style.display = "none";

                    }

                });

            });

        }


        /* =====================================================
           FORM SUBMIT LOADING EFFECT
        ===================================================== */

        document.querySelectorAll("form").forEach(function (form) {

            form.addEventListener("submit", function () {

                const submitButton =
                    form.querySelector(
                        'button[type="submit"]:not([data-bs-dismiss])'
                    );

                if (!submitButton) {
                    return;
                }

                if (form.classList.contains("delete-form")) {
                    return;
                }

                if (submitButton.dataset.loading === "true") {
                    return;
                }

                submitButton.dataset.loading = "true";

                const originalHtml =
                    submitButton.innerHTML;

                submitButton.dataset.originalHtml =
                    originalHtml;

                submitButton.innerHTML =
                    '<span class="spinner-border spinner-border-sm me-2"></span>Processing...';

                submitButton.disabled = true;

            });

        });

    });


    /* =========================================================
       OPEN EDIT MODAL
    ========================================================= */

    function openEditModal(button) {

        if (!button) {
            return;
        }

        const id =
            button.dataset.id;

        const code =
            button.dataset.code || "";

        const title =
            button.dataset.title || "";

        const deptId =
            button.dataset.deptId || "";

        const level =
            button.dataset.level || "";

        const minCtc =
            button.dataset.minCtc || "0";

        const maxCtc =
            button.dataset.maxCtc || "0";

        const description =
            button.dataset.description || "";

        const active =
            button.dataset.active === "True" ||
            button.dataset.active === "true";


        document.getElementById("editDesignationId").value =
            id;

        document.getElementById("editDesignationCode").value =
            code;

        document.getElementById("editJobTitle").value =
            title;

        document.getElementById("editDepartmentId").value =
            deptId;

        document.getElementById("editHierarchyLevel").value =
            level;

        document.getElementById("editMinCTC").value =
            minCtc;

        document.getElementById("editMaxCTC").value =
            maxCtc;

        document.getElementById("editJobDescription").value =
            description;

        document.getElementById("editIsActive").checked =
            active;


        const modalElement =
            document.getElementById("editDesignationModal");

        const editModal =
            bootstrap.Modal.getOrCreateInstance(modalElement);

        editModal.show();

    }


    /* =========================================================
       DELETE CONFIRMATION
    ========================================================= */

    function confirmDelete(button) {

        Swal.fire({

            title: "Delete Designation?",

            html:
                '<div style="font-size:.85rem;color:#64748b;">' +
                'This action is permanent and cannot be undone.<br>' +
                'Please confirm that you want to delete this designation.' +
                '</div>',

            icon: "warning",

            showCancelButton: true,

            confirmButtonColor: "#ef4444",

            cancelButtonColor: "#64748b",

            confirmButtonText:
                '<i class="fa-solid fa-trash-can me-1"></i> Yes, Delete',

            cancelButtonText:
                "Cancel",

            reverseButtons: true,

            focusCancel: true,

            customClass: {

                popup: "rounded-4",

                confirmButton: "rounded-3",

                cancelButton: "rounded-3"

            }

        }).then(function (result) {

            if (result.isConfirmed) {

                const form =
                    button.closest(".delete-form");

                if (form) {

                    const submitButton =
                        document.createElement("button");

                    submitButton.type = "submit";

                    submitButton.style.display = "none";

                    form.appendChild(submitButton);

                    submitButton.click();

                }

            }

        });

    }


    /* =========================================================
       AUTO HIDE BOOTSTRAP ALERTS
    ========================================================= */

    setTimeout(function () {

        document
            .querySelectorAll(".dm-alert")
            .forEach(function (alertElement) {

                const alert =
                    bootstrap.Alert.getOrCreateInstance(alertElement);

                alert.close();

            });

    }, 5000);

</script>
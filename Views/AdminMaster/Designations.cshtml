@model ERP_System.Models.DesignationViewModel

@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Designation Master";

    var counts = ViewBag.DesignationEmployeeCounts as Dictionary<int, int>
                 ?? new Dictionary<int, int>();

    var totalDesignations = Model.Designations?.Count ?? 0;
    var activeDesignations = Model.Designations?.Count(x => x.IsActive) ?? 0;
    var inactiveDesignations = totalDesignations - activeDesignations;
    var totalDepartments = Model.Departments?.Count ?? 0;
}

<!-- =========================================================
     DESIGNATION MASTER
     PREMIUM ERP UI / RESPONSIVE / ANIMATED
========================================================= -->
<!-- SweetAlert -->
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<style>
    /* =========================================================
           ROOT / PAGE
        ========================================================= */

    :root {
        --dm-primary: #2563eb;
        --dm-primary-dark: #1d4ed8;
        --dm-primary-soft: #eff6ff;
        --dm-success: #10b981;
        --dm-success-soft: #ecfdf5;
        --dm-warning: #f59e0b;
        --dm-warning-soft: #fffbeb;
        --dm-danger: #ef4444;
        --dm-danger-soft: #fef2f2;
        --dm-dark: #0f172a;
        --dm-text: #334155;
        --dm-muted: #64748b;
        --dm-border: #e2e8f0;
        --dm-bg: #f8fafc;
        --dm-white: #ffffff;
        --dm-radius: 18px;
        --dm-shadow: 0 10px 35px rgba(15, 23, 42, 0.06);
        --dm-shadow-hover: 0 18px 45px rgba(15, 23, 42, 0.11);
    }

    .designation-page {
        min-height: 100vh;
        background: radial-gradient(circle at 10% 0%, rgba(37, 99, 235, 0.055), transparent 28%), radial-gradient(circle at 90% 10%, rgba(99, 102, 241, 0.045), transparent 25%), var(--dm-bg);
        padding: 28px 0 50px;
    }

    .designation-wrapper {
        animation: pageReveal .65s ease both;
    }

    /* =========================================================
           ANIMATIONS
        ========================================================= */

    @@keyframes pageReveal {
        from

    {
        opacity: 0;
        transform: translateY(18px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }

    }

    @@keyframes fadeUp {
        from

    {
        opacity: 0;
        transform: translateY(16px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }

    }

    @@keyframes scaleIn {
        from

    {
        opacity: 0;
        transform: scale(.94);
    }

    to {
        opacity: 1;
        transform: scale(1);
    }

    }

    @@keyframes pulseSoft {
        0%, 100%

    {
        box-shadow: 0 0 0 0 rgba(16, 185, 129, .18);
    }

    50% {
        box-shadow: 0 0 0 7px rgba(16, 185, 129, 0);
    }

    }

    @@keyframes shine {
        from

    {
        transform: translateX(-120%);
    }

    to {
        transform: translateX(120%);
    }

    }

    @@keyframes modalDrop {
        from

    {
        opacity: 0;
        transform: translateY(-20px) scale(.96);
    }

    to {
        opacity: 1;
        transform: translateY(0) scale(1);
    }

    }

    /* =========================================================
           PAGE HEADER
        ========================================================= */

    .dm-page-header {
        margin-bottom: 26px;
    }

    .dm-breadcrumb {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 6px;
        margin-bottom: 8px;
        font-size: .78rem;
        color: var(--dm-muted);
    }

        .dm-breadcrumb a {
            color: var(--dm-primary);
            text-decoration: none;
            font-weight: 600;
            transition: color .2s ease;
        }

            .dm-breadcrumb a:hover {
                color: var(--dm-primary-dark);
            }

    .dm-title-row {
        display: flex;
        align-items: center;
        gap: 14px;
    }

    .dm-title-icon {
        width: 50px;
        height: 50px;
        flex: 0 0 50px;
        border-radius: 15px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--dm-primary);
        background: linear-gradient(135deg, #eff6ff, #dbeafe);
        border: 1px solid #dbeafe;
        font-size: 20px;
        box-shadow: 0 8px 20px rgba(37, 99, 235, .10);
    }

    .dm-title {
        margin: 0;
        color: var(--dm-dark);
        font-size: 1.55rem;
        font-weight: 800;
        letter-spacing: -.4px;
    }

    .dm-subtitle {
        color: var(--dm-muted);
        font-size: .83rem;
        margin-top: 3px;
    }

    .dm-add-btn {
        position: relative;
        overflow: hidden;
        border: 0;
        min-height: 44px;
        padding: 0 20px;
        border-radius: 13px;
        background: linear-gradient(135deg, var(--dm-primary), #4f46e5);
        box-shadow: 0 9px 22px rgba(37, 99, 235, .20);
        font-size: .85rem;
        font-weight: 700;
        transition: transform .25s ease, box-shadow .25s ease;
    }

        .dm-add-btn::after {
            content: "";
            position: absolute;
            inset: 0;
            width: 45%;
            background: linear-gradient( 90deg, transparent, rgba(255,255,255,.22), transparent );
            transform: translateX(-120%);
        }

        .dm-add-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 14px 30px rgba(37, 99, 235, .27);
        }

            .dm-add-btn:hover::after {
                animation: shine .75s ease;
            }

    /* =========================================================
           SUMMARY CARDS
        ========================================================= */

    .dm-summary-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 15px;
        margin-bottom: 22px;
    }

    .dm-summary-card {
        position: relative;
        overflow: hidden;
        background: rgba(255,255,255,.88);
        border: 1px solid rgba(226,232,240,.85);
        border-radius: var(--dm-radius);
        padding: 18px;
        box-shadow: var(--dm-shadow);
        transition: transform .28s ease, box-shadow .28s ease;
        animation: fadeUp .55s ease both;
    }

        .dm-summary-card:nth-child(1) {
            animation-delay: .05s;
        }

        .dm-summary-card:nth-child(2) {
            animation-delay: .10s;
        }

        .dm-summary-card:nth-child(3) {
            animation-delay: .15s;
        }

        .dm-summary-card:nth-child(4) {
            animation-delay: .20s;
        }

        .dm-summary-card:hover {
            transform: translateY(-4px);
            box-shadow: var(--dm-shadow-hover);
        }

        .dm-summary-card::before {
            content: "";
            position: absolute;
            width: 90px;
            height: 90px;
            border-radius: 50%;
            right: -35px;
            top: -40px;
            background: rgba(37, 99, 235, .045);
        }

    .dm-summary-content {
        position: relative;
        z-index: 1;
        display: flex;
        align-items: center;
        gap: 13px;
    }

    .dm-stat-icon {
        width: 43px;
        height: 43px;
        border-radius: 13px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex: 0 0 43px;
        font-size: 17px;
    }

        .dm-stat-icon.blue {
            background: #eff6ff;
            color: #2563eb;
        }

        .dm-stat-icon.green {
            background: #ecfdf5;
            color: #059669;
        }

        .dm-stat-icon.red {
            background: #fef2f2;
            color: #dc2626;
        }

        .dm-stat-icon.purple {
            background: #f5f3ff;
            color: #7c3aed;
        }

    .dm-stat-label {
        font-size: .73rem;
        color: var(--dm-muted);
        font-weight: 600;
        margin-bottom: 2px;
    }

    .dm-stat-value {
        font-size: 1.35rem;
        color: var(--dm-dark);
        font-weight: 800;
        line-height: 1;
    }

    /* =========================================================
           ALERT
        ========================================================= */

    .dm-alert {
        border: 0;
        border-radius: 13px;
        box-shadow: 0 5px 18px rgba(15,23,42,.05);
        animation: fadeUp .4s ease both;
    }

    /* =========================================================
           FILTER PANEL
        ========================================================= */

    .dm-filter-panel {
        background: rgba(255,255,255,.92);
        border: 1px solid var(--dm-border);
        border-radius: var(--dm-radius);
        padding: 20px;
        box-shadow: var(--dm-shadow);
        margin-bottom: 20px;
        animation: fadeUp .55s ease .15s both;
    }

    .dm-filter-head {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 16px;
    }

    .dm-filter-title {
        display: flex;
        align-items: center;
        gap: 9px;
        color: var(--dm-dark);
        font-size: .9rem;
        font-weight: 800;
        margin: 0;
    }

    .dm-filter-title-icon {
        width: 30px;
        height: 30px;
        border-radius: 9px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: var(--dm-primary-soft);
        color: var(--dm-primary);
        font-size: 13px;
    }

    .dm-filter-label {
        display: block;
        margin-bottom: 6px;
        color: var(--dm-muted);
        font-size: .72rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .35px;
    }

    .dm-form-control,
    .dm-form-select {
        min-height: 43px;
        border-radius: 11px;
        border: 1px solid var(--dm-border);
        background: #fff;
        color: var(--dm-text);
        font-size: .82rem;
        transition: all .22s ease;
    }

        .dm-form-control:focus,
        .dm-form-select:focus {
            border-color: rgba(37,99,235,.45);
            box-shadow: 0 0 0 4px rgba(37,99,235,.08);
        }

    .dm-search-group {
        position: relative;
    }

    .dm-search-icon {
        position: absolute;
        left: 14px;
        top: 50%;
        transform: translateY(-50%);
        color: #94a3b8;
        z-index: 3;
        pointer-events: none;
    }

    .dm-search-input {
        padding-left: 39px;
    }

    .dm-reset-btn {
        min-height: 43px;
        border-radius: 11px;
        font-size: .78rem;
        font-weight: 700;
    }

    /* =========================================================
           TABLE PANEL
        ========================================================= */

    .dm-table-panel {
        position: relative;
        background: rgba(255,255,255,.96);
        border: 1px solid var(--dm-border);
        border-radius: var(--dm-radius);
        box-shadow: var(--dm-shadow);
        overflow: hidden;
        animation: fadeUp .65s ease .22s both;
    }

    .dm-table-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 15px;
        padding: 19px 21px;
        border-bottom: 1px solid #eef2f7;
    }

    .dm-table-heading {
        margin: 0;
        color: var(--dm-dark);
        font-size: .94rem;
        font-weight: 800;
    }

    .dm-table-description {
        margin: 3px 0 0;
        color: var(--dm-muted);
        font-size: .74rem;
    }

    .dm-record-count {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        border-radius: 20px;
        background: var(--dm-primary-soft);
        color: var(--dm-primary);
        border: 1px solid #dbeafe;
        padding: 6px 10px;
        font-size: .7rem;
        font-weight: 800;
    }

    .dm-table-wrapper {
        width: 100%;
        overflow-x: auto;
    }

    .dm-table {
        width: 100%;
        min-width: 1050px;
        margin: 0;
        border-collapse: separate;
        border-spacing: 0;
    }

        .dm-table thead th {
            padding: 13px 15px;
            background: #f8fafc;
            border-bottom: 1px solid var(--dm-border);
            color: #64748b;
            font-size: .67rem;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: .55px;
            white-space: nowrap;
        }

        .dm-table tbody tr {
            position: relative;
            animation: fadeUp .45s ease both;
            transition: background .25s ease, transform .25s ease, box-shadow .25s ease;
        }

            .dm-table tbody tr:hover {
                background: #fbfdff;
            }

        .dm-table tbody td {
            padding: 15px;
            border-bottom: 1px solid #f0f3f7;
            color: var(--dm-text);
            font-size: .79rem;
            vertical-align: middle;
        }

        .dm-table tbody tr:last-child td {
            border-bottom: 0;
        }

    /* =========================================================
           DESIGNATION CODE
        ========================================================= */

    .dm-code {
        display: inline-flex;
        align-items: center;
        padding: 6px 9px;
        border-radius: 8px;
        background: #f8fafc;
        color: #334155;
        border: 1px solid #e2e8f0;
        font-family: "SFMono-Regular", Consolas, monospace;
        font-size: .7rem;
        font-weight: 800;
        letter-spacing: .3px;
    }

    /* =========================================================
           TITLE / GRADE
        ========================================================= */

    .dm-designation-info {
        display: flex;
        align-items: center;
        gap: 11px;
        min-width: 190px;
    }

    .dm-grade-icon {
        width: 38px;
        height: 38px;
        flex: 0 0 38px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 11px;
        background: linear-gradient(135deg, #eff6ff, #f5f3ff);
        color: var(--dm-primary);
        border: 1px solid #dbeafe;
        transition: transform .25s ease;
    }

    .dm-table tbody tr:hover .dm-grade-icon {
        transform: rotate(-5deg) scale(1.06);
    }

    .dm-designation-title {
        color: var(--dm-dark);
        font-size: .82rem;
        font-weight: 800;
        margin-bottom: 5px;
    }

    .dm-grade-badge {
        display: inline-flex;
        align-items: center;
        border-radius: 6px;
        padding: 3px 7px;
        font-size: .61rem;
        font-weight: 800;
        letter-spacing: .3px;
        text-transform: uppercase;
    }

    .grade-L5 {
        background: #fef2f2;
        color: #991b1b;
        border: 1px solid #fee2e2;
    }

    .grade-L4 {
        background: #faf5ff;
        color: #6b21a8;
        border: 1px solid #f3e8ff;
    }

    .grade-L3 {
        background: #eff6ff;
        color: #1e40af;
        border: 1px solid #dbeafe;
    }

    .grade-L2 {
        background: #f0fdf4;
        color: #166534;
        border: 1px solid #dcfce7;
    }

    .grade-L1 {
        background: #f8fafc;
        color: #475569;
        border: 1px solid #e2e8f0;
    }

    /* =========================================================
           DEPARTMENT
        ========================================================= */

    .dm-department {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        color: #475569;
        font-weight: 600;
        white-space: nowrap;
    }

        .dm-department i {
            color: #93c5fd;
        }

    /* =========================================================
           STAFF BADGE
        ========================================================= */

    .dm-staff-badge {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        border-radius: 20px;
        padding: 6px 10px;
        background: #eff6ff;
        color: #2563eb;
        border: 1px solid #dbeafe;
        font-size: .69rem;
        font-weight: 800;
        transition: all .25s ease;
    }

        .dm-staff-badge:hover {
            transform: translateY(-1px);
            background: #dbeafe;
        }

    /* =========================================================
           CTC
        ========================================================= */

    .dm-ctc {
        color: var(--dm-dark);
        font-family: "SFMono-Regular", Consolas, monospace;
        font-size: .75rem;
        font-weight: 800;
        white-space: nowrap;
    }

    .dm-ctc-label {
        display: block;
        color: #94a3b8;
        font-family: inherit;
        font-size: .61rem;
        font-weight: 600;
        margin-top: 2px;
    }

    /* =========================================================
           STATUS
        ========================================================= */

    .dm-status {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        border-radius: 20px;
        padding: 6px 10px;
        font-size: .67rem;
        font-weight: 800;
    }

    .dm-status-dot {
        width: 6px;
        height: 6px;
        border-radius: 50%;
    }

    .dm-status.active {
        color: #047857;
        background: var(--dm-success-soft);
        border: 1px solid #bbf7d0;
    }

        .dm-status.active .dm-status-dot {
            background: #10b981;
            animation: pulseSoft 1.8s infinite;
        }

    .dm-status.inactive {
        color: #64748b;
        background: #f8fafc;
        border: 1px solid #e2e8f0;
    }

        .dm-status.inactive .dm-status-dot {
            background: #94a3b8;
        }

    /* =========================================================
           ACTION BUTTONS
        ========================================================= */

    .dm-actions {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
    }

    .dm-action-btn {
        width: 32px;
        height: 32px;
        padding: 0;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 9px;
        transition: all .23s ease;
        font-size: .72rem;
    }

        .dm-action-btn:hover {
            transform: translateY(-2px);
        }

    .dm-edit-btn {
        color: #2563eb;
        background: #eff6ff;
        border: 1px solid #dbeafe;
    }

        .dm-edit-btn:hover {
            background: #dbeafe;
            color: #1d4ed8;
        }

    .dm-delete-btn {
        color: #dc2626;
        background: #fef2f2;
        border: 1px solid #fee2e2;
    }

        .dm-delete-btn:hover {
            background: #fee2e2;
            color: #b91c1c;
        }

    /* =========================================================
           IOS SWITCH
        ========================================================= */

    .dm-switch {
        margin: 0;
        padding-left: 0;
    }

        .dm-switch .form-check-input {
            float: none;
            margin: 0;
            width: 38px;
            height: 21px;
            border: 0;
            cursor: pointer;
            background-color: #cbd5e1;
            background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='-4 -4 8 8'%3e%3ccircle r='3' fill='%23fff'/%3e%3c/svg%3e");
            background-position: left center;
            background-repeat: no-repeat;
            background-size: auto 100%;
            transition: background-position .2s ease, background-color .2s ease, box-shadow .2s ease;
        }

            .dm-switch .form-check-input:checked {
                background-color: #10b981;
                background-position: right center;
                box-shadow: 0 0 0 4px rgba(16,185,129,.08);
            }

    /* =========================================================
           EMPTY STATE
        ========================================================= */

    .dm-empty-state {
        padding: 65px 20px !important;
        text-align: center;
    }

    .dm-empty-icon {
        width: 70px;
        height: 70px;
        margin: 0 auto 15px;
        border-radius: 20px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        color: #94a3b8;
        font-size: 25px;
        animation: scaleIn .55s ease both;
    }

    .dm-empty-title {
        margin: 0 0 5px;
        color: var(--dm-dark);
        font-weight: 800;
        font-size: .92rem;
    }

    .dm-empty-text {
        margin: 0;
        color: var(--dm-muted);
        font-size: .76rem;
    }

    /* =========================================================
           MODAL
        ========================================================= */

    .dm-modal .modal-dialog {
        animation: modalDrop .35s cubic-bezier(.22,1,.36,1);
    }

    .dm-modal .modal-content {
        border: 0;
        border-radius: 20px;
        overflow: hidden;
        box-shadow: 0 30px 80px rgba(15,23,42,.20);
    }

    .dm-modal-header {
        position: relative;
        padding: 20px 22px;
        background: linear-gradient(135deg, #f8fbff, #f1f5ff);
        border-bottom: 1px solid #e5eaf2;
    }

    .dm-modal-title-wrap {
        display: flex;
        align-items: center;
        gap: 11px;
    }

    .dm-modal-icon {
        width: 39px;
        height: 39px;
        border-radius: 11px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #dbeafe;
        color: #2563eb;
        font-size: 15px;
    }

    .dm-modal-title {
        margin: 0;
        color: var(--dm-dark);
        font-size: .98rem;
        font-weight: 800;
    }

    .dm-modal-subtitle {
        margin: 2px 0 0;
        color: var(--dm-muted);
        font-size: .7rem;
    }

    .dm-modal .btn-close {
        box-shadow: none;
    }

    .dm-modal-body {
        padding: 23px;
        background: #fff;
    }

    .dm-form-section {
        margin-bottom: 20px;
    }

        .dm-form-section:last-child {
            margin-bottom: 0;
        }

    .dm-section-label {
        display: flex;
        align-items: center;
        gap: 7px;
        margin-bottom: 12px;
        color: #334155;
        font-size: .75rem;
        font-weight: 800;
    }

        .dm-section-label i {
            color: #2563eb;
        }

    .dm-field-label {
        display: block;
        margin-bottom: 6px;
        color: #475569;
        font-size: .72rem;
        font-weight: 700;
    }

    .dm-required {
        color: #ef4444;
    }

    .dm-modal .form-control,
    .dm-modal .form-select {
        min-height: 42px;
        border-radius: 10px;
        border: 1px solid #dfe5ed;
        font-size: .8rem;
        color: #334155;
        transition: all .2s ease;
    }

    .dm-modal textarea.form-control {
        min-height: 95px;
        resize: vertical;
    }

    .dm-modal .form-control:focus,
    .dm-modal .form-select:focus {
        border-color: #93c5fd;
        box-shadow: 0 0 0 4px rgba(37,99,235,.08);
    }

    .dm-modal-footer {
        padding: 15px 22px;
        background: #f8fafc;
        border-top: 1px solid #e5e7eb;
    }

    .dm-cancel-btn,
    .dm-save-btn {
        min-height: 39px;
        border-radius: 10px;
        padding: 0 17px;
        font-size: .76rem;
        font-weight: 700;
    }

    .dm-save-btn {
        border: 0;
        background: linear-gradient(135deg, #2563eb, #4f46e5);
        box-shadow: 0 7px 18px rgba(37,99,235,.18);
    }

        .dm-save-btn:hover {
            background: linear-gradient(135deg, #1d4ed8, #4338ca);
        }

    /* =========================================================
           ACTIVE TOGGLE IN MODAL
        ========================================================= */

    .dm-publish-box {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 13px 15px;
        border-radius: 12px;

@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Designation Master";
}

<div class="container-fluid py-4 text-start">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-bold mb-1"><i class="fa-solid fa-id-card text-primary me-2"></i>Designation Master</h4>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0 small">
                    <li class="breadcrumb-item"><a href="/Dashboard" class="text-decoration-none">Admin Dashboard</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Designations</li>
                </ol>
            </nav>
        </div>
    </div>

    <!-- Designations Table -->
    <div class="bg-white border rounded-3 p-4 shadow-sm" style="max-width: 600px;">
        <h5 class="fw-bold mb-3">Enterprise Designation Master</h5>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" style="font-size: 0.85rem;">
                <thead class="table-light">
                    <tr>
                        <th>Designation Code</th>
                        <th>Job Title / Designation</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td class="fw-bold text-dark">HR-MGR</td>
                        <td>Human Resources Manager</td>
                        <td><span class="badge bg-success-subtle text-success">Active</span></td>
                    </tr>
                    <tr>
                        <td class="fw-bold text-dark">SYS-ADM</td>
                        <td>System & Infrastructure Admin</td>
                        <td><span class="badge bg-success-subtle text-success">Active</span></td>
                    </tr>
                    <tr>
                        <td class="fw-bold text-dark">SDE-II</td>
                        <td>Software Development Engineer II</td>
                        <td><span class="badge bg-success-subtle text-success">Active</span></td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

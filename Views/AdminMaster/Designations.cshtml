    @@media (max-width: 480px) {
        .dm-summary-grid

    {
        grid-template-columns: 1fr;
    }

    .dm-title {
        font-size: 1.08rem;
    }

    .dm-breadcrumb {
        font-size: .68rem;
    }

    .dm-filter-title {

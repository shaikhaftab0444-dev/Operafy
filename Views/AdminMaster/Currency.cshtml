@model ERP_System.Models.CurrencyViewModel
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Currency Master";
}

<div class="container-fluid py-4 text-start">

    <!-- Header with Breadcrumb and Action Buttons -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-4">
        <div>
            <h4 class="fw-bold mb-1">
                <i class="fa-solid fa-coins text-primary me-2"></i>Currency Master & Exchange Rates
            </h4>

            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0 small">
                    <li class="breadcrumb-item">
                        <a href="/Dashboard" class="text-decoration-none">Dashboard</a>
                    </li>
                    <li class="breadcrumb-item active" aria-current="page">
                        Currency Master
                    </li>
                </ol>
            </nav>
        </div>

        <div class="d-flex flex-wrap gap-2">

            <!-- Set Base Currency Dropdown -->
            <form action="/AdminMaster/SetBaseCurrency" method="post" class="d-inline-block">
                @Html.AntiForgeryToken()

                <div class="input-group input-group-sm">
                    <span class="input-group-text bg-light text-secondary border-end-0 small fw-semibold">
                        Base Currency
                    </span>

                    <select name="code" class="form-select border-start-0" onchange="this.form.submit()">
                        @foreach (var c in Model.Currencies)
                        {
                            <option value="@c.CurrencyCode"
                                    selected="@(c.IsBaseCurrency ? "selected" : null)">
                                @c.CurrencyCode (@c.Symbol)
                            </option>
                        }
                    </select>
                </div>
            </form>

            <!-- Sync Live Rates -->
            <form action="/AdminMaster/SyncRates" method="post" class="d-inline-block">
                @Html.AntiForgeryToken()

                <button type="submit"
                        class="btn btn-sm btn-outline-primary rounded-pill px-3 shadow-sm">
                    <i class="fa-solid fa-rotate me-1.5"></i>
                    Sync Live Rates
                </button>
            </form>

            <!-- Add Currency Trigger -->
            <button class="btn btn-primary rounded-pill px-3 btn-sm shadow-sm"
                    data-bs-toggle="modal"
                    data-bs-target="#addCurrencyModal">
                <i class="fa-solid fa-plus me-1.5"></i>
                Add New Currency
            </button>

        </div>
    </div>


    <!-- Feedback Alerts -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show small py-2"
             role="alert"
             style="max-width: 800px;">

            <i class="fa-solid fa-circle-check me-2"></i>
            @TempData["SuccessMessage"]

            <button type="button"
                    class="btn-close py-2"
                    data-bs-dismiss="alert"
                    aria-label="Close">
            </button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show small py-2"
             role="alert"
             style="max-width: 800px;">

            <i class="fa-solid fa-triangle-exclamation me-2"></i>
            @TempData["ErrorMessage"]

            <button type="button"
                    class="btn-close py-2"
                    data-bs-dismiss="alert"
                    aria-label="Close">
            </button>
        </div>
    }


    <!-- Currencies Data Table -->
    <div class="bg-white border rounded-3 p-4 shadow-sm"
         style="max-width: 1000px;">

        <h5 class="fw-bold mb-3">
            Enterprise Exchange Rate Conversions
        </h5>

        <div class="table-responsive">

            <table class="table table-hover align-middle mb-0"
                   style="font-size: 0.85rem;">

                <thead class="table-light text-uppercase fw-bold text-secondary"
                       style="font-size: 0.75rem; letter-spacing: 0.5px;">

                    <tr>
                        <th>Code</th>
                        <th>Name</th>
                        <th>Symbol</th>
                        <th>
                            Exchange Rate
                            (1 @Model.BaseCurrencyCode = X)
                        </th>
                        <th>Precision</th>
                        <th>Last Updated</th>
                        <th>Status</th>
                        <th class="text-center">Actions</th>
                    </tr>

                </thead>

                <tbody>

                    @if (Model.Currencies != null && Model.Currencies.Any())
                    {
                        @foreach (var c in Model.Currencies)
                        {
                            <tr>

                                <td class="fw-bold text-dark">
                                    <code>@c.CurrencyCode</code>
                                </td>

                                <td>
                                    @c.CurrencyName
                                </td>

                                <td>
                                    <span class="badge bg-light text-dark font-monospace fs-6 px-2.5">
                                        @c.Symbol
                                    </span>
                                </td>

                                <td class="fw-bold text-dark font-monospace">
                                    @c.ExchangeRate.ToString($"F{c.DecimalPlaces}")
                                </td>

                                <td>
                                    @c.DecimalPlaces Decimals
                                </td>

                                <td class="text-muted">
                                    @c.LastUpdated.ToString("dd MMM yyyy hh:mm tt")
                                </td>

                                <td>

                                    @if (c.IsBaseCurrency)
                                    {
                                        <span class="badge bg-primary rounded-pill px-2.5">
                                            Base Currency
                                        </span>
                                    }
                                    else if (c.IsActive)
                                    {
                                        <span class="badge bg-success-subtle text-success rounded-pill px-2.5">
                                            Active
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger-subtle text-danger rounded-pill px-2.5">
                                            Inactive
                                        </span>
                                    }

                                </td>

                                <td class="text-center">

                                    <div class="d-flex justify-content-center gap-1">

                                        <!-- Edit rate -->
                                        @if (!c.IsBaseCurrency)
                                        {
                                            <button class="btn btn-sm btn-outline-secondary py-1 px-2.5 rounded-pill"
                                                    onclick="openEditModal(@c.CurrencyId, '@c.CurrencyCode', @c.ExchangeRate)"
                                                    title="Edit Rate">

                                                <i class="fa-solid fa-pen-to-square"></i>

                                            </button>

                                            <!-- Toggle status -->
                                            <form action="/AdminMaster/ToggleCurrencyStatus"
                                                  method="post"
                                                  class="d-inline">

                                                @Html.AntiForgeryToken()

                                                <input type="hidden"
                                                       name="id"
                                                       value="@c.CurrencyId" />

                                                <button type="submit"
                                                        class="btn btn-sm btn-outline-warning py-1 px-2.5 rounded-pill"
                                                        title="Toggle Status">

                                                    <i class="fa-solid @(c.IsActive ? "fa-ban" : "fa-check")"></i>

                                                </button>

                                            </form>
                                        }

                                        <!-- History -->
                                        <button class="btn btn-sm btn-outline-info py-1 px-2.5 rounded-pill"
                                                onclick="openHistoryModal(@c.CurrencyId, '@c.CurrencyCode')"
                                                title="Rate History">

                                            <i class="fa-solid fa-timeline"></i>

                                        </button>

                                    </div>

                                </td>

                            </tr>
                        }
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>


<!-- =========================================================
     1. ADD CURRENCY MODAL
     ========================================================= -->

<div class="modal fade text-start"
     id="addCurrencyModal"
     tabindex="-1"
     aria-labelledby="addCurrencyLabel"
     aria-hidden="true">

    <div class="modal-dialog">

        <div class="modal-content">

            <form action="/AdminMaster/CreateCurrency" method="post">

                @Html.AntiForgeryToken()

                <div class="modal-header">

                    <h5 class="modal-title fw-bold" id="addCurrencyLabel">
                        Add New Currency
                    </h5>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal"
                            aria-label="Close">
                    </button>

                </div>


                <div class="modal-body">

                    <div class="mb-3">

                        <label class="form-label small fw-semibold">
                            Currency Code (ISO 3-Letter)
                        </label>

                        <input type="text"
                               name="CurrencyCode"
                               class="form-control text-uppercase"
                               maxlength="3"
                               placeholder="e.g. USD"
                               required />

                    </div>


                    <div class="mb-3">

                        <label class="form-label small fw-semibold">
                            Currency Name
                        </label>

                        <input type="text"
                               name="CurrencyName"
                               class="form-control"
                               placeholder="e.g. US Dollar"
                               required />

                    </div>


                    <div class="mb-3">

                        <label class="form-label small fw-semibold">
                            Symbol
                        </label>

                        <input type="text"
                               name="Symbol"
                               class="form-control"
                               placeholder="e.g. $"
                               required />

                    </div>


                    <div class="mb-3">

                        <label class="form-label small fw-semibold">
                            Exchange Rate relative to Base Currency
                        </label>

                        <input type="number"
                               step="0.000001"
                               name="ExchangeRate"
                               class="form-control"
                               placeholder="e.g. 83.450000"
                               required />

                    </div>


                    <div class="mb-3">

                        <label class="form-label small fw-semibold">
                            Decimal Places
                        </label>

                        <select name="DecimalPlaces"
                                class="form-select">

                            <option value="0">
                                0 places
                            </option>

                            <option value="2" selected>
                                2 places
                            </option>

                            <option value="3">
                                3 places
                            </option>

                            <option value="4">
                                4 places
                            </option>

                        </select>

                    </div>


                    <div class="form-check form-switch mb-3 mt-4">

                        <input class="form-check-input"
                               type="checkbox"
                               name="IsActive"
                               value="true"
                               checked
                               id="isActiveSwitch" />

                        <label class="form-check-label small fw-semibold"
                               for="isActiveSwitch">

                            Is Active

                        </label>

                    </div>

                </div>


                <div class="modal-footer">

                    <button type="button"
                            class="btn btn-outline-secondary rounded-pill px-3 btn-sm"
                            data-bs-dismiss="modal">

                        Cancel

                    </button>

                    <button type="submit"
                            class="btn btn-primary rounded-pill px-3 btn-sm">

                        Save Currency

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>


<!-- =========================================================
     2. EDIT RATE MODAL
     ========================================================= -->

<div class="modal fade text-start"
     id="editRateModal"
     tabindex="-1"
     aria-labelledby="editRateLabel"
     aria-hidden="true">

    <div class="modal-dialog modal-sm">

        <div class="modal-content">

            <form action="/AdminMaster/UpdateRate" method="post">

                @Html.AntiForgeryToken()

                <input type="hidden"
                       name="id"
                       id="editCurrencyId" />


                <div class="modal-header">

                    <h5 class="modal-title fw-bold"
                        id="editRateLabel">

                        Edit Exchange Rate

                    </h5>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal"
                            aria-label="Close">
                    </button>

                </div>


                <div class="modal-body">

                    <div class="mb-3">

                        <label class="form-label small fw-semibold">
                            Currency Code
                        </label>

                        <input type="text"
                               id="editCurrencyCode"
                               class="form-control bg-light"
                               readonly />

                    </div>


                    <div class="mb-3">

                        <label class="form-label small fw-semibold">
                            New Exchange Rate
                        </label>

                        <input type="number"
                               step="0.000001"
                               name="rate"
                               id="editExchangeRate"
                               class="form-control"
                               required />

                    </div>

                </div>


                <div class="modal-footer">

                    <button type="button"
                            class="btn btn-outline-secondary rounded-pill px-3 btn-sm"
                            data-bs-dismiss="modal">

                        Cancel

                    </button>

                    <button type="submit"
                            class="btn btn-primary rounded-pill px-3 btn-sm">

                        Update Rate

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>


<!-- =========================================================
     3. RATE HISTORY MODAL
     ========================================================= -->

<div class="modal fade text-start"
     id="historyModal"
     tabindex="-1"
     aria-labelledby="historyLabel"
     aria-hidden="true">

    <div class="modal-dialog">

        <div class="modal-content">

            <div class="modal-header">

                <h5 class="modal-title fw-bold"
                    id="historyLabel">

                    Exchange Rate Fluctuation Log

                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Close">
                </button>

            </div>


            <div class="modal-body">

                <p class="small text-muted mb-3">

                    Historical conversion rates logged for:

                    <strong class="text-dark"
                            id="historyCode">
                        USD
                    </strong>

                </p>


                <div class="table-responsive"
                     style="max-height: 350px;">

                    <table class="table table-sm table-hover align-middle mb-0"
                           style="font-size: 0.8rem;">

                        <thead class="table-light">

                            <tr>

                                <th>
                                    Exchange Rate
                                </th>

                                <th>
                                    Timestamp
                                </th>

                            </tr>

                        </thead>

                        <tbody id="historyTableBody">

                            <!-- Populated dynamically via JS -->

                        </tbody>

                    </table>

                </div>

            </div>


            <div class="modal-footer">

                <button type="button"
                        class="btn btn-outline-secondary rounded-pill px-3 btn-sm"
                        data-bs-dismiss="modal">

                    Close

                </button>

            </div>

        </div>

    </div>

</div>


<script>

    // Edit Rate Modal binder
    function openEditModal(id, code, currentRate) {

        document.getElementById("editCurrencyId").value = id;

        document.getElementById("editCurrencyCode").value = code;

        document.getElementById("editExchangeRate").value = currentRate;

        var myModal = new bootstrap.Modal(
            document.getElementById('editRateModal')
        );

        myModal.show();
    }


    // Fetch and open History Modal
    function openHistoryModal(id, code) {

        document.getElementById("historyCode").innerText = code;

        const tbody = document.getElementById("historyTableBody");

        tbody.innerHTML =
            '<tr>' +
                '<td colspan="2" class="text-center py-3 text-muted">' +
                    '<i class="fa-solid fa-circle-notch fa-spin me-2"></i>' +
                    'Loading rate records...' +
                '</td>' +
            '</tr>';


        var myModal = new bootstrap.Modal(
            document.getElementById('historyModal')
        );

        myModal.show();


        fetch(`/AdminMaster/GetRateHistory/${id}`)
            .then(res => res.json())
            .then(data => {

                tbody.innerHTML = "";

                if (data && data.length > 0) {

                    data.forEach(item => {

                        const tr = document.createElement("tr");

                        tr.innerHTML = `
                            <td class="font-monospace fw-semibold">
                                ${item.rate}
                            </td>
                            <td class="text-muted">
                                ${item.date}
                            </td>
                        `;

                        tbody.appendChild(tr);

                    });

                }
                else {

                    tbody.innerHTML =
                        '<tr>' +
                            '<td colspan="2" class="text-center py-3 text-muted">' +
                                'No historical fluctuations logged.' +
                            '</td>' +
                        '</tr>';

                }

            })
            .catch(err => {

                console.error(err);

                tbody.innerHTML =
                    '<tr>' +
                        '<td colspan="2" class="text-center py-3 text-danger">' +
                            '<i class="fa-solid fa-circle-xmark me-2"></i>' +
                            'Failed to fetch rate logs.' +
                        '</td>' +
                    '</tr>';

            });

    }

</script>


<style>

    /* =========================================================
       CURRENCY MASTER
       PREMIUM ERP ANIMATION & COLOR SYSTEM
       CSS ONLY
       ========================================================= */

    :root {

        --currency-primary: #0d6efd;
        --currency-primary-dark: #0a58ca;

        --currency-success: #198754;
        --currency-danger: #dc3545;
        --currency-warning: #f59e0b;
        --currency-info: #0dcaf0;

        --currency-border: #e8edf3;

        --currency-text: #27364b;
        --currency-muted: #6c757d;

        --currency-surface: #ffffff;
        --currency-soft: #f8fafc;

        --currency-shadow:
            0 10px 30px rgba(15, 23, 42, 0.055);

        --currency-shadow-hover:
            0 16px 38px rgba(15, 23, 42, 0.095);

        --currency-transition:
            all 0.25s cubic-bezier(0.4, 0, 0.2, 1);

        --currency-transition-fast:
            all 0.18s cubic-bezier(0.4, 0, 0.2, 1);

    }


    /* =========================================================
       PAGE ENTRANCE
       ========================================================= */

    .container-fluid.py-4.text-start {

        animation:
            currencyPageEnter
            0.55s
            cubic-bezier(0.22, 1, 0.36, 1)
            both;

    }


    @@keyframes currencyPageEnter {

        from {

            opacity: 0;

            transform:
                translateY(12px);

        }

        to {

            opacity: 1;

            transform:
                translateY(0);

        }

    }


    /* =========================================================
       HEADER ANIMATION
       ========================================================= */

    .container-fluid.py-4.text-start > .d-flex:first-child {

        animation:
            currencyHeaderEnter
            0.65s
            cubic-bezier(0.22, 1, 0.36, 1)
            both;

    }


    @@keyframes currencyHeaderEnter {

        from {

            opacity: 0;

            transform:
                translateY(-10px);

        }

        to {

            opacity: 1;

            transform:
                translateY(0);

        }

    }


    /* =========================================================
       CURRENCY ICON
       ========================================================= */

    .container-fluid.py-4.text-start h4 .fa-coins {

        display: inline-block;

        transition:
            var(--currency-transition);

        transform-origin: center;

    }


    .container-fluid.py-4.text-start h4:hover .fa-coins {

        transform:
            rotate(-8deg)
            scale(1.08);

    }


    /* =========================================================
       BREADCRUMB
       ========================================================= */

    .breadcrumb {

        animation:
            breadcrumbFade
            0.7s
            ease
            both;

        animation-delay:
            0.12s;

    }


    @@keyframes breadcrumbFade {

        from {

            opacity: 0;

            transform:
                translateY(4px);

        }

        to {

            opacity: 1;

            transform:
                translateY(0);

        }

    }


    .breadcrumb-item a {

        transition:
            var(--currency-transition-fast);

    }


    .breadcrumb-item a:hover {

        color:
            var(--currency-primary) !important;

        transform:
            translateX(2px);

    }


    /* =========================================================
       TOP ACTION AREA
       ========================================================= */

    .container-fluid.py-4.text-start
    > .d-flex:first-child
    .d-flex.flex-wrap {

        animation:
            actionAreaEnter
            0.7s
            cubic-bezier(0.22, 1, 0.36, 1)
            both;

        animation-delay:
            0.1s;

    }


    @@keyframes actionAreaEnter {

        from {

            opacity: 0;

            transform:
                translateX(12px);

        }

        to {

            opacity: 1;

            transform:
                translateX(0);

        }

    }


    /* =========================================================
       BASE CURRENCY SELECT
       ========================================================= */

    .input-group-sm {

        transition:
            var(--currency-transition);

    }


    .input-group-sm:focus-within {

        transform:
            translateY(-1px);

        filter:
            drop-shadow(
                0 5px 12px
                rgba(13, 110, 253, 0.10)
            );

    }


    .input-group-text {

        transition:
            var(--currency-transition-fast);

    }


    .input-group:focus-within .input-group-text {

        color:
            var(--currency-primary) !important;

        background:
            #f3f7ff !important;

    }


    .form-select {

        transition:
            border-color 0.2s ease,
            box-shadow 0.2s ease,
            background-color 0.2s ease;

    }


    .form-select:hover {

        border-color:
            rgba(13, 110, 253, 0.35);

    }


    .form-select:focus {

        border-color:
            rgba(13, 110, 253, 0.55);

        box-shadow:
            0 0 0 0.18rem
            rgba(13, 110, 253, 0.10);

    }


    /* =========================================================
       PREMIUM BUTTON ANIMATION
       ========================================================= */

    .container-fluid.py-4.text-start .btn {

        transition:
            transform 0.2s cubic-bezier(0.4, 0, 0.2, 1),
            box-shadow 0.2s ease,
            background-color 0.2s ease,
            border-color 0.2s ease,
            color 0.2s ease;

        will-change:
            transform;

    }


    .container-fluid.py-4.text-start .btn:hover {

        transform:
            translateY(-2px);

    }


    .container-fluid.py-4.text-start .btn:active {

        transform:
            translateY(0)
            scale(0.97);

    }


    .container-fluid.py-4.text-start .btn-primary {

        box-shadow:
            0 5px 14px
            rgba(13, 110, 253, 0.16);

    }


    .container-fluid.py-4.text-start .btn-primary:hover {

        background-color:
            var(--currency-primary-dark);

        box-shadow:
            0 8px 20px
            rgba(13, 110, 253, 0.23);

    }


    .container-fluid.py-4.text-start .btn-outline-primary:hover {

        box-shadow:
            0 7px 17px
            rgba(13, 110, 253, 0.13);

    }


    .container-fluid.py-4.text-start .btn-outline-secondary:hover {

        box-shadow:
            0 6px 14px
            rgba(108, 117, 125, 0.13);

    }


    .container-fluid.py-4.text-start .btn-outline-warning:hover {

        box-shadow:
            0 6px 14px
            rgba(245, 158, 11, 0.16);

    }


    .container-fluid.py-4.text-start .btn-outline-info:hover {

        box-shadow:
            0 6px 14px
            rgba(13, 202, 240, 0.16);

    }


    /* =========================================================
       BUTTON ICON MICRO ANIMATIONS
       ========================================================= */

    .btn .fa-rotate {

        transition:
            transform 0.35s ease;

    }


    .btn:hover .fa-rotate {

        transform:
            rotate(180deg);

    }


    .btn .fa-plus {

        transition:
            transform 0.22s ease;

    }


    .btn:hover .fa-plus {

        transform:
            rotate(90deg);

    }


    .btn:hover .fa-pen-to-square {

        transform:
            scale(1.08);

    }


    .btn:hover .fa-timeline {

        transform:
            translateY(-1px)
            scale(1.08);

    }


    .btn i {

        transition:
            transform 0.2s ease;

    }


    /* =========================================================
       FEEDBACK ALERTS
       ========================================================= */

    .alert {

        animation:
            alertSlideIn
            0.45s
            cubic-bezier(0.22, 1, 0.36, 1)
            both;

        border:
            1px solid transparent;

        box-shadow:
            0 6px 18px
            rgba(15, 23, 42, 0.045);

    }


    @@keyframes alertSlideIn {

        from {

            opacity: 0;

            transform:
                translateY(-8px)
                scale(0.985);

        }

        to {

            opacity: 1;

            transform:
                translateY(0)
                scale(1);

        }

    }


    .alert-success {

        border-color:
            rgba(25, 135, 84, 0.12);

    }


    .alert-danger {

        border-color:
            rgba(220, 53, 69, 0.12);

    }


    .alert .fa-circle-check,
    .alert .fa-triangle-exclamation {

        animation:
            alertIconPop
            0.45s
            ease
            0.15s
            both;

    }


    @@keyframes alertIconPop {

        from {

            opacity: 0;

            transform:
                scale(0.65);

        }

        70% {

            transform:
                scale(1.08);

        }

        to {

            opacity: 1;

            transform:
                scale(1);

        }

    }


    /* =========================================================
       MAIN EXCHANGE RATE CARD
       ========================================================= */

    .container-fluid.py-4.text-start
    > .bg-white.border.rounded-3.p-4.shadow-sm {


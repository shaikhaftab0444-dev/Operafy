@model ERP_System.Models.CurrencyViewModel

@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Currency Master";

    var currencies = Model.Currencies ?? new List<ERP_System.Models.Currency>();
    var totalCurrencies = Model.Currencies?.Count ?? 0;
    var activeCurrencies = Model.Currencies?.Count(x => x.IsActive) ?? 0;
    var inactiveCurrencies = totalCurrencies - activeCurrencies;
    var baseCurrency = Model.Currencies?.FirstOrDefault(x => x.IsBaseCurrency);
}

<style>
    /* =========================================================
           CURRENCY MASTER
           PREMIUM ERP UI
           DESIGN + ANIMATION SYSTEM
           ========================================================= */

    :root {
        --cm-primary: #2563eb;
        --cm-primary-dark: #1d4ed8;
        --cm-primary-soft: #eff6ff;
        --cm-success: #16a34a;
        --cm-success-soft: #ecfdf3;
        --cm-warning: #f59e0b;
        --cm-warning-soft: #fffbeb;
        --cm-danger: #dc2626;
        --cm-danger-soft: #fef2f2;
        --cm-info: #0891b2;
        --cm-info-soft: #ecfeff;
        --cm-text: #172033;
        --cm-muted: #64748b;
        --cm-light: #f8fafc;
        --cm-border: #e5eaf0;
        --cm-white: #ffffff;
        --cm-shadow: 0 10px 35px rgba(15, 23, 42, 0.055);
        --cm-shadow-hover: 0 18px 45px rgba(15, 23, 42, 0.10);
        --cm-radius: 16px;
        --cm-transition: all .28s cubic-bezier(.4,0,.2,1);
    }

    /* =========================================================
           PAGE
           ========================================================= */

    .currency-page {
        position: relative;
        min-height: 100%;
        animation: cmPageIn .65s cubic-bezier(.22,1,.36,1) both;
    }

    @@keyframes cmPageIn {
        from {
            opacity: 0;
            transform: translateY(16px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* =========================================================
           HEADER
           ========================================================= */

    .currency-header {
        position: relative;
        overflow: hidden;
        padding: 22px 24px;
        border: 1px solid var(--cm-border);
        border-radius: var(--cm-radius);
        background: linear-gradient( 135deg, #ffffff 0%, #f8fbff 55%, #f1f6ff 100% );
        box-shadow: var(--cm-shadow);
        animation: cmHeaderIn .7s cubic-bezier(.22,1,.36,1) both;
    }

        .currency-header::before {
            content: "";
            position: absolute;
            width: 240px;
            height: 240px;
            right: -80px;
            top: -130px;
            border-radius: 50%;
            background: rgba(37, 99, 235, .055);
            pointer-events: none;
        }

        .currency-header::after {
            content: "";
            position: absolute;
            width: 160px;
            height: 160px;
            right: 100px;
            bottom: -120px;
            border-radius: 50%;
            background: rgba(14, 165, 233, .045);
            pointer-events: none;
        }

    @@keyframes cmHeaderIn {
        from {
            opacity: 0;
            transform: translateY(-14px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .currency-header-content {
        position: relative;
        z-index: 2;
    }

    .currency-title {
        display: flex;
        align-items: center;
        gap: 12px;
        margin: 0;
        color: var(--cm-text);
        font-size: 1.25rem;
        font-weight: 800;
        letter-spacing: -.35px;
    }

    .currency-title-icon {
        width: 42px;
        height: 42px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        flex: 0 0 42px;
        color: #fff;
        border-radius: 13px;
        background: linear-gradient( 135deg, var(--cm-primary), #4f8df7 );
        box-shadow: 0 8px 20px rgba(37, 99, 235, .22);
        transition: var(--cm-transition);
    }

    .currency-header:hover .currency-title-icon {
        transform: rotate(-6deg) scale(1.06);
    }

    .currency-subtitle {
        margin: 5px 0 0 54px;
        color: var(--cm-muted);
        font-size: .78rem;
    }

    /* =========================================================
           BREADCRUMB
           ========================================================= */

    .currency-breadcrumb {
        margin-top: 12px;
        margin-bottom: 0;
        padding: 0;
        font-size: .72rem;
    }

        .currency-breadcrumb a {
            color: var(--cm-muted);
            transition: var(--cm-transition);
        }

            .currency-breadcrumb a:hover {
                color: var(--cm-primary);
            }

    /* =========================================================
           HEADER ACTIONS
           ========================================================= */

    .currency-actions {
        position: relative;
        z-index: 5;
        display: flex;
        align-items: center;
        justify-content: flex-end;
        flex-wrap: wrap;
        gap: 8px;
    }

    .base-currency-box {
        display: flex;
        align-items: center;
        min-height: 38px;
        overflow: hidden;
        border: 1px solid var(--cm-border);
        border-radius: 999px;
        background: #fff;
        box-shadow: 0 4px 14px rgba(15,23,42,.035);
        transition: var(--cm-transition);
    }

        .base-currency-box:hover {
            border-color: rgba(37,99,235,.28);
            box-shadow: 0 8px 20px rgba(37,99,235,.08);
            transform: translateY(-1px);
        }

    .base-currency-label {
        padding: 0 11px;
        color: var(--cm-muted);
        background: #f8fafc;
        font-size: .68rem;
        font-weight: 700;
        white-space: nowrap;
    }

    .base-currency-select {
        min-width: 105px;
        border: 0 !important;
        outline: 0 !important;
        box-shadow: none !important;
        padding-left: 9px;
        padding-right: 30px;
        font-size: .74rem;
        font-weight: 700;
        color: var(--cm-text);
        cursor: pointer;
    }

    .cm-btn {
        min-height: 38px;
        border-radius: 999px !important;
        padding: 8px 14px !important;
        font-size: .72rem !important;
        font-weight: 700 !important;
        transition: var(--cm-transition) !important;
    }

        .cm-btn:hover {
            transform: translateY(-2px);
        }

        .cm-btn:active {
            transform: translateY(0) scale(.97);
        }

    .cm-btn-primary {
        box-shadow: 0 7px 18px rgba(37,99,235,.18);
    }

        .cm-btn-primary:hover {
            background: var(--cm-primary-dark) !important;
            box-shadow: 0 10px 24px rgba(37,99,235,.25);
        }

    .sync-icon {
        transition: transform .45s ease;
    }

    .cm-btn:hover .sync-icon {
        transform: rotate(180deg);
    }

    .add-icon {
        transition: transform .25s ease;
    }

    .cm-btn:hover .add-icon {
        transform: rotate(90deg);
    }

    /* =========================================================
           ALERTS
           ========================================================= */

    .cm-alert {
        border-radius: 12px;
        border: 1px solid transparent;
        box-shadow: 0 7px 20px rgba(15,23,42,.05);
        animation: cmAlertIn .45s cubic-bezier(.22,1,.36,1) both;
        font-size: .76rem;
    }

    @@keyframes cmAlertIn {
        from {
            opacity: 0;
            transform: translateY(-8px) scale(.985);
        }

        to {
            opacity: 1;
            transform: translateY(0) scale(1);
        }
    }

    /* =========================================================
           SUMMARY CARDS
           ========================================================= */

    .cm-stat-card {
        position: relative;
        overflow: hidden;
        height: 100%;
        min-height: 112px;
        padding: 18px;
        border: 1px solid var(--cm-border);
        border-radius: var(--cm-radius);
        background: var(--cm-white);
        box-shadow: var(--cm-shadow);
        transition: var(--cm-transition);
        animation: cmStatIn .6s cubic-bezier(.22,1,.36,1) both;
    }

        .cm-stat-card:nth-child(1) {
            animation-delay: .08s;
        }

        .cm-stat-card:nth-child(2) {
            animation-delay: .14s;
        }

        .cm-stat-card:nth-child(3) {
            animation-delay: .20s;
        }

        .cm-stat-card:nth-child(4) {
            animation-delay: .26s;
        }

    @@keyframes cmStatIn {
        from {
            opacity: 0;
            transform: translateY(14px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .cm-stat-card:hover {
        transform: translateY(-5px);
        box-shadow: var(--cm-shadow-hover);
        border-color: rgba(37,99,235,.14);
    }

    .cm-stat-card::before {
        content: "";
        position: absolute;
        left: 0;
        top: 0;
        bottom: 0;
        width: 3px;
        background: var(--cm-primary);
        opacity: .9;
    }

    .cm-stat-card.success::before {
        background: var(--cm-success);
    }

    .cm-stat-card.warning::before {
        background: var(--cm-warning);
    }

    .cm-stat-card.info::before {
        background: var(--cm-info);
    }

    .cm-stat-icon {
        width: 38px;
        height: 38px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 12px;
        background: var(--cm-primary-soft);
        color: var(--cm-primary);
        transition: var(--cm-transition);
    }

    .cm-stat-card.success .cm-stat-icon {
        background: var(--cm-success-soft);
        color: var(--cm-success);
    }

    .cm-stat-card.warning .cm-stat-icon {
        background: var(--cm-warning-soft);
        color: var(--cm-warning);
    }

    .cm-stat-card.info .cm-stat-icon {
        background: var(--cm-info-soft);
        color: var(--cm-info);
    }

    .cm-stat-card:hover .cm-stat-icon {
        transform: rotate(-5deg) scale(1.08);
    }

    .cm-stat-label {
        color: var(--cm-muted);
        font-size: .68rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .45px;
    }

    .cm-stat-value {
        margin-top: 7px;
        color: var(--cm-text);
        font-size: 1.25rem;
        font-weight: 800;
        letter-spacing: -.4px;
    }

    .cm-stat-note {
        margin-top: 2px;
        color: var(--cm-muted);
        font-size: .67rem;
    }

    /* =========================================================
           MAIN CARD
           ========================================================= */

    .currency-main-card {
        position: relative;
        overflow: hidden;
        border: 1px solid var(--cm-border);
        border-radius: var(--cm-radius);
        background: #fff;
        box-shadow: var(--cm-shadow);
        animation: cmMainIn .7s .2s cubic-bezier(.22,1,.36,1) both;
    }

    @@keyframes cmMainIn {
        from {
            opacity: 0;
            transform: translateY(20px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .currency-main-card::before {
        content: "";
        position: absolute;
        left: 0;
        top: 0;
        right: 0;
        height: 3px;
        background: linear-gradient( 90deg, var(--cm-primary), #60a5fa, #22c55e );
        opacity: .85;
    }

    .currency-card-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 15px;
        padding: 20px 22px 15px;
        border-bottom: 1px solid #edf1f5;
    }

    .currency-card-title {
        margin: 0;
        color: var(--cm-text);
        font-size: .95rem;
        font-weight: 800;
    }

    .currency-card-description {
        margin: 4px 0 0;
        color: var(--cm-muted);
        font-size: .7rem;
    }

    .base-indicator {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 6px 10px;
        border: 1px solid rgba(37,99,235,.12);
        border-radius: 999px;
        background: var(--cm-primary-soft);
        color: var(--cm-primary);
        font-size: .66rem;
        font-weight: 700;
        white-space: nowrap;
    }

    .base-dot {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: var(--cm-primary);
        box-shadow: 0 0 0 4px rgba(37,99,235,.10);
        animation: cmPulse 2s infinite;
    }

    @@keyframes cmPulse {
        0%, 100% {
            box-shadow: 0 0 0 3px rgba(37,99,235,.08);
        }

        50% {
            box-shadow: 0 0 0 6px rgba(37,99,235,0);
        }
    }

    /* =========================================================
           TABLE
           ========================================================= */

    .currency-table-wrapper {
        overflow-x: auto;
    }

    .currency-table {
        width: 100%;
        min-width: 980px;
        margin: 0;
        font-size: .76rem;
    }

        .currency-table thead th {
            padding: 13px 14px;
            border-bottom: 1px solid #e9edf2;
            background: #f8fafc;
            color: #667085;
            font-size: .65rem;
            font-weight: 800;
            letter-spacing: .55px;
            text-transform: uppercase;
            white-space: nowrap;
        }

        .currency-table tbody tr {
            position: relative;
            animation: cmRowIn .45s cubic-bezier(.22,1,.36,1) both;
            transition: background-color .25s ease;
        }

            .currency-table tbody tr:nth-child(1) {
                animation-delay: .28s;
            }

            .currency-table tbody tr:nth-child(2) {
                animation-delay: .33s;
            }

            .currency-table tbody tr:nth-child(3) {
                animation-delay: .38s;
            }

            .currency-table tbody tr:nth-child(4) {
                animation-delay: .43s;
            }

            .currency-table tbody tr:nth-child(5) {
                animation-delay: .48s;
            }

            .currency-table tbody tr:nth-child(n+6) {
                animation-delay: .52s;
            }

    @@keyframes cmRowIn {
        from {
            opacity: 0;
            transform: translateX(-7px);
        }

        to {
            opacity: 1;
            transform: translateX(0);
        }
    }

    .currency-table tbody tr:hover {
        background: #f8fbff !important;
    }

    .currency-table tbody td {
        padding: 14px;
        border-color: #eef1f5;
        color: #475467;
        vertical-align: middle;
    }

    .currency-table tbody tr:last-child td {
        border-bottom: 0;
    }

    .currency-code {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 48px;
        padding: 5px 8px;
        border-radius: 7px;
        background: #f1f5f9;
        color: #334155;
        font-family: monospace;
        font-size: .73rem;
        font-weight: 800;
        transition: var(--cm-transition);
    }

    .currency-table tbody tr:hover .currency-code {
        background: #eaf2ff;
        color: var(--cm-primary);
        transform: translateX(2px);
    }

    .currency-name {
        color: var(--cm-text);
        font-weight: 700;
    }

    .currency-symbol {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 34px;
        height: 30px;
        padding: 0 8px;
        border: 1px solid #e7ebf0;
        border-radius: 8px;
        background: #f8fafc;
        color: var(--cm-text);
        font-family: monospace;
        font-size: .9rem;
        font-weight: 700;
        transition: var(--cm-transition);
    }

    .currency-table tbody tr:hover .currency-symbol {
        background: #fff;
        border-color: rgba(37,99,235,.18);
        transform: scale(1.06);
        box-shadow: 0 5px 12px rgba(15,23,42,.06);
    }

    .exchange-rate {
        color: var(--cm-text);
        font-family: monospace;
        font-size: .78rem;
        font-weight: 800;
    }

    .decimal-text {
        color: var(--cm-muted);
        font-size: .69rem;
    }

    .updated-text {
        color: var(--cm-muted);
        font-size: .68rem;
        white-space: nowrap;
    }

    /* =========================================================
           STATUS
           ========================================================= */

    .cm-status {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 6px 10px;
        border-radius: 999px;
        font-size: .63rem;
        font-weight: 800;
        white-space: nowrap;
        transition: var(--cm-transition);
    }

    .cm-status-base {
        background: var(--cm-primary-soft);
        color: var(--cm-primary);
        border: 1px solid rgba(37,99,235,.10);
    }

    .cm-status-active {
        background: var(--cm-success-soft);
        color: var(--cm-success);
        border: 1px solid rgba(22,163,74,.10);
    }

    .cm-status-inactive {
        background: var(--cm-danger-soft);
        color: var(--cm-danger);
        border: 1px solid rgba(220,38,38,.10);
    }

    .status-dot {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: currentColor;
    }

    .cm-status-active .status-dot {
        animation: cmStatusPulse 1.8s infinite;
    }

    @@keyframes cmStatusPulse {
        0%, 100% {
            box-shadow: 0 0 0 0 rgba(22,163,74,.3);
        }

        50% {
            box-shadow: 0 0 0 5px rgba(22,163,74,0);
        }
    }

    .currency-table tbody tr:hover .cm-status {
        transform: translateY(-1px);
    }

    /* =========================================================
           ACTION BUTTONS
           ========================================================= */

    .cm-action-group {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 5px;
    }

    .cm-action-btn {
        width: 32px;
        height: 32px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 0 !important;
        border-radius: 9px !important;
        transition: var(--cm-transition) !important;
    }

        .cm-action-btn:hover {
            transform: translateY(-3px) scale(1.05);
        }

        .cm-action-btn:active {
            transform: scale(.92);
        }

        .cm-action-btn i {
            transition: transform .22s ease;
        }

        .cm-action-btn:hover .fa-pen-to-square {
            transform: rotate(-8deg) scale(1.08);
        }

        .cm-action-btn:hover .fa-ban {
            transform: scale(1.1);
        }

        .cm-action-btn:hover .fa-check {
            transform: scale(1.15);
        }

        .cm-action-btn:hover .fa-timeline {
            transform: translateY(-2px) scale(1.08);
        }

    /* =========================================================
           EMPTY / FOOTER
           ========================================================= */

    .currency-empty {
        padding: 55px 20px !important;
        text-align: center;
    }

    .currency-empty-icon {
        width: 58px;
        height: 58px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 12px;
        border-radius: 16px;
        background: #f1f5f9;
        color: #94a3b8;
        font-size: 1.35rem;
    }

    .currency-footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        padding: 12px 20px;
        border-top: 1px solid #edf1f5;
        background: #fbfcfe;
        color: var(--cm-muted);
        font-size: .66rem;
    }

    /* =========================================================
           MODALS
           ========================================================= */

    .cm-modal .modal-dialog {
        transform: translateY(18px) scale(.97);
        opacity: 0;
        transition: transform .32s cubic-bezier(.22,1,.36,1), opacity .25s ease;
    }

    .cm-modal.show .modal-dialog {
        transform: translateY(0) scale(1);
        opacity: 1;
    }

    .cm-modal .modal-content {
        overflow: hidden;
        border: 1px solid rgba(226,232,240,.9);
        border-radius: 18px;
        background: #fff;
        box-shadow: 0 25px 65px rgba(15,23,42,.18);
    }

    .cm-modal .modal-header {
        position: relative;
        padding: 18px 20px;
        border-bottom: 1px solid #edf1f5;
        background: linear-gradient( 135deg, #ffffff, #f8fbff );
    }

        .cm-modal .modal-header::before {
            content: "";
            position: absolute;
            left: 0;
            top: 0;
            width: 100%;
            height: 3px;
            background: linear-gradient( 90deg, var(--cm-primary), #60a5fa );
        }

    .cm-modal .modal-title {
        color: var(--cm-text);
        font-size: .98rem;
        font-weight: 800;
    }

    .modal-title-icon {
        width: 34px;
        height: 34px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        margin-right: 8px;
        border-radius: 10px;
        background: var(--cm-primary-soft);
        color: var(--cm-primary);
    }

    .cm-modal .modal-body {
        padding: 20px;
    }

    .cm-modal .modal-footer {
        padding: 13px 20px;
        border-top: 1px solid #edf1f5;
        background: #fbfcfe;
    }

    .cm-form-group {
        animation: cmFieldIn .38s ease both;
    }

        .cm-form-group:nth-child(1) {
            animation-delay: .06s;
        }

        .cm-form-group:nth-child(2) {
            animation-delay: .10s;
        }

        .cm-form-group:nth-child(3) {
            animation-delay: .14s;
        }

        .cm-form-group:nth-child(4) {
            animation-delay: .18s;
        }

        .cm-form-group:nth-child(5) {
            animation-delay: .22s;
        }

    @@keyframes cmFieldIn {
        from {
            opacity: 0;
            transform: translateY(7px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .cm-modal label {
        margin-bottom: 6px;
        color: #475467;
        font-size: .7rem;
        font-weight: 700;
    }

    .cm-required {
        color: var(--cm-danger);
    }

    .cm-modal .form-control,
    .cm-modal .form-select {
        min-height: 38px;
        border: 1px solid #dfe5ec;
        border-radius: 9px;
        color: var(--cm-text);
        font-size: .76rem;
        transition: var(--cm-transition);
    }

        .cm-modal .form-control:hover,
        .cm-modal .form-select:hover {
            border-color: #c7d2df;
        }

        .cm-modal .form-control:focus,
        .cm-modal .form-select:focus {
            border-color: rgba(37,99,235,.55);
            box-shadow: 0 0 0 4px rgba(37,99,235,.09);
            transform: translateY(-1px);
        }

        .cm-modal .form-control::placeholder {
            color: #a0a9b5;
        }

    .cm-switch {
        padding: 11px 13px;
        border: 1px solid #e7ebf0;
        border-radius: 11px;
        background: #f8fafc;
        transition: var(--cm-transition);
    }

        .cm-switch:hover {
            background: #f4f8ff;
            border-color: rgba(37,99,235,.16);
        }

        .cm-switch .form-check-input {
            cursor: pointer;
        }

    /* =========================================================
           HISTORY
           ========================================================= */

    .history-summary {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 11px 13px;
        margin-bottom: 14px;
        border: 1px solid #e7ebf0;
        border-radius: 11px;
        background: #f8fafc;
    }

    .history-code {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 48px;
        padding: 5px 8px;
        border-radius: 7px;
        background: #eaf2ff;
        color: var(--cm-primary);
        font-family: monospace;
        font-weight: 800;
    }

    .history-scroll {
        max-height: 350px;
        overflow-y: auto;
        border: 1px solid #edf1f5;
        border-radius: 10px;
    }

    .history-table {
        margin: 0;
        font-size: .72rem;
    }

        .history-table thead th {
            position: sticky;
            top: 0;
            z-index: 2;
            padding: 10px 12px;
            border-bottom: 1px solid #e9edf2;
            background: #f8fafc;
            color: #667085;
            font-size: .63rem;
            text-transform: uppercase;
            letter-spacing: .4px;
        }

        .history-table tbody tr {
            animation: cmHistoryIn .3s ease both;
        }

    @@keyframes cmHistoryIn {
        from {
            opacity: 0;
            transform: translateX(-5px);
        }

        to {
            opacity: 1;
            transform: translateX(0);
        }
    }

    .history-table tbody td {
        padding: 10px 12px;
        border-color: #eef1f5;
    }

    .history-table tbody tr:hover {
        background: #f8fbff;
    }

    /* =========================================================
           SCROLLBAR
           ========================================================= */

    .currency-page ::-webkit-scrollbar {
        width: 6px;
        height: 6px;
    }

    .currency-page ::-webkit-scrollbar-track {
        background: #f1f3f6;
        border-radius: 10px;
    }

    .currency-page ::-webkit-scrollbar-thumb {
        background: #cbd5e1;
        border-radius: 10px;
    }

        .currency-page ::-webkit-scrollbar-thumb:hover {
            background: #94a3b8;
        }

    /* =========================================================
           MOBILE
           ========================================================= */

    @@media (max-width: 991.98px) {
        .currency-header {
            padding: 19px;
        }

        .currency-actions {
            justify-content: flex-start;
            width: 100%;
        }

        .currency-header .row > [class*="col-"] {
            width: 100%;
        }

        .base-currency-box {
            flex: 1 1 100%;
        }

        .base-currency-select {
            flex: 1;
        }

        .cm-btn {
            flex: 1 1 auto;
        }
    }

    @@media (max-width: 767.98px) {
        .currency-page {
            padding-top: 12px !important;
        }

        .currency-header {
            border-radius: 14px;
            padding: 17px;
        }

        .currency-title {
            font-size: 1.05rem;
        }

        .currency-title-icon {
            width: 38px;
            height: 38px;
            flex-basis: 38px;
        }

        .currency-subtitle {
            margin-left: 50px;
            line-height: 1.45;
        }

        .currency-actions {
            display: grid;
            grid-template-columns: 1fr 1fr;
            width: 100%;
        }

        .base-currency-box {
            grid-column: 1 / -1;
            width: 100%;
        }

        .cm-btn {
            width: 100%;
        }

        .cm-stat-card {
            min-height: 105px;
        }

        .currency-card-header {
            align-items: flex-start;
            flex-direction: column;
            padding: 17px;
        }

        .base-indicator {
            width: 100%;
            justify-content: center;
        }

        .currency-footer {
            flex-direction: column;
            align-items: flex-start;
        }

        .cm-modal .modal-dialog {
            margin: .65rem;
        }

        .cm-modal .modal-content {
            border-radius: 14px;
        }
    }

    @@media (max-width: 420px) {
        .currency-actions {
            grid-template-columns: 1fr;
        }

        .base-currency-box {
            grid-column: auto;
        }

        .currency-title {
            align-items: flex-start;
        }

        .currency-subtitle {
            margin-left: 0;
            margin-top: 9px;
        }
    }

    /* =========================================================
           REDUCED MOTION
           ========================================================= */

    @@media (prefers-reduced-motion: reduce) {
        *,
        *::before,
        *::after {
            animation-duration: .01ms !important;
            animation-iteration-count: 1 !important;
            transition-duration: .01ms !important;
            scroll-behavior: auto !important;
        }
    }
</style>


<div class="container-fluid py-4 text-start currency-page">

    <!-- =====================================================
         PREMIUM HEADER
         ===================================================== -->

    <div class="currency-header mb-4">
        <div class="row align-items-center g-3">

            <div class="col-lg-6">
                <div class="currency-header-content">

                    <h4 class="currency-title">
                        <span class="currency-title-icon">
                            <i class="fa-solid fa-coins"></i>
                        </span>

                        <span>
                            Currency Master
                            <small class="d-block text-muted fw-normal mt-1"
                                   style="font-size:.68rem;">
                                Exchange Rates & Currency Configuration
                            </small>
                        </span>
                    </h4>

                    <p class="currency-subtitle">
                        Manage enterprise currencies, base currency and exchange-rate conversions.
                    </p>

                    <nav aria-label="breadcrumb">
                        <ol class="breadcrumb currency-breadcrumb">
                            <li class="breadcrumb-item">
                                <a href="/Dashboard"
                                   class="text-decoration-none">
                                    <i class="fa-solid fa-house me-1"></i>
                                    Dashboard
                                </a>
                            </li>

                            <li class="breadcrumb-item active"
                                aria-current="page">
                                Currency Master
                            </li>
                        </ol>
                    </nav>

                </div>
            </div>


            <div class="col-lg-6">
                <div class="currency-actions">

                    <!-- Base Currency -->

                    <form action="/AdminMaster/SetBaseCurrency"
                          method="post"
                          class="d-flex flex-grow-1">

                        @Html.AntiForgeryToken()

                        <div class="base-currency-box w-100">

                            <span class="base-currency-label">
                                <i class="fa-solid fa-star me-1"></i>
                                Base Currency
                            </span>

                            <select name="code"
                                    class="form-select base-currency-select"
                                    onchange="this.form.submit()">

                                @foreach (var c in Model.Currencies)
                                {
                                    <option value="@c.CurrencyCode"
                                            selected="@(c.IsBaseCurrency ? "selected" : null)">
                                        @c.CurrencyCode (@c.Symbol)
                                    </option>
                                }

                            </select>

                        </div>

                    </form>


                    <!-- Sync -->

                    <form action="/AdminMaster/SyncRates"
                          method="post">

                        @Html.AntiForgeryToken()

                        <button type="submit"
                                class="btn btn-outline-primary cm-btn shadow-sm">

                            <i class="fa-solid fa-rotate sync-icon me-1"></i>

                            Sync Live Rates

                        </button>

                    </form>


                    <!-- Add Currency -->

                    <button type="button"
                            class="btn btn-primary cm-btn cm-btn-primary shadow-sm"
                            data-bs-toggle="modal"
                            data-bs-target="#addCurrencyModal">

                        <i class="fa-solid fa-plus add-icon me-1"></i>

                        Add Currency

                    </button>

                </div>
            </div>

        </div>
    </div>


    <!-- =====================================================
         FEEDBACK ALERTS
         ===================================================== -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show cm-alert mb-4"
             role="alert">

            <i class="fa-solid fa-circle-check me-2"></i>

            @TempData["SuccessMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Close">
            </button>

        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show cm-alert mb-4"
             role="alert">

            <i class="fa-solid fa-triangle-exclamation me-2"></i>

            @TempData["ErrorMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Close">
            </button>

        </div>
    }


    <!-- =====================================================
         SUMMARY CARDS
         ===================================================== -->

    <div class="row g-3 mb-4">

        <!-- Total -->

        <div class="col-xl-3 col-sm-6">

            <div class="cm-stat-card">

                <div class="d-flex align-items-center justify-content-between">

                    <div>

                        <div class="cm-stat-label">
                            Total Currencies
                        </div>

                        <div class="cm-stat-value">
                            @totalCurrencies
                        </div>

                        <div class="cm-stat-note">
                            Configured in currency master
                        </div>

                    </div>

                    <div class="cm-stat-icon">
                        <i class="fa-solid fa-coins"></i>
                    </div>

                </div>

            </div>

        </div>


        <!-- Active -->

        <div class="col-xl-3 col-sm-6">

            <div class="cm-stat-card success">

                <div class="d-flex align-items-center justify-content-between">

                    <div>

                        <div class="cm-stat-label">
                            Active
                        </div>

                        <div class="cm-stat-value">
                            @activeCurrencies
                        </div>

                        <div class="cm-stat-note">
                            Available for transactions
                        </div>

                    </div>

                    <div class="cm-stat-icon">
                        <i class="fa-solid fa-circle-check"></i>
                    </div>

                </div>

            </div>

        </div>


        <!-- Inactive -->

        <div class="col-xl-3 col-sm-6">

            <div class="cm-stat-card warning">

                <div class="d-flex align-items-center justify-content-between">

                    <div>

                        <div class="cm-stat-label">
                            Inactive
                        </div>

                        <div class="cm-stat-value">
                            @inactiveCurrencies
                        </div>

                        <div class="cm-stat-note">
                            Currently disabled
                        </div>

                    </div>

                    <div class="cm-stat-icon">
                        <i class="fa-solid fa-circle-pause"></i>
                    </div>

                </div>

            </div>

        </div>


        <!-- Base -->

        <div class="col-xl-3 col-sm-6">

            <div class="cm-stat-card info">

                <div class="d-flex align-items-center justify-content-between">

                    <div>

                        <div class="cm-stat-label">
                            Base Currency
                        </div>

                        <div class="cm-stat-value">
                            @(baseCurrency?.CurrencyCode ?? Model.BaseCurrencyCode)
                        </div>

                        <div class="cm-stat-note">
                            Primary conversion reference
                        </div>

                    </div>

                    <div class="cm-stat-icon">
                        <i class="fa-solid fa-star"></i>
                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- =====================================================
         MAIN CURRENCY TABLE
         ===================================================== -->

    <div class="currency-main-card">

        <div class="currency-card-header">

            <div>

                <h5 class="currency-card-title">
                    <i class="fa-solid fa-chart-line text-primary me-2"></i>
                    Enterprise Exchange Rate Conversions
                </h5>

                <p class="currency-card-description">
                    Current conversion rates based on the selected base currency.
                </p>

            </div>

            <div class="base-indicator">

                <span class="base-dot"></span>

                1 @Model.BaseCurrencyCode = X

            </div>

        </div>


        <div class="currency-table-wrapper">

            <table class="table currency-table align-middle">

                <thead>

                    <tr>

                        <th>
                            Code
                        </th>

                        <th>
                            Currency
                        </th>

                        <th>
                            Symbol
                        </th>

                        <th>
                            Exchange Rate
                        </th>

                        <th>
                            Precision
                        </th>

                        <th>
                            Last Updated
                        </th>

                        <th>
                            Status
                        </th>

                        <th class="text-center">
                            Actions
                        </th>

                    </tr>

                </thead>


                <tbody>

                    @if (Model.Currencies != null && Model.Currencies.Any())
                    {
                        foreach (var c in Model.Currencies)
                        {
                            <tr>

                                <!-- Code -->

                                <td>

                                    <span class="currency-code">
                                        @c.CurrencyCode
                                    </span>

                                </td>


                                <!-- Name -->

                                <td>

                                    <div class="currency-name">
                                        @c.CurrencyName
                                    </div>

                                </td>


                                <!-- Symbol -->

                                <td>

                                    <span class="currency-symbol">
                                        @c.Symbol
                                    </span>

                                </td>


                                <!-- Exchange Rate -->

                                <td>

                                    <span class="exchange-rate">

                                        @c.ExchangeRate.ToString($"F{c.DecimalPlaces}")

                                    </span>

                                </td>


                                <!-- Precision -->

                                <td>

                                    <span class="decimal-text">
                                        @c.DecimalPlaces decimal@(c.DecimalPlaces == 1 ? "" : "s")
                                    </span>

                                </td>


                                <!-- Last Updated -->

                                <td>

                                    <span class="updated-text">

                                        <i class="fa-regular fa-clock me-1"></i>

                                        @c.LastUpdated.ToString("dd MMM yyyy hh:mm tt")

                                    </span>

                                </td>


                                <!-- Status -->

                                <td>

                                    @if (c.IsBaseCurrency)
                                    {
                                        <span class="cm-status cm-status-base">

                                            <span class="status-dot"></span>

                                            Base Currency

                                        </span>
                                    }
                                    else if (c.IsActive)
                                    {
                                        <span class="cm-status cm-status-active">

                                            <span class="status-dot"></span>

                                            Active

                                        </span>
                                    }
                                    else
                                    {
                                        <span class="cm-status cm-status-inactive">

                                            <span class="status-dot"></span>

                                            Inactive

                                        </span>
                                    }

                                </td>


                                <!-- Actions -->

                                <td>

                                    <div class="cm-action-group">

                                        @if (!c.IsBaseCurrency)
                                        {
                                            <!-- Edit -->

                                            <button type="button"
                                                    class="btn btn-sm btn-outline-secondary cm-action-btn"
                                                    onclick="openEditModal(@c.CurrencyId, '@c.CurrencyCode', @c.ExchangeRate)"
                                                    title="Edit Exchange Rate"
                                                    aria-label="Edit Exchange Rate">

                                                <i class="fa-solid fa-pen-to-square"></i>

                                            </button>


                                            <!-- Toggle -->

                                            <form action="/AdminMaster/ToggleCurrencyStatus"
                                                  method="post"
                                                  class="d-inline">

                                                @Html.AntiForgeryToken()

                                                <input type="hidden"
                                                       name="id"
                                                       value="@c.CurrencyId" />

                                                <button type="submit"
                                                        class="btn btn-sm btn-outline-warning cm-action-btn"
                                                        title="Toggle Currency Status"
                                                        aria-label="Toggle Currency Status">

                                                    <i class="fa-solid @(c.IsActive ? "fa-ban" : "fa-check")"></i>

                                                </button>

                                            </form>
                                        }


                                        <!-- History -->

                                        <button type="button"
                                                class="btn btn-sm btn-outline-info cm-action-btn"
                                                onclick="openHistoryModal(@c.CurrencyId, '@c.CurrencyCode')"
                                                title="View Rate History"
                                                aria-label="View Rate History">

                                            <i class="fa-solid fa-timeline"></i>

                                        </button>

                                    </div>

                                </td>

                            </tr>
                        }
                    }
                    else
                    {
                        <tr>

                            <td colspan="8"
                                class="currency-empty">

                                <div class="currency-empty-icon">

                                    <i class="fa-solid fa-coins"></i>

                                </div>

                                <h6 class="fw-bold text-dark mb-1">
                                    No currencies configured
                                </h6>

                                <p class="text-muted small mb-0">
                                    Add your first currency to begin managing exchange rates.
                                </p>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>


        <div class="currency-footer">

            <span>
                <i class="fa-solid fa-circle-info me-1"></i>
                Exchange rates are maintained relative to
                <strong>@Model.BaseCurrencyCode</strong>.
            </span>

            <span>
                @totalCurrencies currency@(totalCurrencies == 1 ? "" : "ies") configured
            </span>

        </div>

    </div>

</div>


<!-- =========================================================
     ADD CURRENCY MODAL
     ========================================================= -->

<div class="modal fade cm-modal text-start"
     id="addCurrencyModal"
     tabindex="-1"
     aria-labelledby="addCurrencyLabel"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content">

            <form action="/AdminMaster/CreateCurrency"
                  method="post">

                @Html.AntiForgeryToken()


                <div class="modal-header">

                    <h5 class="modal-title"
                        id="addCurrencyLabel">

                        <span class="modal-title-icon">
                            <i class="fa-solid fa-plus"></i>
                        </span>

                        Add New Currency

                    </h5>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal"
                            aria-label="Close">
                    </button>

                </div>


                <div class="modal-body">

                    <div class="row g-3">


                        <!-- Code -->

                        <div class="col-md-6 cm-form-group">

                            <label class="form-label">

                                Currency Code

                                <span class="cm-required">*</span>

                            </label>

                            <input type="text"
                                   name="CurrencyCode"
                                   class="form-control text-uppercase"
                                   maxlength="3"
                                   placeholder="e.g. USD"
                                   required />

                        </div>


                        <!-- Name -->

                        <div class="col-md-6 cm-form-group">

                            <label class="form-label">

                                Currency Name

                                <span class="cm-required">*</span>

                            </label>

                            <input type="text"
                                   name="CurrencyName"
                                   class="form-control"
                                   placeholder="e.g. US Dollar"
                                   required />

                        </div>


                        <!-- Symbol -->

                        <div class="col-md-6 cm-form-group">

                            <label class="form-label">

                                Symbol

                                <span class="cm-required">*</span>

                            </label>

                            <input type="text"
                                   name="Symbol"
                                   class="form-control"
                                   placeholder="e.g. $"
                                   required />

                        </div>


                        <!-- Rate -->

                        <div class="col-md-6 cm-form-group">

                            <label class="form-label">

                                Exchange Rate

                                <span class="cm-required">*</span>

                            </label>

                            <input type="number"
                                   step="0.000001"
                                   name="ExchangeRate"
                                   class="form-control"
                                   placeholder="e.g. 83.450000"
                                   required />

                        </div>


                        <!-- Precision -->

                        <div class="col-12 cm-form-group">

                            <label class="form-label">

                                Decimal Places

                            </label>

                            <select name="DecimalPlaces"
                                    class="form-select">

                                <option value="0">
                                    0 places
                                </option>

                                <option value="2" selected>
                                    2 places
                                </option>

                                <option value="3">
                                    3 places
                                </option>

                                <option value="4">
                                    4 places
                                </option>

                            </select>

                        </div>


                        <!-- Active -->

                        <div class="col-12 cm-form-group">

                            <div class="form-check form-switch cm-switch">

                                <input class="form-check-input"
                                       type="checkbox"
                                       name="IsActive"
                                       value="true"
                                       checked
                                       id="isActiveSwitch" />

                                <label class="form-check-label ms-2"
                                       for="isActiveSwitch">

                                    Currency is Active

                                    <span class="d-block text-muted fw-normal mt-1"
                                          style="font-size:.63rem;">
                                        Allow this currency to be used in transactions.
                                    </span>

                                </label>

                            </div>

                        </div>

                    </div>

                </div>


                <div class="modal-footer">

                    <button type="button"
                            class="btn btn-outline-secondary cm-btn"
                            data-bs-dismiss="modal">

                        Cancel

                    </button>

                    <button type="submit"
                            class="btn btn-primary cm-btn cm-btn-primary">

                        <i class="fa-solid fa-floppy-disk me-1"></i>

                        Save Currency

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>


<!-- =========================================================
     EDIT RATE MODAL
     ========================================================= -->

<div class="modal fade cm-modal text-start"
     id="editRateModal"
     tabindex="-1"
     aria-labelledby="editRateLabel"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered modal-sm">

        <div class="modal-content">

            <form action="/AdminMaster/UpdateRate"
                  method="post">

                @Html.AntiForgeryToken()

                <input type="hidden"
                       name="id"
                       id="editCurrencyId" />


                <div class="modal-header">

                    <h5 class="modal-title"
                        id="editRateLabel">

                        <span class="modal-title-icon">
                            <i class="fa-solid fa-pen-to-square"></i>
                        </span>

                        Edit Exchange Rate

                    </h5>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal"
                            aria-label="Close">
                    </button>

                </div>


                <div class="modal-body">

                    <div class="cm-form-group mb-3">

                        <label class="form-label">
                            Currency Code
                        </label>

                        <input type="text"
                               id="editCurrencyCode"
                               class="form-control bg-light"
                               readonly />

                    </div>


                    <div class="cm-form-group">

                        <label class="form-label">

                            New Exchange Rate

                            <span class="cm-required">*</span>

                        </label>

                        <input type="number"
                               step="0.000001"
                               name="rate"
                               id="editExchangeRate"
                               class="form-control"
                               required />

                        <div class="text-muted mt-2"
                             style="font-size:.63rem;">

                            Update the conversion rate relative to
                            @Model.BaseCurrencyCode.

                        </div>

                    </div>

                </div>


                <div class="modal-footer">

                    <button type="button"
                            class="btn btn-outline-secondary cm-btn"
                            data-bs-dismiss="modal">

                        Cancel

                    </button>

                    <button type="submit"
                            class="btn btn-primary cm-btn cm-btn-primary">

                        <i class="fa-solid fa-check me-1"></i>

                        Update Rate

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>


<!-- =========================================================
     RATE HISTORY MODAL
     ========================================================= -->

<div class="modal fade cm-modal text-start"
     id="historyModal"
     tabindex="-1"
     aria-labelledby="historyLabel"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content">


            <div class="modal-header">

                <h5 class="modal-title"
                    id="historyLabel">

                    <span class="modal-title-icon">
                        <i class="fa-solid fa-timeline"></i>
                    </span>

                    Exchange Rate History

                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Close">
                </button>

            </div>


            <div class="modal-body">

                <div class="history-summary">

                    <span class="history-code"
                          id="historyCode">
                        USD
                    </span>

                    <div>

                        <div class="fw-bold text-dark"
                             style="font-size:.75rem;">
                            Historical Rate Records
                        </div>

                        <div class="text-muted"
                             style="font-size:.62rem;">
                            Previous exchange-rate fluctuations
                        </div>

                    </div>

                </div>


                <div class="history-scroll">

                    <table class="table history-table align-middle">

                        <thead>

                            <tr>

                                <th>
                                    Exchange Rate
                                </th>

                                <th>
                                    Timestamp
                                </th>

                            </tr>

                        </thead>


                        <tbody id="historyTableBody">

                            <tr>

                                <td colspan="2"
                                    class="text-center py-4 text-muted">

                                    <i class="fa-solid fa-circle-notch fa-spin me-2 text-primary"></i>

                                    Loading rate records...

                                </td>

                            </tr>

                        </tbody>

                    </table>

                </div>

            </div>


            <div class="modal-footer">

                <button type="button"
                        class="btn btn-outline-secondary cm-btn"
                        data-bs-dismiss="modal">

                    Close

                </button>

            </div>

        </div>

    </div>

</div>


<script>

    /* =========================================================
       EDIT RATE MODAL
       ========================================================= */

    function openEditModal(id, code, currentRate) {

        const idInput =
            document.getElementById("editCurrencyId");

        const codeInput =
            document.getElementById("editCurrencyCode");

        const rateInput =
            document.getElementById("editExchangeRate");

        if (idInput) {
            idInput.value = id;
        }

        if (codeInput) {
            codeInput.value = code;
        }

        if (rateInput) {
            rateInput.value = currentRate;
        }

        const modalElement =
            document.getElementById("editRateModal");

        if (!modalElement) {
            return;
        }

        const modal =
            bootstrap.Modal.getOrCreateInstance(modalElement);

        modal.show();
    }


    /* =========================================================
       HISTORY MODAL
       ========================================================= */

    function openHistoryModal(id, code) {

        const historyCode =
            document.getElementById("historyCode");

        const tbody =
            document.getElementById("historyTableBody");

        if (historyCode) {
            historyCode.innerText = code;
        }

        if (tbody) {

            tbody.innerHTML = `
                <tr>
                    <td colspan="2"
                        class="text-center py-4 text-muted">

                        <i class="fa-solid fa-circle-notch fa-spin me-2 text-primary"></i>

                        Loading rate records...

                    </td>
                </tr>
            `;

        }


        const modalElement =
            document.getElementById("historyModal");

        if (!modalElement) {
            return;
        }

        const modal =
            bootstrap.Modal.getOrCreateInstance(modalElement);

        modal.show();


        fetch(`/AdminMaster/GetRateHistory/${id}`)

            .then(response => {

                if (!response.ok) {
                    throw new Error("Unable to fetch history.");
                }

                return response.json();

            })

            .then(data => {

                if (!tbody) {
                    return;
                }

                tbody.innerHTML = "";


                if (data && data.length > 0) {

                    data.forEach((item, index) => {

                        const tr =
                            document.createElement("tr");

                        tr.style.animationDelay =
                            `${index * 0.04}s`;

                        tr.innerHTML = `

                            <td>

                                <span class="font-monospace fw-bold text-dark">

                                    ${item.rate}

                                </span>

                            </td>

                            <td class="text-muted">

                                <i class="fa-regular fa-clock me-1"></i>

                                ${item.date}

                            </td>

                        `;

                        tbody.appendChild(tr);

                    });

                }
                else {

                    tbody.innerHTML = `

                        <tr>

                            <td colspan="2"
                                class="text-center py-5 text-muted">

                                <i class="fa-solid fa-clock-rotate-left d-block mb-2"
                                   style="font-size:1.4rem;"></i>

                                No historical fluctuations logged.

                            </td>

                        </tr>

                    `;

                }

            })

            .catch(error => {

                console.error(error);

                if (!tbody) {
                    return;
                }

                tbody.innerHTML = `

                    <tr>

                        <td colspan="2"
                            class="text-center py-5 text-danger">

                            <i class="fa-solid fa-circle-xmark d-block mb-2"
                               style="font-size:1.4rem;"></i>

                            Failed to fetch rate logs.

                        </td>

                    </tr>

                `;

            });

    }


    /* =========================================================
       UPPERCASE CURRENCY CODE
       ========================================================= */

    document.addEventListener("DOMContentLoaded", function () {

        const currencyCodeInput =
            document.querySelector(
                '#addCurrencyModal input[name="CurrencyCode"]'
            );

        if (currencyCodeInput) {

            currencyCodeInput.addEventListener(
                "input",
                function () {

                    this.value =
                        this.value
                            .toUpperCase()
                            .replace(/[^A-Z]/g, "")
                            .slice(0, 3);

                }
            );

        }

    });

</script>
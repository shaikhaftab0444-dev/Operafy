<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Enterprise Resource Planning System</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/fontawesome-free/css/all.min.css" />
    <link rel="stylesheet" href="~/css/landing.css" asp-append-version="true" />
</head>
<body>
    <div class="bg-glow"></div>
    <div class="bg-glow-2"></div>

    <!-- Custom Glassmorphic Navigation -->
    <nav class="navbar navbar-expand-lg glass-nav fixed-top py-3">
        <div class="container">
            <a class="navbar-brand" href="/">
                <i class="fa-solid fa-cubes text-primary-hover" style="color: #6366f1;"></i>
                <span>ERP <span style="color: #6366f1;">System</span></span>
            </a>
            <button class="navbar-toggler border-0 text-white" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                <i class="fa-solid fa-bars"></i>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto align-items-center gap-2">
                    <li class="nav-item">
                        <a class="nav-link" href="#features">Features</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="#roles">Solutions</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="#about">About</a>
                    </li>
                    <li class="nav-item ms-lg-3 mt-2 mt-lg-0">
                        <a class="btn btn-glass-primary btn-sm px-4" href="/Account/Login">Sign In</a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <!-- Content Body -->
    @RenderBody()

    <!-- Custom Dark Footer -->
    <footer class="py-5" style="border-top: 1px solid var(--glass-border); background: rgba(9, 13, 22, 0.9);">
        <div class="container">
            <div class="row g-4">
                <div class="col-lg-4 col-md-6">
                    <div class="d-flex align-items-center gap-2 mb-3">
                        <i class="fa-solid fa-cubes text-primary" style="font-size: 1.5rem;"></i>
                        <span class="fs-5 fw-bold text-white">ERP System</span>
                    </div>
                    <p class="text-secondary small">A professional, modular Enterprise Resource Planning solution to manage company logistics, employee databases, accounts, products, sales, and more under one single unified platform.</p>
                </div>
                <div class="col-lg-2 col-md-6 col-6">
                    <h6 class="text-white fw-bold mb-3">Modules</h6>
                    <ul class="list-unstyled small">
                        <li><a href="#features" class="text-secondary text-decoration-none d-block mb-2">Inventory</a></li>
                        <li><a href="#features" class="text-secondary text-decoration-none d-block mb-2">Sales & Purchase</a></li>
                        <li><a href="#features" class="text-secondary text-decoration-none d-block mb-2">Accounting</a></li>
                        <li><a href="#features" class="text-secondary text-decoration-none d-block mb-2">HR Management</a></li>
                    </ul>
                </div>
                <div class="col-lg-2 col-md-6 col-6">
                    <h6 class="text-white fw-bold mb-3">Company</h6>
                    <ul class="list-unstyled small">
                        <li><a href="#" class="text-secondary text-decoration-none d-block mb-2">About Us</a></li>
                        <li><a href="#" class="text-secondary text-decoration-none d-block mb-2">Pricing Plans</a></li>
                        <li><a href="#" class="text-secondary text-decoration-none d-block mb-2">Careers</a></li>
                        <li><a href="#" class="text-secondary text-decoration-none d-block mb-2">Contact Support</a></li>
                    </ul>
                </div>
                <div class="col-lg-4 col-md-6">
                    <h6 class="text-white fw-bold mb-3">Subscribe to Updates</h6>
                    <p class="text-secondary small">Receive updates about new modules, feature releases, and technical documentation.</p>
                    <div class="input-group mb-3">
                        <input type="email" class="form-control bg-transparent border-secondary text-white small" placeholder="name@company.com" style="border-color: rgba(255,255,255,0.1) !important;" />
                        <button class="btn btn-glass-primary py-1 px-3 small" type="button"><i class="fa-regular fa-paper-plane"></i></button>
                    </div>
                </div>
            </div>
            <hr class="my-4" style="border-color: rgba(255,255,255,0.05);" />
            <div class="d-flex flex-column flex-sm-row justify-content-between align-items-center gap-3">
                <span class="text-secondary small">&copy; 2026 ERP System. All rights reserved. Built for professional deployment.</span>
                <div class="d-flex gap-3">
                    <a href="#" class="text-secondary hover-white"><i class="fa-brands fa-twitter"></i></a>
                    <a href="#" class="text-secondary hover-white"><i class="fa-brands fa-github"></i></a>
                    <a href="#" class="text-secondary hover-white"><i class="fa-brands fa-linkedin"></i></a>
                </div>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Enterprise Resource Planning System</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/fontawesome-free/css/all.min.css" />
    <link rel="stylesheet" href="~/css/landing.css" asp-append-version="true" />
    <style>
        .goog-te-banner-frame, .goog-te-banner-frame.skiptranslate, iframe.skiptranslate, iframe[class*="VIpgJd"], iframe[id*="goog-gt"], .VIpgJd-ZGain-xl0qp4-Ojan2-OWX0fe, #goog-gt-tt, .goog-te-balloon-frame {
            display: none !important;
            visibility: hidden !important;
            opacity: 0 !important;
            height: 0 !important;
            pointer-events: none !important;
        }

        body {
            top: 0px !important;
            position: static !important;
            margin-top: 0px !important;
        }

        #google_translate_element, .goog-te-spinner-pos, .goog-te-combo {
            display: none !important;
        }
    </style>
</head>
<body>
    <div class="bg-glow"></div>
    <div class="bg-glow-2"></div>

    <!-- Custom Glassmorphic Navigation -->
    <nav class="navbar navbar-expand-lg glass-nav fixed-top py-3">
        <div class="container">
            <a class="navbar-brand" href="/">
                <i class="fa-solid fa-cubes text-primary-hover" style="color: #6366f1;"></i>
                <span>ERP <span style="color: #6366f1;">System</span></span>
            </a>
            <button class="navbar-toggler border-0 text-white" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                <i class="fa-solid fa-bars"></i>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto align-items-center gap-2">
                    <li class="nav-item">
                        <a class="nav-link" href="#features">Features</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="#roles">Solutions</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="#about">About</a>
                    </li>
                    <li class="nav-item dropdown ms-lg-2">
                        <button class="btn btn-outline-light btn-sm dropdown-toggle d-flex align-items-center gap-1.5 px-3 py-1.5 notranslate" translate="no" type="button" data-bs-toggle="dropdown" aria-expanded="false" style="border-color: rgba(255,255,255,0.2); background: rgba(255,255,255,0.05); font-size:0.85rem;">
                            <i class="fa-solid fa-globe" style="color: #6366f1;"></i> Language
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end shadow border-0 notranslate" translate="no" style="background:#131b2e; border:1px solid rgba(255,255,255,0.1) !important; font-size:0.85rem;">
                            <li><a class="dropdown-item text-white py-2" href="#" onclick="changeLanguage('en'); return false;">🇬🇧 English</a></li>
                            <li><a class="dropdown-item text-white py-2" href="#" onclick="changeLanguage('hi'); return false;">🇮🇳 हिंदी (Hindi)</a></li>
                            <li><a class="dropdown-item text-white py-2" href="#" onclick="changeLanguage('es'); return false;">🇪🇸 Español (Spanish)</a></li>
                            <li><a class="dropdown-item text-white py-2" href="#" onclick="changeLanguage('ar'); return false;">🇸🇦 العربية (Arabic)</a></li>
                            <li><a class="dropdown-item text-white py-2" href="#" onclick="changeLanguage('fr'); return false;">🇫🇷 Français (French)</a></li>
                            <li><a class="dropdown-item text-white py-2" href="#" onclick="changeLanguage('de'); return false;">🇩🇪 Deutsch (German)</a></li>
                            <li><a class="dropdown-item text-white py-2" href="#" onclick="changeLanguage('ur'); return false;">🇵🇰 اردو (Urdu)</a></li>
                            <li><a class="dropdown-item text-white py-2" href="#" onclick="changeLanguage('zh-CN'); return false;">🇨🇳 中文 (Chinese)</a></li>
                        </ul>
                    </li>
                    <li class="nav-item ms-lg-3 mt-2 mt-lg-0">
                        <a class="btn btn-glass-primary btn-sm px-4" href="/Account/Login">Sign In</a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <!-- Content Body -->
    @RenderBody()



    <div id="google_translate_element"></div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/language-selector.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

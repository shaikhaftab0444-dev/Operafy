<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ERP Dashboard</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/fontawesome-free/css/all.min.css" />
    <style>
        @@import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap');

        :root {
            --sidebar-bg: #0e1726;
            --sidebar-color: #abb5c2;
            --sidebar-active-bg: #3b82f6;
            --sidebar-active-color: #ffffff;
            --topbar-bg: #ffffff;
            --content-bg: #f8fafc;
            --text-color: #1e293b;
            --border-warm: #e2e8f0;
            --primary-warm: #3b82f6;
        }

        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background-color: var(--content-bg);
            color: var(--text-color);
            margin: 0;
            padding: 0;
            overflow-x: hidden;
        }

        /* Layout Structure */
        .wrapper {
            display: flex;
            align-items: stretch;
            min-height: 100vh;
        }

        /* Left Sidebar styling (Original Dark Navy) */
        #sidebar {
            min-width: 280px;
            max-width: 280px;
            background-color: var(--sidebar-bg);
            color: var(--sidebar-color);
            transition: all 0.3s;
            display: flex;
            flex-direction: column;
            border-right: 1px solid rgba(255, 255, 255, 0.05);
        }

        #sidebar.active {
            margin-left: -280px;
        }

        .sidebar-header {
            padding: 1.5rem 1.25rem;
            border-bottom: 1px solid rgba(255, 255, 255, 0.05);
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .sidebar-brand {
            font-weight: 800;
            font-size: 1.25rem;
            color: #ffffff;
            text-decoration: none;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .sidebar-menu {
            flex-grow: 1;
            padding: 1rem 0;
            overflow-y: auto;
        }

        .menu-title {
            padding: 0.75rem 1.25rem 0.25rem 1.25rem;
            font-size: 0.7rem;
            text-transform: uppercase;
            font-weight: 700;
            letter-spacing: 0.8px;
            color: #64748b;
        }

        .menu-link {
            padding: 0.65rem 1rem;
            margin: 2px 12px;
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            color: var(--sidebar-color);
            text-decoration: none;
            font-size: 0.9rem;
            font-weight: 500;
            transition: all 0.2s;
        }

        .menu-link:hover {
            background-color: rgba(255, 255, 255, 0.05);
            color: #ffffff;
        }

        .menu-link.active {
            background-color: var(--sidebar-active-bg);
            color: var(--sidebar-active-color);
            font-weight: 600;
        }

        .menu-link > div {
            display: flex;
            align-items: center;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .menu-icon {
            margin-right: 12px;
            width: 18px;
            text-align: center;
            font-size: 0.95rem;
        }

        /* Sidebar Quick Links */
        .sidebar-quicklinks {
            margin: 12px;
            padding: 1rem;
            border-radius: 8px;
            background-color: #141d31;
            border: 1px solid rgba(255, 255, 255, 0.02);
        }

        /* Main Content Container */
        #content {
            width: 100%;
            display: flex;
            flex-direction: column;
            min-width: 0;
        }

        /* Top Header Navigation Bar */
        .topbar {
            background-color: var(--topbar-bg);
            border-bottom: 1px solid var(--border-warm);
            padding: 0.75rem 1.5rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
            height: 60px;
        }

        .toggle-btn {
            background: none;
            border: none;
            font-size: 1.2rem;
            color: var(--text-color);
            cursor: pointer;
        }

        .search-box {
            position: relative;
            max-width: 300px;
            width: 100%;
        }

        .search-box input {
            padding: 0.4rem 1rem 0.4rem 2.2rem;
            border-radius: 6px;
            border: 1px solid #cbd5e1;
            font-size: 0.85rem;
            background-color: #f8fafc;
            color: var(--text-color);
            width: 100%;
            transition: border-color 0.2s;
        }
        .search-box input:focus {
            outline: none;
            border-color: var(--primary-warm);
        }

        .search-box i {
            position: absolute;
            left: 0.8rem;
            top: 50%;
            transform: translateY(-50%);
            color: #94a3b8;
            font-size: 0.85rem;
        }

        .topbar-right {
            display: flex;
            align-items: center;
            gap: 1.25rem;
        }

        .icon-btn {
            background: none;
            border: none;
            position: relative;
            color: #475569;
            cursor: pointer;
            font-size: 1.1rem;
            padding: 0.25rem;
            transition: color 0.2s;
        }
        .icon-btn:hover {
            color: var(--text-color);
        }

        .icon-badge {
            position: absolute;
            top: -2px;
            right: -2px;
            font-size: 0.6rem;
            padding: 0.2rem 0.35rem;
            border-radius: 50%;
        }

        .user-profile {
            display: flex;
            align-items: center;
            gap: 10px;
            cursor: pointer;
            text-decoration: none;
            color: inherit;
        }

        .profile-img {
            width: 32px;
            height: 32px;
            border-radius: 50%;
            background-color: #e2e8f0;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 700;
            color: var(--primary-warm);
            font-size: 0.85rem;
            border: 2px solid var(--primary-warm);
        }

        .profile-info {
            line-height: 1.1;
        }

        .profile-name {
            font-weight: 600;
            font-size: 0.85rem;
            color: var(--text-color);
        }

        .profile-role {
            font-size: 0.7rem;
            color: #64748b;
        }

        .main-inner {
            padding: 1.5rem;
            flex-grow: 1;
            overflow-y: auto;
        }

        /* Sidebar Footer copyright */
        .sidebar-footer {
            padding: 0.75rem 1.25rem;
            font-size: 0.7rem;
            color: #64748b;
            border-top: 1px solid rgba(255, 255, 255, 0.05);
            display: flex;
            justify-content: space-between;
        }

        /* Suppress Google Translate Top Banner & Iframe */
        .goog-te-banner-frame, .goog-te-banner-frame.skiptranslate, iframe.skiptranslate, iframe[class*="VIpgJd"], iframe[id*="goog-gt"], .VIpgJd-ZGain-xl0qp4-Ojan2-OWX0fe, #goog-gt-tt, .goog-te-balloon-frame { display: none !important; visibility: hidden !important; opacity: 0 !important; height: 0 !important; pointer-events: none !important; }
        body { top: 0px !important; position: static !important; margin-top: 0px !important; }
        #google_translate_element, .goog-te-spinner-pos, .goog-te-combo { display: none !important; }
    </style>
</head>

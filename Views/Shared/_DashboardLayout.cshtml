@using System.Security.Claims
@using Microsoft.EntityFrameworkCore
@inject ERP_System.Data.ApplicationDbContext _switcherContext

@{
    var userFullName = User.Identity?.Name ?? "User Account";
    var userRole = User.FindFirst(ClaimTypes.Role)?.Value ?? "Employee";

    var userCompanyIdStr = User.FindFirst("Company")?.Value;
    var userCompany = "ERP Solutions Ltd";
    if (int.TryParse(userCompanyIdStr, out int loggedCompanyId))
    {
        userCompany = _switcherContext.Companies.Where(c => c.CompanyId == loggedCompanyId).Select(c => c.CompanyName).FirstOrDefault() ?? "ERP Solutions Ltd";
    }

    var allowedModules = new List<string>();
    if (User.Identity?.IsAuthenticated == true)
    {
        allowedModules = _switcherContext.RolePermissions
            .Include(p => p.Role)
            .Where(p => p.Role != null && p.Role.RoleName == userRole && p.IsAllowed)
            .Select(p => p.ModuleName)
            .ToList();
    }

    bool isMasterAdmin = userRole == "Super Admin" || userRole == "Admin";

    bool showUserMgmt = isMasterAdmin || allowedModules.Contains("UserManagement");
    bool showCompany = isMasterAdmin || allowedModules.Contains("Company");
    bool showBranchMgmt = isMasterAdmin || allowedModules.Contains("BranchManagement");
    bool showEmployeeMgmt = isMasterAdmin || allowedModules.Contains("EmployeeManagement");
    bool showCustomerMgmt = isMasterAdmin || allowedModules.Contains("CustomerManagement");
    bool showSupplierMgmt = isMasterAdmin || allowedModules.Contains("SupplierManagement");
    bool showProductMgmt = isMasterAdmin || allowedModules.Contains("ProductManagement");
    bool showInventoryMgmt = isMasterAdmin || allowedModules.Contains("InventoryManagement");
    bool showPurchaseMgmt = isMasterAdmin || allowedModules.Contains("PurchaseManagement");
    bool showSalesMgmt = isMasterAdmin || allowedModules.Contains("SalesManagement");
    bool showExpenseMgmt = isMasterAdmin || allowedModules.Contains("ExpenseManagement");
    bool showAccounting = isMasterAdmin || allowedModules.Contains("Accounting");
    bool showHRMgmt = isMasterAdmin || allowedModules.Contains("HRManagement");
    bool showReports = isMasterAdmin || allowedModules.Contains("Reports");
    bool showSettings = isMasterAdmin || allowedModules.Contains("Settings");

    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "Dashboard";
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "Index";

    var currentUserIdClaim = User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
    string? userProfilePhoto = null;
    if (int.TryParse(currentUserIdClaim, out int loggedUserId))
    {
        userProfilePhoto = _switcherContext.Users.Where(u => u.UserId == loggedUserId).Select(u => u.ProfilePhoto).FirstOrDefault();
    }
    var layoutProfilePhoto = !string.IsNullOrEmpty(userProfilePhoto) ? userProfilePhoto : "/profile_images/admin-avatar.jpg";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ERP Dashboard</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/fontawesome-free/css/all.min.css" />
    <style>
        @@import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap');

        :root {
            --sidebar-bg: #0e1726;
            --sidebar-color: #abb5c2;
            --sidebar-active-bg: #3b82f6;
            --sidebar-active-color: #ffffff;
            --topbar-bg: #ffffff;
            --content-bg: #f8fafc;
            --text-color: #1e293b;
            --border-warm: #e2e8f0;
            --primary-warm: #3b82f6;
        }

        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background-color: var(--content-bg);
            color: var(--text-color);
            margin: 0;
            padding: 0;
            overflow-x: hidden;
        }

        /* Layout Structure */
        .wrapper {
            display: flex;
            align-items: stretch;
            min-height: 100vh;
        }

        /* Left Sidebar styling (Original Dark Navy) */
        #sidebar {
            min-width: 280px;
            max-width: 280px;
            background-color: var(--sidebar-bg);
            color: var(--sidebar-color);
            transition: all 0.3s;
            display: flex;
            flex-direction: column;
            border-right: 1px solid rgba(255, 255, 255, 0.05);
            /* Sidebar now scrolls independently of the page */
            position: sticky;
            top: 0;
            height: 100vh;
            align-self: flex-start;
        }

            #sidebar.active {
                margin-left: -280px;
            }

        .sidebar-header {
            padding: 1.5rem 1.25rem;
            border-bottom: 1px solid rgba(255, 255, 255, 0.05);
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-shrink: 0;
        }

        .sidebar-brand {
            font-weight: 800;
            font-size: 1.25rem;
            color: #ffffff;
            text-decoration: none;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .sidebar-menu {
            flex-grow: 1;
            padding: 1rem 0;
            overflow-y: auto;
            /* Slim scrollbar (Firefox) */
            scrollbar-width: thin;
            scrollbar-color: rgba(255, 255, 255, 0.18) transparent;
        }

            /* Slim scrollbar (WebKit/Chromium/Edge) */
            .sidebar-menu::-webkit-scrollbar {
                width: 6px;
            }

            .sidebar-menu::-webkit-scrollbar-track {
                background: transparent;
            }

            .sidebar-menu::-webkit-scrollbar-thumb {
                background-color: rgba(255, 255, 255, 0.18);
                border-radius: 6px;
            }

                .sidebar-menu::-webkit-scrollbar-thumb:hover {
                    background-color: rgba(255, 255, 255, 0.32);
                }

        .menu-title {
            padding: 0.75rem 1.25rem 0.25rem 1.25rem;
            font-size: 0.7rem;
            text-transform: uppercase;
            font-weight: 700;
            letter-spacing: 0.8px;
            color: #64748b;
        }

        .menu-link {
            padding: 0.65rem 1rem;
            margin: 2px 12px;
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            color: var(--sidebar-color);
            text-decoration: none;
            font-size: 0.9rem;
            font-weight: 500;
            transition: all 0.2s;
        }

            .menu-link:hover {
                background-color: rgba(255, 255, 255, 0.05);
                color: #ffffff;
            }

            .menu-link.active {
                background-color: var(--sidebar-active-bg);
                color: var(--sidebar-active-color);
                font-weight: 600;
            }

            .menu-link > div {
                display: flex;
                align-items: center;
                white-space: nowrap;
                overflow: hidden;
                text-overflow: ellipsis;
            }

        .menu-icon {
            margin-right: 12px;
            width: 18px;
            text-align: center;
            font-size: 0.95rem;
        }

        /* Sidebar Quick Links */
        .sidebar-quicklinks {
            margin: 12px;
            padding: 1rem;
            border-radius: 8px;
            background-color: #141d31;
            border: 1px solid rgba(255, 255, 255, 0.02);
        }

        /* Main Content Container */
        #content {
            width: 100%;
            display: flex;
            flex-direction: column;
            min-width: 0;
        }

        /* Top Header Navigation Bar */
        .topbar {
            background-color: var(--topbar-bg);
            border-bottom: 1px solid var(--border-warm);
            padding: 0.75rem 1.5rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
            height: 60px;
        }

        .toggle-btn {
            background: none;
            border: none;
            font-size: 1.2rem;
            color: var(--text-color);
            cursor: pointer;
        }

        .search-box {
            position: relative;
            max-width: 300px;
            width: 100%;
        }

            .search-box input {
                padding: 0.4rem 1rem 0.4rem 2.2rem;
                border-radius: 6px;
                border: 1px solid #cbd5e1;
                font-size: 0.85rem;
                background-color: #f8fafc;
                color: var(--text-color);
                width: 100%;
                transition: border-color 0.2s;
            }

                .search-box input:focus {
                    outline: none;
                    border-color: var(--primary-warm);
                }

            .search-box i {
                position: absolute;
                left: 0.8rem;
                top: 50%;
                transform: translateY(-50%);
                color: #94a3b8;
                font-size: 0.85rem;
            }

        .topbar-right {
            display: flex;
            align-items: center;
            gap: 1.25rem;
        }

        .icon-btn {
            background: none;
            border: none;
            position: relative;
            color: #475569;
            cursor: pointer;
            font-size: 1.1rem;
            padding: 0.25rem;
            transition: color 0.2s;
        }

            .icon-btn:hover {
                color: var(--text-color);
            }

        .icon-badge {
            position: absolute;
            top: -2px;
            right: -2px;
            font-size: 0.6rem;
            padding: 0.2rem 0.35rem;
            border-radius: 50%;
        }

        .user-profile {
            display: flex;
            align-items: center;
            gap: 10px;
            cursor: pointer;
            text-decoration: none;
            color: inherit;
        }

        .profile-img {
            width: 32px;
            height: 32px;
            border-radius: 50%;
            background-color: #e2e8f0;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 700;
            color: var(--primary-warm);
            font-size: 0.85rem;
            border: 2px solid var(--primary-warm);
        }

        .profile-info {
            line-height: 1.1;
        }

        .profile-name {
            font-weight: 600;
            font-size: 0.85rem;
            color: var(--text-color);
        }

        .profile-role {
            font-size: 0.7rem;
            color: #64748b;
        }

        .main-inner {
            padding: 1.5rem;
            flex-grow: 1;
            overflow-y: auto;
        }

        /* Sidebar Footer copyright */
        .sidebar-footer {
            padding: 0.75rem 1.25rem;
            font-size: 0.7rem;
            color: #64748b;
            border-top: 1px solid rgba(255, 255, 255, 0.05);
            display: flex;
            justify-content: space-between;
            flex-shrink: 0;
        }

        /* Suppress Google Translate Top Banner & Iframe */
        .goog-te-banner-frame, .goog-te-banner-frame.skiptranslate, iframe.skiptranslate, iframe[class*="VIpgJd"], iframe[id*="goog-gt"], .VIpgJd-ZGain-xl0qp4-Ojan2-OWX0fe, #goog-gt-tt, .goog-te-balloon-frame {
            display: none !important;
            visibility: hidden !important;
            opacity: 0 !important;
            height: 0 !important;
            pointer-events: none !important;
        }

        body {
            top: 0px !important;
            position: static !important;
            margin-top: 0px !important;
        }

        #google_translate_element, .goog-te-spinner-pos, .goog-te-combo {
            display: none !important;
        }

        /* Collapsible sub-menus for nested layout */
        .sidebar-submenu {
            background-color: rgba(0, 0, 0, 0.15);
            border-left: 2px solid rgba(255, 255, 255, 0.08);
            margin: 2px 12px 2px 24px;
            padding-left: 8px;
            border-radius: 4px;
        }

        .submenu-link {
            padding: 0.45rem 1rem;
            color: var(--sidebar-color);
            text-decoration: none;
            font-size: 0.8rem;
            font-weight: 500;
            display: block;
            border-radius: 6px;
            transition: all 0.2s;
        }

            .submenu-link:hover {
                background-color: rgba(255, 255, 255, 0.05);
                color: #ffffff;
            }

            .submenu-link.active {
                color: #ffffff;
                background-color: rgba(255, 255, 255, 0.08);
                font-weight: 600;
            }

        .dropdown-toggle-arrow {
            transition: transform 0.2s;
        }

        .menu-link[aria-expanded="true"] .dropdown-toggle-arrow {
            transform: rotate(90deg);
        }
    </style>
</head>
<body>
    <div class="wrapper">
        <!-- Left Sidebar Navigation -->
        <nav id="sidebar">
            <div class="sidebar-header">
                <a href="/" class="sidebar-brand">
                    <i class="fa-solid fa-cubes text-white"></i>
                    <span>ERP System</span>
                </a>
                <button class="toggle-btn text-white d-lg-none" onclick="toggleSidebar()"><i class="fa-solid fa-xmark"></i></button>
            </div>

            <div class="sidebar-menu">
                @if (userRole == "Sales Manager" || userRole == "Sales Executive")
                {
                    var isExecutive = userRole == "Sales Executive";
                    var salesDashUrl = isExecutive ? "/SalesDashboard" : "/SalesManagerDashboard";
                    var isSalesDashActive = currentController == "SalesDashboard" || currentController == "SalesManagerDashboard";

                    <div class="menu-title font-bold text-uppercase" style="font-size: 0.7rem; color: rgba(255,255,255,0.45); padding: 0.75rem 1rem 0.25rem; letter-spacing: 0.5px;">Main</div>
                    <a href="@salesDashUrl" class="menu-link @(isSalesDashActive ? "active" : "")">
                        <div>
                            <i class="fa-solid fa-gauge menu-icon"></i>
                            <span>Sales Dashboard</span>
                        </div>
                    </a>

                    <div class="menu-title font-bold text-uppercase" style="font-size: 0.7rem; color: rgba(255,255,255,0.45); padding: 0.75rem 1rem 0.25rem; letter-spacing: 0.5px;">Core Operations</div>
                    <a href="/Customers" class="menu-link @(currentController == "Customers" ? "active" : "")">
                        <div>
                            <i class="fa-solid fa-handshake menu-icon"></i>
                            <span>Customer Management</span>
                        </div>
                    </a>

                    <a href="/Products" class="menu-link @(currentController == "Products" ? "active" : "")">
                        <div>
                            <i class="fa-solid fa-box-open menu-icon"></i>
                            <span>Product Management</span>
                        </div>
                    </a>

                    <a href="/SalesManagement/Leads" class="menu-link @(currentController == "SalesManagement" && currentAction == "Leads" ? "active" : "")">
                        <div>
                            <i class="fa-solid fa-filter menu-icon"></i>
                            <span>Leads</span>
                        </div>
                    </a>

                    <a href="/SalesManagement/Quotations" class="menu-link @(currentController == "SalesManagement" && currentAction == "Quotations" ? "active" : "")">
                        <div>
                            <i class="fa-solid fa-file-signature menu-icon"></i>
                            <span>Quotations</span>
                        </div>
                    </a>

                    <a href="/SalesManagement/Orders" class="menu-link @(currentController == "SalesManagement" && currentAction == "Orders" ? "active" : "")">
                        <div>
                            <i class="fa-solid fa-folder-open menu-icon"></i>
                            <span>Sales Orders</span>
                        </div>
                    </a>

                    <a href="/Sales" class="menu-link @(currentController == "Sales" && currentAction == "Index" ? "active" : "")">
                        <div>
                            <i class="fa-solid fa-file-invoice menu-icon"></i>
                            <span>Sales Invoices</span>
                        </div>
                    </a>

                    @if (!isExecutive)
                    {
                        <a href="/SalesManagement/Returns" class="menu-link @(currentController == "SalesManagement" && currentAction == "Returns" ? "active" : "")">
                            <div>
                                <i class="fa-solid fa-arrow-rotate-left menu-icon"></i>
                                <span>Sales Returns</span>
                            </div>
                        </a>

                        <a href="/SalesManagement/Receivables" class="menu-link @(currentController == "SalesManagement" && currentAction == "Receivables" ? "active" : "")">
                            <div>
                                <i class="fa-solid fa-money-bill-trend-up menu-icon"></i>
                                <span>Payments / Receivables</span>
                            </div>
                        </a>

                        <div class="menu-title font-bold text-uppercase" style="font-size: 0.7rem; color: rgba(255,255,255,0.45); padding: 0.75rem 1rem 0.25rem; letter-spacing: 0.5px;">Sales Team</div>
                        <a href="/SalesTeam/Executives" class="menu-link @(currentController == "SalesTeam" && currentAction == "Executives" ? "active" : "")">
                            <div>
                                <i class="fa-solid fa-user-tag menu-icon"></i>
                                <span>Sales Executives</span>
                            </div>
                        </a>
                        <a href="/SalesTeam/Coordinators" class="menu-link @(currentController == "SalesTeam" && currentAction == "Coordinators" ? "active" : "")">
                            <div>
                                <i class="fa-solid fa-user-tie menu-icon"></i>
                                <span>Sales Coordinators</span>
                            </div>
                        </a>
                        <a href="/SalesTeam/Targets" class="menu-link @(currentController == "SalesTeam" && currentAction == "Targets" ? "active" : "")">
                            <div>
                                <i class="fa-solid fa-bullseye menu-icon"></i>
                                <span>Sales Targets</span>
                            </div>
                        </a>
                        <a href="/SalesTeam/Performance" class="menu-link @(currentController == "SalesTeam" && currentAction == "Performance" ? "active" : "")">
                            <div>
                                <i class="fa-solid fa-ranking-star menu-icon"></i>
                                <span>Sales Performance</span>
                            </div>
                        </a>

                        <div class="menu-title font-bold text-uppercase" style="font-size: 0.7rem; color: rgba(255,255,255,0.45); padding: 0.75rem 1rem 0.25rem; letter-spacing: 0.5px;">Sales Reports</div>
                        <a href="/SalesReports/Summary" class="menu-link @(currentController == "SalesReports" && currentAction == "Summary" ? "active" : "")">
                            <div>
                                <i class="fa-solid fa-chart-line menu-icon"></i>
                                <span>Sales Summary</span>
                            </div>
                        </a>
                        <a href="/SalesReports/ByCustomer" class="menu-link @(currentController == "SalesReports" && currentAction == "ByCustomer" ? "active" : "")">
                            <div>
                                <i class="fa-solid fa-users-line menu-icon"></i>
                                <span>Sales by Customer</span>
                            </div>
                        </a>
                        <a href="/SalesReports/ByProduct" class="menu-link @(currentController == "SalesReports" && currentAction == "ByProduct" ? "active" : "")">
                            <div>
                                <i class="fa-solid fa-box menu-icon"></i>
                                <span>Sales by Product</span>
                            </div>
                        </a>
                        <a href="/SalesReports/BySalesperson" class="menu-link @(currentController == "SalesReports" && currentAction == "BySalesperson" ? "active" : "")">
                            <div>
                                <i class="fa-solid fa-person-running menu-icon"></i>
                                <span>Sales by Salesperson</span>
                            </div>
                        </a>
                        <a href="/SalesReports/TargetReport" class="menu-link @(currentController == "SalesReports" && currentAction == "TargetReport" ? "active" : "")">
                            <div>
                                <i class="fa-solid fa-crosshairs menu-icon"></i>
                                <span>Sales Target Report</span>
                            </div>
                        </a>
                        <a href="/SalesReports/ReceivablesReport" class="menu-link @(currentController == "SalesReports" && currentAction == "ReceivablesReport" ? "active" : "")">
                            <div>
                                <i class="fa-solid fa-calendar-check menu-icon"></i>
                                <span>Receivables Report</span>
                            </div>
                        </a>
                    }

                    <div class="menu-title font-bold text-uppercase" style="font-size: 0.7rem; color: rgba(255,255,255,0.45); padding: 0.75rem 1rem 0.25rem; letter-spacing: 0.5px;">System</div>
                    <a href="/Notifications" class="menu-link @(currentController == "Notifications" ? "active" : "")">
                        <div>
                            <i class="fa-solid fa-bell menu-icon"></i>
                            <span>Notifications</span>
                        </div>
                    </a>
                }
                else if (userRole == "HR")
                {
                    var hrDashUrl = "/HR";
                    var isHrDashActive = currentController == "HR" && currentAction == "Index";

                    <div class="menu-title font-bold text-uppercase" style="font-size: 0.7rem; color: rgba(255,255,255,0.45); padding: 0.75rem 1rem 0.25rem; letter-spacing: 0.5px;">Main</div>
                    <a href="@hrDashUrl" class="menu-link @(isHrDashActive ? "active" : "")">
                        <div>
                            <i class="fa-solid fa-gauge menu-icon"></i>
                            <span>HR Dashboard</span>
                        </div>
                    </a>

                    <div class="menu-title font-bold text-uppercase" style="font-size: 0.7rem; color: rgba(255,255,255,0.45); padding: 0.75rem 1rem 0.25rem; letter-spacing: 0.5px;">Employee Management</div>
                    <a href="/HREmployee/Directory" class="menu-link @(currentController == "HREmployee" && currentAction == "Directory" ? "active" : "")">
                        <div>
                            <i class="fa-solid fa-users menu-icon"></i>
                            <span>Employee Directory</span>
                        </div>
                    </a>
                    <a href="/HREmployee/Onboarding" class="menu-link @(currentController == "HREmployee" && currentAction == "Onboarding" ? "active" : "")">
                        <div>
                            <i class="fa-solid fa-user-plus menu-icon"></i>
                            <span>Onboarding & KYC</span>
                        </div>
                    </a>
                    <a href="/HREmployee/Contracts" class="menu-link @(currentController == "HREmployee" && currentAction == "Contracts" ? "active" : "")">
                        <div>
                            <i class="fa-solid fa-file-contract menu-icon"></i>
                            <span>Contracts & Docs</span>
                        </div>
                    </a>
                    <a href="/HREmployee/Transfers" class="menu-link @(currentController == "HREmployee" && currentAction == "Transfers" ? "active" : "")">
                        <div>
                            <i class="fa-solid fa-arrows-spin menu-icon"></i>
                            <span>Transfers & Promotions</span>
                        </div>
                    </a>
                    <a href="/HREmployee/Offboarding" class="menu-link @(currentController == "HREmployee" && currentAction == "Offboarding" ? "active" : "")">
                        <div>
                            <i class="fa-solid fa-user-xmark menu-icon"></i>
                            <span>Offboarding & Exit</span>
                        </div>
                    </a>

                    <div class="menu-title font-bold text-uppercase" style="font-size: 0.7rem; color: rgba(255,255,255,0.45); padding: 0.75rem 1rem 0.25rem; letter-spacing: 0.5px;">Attendance & Shifts</div>
                    <a href="/HRAttendance/DailyLogs" class="menu-link @(currentController == "HRAttendance" && currentAction == "DailyLogs" ? "active" : "")">
                        <div>
                            <i class="fa-solid fa-calendar-check menu-icon"></i>
                            <span>Daily Attendance Logs</span>
                        </div>
                    </a>
                    <a href="/HRAttendance/Biometric" class="menu-link @(currentController == "HRAttendance" && currentAction == "Biometric" ? "active" : "")">
                        <div>
                            <i class="fa-solid fa-fingerprint menu-icon"></i>
                            <span>Biometric & Geo-Punches</span>
                        </div>
                    </a>
                    <a href="/HRAttendance/ShiftScheduling" class="menu-link @(currentController == "HRAttendance" && currentAction == "ShiftScheduling" ? "active" : "")">
                        <div>
                            <i class="fa-solid fa-clock menu-icon"></i>
                            <span>Shift Rosters</span>
                        </div>
                    </a>
                    <a href="/HRAttendance/Overtime" class="menu-link @(currentController == "HRAttendance" && currentAction == "Overtime" ? "active" : "")">
                        <div>
                            <i class="fa-solid fa-business-time menu-icon"></i>
                            <span>Overtime Tracker</span>
                        </div>
                    </a>
                    <a href="/HRAttendance/Regularization" class="menu-link @(currentController == "HRAttendance" && currentAction == "Regularization" ? "active" : "")">
                        <div>
                            <i class="fa-solid fa-envelope-open-text menu-icon"></i>
                            <span>Attendance Requests</span>
                        </div>
                    </a>

                    <div class="menu-title font-bold text-uppercase" style="font-size: 0.7rem; color: rgba(255,255,255,0.45); padding: 0.75rem 1rem 0.25rem; letter-spacing: 0.5px;">Leave Management</div>
                    <a href="/HRLeave/Policy" class="menu-link @(currentController == "HRLeave" && currentAction == "Policy" ? "active" : "")">
                        <div>
                            <i class="fa-solid fa-file-invoice menu-icon"></i>
                            <span>Leave Policy & Types</span>

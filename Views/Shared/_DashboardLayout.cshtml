                            <div class="p-2 border-bottom text-start">
                                <a href="/Inbox" class="text-decoration-none d-block p-2 rounded bg-light-subtle mb-1">
                                    <span class="fw-bold d-block text-dark small">Internal Messages</span>
                                    <span class="text-muted extra-small text-truncate d-block">Check your messages and sent items</span>
                                </a>
                            </div>
                            <div class="p-2 text-center bg-light">
                                <a href="/Inbox" class="text-decoration-none fw-bold text-primary small d-block">
                                    Open Inbox & Messages <i class="fa-solid fa-arrow-right ms-1"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                    <!-- Fullscreen -->
                    <button class="icon-btn d-none d-sm-block" onclick="toggleFullscreen()">
                        <i class="fa-solid fa-expand"></i>
                    </button>

                    <!-- Vertical Divider -->
                    <div style="width: 1px; height: 24px; background-color: var(--border-warm);"></div>

                    <!-- Profile dropdown -->
                    <div class="dropdown">
                        <a href="#" class="user-profile dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
                            <img src="@layoutProfilePhoto" alt="@userFullName" class="profile-img" style="object-fit: cover; border: 2px solid var(--primary-warm);" />
                            <div class="profile-info d-none d-sm-block text-start">
                                <div class="profile-name">@userFullName</div>
                                <div class="profile-role">@userRole</div>
                            </div>
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end shadow border-0 mt-2" style="background-color: #ffffff; border: 1px solid var(--border-warm) !important;">
                            <li><h6 class="dropdown-header" style="color: var(--text-color); font-weight: 700;">@userCompany</h6></li>
                            <li><hr class="dropdown-divider" style="background-color: var(--border-warm);"></li>
                            <li><a class="dropdown-item" href="/Profile" style="color: var(--text-color);"><i class="fa-regular fa-user me-2"></i> My Profile</a></li>
                            <li><a class="dropdown-item" href="/Settings" style="color: var(--text-color);"><i class="fa-solid fa-sliders me-2"></i> Settings</a></li>
                            <li><hr class="dropdown-divider" style="background-color: var(--border-warm);"></li>
                            <li><a class="dropdown-item text-danger" href="/Account/Logout"><i class="fa-solid fa-right-from-bracket me-2"></i> Sign Out</a></li>
                        </ul>
                    </div>
                </div>
            </header>

            <!-- Main Panel Render Area -->
            <main class="main-inner">
                @RenderBody()
            </main>
        </div>
    </div>

    <div id="google_translate_element"></div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/language-selector.js" asp-append-version="true"></script>
    <script>
        function toggleSidebar() {
            document.getElementById('sidebar').classList.toggle('active');
        }

        function toggleFullscreen() {
            if (!document.fullscreenElement) {
                document.documentElement.requestFullscreen().catch(err => {
                    console.log(`Error attempting to enable full-screen mode: ${err.message}`);
                });
            } else {
                document.exitFullscreen();
            }
        }
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
                    <!-- Language Selector Dropdown -->
                    <div class="dropdown me-1">
                        <button class="btn btn-sm btn-outline-secondary dropdown-toggle d-flex align-items-center gap-1.5 px-2.5 py-1 notranslate" translate="no" type="button" data-bs-toggle="dropdown" aria-expanded="false" style="border-radius:6px; font-size:0.8rem; font-weight:600; background-color:#faf8f5; border-color:#d4cbbd; color:var(--text-color);">

@* Language Dropdown Partial / Shared Navbar *@
<div class="dropdown">
    <button class="btn btn-outline-secondary btn-sm dropdown-toggle rounded-pill px-3" type="button" id="langDropdown" data-bs-toggle="dropdown" aria-expanded="false">
        <i class="fa fa-globe me-1"></i> <span id="currentLangLabel">Language</span>
    </button>
    <ul class="dropdown-menu dropdown-menu-end shadow border-0" aria-labelledby="langDropdown">
        <li><a class="dropdown-item" href="javascript:void(0)" onclick="switchLanguage('en-US')">🇬🇧 English</a></li>
        <li><a class="dropdown-item" href="javascript:void(0)" onclick="switchLanguage('hi-IN')">🇮🇳 Hindi (हिन्दी)</a></li>
        <li><a class="dropdown-item" href="javascript:void(0)" onclick="switchLanguage('ur-PK')">🇵🇰 Urdu (اردو)</a></li>
        <li><a class="dropdown-item" href="javascript:void(0)" onclick="switchLanguage('mr-IN')">🇮🇳 Marathi (मराठी)</a></li>
        <li><a class="dropdown-item" href="javascript:void(0)" onclick="switchLanguage('ar-SA')">🇸🇦 Arabic (العربية)</a></li>
    </ul>
</div>

<script>
    function switchLanguage(cultureCode) {
        // Set cookie directly in JavaScript as well to avoid race conditions
        const date = new Date();
        date.setTime(date.getTime() + (365 * 24 * 60 * 60 * 1000));
        const expires = "; expires=" + date.toUTCString();
        
        // Write both AspNetCore culture and localStorage
        document.cookie = ".AspNetCore.Culture=c=" + cultureCode + "|uic=" + cultureCode + expires + "; path=/; SameSite=Lax";
        localStorage.setItem("user_selected_language", cultureCode);

        // POST/GET to backend controller and reload cleanly
        window.location.href = '/Home/SetLanguage?culture=' + encodeURIComponent(cultureCode) + '&returnUrl=' + encodeURIComponent(window.location.pathname);
    }
</script>

@model IEnumerable<ERP_System.Models.User>
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "User Directory";
}

<div class="container-fluid py-4 text-start">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-bold mb-1"><i class="fa-solid fa-users text-primary me-2"></i>User Directory</h4>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0 small">
                    <li class="breadcrumb-item"><a href="/Dashboard" class="text-decoration-none">Admin Dashboard</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Users</li>
                </ol>
            </nav>
        </div>
        <a href="/AdminUser/AddEdit" class="btn btn-primary rounded-pill px-3 btn-sm shadow-sm">
            <i class="fa-solid fa-plus me-1.5"></i>Create New User
        </a>
    </div>

    <!-- Users Grid -->
    <div class="bg-white border rounded-3 p-4 shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" style="font-size: 0.85rem;">
                <thead class="table-light">
                    <tr>
                        <th>Full Name</th>
                        <th>Username</th>
                        <th>Email Address</th>
                        <th>Assigned Role</th>
                        <th>Branch</th>
                        <th>Account Status</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var u in Model)
                        {
                            <tr>
                                <td class="fw-bold text-dark">@u.FullName</td>
                                <td>@@@u.UserName</td>
                                <td>@u.Email</td>
                                <td>
                                    <span class="badge bg-primary-subtle text-primary rounded-pill px-2.5">
                                        @(u.Role != null ? u.Role.RoleName : "Employee")
                                    </span>
                                </td>
                                <td>@(u.Branch != null ? u.Branch.BranchName : "Main Head Office")</td>
                                <td>
                                    @if (u.IsActive)
                                    {
                                        <span class="badge bg-success-subtle text-success rounded-pill px-2.5 py-1">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger-subtle text-danger rounded-pill px-2.5 py-1">Locked</span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center py-4 text-muted">No users found.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

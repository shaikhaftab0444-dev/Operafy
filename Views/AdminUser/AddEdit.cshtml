@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Add / Edit User";

    var roles = ViewBag.Roles as IEnumerable<ERP_System.Models.Role>
        ?? new List<ERP_System.Models.Role>();

    var branches = ViewBag.Branches as IEnumerable<ERP_System.Models.Branch>
        ?? new List<ERP_System.Models.Branch>();
}

<style>

    /* =============================================
           USER PROFILE PAGE - PROFESSIONAL UI
        ============================================== */

    .user-profile-page {
        max-width: 950px;
        margin: 0 auto;
        animation: userPageEnter 0.55s ease-out both;
    }

    /* =============================================
           PAGE HEADER
        ============================================== */

    .user-page-header {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 1rem;
        margin-bottom: 1.75rem;
        animation: fadeSlideDown 0.6s ease-out both;
    }

    .user-page-heading {
        display: flex;
        align-items: center;
        gap: 1rem;
    }

    .user-page-icon {
        width: 48px;
        height: 48px;
        flex: 0 0 48px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 14px;
        color: var(--primary-warm, #0d6efd);
        background: linear-gradient( 135deg, rgba(13, 110, 253, 0.13), rgba(13, 110, 253, 0.05) );
        border: 1px solid rgba(13, 110, 253, 0.12);
        box-shadow: 0 8px 22px rgba(13, 110, 253, 0.08);
        font-size: 1.1rem;
        animation: iconFloat 4s ease-in-out infinite;
    }

    .user-page-title {
        margin: 0 0 0.25rem;
        color: var(--text-color, #212529);
        font-size: 1.45rem;
        font-weight: 700;
        letter-spacing: -0.02em;
    }

    .user-page-subtitle {
        margin: 0;
        color: #7b8492;
        font-size: 0.84rem;
    }

    .user-breadcrumb {
        margin: 0;
    }

        .user-breadcrumb .breadcrumb-item {
            font-size: 0.78rem;
        }

        .user-breadcrumb a {
            color: var(--primary-warm, #0d6efd);
            transition: color 0.2s ease;
        }

            .user-breadcrumb a:hover {
                color: #084298;
            }

    /* =============================================
           MAIN CARD
        ============================================== */

    .user-form-card {
        position: relative;
        overflow: hidden;
        background: #ffffff;
        border: 1px solid var(--border-warm, #e9ecef);
        border-radius: 18px;
        box-shadow: 0 10px 30px rgba(30, 40, 55, 0.05), 0 2px 6px rgba(30, 40, 55, 0.025);
        animation: formCardEnter 0.65s cubic-bezier(0.16, 1, 0.3, 1) both;
        animation-delay: 0.08s;
        transition: box-shadow 0.3s ease, transform 0.3s ease;
    }

        .user-form-card:hover {
            box-shadow: 0 18px 42px rgba(30, 40, 55, 0.07), 0 4px 12px rgba(30, 40, 55, 0.035);
        }

        .user-form-card::before {
            content: "";
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 3px;
            background: linear-gradient( 90deg, var(--primary-warm, #0d6efd), rgba(13, 110, 253, 0.35), transparent );
        }

    /* =============================================
           CARD HEADER
        ============================================== */

    .user-card-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        padding: 1.5rem 1.75rem 1.25rem;
        border-bottom: 1px solid #f0f1f4;
    }

    .user-card-header-content {
        display: flex;
        align-items: center;
        gap: 0.9rem;
    }

    .user-card-small-icon {
        width: 40px;
        height: 40px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 12px;
        color: var(--primary-warm, #0d6efd);
        background: rgba(13, 110, 253, 0.08);
        font-size: 0.95rem;
    }

    .user-card-title {
        margin: 0 0 0.2rem;
        color: var(--text-color, #212529);
        font-size: 1rem;
        font-weight: 700;
    }

    .user-card-description {
        margin: 0;
        color: #8a929f;
        font-size: 0.78rem;
    }

    .required-info {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        color: #8a929f;
        font-size: 0.72rem;
    }

    .required-star {
        color: #dc3545;
        font-size: 0.9rem;
    }

    /* =============================================
           FORM BODY
        ============================================== */

    .user-form-body {
        padding: 1.75rem;
    }

    .form-section-label {
        display: flex;
        align-items: center;
        gap: 0.55rem;
        margin-bottom: 1.25rem;
        color: #596273;
        font-size: 0.72rem;
        font-weight: 700;
        letter-spacing: 0.08em;
        text-transform: uppercase;
    }

        .form-section-label::after {
            content: "";
            flex: 1;
            height: 1px;
            background: linear-gradient( 90deg, #e9ecf0, transparent );
        }

    .form-group-custom {
        position: relative;
        opacity: 0;
        animation: fieldEnter 0.5s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

        .form-group-custom:nth-child(1) {
            animation-delay: 0.12s;
        }

        .form-group-custom:nth-child(2) {
            animation-delay: 0.17s;
        }

        .form-group-custom:nth-child(3) {
            animation-delay: 0.22s;
        }

        .form-group-custom:nth-child(4) {
            animation-delay: 0.27s;
        }

        .form-group-custom:nth-child(5) {
            animation-delay: 0.32s;
        }

        .form-group-custom:nth-child(6) {
            animation-delay: 0.37s;
        }

    /* =============================================
           LABEL
        ============================================== */

    .user-form-label {
        display: flex;
        align-items: center;
        gap: 0.45rem;
        margin-bottom: 0.55rem;
        color: #454d5c;
        font-size: 0.78rem;
        font-weight: 700;
    }

        .user-form-label i {
            width: 15px;
            color: #9aa3b0;
            font-size: 0.75rem;
            transition: color 0.25s ease, transform 0.25s ease;
        }

    .form-group-custom:focus-within
    .user-form-label i {
        color: var(--primary-warm, #0d6efd);
        transform: scale(1.08);
    }

    /* =============================================
           INPUT WRAPPER
        ============================================== */

    .input-wrapper {
        position: relative;
    }

    .user-form-control,
    .user-form-select {
        width: 100%;
        min-height: 48px;
        padding: 0.7rem 0.9rem;
        border: 1px solid #e2e6eb;
        border-radius: 11px;
        outline: none;
        color: #2f3745;
        background: #fbfcfd;
        font-size: 0.85rem;
        transition: border-color 0.22s ease, box-shadow 0.22s ease, background 0.22s ease, transform 0.22s ease;
    }

        .user-form-control:hover,
        .user-form-select:hover {
            border-color: #d2d8e0;
            background: #ffffff;
        }

        .user-form-control:focus,
        .user-form-select:focus {
            border-color: var(--primary-warm, #0d6efd);
            background: #ffffff;
            box-shadow: 0 0 0 4px rgba(13, 110, 253, 0.08);
            transform: translateY(-1px);
        }

        .user-form-control::placeholder {
            color: #adb5bd;
        }

    .user-form-select {
        cursor: pointer;
    }

    /* =============================================
           PASSWORD
        ============================================== */

    .password-field-wrapper {
        position: relative;
    }

        .password-field-wrapper
        .user-form-control {
            padding-right: 3rem;
        }

    .password-toggle-btn {
        position: absolute;
        top: 50%;
        right: 0.35rem;
        width: 38px;
        height: 38px;
        display: flex;
        align-items: center;
        justify-content: center;
        border: none;
        border-radius: 9px;
        color: #929aa7;
        background: transparent;
        transform: translateY(-50%);
        cursor: pointer;
        transition: color 0.2s ease, background 0.2s ease, transform 0.2s ease;
    }

        .password-toggle-btn:hover {
            color: var(--primary-warm, #0d6efd);
            background: rgba(13, 110, 253, 0.07);
            transform: translateY(-50%) scale(1.05);
        }

        .password-toggle-btn:active {
            transform: translateY(-50%) scale(0.96);
        }

    /* =============================================
           SECURITY NOTE
        ============================================== */

    .security-note {
        display: flex;
        align-items: flex-start;
        gap: 0.75rem;
        margin-top: 1.5rem;
        padding: 0.9rem 1rem;
        border: 1px solid rgba(13, 110, 253, 0.09);
        border-radius: 12px;
        color: #77808e;
        background: linear-gradient( 135deg, rgba(13, 110, 253, 0.045), rgba(13, 110, 253, 0.02) );
        font-size: 0.77rem;
        line-height: 1.55;
        animation: fadeSlideUp 0.6s ease both;
        animation-delay: 0.4s;
    }

        .security-note i {
            margin-top: 0.1rem;
            color: var(--primary-warm, #0d6efd);
        }

        .security-note strong {
            color: #566071;
        }

    /* =============================================
           FORM ACTIONS
        ============================================== */

    .user-form-actions {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 0.75rem;
        margin-top: 1.75rem;
        padding-top: 1.35rem;
        border-top: 1px solid #f0f1f4;
        animation: fadeSlideUp 0.6s ease both;
        animation-delay: 0.45s;
    }

    .user-btn-cancel,
    .user-btn-save {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.55rem;
        min-height: 43px;
        padding: 0.65rem 1.25rem;
        border-radius: 10px;
        font-size: 0.82rem;
        font-weight: 600;
        text-decoration: none;
        transition: transform 0.2s ease, box-shadow 0.2s ease, background 0.2s ease, border-color 0.2s ease;
    }

    .user-btn-cancel {
        color: #677080;
        border: 1px solid #e1e5ea;
        background: #ffffff;
    }

        .user-btn-cancel:hover {
            color: #49515e;
            background: #f8f9fa;
            border-color: #d5dae1;
            transform: translateY(-1px);
        }

    .user-btn-save {
        position: relative;
        overflow: hidden;
        border: none;
        color: #ffffff;
        background: linear-gradient( 135deg, var(--primary-warm, #0d6efd), #377cf1 );
        box-shadow: 0 8px 18px rgba(13, 110, 253, 0.18);
        cursor: pointer;
    }

        .user-btn-save::before {
            content: "";
            position: absolute;
            top: 0;
            left: -120%;
            width: 70%;
            height: 100%;
            background: linear-gradient( 100deg, transparent, rgba(255,255,255,0.25), transparent );
            transform: skewX(-20deg);
            transition: left 0.6s ease;
        }

        .user-btn-save:hover {
            transform: translateY(-2px);
            box-shadow: 0 12px 25px rgba(13, 110, 253, 0.25);
        }

            .user-btn-save:hover::before {
                left: 150%;
            }

        .user-btn-save:active {
            transform: translateY(0) scale(0.98);
        }

    /* =============================================
           ANIMATIONS
        ============================================== */

    @@keyframes userPageEnter {

        from {
            opacity: 0;
            transform: translateY(12px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@keyframes fadeSlideDown {

        from {
            opacity: 0;
            transform: translateY(-14px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@keyframes formCardEnter {

        from {
            opacity: 0;
            transform: translateY(22px) scale(0.99);
        }

        to {
            opacity: 1;
            transform: translateY(0) scale(1);
        }
    }

    @@keyframes fieldEnter {

        from {
            opacity: 0;
            transform: translateY(14px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@keyframes fadeSlideUp {

        from {
            opacity: 0;
            transform: translateY(12px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@keyframes iconFloat {

        0%,
        100% {
            transform: translateY(0);
        }

        50% {
            transform: translateY(-3px);
        }
    }

    /* =============================================
           RESPONSIVE
        ============================================== */

    @@media (max-width: 767.98px) {

        .user-page-header {
            margin-bottom: 1.25rem;
        }

        .user-page-icon {
            width: 43px;
            height: 43px;
            flex-basis: 43px;
        }

        .user-page-title {
            font-size: 1.2rem;
        }

        .user-card-header {
            padding: 1.25rem;
        }

        .user-card-description {
            display: none;
        }

        .required-info {
            display: none;
        }

        .user-form-body {
            padding: 1.25rem;
        }

        .user-form-actions {
            justify-content: stretch;
        }

        .user-btn-cancel,
        .user-btn-save {
            flex: 1;
        }
    }

    @@media (max-width: 575.98px) {

        .user-page-heading {
            gap: 0.75rem;
        }

        .user-page-title {
            font-size: 1.08rem;
        }

        .user-page-subtitle {
            font-size: 0.75rem;
        }

        .user-card-header {
            padding: 1rem;
        }

        .user-form-body {
            padding: 1rem;
        }

        .user-form-actions {
            flex-direction: column-reverse;
            align-items: stretch;
        }

        .user-btn-cancel,
        .user-btn-save {
            width: 100%;
        }
    }

    /* =============================================
           REDUCED MOTION
        ============================================== */

    @@media (prefers-reduced-motion: reduce) {

        *,
        *::before,
        *::after {
            animation-duration: 0.01ms !important;
            animation-iteration-count: 1 !important;
            transition-duration: 0.01ms !important;
        }
    }

</style>


<div class="container-fluid py-4 text-start">

    <div class="user-profile-page">

        <!-- =========================================
             PAGE HEADER
        ========================================== -->

        <div class="user-page-header">

            <div>

                <div class="user-page-heading">

                    <div class="user-page-icon">
                        <i class="fa-solid fa-user-plus"></i>
                    </div>

                    <div>

                        <h4 class="user-page-title">
                            Create New User Profile
                        </h4>

                        <p class="user-page-subtitle">
                            Create and configure a new user account for your organization.
                        </p>

                    </div>

                </div>


                <nav aria-label="breadcrumb"
                     class="mt-3">

                    <ol class="breadcrumb user-breadcrumb">

                        <li class="breadcrumb-item">
                            <a href="/Dashboard"
                               class="text-decoration-none">

                                Admin Dashboard

                            </a>
                        </li>

                        <li class="breadcrumb-item">
                            <a href="/AdminUser/Directory"
                               class="text-decoration-none">

                                Users

                            </a>
                        </li>

                        <li class="breadcrumb-item active"
                            aria-current="page">

                            Add User

                        </li>

                    </ol>

                </nav>

            </div>

        </div>


        <!-- =========================================
             FORM CARD
        ========================================== -->

        <div class="user-form-card">

            <!-- CARD HEADER -->

            <div class="user-card-header">

                <div class="user-card-header-content">

                    <div class="user-card-small-icon">
                        <i class="fa-solid fa-id-card"></i>
                    </div>

                    <div>

                        <h5 class="user-card-title">
                            User Details
                        </h5>

                        <p class="user-card-description">
                            Enter the basic account and access information.
                        </p>

                    </div>

                </div>


                <div class="required-info">

                    <span class="required-star">*</span>

                    Required fields

                </div>

            </div>


            <!-- FORM BODY -->

            <div class="user-form-body">

                <form>

                    <!-- PERSONAL INFORMATION -->

                    <div class="form-section-label">

                        <i class="fa-solid fa-user"></i>

                        Personal Information

                    </div>


                    <div class="row g-4">

                        <!-- FULL NAME -->

                        <div class="col-md-6">

                            <div class="form-group-custom">

                                <label class="user-form-label">

                                    <i class="fa-regular fa-user"></i>

                                    Full Name

                                    <span class="required-star">*</span>

                                </label>


                                <div class="input-wrapper">

                                    <input type="text"
                                           class="user-form-control"
                                           placeholder="e.g. Aftab Shaik"
                                           required />

                                </div>

                            </div>

                        </div>


                        <!-- EMAIL -->

                        <div class="col-md-6">

                            <div class="form-group-custom">

                                <label class="user-form-label">

                                    <i class="fa-regular fa-envelope"></i>

                                    Email Address

                                    <span class="required-star">*</span>

                                </label>


                                <div class="input-wrapper">

                                    <input type="email"
                                           class="user-form-control"
                                           placeholder="e.g. aftab@erp.com"
                                           required />

                                </div>

                            </div>

                        </div>


                        <!-- USERNAME -->

                        <div class="col-md-6">

                            <div class="form-group-custom">

                                <label class="user-form-label">

                                    <i class="fa-solid fa-at"></i>

                                    Username

                                    <span class="required-star">*</span>

                                </label>


                                <div class="input-wrapper">

                                    <input type="text"
                                           class="user-form-control"
                                           placeholder="e.g. shaikhaftab"
                                           required />

                                </div>

                            </div>

                        </div>


                        <!-- PASSWORD -->

                        <div class="col-md-6">

                            <div class="form-group-custom">

                                <label class="user-form-label">

                                    <i class="fa-solid fa-lock"></i>

                                    Password

                                    <span class="required-star">*</span>

                                </label>


                                <div class="password-field-wrapper">

                                    <input type="password"
                                           id="passwordInput"
                                           class="user-form-control"
                                           placeholder="••••••••"
                                           required />


                                    <button type="button"
                                            class="password-toggle-btn"
                                            id="passwordToggle"
                                            aria-label="Show password">

                                        <i class="fa-regular fa-eye"></i>

                                    </button>

                                </div>

                            </div>

                        </div>

                    </div>


                    <!-- ACCESS CONFIGURATION -->

                    <div class="form-section-label mt-4">

                        <i class="fa-solid fa-shield-halved"></i>

                        Access Configuration

                    </div>


                    <div class="row g-4">

                        <!-- ROLE -->

                        <div class="col-md-6">

                            <div class="form-group-custom">

                                <label class="user-form-label">

                                    <i class="fa-solid fa-user-tag"></i>

                                    Role Name

                                    <span class="required-star">*</span>

                                </label>


                                <select class="user-form-select"
                                        required>

                                    <option value=""
                                            selected
                                            disabled>

                                        Select user role

                                    </option>

                                    @foreach (var role in roles)
                                    {
                                        <option value="@role.RoleId">
                                            @role.RoleName
                                        </option>
                                    }

                                </select>

                            </div>

                        </div>


                        <!-- BRANCH -->

                        <div class="col-md-6">

                            <div class="form-group-custom">

                                <label class="user-form-label">

                                    <i class="fa-solid fa-building"></i>

                                    Office Branch Location

                                    <span class="required-star">*</span>

                                </label>


                                <select class="user-form-select"
                                        required>

                                    <option value=""
                                            selected
                                            disabled>

                                        Select office branch

                                    </option>

                                    @foreach (var branch in branches)
                                    {
                                        <option value="@branch.BranchId">
                                            @branch.BranchName
                                        </option>
                                    }

                                </select>

                            </div>

                        </div>

                    </div>


                    <!-- SECURITY NOTE -->

                    <div class="security-note">

                        <i class="fa-solid fa-shield-heart"></i>

                        <div>

                            <strong>Account Security:</strong>

                            The assigned role controls what the user can
                            access inside the ERP system. Review permissions
                            before creating the account.

                        </div>

                    </div>


                    <!-- FORM ACTIONS -->

                    <div class="user-form-actions">

                        <a href="/AdminUser/Directory"
                           class="user-btn-cancel">

                            <i class="fa-solid fa-arrow-left"></i>

                            Cancel

                        </a>


                        <button type="button"
                                class="user-btn-save"
                                onclick="alert('User profile added successfully in DB!')">

                            <i class="fa-solid fa-user-plus"></i>

                            Save User

                        </button>

                    </div>

                </form>

            </div>

        </div>

    </div>

</div>


<script>

    document.addEventListener("DOMContentLoaded", function () {

        const passwordInput =
            document.getElementById("passwordInput");

        const passwordToggle =
            document.getElementById("passwordToggle");


        if (passwordInput && passwordToggle) {

            passwordToggle.addEventListener(
                "click",
                function () {

                    const icon =
                        this.querySelector("i");


                    if (passwordInput.type === "password") {

                        passwordInput.type = "text";

                        icon.classList.remove("fa-eye");

                        icon.classList.add("fa-eye-slash");

                        this.setAttribute(
                            "aria-label",
                            "Hide password"
                        );

                    }
                    else {

                        passwordInput.type = "password";

                        icon.classList.remove("fa-eye-slash");

                        icon.classList.add("fa-eye");

                        this.setAttribute(
                            "aria-label",
                            "Show password"
                        );

                    }

                }
            );

        }

    });

</script>
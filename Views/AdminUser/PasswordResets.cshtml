@model IEnumerable<ERP_System.Models.AdminPasswordReset>
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Password Reset Requests";
}

<div class="container-fluid py-4 text-start">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-bold mb-1"><i class="fa-solid fa-key text-primary me-2"></i>Password Reset Requests</h4>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0 small">
                    <li class="breadcrumb-item"><a href="/Dashboard" class="text-decoration-none">Admin Dashboard</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Reset Requests</li>
                </ol>
            </nav>
        </div>
    </div>

    <!-- Password Resets List -->
    <div class="bg-white border rounded-3 p-4 shadow-sm" style="max-width: 800px;">
        <h5 class="fw-bold mb-3">Recent Requests</h5>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" style="font-size: 0.85rem;">
                <thead class="table-light">
                    <tr>
                        <th>Username</th>
                        <th>Email</th>
                        <th>Request Date</th>
                        <th>Status</th>
                        <th class="text-center">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var r in Model)
                        {
                            <tr>
                                <td class="fw-bold text-dark">@@@r.Username</td>
                                <td>@r.Email</td>
                                <td class="text-muted">@r.RequestDate.ToString("dd MMM yyyy hh:mm tt")</td>
                                <td>
                                    @if (r.Status == "Completed")
                                    {
                                        <span class="badge bg-success-subtle text-success rounded-pill px-2 py-1">Completed</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning-subtle text-warning rounded-pill px-2 py-1">Pending</span>
                                    }
                                </td>
                                <td class="text-center">
                                    @if (r.Status == "Pending")
                                    {
                                        <form action="/AdminUser/ApproveReset" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@r.ResetId" />
                                            <button type="submit" class="btn btn-sm btn-outline-success px-3 rounded-pill py-1"><i class="fa-solid fa-check me-1"></i> Approve</button>
                                        </form>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">No actions</span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center py-4 text-muted">No password reset requests logged.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

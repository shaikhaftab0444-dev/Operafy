@model IEnumerable<ERP_System.Models.AdminPasswordReset>
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Password Reset Operations & Audit";

    var automatedResets = Model.Count(r => r.RequestType == "Automated Self-Service" && (r.Status.Contains("Completed") || r.Status.Contains("Auto")));
    var manualOverrides = Model.Count(r => r.RequestType == "Admin Override" || r.Status == "Manual Override");
    var failedOrExpired = Model.Count(r => r.Status == "Token Expired" || r.Status == "Rejected");
    var policyCompliance = "100%"; // Password Policy Enforced
}

<style>
    .glass-panel {
        background: rgba(255, 255, 255, 0.85);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border: 1px solid rgba(226, 232, 240, 0.8);
        border-radius: 16px;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.025);
    }
    .metric-card {
        background: #ffffff;
        border: 1px solid rgba(226, 232, 240, 0.8);
        border-radius: 16px;
        transition: all 0.3s ease;
    }
    .metric-card:hover {
        transform: translateY(-3px);
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.04);
    }
    .status-badge {
        font-size: 0.75rem;
        font-weight: 600;
        padding: 5px 12px;
        border-radius: 20px;
    }
    .status-pending {
        background-color: #fff7ed;
        color: #c2410c;
        border: 1px solid #ffedd5;
    }
    .status-completed {
        background-color: #f0fdf4;
        color: #15803d;
        border: 1px solid #dcfce7;
    }
    .status-manual {
        background-color: #eff6ff;
        color: #1d4ed8;
        border: 1px solid #dbeafe;
    }
    .status-expired {
        background-color: #fef2f2;
        color: #b91c1c;
        border: 1px solid #fee2e2;
    }
</style>

<div class="container-fluid py-4 text-start">
    
    <!-- Top Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1">
                    <li class="breadcrumb-item"><a href="/Dashboard" class="text-decoration-none">Admin Dashboard</a></li>
                    <li class="breadcrumb-item text-secondary">Identity & Security</li>
                    <li class="breadcrumb-item active" aria-current="page">Password Resets</li>
                </ol>
            </nav>
            <h4 class="fw-bold mb-1 text-dark"><i class="fa-solid fa-shield-halved text-primary me-2"></i>SSPR Operations & Audit Log</h4>
            <p class="text-secondary small mb-0">Monitor Self-Service resets, audit delivery methods, and apply emergency overrides.</p>
        </div>
    </div>

    <!-- Alert Trigger Notifications -->
    @if (TempData["EmergencySuccess"] != null)
    {
        <div class="alert alert-success border-0 shadow-sm py-3 px-4 rounded-3 mb-4 text-start" role="alert">
            <div class="d-flex align-items-center gap-2">
                <i class="fa-solid fa-circle-check text-success fs-5"></i>
                <span class="fw-bold">@TempData["EmergencySuccess"]</span>
            </div>
        </div>
    }

    <!-- Security KPI Metric Cards Grid -->
    <div class="row g-3 mb-4">
        <!-- Metric 1 -->
        <div class="col-md-3">
            <div class="metric-card p-3 shadow-sm d-flex align-items-center gap-3">
                <div class="bg-success-subtle text-success rounded-circle d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                    <i class="fa-solid fa-circle-check fs-5"></i>
                </div>
                <div>
                    <span class="text-secondary small d-block">Automated Resets</span>
                    <h4 class="fw-bold mb-0 text-dark">@automatedResets <span style="font-size: 0.75rem; font-weight: normal;" class="text-success">Auto-Resolved</span></h4>
                </div>
            </div>
        </div>

        <!-- Metric 2 -->
        <div class="col-md-3">
            <div class="metric-card p-3 shadow-sm d-flex align-items-center gap-3">
                <div class="bg-primary-subtle text-primary rounded-circle d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                    <i class="fa-solid fa-user-gear fs-5"></i>
                </div>
                <div>
                    <span class="text-secondary small d-block">Admin Overrides</span>
                    <h4 class="fw-bold mb-0 text-dark">@manualOverrides <span style="font-size: 0.75rem; font-weight: normal;" class="text-primary">Emergency</span></h4>
                </div>
            </div>
        </div>

        <!-- Metric 3 -->
        <div class="col-md-3">
            <div class="metric-card p-3 shadow-sm d-flex align-items-center gap-3">
                <div class="bg-danger-subtle text-danger rounded-circle d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                    <i class="fa-solid fa-hourglass-end fs-5"></i>
                </div>
                <div>
                    <span class="text-secondary small d-block">Failed & Expired</span>
                    <h4 class="fw-bold mb-0 text-dark">@failedOrExpired <span style="font-size: 0.75rem; font-weight: normal;" class="text-danger">Expired</span></h4>
                </div>
            </div>
        </div>

        <!-- Metric 4 -->
        <div class="col-md-3">
            <div class="metric-card p-3 shadow-sm d-flex align-items-center gap-3">
                <div class="bg-info-subtle text-info rounded-circle d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                    <i class="fa-solid fa-circle-nodes fs-5"></i>
                </div>
                <div>
                    <span class="text-secondary small d-block">SSPR Compliance</span>
                    <h4 class="fw-bold mb-0 text-dark">@policyCompliance <span style="font-size: 0.75rem; font-weight: normal;" class="text-info">Enforced</span></h4>
                </div>
            </div>
        </div>
    </div>

    <!-- Requests Audit Logs Table Card -->
    <div class="glass-panel p-4">
        <h5 class="fw-bold text-dark mb-4 border-bottom pb-2">
            <i class="fa-solid fa-list-check text-primary me-2"></i>Active Requests & Resets History
        </h5>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0 text-start" style="font-size: 0.85rem;">
                <thead class="table-light">
                    <tr>
                        <th style="width: 25%;">Employee Details</th>
                        <th style="width: 20%;">Request Type</th>
                        <th style="width: 18%;">Requested Timestamp</th>
                        <th style="width: 15%;">Delivery Method</th>
                        <th style="width: 12%;">Status</th>
                        <th style="width: 10%;" class="text-center">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var r in Model)
                        {
                            var statusClass = r.Status switch
                            {
                                "Pending" => "status-pending",
                                "Completed" => "status-completed",
                                "Auto-Completed (Self-Service)" => "status-completed",
                                "Manual Override" => "status-manual",
                                "Token Expired" => "status-expired",
                                _ => "status-pending"
                            };

                            var requestType = string.IsNullOrEmpty(r.RequestType) ? "Automated Self-Service" : r.RequestType;
                            var deliveryMethod = string.IsNullOrEmpty(r.DeliveryMethod) ? "Email Magic Link" : r.DeliveryMethod;

                            <tr>
                                <td>
                                    <div class="d-flex align-items-center">
                                        <div class="bg-light text-secondary rounded-circle d-flex align-items-center justify-content-center me-2.5 font-monospace fw-bold" style="width: 32px; height: 32px; font-size: 0.75rem;">
                                            @r.Username.Substring(0, Math.Min(2, r.Username.Length)).ToUpper()
                                        </div>
                                        <div>
                                            <span class="fw-bold text-dark d-block">@@@r.Username</span>
                                            <span class="text-muted small" style="font-size: 0.75rem;">@r.Email</span>
                                        </div>
                                    </div>
                                </td>
                                <td class="fw-semibold text-secondary">
                                    @requestType
                                </td>
                                <td class="text-secondary small">
                                    @r.RequestDate.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt")
                                </td>
                                <td class="font-monospace text-secondary small">
                                    @deliveryMethod
                                </td>
                                <td>
                                    <span class="status-badge @statusClass">@r.Status</span>
                                </td>
                                <td class="text-center">
                                    <button type="button" class="btn btn-sm btn-outline-danger px-2.5 py-1 rounded-pill" onclick="openEmergencyReset(@r.ResetId, '@r.Email')">
                                        <i class="fa-solid fa-triangle-exclamation me-1"></i>Override
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5 text-muted">No password reset requests logged.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

</div>

<!-- Emergency Reset Modal -->
<div class="modal fade" id="emergencyResetModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content glass-panel border shadow-lg text-start">
            <div class="modal-header border-bottom-0 pb-0">
                <h5 class="fw-bold text-dark"><i class="fa-solid fa-triangle-exclamation text-danger me-2"></i>Emergency Password Override</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form action="/AdminUser/EmergencyReset" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" id="emergencyResetId" />
                <div class="modal-body py-3">
                    <p class="text-secondary small mb-3">Assign a temporary password to override SSPR. The user will be able to sign in immediately using this key.</p>
                    
                    <div class="mb-3">
                        <label class="form-label small fw-bold text-secondary">Target Identity</label>
                        <input type="text" id="emergencyResetIdentity" class="form-control" readonly />
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-bold text-secondary">Temporary Password</label>
                        <input type="text" name="tempPassword" class="form-control font-monospace" placeholder="Temp987!" required />
                        <span class="text-muted small d-block mt-1" style="font-size: 0.75rem;">Password must contain uppercase, numbers, and special characters.</span>
                    </div>
                </div>
                <div class="modal-footer border-top-0 pt-0">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger fw-bold px-3">Apply Override</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    function openEmergencyReset(id, identity) {
        document.getElementById("emergencyResetId").value = id;
        document.getElementById("emergencyResetIdentity").value = identity;
        const modal = new bootstrap.Modal(document.getElementById("emergencyResetModal"));
        modal.show();
    }
</script>

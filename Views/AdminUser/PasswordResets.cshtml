@model IEnumerable<ERP_System.Models.AdminPasswordReset>
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Password Reset Operations & Audit";

    var automatedResets = Model.Count(r => r.RequestType == "Automated Self-Service" && (r.Status.Contains("Completed") || r.Status.Contains("Auto")));
    var manualOverrides = Model.Count(r => r.RequestType == "Admin Override" || r.Status == "Manual Override");
    var failedOrExpired = Model.Count(r => r.Status == "Token Expired" || r.Status == "Rejected");
    var policyCompliance = "100%";
}

<style>
    /* =========================================================
           PASSWORD RESET / SSPR PAGE
           Premium ERP UI
           ========================================================= */

    .sspr-page {
        min-height: 100%;
        animation: pageFadeIn .55s ease both;
    }

    /* ---------- Page Animation ---------- */

    @@keyframes pageFadeIn {
        from

    {
        opacity: 0;
        transform: translateY(10px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }

    }

    @@keyframes slideUp {
        from

    {
        opacity: 0;
        transform: translateY(18px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }

    }

    @@keyframes scaleIn {
        from

    {
        opacity: 0;
        transform: scale(.94);
    }

    to {
        opacity: 1;
        transform: scale(1);
    }

    }

    @@keyframes iconPulse {
        0%, 100%

    {
        transform: scale(1);
    }

    50% {
        transform: scale(1.08);
    }

    }

    @@keyframes softGlow {
        0%, 100%

    {
        box-shadow: 0 0 0 0 rgba(13, 110, 253, 0);
    }

    50% {
        box-shadow: 0 0 0 6px rgba(13, 110, 253, .06);
    }

    }

    /* ---------- Header ---------- */

    .sspr-header {
        position: relative;
        overflow: hidden;
        padding: 24px 26px;
        border-radius: 20px;
        background: radial-gradient(circle at 92% 15%, rgba(13, 110, 253, .10), transparent 28%), radial-gradient(circle at 70% 100%, rgba(111, 66, 193, .07), transparent 30%), #ffffff;
        border: 1px solid #e9edf3;
        box-shadow: 0 8px 30px rgba(15, 23, 42, .045);
        animation: slideUp .5s ease both;
    }

        .sspr-header::after {
            content: "";
            position: absolute;
            width: 180px;
            height: 180px;
            right: -70px;
            top: -90px;
            border-radius: 50%;
            border: 1px solid rgba(13, 110, 253, .10);
            pointer-events: none;
        }

    .sspr-breadcrumb {
        margin-bottom: 8px;
    }

        .sspr-breadcrumb .breadcrumb-item {
            font-size: .76rem;
            color: #8a94a6;
        }

        .sspr-breadcrumb a {
            color: #64748b;
            transition: color .2s ease;
        }

            .sspr-breadcrumb a:hover {
                color: #0d6efd;
            }

    .sspr-title {
        display: flex;
        align-items: center;
        gap: 11px;
        font-size: 1.35rem;
        letter-spacing: -.02em;
    }

    .title-icon {
        width: 42px;
        height: 42px;
        border-radius: 13px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(135deg, #0d6efd, #4f8dfd);
        color: #fff;
        box-shadow: 0 8px 18px rgba(13, 110, 253, .20);
        animation: softGlow 3s ease-in-out infinite;
    }

    .sspr-subtitle {
        color: #7b8798;
        font-size: .83rem;
        line-height: 1.55;
        max-width: 760px;
        margin-left: 53px;
    }

    /* ---------- Alert ---------- */

    .security-alert {
        border: 1px solid #d1fae5 !important;
        background: linear-gradient(135deg, #f0fdf4, #ffffff);
        box-shadow: 0 8px 24px rgba(16, 185, 129, .07);
        animation: slideUp .45s ease both;
    }

    .security-alert-icon {
        width: 38px;
        height: 38px;
        border-radius: 11px;
        background: #dcfce7;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    /* ---------- KPI Cards ---------- */

    .kpi-card {
        position: relative;
        height: 100%;
        overflow: hidden;
        border-radius: 18px;
        background: #ffffff;
        border: 1px solid #e9edf3;
        padding: 20px;
        box-shadow: 0 7px 25px rgba(15, 23, 42, .045);
        transition: transform .3s ease, box-shadow .3s ease, border-color .3s ease;
        animation: slideUp .55s ease both;
    }

        .kpi-card:nth-child(1) {
            animation-delay: .05s;
        }

        .kpi-card:nth-child(2) {
            animation-delay: .10s;
        }

        .kpi-card:nth-child(3) {
            animation-delay: .15s;
        }

        .kpi-card:nth-child(4) {
            animation-delay: .20s;
        }

        .kpi-card:hover {
            transform: translateY(-5px);
            border-color: #dce4ef;
            box-shadow: 0 16px 35px rgba(15, 23, 42, .085);
        }

        .kpi-card::before {
            content: "";
            position: absolute;
            width: 100px;
            height: 100px;
            right: -35px;
            top: -40px;
            border-radius: 50%;
            background: rgba(13, 110, 253, .035);
            transition: transform .35s ease;
        }

        .kpi-card:hover::before {
            transform: scale(1.35);
        }

    .kpi-icon {
        width: 50px;
        height: 50px;
        border-radius: 15px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        transition: transform .3s ease;
    }

    .kpi-card:hover .kpi-icon {
        transform: rotate(-4deg) scale(1.06);
    }

    .kpi-icon.success {
        background: #ecfdf3;
        color: #16a34a;
    }

    .kpi-icon.primary {
        background: #eff6ff;
        color: #2563eb;
    }

    .kpi-icon.danger {
        background: #fef2f2;
        color: #dc2626;
    }

    .kpi-icon.info {
        background: #ecfeff;
        color: #0891b2;
    }

    .kpi-label {
        color: #7a8699;
        font-size: .76rem;
        font-weight: 600;
        letter-spacing: .01em;
        margin-bottom: 3px;
    }

    .kpi-value {
        font-size: 1.55rem;
        font-weight: 750;
        line-height: 1.1;
        color: #172033;
        letter-spacing: -.025em;
    }

    .kpi-status {
        font-size: .69rem;
        font-weight: 700;
        padding: 4px 8px;
        border-radius: 20px;
        margin-left: 5px;
        vertical-align: middle;
    }

        .kpi-status.success {
            color: #15803d;
            background: #f0fdf4;
        }

        .kpi-status.primary {
            color: #1d4ed8;
            background: #eff6ff;
        }

        .kpi-status.danger {
            color: #b91c1c;
            background: #fef2f2;
        }

        .kpi-status.info {
            color: #0e7490;
            background: #ecfeff;
        }

    /* ---------- Audit Card ---------- */

    .audit-card {
        position: relative;
        overflow: hidden;
        border-radius: 20px;
        background: rgba(255, 255, 255, .96);
        border: 1px solid #e7ebf1;
        box-shadow: 0 10px 35px rgba(15, 23, 42, .055);
        animation: slideUp .65s ease both;
    }

    .audit-card-header {
        padding: 21px 23px;
        border-bottom: 1px solid #edf0f4;
        background: linear-gradient(135deg, rgba(248, 250, 252, .96), rgba(255, 255, 255, .98));
    }

    .audit-title {
        display: flex;
        align-items: center;
        gap: 10px;
        font-size: .98rem;
        font-weight: 750;
        color: #172033;
    }

    .audit-title-icon {
        width: 35px;
        height: 35px;
        border-radius: 10px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background: #eff6ff;
        color: #2563eb;
    }

    .audit-description {
        color: #8993a4;
        font-size: .73rem;
        margin-top: 3px;
        margin-left: 45px;
    }

    /* ---------- Table ---------- */

    .audit-table {
        margin: 0;
        border-collapse: separate;
        border-spacing: 0;
    }

        .audit-table thead th {
            background: #f8fafc;
            color: #667085;
            border-top: 0;
            border-bottom: 1px solid #e9edf2;
            padding: 13px 16px;
            font-size: .70rem;
            font-weight: 750;
            text-transform: uppercase;
            letter-spacing: .045em;
            white-space: nowrap;
        }

        .audit-table tbody tr {
            animation: rowFade .45s ease both;
            transition: background-color .2s ease;
        }

    @@keyframes rowFade {
        from

    {
        opacity: 0;
        transform: translateY(7px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }

    }

    .audit-table tbody tr:hover {
        background: #f8fbff;
    }

    .audit-table tbody td {
        padding: 15px 16px;
        border-bottom: 1px solid #eef1f5;
        color: #475467;
        font-size: .79rem;
        vertical-align: middle;
    }

    .audit-table tbody tr:last-child td {
        border-bottom: 0;
    }

    /* ---------- Employee Avatar ---------- */

    .employee-avatar {
        width: 38px;
        height: 38px;
        border-radius: 12px;
        background: linear-gradient(135deg, #f1f5f9, #e2e8f0);
        color: #475569;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        font-size: .70rem;
        font-weight: 800;
        border: 1px solid #e2e8f0;
        transition: all .25s ease;
    }

    .audit-table tbody tr:hover .employee-avatar {
        background: linear-gradient(135deg, #eaf2ff, #dbeafe);
        color: #2563eb;
        border-color: #bfdbfe;
        transform: scale(1.05);
    }

    .employee-name {
        color: #1f2937;
        font-size: .79rem;
        font-weight: 700;
    }

    .employee-email {
        color: #98a2b3;
        font-size: .70rem;
        margin-top: 2px;
    }

    /* ---------- Status ---------- */

    .status-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        font-size: .68rem;
        font-weight: 700;
        padding: 6px 10px;
        border-radius: 999px;
        white-space: nowrap;
        border: 1px solid transparent;
    }

        .status-badge::before {
            content: "";
            width: 6px;
            height: 6px;
            border-radius: 50%;
            background: currentColor;
            opacity: .85;
        }

    .status-pending {
        background-color: #fff7ed;
        color: #c2410c;
        border-color: #ffedd5;
    }

    .status-completed {
        background-color: #f0fdf4;
        color: #15803d;
        border-color: #dcfce7;
    }

    .status-manual {
        background-color: #eff6ff;
        color: #1d4ed8;
        border-color: #dbeafe;
    }

    .status-expired {
        background-color: #fef2f2;
        color: #b91c1c;
        border-color: #fee2e2;
    }

    /* ---------- Request Type ---------- */

    .request-type {
        color: #475467;
        font-weight: 650;
    }

    .delivery-method {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        color: #667085;
        background: #f8fafc;
        border: 1px solid #edf0f3;
        padding: 5px 8px;
        border-radius: 8px;
        font-size: .68rem;
    }

    /* ---------- Override Button ---------- */

    .override-btn {
        border: 1px solid #fecaca;
        color: #dc2626;
        background: #fff;
        font-size: .69rem;
        font-weight: 700;
        padding: 7px 11px;
        border-radius: 999px;
        transition: all .25s ease;
        white-space: nowrap;
    }

        .override-btn:hover {
            color: #fff;
            background: #dc2626;
            border-color: #dc2626;
            transform: translateY(-1px);
            box-shadow: 0 6px 15px rgba(220, 38, 38, .18);
        }

    /* ---------- Empty State ---------- */

    .empty-state {
        padding: 65px 20px !important;
        text-align: center;
    }

    .empty-state-icon {
        width: 62px;
        height: 62px;
        margin: 0 auto 15px;
        border-radius: 18px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #f8fafc;
        color: #94a3b8;
        border: 1px solid #e2e8f0;
    }

    .empty-state-title {
        color: #475569;
        font-weight: 700;
        font-size: .86rem;
    }

    .empty-state-text {
        color: #94a3b8;
        font-size: .74rem;
    }

    /* ---------- Modal ---------- */

    .security-modal .modal-content {
        border: 0;
        border-radius: 20px;
        overflow: hidden;
        box-shadow: 0 25px 70px rgba(15, 23, 42, .20);
        animation: scaleIn .25s ease both;
    }

    .security-modal .modal-header {
        position: relative;
        padding: 20px 22px;
        border-bottom: 1px solid #edf0f4;
        background: linear-gradient(135deg, #fff, #fef2f2);
    }

    .modal-warning-icon {
        width: 40px;
        height: 40px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #fee2e2;
        color: #dc2626;
    }

    .security-modal .modal-title {
        font-size: .98rem;
        font-weight: 750;
        color: #1f2937;
    }

    .security-modal .modal-body {
        padding: 22px;
    }

    .security-info {
        padding: 13px 14px;
        border-radius: 12px;
        background: #f8fafc;
        border: 1px solid #edf0f4;
        color: #667085;
        font-size: .74rem;
        line-height: 1.55;
    }

        .security-info i {
            color: #2563eb;
        }

    .field-label {
        color: #475467;
        font-size: .72rem;
        font-weight: 750;
        margin-bottom: 7px;
    }

    .security-modal .form-control {
        min-height: 42px;
        border-radius: 10px;
        border-color: #dfe4ea;
        font-size: .78rem;
        transition: all .2s ease;
        box-shadow: none;
    }

        .security-modal .form-control:focus {
            border-color: #86b7fe;
            box-shadow: 0 0 0 4px rgba(13, 110, 253, .08);
        }

        .security-modal .form-control[readonly] {
            background: #f8fafc;
            color: #64748b;
        }

    .security-modal .modal-footer {
        padding: 15px 22px 20px;
        border-top: 0;
        background: #fff;
    }

    .modal-cancel-btn,
    .modal-apply-btn {
        border-radius: 10px;
        font-size: .76rem;
        font-weight: 700;
        padding: 9px 16px;
    }

    .modal-apply-btn {
        box-shadow: 0 7px 18px rgba(220, 38, 38, .15);
        transition: all .25s ease;
    }

        .modal-apply-btn:hover {
            transform: translateY(-1px);
            box-shadow: 0 10px 23px rgba(220, 38, 38, .22);
        }

    /* ---------- Responsive ---------- */

    @@media (max-width: 991.98px) {
        .sspr-header

    {
        padding: 20px;
    }

    .sspr-subtitle {
        margin-left: 0;
        margin-top: 8px;
    }

    .audit-card-header {
        padding: 18px;
    }

    .audit-table thead th,
    .audit-table tbody td {
        padding-left: 13px;
        padding-right: 13px;
    }

    }

    @@media (max-width: 767.98px) {
        .container-fluid.sspr-page

    {
        padding-top: 18px !important;
    }

    .sspr-header {
        border-radius: 16px;
        padding: 18px;
    }

    .sspr-title {
        font-size: 1.12rem;
    }

    .title-icon {
        width: 38px;
        height: 38px;
        border-radius: 11px;
    }

    .sspr-subtitle {
        font-size: .76rem;
    }

    .kpi-card {
        padding: 17px;
        border-radius: 15px;
    }

    .kpi-icon {
        width: 44px;
        height: 44px;
        border-radius: 13px;
    }

    .kpi-value {
        font-size: 1.35rem;
    }

    .audit-card {
        border-radius: 16px;
    }

    .audit-title {
        font-size: .88rem;
    }

    .audit-description {
        margin-left: 0;
        margin-top: 7px;
    }

    .table-responsive {
        border-radius: 0 0 16px 16px;
    }

    .audit-table {
        min-width: 900px;
    }

    .security-modal .modal-dialog {
        margin: 12px;
    }

    }

    @@media (max-width: 575.98px) {
        .sspr-header

    {
        padding: 16px;
    }

    .sspr-breadcrumb {
        font-size: .70rem;
    }

    .sspr-title {
        align-items: flex-start;
    }

    .title-icon {
        flex-shrink: 0;
    }

    .kpi-card {
        min-height: 94px;
    }

    .audit-card-header {
        padding: 16px;
    }

    .security-modal .modal-body {
        padding: 18px;
    }

    .security-modal .modal-footer {
        padding: 12px 18px 18px;
    }

    }

    /* ---------- Reduced Motion ---------- */

    @@media (prefers-reduced-motion: reduce) {
        .sspr-page, .sspr-header, .kpi-card, .audit-card, .security-alert, .audit-table tbody tr

    {
        animation: none !important;
    }

    *,
    *::before,
    *::after {
        transition-duration: .01ms !important;
    }

    }
</style>

<div class="container-fluid py-4 text-start sspr-page">

    <!-- =====================================================
         HEADER
         ===================================================== -->
    <div class="sspr-header mb-4">
        <nav aria-label="breadcrumb" class="sspr-breadcrumb">
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item">
                    <a href="/Dashboard" class="text-decoration-none">
                        <i class="fa-solid fa-house me-1"></i>Admin Dashboard
                    </a>
                </li>
                <li class="breadcrumb-item">
                    Identity & Security
                </li>
                <li class="breadcrumb-item active" aria-current="page">
                    Password Resets
                </li>
            </ol>
        </nav>

        <div class="d-flex align-items-center mt-2">
            <div class="title-icon">
                <i class="fa-solid fa-shield-halved"></i>
            </div>

            <div>
                <h4 class="fw-bold mb-0 text-dark sspr-title">
                    SSPR Operations & Audit Log
                </h4>
            </div>
        </div>

        <p class="sspr-subtitle mb-0">
            Monitor self-service password resets, audit delivery methods,
            review security activity, and apply emergency administrative overrides.
        </p>
    </div>


    <!-- =====================================================
         SUCCESS ALERT
         ===================================================== -->
    @if (TempData["EmergencySuccess"] != null)
    {
        <div class="alert security-alert py-3 px-3 rounded-4 mb-4 text-start" role="alert">
            <div class="d-flex align-items-center gap-3">
                <div class="security-alert-icon">
                    <i class="fa-solid fa-circle-check text-success"></i>
                </div>

                <div class="flex-grow-1">
                    <div class="fw-bold text-success small mb-0">
                        Security Operation Completed
                    </div>

                    <div class="text-secondary small mt-1">
                        @TempData["EmergencySuccess"]
                    </div>
                </div>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="alert"
                        aria-label="Close">
                </button>
            </div>
        </div>
    }


    <!-- =====================================================
         SECURITY KPI CARDS
         ===================================================== -->
    <div class="row g-3 mb-4">

        <!-- Automated -->
        <div class="col-xl-3 col-md-6">
            <div class="kpi-card">
                <div class="d-flex align-items-center gap-3 position-relative">

                    <div class="kpi-icon success">
                        <i class="fa-solid fa-circle-check fs-5"></i>
                    </div>

                    <div>
                        <div class="kpi-label">
                            Automated Resets
                        </div>

                        <div class="kpi-value">
                            @automatedResets
                            <span class="kpi-status success">
                                Auto-Resolved
                            </span>
                        </div>
                    </div>

                </div>
            </div>
        </div>


        <!-- Admin Overrides -->
        <div class="col-xl-3 col-md-6">
            <div class="kpi-card">
                <div class="d-flex align-items-center gap-3 position-relative">

                    <div class="kpi-icon primary">
                        <i class="fa-solid fa-user-gear fs-5"></i>
                    </div>

                    <div>
                        <div class="kpi-label">
                            Admin Overrides
                        </div>

                        <div class="kpi-value">
                            @manualOverrides
                            <span class="kpi-status primary">
                                Emergency
                            </span>
                        </div>
                    </div>

                </div>
            </div>
        </div>


        <!-- Failed -->
        <div class="col-xl-3 col-md-6">
            <div class="kpi-card">
                <div class="d-flex align-items-center gap-3 position-relative">

                    <div class="kpi-icon danger">
                        <i class="fa-solid fa-hourglass-end fs-5"></i>
                    </div>

                    <div>
                        <div class="kpi-label">
                            Failed & Expired
                        </div>

                        <div class="kpi-value">
                            @failedOrExpired
                            <span class="kpi-status danger">
                                Expired
                            </span>
                        </div>
                    </div>

                </div>
            </div>
        </div>


        <!-- Compliance -->
        <div class="col-xl-3 col-md-6">
            <div class="kpi-card">
                <div class="d-flex align-items-center gap-3 position-relative">

                    <div class="kpi-icon info">
                        <i class="fa-solid fa-circle-nodes fs-5"></i>
                    </div>

                    <div>
                        <div class="kpi-label">
                            SSPR Compliance
                        </div>

                        <div class="kpi-value">
                            @policyCompliance
                            <span class="kpi-status info">
                                Enforced
                            </span>
                        </div>
                    </div>

                </div>
            </div>
        </div>

    </div>


    <!-- =====================================================
         AUDIT LOG CARD
         ===================================================== -->
    <div class="audit-card">

        <!-- Card Header -->
        <div class="audit-card-header">

            <div class="audit-title">
                <div class="audit-title-icon">
                    <i class="fa-solid fa-list-check"></i>
                </div>

                <span>
                    Active Requests & Resets History
                </span>
            </div>

            <div class="audit-description">
                Review password reset requests, delivery channels,
                timestamps, status and emergency override actions.
            </div>

        </div>


        <!-- Table -->
        <div class="table-responsive">

            <table class="table audit-table align-middle text-start">

                <thead>
                    <tr>
                        <th style="width:25%;">
                            Employee Details
                        </th>

                        <th style="width:20%;">
                            Request Type
                        </th>

                        <th style="width:18%;">
                            Requested Timestamp
                        </th>

                        <th style="width:15%;">
                            Delivery Method
                        </th>

                        <th style="width:12%;">
                            Status
                        </th>

                        <th style="width:10%;" class="text-center">
                            Actions
                        </th>
                    </tr>
                </thead>

                <tbody>

                    @if (Model != null && Model.Any())
                    {
                        var rowIndex = 0;

                        @foreach (var r in Model)
                        {
                            rowIndex++;

                            var statusClass = r.Status switch
                            {
                                "Pending" => "status-pending",
                                "Completed" => "status-completed",
                                "Auto-Completed (Self-Service)" => "status-completed",
                                "Manual Override" => "status-manual",
                                "Token Expired" => "status-expired",
                                _ => "status-pending"
                            };

                            var requestType = string.IsNullOrEmpty(r.RequestType)
                            ? "Automated Self-Service"
                            : r.RequestType;

                            var deliveryMethod = string.IsNullOrEmpty(r.DeliveryMethod)
                            ? "Email Magic Link"
                            : r.DeliveryMethod;

                            <tr style="animation-delay:@(Math.Min(rowIndex * 0.04, 0.5))s;">

                                <!-- Employee -->
                                <td>
                                    <div class="d-flex align-items-center">

                                        <div class="employee-avatar me-3">
                                            @r.Username.Substring(
                                            0,
                                                                        Math.Min(2, r.Username.Length)
                                                                        ).ToUpper()
                                </div>

                                        <div>
                                            <div class="employee-name">
                                                @@@r.Username
                                            </div>

                                            <div class="employee-email">
                                                @r.Email
                                            </div>
                                        </div>

                                    </div>
                                </td>


                                <!-- Request Type -->
                                <td>
                                    <span class="request-type">
                                @if (requestType == "Automated Self-Service")
                                        {
                                            <i class="fa-solid fa-robot text-primary me-2"></i>
                                        }
                                        else
                                        {
                                            <i class="fa-solid fa-user-shield text-warning me-2"></i>
                                        }

                                        @requestType
                                    </span>
                                </td>


                                <!-- Timestamp -->
                                <td>
                                    <div class="text-secondary small">
                                        <i class="fa-regular fa-calendar me-1 text-muted"></i>
                                        @r.RequestDate.ToLocalTime().ToString("dd MMM yyyy")
                                    </div>

                                    <div class="text-muted small mt-1">
                                        <i class="fa-regular fa-clock me-1"></i>
                                        @r.RequestDate.ToLocalTime().ToString("hh:mm tt")
                                    </div>
                                </td>


                                <!-- Delivery -->
                                <td>
                                    <span class="delivery-method">
                                        @if (deliveryMethod.Contains("Email"))
                                        {
                                            <i class="fa-solid fa-envelope"></i>
                                        }
                                        else
                                        {
                                            <i class="fa-solid fa-paper-plane"></i>
                                        }

                                        @deliveryMethod
                                    </span>
                                </td>


                                <!-- Status -->
                                <td>
                                    <span class="status-badge @statusClass">
                                        @r.Status
                                    </span>
                                </td>


                                <!-- Action -->
                                <td class="text-center">

                                    <button type="button"
                                            class="override-btn"
                                            onclick="openEmergencyReset(@r.ResetId, '@r.Email')">

                                        <i class="fa-solid fa-triangle-exclamation me-1"></i>
                                        Override

                                    </button>

                                </td>

                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="empty-state">

                                <div class="empty-state-icon">
                                    <i class="fa-solid fa-shield-halved fa-xl"></i>
                                </div>

                                <div class="empty-state-title">
                                    No Password Reset Requests
                                </div>

                                <div class="empty-state-text mt-1">
                                    No password reset activity has been logged yet.
                                </div>

                            </td>
                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>


<!-- =========================================================
     EMERGENCY PASSWORD RESET MODAL
     ========================================================= -->
<div class="modal fade security-modal"
     id="emergencyResetModal"
     tabindex="-1"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content">

            <!-- Modal Header -->
            <div class="modal-header">

                <div class="d-flex align-items-center gap-3">

                    <div class="modal-warning-icon">
                        <i class="fa-solid fa-triangle-exclamation"></i>
                    </div>

                    <div>
                        <h5 class="modal-title mb-0">
                            Emergency Password Override
                        </h5>

                        <div class="text-muted mt-1"
                             style="font-size:.68rem;">
                            Administrative security action
                        </div>
                    </div>

                </div>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Close">
                </button>

            </div>


            <!-- Form -->
            <form action="/AdminUser/EmergencyReset" method="post">

                @Html.AntiForgeryToken()

                <input type="hidden"
                       name="id"
                       id="emergencyResetId" />


                <!-- Modal Body -->
                <div class="modal-body">

                    <div class="security-info mb-4">
                        <i class="fa-solid fa-circle-info me-2"></i>

                        Assign a temporary password to override SSPR.
                        The selected user will be able to sign in immediately
                        using the temporary password.
                    </div>


                    <!-- Target Identity -->
                    <div class="mb-3">

                        <label class="field-label">
                            Target Identity
                        </label>

                        <div class="input-group">

                            <span class="input-group-text bg-light border-end-0">
                                <i class="fa-solid fa-user text-muted"></i>
                            </span>

                            <input type="text"
                                   id="emergencyResetIdentity"
                                   class="form-control border-start-0"
                                   readonly />

                        </div>

                    </div>


                    <!-- Temporary Password -->
                    <div class="mb-2">

                        <label class="field-label">
                            Temporary Password
                        </label>

                        <div class="input-group">

                            <span class="input-group-text bg-light border-end-0">
                                <i class="fa-solid fa-key text-muted"></i>
                            </span>

                            <input type="text"
                                   name="tempPassword"
                                   class="form-control font-monospace border-start-0"
                                   placeholder="Temp987!"
                                   required />

                        </div>

                        <div class="text-muted mt-2"
                             style="font-size:.68rem;">

                            <i class="fa-solid fa-lock me-1"></i>

                            Password must contain uppercase letters,
                            numbers and special characters.

                        </div>

                    </div>

                </div>


                <!-- Modal Footer -->
                <div class="modal-footer">

                    <button type="button"
                            class="btn btn-outline-secondary modal-cancel-btn"
                            data-bs-dismiss="modal">

                        <i class="fa-solid fa-xmark me-1"></i>
                        Cancel

                    </button>

                    <button type="submit"
                            class="btn btn-danger modal-apply-btn">

                        <i class="fa-solid fa-shield-exclamation me-1"></i>
                        Apply Override

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>


<script>
    function openEmergencyReset(id, identity) {

        document.getElementById("emergencyResetId").value = id;

        document.getElementById("emergencyResetIdentity").value = identity;

        const modalElement =
            document.getElementById("emergencyResetModal");

        const modal =
            new bootstrap.Modal(modalElement);

        modal.show();
    }
</script>
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Finance & Accounting Oversight";
}

<div class="container-fluid py-4 text-start">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-bold mb-1"><i class="fa-solid fa-calculator text-primary me-2"></i>Finance & Accounting Oversight</h4>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0 small">
                    <li class="breadcrumb-item"><a href="/SuperAdminDashboard" class="text-decoration-none">Dashboard</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Finance Oversight</li>
                </ol>
            </nav>
        </div>
    </div>

    <!-- Trial Balance Sheet -->
    <div class="bg-white border rounded-3 p-4 shadow-sm mb-4" style="max-width: 600px;">
        <h5 class="fw-bold mb-3">Cross-Branch General Ledger</h5>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" style="font-size: 0.85rem;">
                <thead class="table-light">
                    <tr>
                        <th>Account Class</th>
                        <th>Debit (INR)</th>
                        <th>Credit (INR)</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td class="fw-bold text-dark">Aggregated Liquid Asset Heads</td>
                        <td class="text-success fw-bold">₹12,45,000</td>
                        <td>-</td>
                    </tr>
                    <tr>
                        <td class="fw-bold text-dark">Supplier Liabilities Accounts</td>
                        <td>-</td>
                        <td class="text-danger fw-bold">₹8,12,000</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

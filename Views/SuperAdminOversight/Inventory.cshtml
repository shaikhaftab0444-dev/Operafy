@model IEnumerable<ERP_System.Models.Product>
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Warehouse & Inventory Oversight";
}

<div class="container-fluid py-4 text-start">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-bold mb-1"><i class="fa-solid fa-boxes-stacked text-primary me-2"></i>Warehouse & Inventory Oversight</h4>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0 small">
                    <li class="breadcrumb-item"><a href="/SuperAdminDashboard" class="text-decoration-none">Dashboard</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Inventory Oversight</li>
                </ol>
            </nav>
        </div>
    </div>

    <!-- Consolidated Stock Balance -->
    <div class="bg-white border rounded-3 p-4 shadow-sm mb-4">
        <h5 class="fw-bold mb-3">Consolidated Stock Balance (All Warehouses)</h5>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" style="font-size: 0.85rem;">
                <thead class="table-light">
                    <tr>
                        <th>Item Description</th>
                        <th>Stock Available</th>
                        <th>Sold Qty</th>
                        <th>Aggregate Status</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var p in Model)
                        {
                            <tr>
                                <td class="fw-bold text-dark">@p.ProductName</td>
                                <td>@p.StockQty Units</td>
                                <td>@p.SoldQty Units</td>
                                <td>
                                    @if (p.StockQty > 50)
                                    {
                                        <span class="badge bg-success-subtle text-success">Healthy</span>
                                    }
                                    else if (p.StockQty > 0)
                                    {
                                        <span class="badge bg-warning-subtle text-warning">Low Stock</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger-subtle text-danger">Out of Stock</span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

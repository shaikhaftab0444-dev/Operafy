@model IEnumerable<ERP_System.Models.Lead>
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Sales & CRM Oversight";
}

<div class="container-fluid py-4 text-start">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-bold mb-1"><i class="fa-solid fa-address-book text-primary me-2"></i>Sales & CRM Oversight</h4>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0 small">
                    <li class="breadcrumb-item"><a href="/SuperAdminDashboard" class="text-decoration-none">Dashboard</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Sales Oversight</li>
                </ol>
            </nav>
        </div>
    </div>

    <!-- Leads Table -->
    <div class="bg-white border rounded-3 p-4 shadow-sm mb-4">
        <h5 class="fw-bold mb-3">Global Sales Pipeline</h5>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" style="font-size: 0.85rem;">
                <thead class="table-light">
                    <tr>
                        <th>Contact Name</th>
                        <th>Company</th>
                        <th>Lead Source</th>
                        <th>Pipeline Status</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var l in Model)
                        {
                            <tr>
                                <td class="fw-bold text-dark">@l.ContactName</td>
                                <td>@l.Company</td>
                                <td><span class="badge bg-light text-dark">@l.Source</span></td>
                                <td><span class="badge bg-secondary-subtle text-secondary">@l.Status</span></td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- =========================================
     VOUCHER RESOLUTION & 3-WAY MATCH JAVASCRIPT
     ========================================= -->
<script>
    const inCultureFormat = new Intl.NumberFormat('en-IN', { style: 'currency', currency: 'INR' });

    function inspectThreeWayMatch(flagId, refNo, vendor, poNo, poAmt, grnNo, grnAmt, vendorAmt, varianceAmt, status) {
        document.getElementById('twFlagId').value = flagId;
        document.getElementById('twVendorName').innerText = vendor || 'Registered Vendor';
        document.getElementById('twVoucherRef').innerText = refNo;
        document.getElementById('twPoNumber').innerText = poNo;
        document.getElementById('twPoAmount').innerText = inCultureFormat.format(poAmt);
        document.getElementById('twGrnNumber').innerText = grnNo;
        document.getElementById('twGrnAmount').innerText = inCultureFormat.format(grnAmt);
        document.getElementById('twInvoiceRef').innerText = refNo;
        document.getElementById('twVendorAmount').innerText = inCultureFormat.format(vendorAmt);
        document.getElementById('twVarianceAmount').innerText = inCultureFormat.format(varianceAmt);

        const explanation = varianceAmt > 0 
            ? `Vendor billed amount is higher than verified goods receipt by ${inCultureFormat.format(varianceAmt)}. Verification check flagged.`
            : `All three tiers are in full reconciliation equilibrium.`;
        document.getElementById('twVarianceExplanation').innerText = explanation;

        const actionArea = document.getElementById('twModalActions');
        if (status === 'Pending Review') {
            actionArea.style.display = 'flex';
        } else {
            actionArea.style.display = 'none';
        }

        const modal = new bootstrap.Modal(document.getElementById('threeWayMatchModal'));
        modal.show();
    }

    async function handleFlagAction(id, decision) {
        const promptMsg = decision === 'Cleared'
            ? `Confirm passing voucher #${id}. Enter optional resolution notes:`
            : `Confirm escalating discrepancy #${id} to Chief Compliance Officer. Enter reason:`;

        const notes = prompt(promptMsg, decision === 'Cleared' ? '3-Way Match verified against GRN/PO variance tolerance.' : 'Discrepancy exceeds permissible threshold.');
        if (notes === null) return; // User cancelled prompt

        try {
            const res = await fetch('/Auditor/UpdateFlagStatus', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({
                    flagId: id,
                    decision: decision,
                    resolutionNotes: notes
                })
            });

            const data = await res.json();
            if (data.success) {
                alert(data.message || `Voucher marked as ${decision}.`);
                location.reload();
            } else {
                alert(data.message || "Failed to update voucher status.");
            }
        } catch (e) {
            console.error(e);
            alert("Network error communicating with audit server.");
        }
    }

    function modalAction(decision) {
        const flagId = parseInt(document.getElementById('twFlagId').value);
        if (flagId > 0) {
            handleFlagAction(flagId, decision);
        }
    }

    // Alias for any existing button
    function resolveVoucher(id, status) {
        handleFlagAction(id, status);
    }
</script>
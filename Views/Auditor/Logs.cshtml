@model List<ERP_System.Models.SystemAuditTrail>

@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "System Audit Trails";

    var selectedEntity = ViewBag.SelectedEntity as string ?? "";
    var searchTerm = ViewBag.SearchTerm as string ?? "";

    var totalLogs = Model?.Count ?? 0;
    var approvalLogs = Model?.Count(x => x.ActionType != null && x.ActionType.ToUpper() == "APPROVAL") ?? 0;
    var updateLogs = Model?.Count(x => x.ActionType != null && x.ActionType.ToUpper() == "UPDATE") ?? 0;
    var deleteLogs = Model?.Count(x => x.ActionType != null && x.ActionType.ToUpper() == "DELETE") ?? 0;
}

<style>
    .audit-page {
        background: #f7f9fc;
        min-height: calc(100vh - 70px);
        padding: 28px 0;
    }

    .audit-header-card,
    .audit-summary-card,
    .audit-content-card,
    .audit-filter-card {
        background: #ffffff;
        border: 1px solid #e9eef5;
        border-radius: 18px;
        box-shadow: 0 8px 24px rgba(30, 55, 90, 0.05);
    }

    .audit-header-card {
        padding: 26px 28px;
    }

    .audit-icon-box {
        width: 52px;
        height: 52px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 14px;
        background: #eaf2ff;
        color: #2563eb;
        font-size: 22px;
        flex-shrink: 0;
    }

    .audit-page-title {
        color: #172b4d;
        font-size: 1.45rem;
        font-weight: 700;
        margin-bottom: 6px;
    }

    .audit-page-subtitle {
        color: #7b8798;
        font-size: 0.88rem;
        margin-bottom: 0;
    }

    .audit-breadcrumb {
        margin-bottom: 0;
        padding: 0;
        background: transparent;
    }

        .audit-breadcrumb .breadcrumb-item {
            color: #8a94a6;
            font-size: 0.78rem;
        }

            .audit-breadcrumb .breadcrumb-item a {
                color: #2563eb;
                text-decoration: none;
                font-weight: 500;
            }

            .audit-breadcrumb .breadcrumb-item.active {
                color: #8a94a6;
            }

    .audit-back-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        border: 1px solid #dfe5ec;
        background: #ffffff;
        color: #667085;
        border-radius: 10px;
        padding: 11px 17px;
        font-size: 0.82rem;
        font-weight: 600;
        text-decoration: none;
        transition: all 0.2s ease;
    }

        .audit-back-btn:hover {
            background: #f8fafc;
            border-color: #cbd5e1;
            color: #344054;
            transform: translateY(-1px);
        }

    .audit-summary-card {
        height: 100%;
        padding: 20px;
    }

    .audit-summary-icon {
        width: 44px;
        height: 44px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 12px;
        font-size: 18px;
        flex-shrink: 0;
    }

        .audit-summary-icon.blue {
            background: #eaf2ff;
            color: #2563eb;
        }

        .audit-summary-icon.green {
            background: #e9f8ef;
            color: #16a34a;
        }

        .audit-summary-icon.orange {
            background: #fff4df;
            color: #d97706;
        }

        .audit-summary-icon.red {
            background: #ffeded;
            color: #dc2626;
        }

    .audit-summary-label {
        color: #8a94a6;
        font-size: 0.78rem;
        font-weight: 500;
        margin-bottom: 5px;
    }

    .audit-summary-value {
        color: #172b4d;
        font-size: 1.45rem;
        font-weight: 700;
        margin-bottom: 0;
    }

    .audit-summary-description {
        color: #98a2b3;
        font-size: 0.76rem;
        margin-top: 14px;
        margin-bottom: 0;
    }

    .audit-filter-card {
        padding: 20px;
    }

    .audit-filter-title {
        color: #172b4d;
        font-size: 0.95rem;
        font-weight: 700;
        margin-bottom: 3px;
    }

    .audit-filter-subtitle {
        color: #8a94a6;
        font-size: 0.76rem;
        margin-bottom: 0;
    }

    .audit-form-label {
        color: #667085;
        font-size: 0.74rem;
        font-weight: 600;
        margin-bottom: 6px;
    }

    .audit-input-group .input-group-text {
        background: #ffffff;
        border: 1px solid #dfe5ec;
        border-right: 0;
        color: #98a2b3;
        border-radius: 10px 0 0 10px;
    }

    .audit-input-group .form-control {
        border: 1px solid #dfe5ec;
        border-left: 0;
        border-radius: 0 10px 10px 0;
        color: #344054;
        font-size: 0.8rem;
        min-height: 40px;
        box-shadow: none;
    }

        .audit-input-group .form-control:focus {
            border-color: #93b4f8;
            box-shadow: none;
        }

    .audit-select {
        border: 1px solid #dfe5ec;
        border-radius: 10px;
        color: #344054;
        font-size: 0.8rem;
        min-height: 40px;
        box-shadow: none;
    }

        .audit-select:focus {
            border-color: #93b4f8;
            box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.10);
        }

    .audit-filter-btn {
        border: none;
        background: #2563eb;
        color: #ffffff;
        border-radius: 10px;
        padding: 10px 17px;
        font-size: 0.8rem;
        font-weight: 600;
        min-height: 40px;
        transition: all 0.2s ease;
    }

        .audit-filter-btn:hover {
            background: #1d4ed8;
            color: #ffffff;
            transform: translateY(-1px);
        }

    .audit-reset-btn {
        border: 1px solid #dfe5ec;
        background: #ffffff;
        color: #667085;
        border-radius: 10px;
        padding: 10px 17px;
        font-size: 0.8rem;
        font-weight: 600;
        min-height: 40px;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }

        .audit-reset-btn:hover {
            background: #f8fafc;
            color: #344054;
            border-color: #cbd5e1;
        }

    .audit-content-card {
        overflow: hidden;
    }

    .audit-card-header {
        padding: 24px 28px;
        border-bottom: 1px solid #edf0f5;
    }

    .audit-section-title {
        color: #172b4d;
        font-size: 1.05rem;
        font-weight: 700;
        margin-bottom: 5px;
    }

    .audit-section-subtitle {
        color: #8a94a6;
        font-size: 0.8rem;
        margin-bottom: 0;
    }

    .audit-record-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: #eaf2ff;
        color: #2563eb;
        border-radius: 30px;
        padding: 8px 13px;
        font-size: 0.74rem;
        font-weight: 600;
        white-space: nowrap;
    }

    .audit-table-wrapper {
        border: 1px solid #edf0f5;
        border-radius: 14px;
        overflow: hidden;
    }

    .audit-table {
        min-width: 1200px;
        margin-bottom: 0;
    }

        .audit-table thead th {
            background: #f8fafc;
            color: #667085;
            border-bottom: 1px solid #e8edf3;
            font-size: 0.73rem;
            font-weight: 700;
            letter-spacing: 0.03em;
            padding: 15px 16px;
            white-space: nowrap;
            text-transform: uppercase;
        }

        .audit-table tbody td {
            color: #475467;
            border-bottom: 1px solid #f0f2f6;
            font-size: 0.8rem;
            padding: 16px;
            vertical-align: middle;
        }

        .audit-table tbody tr:last-child td {
            border-bottom: none;
        }

        .audit-table tbody tr:hover {
            background: #fbfdff;
        }

    .audit-log-id {
        color: #8a94a6;
        font-weight: 700;
    }

    .audit-timestamp {
        color: #8a94a6;
        white-space: nowrap;
        font-family: Consolas, "Courier New", monospace;
        font-size: 0.75rem;
    }

    .audit-entity {
        display: inline-flex;
        align-items: center;
        border-radius: 8px;
        background: #f1f5f9;
        color: #475467;
        border: 1px solid #e2e8f0;
        padding: 6px 9px;
        font-size: 0.72rem;
        font-weight: 600;
        white-space: nowrap;
    }

    .audit-record-id {
        color: #172b4d;
        font-weight: 700;
        white-space: nowrap;
    }

    .audit-action {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        border-radius: 30px;
        padding: 6px 10px;
        font-size: 0.69rem;
        font-weight: 700;
        white-space: nowrap;
    }

        .audit-action.approval {
            background: #e9f8ef;
            color: #16803c;
        }

        .audit-action.update {
            background: #fff4df;
            color: #b76b00;
        }

        .audit-action.delete {
            background: #ffeded;
            color: #c62828;
        }

        .audit-action.create {
            background: #eaf2ff;
            color: #2563eb;
        }

    .audit-summary {
        color: #475467;
        line-height: 1.5;
        max-width: 320px;
    }

    .audit-user {
        display: inline-flex;
        align-items: center;
        color: #475467;
        white-space: nowrap;
    }

        .audit-user i {
            color: #98a2b3;
        }

    .audit-ip {
        color: #8a94a6;
        font-family: Consolas, "Courier New", monospace;
        font-size: 0.74rem;
        white-space: nowrap;
    }

    .audit-empty-state {
        padding: 55px 20px !important;
        text-align: center;
    }

    .audit-empty-icon {
        width: 70px;
        height: 70px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        background: #f1f5f9;
        color: #94a3b8;
        font-size: 28px;
        margin-bottom: 16px;
    }

    .audit-empty-title {
        color: #172b4d;
        font-size: 1rem;
        font-weight: 700;
        margin-bottom: 7px;
    }

    .audit-empty-description {
        color: #8a94a6;
        font-size: 0.82rem;
        margin-bottom: 0;
    }

    .audit-card-footer {
        padding: 16px 28px;
        border-top: 1px solid #edf0f5;
        background: #ffffff;
    }

    .audit-footer-text {
        color: #98a2b3;
        font-size: 0.76rem;
    }

    @@media (max-width: 991.98px) {
        .audit-header-actions

    {
        width: 100%;
    }

    .audit-back-btn {
        width: 100%;
    }

    }

    @@media (max-width: 767.98px) {
        .audit-page

    {
        padding: 18px 0;
    }

    .audit-header-card {
        padding: 20px;
    }

    .audit-card-header {
        padding: 20px;
    }

    .audit-card-footer {
        padding: 15px 20px;
    }

    .audit-page-title {
        font-size: 1.2rem;
    }

    .audit-summary-card {
        padding: 16px;
    }

    .audit-filter-card {
        padding: 16px;
    }

    .audit-table-wrapper {
        border-radius: 12px;
    }

    }
</style>

<div class="container-fluid audit-page text-start">
    <div class="container-fluid px-0">

        <!-- Page Header -->
        <div class="audit-header-card mb-4">
            <div class="row align-items-center g-3">

                <div class="col-lg-8">
                    <div class="d-flex align-items-center">
                        <div class="audit-icon-box me-3">
                            <i class="fa-solid fa-fingerprint"></i>
                        </div>

                        <div>
                            <h4 class="audit-page-title">
                                System Audit Trails &amp; Mutation Logs
                            </h4>

                            <p class="audit-page-subtitle">
                                Immutable record of entity creation, status overrides, voucher approvals, and data edits.
                            </p>

                            <nav aria-label="breadcrumb" class="mt-2">
                                <ol class="breadcrumb audit-breadcrumb">
                                    <li class="breadcrumb-item">
                                        <a href="@Url.Action("Index", "Auditor")">
                                            Auditor Center
                                        </a>
                                    </li>

                                    <li class="breadcrumb-item active" aria-current="page">
                                        System Audit Trails
                                    </li>
                                </ol>
                            </nav>
                        </div>
                    </div>
                </div>

                <div class="col-lg-4">
                    <div class="d-flex justify-content-lg-end audit-header-actions">
                        <a href="@Url.Action("Index", "Auditor")"
                           class="audit-back-btn">
                            <i class="fa-solid fa-arrow-left"></i>
                            Back to Dashboard
                        </a>
                    </div>
                </div>

            </div>
        </div>

        <!-- Summary Cards -->
        <div class="row g-4 mb-4">

            <div class="col-12 col-sm-6 col-xl-3">
                <div class="audit-summary-card">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <p class="audit-summary-label">
                                Total Logs
                            </p>

                            <h4 class="audit-summary-value">
                                @totalLogs
                            </h4>
                        </div>

                        <div class="audit-summary-icon blue">
                            <i class="fa-solid fa-database"></i>
                        </div>
                    </div>

                    <p class="audit-summary-description">
                        Audit records currently available
                    </p>
                </div>
            </div>

            <div class="col-12 col-sm-6 col-xl-3">
                <div class="audit-summary-card">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <p class="audit-summary-label">
                                Approvals
                            </p>

                            <h4 class="audit-summary-value">
                                @approvalLogs
                            </h4>
                        </div>

                        <div class="audit-summary-icon green">
                            <i class="fa-solid fa-circle-check"></i>
                        </div>
                    </div>

                    <p class="audit-summary-description">
                        Approval actions recorded
                    </p>
                </div>
            </div>

            <div class="col-12 col-sm-6 col-xl-3">
                <div class="audit-summary-card">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <p class="audit-summary-label">
                                Updates
                            </p>

                            <h4 class="audit-summary-value">
                                @updateLogs
                            </h4>
                        </div>

                        <div class="audit-summary-icon orange">
                            <i class="fa-solid fa-pen-to-square"></i>
                        </div>
                    </div>

                    <p class="audit-summary-description">
                        Data modification actions
                    </p>
                </div>
            </div>

            <div class="col-12 col-sm-6 col-xl-3">
                <div class="audit-summary-card">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <p class="audit-summary-label">
                                Deletions
                            </p>

                            <h4 class="audit-summary-value">
                                @deleteLogs
                            </h4>
                        </div>

                        <div class="audit-summary-icon red">
                            <i class="fa-solid fa-trash-can"></i>
                        </div>
                    </div>

                    <p class="audit-summary-description">
                        Delete actions recorded
                    </p>
                </div>
            </div>

        </div>

        <!-- Filters -->
        <div class="audit-filter-card mb-4">

            <div class="mb-3">
                <h5 class="audit-filter-title">
                    <i class="fa-solid fa-filter text-primary me-2"></i>
                    Audit Log Filters
                </h5>

                <p class="audit-filter-subtitle">
                    Search and filter system audit records by entity or activity.
                </p>
            </div>

            <form method="get"
                  action="@Url.Action("Logs", "Auditor")"
                  class="row g-3 align-items-end">

                <div class="col-12 col-lg-5">
                    <label class="audit-form-label">
                        Search Audit Records
                    </label>

                    <div class="input-group audit-input-group">
                        <span class="input-group-text">
                            <i class="fa-solid fa-magnifying-glass"></i>
                        </span>

                        <input type="text"
                               name="search"
                               class="form-control"
                               placeholder="Search by Record ID, summary, or action..."
                               value="@searchTerm" />
                    </div>
                </div>

                <div class="col-12 col-md-6 col-lg-3">
                    <label class="audit-form-label">
                        Entity
                    </label>

                    <select name="entity" class="form-select audit-select">
                        <option value="" selected="@(string.IsNullOrEmpty(selectedEntity))">
                            All Entities
                        </option>

                        <option value="GeneralLedger" selected="@(selectedEntity == "GeneralLedger")">
                            General Ledger
                        </option>

                        <option value="PurchaseOrder" selected="@(selectedEntity == "PurchaseOrder")">
                            Purchase Order
                        </option>

                        <option value="Employee" selected="@(selectedEntity == "Employee")">
                            Employee Master
                        </option>

                        <option value="StockAdjustment" selected="@(selectedEntity == "StockAdjustment")">
                            Stock Adjustment
                        </option>

                        <option value="SalesInvoice" selected="@(selectedEntity == "SalesInvoice")">
                            Sales Invoice
                        </option>

                        <option value="VendorMaster" selected="@(selectedEntity == "VendorMaster")">
                            Vendor Master
                        </option>

                        <option value="AuditFlaggedItem" selected="@(selectedEntity == "AuditFlaggedItem")">
                            Audit Flag Resolution
                        </option>
                    </select>
                </div>

                <div class="col-12 col-md-6 col-lg-auto">
                    <div class="d-flex flex-wrap gap-2">
                        <button type="submit"
                                class="audit-filter-btn">
                            <i class="fa-solid fa-filter me-1"></i>
                            Filter
                        </button>

                        <a href="@Url.Action("Logs", "Auditor")"
                           class="audit-reset-btn">
                            Reset
                        </a>
                    </div>
                </div>

            </form>
        </div>

        <!-- Audit Logs -->
        <div class="audit-content-card">

            <!-- Card Header -->
            <div class="audit-card-header">
                <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3">

                    <div>
                        <h5 class="audit-section-title">
                            <i class="fa-solid fa-list-check text-primary me-2"></i>
                            Audit Log Entries
                        </h5>

                        <p class="audit-section-subtitle">
                            Review system activity, entity mutations, approvals, updates, and other recorded actions.
                        </p>
                    </div>

                    <div>
                        <span class="audit-record-badge">
                            <i class="fa-solid fa-database"></i>
                            @totalLogs Records
                        </span>
                    </div>

                </div>
            </div>

            <!-- Audit Table -->
            <div class="p-3 p-md-4">

                @if (Model != null && Model.Any())
                {
                    <div class="table-responsive audit-table-wrapper">

                        <table class="table table-hover align-middle audit-table">

                            <thead>
                                <tr>
                                    <th style="width: 80px;">
                                        Log ID
                                    </th>

                                    <th>
                                        Timestamp (UTC)
                                    </th>

                                    <th>
                                        Entity
                                    </th>

                                    <th>
                                        Record ID
                                    </th>

                                    <th>
                                        Action
                                    </th>

                                    <th>
                                        Changes Summary
                                    </th>

                                    <th>
                                        Performed By
                                    </th>

                                    <th>
                                        IP Address
                                    </th>
                                </tr>
                            </thead>

                            <tbody>

                                @foreach (var log in Model)
                                {
                                    <tr>

                                        <!-- Log ID -->
                                        <td>
                                            <span class="audit-log-id">
                                                #@log.Id
                                            </span>
                                        </td>

                                        <!-- Timestamp -->
                                        <td>
                                            <span class="audit-timestamp">
                                                @log.Timestamp.ToString("yyyy-MM-dd HH:mm:ss")
                                            </span>
                                        </td>

                                        <!-- Entity -->
                                        <td>
                                            <span class="audit-entity">
                                                @log.EntityName
                                            </span>
                                        </td>

                                        <!-- Record ID -->
                                        <td>
                                            <span class="audit-record-id">
                                                @log.RecordId
                                            </span>
                                        </td>

                                        <!-- Action -->
                                        <td>

                                            @if (log.ActionType != null &&
                                                                                log.ActionType.ToUpper() == "APPROVAL")
                                            {
                                                <span class="audit-action approval">
                                                    <i class="fa-solid fa-circle-check"></i>
                                                    APPROVAL
                                                </span>
                                            }
                                            else if (log.ActionType != null &&
                                            log.ActionType.ToUpper() == "UPDATE")
                                            {
                                                <span class="audit-action update">
                                                    <i class="fa-solid fa-pen"></i>
                                                    UPDATE
                                                </span>
                                            }
                                            else if (log.ActionType != null &&
                                            log.ActionType.ToUpper() == "DELETE")
                                            {
                                                <span class="audit-action delete">
                                                    <i class="fa-solid fa-trash-can"></i>
                                                    DELETE
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="audit-action create">
                                                    <i class="fa-solid fa-plus"></i>
                                                    CREATE
                                                </span>
                                            }

                                    </td>

                                    <!-- Changes Summary -->
                                    <td>
                                        <span class="audit-summary">
                                            @log.ChangesSummary
                                        </span>
                                    </td>

                                    <!-- Performed By -->
                                    <td>
                                        <span class="audit-user">
                                            <i class="fa-solid fa-user-shield me-2"></i>

                                            @(log.PerformedByUser?.FullName
                                                                                    ?? log.PerformedByUserId
                                                                                    ?? "System")
                                    </span>
                                </td>

                                        <!-- IP Address -->
                                        <td>
                                            <span class="audit-ip">
                                                @log.IpAddress
                                            </span>
                                        </td>

                                    </tr>
                                                        }

                            </tbody>

                        </table>

                    </div>
                }
                else
                {
                    <div class="audit-empty-state">

                        <div class="audit-empty-icon">
                            <i class="fa-solid fa-magnifying-glass"></i>
                        </div>

                        <h5 class="audit-empty-title">
                            No Audit Logs Found
                        </h5>

                        <p class="audit-empty-description">
                            No audit log entries matching the selected criteria were found.
                        </p>

                    </div>
                }

            </div>

            <!-- Card Footer -->
            <div class="audit-card-footer">
                <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-2">

                    <span class="audit-footer-text">
                        Showing @totalLogs audit records
                    </span>

                    <span class="audit-footer-text">
                        <i class="fa-solid fa-shield-halved me-1"></i>
                        Immutable system activity records
                    </span>

                </div>
            </div>

        </div>

    </div>
</div>
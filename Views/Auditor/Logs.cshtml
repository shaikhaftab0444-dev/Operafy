@model List<ERP_System.Models.SystemAuditTrail>
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "System Audit Trails";
    var selectedEntity = ViewBag.SelectedEntity as string ?? "";
    var searchTerm = ViewBag.SearchTerm as string ?? "";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-4">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-1 small">
                <li class="breadcrumb-item"><a href="@Url.Action("Index", "Auditor")" class="text-decoration-none">Auditor Center</a></li>
                <li class="breadcrumb-item active" aria-current="page">System Audit Trails</li>
            </ol>
        </nav>
        <h4 class="fw-bold mb-0 text-dark">
            <i class="fa fa-fingerprint text-primary me-2"></i>System Audit Trails & Mutation Logs
        </h4>
        <p class="text-muted small mb-0">Immutable record of entity creation, status overrides, voucher approvals, and data edits.</p>
    </div>
    <div class="d-flex gap-2">
        <a href="@Url.Action("Index", "Auditor")" class="btn btn-outline-secondary btn-sm px-3">
            <i class="fa fa-arrow-left me-1"></i> Back to Dashboard
        </a>
    </div>
</div>

<!-- Filters Bar -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-body p-3">
        <form method="get" action="@Url.Action("Logs", "Auditor")" class="row g-2 align-items-center">
            <div class="col-md-4">
                <div class="input-group input-group-sm">
                    <span class="input-group-text bg-white"><i class="fa fa-search text-muted"></i></span>
                    <input type="text" name="search" class="form-control" placeholder="Search by Record ID, summary, or action..." value="@searchTerm" />
                </div>
            </div>
            <div class="col-md-3">
                <select name="entity" class="form-select form-select-sm">
                    <option value="" selected="@(string.IsNullOrEmpty(selectedEntity))">All Entities</option>
                    <option value="GeneralLedger" selected="@(selectedEntity == "GeneralLedger")">General Ledger</option>
                    <option value="PurchaseOrder" selected="@(selectedEntity == "PurchaseOrder")">Purchase Order</option>
                    <option value="Employee" selected="@(selectedEntity == "Employee")">Employee Master</option>
                    <option value="StockAdjustment" selected="@(selectedEntity == "StockAdjustment")">Stock Adjustment</option>
                    <option value="SalesInvoice" selected="@(selectedEntity == "SalesInvoice")">Sales Invoice</option>
                    <option value="VendorMaster" selected="@(selectedEntity == "VendorMaster")">Vendor Master</option>
                    <option value="AuditFlaggedItem" selected="@(selectedEntity == "AuditFlaggedItem")">Audit Flag Resolution</option>
                </select>
            </div>
            <div class="col-md-auto">
                <button type="submit" class="btn btn-sm btn-primary px-3">
                    <i class="fa fa-filter me-1"></i> Filter
                </button>
                <a href="@Url.Action("Logs", "Auditor")" class="btn btn-sm btn-light border px-3">
                    Reset
                </a>
            </div>
        </form>
    </div>
</div>

<!-- Audit Logs Table -->
<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" style="font-size: 0.84rem;">
                <thead class="table-light">
                    <tr>
                        <th style="width: 80px;">Log ID</th>
                        <th>Timestamp (UTC)</th>
                        <th>Entity</th>
                        <th>Record ID</th>
                        <th>Action</th>
                        <th>Changes Summary</th>
                        <th>Performed By</th>
                        <th>IP Address</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var log in Model)
                        {
                            <tr>
                                <td class="text-muted fw-bold">#@log.Id</td>
                                <td class="text-nowrap text-muted small">
                                    @log.Timestamp.ToString("yyyy-MM-dd HH:mm:ss")
                                </td>
                                <td>
                                    <span class="badge bg-light text-dark border">
                                        @log.EntityName
                                    </span>
                                </td>
                                <td class="fw-bold text-dark text-nowrap">@log.RecordId</td>
                                <td>
                                    @if (log.ActionType.ToUpper() == "APPROVAL")
                                    {
                                        <span class="badge bg-success-subtle text-success px-2 py-0.5">APPROVAL</span>
                                    }
                                    else if (log.ActionType.ToUpper() == "UPDATE")
                                    {
                                        <span class="badge bg-warning-subtle text-warning px-2 py-0.5">UPDATE</span>
                                    }
                                    else if (log.ActionType.ToUpper() == "DELETE")
                                    {
                                        <span class="badge bg-danger-subtle text-danger px-2 py-0.5">DELETE</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-primary-subtle text-primary px-2 py-0.5">CREATE</span>
                                    }
                                </td>
                                <td style="max-width: 320px;">
                                    <span class="text-dark">@log.ChangesSummary</span>
                                </td>
                                <td class="text-nowrap">
                                    <i class="fa fa-user-shield text-secondary me-1"></i>
                                    @(log.PerformedByUser?.FullName ?? log.PerformedByUserId ?? "System")
                                </td>
                                <td class="text-muted font-monospace small">@log.IpAddress</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="text-center py-5 text-muted">
                                <i class="fa fa-magnifying-glass fs-3 d-block mb-2 text-secondary"></i>
                                No audit log entries matching criteria found.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

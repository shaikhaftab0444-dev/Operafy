@model IEnumerable<ERP_System.Models.InvScrapWriteOff>
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Scrap & Damage Write-Offs";
}

<div class="container-fluid py-4 text-start">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-bold mb-1"><i class="fa-solid fa-trash-can text-primary me-2"></i>Scrap & Damage Write-Offs</h4>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0 small">
                    <li class="breadcrumb-item"><a href="/InventoryDashboard" class="text-decoration-none">Inventory Dashboard</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Scrap Write-Offs</li>
                </ol>
            </nav>
        </div>
        <button class="btn btn-primary rounded-pill px-3 btn-sm shadow-sm" data-bs-toggle="modal" data-bs-target="#scrapModal">
            <i class="fa-solid fa-plus me-1.5"></i>Log Scrap Item
        </button>
    </div>

    <!-- Scrap List -->
    <div class="bg-white border rounded-3 p-4 shadow-sm">
        <h5 class="fw-bold mb-3">Scrap Logs</h5>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" style="font-size: 0.85rem;">
                <thead class="table-light">
                    <tr>
                        <th>Scrap Ticket No</th>
                        <th>Item Name</th>
                        <th>Qty Scrapped</th>
                        <th>Reason for Scrap</th>
                        <th>Write-Off Date</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var s in Model)
                        {
                            <tr>
                                <td class="fw-bold text-dark">@s.ScrapNo</td>
                                <td>@s.ItemName</td>
                                <td class="text-danger fw-bold">@s.QtyScrapped Units</td>
                                <td class="text-muted">@s.Reason</td>
                                <td class="text-muted">@s.WriteOffDate.ToString("dd MMM yyyy")</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center py-4 text-muted">No scrap records found in database.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Scrap Modal -->
<div class="modal fade text-start" id="scrapModal" tabindex="-1" aria-labelledby="scrapModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form action="/InvAudits/CreateScrapWriteOff" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title fw-bold" id="scrapModalLabel">Write-Off Scrap / Damaged Item</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Item Name</label>
                        <input type="text" name="ItemName" class="form-control" placeholder="e.g. Broken Dell Monitor" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Quantity Scrapped</label>
                        <input type="number" name="QtyScrapped" class="form-control" placeholder="e.g. 5" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Reason for Scrap</label>
                        <textarea name="Reason" class="form-control" rows="3" placeholder="e.g. Cracked screen / Water damage" required></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary rounded-pill px-3 btn-sm" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary rounded-pill px-3 btn-sm">Write-Off Item</button>
                </div>
            </form>
        </div>
    </div>
</div>

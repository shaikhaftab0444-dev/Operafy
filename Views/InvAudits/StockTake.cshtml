@model IEnumerable<ERP_System.Models.InvStockAudit>
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Physical Stock Take (Stock Audit)";
}

<div class="container-fluid py-4 text-start">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-bold mb-1"><i class="fa-solid fa-clipboard-check text-primary me-2"></i>Physical Stock Take (Stock Audit)</h4>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0 small">
                    <li class="breadcrumb-item"><a href="/InventoryDashboard" class="text-decoration-none">Inventory Dashboard</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Stock Audit</li>
                </ol>
            </nav>
        </div>
        <button class="btn btn-primary rounded-pill px-3 btn-sm shadow-sm" data-bs-toggle="modal" data-bs-target="#auditModal">
            <i class="fa-solid fa-plus me-1.5"></i>Log New Audit
        </button>
    </div>

    <!-- Audits List -->
    <div class="bg-white border rounded-3 p-4 shadow-sm">
        <h5 class="fw-bold mb-3">Audit Logs</h5>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" style="font-size: 0.85rem;">
                <thead class="table-light">
                    <tr>
                        <th>Audit Number</th>
                        <th>Audit Date</th>
                        <th>Auditor Name</th>
                        <th>Discrepancy Found</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var a in Model)
                        {
                            <tr>
                                <td class="fw-bold text-dark">@a.AuditNo</td>
                                <td class="text-muted">@a.AuditDate.ToString("dd MMM yyyy")</td>
                                <td>@a.AuditorName</td>
                                <td>
                                    @if (a.DiscrepancyFound)
                                    {
                                        <span class="text-danger fw-bold"><i class="fa-solid fa-triangle-exclamation me-1"></i>Yes</span>
                                    }
                                    else
                                    {
                                        <span class="text-success fw-bold"><i class="fa-solid fa-circle-check me-1"></i>No</span>
                                    }
                                </td>
                                <td>
                                    @if (a.Status == "Reconciled")
                                    {
                                        <span class="badge bg-success-subtle text-success rounded-pill px-2.5 py-1">Reconciled</span>
                                    }
                                    else if (a.Status == "Pending Review")
                                    {
                                        <span class="badge bg-warning-subtle text-warning rounded-pill px-2.5 py-1">Pending Review</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary rounded-pill px-2.5 py-1">Draft</span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center py-4 text-muted">No stock audits logged.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Audit Modal -->
<div class="modal fade text-start" id="auditModal" tabindex="-1" aria-labelledby="auditModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form action="/InvAudits/CreateAudit" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title fw-bold" id="auditModalLabel">Log Stock Audit</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Auditor Name</label>
                        <input type="text" name="AuditorName" class="form-control" placeholder="e.g. Sarah Jenkins" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Discrepancy Found</label>
                        <select name="DiscrepancyFound" class="form-select">
                            <option value="false">No Discrepancies</option>
                            <option value="true">Discrepancies Detected</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary rounded-pill px-3 btn-sm" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary rounded-pill px-3 btn-sm">Log Audit</button>
                </div>
            </form>
        </div>
    </div>
</div>

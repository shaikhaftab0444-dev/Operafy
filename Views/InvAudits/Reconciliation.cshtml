@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Stock Reconciliation";
}

<div class="container-fluid py-4 text-start">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-bold mb-1"><i class="fa-solid fa-scale-unbalanced text-primary me-2"></i>Stock Reconciliation</h4>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0 small">
                    <li class="breadcrumb-item"><a href="/InventoryDashboard" class="text-decoration-none">Inventory Dashboard</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Reconciliation</li>
                </ol>
            </nav>
        </div>
    </div>

    <!-- Reconciliation Table -->
    <div class="bg-white border rounded-3 p-4 shadow-sm">
        <h5 class="fw-bold mb-3">Discrepancy Corrections</h5>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" style="font-size: 0.85rem;">
                <thead class="table-light">
                    <tr>
                        <th>Item Name</th>
                        <th>System Qty</th>
                        <th>Physical Qty Counted</th>
                        <th>Variance</th>
                        <th>Adjustment Applied</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td class="fw-bold text-dark">Dell Wired Keyboard</td>
                        <td>125 Units</td>
                        <td>120 Units</td>
                        <td class="text-danger fw-bold">-5 Units</td>
                        <td>-5 Units (Scrapped)</td>
                        <td><span class="badge bg-success-subtle text-success">Reconciled</span></td>
                    </tr>
                    <tr>
                        <td class="fw-bold text-dark">Logitech Wireless Mouse</td>
                        <td>80 Units</td>
                        <td>85 Units</td>
                        <td class="text-success fw-bold">+5 Units</td>
                        <td>+5 Units (Found Surplus)</td>
                        <td><span class="badge bg-success-subtle text-success">Reconciled</span></td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

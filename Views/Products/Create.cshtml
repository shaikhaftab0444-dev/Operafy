@model ERP_System.Models.Product
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Add New Product";
}

<style>
    .panel-form {
        background: #ffffff;
        border: 1px solid var(--border-warm);
        border-radius: 12px;
        box-shadow: 0 1px 3px rgba(45,37,30,0.03);
        padding: 2.5rem;
        max-width: 600px;
        margin: 0 auto;
    }

    .form-label-warm {
        font-size: 0.8rem;
        font-weight: 700;
        color: var(--text-color);
        margin-bottom: 6px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .input-group-warm {
        border: 1px solid #d4cbbd;
        border-radius: 8px;
        background-color: #fcfbfa;
        transition: all 0.2s ease-in-out;
        overflow: hidden;
        display: flex;
        align-items: center;
        width: 100%;
    }
    .input-group-warm:focus-within {
        border-color: var(--primary-warm);
        box-shadow: 0 0 0 4px rgba(79, 70, 229, 0.08);
        background-color: #ffffff;
    }

    .input-icon-warm {
        padding: 0.75rem 0.25rem 0.75rem 1rem;
        color: var(--sidebar-color);
        font-size: 0.95rem;
        display: flex;
        align-items: center;
    }

    .form-control-warm {
        border: none !important;
        box-shadow: none !important;
        background: transparent !important;
        color: var(--text-color) !important;
        font-size: 0.9rem !important;
        padding: 0.75rem 1rem !important;
        width: 100%;
    }
    .form-control-warm::placeholder {
        color: #a3988b;
    }

    .btn-primary-warm {
        background: linear-gradient(135deg, var(--primary-warm) 0%, #6366f1 100%);
        color: #ffffff;
        border: none;
        padding: 0.75rem 2rem;
        border-radius: 8px;
        font-weight: 600;
        font-size: 0.9rem;
        box-shadow: 0 4px 10px rgba(79, 70, 229, 0.2);
        transition: all 0.2s;
    }
    .btn-primary-warm:hover {
        transform: translateY(-1px);
        box-shadow: 0 6px 14px rgba(79, 70, 229, 0.3);
        color: #ffffff;
    }

    .btn-secondary-warm {
        border: 1px solid var(--border-warm);
        background-color: #ffffff;
        color: var(--text-color);
        padding: 0.75rem 2rem;
        border-radius: 8px;
        font-weight: 600;
        font-size: 0.9rem;
        transition: all 0.2s;
    }
    .btn-secondary-warm:hover {
        background-color: #faf8f5;
        border-color: #cbd5e1;
    }

    .text-danger-custom {
        color: #dc2626;
        font-size: 0.8rem;
        margin-top: 4px;
        font-weight: 500;
    }
</style>

<!-- Breadcrumbs & Header -->
<div class="mb-4 text-center">
    <h4 class="fw-bold mb-1" style="color: var(--text-color);">Add New Product Inventory</h4>
    <nav aria-label="breadcrumb" class="d-inline-block">
        <ol class="breadcrumb mb-0 small">
            <li class="breadcrumb-item"><a href="/Dashboard" class="text-decoration-none">Dashboard</a></li>
            <li class="breadcrumb-item"><a href="/Products" class="text-decoration-none">Products</a></li>
            <li class="breadcrumb-item active" aria-current="page">Add New</li>
        </ol>
    </nav>
</div>

<!-- Form Card -->
<div class="panel-form">
    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()
        
        <div asp-validation-summary="ModelOnly" class="text-danger-custom mb-3 text-start"></div>

        <!-- Product Name -->
        <div class="mb-3 text-start">
            <label asp-for="ProductName" class="form-label-warm">Product Name</label>
            <div class="input-group-warm">
                <span class="input-icon-warm">
                    <i class="fa-solid fa-box-open"></i>
                </span>
                <input asp-for="ProductName" class="form-control-warm" placeholder="Enter product name..." required />
            </div>
            <span asp-validation-for="ProductName" class="text-danger-custom d-block"></span>
        </div>

        <!-- Branch Location -->
        <div class="mb-3 text-start">
            <label asp-for="BranchId" class="form-label-warm">Branch Location</label>
            <div class="input-group-warm" style="border: 1px solid #d4cbbd; border-radius: 8px; background-color: #fcfbfa; padding: 2px;">
                <span class="input-icon-warm"><i class="fa-solid fa-code-fork"></i></span>
                <select asp-for="BranchId" class="form-select" style="border: none !important; box-shadow: none !important; font-size: 0.9rem; padding: 0.6rem 1rem;" required>
                    @foreach (var branch in (IEnumerable<ERP_System.Models.Branch>)ViewBag.BranchesList)
                    {
                        <option value="@branch.BranchId">@branch.BranchName</option>
                    }
                </select>
            </div>
        </div>

        <!-- Category -->
        <div class="mb-3 text-start">
            <label asp-for="Category" class="form-label-warm">Category</label>
            <div class="input-group-warm">
                <span class="input-icon-warm"><i class="fa-solid fa-tag"></i></span>
                <input asp-for="Category" class="form-control-warm" placeholder="e.g. Electronics, Office Supplies..." required list="categoryList" />
                <datalist id="categoryList">
                    <option value="Electronics"></option>
                    <option value="Office Supplies"></option>
                    <option value="Hardware"></option>
                    <option value="General"></option>
                </datalist>
            </div>
            <span asp-validation-for="Category" class="text-danger-custom d-block"></span>
        </div>

        <!-- Stock Quantity -->
        <div class="mb-3 text-start">
            <label asp-for="StockQty" class="form-label-warm">Initial Stock Quantity</label>
            <div class="input-group-warm">
                <span class="input-icon-warm">
                    <i class="fa-solid fa-boxes-stacked"></i>
                </span>
                <input asp-for="StockQty" type="number" min="0" class="form-control-warm" placeholder="100" required />
            </div>
            <span asp-validation-for="StockQty" class="text-danger-custom d-block"></span>
        </div>

        <!-- Sold Quantity -->
        <div class="mb-3 text-start">
            <label asp-for="SoldQty" class="form-label-warm">Sold Quantity (Demo purposes)</label>
            <div class="input-group-warm">
                <span class="input-icon-warm">
                    <i class="fa-solid fa-cart-shopping"></i>
                </span>
                <input asp-for="SoldQty" type="number" min="0" class="form-control-warm" placeholder="0" required />
            </div>
            <span asp-validation-for="SoldQty" class="text-danger-custom d-block"></span>
        </div>

        <!-- Total Revenue -->
        <div class="mb-4 text-start">
            <label asp-for="Revenue" class="form-label-warm">Total Revenue Generated (INR)</label>
            <div class="input-group-warm">
                <span class="input-icon-warm">
                    <i class="fa-solid fa-indian-rupee-sign"></i>
                </span>
                <input asp-for="Revenue" type="number" min="0" step="0.01" class="form-control-warm" placeholder="0.00" required />
            </div>
            <span asp-validation-for="Revenue" class="text-danger-custom d-block"></span>
        </div>

        <!-- Form Buttons -->
        <div class="d-flex justify-content-end gap-3 mt-4">
            <a href="/Products" class="btn btn-secondary-warm">
                Cancel
            </a>
            <button type="submit" class="btn btn-primary-warm">
                Add Product
            </button>
        </div>
    </form>
</div>

@model IEnumerable<ERP_System.Models.Product>
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Product Inventory Manager";
    var inCulture = new System.Globalization.CultureInfo("en-IN");
    var branches = (IEnumerable<ERP_System.Models.Branch>)ViewBag.BranchesList;
    var categories = (IEnumerable<string>)ViewBag.CategoriesList;
}

<style>
    .panel-products {
        background: #ffffff;
        border: 1px solid var(--border-warm);
        border-radius: 12px;
        box-shadow: 0 1px 3px rgba(45,37,30,0.03);
    }
    
    .table-products th {
        background-color: #fcfbfa !important;
        font-size: 0.75rem;
        text-transform: uppercase;
        font-weight: 700;
        color: #7c7267;
        border-bottom: 1px solid var(--border-warm);
        padding: 1rem 1.25rem;
    }
    
    .table-products td {
        font-size: 0.875rem;
        color: var(--text-color);
        border-bottom: 1px solid var(--border-warm);
        padding: 1rem 1.25rem;
        vertical-align: middle;
    }

    .badge-in-stock {
        background-color: rgba(16, 185, 129, 0.08);
        color: #10b981;
        font-weight: 600;
        border: 1px solid rgba(16, 185, 129, 0.2);
    }
    .badge-low-stock {
        background-color: rgba(245, 158, 11, 0.08);
        color: #f59e0b;
        font-weight: 600;
        border: 1px solid rgba(245, 158, 11, 0.2);
    }
    .badge-out-stock {
        background-color: rgba(239, 68, 68, 0.08);
        color: #ef4444;
        font-weight: 600;
        border: 1px solid rgba(239, 68, 68, 0.2);
    }

    .btn-edit-warm {
        border: 1px solid var(--border-warm);
        background-color: #ffffff;
        color: var(--text-color);
        font-size: 0.8rem;
        font-weight: 600;
        transition: all 0.2s;
    }
    .btn-edit-warm:hover {
        background-color: #faf8f5;
        border-color: #cbd5e1;
        color: var(--primary-warm);
    }

    .btn-delete-warm {
        border: 1px solid rgba(239, 68, 68, 0.15);
        background-color: #ffffff;
        color: #ef4444;
        font-size: 0.8rem;
        font-weight: 600;
        transition: all 0.2s;
    }
    .btn-delete-warm:hover {
        background-color: rgba(239, 68, 68, 0.05);
        border-color: #ef4444;
    }
</style>

<!-- Top Breadcrumbs & Page Header -->
<div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-3 mb-4 text-start">
    <div>
        <h4 class="fw-bold mb-1" style="color: var(--text-color);">Product Management</h4>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0 small">
                <li class="breadcrumb-item"><a href="/Dashboard" class="text-decoration-none">Dashboard</a></li>
                <li class="breadcrumb-item active" aria-current="page">Products</li>
            </ol>
        </nav>
    </div>
    
    <a href="/Products/Create" class="btn btn-primary-warm px-4 py-2">
        <i class="fa-solid fa-plus me-2"></i> Add New Product
    </a>
</div>

<!-- Alerts -->
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success border-0 shadow-sm alert-dismissible fade show mb-4 small text-start" role="alert" style="background-color: #f0fdf4; color: #15803d; border-left: 4px solid #16a34a !important;">
        <i class="fa-solid fa-circle-check me-2"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Search & Filter Controls -->
<div class="row g-3 mb-4 text-start">
    <!-- Search Input -->
    <div class="col-md-5">
        <div class="input-group-warm" style="border: 1px solid #d4cbbd; border-radius: 8px; background-color: #ffffff; display: flex; align-items: center; padding: 2px;">
            <span style="padding: 0.6rem 0.5rem 0.6rem 1rem; color: #7c7267;"><i class="fa-solid fa-magnifying-glass"></i></span>
            <input type="text" id="searchProduct" class="form-control" style="border: none !important; box-shadow: none !important; background: transparent; font-size: 0.9rem; padding: 0.6rem 1rem 0.6rem 0;" placeholder="Search products by name..." />
        </div>
    </div>
    
    <!-- Category Filter Dropdown -->
    <div class="col-md-3">
        <select id="filterCategory" class="form-select" style="border: 1px solid #d4cbbd; border-radius: 8px; background-color: #ffffff; padding: 0.72rem 1rem; font-size: 0.9rem; font-weight: 600; outline: none; width: 100%; color: var(--text-color);">
            <option value="">All Categories (Filter by Category)</option>
            @foreach (var cat in categories)
            {
                <option value="@cat">@cat</option>
            }
        </select>
    </div>

    <!-- Branch Filter Dropdown -->
    <div class="col-md-4">
        <select id="filterBranch" class="form-select" style="border: 1px solid #d4cbbd; border-radius: 8px; background-color: #ffffff; padding: 0.72rem 1rem; font-size: 0.9rem; font-weight: 600; outline: none; width: 100%; color: var(--text-color);">
            <option value="">All Branches (Filter by Branch)</option>
            @foreach (var branch in branches)
            {
                <option value="@branch.BranchName">@branch.BranchName</option>
            }
        </select>
    </div>
</div>

<!-- Products Inventory Grid -->
<div class="panel-products overflow-hidden">
    <div class="table-responsive">
        <table class="table table-hover table-products mb-0 border-0 text-start" id="productsTable">
            <thead>
                <tr>
                    <th class="border-0">Product ID</th>
                    <th class="border-0">Product Name</th>
                    <th class="border-0">Category</th>
                    <th class="border-0">Branch Location</th>
                    <th class="border-0 text-center">Sold Qty</th>
                    <th class="border-0">Total Revenue</th>
                    <th class="border-0 text-center">In Stock Bal</th>
                    <th class="border-0">Availability Status</th>
                    <th class="border-0 text-center">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var prod in Model)
                    {
                        var badgeClass = prod.Status == "In Stock" ? "badge-in-stock" :
                                         prod.Status == "Low Stock" ? "badge-low-stock" : "badge-out-stock";
                        <tr>
                            <td class="fw-bold text-secondary">PROD#@prod.ProductId.ToString("D3")</td>
                            <td class="fw-bold text-dark">@prod.ProductName</td>
                            <td class="fw-bold text-secondary">@prod.Category</td>
                            <td class="fw-bold text-secondary">@(prod.Branch?.BranchName ?? "Head Office")</td>
                            <td class="text-center fw-bold text-secondary">@prod.SoldQty</td>
                            <td class="fw-bold text-dark">@prod.Revenue.ToString("C0", inCulture)</td>
                            <td class="text-center fw-bold @(prod.StockQty <= 50 ? "text-danger" : "text-dark")">@prod.StockQty Units</td>
                            <td>
                                <span class="badge rounded-pill px-2.5 py-1.5 @badgeClass" style="font-size: 0.75rem;">@prod.Status</span>
                            </td>
                            <td class="text-center">
                                <div class="d-flex justify-content-center gap-2">
                                    <a href="/Products/Edit/@prod.ProductId" class="btn btn-sm btn-edit-warm px-3 py-1 rounded">
                                        <i class="fa-solid fa-pen-to-square me-1"></i>Edit
                                    </a>
                                    <form asp-action="Delete" asp-route-id="@prod.ProductId" method="post" onsubmit="return confirm('Are you sure you want to delete this product?');" style="display:inline;">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-delete-warm px-3 py-1 rounded">
                                            <i class="fa-solid fa-trash-can me-1"></i>Delete
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="9" class="text-center text-muted py-5">No product records found in warehouse inventory.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", () => {
            const searchInput = document.getElementById("searchProduct");
            const catSelect = document.getElementById("filterCategory");
            const branchSelect = document.getElementById("filterBranch");
            const tableRows = document.querySelectorAll("#productsTable tbody tr");

            function filterTable() {
                const query = searchInput.value.toLowerCase().trim();
                const selectedCat = catSelect.value.toLowerCase().trim();
                const selectedBranch = branchSelect.value.toLowerCase().trim();

                tableRows.forEach(row => {
                    if (row.cells.length < 8) return;

                    const name = row.cells[1].innerText.toLowerCase();
                    const category = row.cells[2].innerText.toLowerCase();
                    const branch = row.cells[3].innerText.toLowerCase();

                    const matchesSearch = name.includes(query);
                    const matchesCat = selectedCat === "" || category.includes(selectedCat);
                    const matchesBranch = selectedBranch === "" || branch.includes(selectedBranch);

                    if (matchesSearch && matchesCat && matchesBranch) {
                        row.style.display = "";
                    } else {
                        row.style.display = "none";
                    }
                });
            }

            searchInput.addEventListener("input", filterTable);
            catSelect.addEventListener("change", filterTable);
            branchSelect.addEventListener("change", filterTable);
        });
    </script>
}

                                </li>

                            </ol>
                        </nav>
                    </div>

                </div>

                @if (User.IsInRole("Sales Manager") ||
                                User.IsInRole("Admin") ||
                                User.IsInRole("Super Admin"))
                {
                    <div class="col-lg-auto">

                        <a href="/Products/Create"
                           class="product-add-btn">

                            <i class="fa-solid fa-plus"></i>
                            Add New Product

                        </a>

                    </div>
                }

            </div>

        </div>

    </div>

    <!-- =========================================================
         ALERT
         ========================================================= -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-dismissible fade show product-alert mb-4"
             role="alert">

            <i class="fa-solid fa-circle-check"></i>

            <span>
                @TempData["SuccessMessage"]
            </span>

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Close">
            </button>

        </div>
    }

    <!-- =========================================================
         INVENTORY SUMMARY
         ========================================================= -->
    <div class="row g-3 mb-4">

        <div class="col-md-4">
            <div class="inventory-summary-card products">

                <div class="inventory-summary-icon">
                    <i class="fa-solid fa-boxes-stacked"></i>
                </div>

                <div class="inventory-summary-content">

                    <div class="inventory-summary-label">
                        Product Catalog
                    </div>

                    <div class="inventory-summary-value">
                        @(Model?.Count() ?? 0)
                    </div>

                    <div class="inventory-summary-caption">
                        Products in current registry
                    </div>

                </div>

            </div>
        </div>

        <div class="col-md-4">
            <div class="inventory-summary-card stock">

                <div class="inventory-summary-icon">
                    <i class="fa-solid fa-warehouse"></i>
                </div>

                <div class="inventory-summary-content">

                    <div class="inventory-summary-label">
                        Inventory Control
                    </div>

                    <div class="inventory-summary-value">
                        <i class="fa-solid fa-check"
                           style="font-size: 0.85rem;"></i>
                    </div>

                    <div class="inventory-summary-caption">
                        Warehouse stock monitoring
                    </div>

                </div>

            </div>
        </div>

        <div class="col-md-4">
            <div class="inventory-summary-card warning">

                <div class="inventory-summary-icon">
                    <i class="fa-solid fa-chart-line"></i>
                </div>

                <div class="inventory-summary-content">

                    <div class="inventory-summary-label">
                        Stock Visibility
                    </div>

                    <div class="inventory-summary-value">
                        Live
                    </div>

                    <div class="inventory-summary-caption">
                        Availability and sales quantities
                    </div>

                </div>

            </div>
        </div>

    </div>

    <!-- =========================================================
         SEARCH & FILTERS
         ========================================================= -->
    <div class="product-filter-panel mb-4">

        <div class="product-filter-heading">

            <div>

                <h2 class="product-filter-title">

                    <span class="product-filter-title-icon">
                        <i class="fa-solid fa-sliders"></i>
                    </span>

                    Inventory Filters

                </h2>

                <div class="product-filter-caption mt-1">
                    Quickly find products by name, category or branch.
                </div>

            </div>

        </div>

        <div class="row g-3 text-start">

            <!-- Search -->
            <div class="col-lg-5 col-md-12">

                <label class="product-filter-label">
                    Search Products
                </label>

                <div class="product-search-box">

                    <i class="fa-solid fa-magnifying-glass"></i>

                    <input type="text"
                           id="searchProduct"
                           class="form-control product-search-input"
                           placeholder="Search products by name..." />

                </div>

            </div>

            <!-- Category -->
            <div class="col-lg-3 col-md-6">

                <label class="product-filter-label">
                    Product Category
                </label>

                <select id="filterCategory"
                        class="form-select product-filter-select">

                    <option value="">
                        All Categories (Filter by Category)
                    </option>

                    @foreach (var cat in categories)
                    {
                        <option value="@cat">
                            @cat
                        </option>
                    }

                </select>

            </div>

            <!-- Branch -->
            <div class="col-lg-4 col-md-6">

                <label class="product-filter-label">
                    Warehouse / Branch
                </label>

                <select id="filterBranch"
                        class="form-select product-filter-select">

                    <option value="">
                        All Branches (Filter by Branch)
                    </option>

                    @foreach (var branch in branches)
                    {
                        <option value="@branch.BranchName">
                            @branch.BranchName
                        </option>
                    }

                </select>

            </div>

        </div>

    </div>

    <!-- =========================================================
         PRODUCTS TABLE
         ========================================================= -->
    <div class="product-table-panel">

        <div class="product-table-header">

            <div class="product-table-heading">

                <div class="product-table-heading-icon">
                    <i class="fa-solid fa-box-open"></i>
                </div>

                <div>

                    <h2 class="product-table-title">
                        Product Inventory
                    </h2>

                    <p class="product-table-subtitle">
                        Product pricing, stock allocation and availability
                    </p>

                </div>

            </div>

            <div class="product-table-badge">
                <i class="fa-solid fa-database"></i>
                Inventory Registry
            </div>

        </div>

        <div class="product-table-wrap">

            <table class="table product-table table-hover mb-0 border-0 text-start align-middle"
                   id="productsTable">

                <thead>

                    <tr>

                        <th class="border-0">
                            Product ID
                        </th>

                        <th class="border-0">
                            Product Name
                        </th>

                        <th class="border-0">
                            Category
                        </th>

                        <th class="border-0 text-end">
                            Unit Price (₹)
                        </th>

                        <th class="border-0 text-center">
                            GST Rate
                        </th>

                        <th class="border-0 text-center">
                            Free Available
                        </th>

                        <th class="border-0 text-center">
                            Reserved
                        </th>

                        <th class="border-0 text-center">
                            Total Stock
                        </th>

                        <th class="border-0 text-center">
                            Sold Qty
                        </th>

                        <th class="border-0">
                            Availability
                        </th>

                        <th class="border-0 text-center">
                            Actions
                        </th>

                    </tr>

                </thead>

                <tbody>

                    @if (Model != null && Model.Any())
                    {
                        foreach (var prod in Model)
                        {
                            var badgeClass =
                            prod.Status == "In Stock"
                            ? "in-stock"
                            : prod.Status == "Low Stock"
                            ? "low-stock"
                            : "out-stock";

                            var price =
                            prod.UnitSellingPrice > 0
                            ? prod.UnitSellingPrice
                            : (prod.StockQty > 0
                            ? prod.Revenue / Math.Max(1, prod.SoldQty)
                            : 1000m);

                            var freeStock = prod.FreeAvailableStock;
                            var reservedStock = prod.ReservedStockQty;

                            <tr>

                                <!-- Product ID -->
                                <td>

                                    <span class="product-id-badge">
                                        PROD#@prod.ProductId.ToString("D3")
                                    </span>

                                </td>

                                <!-- Product Name -->
                                <td>

                                    <div class="product-name-cell">

                                        <div class="product-name">
                                            @prod.ProductName
                                        </div>

                                        <div class="product-branch">
                                            <i class="fa-solid fa-location-dot"></i>
                                            @(prod.Branch?.BranchName ?? "Head Office")
                                        </div>

                                    </div>

                                </td>

                                <!-- Category -->
                                <td>

                                    <span class="product-category-badge">
                                        @prod.Category
                                    </span>

                                </td>

                                <!-- Price -->
                                <td class="text-end">

                                    <span class="product-price">
                                        ₹@price.ToString("N2")
                                    </span>

                                </td>

                                <!-- GST -->
                                <td class="text-center">

                                    <span class="product-gst-badge">
                                        @(prod.GstRate > 0
                                                                        ? prod.GstRate.ToString("0.##")
                                                                        : "18")%
                            </span>

                                </td>

                                <!-- Free Stock -->
                                <td class="text-center">

                                    <span class="product-qty-badge product-qty-free">
                                        @freeStock Units
                                    </span>

                                </td>

                                <!-- Reserved -->
                                <td class="text-center">

                                    <span class="product-qty-badge product-qty-reserved">
                                        @reservedStock Units
                                    </span>

                                </td>

                                <!-- Total Stock -->
                                <td class="text-center">

                                    <span class="product-stock-value @(prod.StockQty <= 50 ? "low" : "")">
                                        @prod.StockQty
                                    </span>

                                </td>

                                <!-- Sold -->
                                <td class="text-center">

                                    <span class="product-sold-value">
                                        @prod.SoldQty
                                    </span>

                                </td>

                                <!-- Availability -->
                                <td>

                                    <span class="product-status @badgeClass"
                                          style="font-size: 0.7rem;">

                                        @prod.Status

                                    </span>

                                </td>

                                <!-- Actions -->
                                <td class="text-center">

                                    <div class="product-actions">

                                @if (User.IsInRole("Sales Manager") ||
                                                                User.IsInRole("Admin") ||
                                                                User.IsInRole("Super Admin"))
                                        {
                                            <a href="/Products/Edit/@prod.ProductId"
                                               class="product-edit-btn">

                                                <i class="fa-solid fa-pen-to-square"></i>
                                                Edit

                                            </a>

                                            @if (User.IsInRole("Super Admin") ||
                                                                            User.IsInRole("Admin"))
                                            {
                                                <form asp-action="Delete"
                                                      asp-route-id="@prod.ProductId"
                                                      method="post"
                                                      onsubmit="return confirm('Are you sure you want to delete this product?');"
                                                      style="display:inline;">

                                                    @Html.AntiForgeryToken()

                                                    <button type="submit"
                                                            class="product-delete-btn">

                                                        <i class="fa-solid fa-trash-can"></i>
                                                        Delete

                                                    </button>

                                                </form>
                                            }
                                        }
                                        else
                                        {
                                            <span class="product-readonly">

                                                <i class="fa-solid fa-lock"></i>
                                                Read-Only

                                            </span>
                                        }

                                    </div>

                                </td>

                            </tr>
                        }
                    }
                    else
                    {
                        <tr>

                            <td colspan="11"
                                class="text-center product-empty-state">

                                <div class="product-empty-icon">
                                    <i class="fa-solid fa-box-open"></i>
                                </div>

                                <div class="product-empty-title">
                                    No product records found
                                </div>

                                <div class="product-empty-text">
                                    No products are currently available in the warehouse inventory.
                                </div>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>
    ```

</div>

@section Scripts {

    ```
    <script>
        document.addEventListener("DOMContentLoaded", () => {

            const searchInput = document.getElementById("searchProduct");
            const catSelect = document.getElementById("filterCategory");
            const branchSelect = document.getElementById("filterBranch");
            const tableRows = document.querySelectorAll("#productsTable tbody tr");

            function filterTable() {

                const query =
                    searchInput.value.toLowerCase().trim();

                const selectedCat =
                    catSelect.value.toLowerCase().trim();

                const selectedBranch =
                    branchSelect.value.toLowerCase().trim();

                tableRows.forEach(row => {

                    if (row.cells.length < 8) {
                        return;
                    }

                    const name =
                        row.cells[1].innerText.toLowerCase();

                    const category =
                        row.cells[2].innerText.toLowerCase();

                    const branch =
                        row.cells[3].innerText.toLowerCase();

                    const matchesSearch =
                        name.includes(query);

                    const matchesCat =
                        selectedCat === "" ||
                        category.includes(selectedCat);

                    const matchesBranch =
                        selectedBranch === "" ||
                        branch.includes(selectedBranch);

                    if (
                        matchesSearch &&
                        matchesCat &&
                        matchesBranch
                    ) {
                        row.style.display = "";
                    }
                    else {
                        row.style.display = "none";
                    }

                });
            }

            searchInput.addEventListener(
                "input",
                filterTable
            );

            catSelect.addEventListener(
                "change",
                filterTable
            );

            branchSelect.addEventListener(
                "change",
                filterTable
            );

        });
    </script>
   

}


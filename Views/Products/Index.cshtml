@model IEnumerable<ERP_System.Models.Product>

@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Product Inventory Manager";

var inCulture = new System.Globalization.CultureInfo("en-IN");
    var branches = (IEnumerable<ERP_System.Models.Branch>)ViewBag.BranchesList;
    var categories = (IEnumerable<string>)ViewBag.CategoriesList;

}

<style>
    /* =========================================================
           PRODUCT INVENTORY MANAGER
           Premium ERP UI - Scoped to .product-inventory-page
           ========================================================= */

    .product-inventory-page {
        --product-primary: #4f46e5;
        --product-primary-dark: #4338ca;
        --product-primary-soft: rgba(79, 70, 229, 0.09);
        --product-success: #10b981;
        --product-success-soft: rgba(16, 185, 129, 0.09);
        --product-warning: #f59e0b;
        --product-warning-soft: rgba(245, 158, 11, 0.10);
        --product-danger: #ef4444;
        --product-danger-soft: rgba(239, 68, 68, 0.09);
        --product-info: #0ea5e9;
        --product-info-soft: rgba(14, 165, 233, 0.09);
        --product-text: #1f2937;
        --product-muted: #6b7280;
        --product-border: #e7e5e4;
        --product-surface: #ffffff;
        --product-soft-bg: #f8fafc;
    }

    .product-inventory-page {
        width: 100%;
        color: var(--product-text);
    }

    /* =========================================================
           PAGE HERO
           ========================================================= */

    .product-hero {
        position: relative;
        overflow: hidden;
        background: linear-gradient( 135deg, #ffffff 0%, #fbfbff 58%, #f6f7ff 100% );
        border: 1px solid var(--product-border);
        border-radius: 18px;
        padding: 1.35rem 1.5rem;
        margin-bottom: 1.25rem;
        box-shadow: 0 4px 18px rgba(15, 23, 42, 0.035);
    }

        .product-hero::before {
            content: "";
            position: absolute;
            width: 190px;
            height: 190px;
            right: -75px;
            top: -95px;
            border-radius: 50%;
            background: rgba(79, 70, 229, 0.055);
            pointer-events: none;
        }

        .product-hero::after {
            content: "";
            position: absolute;
            width: 90px;
            height: 90px;
            right: 105px;
            bottom: -60px;
            border-radius: 50%;
            background: rgba(14, 165, 233, 0.035);
            pointer-events: none;
        }

    .product-hero-content {
        position: relative;
        z-index: 1;
    }

    .product-eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        color: var(--product-primary);
        font-size: 0.68rem;
        font-weight: 800;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        margin-bottom: 0.35rem;
    }

        .product-eyebrow i {
            font-size: 0.55rem;
        }

    .product-page-title {
        color: var(--product-text);
        font-size: 1.55rem;
        line-height: 1.2;
        font-weight: 800;
        letter-spacing: -0.025em;
        margin: 0;
    }

    .product-page-subtitle {
        color: var(--product-muted);
        font-size: 0.82rem;
        margin: 0.3rem 0 0;
    }

    .product-breadcrumb {
        margin-top: 0.55rem;
    }

        .product-breadcrumb .breadcrumb {
            margin-bottom: 0;
            font-size: 0.74rem;
        }

        .product-breadcrumb .breadcrumb-item a {
            color: var(--product-primary);
            font-weight: 600;
        }

        .product-breadcrumb .breadcrumb-item.active {
            color: var(--product-muted);
        }

        .product-breadcrumb .breadcrumb-item + .breadcrumb-item::before {
            color: #b6b3af;
        }

    .product-add-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        min-height: 42px;
        padding: 0.7rem 1rem;
        border: 0;
        border-radius: 10px;
        background: linear-gradient( 135deg, var(--product-primary), var(--product-primary-dark) );
        color: #ffffff !important;
        font-size: 0.79rem;
        font-weight: 750;
        text-decoration: none;
        white-space: nowrap;
        box-shadow: 0 6px 16px rgba(79, 70, 229, 0.18);
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

        .product-add-btn:hover {
            color: #ffffff !important;
            transform: translateY(-2px);
            box-shadow: 0 9px 21px rgba(79, 70, 229, 0.24);
        }

        .product-add-btn:active {
            transform: translateY(0);
        }

    /* =========================================================
           ALERT
           ========================================================= */

    .product-alert {
        display: flex;
        align-items: center;
        gap: 9px;
        background: #f0fdf4;
        color: #15803d;
        border: 1px solid #bbf7d0;
        border-left: 4px solid #16a34a !important;
        border-radius: 12px;
        padding: 0.8rem 1rem;
        font-size: 0.8rem;
        box-shadow: 0 3px 12px rgba(22, 163, 74, 0.04);
    }

        .product-alert i {
            font-size: 0.92rem;
        }

        .product-alert .btn-close {
            margin-left: auto;
            font-size: 0.68rem;
        }

    /* =========================================================
           INVENTORY SUMMARY CARDS
           ========================================================= */

    .inventory-summary-card {
        position: relative;
        height: 100%;
        min-height: 108px;
        overflow: hidden;
        display: flex;
        align-items: center;
        gap: 13px;
        background: #ffffff;
        border: 1px solid var(--product-border);
        border-radius: 15px;
        padding: 1.05rem 1.1rem;
        box-shadow: 0 4px 15px rgba(15, 23, 42, 0.035);
        transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
    }

        .inventory-summary-card::after {
            content: "";
            position: absolute;
            width: 120px;
            height: 120px;
            right: -48px;
            bottom: -62px;
            border-radius: 50%;
            background: var(--summary-soft, var(--product-primary-soft));
            pointer-events: none;
        }

        .inventory-summary-card:hover {
            transform: translateY(-3px);
            border-color: rgba(79, 70, 229, 0.14);
            box-shadow: 0 9px 24px rgba(15, 23, 42, 0.06);
        }

        .inventory-summary-card.products {
            --summary-soft: var(--product-primary-soft);
        }

        .inventory-summary-card.stock {
            --summary-soft: var(--product-success-soft);
        }

        .inventory-summary-card.warning {
            --summary-soft: var(--product-warning-soft);
        }

    .inventory-summary-icon {
        position: relative;
        z-index: 1;
        width: 48px;
        height: 48px;
        min-width: 48px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 13px;
        font-size: 1rem;
    }

    .inventory-summary-card.products .inventory-summary-icon {
        color: var(--product-primary);
        background: var(--product-primary-soft);
    }

    .inventory-summary-card.stock .inventory-summary-icon {
        color: var(--product-success);
        background: var(--product-success-soft);
    }

    .inventory-summary-card.warning .inventory-summary-icon {
        color: var(--product-warning);
        background: var(--product-warning-soft);
    }

    .inventory-summary-content {
        position: relative;
        z-index: 1;
        min-width: 0;
    }

    .inventory-summary-label {
        color: var(--product-muted);
        font-size: 0.67rem;
        font-weight: 800;
        letter-spacing: 0.065em;
        text-transform: uppercase;
        margin-bottom: 0.18rem;
    }

    .inventory-summary-value {
        color: var(--product-text);
        font-size: 1.35rem;
        font-weight: 800;
        line-height: 1.15;
        letter-spacing: -0.02em;
    }

    .inventory-summary-caption {
        color: #9ca3af;
        font-size: 0.67rem;
        margin-top: 0.18rem;
    }

    /* =========================================================
           FILTER PANEL
           ========================================================= */

    .product-filter-panel {
        background: #ffffff;
        border: 1px solid var(--product-border);
        border-radius: 15px;
        padding: 1rem 1.15rem;
        box-shadow: 0 4px 16px rgba(15, 23, 42, 0.032);
    }

    .product-filter-heading {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        padding-bottom: 0.85rem;
        margin-bottom: 0.95rem;
        border-bottom: 1px solid #f0efed;
    }

    .product-filter-title {
        display: flex;
        align-items: center;
        gap: 9px;
        color: var(--product-text);
        font-size: 0.86rem;
        font-weight: 800;
        margin: 0;
    }

    .product-filter-title-icon {
        width: 30px;
        height: 30px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 9px;
        background: var(--product-primary-soft);
        color: var(--product-primary);
        font-size: 0.73rem;
    }

    .product-filter-caption {
        color: #9ca3af;
        font-size: 0.69rem;
    }

    .product-filter-label {
        display: block;
        color: #4b5563;
        font-size: 0.69rem;
        font-weight: 800;
        margin-bottom: 0.38rem;
    }

    .product-search-box {
        position: relative;
    }

        .product-search-box > i {
            position: absolute;
            left: 13px;
            top: 50%;
            transform: translateY(-50%);
            color: #9ca3af;
            font-size: 0.76rem;
            pointer-events: none;
            z-index: 2;
        }

    .product-search-input,
    .product-filter-select {
        width: 100%;
        min-height: 42px;
        border: 1px solid #deddda !important;
        border-radius: 9px !important;
        background: #ffffff !important;
        color: var(--product-text) !important;
        font-size: 0.78rem !important;
        font-weight: 500;
        box-shadow: none !important;
        outline: none;
        transition: border-color 0.2s ease, box-shadow 0.2s ease;
    }

    .product-search-input {
        padding-left: 2.2rem !important;
    }

        .product-search-input:focus,
        .product-filter-select:focus {
            border-color: rgba(79, 70, 229, 0.55) !important;
            box-shadow: 0 0 0 3px rgba(79, 70, 229, 0.08) !important;
        }

        .product-search-input::placeholder {
            color: #aaa6a1;
        }

    /* =========================================================
           TABLE PANEL
           ========================================================= */

    .product-table-panel {
        background: #ffffff;
        border: 1px solid var(--product-border);
        border-radius: 15px;
        overflow: hidden;
        box-shadow: 0 4px 16px rgba(15, 23, 42, 0.032);
    }

    .product-table-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        padding: 1rem 1.15rem;
        border-bottom: 1px solid #f0efed;
    }

    .product-table-heading {
        display: flex;
        align-items: center;
        gap: 9px;
    }

    .product-table-heading-icon {
        width: 31px;
        height: 31px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 9px;
        background: var(--product-primary-soft);
        color: var(--product-primary);
        font-size: 0.74rem;
    }

    .product-table-title {
        color: var(--product-text);
        font-size: 0.86rem;
        font-weight: 800;
        margin: 0;
    }

    .product-table-subtitle {
        color: #9ca3af;
        font-size: 0.68rem;
        margin: 2px 0 0;
    }

    .product-table-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 0.34rem 0.65rem;
        border: 1px solid #e5e7eb;
        border-radius: 20px;
        background: #f8fafc;
        color: #6b7280;
        font-size: 0.67rem;
        font-weight: 700;
    }

    .product-table-wrap {
        width: 100%;
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
    }

    .product-table {
        width: 100%;
        min-width: 1220px;
        margin: 0;
        border-collapse: separate;
        border-spacing: 0;
    }

        .product-table thead th {
            background: #fafafa !important;
            color: #77716a;
            border-bottom: 1px solid #e7e5e4 !important;
            padding: 0.8rem 0.85rem;
            font-size: 0.64rem;
            font-weight: 800;
            letter-spacing: 0.055em;
            text-transform: uppercase;
            white-space: nowrap;
            vertical-align: middle;
        }

        .product-table tbody td {
            background: #ffffff;
            color: var(--product-text);
            border-bottom: 1px solid #f0efed !important;
            padding: 0.82rem 0.85rem;
            font-size: 0.77rem;
            vertical-align: middle;
        }

        .product-table tbody tr:last-child td {
            border-bottom: 0 !important;
        }

        .product-table tbody tr {
            transition: background-color 0.18s ease;
        }

            .product-table tbody tr:hover td {
                background: #fbfbff;
            }

    .product-id-badge {
        display: inline-flex;
        align-items: center;
        padding: 0.3rem 0.5rem;
        border: 1px solid #e2e8f0;
        border-radius: 7px;
        background: #f8fafc;
        color: #475569;
        font-family: "SFMono-Regular", Consolas, "Liberation Mono", monospace;
        font-size: 0.66rem;
        font-weight: 750;
        white-space: nowrap;
    }

    .product-name-cell {
        min-width: 190px;
    }

    .product-name {
        color: #1f2937;
        font-size: 0.79rem;
        font-weight: 750;
        line-height: 1.25;
    }

    .product-branch {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        color: #9ca3af;
        font-size: 0.65rem;
        margin-top: 3px;
        white-space: nowrap;
    }

    .product-category-badge {
        display: inline-flex;
        align-items: center;
        padding: 0.3rem 0.55rem;
        border-radius: 7px;
        background: #f8fafc;
        color: #475569;
        border: 1px solid #e2e8f0;
        font-size: 0.66rem;
        font-weight: 700;
        white-space: nowrap;
    }

    .product-price {
        color: #1f2937;
        font-size: 0.78rem;
        font-weight: 800;
        white-space: nowrap;
    }

    .product-gst-badge {
        display: inline-flex;
        align-items: center;
        padding: 0.3rem 0.55rem;
        border-radius: 7px;
        background: var(--product-info-soft);
        color: #0284c7;
        border: 1px solid rgba(14, 165, 233, 0.12);
        font-size: 0.66rem;
        font-weight: 750;
        white-space: nowrap;
    }

    .product-qty-badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 58px;
        padding: 0.3rem 0.5rem;
        border-radius: 7px;
        font-size: 0.66rem;
        font-weight: 750;
        white-space: nowrap;
    }

    .product-qty-free {
        background: var(--product-success-soft);
        color: #059669;
        border: 1px solid rgba(16, 185, 129, 0.12);
    }

    .product-qty-reserved {
        background: var(--product-warning-soft);
        color: #b45309;
        border: 1px solid rgba(245, 158, 11, 0.13);
    }

    .product-stock-value {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 48px;
        color: #1f2937;
        font-weight: 800;
        white-space: nowrap;
    }

        .product-stock-value.low {
            color: #dc2626;
        }

    .product-sold-value {
        color: #64748b;
        font-weight: 700;
        white-space: nowrap;
    }

    .product-status {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 0.34rem 0.62rem;
        border-radius: 20px;
        font-size: 0.66rem;
        font-weight: 800;
        white-space: nowrap;
    }

        .product-status::before {
            content: "";
            width: 5px;
            height: 5px;
            border-radius: 50%;
        }

        .product-status.in-stock {
            background: var(--product-success-soft);
            color: #059669;
            border: 1px solid rgba(16, 185, 129, 0.13);
        }

            .product-status.in-stock::before {
                background: #10b981;
                box-shadow: 0 0 0 3px rgba(16, 185, 129, 0.09);
            }

        .product-status.low-stock {
            background: var(--product-warning-soft);
            color: #b45309;
            border: 1px solid rgba(245, 158, 11, 0.14);
        }

            .product-status.low-stock::before {
                background: #f59e0b;
                box-shadow: 0 0 0 3px rgba(245, 158, 11, 0.09);
            }

        .product-status.out-stock {
            background: var(--product-danger-soft);
            color: #dc2626;
            border: 1px solid rgba(239, 68, 68, 0.14);
        }

            .product-status.out-stock::before {
                background: #ef4444;
                box-shadow: 0 0 0 3px rgba(239, 68, 68, 0.08);
            }

    .product-actions {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 6px;
        white-space: nowrap;
    }

    .product-edit-btn,
    .product-delete-btn {
        min-height: 32px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 5px;
        padding: 0.35rem 0.62rem;
        border-radius: 8px;
        font-size: 0.67rem;
        font-weight: 700;
        text-decoration: none;
        transition: background-color 0.18s ease, border-color 0.18s ease, color 0.18s ease, transform 0.18s ease;
    }

    .product-edit-btn {
        border: 1px solid #e2e0dd;
        background: #ffffff;
        color: #475569;
    }

        .product-edit-btn:hover {
            background: #fafaff;
            border-color: rgba(79, 70, 229, 0.25);
            color: var(--product-primary);
            transform: translateY(-1px);
        }

    .product-delete-btn {
        border: 1px solid rgba(239, 68, 68, 0.15);
        background: #ffffff;
        color: #ef4444;
    }

        .product-delete-btn:hover {
            background: var(--product-danger-soft);
            border-color: rgba(239, 68, 68, 0.35);
            color: #dc2626;
            transform: translateY(-1px);
        }

    .product-readonly {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 0.34rem 0.62rem;
        border-radius: 20px;
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        color: #94a3b8;
        font-size: 0.66rem;
        font-weight: 700;
        white-space: nowrap;
    }

    .product-empty-state {
        padding: 4rem 1.5rem !important;
        color: #9ca3af !important;
    }

    .product-empty-icon {
        width: 58px;
        height: 58px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 0.85rem;
        border-radius: 16px;
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        color: #94a3b8;
        font-size: 1.2rem;
    }

    .product-empty-title {
        color: #4b5563;
        font-size: 0.85rem;
        font-weight: 750;
        margin-bottom: 0.25rem;
    }

    .product-empty-text {
        color: #9ca3af;
        font-size: 0.7rem;
    }

    /* =========================================================
           RESPONSIVE
           ========================================================= */

    @@media (max-width: 991.98px) {
        .product-page-title

    {
        font-size: 1.35rem;
    }

    .product-hero {
        padding: 1.15rem;
    }

    .product-table {
        min-width: 1160px;
    }

    }

    @@media (max-width: 767.98px) {
        .product-hero

    {
        border-radius: 14px;
        padding: 1rem;
    }

    .product-hero .product-add-btn {
        width: 100%;
    }

    .product-page-title {
        font-size: 1.25rem;
    }

    .product-page-subtitle {
        font-size: 0.76rem;
    }

    .inventory-summary-card {
        min-height: 94px;
        padding: 0.9rem;
    }

    .inventory-summary-icon {
        width: 44px;
        height: 44px;
        min-width: 44px;
    }

    .inventory-summary-value {
        font-size: 1.22rem;
    }

    .product-filter-panel {
        padding: 0.95rem;
    }

    .product-table-header {
        align-items: flex-start;
        flex-direction: column;
        padding: 0.9rem;
    }

    .product-table-badge {
        align-self: flex-start;
    }

    }

    @@media (max-width: 575.98px) {
        .product-breadcrumb

    {
        display: none;
    }

    .product-eyebrow {
        font-size: 0.61rem;
    }

    .product-page-title {
        font-size: 1.15rem;
    }

    .product-filter-heading {
        align-items: flex-start;
        flex-direction: column;
    }

    .product-table-panel {
        border-radius: 12px;
    }

    .inventory-summary-card {
        border-radius: 12px;
    }

    }

    /* =========================================================
           REDUCED MOTION
           ========================================================= */

    @@media (prefers-reduced-motion: reduce) {
        .product-inventory-page *, .product-inventory-page *::before, .product-inventory-page *::after

    {
        scroll-behavior: auto !important;
        transition: none !important;
        animation: none !important;
    }

    }

    /* =========================================================
           PRINT
           ========================================================= */

    @@media print {
        .product-hero::before, .product-hero::after, .inventory-summary-card::after, .product-filter-panel, .product-add-btn, .product-actions

    {
        display: none !important;
    }

    .product-hero,
    .product-table-panel,
    .inventory-summary-card {
        box-shadow: none !important;
    }

    .product-table {
        min-width: 0 !important;
    }

    }
</style>


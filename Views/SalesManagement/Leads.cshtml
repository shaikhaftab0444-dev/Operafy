@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Leads Management";
}

<div class="container-fluid py-4 text-start">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-bold mb-1"><i class="fa-solid fa-filter text-primary me-2"></i>Leads</h4>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0 small">
                    <li class="breadcrumb-item"><a href="/SalesDashboard" class="text-decoration-none">Sales Management</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Leads</li>
                </ol>
            </nav>
        </div>
        <button class="btn btn-primary rounded-pill px-3 shadow-sm"><i class="fa-solid fa-plus me-1.5"></i>Create Lead</button>
    </div>

    <!-- Leads Cards -->
    <div class="row g-4 mb-4">
        <div class="col-md-3">
            <div class="bg-white border rounded-3 p-3 shadow-sm">
                <div class="text-muted fw-semibold small">New Leads</div>
                <h3 class="fw-bold text-primary mb-0 mt-1">45</h3>
            </div>
        </div>
        <div class="col-md-3">
            <div class="bg-white border rounded-3 p-3 shadow-sm">
                <div class="text-muted fw-semibold small">Contacted</div>
                <h3 class="fw-bold text-warning mb-0 mt-1">28</h3>
            </div>
        </div>
        <div class="col-md-3">
            <div class="bg-white border rounded-3 p-3 shadow-sm">
                <div class="text-muted fw-semibold small">Qualified</div>
                <h3 class="fw-bold text-success mb-0 mt-1">15</h3>
            </div>
        </div>
        <div class="col-md-3">
            <div class="bg-white border rounded-3 p-3 shadow-sm">
                <div class="text-muted fw-semibold small">Conversion Rate</div>
                <h3 class="fw-bold text-dark mb-0 mt-1">18.4%</h3>
            </div>
        </div>
    </div>

    <!-- Leads Grid Table -->
    <div class="bg-white border rounded-3 p-4 shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" style="font-size: 0.85rem;">
                <thead class="table-light">
                    <tr>
                        <th>Lead ID</th>
                        <th>Contact Name</th>
                        <th>Company</th>
                        <th>Source</th>
                        <th>Created Date</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td class="fw-bold text-dark">LD-2041</td>
                        <td>Rajesh Kumar</td>
                        <td>Rajesh Corp Ltd</td>
                        <td>Website Referral</td>
                        <td class="text-muted">20 Aug 2026</td>
                        <td><span class="badge bg-primary-subtle text-primary rounded-pill px-2.5 py-1">New</span></td>
                    </tr>
                    <tr>
                        <td class="fw-bold text-dark">LD-2042</td>
                        <td>Sarah Jenkins</td>
                        <td>Jenkins Q2 Auditing</td>
                        <td>Cold Email</td>
                        <td class="text-muted">19 Aug 2026</td>
                        <td><span class="badge bg-warning-subtle text-warning rounded-pill px-2.5 py-1">Contacted</span></td>
                    </tr>
                    <tr>
                        <td class="fw-bold text-dark">LD-2043</td>
                        <td>Sunil Mehta</td>
                        <td>Mehta Logistics</td>
                        <td>Direct Call</td>
                        <td class="text-muted">18 Aug 2026</td>
                        <td><span class="badge bg-success-subtle text-success rounded-pill px-2.5 py-1">Qualified</span></td>
                    </tr>
                    <tr>
                        <td class="fw-bold text-dark">LD-2044</td>
                        <td>Vikram Singh</td>
                        <td>Singh & Sons</td>
                        <td>LinkedIn</td>
                        <td class="text-muted">15 Aug 2026</td>
                        <td><span class="badge bg-danger-subtle text-danger rounded-pill px-2.5 py-1">Lost</span></td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

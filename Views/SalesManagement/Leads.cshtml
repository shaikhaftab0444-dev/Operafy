@model IEnumerable<ERP_System.Models.Lead>
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Leads Management";
}

<div class="container-fluid py-4 text-start">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-bold mb-1"><i class="fa-solid fa-filter text-primary me-2"></i>Leads</h4>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0 small">
                    <li class="breadcrumb-item"><a href="/SalesDashboard" class="text-decoration-none">Sales Management</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Leads</li>
                </ol>
            </nav>
        </div>
        <button class="btn btn-primary rounded-pill px-3 shadow-sm" data-bs-toggle="modal" data-bs-target="#createLeadModal">
            <i class="fa-solid fa-plus me-1.5"></i>Create Lead
        </button>
    </div>

    <!-- Leads Cards -->
    <div class="row g-4 mb-4">
        <div class="col-md-3">
            <div class="bg-white border rounded-3 p-3 shadow-sm">
                <div class="text-muted fw-semibold small">New Leads</div>
                <h3 class="fw-bold text-primary mb-0 mt-1">@Model.Count(l => l.Status == "New")</h3>
            </div>
        </div>
        <div class="col-md-3">
            <div class="bg-white border rounded-3 p-3 shadow-sm">
                <div class="text-muted fw-semibold small">Contacted</div>
                <h3 class="fw-bold text-warning mb-0 mt-1">@Model.Count(l => l.Status == "Contacted")</h3>
            </div>
        </div>
        <div class="col-md-3">
            <div class="bg-white border rounded-3 p-3 shadow-sm">
                <div class="text-muted fw-semibold small">Qualified</div>
                <h3 class="fw-bold text-success mb-0 mt-1">@Model.Count(l => l.Status == "Qualified")</h3>
            </div>
        </div>
        <div class="col-md-3">
            <div class="bg-white border rounded-3 p-3 shadow-sm">
                <div class="text-muted fw-semibold small">Total Leads</div>
                <h3 class="fw-bold text-dark mb-0 mt-1">@Model.Count()</h3>
            </div>
        </div>
    </div>

    <!-- Leads Grid Table -->
    <div class="bg-white border rounded-3 p-4 shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" style="font-size: 0.85rem;">
                <thead class="table-light">
                    <tr>
                        <th>Lead ID</th>
                        <th>Contact Name</th>
                        <th>Company</th>
                        <th>Source</th>
                        <th>Created Date</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var lead in Model)
                        {
                            <tr>
                                <td class="fw-bold text-dark">LD-@lead.LeadId</td>
                                <td>@lead.ContactName</td>
                                <td>@lead.Company</td>
                                <td>@lead.Source</td>
                                <td class="text-muted">@lead.CreatedAt.ToString("dd MMM yyyy")</td>
                                <td>
                                    @{
                                        var badgeClass = lead.Status == "New" ? "bg-primary-subtle text-primary" :
                                                         lead.Status == "Contacted" ? "bg-warning-subtle text-warning" :
                                                         lead.Status == "Qualified" ? "bg-success-subtle text-success" :
                                                         "bg-danger-subtle text-danger";
                                    }
                                    <span class="badge @badgeClass rounded-pill px-2.5 py-1">@lead.Status</span>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center py-4 text-muted">No leads found in database.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Create Lead Modal -->
<div class="modal fade text-start" id="createLeadModal" tabindex="-1" aria-labelledby="createLeadModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form action="/SalesManagement/CreateLead" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title fw-bold" id="createLeadModalLabel">Create New Lead</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Contact Name</label>
                        <input type="text" name="ContactName" class="form-control" placeholder="e.g. Rajesh Kumar" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Company Name</label>
                        <input type="text" name="Company" class="form-control" placeholder="e.g. Rajesh Corp Ltd" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Lead Source</label>
                        <select name="Source" class="form-select" required>
                            <option value="Website Referral">Website Referral</option>
                            <option value="Cold Email">Cold Email</option>
                            <option value="Direct Call">Direct Call</option>
                            <option value="LinkedIn">LinkedIn</option>
                            <option value="Other">Other</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Status</label>
                        <select name="Status" class="form-select" required>
                            <option value="New">New</option>
                            <option value="Contacted">Contacted</option>
                            <option value="Qualified">Qualified</option>
                            <option value="Lost">Lost</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary rounded-pill px-3 btn-sm" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary rounded-pill px-3 btn-sm">Save Lead</button>
                </div>
            </form>
        </div>
    </div>
</div>

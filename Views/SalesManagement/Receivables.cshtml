                            class="receivable-primary-btn"
                            data-bs-toggle="modal"
                            data-bs-target="#createReceivableModal">
                        <i class="fa-solid fa-hand-holding-dollar"></i>
                        <span>Log Payment Receipt</span>
                    </button>
                </div>
            </div>
        </section>

        <!-- Success Message -->
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert receivable-alert alert-dismissible fade show"
                 role="alert">
                <span class="alert-icon">
                    <i class="fa-solid fa-circle-check"></i>
                </span>

                <span>@TempData["SuccessMessage"]</span>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="alert"
                        aria-label="Close"></button>
            </div>
        }

        <!-- KPI Summary -->
        <section class="receivable-kpi-grid">

            <div class="receivable-kpi">
                <div class="kpi-top">
                    <span class="kpi-label">Total Outstanding</span>
                    <span class="kpi-icon blue">
                        <i class="fa-solid fa-wallet"></i>
                    </span>
                </div>

                <h2 class="kpi-value">
                    ₹@(((decimal)(ViewBag.TotalOutstanding ?? 0m)).ToString("N0"))
                </h2>
            </div>

            <div class="receivable-kpi">
                <div class="kpi-top">
                    <span class="kpi-label">Overdue Aging Amount</span>
                    <span class="kpi-icon red">
                        <i class="fa-solid fa-clock"></i>
                    </span>
                </div>

                <h2 class="kpi-value danger">
                    ₹@(((decimal)(ViewBag.OverdueBalance ?? 0m)).ToString("N0"))
                </h2>
            </div>

            <div class="receivable-kpi">
                <div class="kpi-top">
                    <span class="kpi-label">Collected to Date</span>
                    <span class="kpi-icon green">
                        <i class="fa-solid fa-circle-dollar-to-slot"></i>
                    </span>
                </div>

                <h2 class="kpi-value success">
                    ₹@(((decimal)(ViewBag.TotalCollected ?? 0m)).ToString("N0"))
                </h2>
            </div>

            <div class="receivable-kpi">
                <div class="kpi-top">
                    <span class="kpi-label">Open Invoices</span>
                    <span class="kpi-icon indigo">
                        <i class="fa-solid fa-file-invoice"></i>
                    </span>
                </div>

                <h2 class="kpi-value primary">
                    @(ViewBag.ActiveCount ?? Model.Count(r => r.PendingBalance > 0))
                </h2>
            </div>

        </section>

        <!-- Receivables Ledger -->
        <section class="receivable-card">

            <div class="receivable-card-header">
                <h2 class="receivable-section-title">
                    <span class="receivable-section-title-icon">
                        <i class="fa-solid fa-list-check"></i>
                    </span>
                    Receivables Ledger
                </h2>

                <span class="receivable-section-note">
                    Customer invoice balances & aging
                </span>
            </div>

            <div class="receivable-table-wrap">
                <table class="receivable-table">
                    <thead>
                        <tr>
                            <th>Invoice #</th>
                            <th>Customer / Client</th>
                            <th>Invoice Date</th>
                            <th>Due Date</th>
                            <th class="text-end">Total Amount</th>
                            <th class="text-end">Pending Balance</th>
                            <th class="text-center">Aging / Status</th>
                            <th class="text-center">Action</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            @foreach (var rec in Model)
                            {
                                var isOverdue = rec.DueDate.Date < DateTime.Today && rec.PendingBalance > 0;
                                var daysOverdue = (DateTime.Today - rec.DueDate.Date).Days;
                                var daysRemaining = (rec.DueDate.Date - DateTime.Today).Days;

                                <tr>
                                    <!-- Invoice -->
                                    <td>
                                        <span class="invoice-badge">
                                            @rec.InvoiceNumber
                                        </span>
                                    </td>

                                    <!-- Customer -->
                                    <td class="customer-cell">
                                        <div class="customer-name">
                                            @(rec.Customer?.CustomerName ?? rec.CustomerName)
                                        </div>

                                        @if (!string.IsNullOrEmpty(rec.Customer?.CompanyName))
                                        {
                                            <span class="customer-company">
                                                @rec.Customer.CompanyName
                                            </span>
                                        }
                                    </td>

                                    <!-- Invoice Date -->
                                    <td class="date-cell">
                                        @rec.InvoiceDate.ToString("dd MMM yyyy")
                                    </td>

                                    <!-- Due Date -->
                                    <td>
                                        <span class="date-cell @(isOverdue ? "overdue" : "")">
                                            @rec.DueDate.ToString("dd MMM yyyy")
                                        </span>
                                    </td>

                                    <!-- Total -->
                                    <td class="text-end amount-cell">
                                        ₹@rec.TotalAmount.ToString("N2")
                                    </td>

                                    <!-- Pending -->
                                    <td class="text-end pending-cell @(rec.PendingBalance > 0 ? "pending" : "cleared")">
                                        ₹@rec.PendingBalance.ToString("N2")
                                    </td>

                                    <!-- Aging -->
                                    <td class="text-center">
                                        @if (isOverdue)
                                        {
                                            <span class="aging-pill overdue">
                                                <i class="fa-solid fa-triangle-exclamation"></i>
                                                Overdue (@daysOverdue Days)
                                            </span>
                                        }
                                        else if (rec.PendingBalance <= 0)
                                        {
                                            <span class="aging-pill paid">
                                                <i class="fa-solid fa-check"></i>
                                                Paid in Full
                                            </span>
                                        }
                                        else if (rec.Status == "Partially Paid")
                                        {
                                            <span class="aging-pill partial">
                                                <i class="fa-solid fa-clock"></i>
                                                Partially Paid (Due in @daysRemaining d)
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="aging-pill due">
                                                <i class="fa-regular fa-calendar"></i>
                                                Due in @daysRemaining Days
                                            </span>
                                        }
                                    </td>

                                    <!-- Action -->
                                    <td class="text-center">
                                        @if (rec.PendingBalance > 0)
                                        {
                                            <button type="button"
                                                    class="receive-btn"
                                                    onclick="openPaymentModal('@rec.InvoiceNumber', @rec.PendingBalance, '@(rec.Customer?.CustomerName ?? rec.CustomerName)')">
                                                <i class="fa-solid fa-receipt"></i>
                                                Receive
                                            </button>
                                        }
                                        else
                                        {
                                            <span class="cleared-state">
                                                <i class="fa-solid fa-circle-check me-1"></i>
                                                Cleared
                                            </span>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="8">
                                    <div class="receivable-empty">
                                        <div class="receivable-empty-icon">
                                            <i class="fa-solid fa-file-invoice-dollar"></i>
                                        </div>

                                        <h6>No receivable records found</h6>

                                        <p>
                                            There are currently no accounts receivable records to display.
                                        </p>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>

    </div>
</div>

<!-- Log Payment Receipt Modal -->
<div class="modal fade text-start receivable-modal"
     id="createReceivableModal"
     tabindex="-1"
     aria-labelledby="createReceivableModalLabel"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content">

            <form id="paymentReceiptForm"
                  onsubmit="submitPaymentReceipt(event)">

                @Html.AntiForgeryToken()

                <div class="modal-header">

                    <h5 class="modal-title"
                        id="createReceivableModalLabel">

                        <span class="modal-title-icon">
                            <i class="fa-solid fa-hand-holding-dollar"></i>
                        </span>

                        Log Payment Receipt
                    </h5>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal"
                            aria-label="Close"></button>
                </div>

                <div class="modal-body">

                    <!-- Invoice -->
                    <div class="receivable-form-group">

                        <label class="receivable-form-label">
                            Target Invoice No
                            <span class="text-danger">*</span>
                        </label>

                        <select id="modalPayInvoiceNo"
                                name="invoiceNo"
                                class="receivable-form-select"
                                onchange="onInvoiceSelectionChanged()"
                                required>

                            <option value="">
                                -- Select Pending Invoice --
                            </option>

                            @if (Model != null)
                            {
                                foreach (var p in Model.Where(m => m.PendingBalance > 0))
                                {
                                    <option value="@p.InvoiceNumber"
                                            data-balance="@p.PendingBalance"
                                            data-customer="@(p.Customer?.CustomerName ?? p.CustomerName)">
                                        @p.InvoiceNumber - @(p.Customer?.CustomerName ?? p.CustomerName) (Pending: ₹@p.PendingBalance.ToString("N2"))
                                    </option>
                                }
                            }
                        </select>
                    </div>

                    <!-- Invoice Summary -->
                    <div class="receivable-form-group"
                         id="invoiceSummaryBox">

                        <div class="invoice-summary">

                            <div class="invoice-summary-grid">

                                <div>
                                    <span class="summary-label">
                                        Customer
                                    </span>

                                    <strong class="summary-customer"
                                            id="boxCustomer">
                                        --
                                    </strong>
                                </div>

                                <div>
                                    <span class="summary-label">
                                        Maximum Due
                                    </span>

                                    <strong class="summary-balance"
                                            id="boxBalance">
                                        ₹0.00
                                    </strong>
                                </div>

                            </div>

                        </div>
                    </div>

                    <!-- Amount -->
                    <div class="receivable-form-group">

                        <label class="receivable-form-label">
                            Amount Received (₹)
                            <span class="text-danger">*</span>
                        </label>

                        <div class="amount-input-wrap">
                            <span class="currency-symbol">₹</span>

                            <input type="number"
                                   id="modalPayAmount"
                                   name="amountReceived"
                                   class="receivable-form-control fw-bold"
                                   placeholder="0.00"
                                   min="1"
                                   step="0.01"
                                   required />
                        </div>
                    </div>

                    <!-- Payment Mode -->
                    <div class="receivable-form-group">

                        <label class="receivable-form-label">
                            Payment Mode
                            <span class="text-danger">*</span>
                        </label>

                        <select name="paymentMode"
                                class="receivable-form-select"
                                required>

                            <option value="NEFT / RTGS Bank Transfer">
                                NEFT / RTGS Bank Transfer
                            </option>

                            <option value="UPI / IMPS">
                                UPI / IMPS Instant Transfer
                            </option>

                            <option value="Corporate Net Banking">
                                Corporate Net Banking
                            </option>

                            <option value="Cheque Deposit">
                                Cheque Deposit
                            </option>

                            <option value="Cash / Counter Receipt">
                                Cash / Counter Receipt
                            </option>

                        </select>
                    </div>

                    <!-- UTR -->
                    <div class="receivable-form-group">

                        <label class="receivable-form-label">
                            Transaction UTR / Reference #
                            <span class="text-danger">*</span>
                        </label>

                        <input type="text"
                               name="referenceUtr"
                               class="receivable-form-control"
                               placeholder="e.g. UTR928472910482"
                               required />
                    </div>

                </div>

                <div class="modal-footer">

                    <button type="button"
                            class="modal-cancel-btn"
                            data-bs-dismiss="modal">
                        Cancel
                    </button>

                    <button type="submit"
                            class="modal-submit-btn"
                            id="btnSubmitPayment">
                        <i class="fa-solid fa-check-circle me-1"></i>
                        Post Payment Receipt
                    </button>

                </div>

            </form>

        </div>
    </div>
</div>

@section Scripts {
    <script>
        function openPaymentModal(invNo, pendingBalance, customer) {
            const select = document.getElementById('modalPayInvoiceNo');

            select.value = invNo;

            document.getElementById('modalPayAmount').value = pendingBalance;
            document.getElementById('modalPayAmount').max = pendingBalance;

            document.getElementById('boxCustomer').textContent = customer;

            document.getElementById('boxBalance').textContent =
                '₹' + pendingBalance.toLocaleString('en-IN', {
                    minimumFractionDigits: 2
                });

            document.querySelector('#invoiceSummaryBox .invoice-summary').style.display = 'block';

            new bootstrap.Modal(
                document.getElementById('createReceivableModal')
            ).show();
        }

        function onInvoiceSelectionChanged() {
            const select = document.getElementById('modalPayInvoiceNo');
            const selectedOpt = select.options[select.selectedIndex];

            if (selectedOpt && selectedOpt.value) {

                const bal =
                    parseFloat(selectedOpt.getAttribute('data-balance')) || 0;

                const cust =
                    selectedOpt.getAttribute('data-customer') || '';

                document.getElementById('modalPayAmount').value = bal;
                document.getElementById('modalPayAmount').max = bal;

                document.getElementById('boxCustomer').textContent = cust;

                document.getElementById('boxBalance').textContent =
                    '₹' + bal.toLocaleString('en-IN', {
                        minimumFractionDigits: 2
                    });

                document.querySelector('#invoiceSummaryBox .invoice-summary').style.display = 'block';

            } else {

                document.querySelector('#invoiceSummaryBox .invoice-summary').style.display = 'none';

            }
        }

        async function submitPaymentReceipt(event) {
            event.preventDefault();

            const btn = document.getElementById('btnSubmitPayment');

            btn.disabled = true;

            btn.innerHTML =
                '<i class="fa-solid fa-spinner fa-spin me-1"></i> Processing...';

            const form =
                document.getElementById('paymentReceiptForm');

            const formData =
                new FormData(form);

            try {

                const response = await fetch(
                    '/SalesManagement/RecordPaymentReceipt',
                    {
                        method: 'POST',
                        body: formData
                    }
                );

                const res = await response.json();

                if (res.success) {

                    alert(res.message);

                    location.reload();

                } else {

                    alert(
                        res.message ||
                        "Failed to record payment receipt."
                    );

                    btn.disabled = false;

                    btn.innerHTML =
                        '<i class="fa-solid fa-check-circle me-1"></i> Post Payment Receipt';
                }

            } catch (err) {

                alert(
                    "An error occurred while posting payment receipt."
                );

                btn.disabled = false;

                btn.innerHTML =
                    '<i class="fa-solid fa-check-circle me-1"></i> Post Payment Receipt';
            }
        }
    </script>
}

@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Payments & Receivables";
}

<div class="container-fluid py-4 text-start">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-bold mb-1"><i class="fa-solid fa-money-bill-trend-up text-primary me-2"></i>Payments / Receivables</h4>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0 small">
                    <li class="breadcrumb-item"><a href="/SalesDashboard" class="text-decoration-none">Sales Management</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Payments / Receivables</li>
                </ol>
            </nav>
        </div>
        <button class="btn btn-primary rounded-pill px-3 shadow-sm"><i class="fa-solid fa-hand-holding-dollar me-1.5"></i>Log Payment Receipt</button>
    </div>

    <!-- Payments Table -->
    <div class="bg-white border rounded-3 p-4 shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" style="font-size: 0.85rem;">
                <thead class="table-light">
                    <tr>
                        <th>Invoice No</th>
                        <th>Customer</th>
                        <th>Invoice Date</th>
                        <th>Due Date</th>
                        <th>Pending Balance</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td class="fw-bold text-dark">INV-10041</td>
                        <td>Rajesh Corp Ltd</td>
                        <td class="text-muted">10 Aug 2026</td>
                        <td class="text-muted">25 Aug 2026</td>
                        <td class="fw-bold">₹75,000</td>
                        <td><span class="badge bg-warning-subtle text-warning rounded-pill px-2.5 py-1">Pending</span></td>
                    </tr>
                    <tr>
                        <td class="fw-bold text-dark">INV-10042</td>
                        <td>Mehta Logistics</td>
                        <td class="text-muted">05 Aug 2026</td>
                        <td class="text-muted">20 Aug 2026</td>
                        <td class="fw-bold">₹55,250</td>
                        <td><span class="badge bg-danger-subtle text-danger rounded-pill px-2.5 py-1">Overdue</span></td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

@model IEnumerable<ERP_System.Models.PaymentReceipt>
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Payments & Receivables";
    var inCulture = new System.Globalization.CultureInfo("en-IN");
}

<div class="container-fluid py-4 text-start">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-bold mb-1"><i class="fa-solid fa-money-bill-trend-up text-primary me-2"></i>Payments / Receivables</h4>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0 small">
                    <li class="breadcrumb-item"><a href="/SalesDashboard" class="text-decoration-none">Sales Management</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Payments / Receivables</li>
                </ol>
            </nav>
        </div>
        <button class="btn btn-primary rounded-pill px-3 shadow-sm" data-bs-toggle="modal" data-bs-target="#createReceivableModal">
            <i class="fa-solid fa-hand-holding-dollar me-1.5"></i>Log Payment Receipt
        </button>
    </div>

    <!-- Payments Table -->
    <div class="bg-white border rounded-3 p-4 shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" style="font-size: 0.85rem;">
                <thead class="table-light">
                    <tr>
                        <th>Invoice No</th>
                        <th>Customer</th>
                        <th>Invoice Date</th>
                        <th>Due Date</th>
                        <th>Pending Balance</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var rec in Model)
                        {
                            <tr>
                                <td class="fw-bold text-dark">@rec.InvoiceNo</td>
                                <td>@rec.CustomerName</td>
                                <td class="text-muted">@rec.InvoiceDate.ToString("dd MMM yyyy")</td>
                                <td class="text-muted">@rec.DueDate.ToString("dd MMM yyyy")</td>
                                <td class="fw-bold">₹@rec.PendingBalance.ToString("N0", inCulture)</td>
                                <td>
                                    @{
                                        var badgeClass = rec.Status == "Paid" ? "bg-success-subtle text-success" :
                                                         rec.Status == "Overdue" ? "bg-danger-subtle text-danger" :
                                                         "bg-warning-subtle text-warning";
                                    }
                                    <span class="badge @badgeClass rounded-pill px-2.5 py-1">@rec.Status</span>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center py-4 text-muted">No receivables log found in database.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Log Payment Receipt Modal -->
<div class="modal fade text-start" id="createReceivableModal" tabindex="-1" aria-labelledby="createReceivableModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form action="/SalesManagement/CreateReceivable" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title fw-bold" id="createReceivableModalLabel">Log Payment Receivable Receipt</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Invoice No</label>
                        <input type="text" name="InvoiceNo" class="form-control" placeholder="e.g. INV-10041" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Customer Name</label>
                        <input type="text" name="CustomerName" class="form-control" placeholder="e.g. Rajesh Corp Ltd" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Due Date</label>
                        <input type="date" name="DueDate" class="form-control" value="@DateTime.Now.AddDays(15).ToString("yyyy-MM-dd")" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Pending Balance (INR)</label>
                        <input type="number" name="PendingBalance" class="form-control" placeholder="e.g. 75000" min="0" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Status</label>
                        <select name="Status" class="form-select" required>
                            <option value="Pending">Pending</option>
                            <option value="Overdue">Overdue</option>
                            <option value="Paid">Paid</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary rounded-pill px-3 btn-sm" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary rounded-pill px-3 btn-sm">Log Payment</button>
                </div>
            </form>
        </div>
    </div>
</div>

@model IEnumerable<ERP_System.Models.SalesReturn>
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Sales Returns";
    var inCulture = new System.Globalization.CultureInfo("en-IN");
}

<div class="container-fluid py-4 text-start">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-bold mb-1"><i class="fa-solid fa-arrow-rotate-left text-primary me-2"></i>Sales Returns</h4>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0 small">
                    <li class="breadcrumb-item"><a href="/SalesDashboard" class="text-decoration-none">Sales Management</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Sales Returns</li>
                </ol>
            </nav>
        </div>
        <button class="btn btn-primary rounded-pill px-3 shadow-sm" data-bs-toggle="modal" data-bs-target="#createReturnModal">
            <i class="fa-solid fa-clock-rotate-left me-1.5"></i>Log Return
        </button>
    </div>

    <!-- Sales Returns Table -->
    <div class="bg-white border rounded-3 p-4 shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" style="font-size: 0.85rem;">
                <thead class="table-light">
                    <tr>
                        <th>Return ID</th>
                        <th>Original Invoice</th>
                        <th>Customer</th>
                        <th>Return Date</th>
                        <th>Refund Value</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var ret in Model)
                        {
                            <tr>
                                <td class="fw-bold text-dark">@ret.ReturnNo</td>
                                <td>@ret.OriginalInvoiceNo</td>
                                <td>@ret.CustomerName</td>
                                <td class="text-muted">@ret.ReturnDate.ToString("dd MMM yyyy")</td>
                                <td class="fw-bold text-danger">₹@ret.RefundValue.ToString("N0", inCulture)</td>
                                <td>
                                    @{
                                        var badgeClass = ret.Status == "Refunded" ? "bg-success-subtle text-success" :
                                                         ret.Status == "Inspecting" ? "bg-warning-subtle text-warning" :
                                                         "bg-danger-subtle text-danger";
                                    }
                                    <span class="badge @badgeClass rounded-pill px-2.5 py-1">@ret.Status</span>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center py-4 text-muted">No returns found in database.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Log Return Modal -->
<div class="modal fade text-start" id="createReturnModal" tabindex="-1" aria-labelledby="createReturnModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form action="/SalesManagement/CreateReturn" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title fw-bold" id="createReturnModalLabel">Log Customer Sales Return</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Original Invoice No</label>
                        <input type="text" name="OriginalInvoiceNo" class="form-control" placeholder="e.g. INV-10022" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Customer Name</label>
                        <input type="text" name="CustomerName" class="form-control" placeholder="e.g. Rahul Enterprises" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Refund Value (INR)</label>
                        <input type="number" name="RefundValue" class="form-control" placeholder="e.g. 12500" min="0" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Return Status</label>
                        <select name="Status" class="form-select" required>
                            <option value="Inspecting">Inspecting</option>
                            <option value="Refunded">Refunded</option>
                            <option value="Cancelled">Cancelled</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary rounded-pill px-3 btn-sm" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary rounded-pill px-3 btn-sm">Log Return</button>
                </div>
            </form>
        </div>
    </div>
</div>

@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Sales Returns";
}

<div class="container-fluid py-4 text-start">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-bold mb-1"><i class="fa-solid fa-arrow-rotate-left text-primary me-2"></i>Sales Returns</h4>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0 small">
                    <li class="breadcrumb-item"><a href="/SalesDashboard" class="text-decoration-none">Sales Management</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Sales Returns</li>
                </ol>
            </nav>
        </div>
        <button class="btn btn-primary rounded-pill px-3 shadow-sm"><i class="fa-solid fa-clock-rotate-left me-1.5"></i>Log Return</button>
    </div>

    <!-- Sales Returns Table -->
    <div class="bg-white border rounded-3 p-4 shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" style="font-size: 0.85rem;">
                <thead class="table-light">
                    <tr>
                        <th>Return ID</th>
                        <th>Original Invoice</th>
                        <th>Customer</th>
                        <th>Return Date</th>
                        <th>Refund Value</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td class="fw-bold text-dark">SR-7001</td>
                        <td>INV-10022</td>
                        <td>Rahul Enterprises</td>
                        <td class="text-muted">15 Aug 2026</td>
                        <td class="fw-bold text-danger">₹12,500</td>
                        <td><span class="badge bg-success-subtle text-success rounded-pill px-2.5 py-1">Refunded</span></td>
                    </tr>
                    <tr>
                        <td class="fw-bold text-dark">SR-7002</td>
                        <td>INV-10034</td>
                        <td>Mehta Logistics</td>
                        <td class="text-muted">18 Aug 2026</td>
                        <td class="fw-bold text-danger">₹25,000</td>
                        <td><span class="badge bg-warning-subtle text-warning rounded-pill px-2.5 py-1">Inspecting</span></td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

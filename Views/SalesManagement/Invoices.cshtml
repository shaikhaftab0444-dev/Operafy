                            Overall invoice value
                        </div>
                    </div>

                    <div class="invoice-kpi-icon">
                        <i class="fa-solid fa-file-invoice-dollar"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="invoice-kpi invoice-kpi-green">
                <div class="invoice-kpi-top">
                    <div>
                        <div class="invoice-kpi-label">Paid Collections</div>
                        <h3 class="invoice-kpi-value">
                            ₹@(((decimal)(ViewBag.PaidInvoices ?? 0m)).ToString("N0"))
                        </h3>
                        <div class="invoice-kpi-meta">
                            Successfully collected
                        </div>
                    </div>

                    <div class="invoice-kpi-icon">
                        <i class="fa-solid fa-circle-check"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="invoice-kpi invoice-kpi-orange">
                <div class="invoice-kpi-top">
                    <div>
                        <div class="invoice-kpi-label">Pending Balance</div>
                        <h3 class="invoice-kpi-value">
                            ₹@(((decimal)(ViewBag.PendingInvoices ?? 0m)).ToString("N0"))
                        </h3>
                        <div class="invoice-kpi-meta">
                            Awaiting customer payment
                        </div>
                    </div>

                    <div class="invoice-kpi-icon">
                        <i class="fa-solid fa-clock"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="invoice-kpi invoice-kpi-red">
                <div class="invoice-kpi-top">
                    <div>
                        <div class="invoice-kpi-label">Overdue Invoices</div>
                        <h3 class="invoice-kpi-value">
                            ₹@(((decimal)(ViewBag.OverdueInvoices ?? 0m)).ToString("N0"))
                        </h3>
                        <div class="invoice-kpi-meta">
                            Requires collection follow-up
                        </div>
                    </div>

                    <div class="invoice-kpi-icon">
                        <i class="fa-solid fa-triangle-exclamation"></i>
                    </div>
                </div>
            </div>
        </div>

    </div>

    <!-- =====================================================
         FILTERS
         ===================================================== -->
    <div class="invoice-filter-card">

        <div class="invoice-section-heading">
            <h2 class="invoice-section-title">
                <i class="fa-solid fa-sliders"></i>
                Invoice Filters
            </h2>

            <span class="invoice-record-pill">
                <i class="fa-solid fa-filter"></i>
                Refine ledger
            </span>
        </div>

        <form method="get" asp-action="Invoices" class="row g-3 align-items-end">

            <div class="col-12 col-lg-6">
                <label class="invoice-filter-label">
                    Search invoices
                </label>

                <div class="input-group">
                    <span class="input-group-text">
                        <i class="fa-solid fa-magnifying-glass"></i>
                    </span>

                    <input type="text"
                           name="search"
                           value="@ViewBag.SearchTerm"
                           class="form-control"
                           placeholder="Search by invoice #, order #, or customer name..." />
                </div>
            </div>

            <div class="col-12 col-md-6 col-lg-3">
                <label class="invoice-filter-label">
                    Payment status
                </label>

                <select name="status" class="form-select">
                    <option value="All" selected="@(ViewBag.StatusFilter == "All")">
                        All Statuses
                    </option>

                    <option value="Paid" selected="@(ViewBag.StatusFilter == "Paid")">
                        Paid
                    </option>

                    <option value="Pending" selected="@(ViewBag.StatusFilter == "Pending")">
                        Pending
                    </option>

                    <option value="Partially Paid" selected="@(ViewBag.StatusFilter == "Partially Paid")">
                        Partially Paid
                    </option>

                    <option value="Overdue" selected="@(ViewBag.StatusFilter == "Overdue")">
                        Overdue
                    </option>
                </select>
            </div>

            <div class="col-12 col-md-6 col-lg-3">
                <div class="d-flex gap-2">
                    <button type="submit"
                            class="btn invoice-filter-submit flex-grow-1">
                        <i class="fa-solid fa-filter me-1"></i>
                        Filter
                    </button>

                    <a asp-action="Invoices"
                       class="btn btn-outline-secondary invoice-reset-btn">

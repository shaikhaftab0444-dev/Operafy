        </form>
    </div>

    <!-- =====================================================
         INVOICE LEDGER
         ===================================================== -->
    <div class="invoice-table-card">

        <div class="invoice-table-header">

            <div>
                <h2 class="invoice-table-title">
                    <i class="fa-solid fa-list-check text-primary me-2"></i>
                    Invoice Ledger
                </h2>

                <div class="invoice-table-caption">
                    Detailed record of issued sales invoices and payment status.
                </div>
            </div>

            <div class="invoice-record-pill">
                <i class="fa-solid fa-database"></i>
                @((Model?.Count() ?? 0)) Records
            </div>

        </div>

        <div class="invoice-table-wrap">

            <table class="table invoice-table align-middle mb-0">

                <thead>
                    <tr>
                        <th>Invoice #</th>
                        <th>Linked Order #</th>
                        <th>Customer</th>
                        <th>Invoice Date</th>
                        <th>Due Date</th>
                        <th class="text-end">Taxable Value</th>
                        <th class="text-end">GST (18%)</th>
                        <th class="text-end">Grand Total</th>
                        <th class="text-center">Status</th>
                        <th class="text-center">Actions</th>
                    </tr>
                </thead>

                <tbody>

                    @if (Model != null && Model.Any())
                    {
                        foreach (var inv in Model)
                        {
                            var badgeClass =
                            inv.Status == "Paid"
                            ? "invoice-status-paid"
                            : inv.Status == "Partially Paid"
                            ? "invoice-status-partial"
                            : inv.Status == "Pending"
                            ? "invoice-status-pending"
                            : "invoice-status-overdue";

                            var taxable =
                            inv.TaxableValue > 0
                            ? inv.TaxableValue
                            : Math.Round(inv.GrandTotal / 1.18m, 2);

                            var gst =
                            inv.GstAmount > 0
                            ? inv.GstAmount
                            : Math.Round(inv.GrandTotal - taxable, 2);

                            var isOverdue =
                            inv.DueDate.Date < DateTime.Today &&
                            inv.Status != "Paid";

                            <tr>

                                <!-- Invoice Number -->
                                <td>
                                    <span class="invoice-number">
                                        <i class="fa-regular fa-file-lines"></i>
                                        @inv.InvoiceNumber
                                    </span>
                                </td>

                                <!-- Linked Order -->
                                <td>
                                    @{
                                        var orderNo =
                                        inv.SalesOrder?.OrderNumber ??
                                        (!string.IsNullOrEmpty(inv.LinkedOrderNumber)
                                        ? inv.LinkedOrderNumber
                                        : "Direct");
                                    }

                                    @if (orderNo != "Direct")
                                    {
                                        <span class="invoice-order-number">
                                            <i class="fa-solid fa-link me-1 text-primary"></i>
                                            @orderNo
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="invoice-direct">
                                            Direct invoice
                                        </span>
                                    }
                                </td>

                                <!-- Customer -->
                                <td>
                                    <div class="invoice-customer">
                                        @(inv.Customer?.CustomerName ?? inv.CustomerName)
                                    </div>

                                    @if (!string.IsNullOrEmpty(inv.Customer?.CompanyName))
                                    {
                                        <span class="invoice-company">
                                            <i class="fa-regular fa-building me-1"></i>
                                            @inv.Customer.CompanyName
                                        </span>
                                    }
                                </td>

                                <!-- Invoice Date -->
                                <td>
                                    <span class="invoice-date">
                                        <i class="fa-regular fa-calendar me-1"></i>
                                        @inv.InvoiceDate.ToString("dd MMM yyyy")
                                    </span>
                                </td>

                                <!-- Due Date -->
                                <td>
                                    <span class="@(isOverdue ? "text-danger fw-bold" : "invoice-due-date text-muted")">
                                        @inv.DueDate.ToString("dd MMM yyyy")
                                    </span>

                                    @if (isOverdue)
                                    {
                                        <span class="invoice-overdue-label">
                                            <i class="fa-solid fa-triangle-exclamation"></i>
                                            OVERDUE
                                        </span>
                                    }
                                </td>

                                <!-- Taxable -->
                                <td class="text-end">
                                    <span class="invoice-amount">
                                        ₹@taxable.ToString("N2")
                                    </span>
                                </td>

                                <!-- GST -->
                                <td class="text-end">
                                    <span class="invoice-amount">
                                        ₹@gst.ToString("N2")
                                    </span>
                                </td>

                                <!-- Grand Total -->
                                <td class="text-end">
                                    <span class="invoice-total">
                                        ₹@inv.GrandTotal.ToString("N2")
                                    </span>
                                </td>

                                <!-- Status -->
                                <td class="text-center">
                                    <span class="invoice-status @badgeClass">
                                        @inv.Status
                                    </span>
                                </td>

                                <!-- Actions -->
                                <td class="text-center">

                                    <div class="invoice-actions-cell">

                                        <button type="button"
                                                class="btn invoice-icon-btn invoice-view-btn px-2 py-1"
                                                title="View Receipt"
                                                onclick="viewReceiptModal('@inv.InvoiceNumber', '@(inv.Customer?.CustomerName ?? inv.CustomerName)', '@orderNo', '₹@taxable.ToString("N2")', '₹@gst.ToString("N2")', '₹@inv.GrandTotal.ToString("N2")', '@inv.Status', '@inv.InvoiceDate.ToString("dd MMM yyyy")', '@inv.DueDate.ToString("dd MMM yyyy")')">
                                            <i class="fa-regular fa-eye me-1"></i>
                                            View
                                        </button>

                                        <button type="button"
                                                class="btn invoice-icon-btn invoice-pdf-btn px-2 py-1"
                                                title="Download PDF"
                                                onclick="downloadPdfModal('@inv.InvoiceNumber', '@(inv.Customer?.CustomerName ?? inv.CustomerName)', '₹@taxable.ToString("N2")', '₹@gst.ToString("N2")', '₹@inv.GrandTotal.ToString("N2")', '@inv.InvoiceDate.ToString("dd MMM yyyy")')">
                                            <i class="fa-solid fa-download me-1"></i>
                                            PDF
                                        </button>

                                        @if (inv.Status == "Overdue")
                                        {
                                            <button type="button"
                                                    class="btn invoice-action-small invoice-reminder-btn px-2 py-1"
                                                    title="Send Payment Reminder"
                                                    onclick="sendInvoiceReminder('@inv.InvoiceNumber', '@(inv.Customer?.CustomerName ?? inv.CustomerName)')">
                                                <i class="fa-solid fa-bell me-1"></i>
                                                Remind
                                            </button>
                                        }

                                    </div>

                                </td>

                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="10" class="invoice-empty-state text-center">

                                <div class="invoice-empty-icon">
                                    <i class="fa-regular fa-file-lines"></i>
                                </div>

                                <div class="invoice-empty-title">
                                    No sales invoices found
                                </div>

                                <div class="invoice-empty-text">
                                    No invoices match the current search or filter criteria.
                                </div>

                            </td>
                        </tr>
                    }

                </tbody>

            </table>

        </div>
    </div>

</div>

<!-- =========================================================
     RECEIPT MODAL
     ========================================================= -->

@section Scripts {

    <form id="reminderForm"
          asp-action="SendInvoiceReminder"
          method="post"
          style="display:none;">

        @Html.AntiForgeryToken()

        <input type="hidden"
               name="invoiceNo"
               id="reminderInvoiceNo"
               value="" />

    </form>

    <script>

        /* =====================================================
           RECEIPT MODAL
           ===================================================== */

        function viewReceiptModal(
            invNum,
            customer,
            order,
            taxable,
            gst,
            grandTotal,
            status,
            invDate,
            dueDate
        ) {
            document.getElementById('modalInvoiceNum').textContent = invNum;
            document.getElementById('modalCustomerName').textContent = customer;
            document.getElementById('modalLinkedOrder').textContent = order;
            document.getElementById('modalTaxable').textContent = taxable;
            document.getElementById('modalGst').textContent = gst;
            document.getElementById('modalGrandTotal').textContent = grandTotal;
            document.getElementById('modalGrandTotalLarge').textContent = grandTotal;
            document.getElementById('modalStatus').textContent = status;
            document.getElementById('modalInvoiceDate').textContent = invDate;
            document.getElementById('modalDueDate').textContent = dueDate;

            new bootstrap.Modal(
                document.getElementById('invoiceReceiptModal')
            ).show();
        }


        /* =====================================================
           PDF / PRINT
           ===================================================== */

        function downloadPdfModal(
            invNum,
            customer,
            taxable,
            gst,
            grandTotal,
            invDate
        ) {
            viewReceiptModal(
                invNum,
                customer,
                "-",
                taxable,
                gst,
                grandTotal,
                "Paid / Downloaded",
                invDate,
                invDate
            );

            setTimeout(() => {
                window.print();
            }, 400);
        }


        /* =====================================================
           OVERDUE INVOICE REMINDER
           ===================================================== */

        async function sendInvoiceReminder(invNum, customer) {

            if (!confirm(
                `Dispatch automated overdue payment reminder to ${customer} for invoice ${invNum}?`
            )) {
                return;
            }

            const token = document.querySelector(
                '#reminderForm input[name="__RequestVerificationToken"]'
            )?.value;

            const formData = new FormData();

            formData.append('invoiceNo', invNum);

            if (token) {
                formData.append(
                    '__RequestVerificationToken',
                    token
                );
            }

            try {

                const response = await fetch(
                    '/SalesManagement/SendInvoiceReminder',
                    {
                        method: 'POST',
                        body: formData
                    }
                );

                const result = await response.json();

                if (result.success) {
                    alert(result.message);
                }
                else {
                    alert(
                        result.message ||
                        "Failed to send reminder."
                    );
                }

            }
            catch (err) {

                alert(
                    "Reminder dispatch error: " + err
                );

            }
        }

    </script>
}


@model IEnumerable<ERP_System.Models.SalesInvoice>

@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Sales Invoices Ledger";
    var inCulture = new System.Globalization.CultureInfo("en-IN");
}

<style>
    /* =========================================================
           SALES INVOICE LEDGER - SCOPED ERP UI
           ========================================================= */

    .sales-invoice-page {
        --invoice-primary: #2563eb;
        --invoice-primary-dark: #1d4ed8;
        --invoice-success: #16a34a;
        --invoice-warning: #d97706;
        --invoice-danger: #dc2626;
        --invoice-purple: #7c3aed;
        --invoice-text: #172033;
        --invoice-muted: #64748b;
        --invoice-border: #e5eaf1;
        --invoice-surface: #ffffff;
        --invoice-soft: #f6f8fb;
        --invoice-shadow: 0 10px 30px rgba(15, 23, 42, 0.055);
        --invoice-shadow-hover: 0 16px 36px rgba(15, 23, 42, 0.09);
        color: var(--invoice-text);
    }

        .sales-invoice-page * {
            box-sizing: border-box;
        }

    /* Hero */
    .invoice-hero {
        position: relative;
        overflow: hidden;
        background: radial-gradient(circle at 90% 15%, rgba(37, 99, 235, 0.09), transparent 28%), radial-gradient(circle at 70% 100%, rgba(124, 58, 237, 0.06), transparent 30%), #ffffff;
        border: 1px solid var(--invoice-border);
        border-radius: 22px;
        padding: 26px 28px;
        margin-bottom: 22px;
        box-shadow: var(--invoice-shadow);
    }

        .invoice-hero::after {
            content: "";
            position: absolute;
            right: -80px;
            top: -90px;
            width: 230px;
            height: 230px;
            border-radius: 50%;
            border: 28px solid rgba(37, 99, 235, 0.035);
            pointer-events: none;
        }

    .invoice-hero-content {
        position: relative;
        z-index: 2;
    }

    .invoice-title-row {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 20px;
    }

    .invoice-title-icon {
        width: 52px;
        height: 52px;
        min-width: 52px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 15px;
        background: linear-gradient(145deg, #eff6ff, #dbeafe);
        color: var(--invoice-primary);
        font-size: 21px;
        box-shadow: inset 0 1px 0 rgba(255,255,255,.8);
    }

    .invoice-eyebrow {
        color: var(--invoice-primary);
        font-size: .72rem;
        font-weight: 800;
        letter-spacing: .11em;
        text-transform: uppercase;
        margin-bottom: 4px;
    }

    .invoice-page-title {
        color: var(--invoice-text);
        font-size: clamp(1.35rem, 2vw, 1.75rem);
        font-weight: 800;
        letter-spacing: -.025em;
        margin: 0;
    }

    .invoice-page-subtitle {
        color: var(--invoice-muted);
        margin: 6px 0 0;
        font-size: .9rem;
    }

    .invoice-breadcrumb {
        margin-top: 13px;
    }

        .invoice-breadcrumb .breadcrumb {
            margin: 0;
            font-size: .78rem;
        }

        .invoice-breadcrumb a {
            color: var(--invoice-primary);
            font-weight: 600;
        }

    .invoice-actions {
        display: flex;
        align-items: center;
        gap: 9px;
        position: relative;
        z-index: 3;
    }

    .invoice-action-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        min-height: 42px;
        padding: 0 15px;
        border-radius: 11px;
        font-size: .82rem;
        font-weight: 700;
        transition: all .2s ease;
        white-space: nowrap;
    }

        .invoice-action-btn:hover {
            transform: translateY(-1px);
        }

    .invoice-primary-btn {
        background: linear-gradient(135deg, #2563eb, #1d4ed8);
        border: 1px solid #1d4ed8;
        color: #fff;
        box-shadow: 0 7px 16px rgba(37, 99, 235, .17);
    }

        .invoice-primary-btn:hover {
            color: #fff;
            box-shadow: 0 10px 22px rgba(37, 99, 235, .23);
        }

    .invoice-outline-btn {
        background: #fff;
        color: #334155;
        border: 1px solid #dbe2ea;
    }

        .invoice-outline-btn:hover {
            background: #f8fafc;
            color: var(--invoice-primary);
            border-color: #bfdbfe;
        }

    /* Alerts */
    .invoice-success-alert {
        display: flex;
        align-items: center;
        gap: 10px;
        background: #f0fdf4;
        color: #15803d;
        border: 1px solid #bbf7d0;
        border-left: 4px solid #16a34a !important;
        border-radius: 13px;
        padding: 12px 15px;
        box-shadow: 0 5px 18px rgba(22, 163, 74, .05);
    }

    /* KPI cards */
    .invoice-kpi-grid {
        margin-bottom: 22px;
    }

    .invoice-kpi {
        height: 100%;
        position: relative;
        overflow: hidden;
        background: var(--invoice-surface);
        border: 1px solid var(--invoice-border);
        border-radius: 17px;
        padding: 18px;
        box-shadow: var(--invoice-shadow);
        transition: transform .2s ease, box-shadow .2s ease, border-color .2s ease;
    }

        .invoice-kpi:hover {
            transform: translateY(-3px);
            box-shadow: var(--invoice-shadow-hover);
            border-color: #d7dee8;
        }

        .invoice-kpi::after {
            content: "";
            position: absolute;
            width: 80px;
            height: 80px;
            right: -28px;
            bottom: -32px;
            border-radius: 50%;
            background: rgba(37, 99, 235, .035);
        }

    .invoice-kpi-top {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
    }

    .invoice-kpi-icon {
        width: 42px;
        height: 42px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 12px;
        font-size: 17px;
    }

    .invoice-kpi-blue .invoice-kpi-icon {
        color: #2563eb;
        background: #eff6ff;
    }

    .invoice-kpi-green .invoice-kpi-icon {
        color: #16a34a;
        background: #f0fdf4;
    }

    .invoice-kpi-orange .invoice-kpi-icon {
        color: #d97706;
        background: #fffbeb;
    }

    .invoice-kpi-red .invoice-kpi-icon {
        color: #dc2626;
        background: #fef2f2;
    }

    .invoice-kpi-label {
        color: #64748b;
        font-size: .7rem;
        font-weight: 800;
        letter-spacing: .075em;
        text-transform: uppercase;
        margin-bottom: 7px;
    }

    .invoice-kpi-value {
        color: #111827;
        font-size: 1.35rem;
        line-height: 1.15;
        font-weight: 800;
        letter-spacing: -.025em;
        margin: 0;
    }

    .invoice-kpi-meta {
        color: #94a3b8;
        font-size: .72rem;
        margin-top: 7px;
    }

    /* Filter panel */
    .invoice-filter-card {
        background: #fff;
        border: 1px solid var(--invoice-border);
        border-radius: 17px;
        padding: 18px;
        margin-bottom: 22px;
        box-shadow: var(--invoice-shadow);
    }

    .invoice-section-heading {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 15px;
        margin-bottom: 14px;
    }

    .invoice-section-title {
        display: flex;
        align-items: center;
        gap: 9px;
        color: #1e293b;
        font-size: .92rem;
        font-weight: 800;
        margin: 0;
    }

        .invoice-section-title i {
            color: var(--invoice-primary);
        }

    .invoice-filter-label {
        display: block;
        color: #64748b;
        font-size: .72rem;
        font-weight: 700;
        margin-bottom: 6px;
    }

    .invoice-filter-card .input-group-text {
        background: #f8fafc;
        border-color: #dfe5ec;
        color: #64748b;
        border-radius: 11px 0 0 11px;
    }

    .invoice-filter-card .form-control,
    .invoice-filter-card .form-select {
        min-height: 43px;
        border-color: #dfe5ec;
        border-radius: 11px;
        color: #334155;
        font-size: .84rem;
        box-shadow: none;
        transition: border-color .2s ease, box-shadow .2s ease;
    }

    .invoice-filter-card .input-group .form-control {
        border-radius: 0 11px 11px 0;
    }

    .invoice-filter-card .form-control:focus,
    .invoice-filter-card .form-select:focus {
        border-color: #93c5fd;
        box-shadow: 0 0 0 3px rgba(37, 99, 235, .09);
    }

    .invoice-filter-submit {
        min-height: 43px;
        border: 0;
        border-radius: 11px;
        background: linear-gradient(135deg, #2563eb, #1d4ed8);
        color: #fff;
        font-size: .82rem;
        font-weight: 800;
        box-shadow: 0 6px 14px rgba(37, 99, 235, .14);
        transition: all .2s ease;
    }

        .invoice-filter-submit:hover {
            color: #fff;
            transform: translateY(-1px);
            box-shadow: 0 9px 18px rgba(37, 99, 235, .2);
        }

    .invoice-reset-btn {
        min-height: 43px;
        border-radius: 11px;
        font-size: .82rem;
        font-weight: 700;
        border-color: #dfe5ec;
        color: #64748b;
    }

        .invoice-reset-btn:hover {
            background: #f8fafc;
            color: #334155;
        }

    /* Table shell */
    .invoice-table-card {
        background: #fff;
        border: 1px solid var(--invoice-border);
        border-radius: 18px;
        overflow: hidden;
        box-shadow: var(--invoice-shadow);
    }

    .invoice-table-header {
        padding: 18px 20px;
        border-bottom: 1px solid var(--invoice-border);
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 15px;
    }

    .invoice-table-title {
        color: #1e293b;
        font-size: .95rem;
        font-weight: 800;
        margin: 0;
    }

    .invoice-table-caption {
        color: #94a3b8;
        font-size: .74rem;
        margin-top: 3px;
    }

    .invoice-record-pill {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        color: #64748b;
        border-radius: 999px;
        padding: 6px 10px;
        font-size: .72rem;
        font-weight: 700;
    }

    .invoice-table-wrap {
        overflow-x: auto;
    }

    .invoice-table {
        min-width: 1180px;
        margin: 0;
        border-collapse: separate;
        border-spacing: 0;
    }

        .invoice-table thead th {
            background: #f8fafc;
            color: #64748b;
            border-bottom: 1px solid #e2e8f0;
            border-top: 0;
            padding: 13px 14px;
            font-size: .68rem;
            font-weight: 800;
            letter-spacing: .055em;
            text-transform: uppercase;
            white-space: nowrap;
        }

        .invoice-table tbody td {
            color: #475569;
            border-bottom: 1px solid #eef2f6;
            padding: 15px 14px;
            font-size: .8rem;
            vertical-align: middle;
            white-space: nowrap;
        }

        .invoice-table tbody tr {
            transition: background .18s ease;
        }

            .invoice-table tbody tr:hover {
                background: #f8fbff;
            }

            .invoice-table tbody tr:last-child td {
                border-bottom: 0;
            }

    .invoice-number {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        color: #1e40af;
        background: #eff6ff;
        border: 1px solid #dbeafe;
        border-radius: 8px;
        padding: 5px 8px;
        font-size: .72rem;
        font-weight: 800;
    }

    .invoice-order-number {
        display: inline-flex;
        align-items: center;
        color: #475569;
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 7px;
        padding: 5px 8px;
        font-size: .7rem;
        font-weight: 700;
    }

    .invoice-direct {
        color: #94a3b8;
        font-size: .74rem;
        font-style: italic;
    }

    .invoice-customer {
        color: #1e293b;
        font-weight: 750;
        max-width: 185px;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .invoice-company {
        display: block;
        color: #94a3b8;
        font-size: .7rem;
        margin-top: 3px;
        max-width: 185px;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .invoice-date {
        color: #64748b;
        font-size: .75rem;
    }

    .invoice-due-date {
        font-size: .75rem;
        font-weight: 600;
    }

    .invoice-overdue-label {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        margin-left: 5px;
        padding: 3px 6px;
        border-radius: 5px;
        background: #fef2f2;
        border: 1px solid #fecaca;
        color: #dc2626;
        font-size: .57rem;
        font-weight: 900;
        letter-spacing: .03em;
    }

    .invoice-amount {
        color: #475569;
        font-variant-numeric: tabular-nums;
    }

    .invoice-total {
        color: #111827;
        font-weight: 800;
        font-variant-numeric: tabular-nums;
    }

    /* Status */
    .invoice-status {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        border-radius: 999px;
        padding: 6px 9px;
        font-size: .67rem;
        font-weight: 800;
        white-space: nowrap;
    }

        .invoice-status::before {
            content: "";
            width: 6px;
            height: 6px;
            border-radius: 50%;
            background: currentColor;
        }

    .invoice-status-paid {
        color: #15803d;
        background: #f0fdf4;
        border: 1px solid #bbf7d0;
    }

    .invoice-status-partial {
        color: #0284c7;
        background: #f0f9ff;
        border: 1px solid #bae6fd;
    }

    .invoice-status-pending {
        color: #b45309;
        background: #fffbeb;
        border: 1px solid #fde68a;
    }

    .invoice-status-overdue {
        color: #dc2626;
        background: #fef2f2;
        border: 1px solid #fecaca;
    }

    /* Action buttons */
    .invoice-actions-cell {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 5px;
        flex-wrap: wrap;
    }

    .invoice-icon-btn,
    .invoice-action-small {
        min-height: 31px;
        border-radius: 8px;
        font-size: .69rem;
        font-weight: 700;
        transition: all .18s ease;
    }

        .invoice-icon-btn:hover,
        .invoice-action-small:hover {
            transform: translateY(-1px);
        }

    .invoice-view-btn {
        color: #2563eb;
        border-color: #bfdbfe;
        background: #eff6ff;
    }

        .invoice-view-btn:hover {
            color: #1d4ed8;
            background: #dbeafe;
            border-color: #93c5fd;
        }

    .invoice-pdf-btn {
        color: #475569;
        border-color: #dbe2ea;
        background: #fff;
    }

        .invoice-pdf-btn:hover {
            color: #1e293b;
            background: #f8fafc;
        }

    .invoice-reminder-btn {
        color: #fff;
        background: #dc2626;
        border-color: #dc2626;
    }

        .invoice-reminder-btn:hover {
            color: #fff;
            background: #b91c1c;
            border-color: #b91c1c;
        }

    /* Empty state */
    .invoice-empty-state {
        padding: 65px 20px !important;
        white-space: normal !important;
    }

    .invoice-empty-icon {
        width: 58px;
        height: 58px;
        margin: 0 auto 13px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 16px;
        background: #f1f5f9;
        color: #94a3b8;
        font-size: 22px;
    }

    .invoice-empty-title {
        color: #334155;
        font-size: .95rem;
        font-weight: 800;
        margin-bottom: 4px;
    }

    .invoice-empty-text {
        color: #94a3b8;
        font-size: .77rem;
    }

    /* Modal */
    .invoice-modal .modal-content {
        border: 1px solid #e2e8f0;
        border-radius: 20px;
        overflow: hidden;
        box-shadow: 0 25px 70px rgba(15, 23, 42, .16);
    }

    .invoice-modal .modal-header {
        background: linear-gradient(135deg, #f8fafc, #ffffff);
        border-bottom: 1px solid #e5eaf1;
        padding: 17px 20px;
    }

    .invoice-modal-title {
        color: #1e293b;
        font-size: .98rem;
        font-weight: 800;
    }

        .invoice-modal-title i {
            color: var(--invoice-primary);
        }

    .invoice-receipt {
        background: #fff;
        border: 1px solid #e5eaf1;
        border-radius: 15px;
        padding: 20px;
    }

    .invoice-receipt-brand {
        color: #1d4ed8;
        font-size: 1.35rem;
        font-weight: 900;
        letter-spacing: -.03em;
    }

    .invoice-receipt-subtitle {
        color: #64748b;
        font-size: .7rem;
        margin-top: 3px;
    }

    .invoice-receipt-meta {
        color: #64748b;
        font-size: .72rem;
    }

        .invoice-receipt-meta strong {
            color: #1e293b;
        }

    .invoice-receipt-label {
        color: #94a3b8;
        font-size: .63rem;
        font-weight: 900;
        letter-spacing: .08em;
        text-transform: uppercase;
        margin-bottom: 4px;
    }

    .invoice-receipt-customer {
        color: #1e293b;
        font-size: .92rem;
        font-weight: 800;
    }

    .invoice-receipt .table {
        font-size: .76rem;
    }

        .invoice-receipt .table th {
            background: #f8fafc;
            color: #64748b;
            border-color: #e5eaf1;
            font-size: .65rem;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: .04em;
        }

        .invoice-receipt .table td {
            border-color: #e5eaf1;
            color: #475569;
        }

    .invoice-total-panel {
        background: linear-gradient(135deg, #f8fafc, #eff6ff);
        border: 1px solid #dbeafe;
        border-radius: 13px;
        padding: 14px 16px;
    }

    .invoice-total-label {
        color: #64748b;
        font-size: .65rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: .06em;
    }

    .invoice-total-value {
        color: #1d4ed8;
        font-size: 1.45rem;
        font-weight: 900;
    }

    .invoice-modal .modal-footer {
        background: #fafbfc;
        border-top: 1px solid #e5eaf1;
        padding: 13px 18px;
    }

        .invoice-modal .modal-footer .btn {
            border-radius: 9px;
            font-size: .78rem;
            font-weight: 700;
        }

    /* Responsive */
    @@media (max-width: 991.98px) {
        .invoice-title-row

    {
        flex-direction: column;
    }

    .invoice-actions {
        width: 100%;
    }

    .invoice-action-btn {
        flex: 1;
    }

    }

    @@media (max-width: 767.98px) {
        .sales-invoice-page

    {
        padding-top: 1rem !important;
    }

    .invoice-hero {
        padding: 20px;
        border-radius: 17px;
    }

    .invoice-actions {
        flex-direction: column;
    }

    .invoice-action-btn {
        width: 100%;
    }

    .invoice-filter-card {
        padding: 14px;
    }

    .invoice-table-header {
        align-items: flex-start;
        flex-direction: column;
        padding: 15px;
    }

    .invoice-table-card {
        border-radius: 15px;
    }

    .invoice-receipt {
        padding: 14px;
    }

        .invoice-receipt .row > div {
            margin-bottom: 14px;
        }

        .invoice-receipt .text-end {
            text-align: left !important;
        }

    .invoice-total-panel {
        flex-direction: column;
        align-items: flex-start !important;
        gap: 8px;
    }

    }

    @@media (max-width: 575.98px) {
        .invoice-page-title

    {
        font-size: 1.25rem;
    }

    .invoice-page-subtitle {
        font-size: .78rem;
    }

    .invoice-kpi {
        padding: 15px;
    }

    .invoice-kpi-value {
        font-size: 1.18rem;
    }

    .invoice-modal .modal-dialog {
        margin: 10px;
    }

    }

    @@media print {
        body *

    {
        visibility: hidden !important;
    }

    #invoiceReceiptContent,
    #invoiceReceiptContent * {
        visibility: visible !important;
    }

    #invoiceReceiptContent {
        position: absolute;
        left: 0;
        top: 0;
        width: 100%;
        border: 0 !important;
        box-shadow: none !important;
    }

    .invoice-receipt {
        border: 0 !important;
    }

    }

    @@media (prefers-reduced-motion: reduce) {
        .invoice-kpi, .invoice-action-btn, .invoice-filter-submit, .invoice-icon-btn, .invoice-action-small, .invoice-table tbody tr

    {
        transition: none !important;
    }

    }
</style>

<div class="container-fluid py-4 text-start sales-invoice-page">

    <!-- =====================================================
         PAGE HERO
         ===================================================== -->
    <div class="invoice-hero">
        <div class="invoice-hero-content">
            <div class="invoice-title-row">

                <div class="d-flex align-items-start gap-3">
                    <div class="invoice-title-icon">
                        <i class="fa-solid fa-file-invoice-dollar"></i>
                    </div>

                    <div>
                        <div class="invoice-eyebrow">Sales & Receivables</div>

                        <h1 class="invoice-page-title">
                            Sales Invoices Ledger
                        </h1>

                        <p class="invoice-page-subtitle">
                            Monitor issued invoices, collections, outstanding balances and overdue receivables.
                        </p>

                        <div class="invoice-breadcrumb">
                            <nav aria-label="breadcrumb">
                                <ol class="breadcrumb">
                                    <li class="breadcrumb-item">
                                        <a href="/Dashboard" class="text-decoration-none">

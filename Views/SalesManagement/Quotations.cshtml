                    </div>

                    <div class="table-responsive mb-3">
                        <table class="table table-bordered align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th>Description / Line Item</th>
                                    <th class="text-end" style="width: 150px;">SubTotal</th>
                                    <th class="text-end" style="width: 150px;">Discount</th>
                                    <th class="text-end" style="width: 180px;">Net Quoted Total</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td>
                                        <div class="fw-bold">Enterprise Supply Order & Licensing</div>
                                        <small class="text-muted" id="previewRemarks">Standard terms and approved pricing schedule.</small>
                                    </td>
                                    <td class="text-end" id="previewSubTotal">₹0.00</td>
                                    <td class="text-end" id="previewDiscountRate">0%</td>
                                    <td class="text-end fw-bold text-dark fs-6" id="previewTotal">₹0.00</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                    <div class="row justify-content-end">
                        <div class="col-md-5">
                            <div class="d-flex justify-content-between py-1 border-bottom">
                                <span class="text-muted small">SubTotal:</span>
                                <span class="fw-semibold text-dark" id="previewSubTotalRow">₹0.00</span>
                            </div>
                            <div class="d-flex justify-content-between py-1 border-bottom">
                                <span class="text-muted small">Discount Applied:</span>
                                <span class="fw-semibold text-danger" id="previewDiscountRow">0%</span>
                            </div>
                            <div class="d-flex justify-content-between py-2">
                                <span class="fw-bold text-dark">Grand Total:</span>
                                <span class="fw-bold fs-5 text-primary" id="previewTotalRow">₹0.00</span>

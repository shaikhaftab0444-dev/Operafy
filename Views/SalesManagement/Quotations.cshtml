@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Quotations";
}

<div class="container-fluid py-4 text-start">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-bold mb-1"><i class="fa-solid fa-file-signature text-primary me-2"></i>Quotations</h4>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0 small">
                    <li class="breadcrumb-item"><a href="/SalesDashboard" class="text-decoration-none">Sales Management</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Quotations</li>
                </ol>
            </nav>
        </div>
        <button class="btn btn-primary rounded-pill px-3 shadow-sm"><i class="fa-solid fa-file-invoice me-1.5"></i>Create Quotation</button>
    </div>

    <!-- Quotations Table -->
    <div class="bg-white border rounded-3 p-4 shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" style="font-size: 0.85rem;">
                <thead class="table-light">
                    <tr>
                        <th>Quote No</th>
                        <th>Customer</th>
                        <th>Expiry Date</th>
                        <th>Estimated Amount</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td class="fw-bold text-dark">QTN-5011</td>
                        <td>Rajesh Corp Ltd</td>
                        <td class="text-muted">30 Aug 2026</td>
                        <td class="fw-bold">₹1,50,000</td>
                        <td><span class="badge bg-success-subtle text-success rounded-pill px-2.5 py-1">Approved</span></td>
                    </tr>
                    <tr>
                        <td class="fw-bold text-dark">QTN-5012</td>
                        <td>Mehta Logistics</td>
                        <td class="text-muted">15 Sep 2026</td>
                        <td class="fw-bold">₹3,20,000</td>
                        <td><span class="badge bg-warning-subtle text-warning rounded-pill px-2.5 py-1">Sent</span></td>
                    </tr>
                    <tr>
                        <td class="fw-bold text-dark">QTN-5013</td>
                        <td>Global Agencies Ltd</td>
                        <td class="text-muted">25 Aug 2026</td>
                        <td class="fw-bold">₹75,000</td>
                        <td><span class="badge bg-secondary-subtle text-secondary rounded-pill px-2.5 py-1">Draft</span></td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

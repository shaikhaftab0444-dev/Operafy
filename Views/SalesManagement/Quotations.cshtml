                    <div class="d-flex justify-content-between align-items-start border-bottom pb-3 mb-3">
                        <div>
                            <h4 class="fw-bold mb-1" style="color: var(--sq-primary);">Operafy ERP Systems</h4>
                            <p class="text-muted small mb-0">Enterprise Sales & Operations Management</p>
                            <p class="text-muted small mb-0">GSTIN: 27AAAAA0000A1Z5 | Corporate Sales Desk</p>
                        </div>
                        <div class="text-end">
                            <span class="badge bg-primary-subtle text-primary border px-3 py-1.5 fs-6 mb-1" id="previewStatusBadge">Approved</span>
                            <div class="text-muted small" id="previewDate">Date: 22 Sep 2026</div>

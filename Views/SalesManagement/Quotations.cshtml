@model IEnumerable<ERP_System.Models.Quotation>
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Quotations";
    var inCulture = new System.Globalization.CultureInfo("en-IN");
}

<div class="container-fluid py-4 text-start">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-bold mb-1"><i class="fa-solid fa-file-signature text-primary me-2"></i>Quotations</h4>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0 small">
                    <li class="breadcrumb-item"><a href="/SalesDashboard" class="text-decoration-none">Sales Management</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Quotations</li>
                </ol>
            </nav>
        </div>
        <button class="btn btn-primary rounded-pill px-3 shadow-sm" data-bs-toggle="modal" data-bs-target="#createQuotationModal">
            <i class="fa-solid fa-plus me-1.5"></i>Create Quotation
        </button>
    </div>

    <!-- Quotations Table -->
    <div class="bg-white border rounded-3 p-4 shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" style="font-size: 0.85rem;">
                <thead class="table-light">
                    <tr>
                        <th>Quote No</th>
                        <th>Customer</th>
                        <th>Expiry Date</th>
                        <th>Estimated Amount</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var quote in Model)
                        {
                            <tr>
                                <td class="fw-bold text-dark">@quote.QuoteNo</td>
                                <td>@quote.CustomerName</td>
                                <td class="text-muted">@quote.ExpiryDate.ToString("dd MMM yyyy")</td>
                                <td class="fw-bold">₹@quote.EstimatedAmount.ToString("N0", inCulture)</td>
                                <td>
                                    @{
                                        var badgeClass = quote.Status == "Approved" ? "bg-success-subtle text-success" :
                                                         quote.Status == "Sent" ? "bg-warning-subtle text-warning" :
                                                         "bg-secondary-subtle text-secondary";
                                    }
                                    <span class="badge @badgeClass rounded-pill px-2.5 py-1">@quote.Status</span>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center py-4 text-muted">No quotations found in database.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Create Quotation Modal -->
<div class="modal fade text-start" id="createQuotationModal" tabindex="-1" aria-labelledby="createQuotationModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form action="/SalesManagement/CreateQuotation" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title fw-bold" id="createQuotationModalLabel">Create New Quotation</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Customer Name</label>
                        <input type="text" name="CustomerName" class="form-control" placeholder="e.g. Rajesh Corp Ltd" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Estimated Amount (INR)</label>
                        <input type="number" name="EstimatedAmount" class="form-control" placeholder="e.g. 150000" min="0" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Expiry Date</label>
                        <input type="date" name="ExpiryDate" class="form-control" value="@DateTime.Now.AddDays(10).ToString("yyyy-MM-dd")" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Status</label>
                        <select name="Status" class="form-select" required>
                            <option value="Draft">Draft</option>
                            <option value="Sent">Sent</option>
                            <option value="Approved">Approved</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary rounded-pill px-3 btn-sm" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary rounded-pill px-3 btn-sm">Save Quotation</button>
                </div>
            </form>
        </div>
    </div>
</div>

                        </div>
                    </div>
                </div>
            </div>

            <div class="modal-footer bg-light">
                <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Close</button>
                <button type="button" class="btn btn-sm btn-primary px-3 fw-semibold" id="printModalBtn">
                    <i class="fa-solid fa-print me-1"></i> Print / Export PDF
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Live Search & Filtering
            const searchInput = document.getElementById('quotationSearchInput');
            const statusFilter = document.getElementById('statusFilterSelect');
            const resetBtn = document.getElementById('resetFiltersBtn');
            const table = document.getElementById('quotationsTable');
            const rows = table.querySelectorAll('tbody tr[data-status]');

            function filterRows() {
                const query = (searchInput.value || '').toLowerCase().trim();
                const status = (statusFilter.value || '').trim();

                rows.forEach(function (row) {
                    const rowStatus = row.getAttribute('data-status') || '';
                    const quote = (row.getAttribute('data-quote') || '').toLowerCase();
                    const customer = (row.getAttribute('data-customer') || '').toLowerCase();
                    const remarks = (row.getAttribute('data-remarks') || '').toLowerCase();

                    const matchesQuery = !query || quote.includes(query) || customer.includes(query) || remarks.includes(query);
                    const matchesStatus = !status || rowStatus.toLowerCase() === status.toLowerCase();

                    if (matchesQuery && matchesStatus) {
                        row.style.display = '';
                    } else {
                        row.style.display = 'none';
                    }
                });
            }

            if (searchInput) searchInput.addEventListener('input', filterRows);
            if (statusFilter) statusFilter.addEventListener('change', filterRows);
            if (resetBtn) {
                resetBtn.addEventListener('click', function () {
                    if (searchInput) searchInput.value = '';
                    if (statusFilter) statusFilter.value = '';
                    filterRows();
                });
            }

            // Calculation & Discount Policy Trigger in Modal
            const subTotalInput = document.getElementById('modalSubTotal');
            const discountInput = document.getElementById('modalDiscount');
            const totalAmountInput = document.getElementById('modalTotalAmount');
            const banner = document.getElementById('discountAlertBanner');

            function recalculate() {
                const sub = parseFloat(subTotalInput.value) || 0;
                const disc = parseFloat(discountInput.value) || 0;

                const net = sub - (sub * (disc / 100));
                totalAmountInput.value = net > 0 ? net.toFixed(2) : '0.00';

                if (disc > 5.0) {
                    banner.style.display = 'block';
                } else {
                    banner.style.display = 'none';
                }
            }

            if (subTotalInput) subTotalInput.addEventListener('input', recalculate);
            if (discountInput) discountInput.addEventListener('input', recalculate);

            // Preview Modal Handling
            const previewModal = new bootstrap.Modal(document.getElementById('viewQuotationModal'));
            document.querySelectorAll('.view-preview-btn').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    const quote = this.getAttribute('data-quote');
                    const customer = this.getAttribute('data-customer');
                    const subtotal = this.getAttribute('data-subtotal');
                    const discount = this.getAttribute('data-discount');
                    const total = this.getAttribute('data-total');
                    const status = this.getAttribute('data-status');
                    const remarks = this.getAttribute('data-remarks');
                    const date = this.getAttribute('data-date');

                    document.getElementById('previewQuoteNumber').textContent = quote;
                    document.getElementById('previewRefCode').textContent = quote;
                    document.getElementById('previewCustomerName').textContent = customer;
                    document.getElementById('previewSubTotal').textContent = subtotal;
                    document.getElementById('previewSubTotalRow').textContent = subtotal;
                    document.getElementById('previewDiscountRate').textContent = discount + '%';
                    document.getElementById('previewDiscountRow').textContent = discount + '%';
                    document.getElementById('previewTotal').textContent = total;
                    document.getElementById('previewTotalRow').textContent = total;
                    document.getElementById('previewDate').textContent = 'Date: ' + date;
                    document.getElementById('previewStatusBadge').textContent = status;

                    if (remarks && remarks.trim().length > 0) {
                        document.getElementById('previewRemarks').textContent = remarks;
                    } else {
                        document.getElementById('previewRemarks').textContent = 'Standard terms and approved pricing schedule.';
                    }

                    previewModal.show();
                });
            });

            // Print triggers
            const printModalBtn = document.getElementById('printModalBtn');
            if (printModalBtn) {
                printModalBtn.addEventListener('click', function () {
                    const printContent = document.getElementById('printableQuotationArea').innerHTML;
                    const win = window.open('', '', 'height=700,width=900');
                    win.document.write('<html><head><title>Quotation Print</title>');
                    win.document.write('<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />');
                    win.document.write('</head><body class="p-4">');
                    win.document.write(printContent);
                    win.document.write('</body></html>');
                    win.document.close();
                    win.focus();
                    setTimeout(function () { win.print(); }, 400);
                });
            }

            document.querySelectorAll('.print-direct-btn').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    const quote = this.getAttribute('data-quote');
                    const customer = this.getAttribute('data-customer');
                    const subtotal = this.getAttribute('data-subtotal');
                    const discount = this.getAttribute('data-discount');
                    const total = this.getAttribute('data-total');
                    const status = this.getAttribute('data-status');
                    const date = this.getAttribute('data-date');

                    const win = window.open('', '', 'height=700,width=900');
                    win.document.write('<html><head><title>Quotation ' + quote + '</title>');
                    win.document.write('<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />');
                    win.document.write('</head><body class="p-4">');
                    win.document.write('<div class="border p-4 rounded"><div class="d-flex justify-content-between mb-4 border-bottom pb-3"><div><h3 class="fw-bold text-primary">Operafy ERP Systems</h3><p class="text-muted mb-0">Quotation Proposal Reference: ' + quote + '</p></div><div class="text-end"><span class="badge bg-success fs-6">' + status + '</span><div class="text-muted mt-1">' + date + '</div></div></div>');
                    win.document.write('<h5>Issued To: ' + customer + '</h5><table class="table table-bordered mt-3"><thead><tr><th>Description</th><th>SubTotal</th><th>Discount</th><th>Grand Total</th></tr></thead><tbody><tr><td>Standard Enterprise Proposal</td><td>' + subtotal + '</td><td>' + discount + '%</td><td class="fw-bold">' + total + '</td></tr></tbody></table></div>');
                    win.document.write('</body></html>');
                    win.document.close();
                    win.focus();
                    setTimeout(function () { win.print(); }, 400);
                });
            });

            @if (!string.IsNullOrEmpty(preselectedCust))
            {
                <text>
                const createModal = new bootstrap.Modal(document.getElementById('createQuotationModal'));
                createModal.show();
                </text>
            }
        });
    </script>
}

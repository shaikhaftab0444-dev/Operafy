@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Sales Orders";
}

<div class="container-fluid py-4 text-start">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-bold mb-1"><i class="fa-solid fa-folder-open text-primary me-2"></i>Sales Orders</h4>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0 small">
                    <li class="breadcrumb-item"><a href="/SalesDashboard" class="text-decoration-none">Sales Management</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Sales Orders</li>
                </ol>
            </nav>
        </div>
        <button class="btn btn-primary rounded-pill px-3 shadow-sm"><i class="fa-solid fa-cart-plus me-1.5"></i>Create Sales Order</button>
    </div>

    <!-- Sales Orders Table -->
    <div class="bg-white border rounded-3 p-4 shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" style="font-size: 0.85rem;">
                <thead class="table-light">
                    <tr>
                        <th>Order ID</th>
                        <th>Customer</th>
                        <th>Order Date</th>
                        <th>Order Total</th>
                        <th>Delivery Status</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td class="fw-bold text-dark">SO-9041</td>
                        <td>Rahul Enterprises</td>
                        <td class="text-muted">18 Aug 2026</td>
                        <td class="fw-bold">₹1,80,000</td>
                        <td><span class="badge bg-success-subtle text-success rounded-pill px-2.5 py-1">Dispatched</span></td>
                    </tr>
                    <tr>
                        <td class="fw-bold text-dark">SO-9042</td>
                        <td>Sunil Mehta</td>
                        <td class="text-muted">19 Aug 2026</td>
                        <td class="fw-bold">₹4,25,000</td>
                        <td><span class="badge bg-warning-subtle text-warning rounded-pill px-2.5 py-1">Processing</span></td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

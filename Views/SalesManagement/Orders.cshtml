@model IEnumerable<ERP_System.Models.SalesOrder>
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Sales Orders";
    var inCulture = new System.Globalization.CultureInfo("en-IN");
}

<div class="container-fluid py-4 text-start">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-bold mb-1"><i class="fa-solid fa-folder-open text-primary me-2"></i>Sales Orders</h4>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0 small">
                    <li class="breadcrumb-item"><a href="/SalesDashboard" class="text-decoration-none">Sales Management</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Sales Orders</li>
                </ol>
            </nav>
        </div>
        <button class="btn btn-primary rounded-pill px-3 shadow-sm" data-bs-toggle="modal" data-bs-target="#createOrderModal">
            <i class="fa-solid fa-cart-plus me-1.5"></i>Create Sales Order
        </button>
    </div>

    <!-- Sales Orders Table -->
    <div class="bg-white border rounded-3 p-4 shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" style="font-size: 0.85rem;">
                <thead class="table-light">
                    <tr>
                        <th>Order ID</th>
                        <th>Customer</th>
                        <th>Order Date</th>
                        <th>Order Total</th>
                        <th>Delivery Status</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var order in Model)
                        {
                            <tr>
                                <td class="fw-bold text-dark">@order.OrderNo</td>
                                <td>@order.CustomerName</td>
                                <td class="text-muted">@order.OrderDate.ToString("dd MMM yyyy")</td>
                                <td class="fw-bold">₹@order.OrderTotal.ToString("N0", inCulture)</td>
                                <td>
                                    @{
                                        var badgeClass = order.DeliveryStatus == "Delivered" ? "bg-success-subtle text-success" :
                                                         order.DeliveryStatus == "Dispatched" ? "bg-info-subtle text-info" :
                                                         "bg-warning-subtle text-warning";
                                    }
                                    <span class="badge @badgeClass rounded-pill px-2.5 py-1">@order.DeliveryStatus</span>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center py-4 text-muted">No sales orders found in database.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Create Sales Order Modal -->
<div class="modal fade text-start" id="createOrderModal" tabindex="-1" aria-labelledby="createOrderModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form action="/SalesManagement/CreateOrder" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title fw-bold" id="createOrderModalLabel">Create New Sales Order</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Customer Name</label>
                        <input type="text" name="CustomerName" class="form-control" placeholder="e.g. Rahul Enterprises" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Order Total (INR)</label>
                        <input type="number" name="OrderTotal" class="form-control" placeholder="e.g. 180000" min="0" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Delivery Status</label>
                        <select name="DeliveryStatus" class="form-select" required>
                            <option value="Processing">Processing</option>
                            <option value="Dispatched">Dispatched</option>
                            <option value="Delivered">Delivered</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary rounded-pill px-3 btn-sm" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary rounded-pill px-3 btn-sm">Save Order</button>
                </div>
            </form>
        </div>
    </div>
</div>

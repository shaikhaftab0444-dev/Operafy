@model ERP_System.Models.RolePermissionMatrixViewModel

@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Access Rights Matrix";

    var roles = Model.Roles ?? new List<ERP_System.Models.Role>();
    var users = Model.Users ?? new List<ERP_System.Models.UserItemViewModel>();
    var permissions = Model.ModulePermissions ?? new List<ERP_System.Models.ModulePermissionRow>();
    var categories = permissions
        .Select(x => x.Category)
        .Where(x => !string.IsNullOrWhiteSpace(x))
        .Distinct()
        .OrderBy(x => x)
        .ToList();

    bool isUserMode = Model.ActiveMode == "User";
}

<!-- =========================================================
     ACCESS RIGHTS MATRIX (Role + User Specific)
     ========================================================= -->

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" />
<script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<style>
    .rbac-page {
        --rbac-primary: #2563eb;
        --rbac-primary-dark: #1d4ed8;
        --rbac-primary-soft: #eff6ff;
        --rbac-success: #16a34a;
        --rbac-warning: #d97706;
        --rbac-danger: #dc2626;
        --rbac-indigo: #4f46e5;
        --rbac-text: #172033;
        --rbac-muted: #64748b;
        --rbac-border: #e2e8f0;
        --rbac-surface: rgba(255,255,255,.94);
        --rbac-shadow: 0 10px 35px rgba(15,23,42,.07);
        position: relative;
        min-height: 100vh;
        padding-bottom: 60px;
        color: var(--rbac-text);
        font-family: 'Segoe UI', system-ui, sans-serif;
    }

    .rbac-card {
        border: 1px solid rgba(226,232,240,.9);
        border-radius: 18px;
        background: var(--rbac-surface);
        box-shadow: var(--rbac-shadow);
        backdrop-filter: blur(16px);
        margin-bottom: 24px;
    }

    .rbac-role-list, .rbac-user-list {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        max-height: 180px;
        overflow-y: auto;
        padding: 4px;
    }

    .rbac-role-pill, .rbac-user-pill {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 7px 14px !important;
        border: 1px solid #e2e8f0 !important;
        border-radius: 999px !important;
        background: #fff !important;
        color: #475569 !important;
        font-size: .8rem !important;
        font-weight: 600 !important;
        cursor: pointer;
        transition: all .2s ease;
    }

    .rbac-role-pill:hover, .rbac-user-pill:hover {
        border-color: #93c5fd !important;
        background: #f8fafc !important;
        color: #1e40af !important;
        transform: translateY(-1px);
    }

    .rbac-role-pill.active, .rbac-user-pill.active {
        border-color: var(--rbac-primary) !important;
        background: var(--rbac-primary) !important;
        color: #fff !important;
        box-shadow: 0 4px 14px rgba(37,99,235,.28);
    }

    .rbac-toolbar {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 12px;
        padding: 16px 22px;
        border-top: 1px solid #f1f5f9;
        background: #f8fafc;
        border-bottom-left-radius: 18px;
        border-bottom-right-radius: 18px;
    }

    .rbac-save-bar {
        position: sticky;
        bottom: 16px;
        z-index: 100;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        margin: 24px 18px 18px 18px;
        padding: 14px 22px;
        border: 1px solid rgba(226,232,240,.95);
        border-radius: 16px;
        background: rgba(255,255,255,.98);
        backdrop-filter: blur(18px);
        box-shadow: 0 10px 30px rgba(15,23,42,.10), 0 2px 8px rgba(15,23,42,.04);
    }

    .rbac-table-wrapper {
        position: relative;
        overflow-x: auto;
        padding-bottom: 15px;
    }

    .row-hidden {
        display: none !important;
    }

    .rbac-screen-icon {
        width: 36px;
        height: 36px;
        border-radius: 10px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background: rgba(37,99,235,.09);
        color: var(--rbac-primary);
        font-size: 1rem;
        flex-shrink: 0;
    }

    .rbac-switch .form-check-input {
        width: 2.35em;
        height: 1.25em;
        cursor: pointer;
    }
</style>

<div class="container-fluid py-3 px-3 px-xl-4 text-start rbac-page">

    <!-- Header & Mode Switcher -->
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <div class="d-flex align-items-center gap-2 text-secondary small fw-semibold mb-1">
                <a href="/Dashboard" class="text-decoration-none text-muted">Security Control</a>
                <span>/</span>
                <span>Access Rights Matrix</span>
            </div>
            <h1 class="h4 mb-0 fw-bold text-slate-800">
                <i class="fa-solid fa-shield-halved text-primary me-2"></i>Access Rights Matrix
            </h1>
        </div>

        <!-- Mode Switcher: Role vs User Specific -->
        <div class="bg-white p-1.5 rounded-pill border shadow-sm d-flex gap-1">
            <button type="button"
                    class="btn btn-sm rounded-pill px-3 py-1.5 fw-bold @(!isUserMode ? "btn-primary" : "btn-light text-muted")"
                    id="btnModeRole"
                    onclick="switchMatrixMode('Role')">
                <i class="fa-solid fa-users me-1.5"></i>Role Permissions
            </button>
            <button type="button"
                    class="btn btn-sm rounded-pill px-3 py-1.5 fw-bold @(isUserMode ? "btn-primary" : "btn-light text-muted")"
                    id="btnModeUser"
                    onclick="switchMatrixMode('User')">
                <i class="fa-solid fa-user-gear me-1.5"></i>User-Specific Overrides
            </button>
        </div>
    </div>

    <!-- Status Messages -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div id="rbacSuccessMessage" data-message="@TempData["SuccessMessage"]" style="display:none;"></div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div id="rbacErrorMessage" data-message="@TempData["ErrorMessage"]" style="display:none;"></div>
    }

    <!-- Selection Context Card -->
    <div class="rbac-card">
        <div class="p-3 pb-2">
            
            <!-- ROLE SELECTOR BLOCK -->
            <div id="roleSelectorBlock" style="@(isUserMode ? "display:none;" : "display:block;")">
                <div class="small text-uppercase fw-bold text-muted mb-2">
                    <i class="fa-solid fa-shield-cat me-1 text-primary"></i>Select Active Role Context
                </div>
                <div class="rbac-role-list">
                    @foreach (var role in roles)
                    {
                        <button type="button"
                                class="btn rbac-role-pill @(Model.SelectedRoleId == role.RoleId ? "active" : "")"
                                data-role-id="@role.RoleId"
                                data-role-name="@role.RoleName"
                                onclick="switchRole(@role.RoleId, this)">
                            <i class="fa-solid fa-user-gear"></i>
                            <span>@role.RoleName</span>
                        </button>
                    }
                </div>
            </div>

            <!-- USER SELECTOR BLOCK -->
            <div id="userSelectorBlock" style="@(isUserMode ? "display:block;" : "display:none;")">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <div class="small text-uppercase fw-bold text-muted">
                        <i class="fa-solid fa-user-check me-1 text-primary"></i>Select Employee / User Context
                    </div>
                    <form asp-action="ResetUserPermissionsToRole" method="post" class="d-inline" onsubmit="return confirm('Reset this user\'s custom overrides and restore standard role defaults?');">
                        <input type="hidden" name="userId" id="resetUserId" value="@Model.SelectedUserId" />
                        <button type="submit" class="btn btn-outline-danger btn-sm py-0 px-2 fw-semibold" style="font-size: 0.75rem;">
                            <i class="fa-solid fa-rotate-left me-1"></i>Reset to Role Defaults
                        </button>
                    </form>
                </div>
                <div class="rbac-user-list">
                    @foreach (var user in users)
                    {
                        <button type="button"
                                class="btn rbac-user-pill @(Model.SelectedUserId == user.UserId ? "active" : "")"
                                data-user-id="@user.UserId"
                                data-user-name="@user.FullName"
                                data-user-role="@user.RoleName"
                                data-user-role-id="@user.RoleId"
                                onclick="switchUser(@user.UserId, this)">
                            <i class="fa-solid fa-circle-user text-primary"></i>
                            <span>@user.FullName</span>
                            <span class="badge bg-light text-secondary border ms-1" style="font-size:0.68rem;">@user.RoleName</span>
                        </button>
                    }
                </div>
            </div>

        </div>

        <!-- Filter Toolbar -->
        <div class="rbac-toolbar">
            
            <!-- Context Select Dropdown -->
            <div style="width: 28%; min-width: 200px;">
                <select class="form-select form-select-sm" id="roleIdSelect" style="@(isUserMode ? "display:none;" : "display:block;")" onchange="switchRoleDropdown(this)">
                    @foreach (var role in roles)
                    {
                        <option value="@role.RoleId" selected="@(Model.SelectedRoleId == role.RoleId ? "selected" : null)">
                            Role: @role.RoleName
                        </option>
                    }
                </select>

                <select class="form-select form-select-sm" id="userIdSelect" style="@(isUserMode ? "display:block;" : "display:none;")" onchange="switchUserDropdown(this)">
                    @foreach (var user in users)
                    {
                        <option value="@user.UserId" selected="@(Model.SelectedUserId == user.UserId ? "selected" : null)">
                            User: @user.FullName (@user.RoleName)
                        </option>
                    }
                </select>
            </div>

            <!-- Search input -->
            <div class="input-group input-group-sm flex-grow-1" style="min-width: 220px;">
                <span class="input-group-text bg-white"><i class="fa-solid fa-magnifying-glass text-muted"></i></span>
                <input type="text" id="moduleFilter" class="form-control" placeholder="Search screen, module or group..." oninput="filterMatrixRows()" />
            </div>

            <!-- Category Filter -->
            <div style="width: 18%; min-width: 150px;">
                <select class="form-select form-select-sm" id="categoryFilter" onchange="filterMatrixRows()">
                    <option value="">All Access Groups</option>
                    @foreach (var category in categories)
                    {
                        <option value="@category">@category</option>
                    }
                </select>
            </div>

            <!-- Visible counter -->
            <div class="text-muted small fw-bold ms-auto">
                Showing <span class="badge bg-primary px-2" id="visibleCount">@permissions.Count</span>
            </div>
        </div>
    </div>

    <!-- Main Permissions Matrix Card -->
    <div class="rbac-card">
        
        <!-- Header -->
        <div class="p-3 px-4 border-bottom d-flex flex-wrap justify-content-between align-items-center gap-3">
            <div>
                <h2 class="h5 mb-1 fw-bold text-dark">
                    <span id="matrix-mode-label">@(isUserMode ? "User Custom Overrides:" : "Grant Operational Access:")</span>
                    <span id="context-title-display" class="text-primary">@(isUserMode ? Model.SelectedUserName : Model.SelectedRoleName)</span>
                    <span id="user-role-badge" class="badge bg-info-subtle text-info border border-info-subtle ms-2" style="@(isUserMode ? "display:inline-block;" : "display:none;")">@Model.SelectedUserRole</span>
                </h2>
                <p class="text-muted small mb-0" id="context-desc-display">
                    @(isUserMode 
                        ? "Configure direct permission overrides for this employee. Takes precedence over role defaults." 
                        : "Manage screen visibility, record creation, modification, deletion and approval workflows.")
                </p>
            </div>

            <!-- Batch Grants -->
            <div class="d-flex flex-wrap gap-1.5">
                <button type="button" class="btn btn-outline-primary btn-sm px-2.5 fw-semibold" onclick="batchGrantAll('view')">
                    <i class="fa-solid fa-eye me-1"></i>Grant View
                </button>
                <button type="button" class="btn btn-outline-success btn-sm px-2.5 fw-semibold" onclick="batchGrantAll('create')">
                    <i class="fa-solid fa-plus me-1"></i>Grant Create
                </button>
                <button type="button" class="btn btn-outline-info btn-sm px-2.5 fw-semibold" onclick="batchGrantAll('edit')">
                    <i class="fa-solid fa-pen me-1"></i>Grant Edit
                </button>
                <button type="button" class="btn btn-outline-danger btn-sm px-2.5 fw-semibold" onclick="batchClearAll()">
                    <i class="fa-solid fa-eraser me-1"></i>Clear All
                </button>
            </div>
        </div>

        <!-- Form for Submitting Permissions -->
        <form method="post" action="@(isUserMode ? "/RolePermissions/SaveUserPermissions" : "/RolePermissions/SavePermissions")" id="permissionsForm">
            @Html.AntiForgeryToken()

            <input type="hidden" asp-for="ActiveMode" id="ActiveMode" value="@Model.ActiveMode" />
            <input type="hidden" asp-for="SelectedRoleId" id="SelectedRoleId" />
            <input type="hidden" asp-for="SelectedRoleName" id="SelectedRoleName" />
            <input type="hidden" asp-for="SelectedUserId" id="SelectedUserId" />
            <input type="hidden" asp-for="SelectedUserName" id="SelectedUserName" />

            <!-- Table Wrapper -->
            <div class="rbac-table-wrapper px-3 pt-2">
                <table class="table table-hover align-middle mb-0" style="font-size: 0.88rem;">
                    <thead class="table-light">
                        <tr class="text-secondary small text-uppercase fw-bold">
                            <th style="width: 32%;">Operational Screen</th>
                            <th style="width: 14%;">Access Group</th>
                            <th class="text-center" style="width: 10%;">
                                <input type="checkbox" class="form-check-input" id="colHeaderView" onclick="toggleColumnCheckboxes('view', this.checked)" />
                                <label class="d-block small text-muted" for="colHeaderView">View</label>
                            </th>
                            <th class="text-center" style="width: 10%;">
                                <input type="checkbox" class="form-check-input" id="colHeaderCreate" onclick="toggleColumnCheckboxes('create', this.checked)" />
                                <label class="d-block small text-muted" for="colHeaderCreate">Create</label>
                            </th>
                            <th class="text-center" style="width: 10%;">
                                <input type="checkbox" class="form-check-input" id="colHeaderEdit" onclick="toggleColumnCheckboxes('edit', this.checked)" />
                                <label class="d-block small text-muted" for="colHeaderEdit">Edit</label>
                            </th>
                            <th class="text-center" style="width: 10%;">
                                <input type="checkbox" class="form-check-input" id="colHeaderDelete" onclick="toggleColumnCheckboxes('delete', this.checked)" />
                                <label class="d-block small text-muted" for="colHeaderDelete">Delete</label>
                            </th>
                            <th class="text-center" style="width: 10%;">
                                <input type="checkbox" class="form-check-input" id="colHeaderApprove" onclick="toggleColumnCheckboxes('approve', this.checked)" />
                                <label class="d-block small text-muted" for="colHeaderApprove">Approve</label>
                            </th>
                            <th class="text-center" style="width: 4%;">Row</th>
                        </tr>
                    </thead>
                    <tbody id="permissionTableBody">
                        @for (int i = 0; i < permissions.Count; i++)
                        {
                            var row = permissions[i];
                            var iconClass = "fa-window-maximize";
                            var descText = "Operational screen settings";

                            if (row.ModuleName == "UserManagement") { iconClass = "fa-user-shield"; descText = "Configure user access, password policies and role-based rights"; }
                            else if (row.ModuleName == "Company") { iconClass = "fa-building"; descText = "Manage company profile, tax registration and fiscal year setup"; }
                            else if (row.ModuleName == "BranchManagement") { iconClass = "fa-code-branch"; descText = "Configure branches, working schedules and locations"; }
                            else if (row.ModuleName == "Settings") { iconClass = "fa-gears"; descText = "Manage email triggers, backup frequencies and localization"; }
                            else if (row.ModuleName == "HRManagement_DailyAttendance") { iconClass = "fa-calendar-check"; descText = "Track staff clock-in, clock-out, biometric logs and overtime"; }
                            else if (row.ModuleName == "HRManagement_EmployeeDirectory") { iconClass = "fa-address-book"; descText = "Manage staff profiles, contracts and onboarding files"; }
                            else if (row.ModuleName == "HRManagement_LeaveRequests") { iconClass = "fa-umbrella-beach"; descText = "Process employee leave applications and balances"; }
                            else if (row.ModuleName == "HRManagement_MonthlyPayroll") { iconClass = "fa-file-invoice-dollar"; descText = "Generate salary sheets, allowances and tax deductions"; }
                            else if (row.ModuleName == "SupplyChain_InventoryStock") { iconClass = "fa-cubes"; descText = "Manage inventory, low stock alerts and warehouse count"; }
                            else if (row.ModuleName == "SupplyChain_PurchaseOrders") { iconClass = "fa-file-signature"; descText = "Issue purchase orders and track supplier deliveries"; }
                            else if (row.ModuleName == "SupplyChain_GoodsReceipt") { iconClass = "fa-clipboard-check"; descText = "Acknowledge material inward and inspect shipment status"; }
                            else if (row.ModuleName == "SalesCRM_CustomerDirectory") { iconClass = "fa-users-rectangle"; descText = "Manage client database, contacts and credit limits"; }
                            else if (row.ModuleName == "SalesCRM_QuotationsEstimates") { iconClass = "fa-calculator"; descText = "Create price offers, estimates and discount proposals"; }
                            else if (row.ModuleName == "SalesCRM_OrdersInvoicing") { iconClass = "fa-receipt"; descText = "Confirm client orders and generate invoices"; }
                            else if (row.ModuleName == "FinanceAccounts_GeneralLedger") { iconClass = "fa-book-open"; descText = "View double-entry journals and financial transactions"; }
                            else if (row.ModuleName == "FinanceAccounts_ReportsTax") { iconClass = "fa-chart-pie"; descText = "Access trial balance, profit and loss and tax reports"; }

                            <tr class="permission-row"
                                data-module-name="@row.ModuleName"
                                data-category="@row.Category"
                                data-search-text="@($"{row.DisplayName} {row.Category} {row.ModuleName}".ToLowerInvariant())">
                                
                                <td>
                                    <div class="d-flex align-items-center gap-2.5">
                                        <div class="rbac-screen-icon">
                                            <i class="fa-solid @iconClass"></i>
                                        </div>
                                        <div>
                                            <div class="fw-bold text-dark screen-name-title">@row.DisplayName</div>
                                            <div class="small text-muted" style="font-size: 0.74rem;">@descText</div>
                                            <span class="badge bg-light text-secondary border" style="font-size: 0.65rem;">@row.ModuleName</span>

                                            <input type="hidden" asp-for="ModulePermissions[i].ModuleName" />
                                            <input type="hidden" asp-for="ModulePermissions[i].DisplayName" />
                                            <input type="hidden" asp-for="ModulePermissions[i].Category" />
                                        </div>
                                    </div>
                                </td>

                                <td>
                                    <span class="badge bg-light text-dark border">
                                        <i class="fa-solid fa-folder-open me-1 text-primary"></i>@row.Category
                                    </span>
                                </td>

                                <td class="text-center">
                                    <div class="form-check form-switch rbac-switch d-inline-block">
                                        <input class="form-check-input permission-checkbox view-cb" type="checkbox" asp-for="ModulePermissions[i].CanView" onchange="syncRowHeaderStates()" />
                                    </div>
                                </td>

                                <td class="text-center">
                                    <div class="form-check form-switch rbac-switch d-inline-block">
                                        <input class="form-check-input permission-checkbox create-cb" type="checkbox" asp-for="ModulePermissions[i].CanCreate" onchange="syncRowHeaderStates()" />
                                    </div>
                                </td>

                                <td class="text-center">
                                    <div class="form-check form-switch rbac-switch d-inline-block">
                                        <input class="form-check-input permission-checkbox edit-cb" type="checkbox" asp-for="ModulePermissions[i].CanEdit" onchange="syncRowHeaderStates()" />
                                    </div>
                                </td>

                                <td class="text-center">
                                    <div class="form-check form-switch rbac-switch d-inline-block">
                                        <input class="form-check-input permission-checkbox delete-cb" type="checkbox" asp-for="ModulePermissions[i].CanDelete" onchange="syncRowHeaderStates()" />
                                    </div>
                                </td>

                                <td class="text-center">
                                    <div class="form-check form-switch rbac-switch d-inline-block">
                                        <input class="form-check-input permission-checkbox approve-cb" type="checkbox" asp-for="ModulePermissions[i].CanApprove" onchange="syncRowHeaderStates()" />
                                    </div>
                                </td>

                                <td class="text-center">
                                    <button type="button" class="btn btn-light btn-sm p-1 px-2 border rbac-row-toggle" onclick="toggleEntireRow(this)" title="Toggle whole row">
                                        <i class="fa-solid fa-arrows-rotate text-muted"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Sticky Save Bar -->
            <div class="rbac-save-bar">
                <div class="d-flex align-items-center gap-2 text-secondary small">
                    <i class="fa-solid fa-circle-info text-primary"></i>
                    <span>Review permissions carefully before saving. Changes take effect on next request.</span>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <button type="button" class="btn btn-outline-secondary btn-sm px-3" onclick="window.location.reload();">
                        <i class="fa-solid fa-arrow-rotate-left me-1"></i>Reset
                    </button>
                    <button type="submit" class="btn btn-primary btn-sm px-4 fw-bold shadow-sm" id="btnSavePermissions">
                        <span id="btnText"><i class="fa-solid fa-floppy-disk me-1.5"></i>Save Permissions</span>
                        <span id="btnSpinner" class="spinner-border spinner-border-sm me-1.5" role="status" style="display:none;"></span>
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>

<!-- JavaScript Logic -->
<script>
    let activeMode = "@Model.ActiveMode";
    let currentRoleId = @Model.SelectedRoleId;
    let currentRoleName = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.SelectedRoleName ?? ""));
    let currentUserId = @Model.SelectedUserId;
    let currentUserName = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.SelectedUserName ?? ""));

    // Preloaded In-Memory Caches for 0ms Instant Switching
    const allRolePermissionsData = @Html.Raw(ViewBag.AllRolePermissionsJson ?? "[]");
    const allUserPermissionsData = @Html.Raw(ViewBag.AllUserPermissionsJson ?? "[]");

    const rolePermissionsCache = {};
    if (Array.isArray(allRolePermissionsData)) {
        allRolePermissionsData.forEach(p => {
            const rId = p.roleId || p.RoleId;
            if (!rolePermissionsCache[rId]) rolePermissionsCache[rId] = [];
            rolePermissionsCache[rId].push(p);
        });
    }

    const userPermissionsCache = {};
    if (Array.isArray(allUserPermissionsData)) {
        allUserPermissionsData.forEach(p => {
            const uId = p.userId || p.UserId;
            if (!userPermissionsCache[uId]) userPermissionsCache[uId] = [];
            userPermissionsCache[uId].push(p);
        });
    }

    document.addEventListener("DOMContentLoaded", function () {
        syncRowHeaderStates();
        initializeStatusMessages();

        const form = document.getElementById("permissionsForm");
        if (form) {
            form.addEventListener("submit", function () {
                const btnText = document.getElementById("btnText");
                const btnSpinner = document.getElementById("btnSpinner");
                if (btnText) btnText.style.display = "none";
                if (btnSpinner) btnSpinner.style.display = "inline-block";
                setTimeout(function () {
                    const saveButton = document.getElementById("btnSavePermissions");
                    if (saveButton) saveButton.disabled = true;
                }, 20);
            });
        }
    });

    function initializeStatusMessages() {
        const success = document.getElementById("rbacSuccessMessage");
        const error = document.getElementById("rbacErrorMessage");

        if (success && success.dataset.message) {
            Swal.fire({
                icon: "success",
                title: "Permissions Saved",
                text: success.dataset.message,
                confirmButtonColor: "#2563eb"
            });
        }
        if (error && error.dataset.message) {
            Swal.fire({
                icon: "error",
                title: "Error",
                text: error.dataset.message,
                confirmButtonColor: "#dc2626"
            });
        }
    }

    // MODE SWITCHER: Role vs User
    function switchMatrixMode(mode) {
        activeMode = mode;
        document.getElementById("ActiveMode").value = mode;

        const roleBlock = document.getElementById("roleSelectorBlock");
        const userBlock = document.getElementById("userSelectorBlock");
        const roleSelect = document.getElementById("roleIdSelect");
        const userSelect = document.getElementById("userIdSelect");
        const btnRole = document.getElementById("btnModeRole");
        const btnUser = document.getElementById("btnModeUser");
        const modeLabel = document.getElementById("matrix-mode-label");
        const userRoleBadge = document.getElementById("user-role-badge");
        const contextDesc = document.getElementById("context-desc-display");
        const form = document.getElementById("permissionsForm");

        if (mode === "User") {
            roleBlock.style.display = "none";
            userBlock.style.display = "block";
            roleSelect.style.display = "none";
            userSelect.style.display = "block";

            btnUser.className = "btn btn-sm rounded-pill px-3 py-1.5 fw-bold btn-primary";
            btnRole.className = "btn btn-sm rounded-pill px-3 py-1.5 fw-bold btn-light text-muted";

            modeLabel.textContent = "User Custom Overrides:";
            userRoleBadge.style.display = "inline-block";
            contextDesc.textContent = "Configure direct permission overrides for this employee. Takes precedence over role defaults.";
            form.action = "/RolePermissions/SaveUserPermissions";

            // Switch to currently selected user
            const activeUserPill = document.querySelector(".rbac-user-pill.active") || document.querySelector(".rbac-user-pill");
            if (activeUserPill) {
                const uId = activeUserPill.dataset.userId;
                switchUser(uId, activeUserPill);
            }
        } else {
            roleBlock.style.display = "block";
            userBlock.style.display = "none";
            roleSelect.style.display = "block";
            userSelect.style.display = "none";

            btnRole.className = "btn btn-sm rounded-pill px-3 py-1.5 fw-bold btn-primary";
            btnUser.className = "btn btn-sm rounded-pill px-3 py-1.5 fw-bold btn-light text-muted";

            modeLabel.textContent = "Grant Operational Access:";
            userRoleBadge.style.display = "none";
            contextDesc.textContent = "Manage screen visibility, record creation, modification, deletion and approval workflows for the selected role.";
            form.action = "/RolePermissions/SavePermissions";

            // Switch to currently selected role
            const activeRolePill = document.querySelector(".rbac-role-pill.active") || document.querySelector(".rbac-role-pill");
            if (activeRolePill) {
                const rId = activeRolePill.dataset.roleId;
                switchRole(rId, activeRolePill);
            }
        }
    }

    // ROLE SWITCH
    function switchRole(roleId, btnElement, optionalRoleName) {
        roleId = parseInt(roleId);
        if (isNaN(roleId) || roleId <= 0) return;

        let roleName = optionalRoleName;
        if (!roleName && btnElement) roleName = btnElement.dataset?.roleName || btnElement.textContent?.trim();
        if (!roleName) {
            const opt = document.querySelector(`#roleIdSelect option[value="${roleId}"]`);
            roleName = opt ? opt.textContent.replace("Role: ", "").trim() : "Role";
        }

        currentRoleId = roleId;
        currentRoleName = roleName;

        document.querySelectorAll(".rbac-role-pill").forEach(b => b.classList.remove("active"));
        const pill = btnElement || document.querySelector(`.rbac-role-pill[data-role-id="${roleId}"]`);
        if (pill) pill.classList.add("active");

        document.getElementById("SelectedRoleId").value = roleId;
        document.getElementById("SelectedRoleName").value = roleName;
        document.getElementById("context-title-display").textContent = roleName;

        const select = document.getElementById("roleIdSelect");
        if (select && select.value != roleId) select.value = roleId;

        // Instant 0ms apply from cache
        const cachedPerms = rolePermissionsCache[roleId] || [];
        applyPermissionsFromList(cachedPerms);

        if (typeof toastr !== "undefined") {
            toastr.success("Role context: " + roleName, "RBAC", { timeOut: 1200 });
        }
    }

    function switchRoleDropdown(selectElement) {
        const roleId = parseInt(selectElement.value);
        const matchingButton = document.querySelector(`.rbac-role-pill[data-role-id="${roleId}"]`);
        const roleName = selectElement.options[selectElement.selectedIndex]?.text?.replace("Role: ", "")?.trim();
        switchRole(roleId, matchingButton, roleName);
    }

    // USER SWITCH
    function switchUser(userId, btnElement, optionalUserName) {
        userId = parseInt(userId);
        if (isNaN(userId) || userId <= 0) return;

        let userName = optionalUserName;
        let userRole = "";
        let userRoleId = 0;

        if (btnElement) {
            userName = btnElement.dataset?.userName || btnElement.querySelector("span")?.textContent?.trim();
            userRole = btnElement.dataset?.userRole || "";
            userRoleId = parseInt(btnElement.dataset?.userRoleId || "0");
        }
        if (!userName) {
            const opt = document.querySelector(`#userIdSelect option[value="${userId}"]`);
            userName = opt ? opt.textContent.replace("User: ", "").trim() : "User";
        }

        currentUserId = userId;
        currentUserName = userName;

        document.querySelectorAll(".rbac-user-pill").forEach(b => b.classList.remove("active"));
        const pill = btnElement || document.querySelector(`.rbac-user-pill[data-user-id="${userId}"]`);
        if (pill) pill.classList.add("active");

        document.getElementById("SelectedUserId").value = userId;
        document.getElementById("SelectedUserName").value = userName;
        document.getElementById("resetUserId").value = userId;
        document.getElementById("context-title-display").textContent = userName;

        const badge = document.getElementById("user-role-badge");
        if (userRole && badge) {
            badge.textContent = userRole;
            badge.style.display = "inline-block";
        }

        const select = document.getElementById("userIdSelect");
        if (select && select.value != userId) select.value = userId;

        // Instant 0ms apply from cache (fallback to role defaults if user has no custom perms yet)
        let cachedUserPerms = userPermissionsCache[userId];
        if (!cachedUserPerms || cachedUserPerms.length === 0) {
            cachedUserPerms = rolePermissionsCache[userRoleId] || [];
        }
        applyPermissionsFromList(cachedUserPerms);

        if (typeof toastr !== "undefined") {
            toastr.success("User context: " + userName, "User Security", { timeOut: 1200 });
        }
    }

    function switchUserDropdown(selectElement) {
        const userId = parseInt(selectElement.value);
        const matchingButton = document.querySelector(`.rbac-user-pill[data-user-id="${userId}"]`);
        const userName = selectElement.options[selectElement.selectedIndex]?.text?.replace("User: ", "")?.trim();
        switchUser(userId, matchingButton, userName);
    }

    function applyPermissionsFromList(perms) {
        clearAllPermissionCheckboxes();

        if (Array.isArray(perms)) {
            perms.forEach(perm => {
                const moduleName = perm.moduleName || perm.ModuleName;
                if (!moduleName) return;

                const row = document.querySelector(`.permission-row[data-module-name="${moduleName}"]`);
                if (!row) return;

                setCheckboxValue(row.querySelector(".view-cb"), perm.canView ?? perm.CanView);
                setCheckboxValue(row.querySelector(".create-cb"), perm.canCreate ?? perm.CanCreate);
                setCheckboxValue(row.querySelector(".edit-cb"), perm.canEdit ?? perm.CanEdit);
                setCheckboxValue(row.querySelector(".delete-cb"), perm.canDelete ?? perm.CanDelete);
                setCheckboxValue(row.querySelector(".approve-cb"), perm.canApprove ?? perm.CanApprove);
            });
        }

        syncRowHeaderStates();
    }

    function clearAllPermissionCheckboxes() {
        document.querySelectorAll(".permission-checkbox").forEach(cb => cb.checked = false);
    }

    function setCheckboxValue(checkbox, value) {
        if (!checkbox) return;
        checkbox.checked = value === true || value === "true" || value === 1 || value === "1";
    }

    function toggleEntireRow(button) {
        const row = button.closest(".permission-row");
        if (!row) return;
        const checkboxes = row.querySelectorAll(".permission-checkbox");
        if (!checkboxes.length) return;

        let shouldEnable = false;
        checkboxes.forEach(cb => { if (!cb.checked) shouldEnable = true; });
        checkboxes.forEach(cb => { cb.checked = shouldEnable; });

        syncRowHeaderStates();
    }

    function toggleColumnCheckboxes(type, value) {
        const checkboxes = document.querySelectorAll(`.${type}-cb`);
        checkboxes.forEach(cb => {
            const row = cb.closest(".permission-row");
            if (row && !row.classList.contains("row-hidden")) {
                cb.checked = value;
            }
        });
        syncRowHeaderStates();
    }

    function batchGrantAll(type) {
        toggleColumnCheckboxes(type, true);
    }

    function batchClearAll() {
        document.querySelectorAll(".permission-checkbox").forEach(cb => {
            const row = cb.closest(".permission-row");
            if (row && !row.classList.contains("row-hidden")) {
                cb.checked = false;
            }
        });
        syncRowHeaderStates();
    }

    function filterMatrixRows() {
        const query = (document.getElementById("moduleFilter")?.value || "").toLowerCase().trim();
        const category = (document.getElementById("categoryFilter")?.value || "").toLowerCase().trim();
        const rows = document.querySelectorAll(".permission-row");
        let visible = 0;

        rows.forEach(row => {
            const searchText = (row.dataset.searchText || "").toLowerCase();
            const rowCategory = (row.dataset.category || "").toLowerCase();

            const matchesSearch = !query || searchText.includes(query);
            const matchesCategory = !category || rowCategory === category;

            if (matchesSearch && matchesCategory) {
                row.classList.remove("row-hidden");
                visible++;
            } else {
                row.classList.add("row-hidden");
            }
        });

        const counter = document.getElementById("visibleCount");
        if (counter) counter.textContent = visible;
        syncRowHeaderStates();
    }

    function syncRowHeaderStates() {
        ["view", "create", "edit", "delete", "approve"].forEach(type => {
            const header = document.getElementById("colHeader" + type.charAt(0).toUpperCase() + type.slice(1));
            if (!header) return;

            const visibleCheckboxes = Array.from(document.querySelectorAll(`.${type}-cb`))
                .filter(cb => {
                    const row = cb.closest(".permission-row");
                    return row && !row.classList.contains("row-hidden");
                });

            if (!visibleCheckboxes.length) {
                header.checked = false;
                header.indeterminate = false;
                return;
            }

            const checkedCount = visibleCheckboxes.filter(cb => cb.checked).length;
            header.checked = checkedCount === visibleCheckboxes.length;
            header.indeterminate = checkedCount > 0 && checkedCount < visibleCheckboxes.length;
        });
    }
</script>
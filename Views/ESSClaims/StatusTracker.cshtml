@model IEnumerable<ERP_System.Models.ESSExpenseClaim>
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Claim Status Tracker";
}

<div class="container-fluid py-4 text-start">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-bold mb-1"><i class="fa-solid fa-map-location-dot text-primary me-2"></i>Claim Status Tracker</h4>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0 small">
                    <li class="breadcrumb-item"><a href="/EmployeeDashboard" class="text-decoration-none">ESS</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Status Tracker</li>
                </ol>
            </nav>
        </div>
        <a href="/ESSClaims/Submit" class="btn btn-primary rounded-pill px-3 btn-sm shadow-sm">
            <i class="fa-solid fa-plus me-1.5"></i>Submit Expense Claim
        </a>
    </div>

    <!-- Tracker List -->
    <div class="bg-white border rounded-3 p-4 shadow-sm">
        <h5 class="fw-bold mb-3">Reimbursement Progress</h5>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" style="font-size: 0.85rem;">
                <thead class="table-light">
                    <tr>
                        <th>Claim Date</th>
                        <th>Category</th>
                        <th>Amount</th>
                        <th>Status Progress</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var c in Model)
                        {
                            <tr>
                                <td class="text-muted">@c.ClaimDate.ToString("dd MMM yyyy")</td>
                                <td class="fw-bold text-dark">@c.ExpenseType</td>
                                <td class="fw-bold">₹@c.Amount.ToString("N2")</td>
                                <td>
                                    <div class="d-flex align-items-center">
                                        <div class="progress flex-grow-1 me-2" style="height: 6px; width: 120px;">
                                            @if (c.Status == "Approved")
                                            {
                                                <div class="progress-bar bg-success" role="progressbar" style="width: 100%;"></div>
                                            }
                                            else if (c.Status == "Rejected")
                                            {
                                                <div class="progress-bar bg-danger" role="progressbar" style="width: 100%;"></div>
                                            }
                                            else
                                            {
                                                <div class="progress-bar bg-warning" role="progressbar" style="width: 50%;"></div>
                                            }
                                        </div>
                                        <span class="small fw-semibold">
                                            @if (c.Status == "Approved")
                                            {
                                                <span class="text-success">Approved / Processed</span>
                                            }
                                            else if (c.Status == "Rejected")
                                            {
                                                <span class="text-danger">Rejected</span>
                                            }
                                            else
                                            {
                                                <span class="text-warning">Under Review</span>
                                            }
                                        </span>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4" class="text-center py-4 text-muted">No expense claims logged.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

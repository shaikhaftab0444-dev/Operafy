@model IEnumerable<ERP_System.Models.ESSExpenseClaim>
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Claim Status Tracker";
    var claimsList = Model?.ToList() ?? new List<ERP_System.Models.ESSExpenseClaim>();
    var totalAmount = claimsList.Sum(c => c.Amount);
    var pendingCount = claimsList.Count(c => c.Status == "Pending");
    var reimbursedAmount = claimsList.Where(c => c.Status == "Finance Reimbursed" || c.Status == "Approved").Sum(c => c.Amount);
}

<div class="container-fluid py-4 text-start">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-bold mb-1 text-dark"><i class="fa-solid fa-map-location-dot text-primary me-2"></i>Reimbursement Progress &amp; Claims</h4>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0 small">
                    <li class="breadcrumb-item"><a href="/EmployeeDashboard" class="text-decoration-none text-muted">ESS</a></li>
                    <li class="breadcrumb-item active text-primary fw-semibold" aria-current="page">Status Tracker</li>
                </ol>
            </nav>
        </div>
        <a href="@Url.Action("Submit", "ESSClaims")" class="btn btn-primary rounded-pill px-3 shadow-sm">
            <i class="fa-solid fa-plus me-1.5"></i>+ Submit Expense Claim
        </a>
    </div>

    <!-- Quick Stats Cards -->
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-3 p-3 bg-white border-start border-primary border-4">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted small fw-medium text-uppercase">Total Claims Value</div>
                        <div class="fs-4 fw-bold text-dark mt-1">&#8377;@totalAmount.ToString("N2")</div>
                        <div class="small text-muted mt-1">Across @claimsList.Count claim(s)</div>
                    </div>
                    <div class="bg-primary-subtle text-primary p-3 rounded-circle">
                        <i class="fa-solid fa-file-invoice-dollar fa-xl"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-3 p-3 bg-white border-start border-warning border-4">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted small fw-medium text-uppercase">Pending Approvals</div>
                        <div class="fs-4 fw-bold text-warning mt-1">@pendingCount Pending</div>
                        <div class="small text-muted mt-1">Awaiting Manager / Finance</div>
                    </div>
                    <div class="bg-warning-subtle text-warning p-3 rounded-circle">
                        <i class="fa-solid fa-hourglass-half fa-xl"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-3 p-3 bg-white border-start border-success border-4">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted small fw-medium text-uppercase">Total Reimbursed</div>
                        <div class="fs-4 fw-bold text-success mt-1">&#8377;@reimbursedAmount.ToString("N2")</div>
                        <div class="small text-muted mt-1">Direct Bank Settlement</div>
                    </div>
                    <div class="bg-success-subtle text-success p-3 rounded-circle">
                        <i class="fa-solid fa-circle-check fa-xl"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Tracker List -->
    <div class="card border-0 shadow-sm rounded-3 bg-white p-4">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <div>
                <h5 class="fw-bold mb-0 text-dark">Reimbursement Progress</h5>
                <p class="text-muted small mb-0">Track real-time status of your departmental and travel expense reimbursements.</p>
            </div>
            <span class="badge bg-light text-dark border px-3 py-2">
                <i class="fa-solid fa-receipt me-1.5 text-primary"></i>@claimsList.Count Records
            </span>
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" style="font-size: 0.88rem;">
                <thead class="table-light">
                    <tr>
                        <th class="ps-3">Claim Date</th>
                        <th>Category</th>
                        <th>Description</th>
                        <th>Amount</th>
                        <th>Receipt</th>
                        <th class="text-end pe-3">Status Progress</th>
                    </tr>
                </thead>
                <tbody>
                    @if (claimsList.Any())
                    {
                        @foreach (var c in claimsList)
                        {
                            <tr>
                                <td class="ps-3 text-muted">
                                    <i class="fa-regular fa-calendar-days text-primary me-1.5"></i>@c.ClaimDate.ToString("dd MMM yyyy")
                                </td>
                                <td>
                                    <span class="fw-semibold text-dark">@c.ExpenseType</span>
                                </td>
                                <td>
                                    <span class="text-secondary small">@(string.IsNullOrEmpty(c.Description) ? "Standard Claim" : c.Description)</span>
                                </td>
                                <td>
                                    <span class="fw-bold text-dark">&#8377;@c.Amount.ToString("N2")</span>
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(c.ReceiptFileName))
                                    {
                                        <a href="@c.ReceiptFileName" target="_blank" class="btn btn-outline-primary btn-xs rounded-pill px-2.5 shadow-none">
                                            <i class="fa-solid fa-paperclip me-1"></i>View
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">None</span>
                                    }
                                </td>
                                <td class="text-end pe-3">
                                    @if (c.Status == "Pending")
                                    {
                                        <span class="badge bg-warning-subtle text-warning border border-warning-subtle px-2.5 py-1">
                                            <i class="fa-solid fa-clock me-1"></i>Pending Manager Review
                                        </span>
                                    }
                                    else if (c.Status == "Manager Approved")
                                    {
                                        <span class="badge bg-info-subtle text-info border border-info-subtle px-2.5 py-1">
                                            <i class="fa-solid fa-spinner me-1"></i>In Finance Settlement
                                        </span>
                                    }
                                    else if (c.Status == "Finance Reimbursed" || c.Status == "Approved")
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle px-2.5 py-1">
                                            <i class="fa-solid fa-circle-check me-1"></i>Reimbursed
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2.5 py-1">
                                            <i class="fa-solid fa-circle-xmark me-1"></i>Rejected
                                        </span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5">
                                <div class="text-muted mb-3">
                                    <i class="fa-regular fa-folder-open fa-3x"></i>
                                </div>
                                <h6 class="fw-bold text-dark">No expense claims logged yet.</h6>
                                <p class="text-muted small mb-3">Submit your business travel or office purchase bills to claim reimbursement.</p>
                                <a href="@Url.Action("Submit", "ESSClaims")" class="btn btn-primary btn-sm rounded-pill px-3">
                                    <i class="fa-solid fa-plus me-1.5"></i>Submit First Claim
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@model IEnumerable<ERP_System.Models.ESSExpenseClaim>
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Expense Receipts & Invoices";
}

<div class="container-fluid py-4 text-start">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-bold mb-1"><i class="fa-solid fa-receipt text-primary me-2"></i>Expense Receipts & Invoices</h4>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0 small">
                    <li class="breadcrumb-item"><a href="/EmployeeDashboard" class="text-decoration-none">ESS</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Receipts</li>
                </ol>
            </nav>
        </div>
        <a href="/ESSClaims/Submit" class="btn btn-primary rounded-pill px-3 btn-sm shadow-sm">
            <i class="fa-solid fa-plus me-1.5"></i>Submit Expense Claim
        </a>
    </div>

    <!-- Receipts Grid -->
    <div class="bg-white border rounded-3 p-4 shadow-sm">
        <h5 class="fw-bold mb-3">Linked Receipts</h5>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" style="font-size: 0.85rem;">
                <thead class="table-light">
                    <tr>
                        <th>Claim Date</th>
                        <th>Category</th>
                        <th>Amount</th>
                        <th>Receipt Attachment</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var c in Model)
                        {
                            <tr>
                                <td class="text-muted">@c.ClaimDate.ToString("dd MMM yyyy")</td>
                                <td class="fw-bold text-dark">@c.ExpenseType</td>
                                <td class="fw-bold">₹@c.Amount.ToString("N2")</td>
                                <td>
                                    <a href="@c.ReceiptFileName" target="_blank" class="text-decoration-none">
                                        <i class="fa-solid fa-file-invoice text-danger me-1.5"></i>View Attachment
                                    </a>
                                </td>
                                <td>
                                    @if (c.Status == "Approved")
                                    {
                                        <span class="badge bg-success-subtle text-success rounded-pill">Approved</span>
                                    }
                                    else if (c.Status == "Rejected")
                                    {
                                        <span class="badge bg-danger-subtle text-danger rounded-pill">Rejected</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning-subtle text-warning">Pending</span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center py-4 text-muted">No uploaded receipts found.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@model ERP_System.Models.ESSExpenseClaim
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Submit Expense Claim";
}

<div class="container-fluid py-4 text-start">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-bold mb-1 text-dark"><i class="fa-solid fa-wallet text-primary me-2"></i>Submit Expense Claim</h4>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0 small">
                    <li class="breadcrumb-item"><a href="/EmployeeDashboard" class="text-decoration-none text-muted">ESS</a></li>
                    <li class="breadcrumb-item"><a href="/ESSClaims/StatusTracker" class="text-decoration-none text-muted">My Claims</a></li>
                    <li class="breadcrumb-item active text-primary fw-semibold" aria-current="page">Submit Claim</li>
                </ol>
            </nav>
        </div>
    </div>

    <!-- Submit Form -->
    <div class="card border-0 shadow-sm rounded-3 bg-white p-4" style="max-width: 680px;">
        <form action="/ESSClaims/SubmitClaim" method="post" enctype="multipart/form-data">
            @Html.AntiForgeryToken()
            
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label small fw-semibold text-dark">Expense Category <span class="text-danger">*</span></label>
                    <select name="ExpenseType" class="form-select" required>
                        <option value="Travel & Conveyance">Travel &amp; Conveyance</option>
                        <option value="Client Entertainment">Client Entertainment</option>
                        <option value="Office Supplies">Office Supplies</option>
                        <option value="Meals & Food">Meals &amp; Food</option>
                        <option value="Internet / Broadband">Internet / Broadband</option>
                        <option value="Other Expenses">Other Expenses</option>
                    </select>
                </div>

                <div class="col-md-6">
                    <label class="form-label small fw-semibold text-dark">Expense Date <span class="text-danger">*</span></label>
                    <input type="date" name="ClaimDate" class="form-control" value="@DateTime.Today.ToString("yyyy-MM-dd")" required />
                </div>

                <div class="col-12">
                    <label class="form-label small fw-semibold text-dark">Amount (INR &#8377;) <span class="text-danger">*</span></label>
                    <div class="input-group">
                        <span class="input-group-text bg-light text-muted">&#8377;</span>
                        <input type="number" step="0.01" min="1" name="Amount" class="form-control" placeholder="e.g. 2500.00" required />
                    </div>
                </div>

                <div class="col-12">
                    <label class="form-label small fw-semibold text-dark">Business Purpose / Description <span class="text-danger">*</span></label>
                    <textarea name="Description" class="form-control" rows="3" placeholder="Provide business justification, client name, or project details..." required></textarea>
                </div>

                <div class="col-12">
                    <label class="form-label small fw-semibold text-dark">Attach Receipt / Invoice (PDF / JPG / PNG)</label>
                    <input type="file" name="ReceiptFile" class="form-control" accept=".pdf,.jpg,.jpeg,.png,image/*,application/pdf" />
                    <div class="form-text text-muted small">Max file size 5MB. Clear bills/invoices ensure faster reimbursement.</div>
                </div>

                <div class="col-12 mt-4 pt-2 border-top d-flex align-items-center">
                    <button type="submit" class="btn btn-primary rounded-pill px-4 shadow-sm">
                        <i class="fa-solid fa-paper-plane me-1.5"></i>Submit Claim
                    </button>
                    <a href="@Url.Action("StatusTracker", "ESSClaims")" class="btn btn-outline-secondary rounded-pill px-4 ms-2">
                        Cancel
                    </a>
                </div>
            </div>
        </form>
    </div>
</div>

@model ERP_System.Models.ESSExpenseClaim
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Submit Expense Claim";
}

<div class="container-fluid py-4 text-start">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-bold mb-1"><i class="fa-solid fa-wallet text-primary me-2"></i>Submit Expense Claim</h4>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0 small">
                    <li class="breadcrumb-item"><a href="/EmployeeDashboard" class="text-decoration-none">ESS</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Submit Claim</li>
                </ol>
            </nav>
        </div>
    </div>

    <!-- Submit Form -->
    <div class="bg-white border rounded-3 p-4 shadow-sm" style="max-width: 600px;">
        <form action="/ESSClaims/SubmitClaim" method="post" enctype="multipart/form-data">
            @Html.AntiForgeryToken()
            <div class="mb-3">
                <label class="form-label small fw-semibold">Expense Category</label>
                <select name="ExpenseType" class="form-select" required>
                    <option value="Travel">Travel & Conveyance</option>
                    <option value="Food">Meals & Food</option>
                    <option value="Internet">Internet / Broadband</option>
                    <option value="Hardware">Hardware / Office Supplies</option>
                    <option value="Other">Other Expenses</option>
                </select>
            </div>
            <div class="mb-3">
                <label class="form-label small fw-semibold">Amount (INR)</label>
                <input type="number" step="0.01" name="Amount" class="form-control" placeholder="e.g. 1500.00" required />
            </div>
            <div class="mb-3">
                <label class="form-label small fw-semibold">Attach Receipt / Invoice (Optional)</label>
                <input type="file" name="ReceiptFile" class="form-control" accept="image/*,application/pdf" />
            </div>
            <div class="mt-4">
                <button type="submit" class="btn btn-primary rounded-pill px-4 btn-sm"><i class="fa-solid fa-paper-plane me-1.5"></i>Submit Claim</button>
                <a href="/ESSClaims/StatusTracker" class="btn btn-outline-secondary rounded-pill px-4 btn-sm ms-2">Cancel</a>
            </div>
        </form>
    </div>
</div>

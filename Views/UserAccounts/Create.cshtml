@model ERP_System.Controllers.CreateUserViewModel
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Add New User";
}

<style>
    .panel-form {
        background: #ffffff;
        border: 1px solid var(--border-warm);
        border-radius: 12px;
        box-shadow: 0 1px 3px rgba(45,37,30,0.03);
        padding: 2.5rem;
        max-width: 600px;
        margin: 0 auto;
    }

    .form-label-warm {
        font-size: 0.8rem;
        font-weight: 700;
        color: var(--text-color);
        margin-bottom: 6px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .input-group-warm {
        border: 1px solid #d4cbbd;
        border-radius: 8px;
        background-color: #fcfbfa;
        transition: all 0.2s ease-in-out;
        overflow: hidden;
        display: flex;
        align-items: center;
        width: 100%;
    }
    .input-group-warm:focus-within {
        border-color: var(--primary-warm);
        box-shadow: 0 0 0 4px rgba(79, 70, 229, 0.08);
        background-color: #ffffff;
    }

    .input-icon-warm {
        padding: 0.75rem 0.25rem 0.75rem 1rem;
        color: var(--sidebar-color);
        font-size: 0.95rem;
        display: flex;
        align-items: center;
    }

    .form-control-warm, .form-select-warm {
        border: none !important;
        box-shadow: none !important;
        background: transparent !important;
        color: var(--text-color) !important;
        font-size: 0.9rem !important;
        padding: 0.75rem 1rem !important;
        width: 100%;
    }
    .form-control-warm::placeholder {
        color: #a3988b;
    }

    .btn-primary-warm {
        background: linear-gradient(135deg, var(--primary-warm) 0%, #6366f1 100%);
        color: #ffffff;
        border: none;
        padding: 0.75rem 2rem;
        border-radius: 8px;
        font-weight: 600;
        font-size: 0.9rem;
        box-shadow: 0 4px 10px rgba(79, 70, 229, 0.2);
        transition: all 0.2s;
    }
    .btn-primary-warm:hover {
        transform: translateY(-1px);
        box-shadow: 0 6px 14px rgba(79, 70, 229, 0.3);
        color: #ffffff;
    }

    .btn-secondary-warm {
        border: 1px solid var(--border-warm);
        background-color: #ffffff;
        color: var(--text-color);
        padding: 0.75rem 2rem;
        border-radius: 8px;
        font-weight: 600;
        font-size: 0.9rem;
        transition: all 0.2s;
    }
    .btn-secondary-warm:hover {
        background-color: #faf8f5;
        border-color: #cbd5e1;
    }

    .text-danger-custom {
        color: #dc2626;
        font-size: 0.8rem;
        margin-top: 4px;
        font-weight: 500;
    }

    .password-toggle-warm {
        border: none;
        background: transparent;
        padding: 0 12px;
        cursor: pointer;
        color: inherit;
        display: flex;
        align-items: center;
        justify-content: center;
    }

        .password-toggle-warm:focus {
            outline: none;
        }
</style>

<!-- Breadcrumbs & Header -->
<div class="mb-4 text-center">
    <h4 class="fw-bold mb-1" style="color: var(--text-color);">Add New User Account</h4>
    <nav aria-label="breadcrumb" class="d-inline-block">
        <ol class="breadcrumb mb-0 small">
            <li class="breadcrumb-item"><a href="/Dashboard" class="text-decoration-none">Dashboard</a></li>
            <li class="breadcrumb-item"><a href="/Users" class="text-decoration-none">Users</a></li>
            <li class="breadcrumb-item active" aria-current="page">Add New</li>
        </ol>
    </nav>
</div>

<!-- Form Card -->
<div class="panel-form">
    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()
        
        <div asp-validation-summary="ModelOnly" class="text-danger-custom mb-3 text-start"></div>

        <!-- Full Name -->
        <div class="mb-3 text-start">
            <label asp-for="FullName" class="form-label-warm">Full Name</label>
            <div class="input-group-warm">
                <span class="input-icon-warm">
                    <i class="fa-regular fa-user"></i>
                </span>
                <input asp-for="FullName" class="form-control-warm" placeholder="John Doe" />
            </div>
            <span asp-validation-for="FullName" class="text-danger-custom d-block"></span>
        </div>

        <!-- Username -->
        <div class="mb-3 text-start">
            <label asp-for="UserName" class="form-label-warm">Username</label>
            <div class="input-group-warm">
                <span class="input-icon-warm">
                    <i class="fa-solid fa-at"></i>
                </span>
                <input asp-for="UserName" class="form-control-warm" placeholder="johndoe" />
            </div>
            <span asp-validation-for="UserName" class="text-danger-custom d-block"></span>
        </div>

        <!-- Email -->
        <div class="mb-3 text-start">
            <label asp-for="Email" class="form-label-warm">Email Address</label>
            <div class="input-group-warm">
                <span class="input-icon-warm">
                    <i class="fa-regular fa-envelope"></i>
                </span>
                <input asp-for="Email" class="form-control-warm" placeholder="johndoe@company.com" />
            </div>
            <span asp-validation-for="Email" class="text-danger-custom d-block"></span>
        </div>

        <!-- Mobile Number -->
        <div class="mb-3 text-start">
            <label asp-for="MobileNumber" class="form-label-warm">Mobile Number</label>
            <div class="input-group-warm">
                <span class="input-icon-warm">
                    <i class="fa-solid fa-phone"></i>
                </span>
                <input asp-for="MobileNumber" class="form-control-warm" placeholder="9876543210" />
            </div>
            <span asp-validation-for="MobileNumber" class="text-danger-custom d-block"></span>
        </div>

        <!-- Password -->
        <div class="mb-3 text-start">
            <label asp-for="Password" class="form-label-warm">Password</label>

            <div class="input-group-warm">
                <span class="input-icon-warm">
                    <i class="fa-solid fa-lock"></i>
                </span>

                <input asp-for="Password"
                       type="password"
                       id="Password"
                       class="form-control-warm"
                       placeholder="••••••••" />

                <!-- Show Password Button -->
                <button type="button"
                        class="password-toggle-warm"
                        id="togglePassword"
                        aria-label="Show password">
                    <i class="fa-solid fa-eye" id="passwordEye"></i>
                </button>
            </div>

            <span asp-validation-for="Password"
                  class="text-danger-custom d-block"></span>
        </div>

        <!-- Role -->
        <div class="mb-4 text-start">
            <label asp-for="RoleId" class="form-label-warm">System Role</label>
            <div class="input-group-warm">
                <span class="input-icon-warm">
                    <i class="fa-solid fa-shield-halved"></i>
                </span>
                <select asp-for="RoleId" class="form-select-warm" style="cursor: pointer;">
                    <option value="" disabled selected>-- Select System Role --</option>
                    @if (ViewBag.Roles != null)
                    {
                        foreach (var role in (IEnumerable<ERP_System.Models.Role>)ViewBag.Roles)
                        {
                            <option value="@role.RoleId">@role.RoleName (@role.Description)</option>
                        }
                    }
                </select>
            </div>
            <span asp-validation-for="RoleId" class="text-danger-custom d-block"></span>
        </div>

        <!-- Form Buttons -->
        <div class="d-flex justify-content-end gap-3 mt-4">
            <a href="/Users" class="btn btn-secondary-warm">
                Cancel
            </a>
            <button type="submit" class="btn btn-primary-warm">
                Create User
            </button>
        </div>
    </form>
</div>

<script>
    document.getElementById("togglePassword").addEventListener("click", function () {

        const passwordInput = document.getElementById("Password");
        const eyeIcon = document.getElementById("passwordEye");

        if (passwordInput.type === "password") {

            passwordInput.type = "text";

            eyeIcon.classList.remove("fa-eye");
            eyeIcon.classList.add("fa-eye-slash");

            this.setAttribute("aria-label", "Hide password");

        } else {

            passwordInput.type = "password";

            eyeIcon.classList.remove("fa-eye-slash");
            eyeIcon.classList.add("fa-eye");

            this.setAttribute("aria-label", "Show password");
        }
    });
</script>

@model IEnumerable<ERP_System.Models.SuperAdminRestorePoint>
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Database Restore Points";
}

<div class="container-fluid py-4 text-start">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-bold mb-1"><i class="fa-solid fa-clock-rotate-left text-primary me-2"></i>Database Restore Points</h4>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0 small">
                    <li class="breadcrumb-item"><a href="/SuperAdminDashboard" class="text-decoration-none">Dashboard</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Restore Points</li>
                </ol>
            </nav>
        </div>
        <button class="btn btn-primary rounded-pill px-3 btn-sm shadow-sm" data-bs-toggle="modal" data-bs-target="#rpModal">
            <i class="fa-solid fa-plus me-1.5"></i>Create Restore Point
        </button>
    </div>

    <!-- Restore Points List -->
    <div class="bg-white border rounded-3 p-4 shadow-sm" style="max-width: 800px;">
        <h5 class="fw-bold mb-3">Restore Point Archive</h5>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" style="font-size: 0.85rem;">
                <thead class="table-light">
                    <tr>
                        <th>Point Name</th>
                        <th>Created At</th>
                        <th>Description</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var r in Model)
                        {
                            <tr>
                                <td class="fw-bold text-dark">@r.PointName</td>
                                <td class="text-muted">@r.CreatedAt.ToString("dd MMM yyyy hh:mm tt")</td>
                                <td>@r.Description</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Restore Point Modal -->
<div class="modal fade text-start" id="rpModal" tabindex="-1" aria-labelledby="rpModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form action="/SuperAdminMaintenance/CreateRestorePoint" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title fw-bold" id="rpModalLabel">Create Restore Point</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Restore Point Name</label>
                        <input type="text" name="PointName" class="form-control" placeholder="e.g. FY-26 Compliance Launch" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Description / Scope Details</label>
                        <textarea name="Description" class="form-control" rows="3" placeholder="Identify snapshot scope..." required></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary rounded-pill px-3 btn-sm" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary rounded-pill px-3 btn-sm">Save Point</button>
                </div>
            </form>
        </div>
    </div>
</div>

@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Cache & Temp Storage Purging";
}

<div class="container-fluid py-4 text-start" style="max-width: 600px;">
    <div class="mb-4">
        <h4 class="fw-bold mb-1"><i class="fa-solid fa-broom text-primary me-2"></i>Cache & Temp Storage Purging</h4>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0 small">
                <li class="breadcrumb-item"><a href="/SuperAdminDashboard" class="text-decoration-none">Dashboard</a></li>
                <li class="breadcrumb-item active" aria-current="page">Cache Purging</li>
            </ol>
        </nav>
    </div>

    <!-- Purge Utility -->
    <div class="bg-white border rounded-3 p-4 shadow-sm mb-4">
        <h5 class="fw-bold mb-3">Temporary Storage Space Cleaners</h5>
        <div class="row g-3">
            <div class="col-md-6">
                <div class="p-3 border rounded text-center bg-light">
                    <h6 class="fw-bold mb-2">Purge Session Logs</h6>
                    <button class="btn btn-sm btn-outline-danger rounded-pill px-3" onclick="alert('Session cache cleared successfully!')"><i class="fa-solid fa-trash me-1"></i> Clean Logs</button>
                </div>
            </div>
            <div class="col-md-6">
                <div class="p-3 border rounded text-center bg-light">
                    <h6 class="fw-bold mb-2">Purge Temp Uploads</h6>
                    <button class="btn btn-sm btn-outline-danger rounded-pill px-3" onclick="alert('Temp upload directories purged!')"><i class="fa-solid fa-trash-can me-1"></i> Clean Files</button>
                </div>
            </div>
        </div>
    </div>
</div>

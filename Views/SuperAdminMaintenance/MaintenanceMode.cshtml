@model ERP_System.Models.SuperAdminMaintenance
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Maintenance Mode Setup";
}

<div class="container-fluid py-4 text-start" style="max-width: 700px;">
    <div class="mb-4">
        <h4 class="fw-bold mb-1"><i class="fa-solid fa-screwdriver-wrench text-primary me-2"></i>Maintenance Mode Setup</h4>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0 small">
                <li class="breadcrumb-item"><a href="/SuperAdminDashboard" class="text-decoration-none">Dashboard</a></li>
                <li class="breadcrumb-item active" aria-current="page">Maintenance Mode</li>
            </ol>
        </nav>
    </div>

    <!-- Toggle Form -->
    <div class="bg-white border rounded-3 p-4 shadow-sm mb-4">
        <h5 class="fw-bold mb-3">Service Maintenance Configs</h5>
        <form action="/SuperAdminMaintenance/ToggleMaintenance" method="post">
            @Html.AntiForgeryToken()
            <div class="mb-3">
                <label class="form-label small fw-semibold">Maintenance Mode State</label>
                <select name="IsMaintenanceMode" class="form-select">
                    <option value="false" selected="@(Model?.IsMaintenanceMode == false ? "selected" : null)">Disabled (Public Access Active)</option>
                    <option value="true" selected="@(Model?.IsMaintenanceMode == true ? "selected" : null)">Enabled (Platform Access Locked)</option>
                </select>
            </div>
            <div class="mb-4">
                <label class="form-label small fw-semibold">Custom Maintenance Message</label>
                <textarea name="CustomMessage" class="form-control" rows="4" required>@(Model?.CustomMessage ?? "ERP portal is currently undergoing scheduled platform updates. Please check back in 30 minutes.")</textarea>
            </div>
            <button type="submit" class="btn btn-primary rounded-pill px-4">Save Maintenance Configurations</button>
        </form>
    </div>
</div>

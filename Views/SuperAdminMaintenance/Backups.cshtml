@model IEnumerable<ERP_System.Models.AdminBackupLog>
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Database Backups";
}

<div class="container-fluid py-4 text-start">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-bold mb-1"><i class="fa-solid fa-database text-primary me-2"></i>Database Backup History</h4>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0 small">
                    <li class="breadcrumb-item"><a href="/SuperAdminDashboard" class="text-decoration-none">Dashboard</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Backups</li>
                </ol>
            </nav>
        </div>
        <form action="/SuperAdminMaintenance/CreateBackup" method="post">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-primary rounded-pill px-3 btn-sm shadow-sm">
                <i class="fa-solid fa-rotate me-1.5"></i>Trigger Manual Backup
            </button>
        </form>
    </div>

    <!-- Backups Grid -->
    <div class="bg-white border rounded-3 p-4 shadow-sm" style="max-width: 800px;">
        <h5 class="fw-bold mb-3">Backup Archive Catalog</h5>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" style="font-size: 0.85rem;">
                <thead class="table-light">
                    <tr>
                        <th>Backup Filename</th>
                        <th>File Size</th>
                        <th>Created At</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var log in Model)
                        {
                            <tr>
                                <td class="fw-bold text-dark">@log.Filename</td>
                                <td>@log.BackupSize</td>
                                <td class="text-muted">@log.CreatedAt.ToString("dd MMM yyyy hh:mm tt")</td>
                                <td>
                                    @if (log.Status == "Success")
                                    {
                                        <span class="badge bg-success-subtle text-success rounded-pill px-2.5">Success</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger-subtle text-danger rounded-pill px-2.5">Failed</span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

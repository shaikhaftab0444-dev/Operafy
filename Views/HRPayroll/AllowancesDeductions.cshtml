@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Allowances & Deductions Master";
}

<div class="container-fluid py-4 text-start">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-bold mb-1"><i class="fa-solid fa-percent text-primary me-2"></i>Allowances & Deductions</h4>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0 small">
                    <li class="breadcrumb-item"><a href="/HR" class="text-decoration-none">HR Dashboard</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Allowances & Deductions</li>
                </ol>
            </nav>
        </div>
        <button class="btn btn-primary rounded-pill px-3 btn-sm shadow-sm"><i class="fa-solid fa-plus me-1.5"></i>Create Component</button>
    </div>

    <!-- Components Table -->
    <div class="bg-white border rounded-3 p-4 shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" style="font-size: 0.85rem;">
                <thead class="table-light">
                    <tr>
                        <th>Component Name</th>
                        <th>Type</th>
                        <th>Taxability</th>
                        <th>Calculation Basis</th>
                        <th>Default Amount/Rate</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td class="fw-bold text-dark">House Rent Allowance (HRA)</td>
                        <td><span class="badge bg-success-subtle text-success">Allowance</span></td>
                        <td>Partially Exempt</td>
                        <td>Percentage of Basic</td>
                        <td>40% / 50%</td>
                        <td>Active</td>
                    </tr>
                    <tr>
                        <td class="fw-bold text-dark">Professional Tax (PT)</td>
                        <td><span class="badge bg-danger-subtle text-danger">Deduction</span></td>
                        <td>Fully Deductible</td>
                        <td>Slab Based (State Law)</td>
                        <td>₹200 / month</td>
                        <td>Active</td>
                    </tr>
                    <tr>
                        <td class="fw-bold text-dark">Conveyance Allowance</td>
                        <td><span class="badge bg-success-subtle text-success">Allowance</span></td>
                        <td>Fully Taxable</td>
                        <td>Fixed Value</td>
                        <td>₹1,600 / month</td>
                        <td>Active</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

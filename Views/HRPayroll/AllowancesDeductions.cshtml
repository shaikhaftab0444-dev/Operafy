@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Allowances & Deductions Master";
    var allowances = ViewBag.Allowances as List<ERP_System.Models.AllowanceDeductionMaster> ?? new List<ERP_System.Models.AllowanceDeductionMaster>();
    var deductions = ViewBag.Deductions as List<ERP_System.Models.AllowanceDeductionMaster> ?? new List<ERP_System.Models.AllowanceDeductionMaster>();
}

<style>
    .component-page {
        position: relative;
        animation: componentPageFadeIn .6s ease;
    }

        .component-page::before {
            content: "";
            position: absolute;
            width: 280px;
            height: 280px;
            top: -100px;
            right: 5%;
            border-radius: 50%;
            background: radial-gradient(circle, rgba(13, 110, 253, .08) 0%, rgba(13, 110, 253, 0) 70%);
            pointer-events: none;
        }

    @@keyframes componentPageFadeIn {
        from {
            opacity: 0;
            transform: translateY(14px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@keyframes componentCardIn {
        from {
            opacity: 0;
            transform: translateY(20px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .component-header {
        position: relative;
        z-index: 1;
    }

    .component-title {
        color: #172033;
        font-size: 1.55rem;
        letter-spacing: -.03em;
    }

    .component-title-icon {
        width: 46px;
        height: 46px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 14px;
        background: linear-gradient(135deg, #eef5ff, #dbeafe);
        color: #0d6efd;
        margin-right: .65rem;
        box-shadow: 0 8px 20px rgba(13, 110, 253, .10);
    }

    .component-breadcrumb .breadcrumb-item,
    .component-breadcrumb .breadcrumb-item a {
        font-size: .78rem;
        color: #6c757d;
    }

        .component-breadcrumb .breadcrumb-item a:hover {
            color: #0d6efd;
        }

    .create-component-btn {
        border: 0;
        padding: .68rem 1.1rem;
        border-radius: 12px;
        font-size: .83rem;
        font-weight: 700;
        background: linear-gradient(135deg, #0d6efd, #4f8cff);
        box-shadow: 0 10px 24px rgba(13, 110, 253, .20);
        transition: all .25s ease;
    }

        .create-component-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 14px 28px rgba(13, 110, 253, .28);
        }

        .create-component-btn:active {
            transform: translateY(0);
        }

    .component-alert {
        border: 0;
        border-radius: 16px;
        padding: 1rem 1.15rem;
        animation: componentCardIn .45s ease;
    }

    .component-stat-card {
        position: relative;
        overflow: hidden;
        min-height: 145px;
        border: 1px solid #e9edf3;
        border-radius: 20px;
        background: #fff;
        padding: 1.35rem;
        box-shadow: 0 8px 24px rgba(25, 42, 70, .05);
        transition: all .28s ease;
        animation: componentCardIn .6s ease both;
    }

        .component-stat-card:nth-child(1) {
            animation-delay: .05s;
        }

        .component-stat-card:nth-child(2) {
            animation-delay: .12s;
        }

        .component-stat-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 18px 35px rgba(25, 42, 70, .10);
        }

        .component-stat-card::after {
            content: "";
            position: absolute;
            width: 100px;
            height: 100px;
            border-radius: 50%;
            right: -35px;
            bottom: -40px;
            opacity: .45;
        }

    .allowance-stat::after {
        background: #d1e7dd;
    }

    .deduction-stat::after {
        background: #f8d7da;
    }

    .stat-label {
        font-size: .78rem;
        color: #7b8494;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .04em;
        margin-bottom: .35rem;
    }

    .stat-value {
        font-size: 2rem;
        font-weight: 800;
        line-height: 1.1;
        letter-spacing: -.04em;
    }

    .stat-description {
        font-size: .78rem;
        color: #8a94a6;
        margin-top: .4rem;
    }

    .stat-icon {
        width: 56px;
        height: 56px;
        min-width: 56px;
        border-radius: 17px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.35rem;
    }

    .allowance-icon {
        color: #198754;
        background: linear-gradient(135deg, #d1e7dd, #eaf7f0);
    }

    .deduction-icon {
        color: #dc3545;
        background: linear-gradient(135deg, #f8d7da, #fff0f1);
    }

    .component-tabs {
        border: 0;
        gap: .75rem;
    }

        .component-tabs .nav-item {
            flex: 1;
        }

        .component-tabs .nav-link {
            width: 100%;
            border: 1px solid #e6ebf2;
            border-radius: 14px;
            padding: .85rem 1rem;
            background: #fff;
            color: #667085;
            font-size: .84rem;
            transition: all .25s ease;
        }

            .component-tabs .nav-link:hover {
                border-color: #cbd8ee;
                background: #f8fbff;
                transform: translateY(-2px);
            }

            .component-tabs .nav-link.active {
                color: #0d6efd;
                background: linear-gradient(135deg, #f0f6ff, #ffffff);
                border-color: #b9d1f7;
                box-shadow: 0 8px 20px rgba(13, 110, 253, .08);
            }

        .component-tabs .tab-count {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-width: 26px;
            height: 22px;
            padding: 0 .45rem;
            margin-left: .4rem;
            border-radius: 50px;
            font-size: .7rem;
            background: rgba(13, 110, 253, .10);
            color: #0d6efd;
        }

        .component-tabs .nav-link.active .allowance-tab-icon {
            color: #198754 !important;
        }

        .component-tabs .nav-link.active .deduction-tab-icon {
            color: #dc3545 !important;
        }

    .component-content-card {
        overflow: hidden;
        border: 1px solid #e9edf3;
        border-radius: 20px;
        background: #fff;
        box-shadow: 0 10px 28px rgba(25, 42, 70, .055);
        animation: componentCardIn .45s ease;
    }

    .component-table-toolbar {
        padding: 1.1rem 1.35rem;
        border-bottom: 1px solid #edf0f5;
        background: linear-gradient(180deg, #ffffff, #fbfcfe);
    }

    .component-table-title {
        font-size: .95rem;
        font-weight: 800;
        color: #253047;
        margin: 0;
    }

    .component-table-subtitle {
        font-size: .76rem;
        color: #8b95a5;
        margin-top: .15rem;
    }

    .component-table-search {
        position: relative;
        min-width: 250px;
    }

        .component-table-search i {
            position: absolute;
            top: 50%;
            left: .85rem;
            transform: translateY(-50%);
            color: #98a2b3;
            z-index: 2;
        }

        .component-table-search input {
            border-radius: 10px;
            padding: .6rem .75rem .6rem 2.35rem;
            border: 1px solid #e2e7ee;
            font-size: .8rem;
            box-shadow: none;
        }

            .component-table-search input:focus {
                border-color: #9ec5fe;
                box-shadow: 0 0 0 .2rem rgba(13, 110, 253, .08);
            }

    .component-table {
        margin: 0;
        font-size: .82rem;
    }

        .component-table thead th {
            padding: .95rem .85rem;
            border-bottom: 1px solid #e8edf3;
            background: #f8fafc;
            color: #697386;
            font-size: .69rem;
            font-weight: 800;
            letter-spacing: .045em;
            text-transform: uppercase;
            white-space: nowrap;
        }

        .component-table tbody td {
            padding: 1rem .85rem;
            border-color: #edf0f4;
            vertical-align: middle;
        }

        .component-table tbody tr {
            transition: background .2s ease, transform .2s ease;
        }

            .component-table tbody tr:hover {
                background: #fbfdff;
            }

    .component-name {
        color: #27334a;
        font-weight: 800;
    }

    .component-code {
        display: inline-flex;
        align-items: center;
        padding: .3rem .55rem;
        border-radius: 7px;
        background: #f1f4f8;
        color: #586174;
        font-size: .73rem;
        font-weight: 700;
        font-family: inherit;
    }

    .component-type-badge,
    .status-badge,
    .basis-badge {
        display: inline-flex;
        align-items: center;
        gap: .3rem;
        padding: .38rem .65rem;
        border-radius: 50px;
        font-size: .7rem;
        font-weight: 700;
        white-space: nowrap;
    }

    .allowance-badge {
        color: #198754;
        background: #e9f8ef;
    }

    .deduction-badge {
        color: #dc3545;
        background: #fff0f1;
    }

    .active-badge {
        color: #198754;
        background: #eaf8ef;
    }

    .inactive-badge {
        color: #6c757d;
        background: #f1f3f5;
    }

    .basis-badge {
        color: #596579;
        background: #f4f6f9;
        max-width: 180px;
        white-space: normal;
        text-align: center;
    }

    .rate-value {
        font-weight: 800;
        color: #27334a;
    }

    .frequency-label,
    .tax-label {
        color: #697386;
        font-weight: 600;
    }

    .action-button {
        width: 34px;
        height: 34px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 10px !important;
        transition: all .2s ease;
    }

        .action-button:hover {
            transform: translateY(-2px);
        }

    .empty-state {
        padding: 3.8rem 1.5rem !important;
    }

    .empty-icon {
        width: 72px;
        height: 72px;
        margin: 0 auto 1rem;
        border-radius: 22px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #f2f6fb;
        color: #9aa4b2;
        font-size: 1.7rem;
    }

    .empty-title {
        color: #344054;
        font-weight: 800;
        margin-bottom: .3rem;
    }

    .empty-text {
        color: #98a2b3;
        font-size: .82rem;
        margin-bottom: 0;
    }

    .component-modal .modal-content {
        overflow: hidden;
        border-radius: 20px;
        box-shadow: 0 25px 70px rgba(16, 24, 40, .18);
    }

    .component-modal .modal-header {
        padding: 1.2rem 1.35rem;
        border: 0;
        background: linear-gradient(135deg, #f7faff, #ffffff);
        border-bottom: 1px solid #e9eef5;
    }

    .component-modal-title {
        color: #253047;
        font-weight: 800;
        font-size: 1rem;
    }

    .modal-title-icon {
        width: 38px;
        height: 38px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 11px;
        background: #e8f1ff;
        color: #0d6efd;
        margin-right: .6rem;
    }

    .component-modal .modal-body {
        padding: 1.35rem;
    }

    .component-modal .form-label {
        margin-bottom: .4rem;
        color: #596579;
        font-size: .74rem;
        font-weight: 800;
    }

    .component-modal .form-control,
    .component-modal .form-select {
        min-height: 40px;
        border-radius: 10px;
        border-color: #e0e6ed;
        font-size: .82rem;
        box-shadow: none;
    }

    .component-modal textarea.form-control {
        min-height: auto;
    }

    .component-modal .form-control:focus,
    .component-modal .form-select:focus {
        border-color: #9ec5fe;
        box-shadow: 0 0 0 .2rem rgba(13, 110, 253, .08);
    }

    .component-modal .modal-footer {
        padding: 1rem 1.35rem;
        border-top: 1px solid #e9eef5;
        background: #fbfcfe;
    }

    .component-modal .btn-cancel {
        border-radius: 10px;
        padding: .55rem 1rem;
        font-size: .8rem;
        font-weight: 700;
    }

    .component-modal .btn-save {
        border: 0;
        border-radius: 10px;
        padding: .58rem 1.1rem;
        font-size: .8rem;
        font-weight: 700;
        background: linear-gradient(135deg, #0d6efd, #4f8cff);
        box-shadow: 0 8px 18px rgba(13, 110, 253, .18);
    }

    .component-modal .form-check {
        padding: .8rem 1rem .8rem 2.6rem;
        border: 1px solid #e5eaf0;
        border-radius: 12px;
        background: #fafbfd;
    }

    .component-modal .form-check-input {
        margin-left: -1.7rem;
    }

    .component-modal .form-check-label {
        color: #475467;
        font-size: .78rem;
        font-weight: 700;
    }

    @@media (max-width: 767.98px) {
        .component-header {
            align-items: flex-start !important;
        }

        .component-title {
            font-size: 1.3rem;
        }

        .create-component-btn {
            width: 100%;
        }

        .component-tabs {
            flex-wrap: nowrap;
            overflow-x: auto;
            padding-bottom: .25rem;
        }

            .component-tabs .nav-item {
                min-width: 250px;
            }

        .component-table-toolbar {
            align-items: stretch !important;
        }

        .component-table-search {
            min-width: 100%;
            width: 100%;
        }

        .component-stat-card {
            min-height: 125px;
        }

        .component-content-card {
            border-radius: 16px;
        }
    }
</style>

<div class="container-fluid py-4 text-start component-page">

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show component-alert shadow-sm mb-4" role="alert">
            <i class="fa-solid fa-circle-check me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show component-alert shadow-sm mb-4" role="alert">
            <i class="fa-solid fa-circle-exclamation me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Page Header -->
    <div class="component-header d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <div class="d-flex align-items-center mb-2">
                <div class="component-title-icon">
                    <i class="fa-solid fa-percent"></i>
                </div>
                <div>
                    <h4 class="component-title fw-bold mb-0">Allowances & Deductions</h4>
                    <div class="text-muted small mt-1">Manage payroll components, earnings, rates and statutory deductions</div>
                </div>
            </div>

            <nav aria-label="breadcrumb">
                <ol class="breadcrumb component-breadcrumb mb-0">
                    <li class="breadcrumb-item">
                        <a href="/HR" class="text-decoration-none">HR Dashboard</a>
                    </li>
                    <li class="breadcrumb-item active" aria-current="page">Payroll Components</li>
                </ol>
            </nav>
        </div>

        <button class="btn btn-primary create-component-btn" data-bs-toggle="modal" data-bs-target="#createModal" onclick="openCreateModal()">
            <i class="fa-solid fa-plus me-2"></i>Create Component
        </button>
    </div>

    <!-- Statistics -->
    <div class="row g-3 mb-4">
        <div class="col-md-6">
            <div class="component-stat-card allowance-stat d-flex align-items-center justify-content-between">
                <div>
                    <div class="stat-label">Configured Allowances</div>
                    <div class="stat-value text-success">@allowances.Count</div>
                    <div class="stat-description">Active earning and allowance components</div>
                </div>

                <div class="stat-icon allowance-icon">
                    <i class="fa-solid fa-hand-holding-dollar"></i>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="component-stat-card deduction-stat d-flex align-items-center justify-content-between">
                <div>
                    <div class="stat-label">Configured Deductions</div>
                    <div class="stat-value text-danger">@deductions.Count</div>
                    <div class="stat-description">Statutory and custom deduction components</div>
                </div>

                <div class="stat-icon deduction-icon">
                    <i class="fa-solid fa-file-invoice-dollar"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- Navigation Tabs -->
    <ul class="nav component-tabs mb-4" id="componentTabs" role="tablist">

        <li class="nav-item" role="presentation">
            <button class="nav-link active fw-bold" id="allowances-tab" data-bs-toggle="tab" data-bs-target="#allowances-pane" type="button" role="tab">
                <i class="fa-solid fa-arrow-trend-up text-success allowance-tab-icon me-2"></i>
                Earnings & Allowances
                <span class="tab-count">@allowances.Count</span>
            </button>
        </li>

        <li class="nav-item" role="presentation">
            <button class="nav-link fw-bold" id="deductions-tab" data-bs-toggle="tab" data-bs-target="#deductions-pane" type="button" role="tab">
                <i class="fa-solid fa-arrow-trend-down text-danger deduction-tab-icon me-2"></i>
                Statutory & Custom Deductions
                <span class="tab-count">@deductions.Count</span>
            </button>
        </li>

    </ul>

    <div class="tab-content" id="componentTabsContent">

        <!-- ALLOWANCES TAB -->
        <div class="tab-pane fade show active" id="allowances-pane" role="tabpanel">

            <div class="component-content-card">

                <div class="component-table-toolbar d-flex flex-wrap justify-content-between align-items-center gap-3">
                    <div>
                        <h6 class="component-table-title">
                            <i class="fa-solid fa-wallet text-success me-2"></i>Allowance Components
                        </h6>
                        <div class="component-table-subtitle">
                            Manage salary earnings, benefits and additional employee allowances
                        </div>
                    </div>

                    <div class="component-table-search">
                        <i class="fa-solid fa-search"></i>
                        <input type="text" class="form-control" id="allowanceSearchInput" placeholder="Search allowance components...">
                    </div>
                </div>

                <div class="table-responsive">
                    <table class="table table-hover align-middle component-table" id="allowancesTable">
                        <thead>
                            <tr>
                                <th>Component Name</th>
                                <th>Code</th>
                                <th>Type</th>
                                <th>Taxability</th>
                                <th>Calculation Basis</th>
                                <th>Default Value / Rate</th>
                                <th>Pay Frequency</th>
                                <th>Status</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>

                        <tbody>
                            @if (!allowances.Any())
                            {
                                <tr>
                                    <td colspan="9" class="text-center empty-state">
                                        <div class="empty-icon">
                                            <i class="fa-solid fa-wallet"></i>
                                        </div>
                                        <div class="empty-title">No Allowances Created</div>
                                        <p class="empty-text">Create your first earning or allowance component to configure payroll.</p>
                                    </td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var item in allowances)
                                {
                                    <tr>
                                        <td>
                                            <div class="component-name">@item.ComponentName</div>
                                        </td>

                                        <td>
                                            <span class="component-code">@item.ComponentCode</span>
                                        </td>

                                        <td>
                                            <span class="component-type-badge allowance-badge">
                                                <i class="fa-solid fa-arrow-trend-up"></i>
                                                Allowance
                                            </span>
                                        </td>

                                        <td>
                                            <span class="tax-label">@item.Taxability</span>
                                        </td>

                                        <td>
                                            <span class="basis-badge">@item.CalculationBasis</span>
                                        </td>

                                        <td>
                                            <span class="rate-value">
                                                @(item.CalculationBasis.Contains("Percentage") ? $"{item.DefaultValueOrRate}%" : $"₹{item.DefaultValueOrRate:N0}")
                                            </span>
                                        </td>

                                        <td>
                                            <span class="frequency-label">
                                                <i class="fa-regular fa-calendar me-1"></i>@item.PayFrequency
                                            </span>
                                        </td>

                                        <td>
                                            @if (item.IsActive)
                                            {
                                                <span class="status-badge active-badge">
                                                    <i class="fa-solid fa-circle-check"></i>Active
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="status-badge inactive-badge">
                                                    <i class="fa-solid fa-circle-minus"></i>Inactive
                                                </span>
                                            }
                                        </td>

                                        <td class="text-end">
                                            <div class="d-inline-flex align-items-center gap-2">

                                                <form asp-action="ToggleComponentStatus" method="post" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@item.ComponentId" />

                                                    <button type="submit"
                                                            class="btn btn-outline-warning btn-sm action-button"
                                                            title="Toggle Status"
                                                            data-bs-toggle="tooltip">
                                                        <i class="fa-solid fa-power-off"></i>
                                                    </button>
                                                </form>

                                                <form asp-action="DeleteComponent"
                                                      method="post"
                                                      class="d-inline"
                                                      onsubmit="return confirm('Are you sure you want to delete this allowance?');">

                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@item.ComponentId" />

                                                    <button type="submit"
                                                            class="btn btn-outline-danger btn-sm action-button"
                                                            title="Delete"
                                                            data-bs-toggle="tooltip">
                                                        <i class="fa-solid fa-trash"></i>
                                                    </button>
                                                </form>

                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>

            </div>

        </div>

        <!-- DEDUCTIONS TAB -->
        <div class="tab-pane fade" id="deductions-pane" role="tabpanel">

            <div class="component-content-card">

                <div class="component-table-toolbar d-flex flex-wrap justify-content-between align-items-center gap-3">
                    <div>
                        <h6 class="component-table-title">
                            <i class="fa-solid fa-file-invoice-dollar text-danger me-2"></i>Deduction Components
                        </h6>
                        <div class="component-table-subtitle">
                            Manage statutory deductions, payroll contributions and custom deductions
                        </div>
                    </div>

                    <div class="component-table-search">
                        <i class="fa-solid fa-search"></i>
                        <input type="text" class="form-control" id="deductionSearchInput" placeholder="Search deduction components...">
                    </div>
                </div>

                <div class="table-responsive">
                    <table class="table table-hover align-middle component-table" id="deductionsTable">
                        <thead>
                            <tr>
                                <th>Component Name</th>
                                <th>Code</th>
                                <th>Type</th>
                                <th>Taxability</th>
                                <th>Calculation Basis</th>
                                <th>Default Value / Rate</th>
                                <th>Max Cap Limit</th>
                                <th>Status</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>

                        <tbody>
                            @if (!deductions.Any())
                            {
                                <tr>
                                    <td colspan="9" class="text-center empty-state">
                                        <div class="empty-icon">
                                            <i class="fa-solid fa-file-invoice-dollar"></i>
                                        </div>
                                        <div class="empty-title">No Deductions Created</div>
                                        <p class="empty-text">Create statutory or custom deductions to configure your payroll rules.</p>
                                    </td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var item in deductions)
                                {
                                    <tr>
                                        <td>
                                            <div class="component-name">@item.ComponentName</div>
                                        </td>

                                        <td>
                                            <span class="component-code">@item.ComponentCode</span>
                                        </td>

                                        <td>
                                            <span class="component-type-badge deduction-badge">
                                                <i class="fa-solid fa-arrow-trend-down"></i>
                                                Deduction
                                            </span>
                                        </td>

                                        <td>
                                            <span class="tax-label">@item.Taxability</span>
                                        </td>

                                        <td>
                                            <span class="basis-badge">@item.CalculationBasis</span>
                                        </td>

                                        <td>
                                            <span class="rate-value">
                                                @(item.CalculationBasis.Contains("Percentage") ? $"{item.DefaultValueOrRate}%" : $"₹{item.DefaultValueOrRate:N0}")
                                            </span>
                                        </td>

                                        <td>
                                            @if (item.MaxLimit > 0)
                                            {
                                                <span class="rate-value">₹@item.MaxLimit.ToString("N0")</span>
                                            }
                                            else
                                            {
                                                <span class="text-muted small">No Limit</span>
                                            }
                                        </td>

                                        <td>
                                            @if (item.IsActive)
                                            {
                                                <span class="status-badge active-badge">
                                                    <i class="fa-solid fa-circle-check"></i>Active
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="status-badge inactive-badge">
                                                    <i class="fa-solid fa-circle-minus"></i>Inactive
                                                </span>
                                            }
                                        </td>

                                        <td class="text-end">
                                            <div class="d-inline-flex align-items-center gap-2">

                                                <form asp-action="ToggleComponentStatus" method="post" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@item.ComponentId" />

                                                    <button type="submit"
                                                            class="btn btn-outline-warning btn-sm action-button"
                                                            title="Toggle Status"
                                                            data-bs-toggle="tooltip">
                                                        <i class="fa-solid fa-power-off"></i>
                                                    </button>
                                                </form>

                                                <form asp-action="DeleteComponent"
                                                      method="post"
                                                      class="d-inline"
                                                      onsubmit="return confirm('Are you sure you want to delete this deduction?');">

                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@item.ComponentId" />

                                                    <button type="submit"
                                                            class="btn btn-outline-danger btn-sm action-button"
                                                            title="Delete"
                                                            data-bs-toggle="tooltip">
                                                        <i class="fa-solid fa-trash"></i>
                                                    </button>
                                                </form>

                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>

            </div>

        </div>

    </div>

</div>

<!-- CREATE / EDIT COMPONENT MODAL -->
<div class="modal fade component-modal" id="createModal" tabindex="-1" aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content border-0">

            <div class="modal-header">
                <h5 class="modal-title component-modal-title d-flex align-items-center" id="modalTitle">
                    <span class="modal-title-icon">
                        <i class="fa-solid fa-plus"></i>
                    </span>
                    Create Salary Component
                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Close"></button>
            </div>

            <form asp-action="SaveComponent" method="post">

                @Html.AntiForgeryToken()

                <input type="hidden" name="ComponentId" id="compFieldId" value="0" />

                <div class="modal-body">

                    <div class="row g-3">

                        <div class="col-md-8">
                            <label class="form-label">
                                Component Name <span class="text-danger">*</span>
                            </label>

                            <input type="text"
                                   name="ComponentName"
                                   class="form-control"
                                   required
                                   placeholder="e.g. Telephone Allowance">
                        </div>

                        <div class="col-md-4">
                            <label class="form-label">
                                Code <span class="text-danger">*</span>
                            </label>

                            <input type="text"
                                   name="ComponentCode"
                                   class="form-control"
                                   required
                                   placeholder="e.g. TEL">
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">Component Type</label>

                            <select name="ComponentType" class="form-select">
                                <option value="Allowance">Allowance (Earning)</option>
                                <option value="Deduction">Deduction</option>
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">Taxability Status</label>

                            <select name="Taxability" class="form-select">
                                <option value="Fully Taxable">Fully Taxable</option>
                                <option value="Partially Exempt">Partially Exempt</option>
                                <option value="Tax Exempt">Tax Exempt</option>
                                <option value="Fully Deductible">Fully Deductible</option>
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">Calculation Basis</label>

                            <select name="CalculationBasis" class="form-select">
                                <option value="Fixed Amount">Fixed Amount</option>
                                <option value="Percentage of Basic">Percentage of Basic</option>
                                <option value="Percentage of CTC">Percentage of CTC</option>
                                <option value="Slab Based">Slab Based</option>
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">Default Value or Rate (%)</label>

                            <input type="number"
                                   step="0.01"
                                   name="DefaultValueOrRate"
                                   class="form-control"
                                   value="0.00">
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">Max Limit / Cap (₹)</label>

                            <input type="number"
                                   step="0.01"
                                   name="MaxLimit"
                                   class="form-control"
                                   value="0.00">
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">Pay Frequency</label>

                            <select name="PayFrequency" class="form-select">
                                <option value="Monthly">Monthly</option>
                                <option value="Yearly">Yearly</option>
                            </select>
                        </div>

                        <div class="col-12">
                            <div class="form-check form-switch">
                                <input class="form-check-input"
                                       type="checkbox"
                                       name="IsActive"
                                       value="true"
                                       checked
                                       id="compActive">

                                <label class="form-check-label" for="compActive">
                                    Component Active
                                </label>
                            </div>
                        </div>

                    </div>

                </div>

                <div class="modal-footer">
                    <button type="button"
                            class="btn btn-light border btn-cancel"
                            data-bs-dismiss="modal">
                        Cancel
                    </button>

                    <button type="submit"
                            class="btn btn-primary btn-save">
                        <i class="fa-solid fa-floppy-disk me-2"></i>Save Component
                    </button>
                </div>

            </form>

        </div>

    </div>

</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {

        const allowanceSearchInput = document.getElementById('allowanceSearchInput');
        const deductionSearchInput = document.getElementById('deductionSearchInput');

        allowanceSearchInput?.addEventListener('keyup', function () {
            const value = this.value.toLowerCase();
            const rows = document.querySelectorAll('#allowancesTable tbody tr');

            rows.forEach(function (row) {
                const text = row.innerText.toLowerCase();
                row.style.display = text.includes(value) ? '' : 'none';
            });
        });

        deductionSearchInput?.addEventListener('keyup', function () {
            const value = this.value.toLowerCase();
            const rows = document.querySelectorAll('#deductionsTable tbody tr');

            rows.forEach(function (row) {
                const text = row.innerText.toLowerCase();
                row.style.display = text.includes(value) ? '' : 'none';
            });
        });

        const tooltipTriggerList = [].slice.call(
            document.querySelectorAll('[data-bs-toggle="tooltip"]')
        );

        tooltipTriggerList.forEach(function (tooltipTriggerEl) {
            new bootstrap.Tooltip(tooltipTriggerEl);
        });

    });
</script>
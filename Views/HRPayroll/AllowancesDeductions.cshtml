@model List<ERP_System.Models.PayrollComponent>
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Allowances & Deductions Master";
    var allowances = ViewBag.Allowances as List<ERP_System.Models.PayrollComponent> ?? Model?.Where(m => m.Type == "Allowance").ToList() ?? new List<ERP_System.Models.PayrollComponent>();
    var deductions = ViewBag.Deductions as List<ERP_System.Models.PayrollComponent> ?? Model?.Where(m => m.Type == "Deduction").ToList() ?? new List<ERP_System.Models.PayrollComponent>();
    int activeAllowances = ViewBag.ActiveAllowancesCount ?? allowances.Count(a => a.IsActive);
    int activeDeductions = ViewBag.ActiveDeductionsCount ?? deductions.Count(d => d.IsActive);
}

<style>
    .component-page {
        position: relative;
        animation: componentPageFadeIn .5s ease;
    }

    @@keyframes componentPageFadeIn {
        from { opacity: 0; transform: translateY(12px); }
        to { opacity: 1; transform: translateY(0); }
    }

    .component-header {
        position: relative;
        z-index: 1;
    }

    .component-title {
        color: #172033;
        font-size: 1.55rem;
        letter-spacing: -.03em;
    }

    .component-title-icon {
        width: 46px;
        height: 46px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 14px;
        background: linear-gradient(135deg, #eef5ff, #dbeafe);
        color: #0d6efd;
        margin-right: .65rem;
        box-shadow: 0 8px 20px rgba(13, 110, 253, .10);
    }

    .component-breadcrumb .breadcrumb-item,
    .component-breadcrumb .breadcrumb-item a {
        font-size: .78rem;
        color: #6c757d;
    }

    .component-breadcrumb .breadcrumb-item a:hover {
        color: #0d6efd;
    }

    .create-component-btn {
        border: 0;
        padding: .68rem 1.25rem;
        border-radius: 12px;
        font-size: .83rem;
        font-weight: 700;
        background: linear-gradient(135deg, #0d6efd, #4f8cff);
        box-shadow: 0 10px 24px rgba(13, 110, 253, .20);
        transition: all .25s ease;
    }

    .create-component-btn:hover {
        transform: translateY(-2px);
        box-shadow: 0 14px 28px rgba(13, 110, 253, .28);
    }

    .component-stat-card {
        position: relative;
        overflow: hidden;
        min-height: 120px;
        border: 1px solid #e9edf3;
        border-radius: 18px;
        background: #fff;
        padding: 1.25rem 1.5rem;
        box-shadow: 0 6px 20px rgba(25, 42, 70, .04);
        transition: all .25s ease;
    }

    .component-stat-card:hover {
        transform: translateY(-3px);
        box-shadow: 0 12px 28px rgba(25, 42, 70, .08);
    }

    .stat-label {
        font-size: .76rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: .05em;
        color: #6c757d;
        margin-bottom: .25rem;
    }

    .stat-value {
        font-size: 1.85rem;
        font-weight: 800;
        line-height: 1.2;
    }

    .stat-description {
        font-size: .76rem;
        color: #8c98a4;
        margin-top: .2rem;
    }

    .stat-icon {
        width: 52px;
        height: 52px;
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.45rem;
    }

    .allowance-icon {
        background: #ecfdf5;
        color: #10b981;
    }

    .deduction-icon {
        background: #fef2f2;
        color: #ef4444;
    }

    .component-tabs {
        border-bottom: 2px solid #eef2f6;
        gap: .5rem;
    }

    .component-tabs .nav-link {
        border: 0;
        border-radius: 12px;
        padding: .75rem 1.25rem;
        color: #596579;
        font-weight: 700;
        font-size: .86rem;
        background: #f8fafc;
        transition: all .2s ease;
    }

    .component-tabs .nav-link.active {
        color: #0d6efd;
        background: #eff6ff;
        box-shadow: 0 4px 12px rgba(13, 110, 253, .08);
    }

    .tab-count {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 22px;
        height: 22px;
        padding: 0 6px;
        border-radius: 100px;
        font-size: .72rem;
        font-weight: 800;
        margin-left: .45rem;
        background: rgba(0,0,0,0.06);
    }

    .component-tabs .nav-link.active .tab-count {
        background: #0d6efd;
        color: #fff;
    }

    .component-content-card {
        border: 1px solid #e9edf3;
        border-radius: 18px;
        background: #fff;
        padding: 1.25rem;
        box-shadow: 0 8px 24px rgba(25, 42, 70, .04);
    }

    .component-table-toolbar {
        padding-bottom: 1rem;
        border-bottom: 1px solid #f1f5f9;
        margin-bottom: 1rem;
    }

    .component-table-title {
        font-size: 1rem;
        font-weight: 800;
        color: #1e293b;
        margin-bottom: 2px;
    }

    .component-table-subtitle {
        font-size: .76rem;
        color: #64748b;
    }

    .component-table-search {
        position: relative;
        min-width: 280px;
    }

    .component-table-search i {
        position: absolute;
        left: 12px;
        top: 50%;
        transform: translateY(-50%);
        color: #94a3b8;
        font-size: .82rem;
    }

    .component-table-search input {
        padding-left: 34px;
        border-radius: 10px;
        border-color: #e2e8f0;
        font-size: .82rem;
    }

    .component-table {
        margin-bottom: 0;
    }

    .component-table thead th {
        background: #f8fafc;
        color: #475569;
        font-weight: 800;
        font-size: .74rem;
        text-transform: uppercase;
        letter-spacing: .04em;
        padding: .85rem 1rem;
        border: 0;
    }

    .component-table tbody td {
        padding: .85rem 1rem;
        font-size: .83rem;
        color: #334155;
        border-bottom: 1px solid #f1f5f9;
    }

    .component-name {
        font-weight: 700;
        color: #0f172a;
    }

    .component-code {
        display: inline-block;
        font-family: monospace;
        font-weight: 700;
        font-size: .78rem;
        padding: 3px 8px;
        border-radius: 6px;
        background: #f1f5f9;
        color: #334155;
        border: 1px solid #e2e8f0;
    }

    .component-type-badge {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        font-size: .74rem;
        font-weight: 700;
        padding: 4px 9px;
        border-radius: 8px;
    }

    .allowance-badge {
        background: #ecfdf5;
        color: #059669;
        border: 1px solid #a7f3d0;
    }

    .deduction-badge {
        background: #fef2f2;
        color: #dc2626;
        border: 1px solid #fecaca;
    }

    .basis-badge {
        display: inline-block;
        font-size: .74rem;
        font-weight: 700;
        padding: 3px 8px;
        border-radius: 6px;
        background: #eff6ff;
        color: #2563eb;
    }

    .rate-value {
        font-weight: 800;
        color: #0f172a;
    }

    .status-badge {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        font-size: .72rem;
        font-weight: 700;
        padding: 3px 8px;
        border-radius: 6px;
    }

    .status-badge.active-badge {
        background: #ecfdf5;
        color: #059669;
    }

    .status-badge.inactive-badge {
        background: #f1f5f9;
        color: #64748b;
    }

    .action-button {
        width: 32px;
        height: 32px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 8px !important;
        font-size: .78rem;
        transition: all .2s ease;
    }

    .action-button:hover {
        transform: translateY(-2px);
    }

    .component-modal .modal-content {
        border-radius: 18px;
        box-shadow: 0 25px 60px rgba(15, 23, 42, .18);
        border: 0;
        overflow: hidden;
    }

    .component-modal .modal-header {
        padding: 1.15rem 1.35rem;
        background: linear-gradient(135deg, #f8fafc, #ffffff);
        border-bottom: 1px solid #e2e8f0;
    }

    .component-modal .modal-title {
        font-size: 1rem;
        font-weight: 800;
        color: #0f172a;
    }

    .component-modal .modal-body {
        padding: 1.35rem;
    }

    .component-modal .form-label {
        font-size: .75rem;
        font-weight: 800;
        color: #475569;
        margin-bottom: .35rem;
    }

    .component-modal .form-control,
    .component-modal .form-select {
        border-radius: 10px;
        border-color: #cbd5e1;
        font-size: .83rem;
        min-height: 38px;
    }

    .component-modal .form-control:focus,
    .component-modal .form-select:focus {
        border-color: #3b82f6;
        box-shadow: 0 0 0 3px rgba(59, 130, 246, .12);
    }
</style>

<div class="container-fluid py-4 text-start component-page">

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm mb-4 rounded-3 border-0" role="alert">
            <i class="fa-solid fa-circle-check me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm mb-4 rounded-3 border-0" role="alert">
            <i class="fa-solid fa-circle-exclamation me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Header Section -->
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4 component-header">
        <div class="d-flex align-items-center">
            <div class="component-title-icon">
                <i class="fa-solid fa-sliders"></i>
            </div>
            <div>
                <h4 class="mb-0 fw-bold component-title">Salary Allowances & Deductions</h4>
                <nav aria-label="breadcrumb" class="component-breadcrumb">
                    <ol class="breadcrumb mb-0">
                        <li class="breadcrumb-item"><a asp-controller="HR" asp-action="Index">HR Portal</a></li>
                        <li class="breadcrumb-item"><a asp-controller="HRPayroll" asp-action="SalaryStructures">Payroll Management</a></li>
                        <li class="breadcrumb-item active" aria-current="page">Components Master</li>
                    </ol>
                </nav>
            </div>
        </div>

        <div>
            <button type="button" class="btn btn-primary text-white create-component-btn" onclick="openCreateModal()">
                <i class="fa-solid fa-plus me-2"></i>Create Component
            </button>
        </div>
    </div>

    <!-- Metric Summary Cards -->
    <div class="row g-3 mb-4">
        <div class="col-md-6">
            <div class="component-stat-card d-flex align-items-center justify-content-between">
                <div>
                    <div class="stat-label">Active Earnings & Allowances</div>
                    <div class="stat-value text-success">@activeAllowances</div>
                    <div class="stat-description">@allowances.Count total configured earning components</div>
                </div>
                <div class="stat-icon allowance-icon">
                    <i class="fa-solid fa-hand-holding-dollar"></i>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="component-stat-card d-flex align-items-center justify-content-between">
                <div>
                    <div class="stat-label">Active Deductions</div>
                    <div class="stat-value text-danger">@activeDeductions</div>
                    <div class="stat-description">@deductions.Count total statutory and custom deduction rules</div>
                </div>
                <div class="stat-icon deduction-icon">
                    <i class="fa-solid fa-file-invoice-dollar"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- Navigation Tabs -->
    <ul class="nav component-tabs mb-4" id="componentTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active fw-bold" id="allowances-tab" data-bs-toggle="tab" data-bs-target="#allowances-pane" type="button" role="tab">
                <i class="fa-solid fa-arrow-trend-up text-success me-2"></i>
                Earnings & Allowances
                <span class="tab-count">@allowances.Count</span>
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link fw-bold" id="deductions-tab" data-bs-toggle="tab" data-bs-target="#deductions-pane" type="button" role="tab">
                <i class="fa-solid fa-arrow-trend-down text-danger me-2"></i>
                Statutory & Custom Deductions
                <span class="tab-count">@deductions.Count</span>
            </button>
        </li>
    </ul>

    <div class="tab-content" id="componentTabsContent">
        <!-- ALLOWANCES TAB -->
        <div class="tab-pane fade show active" id="allowances-pane" role="tabpanel">
            <div class="component-content-card">
                <div class="component-table-toolbar d-flex flex-wrap justify-content-between align-items-center gap-3">
                    <div>
                        <h6 class="component-table-title">
                            <i class="fa-solid fa-wallet text-success me-2"></i>Allowance Components
                        </h6>
                        <div class="component-table-subtitle">
                            Configure base earnings, flexible perks and reimbursement allowances
                        </div>
                    </div>
                    <div class="component-table-search">
                        <i class="fa-solid fa-search"></i>
                        <input type="text" class="form-control" id="allowanceSearchInput" placeholder="Search allowances by name or code...">
                    </div>
                </div>

                <div class="table-responsive">
                    <table class="table table-hover align-middle component-table" id="allowancesTable">
                        <thead>
                            <tr>
                                <th>Component Name</th>
                                <th>Code</th>
                                <th>Taxability</th>
                                <th>Calculation Basis</th>
                                <th>Default Value / Rate</th>
                                <th>Max Cap Limit</th>
                                <th>Pay Frequency</th>
                                <th>Status</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!allowances.Any())
                            {
                                <tr>
                                    <td colspan="9" class="text-center py-5 text-muted">
                                        <i class="fa-solid fa-wallet fa-2x mb-2 d-block text-secondary opacity-50"></i>
                                        <p class="mb-0 fw-bold">No Allowances Found</p>
                                        <small>Click "+ Create Component" to add a new earning rule.</small>
                                    </td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var item in allowances)
                                {
                                    <tr id="comp-row-@item.Id">
                                        <td>
                                            <div class="component-name">@item.ComponentName</div>
                                        </td>
                                        <td>
                                            <span class="component-code">@item.Code</span>
                                        </td>
                                        <td>
                                            <span class="text-secondary small fw-bold">@item.Taxability</span>
                                        </td>
                                        <td>
                                            <span class="basis-badge">@item.CalculationBasis</span>
                                        </td>
                                        <td>
                                            <span class="rate-value">
                                                @(item.CalculationBasis.Contains("Percentage") ? $"{item.DefaultValueOrRate}%" : $"₹{item.DefaultValueOrRate:N0}")
                                            </span>
                                        </td>
                                        <td>
                                            <span class="text-secondary small">@(string.IsNullOrEmpty(item.MaxCapLimit) ? "No Limit" : item.MaxCapLimit)</span>
                                        </td>
                                        <td>
                                            <span class="text-secondary small"><i class="fa-regular fa-calendar me-1"></i>@item.PayFrequency</span>
                                        </td>
                                        <td>
                                            @if (item.IsActive)
                                            {
                                                <span class="status-badge active-badge" id="badge-@item.Id">
                                                    <i class="fa-solid fa-circle-check"></i>Active
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="status-badge inactive-badge" id="badge-@item.Id">
                                                    <i class="fa-solid fa-circle-minus"></i>Inactive
                                                </span>
                                            }
                                        </td>
                                        <td class="text-end">
                                            <div class="d-inline-flex align-items-center gap-1">
                                                <button type="button" class="btn btn-outline-primary btn-sm action-button"
                                                        title="Edit Component"
                                                        onclick='openEditModal(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(item)))'>
                                                    <i class="fa-solid fa-pen-to-square"></i>
                                                </button>

                                                <button type="button" class="btn btn-outline-warning btn-sm action-button"
                                                        title="Toggle Status"
                                                        onclick="toggleStatus(@item.Id)">
                                                    <i class="fa-solid fa-power-off"></i>
                                                </button>

                                                <button type="button" class="btn btn-outline-danger btn-sm action-button"
                                                        title="Delete Component"
                                                        onclick="deleteComponent(@item.Id, '@item.ComponentName')">
                                                    <i class="fa-solid fa-trash"></i>
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- DEDUCTIONS TAB -->
        <div class="tab-pane fade" id="deductions-pane" role="tabpanel">
            <div class="component-content-card">
                <div class="component-table-toolbar d-flex flex-wrap justify-content-between align-items-center gap-3">
                    <div>
                        <h6 class="component-table-title">
                            <i class="fa-solid fa-file-invoice-dollar text-danger me-2"></i>Deduction Components
                        </h6>
                        <div class="component-table-subtitle">
                            Configure statutory deductions (PF, ESI, PT) and employee withholding rules
                        </div>
                    </div>
                    <div class="component-table-search">
                        <i class="fa-solid fa-search"></i>
                        <input type="text" class="form-control" id="deductionSearchInput" placeholder="Search deductions by name or code...">
                    </div>
                </div>

                <div class="table-responsive">
                    <table class="table table-hover align-middle component-table" id="deductionsTable">
                        <thead>
                            <tr>
                                <th>Component Name</th>
                                <th>Code</th>
                                <th>Taxability</th>
                                <th>Calculation Basis</th>
                                <th>Default Value / Rate</th>
                                <th>Max Cap Limit</th>
                                <th>Pay Frequency</th>
                                <th>Status</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!deductions.Any())
                            {
                                <tr>
                                    <td colspan="9" class="text-center py-5 text-muted">
                                        <i class="fa-solid fa-file-invoice-dollar fa-2x mb-2 d-block text-secondary opacity-50"></i>
                                        <p class="mb-0 fw-bold">No Deductions Found</p>
                                        <small>Click "+ Create Component" to add a new statutory or deduction rule.</small>
                                    </td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var item in deductions)
                                {
                                    <tr id="comp-row-@item.Id">
                                        <td>
                                            <div class="component-name">@item.ComponentName</div>
                                        </td>
                                        <td>
                                            <span class="component-code">@item.Code</span>
                                        </td>
                                        <td>
                                            <span class="text-secondary small fw-bold">@item.Taxability</span>
                                        </td>
                                        <td>
                                            <span class="basis-badge">@item.CalculationBasis</span>
                                        </td>
                                        <td>
                                            <span class="rate-value">
                                                @(item.CalculationBasis.Contains("Percentage") ? $"{item.DefaultValueOrRate}%" : $"₹{item.DefaultValueOrRate:N0}")
                                            </span>
                                        </td>
                                        <td>
                                            <span class="text-secondary small">@(string.IsNullOrEmpty(item.MaxCapLimit) ? "No Limit" : item.MaxCapLimit)</span>
                                        </td>
                                        <td>
                                            <span class="text-secondary small"><i class="fa-regular fa-calendar me-1"></i>@item.PayFrequency</span>
                                        </td>
                                        <td>
                                            @if (item.IsActive)
                                            {
                                                <span class="status-badge active-badge" id="badge-@item.Id">
                                                    <i class="fa-solid fa-circle-check"></i>Active
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="status-badge inactive-badge" id="badge-@item.Id">
                                                    <i class="fa-solid fa-circle-minus"></i>Inactive
                                                </span>
                                            }
                                        </td>
                                        <td class="text-end">
                                            <div class="d-inline-flex align-items-center gap-1">
                                                <button type="button" class="btn btn-outline-primary btn-sm action-button"
                                                        title="Edit Component"
                                                        onclick='openEditModal(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(item)))'>
                                                    <i class="fa-solid fa-pen-to-square"></i>
                                                </button>

                                                <button type="button" class="btn btn-outline-warning btn-sm action-button"
                                                        title="Toggle Status"
                                                        onclick="toggleStatus(@item.Id)">
                                                    <i class="fa-solid fa-power-off"></i>
                                                </button>

                                                <button type="button" class="btn btn-outline-danger btn-sm action-button"
                                                        title="Delete Component"
                                                        onclick="deleteComponent(@item.Id, '@item.ComponentName')">
                                                    <i class="fa-solid fa-trash"></i>
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- CREATE / EDIT COMPONENT MODAL -->
<div class="modal fade component-modal" id="componentModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title d-flex align-items-center" id="modalTitle">
                    <i class="fa-solid fa-plus text-primary me-2"></i>Create Salary Component
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <form asp-controller="HRPayroll" asp-action="CreateComponent" method="post" id="componentForm">
                @Html.AntiForgeryToken()
                <input type="hidden" name="Id" id="modalCompId" value="0" />

                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label">Component Type <span class="text-danger">*</span></label>
                            <select name="Type" id="modalType" class="form-select" required>
                                <option value="Allowance">Allowance (Earning)</option>
                                <option value="Deduction">Deduction (Statutory / Withholding)</option>
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">Component Code <span class="text-danger">*</span></label>
                            <input type="text" name="Code" id="modalCode" class="form-control" required placeholder="e.g. HRA, PF, MED" maxlength="15">
                        </div>

                        <div class="col-md-12">
                            <label class="form-label">Component Name <span class="text-danger">*</span></label>
                            <input type="text" name="ComponentName" id="modalComponentName" class="form-control" required placeholder="e.g. House Rent Allowance" maxlength="100">
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">Calculation Basis <span class="text-danger">*</span></label>
                            <select name="CalculationBasis" id="modalCalculationBasis" class="form-select" required>
                                <option value="Fixed Amount">Fixed Amount</option>
                                <option value="Percentage of Basic">Percentage of Basic</option>
                                <option value="Percentage of Gross">Percentage of Gross</option>
                                <option value="Percentage of CTC">Percentage of CTC</option>
                                <option value="Slab Based">Slab Based</option>
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">Default Value or Rate (%) <span class="text-danger">*</span></label>
                            <input type="number" step="0.01" name="DefaultValueOrRate" id="modalDefaultValueOrRate" class="form-control" value="0.00" required>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">Taxability Rule</label>
                            <select name="Taxability" id="modalTaxability" class="form-select">
                                <option value="Fully Taxable">Fully Taxable</option>
                                <option value="Partially Exempt">Partially Exempt</option>
                                <option value="Tax Exempt">Tax Exempt</option>
                                <option value="Fully Deductible">Fully Deductible</option>
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">Max Cap / Monthly Limit</label>
                            <input type="text" name="MaxCapLimit" id="modalMaxCapLimit" class="form-control" placeholder="e.g. No Limit, 1800">
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">Pay Frequency</label>
                            <select name="PayFrequency" id="modalPayFrequency" class="form-select">
                                <option value="Monthly">Monthly</option>
                                <option value="Yearly">Yearly</option>
                            </select>
                        </div>

                        <div class="col-md-6 d-flex align-items-center pt-3">
                            <div class="form-check form-switch mt-2">
                                <input class="form-check-input" type="checkbox" name="IsActive" value="true" checked id="modalIsActive">
                                <label class="form-check-label fw-bold text-dark small" for="modalIsActive">Component Active</label>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="modal-footer border-top bg-light">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary btn-sm px-4 fw-bold">
                        <i class="fa-solid fa-floppy-disk me-1"></i> Save Component
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<form id="antiForgeryForm" style="display:none;">
    @Html.AntiForgeryToken()
</form>

<script>
    let compModal;

    document.addEventListener('DOMContentLoaded', function () {
        compModal = new bootstrap.Modal(document.getElementById('componentModal'));

        // Search in Allowances
        const allowanceSearchInput = document.getElementById('allowanceSearchInput');
        allowanceSearchInput?.addEventListener('keyup', function () {
            const value = this.value.toLowerCase();
            const rows = document.querySelectorAll('#allowancesTable tbody tr');
            rows.forEach(function (row) {
                const text = row.innerText.toLowerCase();
                row.style.display = text.includes(value) ? '' : 'none';
            });
        });

        // Search in Deductions
        const deductionSearchInput = document.getElementById('deductionSearchInput');
        deductionSearchInput?.addEventListener('keyup', function () {
            const value = this.value.toLowerCase();
            const rows = document.querySelectorAll('#deductionsTable tbody tr');
            rows.forEach(function (row) {
                const text = row.innerText.toLowerCase();
                row.style.display = text.includes(value) ? '' : 'none';
            });
        });
    });

    function openCreateModal() {
        document.getElementById('modalTitle').innerHTML = '<i class="fa-solid fa-plus text-primary me-2"></i>Create Salary Component';
        document.getElementById('modalCompId').value = '0';
        document.getElementById('modalComponentName').value = '';
        document.getElementById('modalCode').value = '';
        document.getElementById('modalType').value = 'Allowance';
        document.getElementById('modalTaxability').value = 'Fully Taxable';
        document.getElementById('modalCalculationBasis').value = 'Fixed Amount';
        document.getElementById('modalDefaultValueOrRate').value = '0.00';
        document.getElementById('modalMaxCapLimit').value = 'No Limit';
        document.getElementById('modalPayFrequency').value = 'Monthly';
        document.getElementById('modalIsActive').checked = true;
        compModal.show();
    }

    function openEditModal(item) {
        document.getElementById('modalTitle').innerHTML = '<i class="fa-solid fa-pen-to-square text-primary me-2"></i>Edit Salary Component';
        document.getElementById('modalCompId').value = item.Id;
        document.getElementById('modalComponentName').value = item.ComponentName || '';
        document.getElementById('modalCode').value = item.Code || '';
        document.getElementById('modalType').value = item.Type || 'Allowance';
        document.getElementById('modalTaxability').value = item.Taxability || 'Fully Taxable';
        document.getElementById('modalCalculationBasis').value = item.CalculationBasis || 'Fixed Amount';
        document.getElementById('modalDefaultValueOrRate').value = item.DefaultValueOrRate !== undefined ? item.DefaultValueOrRate : 0.00;
        document.getElementById('modalMaxCapLimit').value = item.MaxCapLimit || 'No Limit';
        document.getElementById('modalPayFrequency').value = item.PayFrequency || 'Monthly';
        document.getElementById('modalIsActive').checked = item.IsActive !== false;
        compModal.show();
    }

    function getAntiForgeryToken() {
        return document.querySelector('#antiForgeryForm input[name="__RequestVerificationToken"]')?.value || '';
    }

    function toggleStatus(id) {
        const token = getAntiForgeryToken();
        const formData = new FormData();
        formData.append('id', id);
        formData.append('__RequestVerificationToken', token);

        fetch('@Url.Action("ToggleComponentStatus", "HRPayroll")', {
            method: 'POST',
            body: formData,
            headers: {
                'X-Requested-With': 'XMLHttpRequest'
            }
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                const badge = document.getElementById('badge-' + id);
                if (badge) {
                    if (data.isActive) {
                        badge.className = 'status-badge active-badge';
                        badge.innerHTML = '<i class="fa-solid fa-circle-check"></i>Active';
                    } else {
                        badge.className = 'status-badge inactive-badge';
                        badge.innerHTML = '<i class="fa-solid fa-circle-minus"></i>Inactive';
                    }
                }
            } else {
                alert(data.message || 'Failed to toggle status.');
            }
        })
        .catch(() => {
            window.location.reload();
        });
    }

    function deleteComponent(id, name) {
        if (!confirm(`Are you sure you want to delete component "${name}"?`)) {
            return;
        }

        const token = getAntiForgeryToken();
        const formData = new FormData();
        formData.append('id', id);
        formData.append('__RequestVerificationToken', token);

        fetch('@Url.Action("DeleteComponent", "HRPayroll")', {
            method: 'POST',
            body: formData,
            headers: {
                'X-Requested-With': 'XMLHttpRequest'
            }
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                const row = document.getElementById('comp-row-' + id);
                if (row) {
                    row.remove();
                }
            } else {
                alert(data.message || 'Failed to delete component.');
            }
        })
        .catch(() => {
            window.location.reload();
        });
    }
</script>
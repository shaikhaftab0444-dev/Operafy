@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Salary Structures (CTC Breakdown)";
}

<div class="container-fluid py-4 text-start">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-bold mb-1"><i class="fa-solid fa-wallet text-primary me-2"></i>Salary Structures</h4>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0 small">
                    <li class="breadcrumb-item"><a href="/HR" class="text-decoration-none">HR Dashboard</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Salary Structures</li>
                </ol>
            </nav>
        </div>
        <button class="btn btn-primary rounded-pill px-3 btn-sm shadow-sm"><i class="fa-solid fa-plus me-1.5"></i>Create Structure</button>
    </div>

    <!-- Salary Structures Grid -->
    <div class="bg-white border rounded-3 p-4 shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" style="font-size: 0.85rem;">
                <thead class="table-light">
                    <tr>
                        <th>Structure Name</th>
                        <th>Basic Salary (%)</th>
                        <th>HRA (%)</th>
                        <th>LTA (%)</th>
                        <th>Special Allowance</th>
                        <th>PF Contribution</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td class="fw-bold text-dark">Standard Executive CTC</td>
                        <td>50% of CTC</td>
                        <td>20% of CTC</td>
                        <td>5% of CTC</td>
                        <td>Balance amount</td>
                        <td>12% of Basic</td>
                        <td><span class="badge bg-success-subtle text-success">Active</span></td>
                    </tr>
                    <tr>
                        <td class="fw-bold text-dark">Developer Grade A CTC</td>
                        <td>45% of CTC</td>
                        <td>22.5% of CTC</td>
                        <td>5% of CTC</td>
                        <td>Balance amount</td>
                        <td>12% of Basic</td>
                        <td><span class="badge bg-success-subtle text-success">Active</span></td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Statutory Compliance (PF / ESI / TDS)";
}

<div class="container-fluid py-4 text-start">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-bold mb-1"><i class="fa-solid fa-building-shield text-primary me-2"></i>Statutory Compliance</h4>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0 small">
                    <li class="breadcrumb-item"><a href="/HR" class="text-decoration-none">HR Dashboard</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Statutory Compliance</li>
                </ol>
            </nav>
        </div>
    </div>

    <!-- Compliance Slab Cards -->
    <div class="row g-4 mb-4">
        <div class="col-md-4">
            <div class="bg-white border rounded-3 p-3 shadow-sm">
                <div class="text-muted fw-semibold small">Provident Fund (PF)</div>
                <h5 class="fw-bold text-dark mt-2 mb-1">Employer: 12% | Employee: 12%</h5>
                <div class="text-muted small">Applicable on basic salary cap of ₹15,000</div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="bg-white border rounded-3 p-3 shadow-sm">
                <div class="text-muted fw-semibold small">ESI Contribution</div>
                <h5 class="fw-bold text-dark mt-2 mb-1">Employer: 3.25% | Employee: 0.75%</h5>
                <div class="text-muted small">Applicable on Gross salary <= ₹21,000</div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="bg-white border rounded-3 p-3 shadow-sm">
                <div class="text-muted fw-semibold small">TDS Slab Config</div>
                <h5 class="fw-bold text-dark mt-2 mb-1">New Tax Regime Default</h5>
                <div class="text-muted small">Zero tax up to ₹7,00,000 annual income</div>
            </div>
        </div>
    </div>

    <!-- Compliance Tracker Table -->
    <div class="bg-white border rounded-3 p-4 shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" style="font-size: 0.85rem;">
                <thead class="table-light">
                    <tr>
                        <th>Compliance Act</th>
                        <th>Frequency</th>
                        <th>Due Date</th>
                        <th>Last Filing Period</th>
                        <th>Filing Status</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td class="fw-bold text-dark">Provident Fund ECR Filing</td>
                        <td>Monthly</td>
                        <td>15th of next month</td>
                        <td>July 2026</td>
                        <td><span class="badge bg-success-subtle text-success">Filed (Receipt #PF-77482)</span></td>
                    </tr>
                    <tr>
                        <td class="fw-bold text-dark">ESI Monthly Return</td>
                        <td>Monthly</td>
                        <td>15th of next month</td>
                        <td>July 2026</td>
                        <td><span class="badge bg-success-subtle text-success">Filed (Receipt #ESI-99381)</span></td>
                    </tr>
                    <tr>
                        <td class="fw-bold text-dark">TDS Quarter Return (Form 24Q)</td>
                        <td>Quarterly</td>
                        <td>31st after quarter end</td>
                        <td>Q1 (Apr-Jun 2026)</td>
                        <td><span class="badge bg-success-subtle text-success">Filed</span></td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

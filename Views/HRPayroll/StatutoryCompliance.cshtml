@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Statutory Compliance (PF / ESI / TDS)";
    var pfConfig = ViewBag.PFConfig as ERP_System.Models.StatutoryConfiguration;
    var esiConfig = ViewBag.ESIConfig as ERP_System.Models.StatutoryConfiguration;
    var tdsConfig = ViewBag.TDSConfig as ERP_System.Models.StatutoryConfiguration;
    var filings = ViewBag.Filings as List<ERP_System.Models.StatutoryFilingLog> ?? new List<ERP_System.Models.StatutoryFilingLog>();
}

<div class="container-fluid py-4 text-start">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3 shadow-sm mb-4" role="alert">
            <i class="fa-solid fa-circle-check me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Header Section -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
        <div>
            <h4 class="fw-bold mb-1"><i class="fa-solid fa-building-shield text-primary me-2"></i>Statutory Compliance & Settings</h4>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0 small">
                    <li class="breadcrumb-item"><a href="/HR" class="text-decoration-none">HR Dashboard</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Statutory Compliance</li>
                </ol>
            </nav>
        </div>
        <button class="btn btn-primary rounded-pill px-3 btn-sm shadow-sm" data-bs-toggle="modal" data-bs-target="#addFilingModal">
            <i class="fa-solid fa-file-signature me-1.5"></i>Log Filing Receipt
        </button>
    </div>

    <!-- Statutory Rules Configuration Cards -->
    <div class="row g-4 mb-4">
        <!-- PF CONFIG CARD -->
        <div class="col-md-4">
            <div class="bg-white border rounded-3 p-4 shadow-sm h-100 position-relative">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div class="badge bg-primary-subtle text-primary fw-bold px-2.5 py-1">Provident Fund (PF)</div>
                    <button class="btn btn-sm btn-outline-primary rounded-pill btn-xs px-2" data-bs-toggle="modal" data-bs-target="#editPfModal">
                        <i class="fa-solid fa-pen me-1"></i>Configure
                    </button>
                </div>
                <h5 class="fw-bold text-dark mb-1">Employer: @(pfConfig?.EmployerRate)% | Employee: @(pfConfig?.EmployeeRate)%</h5>
                <p class="text-muted small mb-3">Statutory Provident Fund rate under EPF Act 1952.</p>
                <div class="bg-light p-2.5 rounded-3 border small">
                    <div class="d-flex justify-content-between mb-1">
                        <span class="text-muted">Wage Ceiling Cap:</span>
                        <span class="fw-bold text-dark">₹@(pfConfig?.WageCeilingLimit.ToString("N0")) / month</span>
                    </div>
                    <div class="d-flex justify-content-between">
                        <span class="text-muted">Max Employee Deduction:</span>
                        <span class="fw-bold text-success">₹1,800 / month</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- ESI CONFIG CARD -->
        <div class="col-md-4">
            <div class="bg-white border rounded-3 p-4 shadow-sm h-100 position-relative">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div class="badge bg-success-subtle text-success fw-bold px-2.5 py-1">ESI Contribution</div>
                    <button class="btn btn-sm btn-outline-primary rounded-pill btn-xs px-2" data-bs-toggle="modal" data-bs-target="#editEsiModal">
                        <i class="fa-solid fa-pen me-1"></i>Configure
                    </button>
                </div>
                <h5 class="fw-bold text-dark mb-1">Employer: @(esiConfig?.EmployerRate)% | Employee: @(esiConfig?.EmployeeRate)%</h5>
                <p class="text-muted small mb-3">Employees State Insurance Corporation compliance.</p>
                <div class="bg-light p-2.5 rounded-3 border small">
                    <div class="d-flex justify-content-between mb-1">
                        <span class="text-muted">Gross Salary Eligibility Cap:</span>
                        <span class="fw-bold text-dark">≤ ₹@(esiConfig?.WageCeilingLimit.ToString("N0")) / month</span>
                    </div>
                    <div class="d-flex justify-content-between">
                        <span class="text-muted">Eligibility:</span>
                        <span class="fw-bold text-info">Gross Wages ≤ ₹21k</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- TDS CONFIG CARD -->
        <div class="col-md-4">
            <div class="bg-white border rounded-3 p-4 shadow-sm h-100 position-relative">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div class="badge bg-warning-subtle text-warning-emphasis fw-bold px-2.5 py-1">TDS Slabs (Income Tax)</div>
                    <button class="btn btn-sm btn-outline-primary rounded-pill btn-xs px-2" data-bs-toggle="modal" data-bs-target="#editTdsModal">
                        <i class="fa-solid fa-pen me-1"></i>Configure
                    </button>
                </div>
                <h5 class="fw-bold text-dark mb-1">@(tdsConfig?.DefaultTaxRegime ?? "New Tax Regime")</h5>
                <p class="text-muted small mb-3">Section 192 Tax Deducted at Source withholding.</p>
                <div class="bg-light p-2.5 rounded-3 border small">
                    <div class="d-flex justify-content-between mb-1">
                        <span class="text-muted">Standard Deduction:</span>
                        <span class="fw-bold text-dark">₹@(tdsConfig?.StandardDeductionAnnual.ToString("N0")) / year</span>
                    </div>
                    <div class="d-flex justify-content-between">
                        <span class="text-muted">Zero Tax Limit:</span>
                        <span class="fw-bold text-success">Up to ₹7,00,000 annual</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Compliance Filing Tracker Table -->
    <div class="bg-white border rounded-3 p-4 shadow-sm">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h6 class="fw-bold text-dark mb-0"><i class="fa-solid fa-receipt text-primary me-2"></i>Statutory Return Filings Log</h6>
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" style="font-size: 0.85rem;">
                <thead class="table-light">
                    <tr>
                        <th>Compliance Act / Return</th>
                        <th>Frequency</th>
                        <th>Filing Period</th>
                        <th>Due Date</th>
                        <th>Filing Date</th>
                        <th>Receipt Number</th>
                        <th>Filing Status</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!filings.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center py-4 text-muted">No filing receipts logged yet. Click <strong>Log Filing Receipt</strong> to add one.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var f in filings)
                        {
                            <tr>
                                <td class="fw-bold text-dark">@f.ComplianceAct</td>
                                <td><span class="badge bg-light text-dark border">@f.Frequency</span></td>
                                <td>@f.Period</td>
                                <td>@f.DueDate.ToString("dd MMM yyyy")</td>
                                <td>@f.FilingDate.ToString("dd MMM yyyy")</td>
                                <td><code>@f.ReceiptNumber</code></td>
                                <td><span class="badge bg-success-subtle text-success"><i class="fa-solid fa-check me-1"></i>@f.Status</span></td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- MODAL: EDIT PF CONFIG -->
<div class="modal fade" id="editPfModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-light">
                <h5 class="modal-title fw-bold"><i class="fa-solid fa-pen-to-square text-primary me-2"></i>Update PF Settings</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="UpdateStatutoryConfig" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="ruleType" value="PF" />
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Employee Contribution Rate (%)</label>
                        <input type="number" step="0.01" name="employeeRate" class="form-control form-control-sm" value="@(pfConfig?.EmployeeRate ?? 12.00m)" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Employer Contribution Rate (%)</label>
                        <input type="number" step="0.01" name="employerRate" class="form-control form-control-sm" value="@(pfConfig?.EmployerRate ?? 12.00m)" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Basic Wage Ceiling Limit (₹/month)</label>
                        <input type="number" step="100" name="wageCeilingLimit" class="form-control form-control-sm" value="@(pfConfig?.WageCeilingLimit ?? 15000.00m)" required>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary btn-sm rounded-pill px-3" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary btn-sm rounded-pill px-3">Update Rules</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- MODAL: EDIT ESI CONFIG -->
<div class="modal fade" id="editEsiModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-light">
                <h5 class="modal-title fw-bold"><i class="fa-solid fa-pen-to-square text-primary me-2"></i>Update ESI Settings</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="UpdateStatutoryConfig" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="ruleType" value="ESI" />
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Employee ESI Rate (%)</label>
                        <input type="number" step="0.01" name="employeeRate" class="form-control form-control-sm" value="@(esiConfig?.EmployeeRate ?? 0.75m)" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Employer ESI Rate (%)</label>
                        <input type="number" step="0.01" name="employerRate" class="form-control form-control-sm" value="@(esiConfig?.EmployerRate ?? 3.25m)" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Gross Salary Eligibility Limit (₹/month)</label>
                        <input type="number" step="100" name="wageCeilingLimit" class="form-control form-control-sm" value="@(esiConfig?.WageCeilingLimit ?? 21000.00m)" required>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary btn-sm rounded-pill px-3" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary btn-sm rounded-pill px-3">Update ESI Rules</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- MODAL: EDIT TDS CONFIG -->
<div class="modal fade" id="editTdsModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-light">
                <h5 class="modal-title fw-bold"><i class="fa-solid fa-pen-to-square text-primary me-2"></i>Update TDS Settings</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="UpdateStatutoryConfig" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="ruleType" value="TDS" />
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Default Tax Regime</label>
                        <select name="defaultTaxRegime" class="form-select form-select-sm">
                            <option value="New Tax Regime">New Tax Regime (Section 115BAC)</option>
                            <option value="Old Tax Regime">Old Tax Regime (With Deductions)</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Standard Deduction (Annual ₹)</label>
                        <input type="number" step="1000" name="standardDeductionAnnual" class="form-control form-control-sm" value="@(tdsConfig?.StandardDeductionAnnual ?? 75000.00m)" required>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary btn-sm rounded-pill px-3" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary btn-sm rounded-pill px-3">Update TDS Slabs</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- MODAL: LOG FILING RECEIPT -->
<div class="modal fade" id="addFilingModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-light">
                <h5 class="modal-title fw-bold"><i class="fa-solid fa-plus-circle text-primary me-2"></i>Log Statutory Return Filing</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="AddFilingRecord" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body p-4">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">Compliance Return</label>
                            <select name="ComplianceAct" class="form-select form-select-sm" required>
                                <option value="Provident Fund ECR Filing">PF ECR Monthly Return</option>
                                <option value="ESI Monthly Return">ESI Monthly Return</option>
                                <option value="TDS Quarter Return (Form 24Q)">TDS Form 24Q Quarterly Return</option>
                                <option value="Professional Tax Return">Professional Tax Monthly Return</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">Frequency</label>
                            <select name="Frequency" class="form-select form-select-sm">
                                <option value="Monthly">Monthly</option>
                                <option value="Quarterly">Quarterly</option>
                                <option value="Annual">Annual</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">Filing Period</label>
                            <input type="text" name="Period" class="form-control form-control-sm" required placeholder="e.g. August 2026 or Q2 2026">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">Due Date</label>
                            <input type="date" name="DueDate" class="form-control form-control-sm" required value="@DateTime.Today.AddDays(15).ToString("yyyy-MM-dd")">
                        </div>
                        <div class="col-md-12">
                            <label class="form-label small fw-bold">Receipt / Challan Number <span class="text-danger">*</span></label>
                            <input type="text" name="ReceiptNumber" class="form-control form-control-sm" required placeholder="e.g. PF-8839201">
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary btn-sm rounded-pill px-3" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary btn-sm rounded-pill px-3">Save Receipt</button>
                </div>
            </form>
        </div>
    </div>
</div>

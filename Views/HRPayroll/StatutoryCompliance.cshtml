    <!-- =========================================================
         FILING LOG SECTION
    ========================================================= -->
    <div class="filing-section">

        <div class="filing-header">

            <div class="filing-title-wrap">
                <div class="filing-title-icon">
                    <i class="fa-solid fa-receipt"></i>
                </div>

                <div>
                    <h6 class="filing-title">Statutory Return Filings & Bank Debits</h6>
                    <div class="filing-subtitle">
                        Track filing receipts, challan payments, debited company bank accounts, and completed compliance returns.
                    </div>
                </div>
            </div>

            <div class="filing-count">
                <i class="fa-solid fa-file-lines me-1"></i>
                @filings.Count Record@(filings.Count == 1 ? "" : "s")
            </div>

        </div>


        <div class="table-responsive">
            <table class="table compliance-table align-middle">

                <thead>
                    <tr>
                        <th>Compliance Return</th>
                        <th>Frequency</th>
                        <th>Filing Period</th>
                        <th>Due Date</th>
                        <th>Filing Date</th>
                        <th>Receipt / Challan #</th>
                        <th>Challan Amount</th>
                        <th>Debited Bank Account</th>
                        <th>Status</th>
                    </tr>
                </thead>

                <tbody>

                    @if (!filings.Any())
                    {
                        <tr>
                            <td colspan="9" class="empty-state">

                                <div class="empty-icon">
                                    <i class="fa-solid fa-folder-open"></i>
                                </div>

                                <div class="empty-title">
                                    No filing records yet
                                </div>

                                <p class="empty-text">
                                    Log your first PF, ESI, TDS or Professional Tax statutory filing receipt with automated bank account debiting.
                                </p>

                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var f in filings)
                        {
                            <tr>

                                <td>
                                    <div class="return-name">
                                        <div class="return-icon">
                                            <i class="fa-solid fa-file-circle-check"></i>
                                        </div>
                                        <span>@f.ComplianceReturn</span>
                                    </div>
                                </td>

                                <td>
                                    <span class="frequency-badge">
                                        <i class="fa-regular fa-clock me-1"></i>
                                        @f.Frequency
                                    </span>
                                </td>

                                <td class="fw-semibold">
                                    @f.FilingPeriod
                                </td>

                                <td>
                                    <span>
                                        <i class="fa-regular fa-calendar me-1 text-muted"></i>
                                        @f.DueDate.ToString("dd MMM yyyy")
                                    </span>
                                </td>

                                <td>
                                    <span>
                                        <i class="fa-regular fa-calendar-check me-1 text-success"></i>
                                        @f.FilingDate.ToString("dd MMM yyyy")
                                    </span>
                                </td>

                                <td>
                                    <code class="receipt-code">
                                        @f.ReceiptOrChallanNumber
                                    </code>
                                </td>

                                <td>
                                    <span class="amount-text">
                                        ₹@f.ChallanAmountPaid.ToString("N2")
                                    </span>
                                </td>

                                <td>
                                    @if (f.CompanyBankAccount != null)
                                    {
                                        <span class="bank-badge">
                                            <i class="fa-solid fa-building-columns text-primary"></i>
                                            @f.CompanyBankAccount.BankName (@(f.CompanyBankAccount.AccountNumber.Length > 4 ? ".." + f.CompanyBankAccount.AccountNumber.Substring(f.CompanyBankAccount.AccountNumber.Length - 4) : f.CompanyBankAccount.AccountNumber))
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">Direct / Non-Linked</span>
                                    }
                                </td>

                                <td>
                                    <span class="status-completed">
                                        <i class="fa-solid fa-circle-check"></i>
                                        @f.Status
                                    </span>
                                </td>

                            </tr>
                        }
                    }

                </tbody>
            </table>
        </div>

    </div>

</div>



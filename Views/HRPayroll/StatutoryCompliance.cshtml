========================================================= -->
<div class="modal fade statutory-modal" id="logFilingModal" tabindex="-1" aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered modal-lg">

        <div class="modal-content">

            <div class="modal-header">

                <div class="modal-title-wrap">

                    <div class="modal-title-icon">
                        <i class="fa-solid fa-file-circle-plus"></i>
                    </div>

                    <div>
                        <h5>Log Statutory Return Filing & Challan Payment</h5>
                        <div class="modal-subtitle">
                            Record compliance filing and automatically debit company bank account ledger
                        </div>
                    </div>

                </div>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Close"></button>

            </div>


            <form asp-action="LogFilingReceipt" method="post">

                @Html.AntiForgeryToken()

                <div class="modal-body">

                    <div class="row g-3">

                        <div class="col-md-6">

                            <label class="form-label">
                                <i class="fa-solid fa-building-columns modal-field-icon"></i>
                                Compliance Return <span class="text-danger">*</span>
                            </label>

                            <select name="complianceReturn"
                                    class="form-select"
                                    required>

                                <option value="Provident Fund ECR Monthly Return">
                                    Provident Fund (PF) ECR Monthly Return
                                </option>

                                <option value="ESI Monthly Return (Challan)">
                                    ESI Monthly Return & Challan
                                </option>

                                <option value="TDS Form 24Q (Salary TDS)">
                                    TDS Form 24Q Quarterly Return
                                </option>

                                <option value="Professional Tax Monthly Return">
                                    Professional Tax (PT) Return
                                </option>

                            </select>

                        </div>


                        <div class="col-md-6">

                            <label class="form-label">
                                <i class="fa-solid fa-repeat modal-field-icon"></i>
                                Frequency
                            </label>

                            <select name="frequency" class="form-select">

                                <option value="Monthly">Monthly</option>
                                <option value="Quarterly">Quarterly</option>
                                <option value="Annual">Annual</option>

                            </select>

                        </div>


                        <div class="col-md-6">

                            <label class="form-label">
                                <i class="fa-solid fa-calendar-days modal-field-icon"></i>
                                Filing Period <span class="text-danger">*</span>
                            </label>

                            <input type="text"
                                   name="filingPeriod"
                                   class="form-control"
                                   required
                                   placeholder="e.g. August 2026 or Q2 FY 2026-27">

                        </div>


                        <div class="col-md-6">

                            <label class="form-label">
                                <i class="fa-solid fa-calendar-check modal-field-icon"></i>
                                Due Date <span class="text-danger">*</span>
                            </label>

                            <input type="date"
                                   name="dueDate"
                                   class="form-control"
                                   required
                                   value="@DateTime.Today.AddDays(15).ToString("yyyy-MM-dd")">

                        </div>


                        <div class="col-md-6">

                            <label class="form-label">
                                <i class="fa-solid fa-hashtag modal-field-icon"></i>
                                Receipt / Challan / BSR Number <span class="text-danger">*</span>
                            </label>

                            <input type="text"
                                   name="receiptOrChallanNumber"
                                   class="form-control"
                                   required
                                   placeholder="e.g. PF-8839201 or CRN-99281">

                        </div>


                        <div class="col-md-6">

                            <label class="form-label">
                                <i class="fa-solid fa-indian-rupee-sign modal-field-icon"></i>
                                Challan Amount Paid (₹) <span class="text-danger">*</span>
                            </label>

                            <input type="number"
                                   step="0.01"
                                   min="0"
                                   name="challanAmountPaid"
                                   class="form-control"
                                   required
                                   placeholder="0.00">

                        </div>


                        <div class="col-12">

                            <label class="form-label">
                                <i class="fa-solid fa-building-columns modal-field-icon"></i>
                                Company Bank Account for Challan Debit
                            </label>

                            <select name="companyBankAccountId" class="form-select">
                                <option value="">-- No Direct Bank Debit / Manual Cash / Outside ERP --</option>
                                @foreach (var b in bankAccounts)
                                {
                                    <option value="@b.Id">
                                        @b.BankName - @b.AccountNumber (Available Bal: ₹@b.CurrentBalance.ToString("N2")) @(b.IsPrimaryAccount ? "★ Primary" : "")
                                    </option>
                                }
                            </select>
                            <small class="text-muted">Selecting an account will automatically deduct the amount from company funds and log a general ledger bank transaction entry.</small>

                        </div>

                    </div>

                </div>


                <div class="modal-footer">

                    <button type="button"
                            class="btn btn-light btn-modal-cancel"
                            data-bs-dismiss="modal">
                        Cancel
                    </button>

                    <button type="submit"
                            class="btn btn-modal-save">
                        <i class="fa-solid fa-floppy-disk me-1"></i>
                        Record Filing & Debit Bank
                    </button>

                </div>

            </form>

        </div>

    </div>

</div>

@section Scripts {
    <script>
        // Connect to SignalR Payroll Hub for real-time compliance updates
        document.addEventListener("DOMContentLoaded", function () {
            if (typeof signalR !== "undefined") {
                const connection = new signalR.HubConnectionBuilder()
                    .withUrl("/payrollHub")
                    .withAutomaticReconnect()
                    .build();

                connection.on("ReceiveStatutoryRuleUpdated", function (data) {
                    console.log("Statutory rule updated in real-time:", data);
                });

                connection.on("ReceiveStatutoryReturnFiled", function (data) {
                    console.log("Statutory return filed:", data);
                });

                connection.start().catch(err => console.debug("SignalR connection skipped:", err));
            }
        });
    </script>
}
@model List<ERP_System.Models.BonusIncentive>
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Bonus & Incentive Tracker";
    var employees = ViewBag.ActiveEmployees as List<ERP_System.Models.User> ?? new List<ERP_System.Models.User>();
}

<div class="container-fluid py-4 text-start">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3 shadow-sm mb-4" role="alert">
            <i class="fa-solid fa-circle-check me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-3 shadow-sm mb-4" role="alert">
            <i class="fa-solid fa-circle-exclamation me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Header Section -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
        <div>
            <h4 class="fw-bold mb-1"><i class="fa-solid fa-gift text-primary me-2"></i>Bonus & Incentive Management</h4>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0 small">
                    <li class="breadcrumb-item"><a href="/HR" class="text-decoration-none">HR Dashboard</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Bonus & Incentives</li>
                </ol>
            </nav>
        </div>
        <button class="btn btn-primary rounded-pill px-3.5 btn-sm shadow-sm" data-bs-toggle="modal" data-bs-target="#awardBonusModal">
            <i class="fa-solid fa-plus me-1.5"></i>Award Incentive / Bonus
        </button>
    </div>

    <!-- Stats Summary Cards -->
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="bg-white border rounded-3 p-3 shadow-sm d-flex align-items-center justify-content-between">
                <div>
                    <div class="text-muted small fw-semibold">Total Bonus Records</div>
                    <h3 class="fw-bold mb-0 text-dark">@(Model?.Count ?? 0)</h3>
                </div>
                <div class="bg-primary-subtle text-primary p-3 rounded-circle">
                    <i class="fa-solid fa-trophy fa-lg"></i>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="bg-white border rounded-3 p-3 shadow-sm d-flex align-items-center justify-content-between">
                <div>
                    <div class="text-muted small fw-semibold">Approved for Payout</div>
                    <h3 class="fw-bold mb-0 text-success">₹@(ViewBag.ApprovedTotal?.ToString("N0"))</h3>
                </div>
                <div class="bg-success-subtle text-success p-3 rounded-circle">
                    <i class="fa-solid fa-circle-check fa-lg"></i>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="bg-white border rounded-3 p-3 shadow-sm d-flex align-items-center justify-content-between">
                <div>
                    <div class="text-muted small fw-semibold">Pending Approvals</div>
                    <h3 class="fw-bold mb-0 text-warning">@(Model?.Count(m => m.Status == "Draft" || m.Status == "Submitted") ?? 0)</h3>
                </div>
                <div class="bg-warning-subtle text-warning p-3 rounded-circle">
                    <i class="fa-solid fa-hourglass-half fa-lg"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- Tracker List Table -->
    <div class="bg-white border rounded-3 p-4 shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" style="font-size: 0.85rem;">
                <thead class="table-light">
                    <tr>
                        <th>Employee</th>
                        <th>Incentive Type</th>
                        <th>Amount</th>
                        <th>Performance Period</th>
                        <th>Payout Month</th>
                        <th>Reason / Description</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model == null || !Model.Any())
                    {
                        <tr>
                            <td colspan="8" class="text-center py-4 text-muted">
                                <i class="fa-solid fa-gift fa-2x mb-2 text-secondary d-block"></i>
                                No bonus or incentive records logged yet. Click <strong>Award Incentive / Bonus</strong> above.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    <div class="fw-bold text-dark">@(item.User?.FullName ?? "N/A")</div>
                                    <div class="text-muted extra-small">Code: @(item.User?.UserCode)</div>
                                </td>
                                <td><span class="badge bg-primary-subtle text-primary">@item.Type</span></td>
                                <td class="fw-bold text-success">₹@item.Amount.ToString("N0")</td>
                                <td>@item.PerformancePeriod</td>
                                <td><span class="badge bg-light text-dark border">@item.PayoutMonth</span></td>
                                <td class="text-muted">@(item.Reason ?? "N/A")</td>
                                <td>
                                    @if (item.Status == "Paid" || item.Status == "Included in Payroll")
                                    {
                                        <span class="badge bg-success-subtle text-success"><i class="fa-solid fa-check me-1"></i>@item.Status</span>
                                    }
                                    else if (item.Status == "Approved")
                                    {
                                        <span class="badge bg-info-subtle text-info"><i class="fa-solid fa-thumbs-up me-1"></i>Approved for Payout</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning-subtle text-warning"><i class="fa-solid fa-clock me-1"></i>@item.Status</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <div class="btn-group btn-group-sm">
                                        @if (item.Status == "Draft" || item.Status == "Submitted")
                                        {
                                            <form asp-action="ApproveBonusIncentive" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@item.BonusId" />
                                                <button type="submit" class="btn btn-outline-success btn-xs rounded-pill px-2.5 me-1" title="Approve">
                                                    <i class="fa-solid fa-check me-1"></i>Approve
                                                </button>
                                            </form>
                                        }

                                        @if (item.Status != "Included in Payroll" && item.Status != "Paid")
                                        {
                                            <form asp-action="DeleteBonusIncentive" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this bonus record?');">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@item.BonusId" />
                                                <button type="submit" class="btn btn-outline-danger btn-xs rounded-circle" title="Delete"><i class="fa-solid fa-trash"></i></button>
                                            </form>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- AWARD BONUS MODAL -->
<div class="modal fade" id="awardBonusModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-light">
                <h5 class="modal-title fw-bold"><i class="fa-solid fa-gift text-primary me-2"></i>Award Bonus or Sales Incentive</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="SaveBonusIncentive" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body p-4 text-start">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">Select Employee <span class="text-danger">*</span></label>
                            <select name="UserId" class="form-select form-select-sm" required>
                                <option value="">-- Choose Employee --</option>
                                @foreach (var emp in employees)
                                {
                                    <option value="@emp.UserId">@emp.FullName (@emp.UserCode)</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">Incentive Type <span class="text-danger">*</span></label>
                            <select name="Type" class="form-select form-select-sm" required>
                                <option value="Sales Incentive">Sales Incentive / Commission</option>
                                <option value="Performance Bonus">Performance Bonus</option>
                                <option value="Festival Bonus">Festival Bonus (Diwali / Eid / New Year)</option>
                                <option value="Annual Bonus">Annual Bonus</option>
                                <option value="Project Incentive">Project Milestone Incentive</option>
                                <option value="Custom Incentive">Custom Incentive</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">Award Amount (₹) <span class="text-danger">*</span></label>
                            <input type="number" step="100" name="Amount" class="form-control form-control-sm" required placeholder="e.g. 15000">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">Performance Period</label>
                            <input type="text" name="PerformancePeriod" class="form-control form-control-sm" required value="August 2026" placeholder="e.g. Q2 2026 or August 2026">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">Payout Month <span class="text-danger">*</span></label>
                            <input type="text" name="PayoutMonth" class="form-control form-control-sm" required value="August 2026" placeholder="e.g. August 2026">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">Reason / Description</label>
                            <input type="text" name="Reason" class="form-control form-control-sm" placeholder="e.g. Top Sales Performer in Q2">
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary btn-sm rounded-pill px-3" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary btn-sm rounded-pill px-4"><i class="fa-solid fa-award me-1"></i>Award Bonus</button>
                </div>
            </form>
        </div>
    </div>
</div>

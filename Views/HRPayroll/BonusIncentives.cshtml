@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Bonus & Incentive Tracker";
}

<div class="container-fluid py-4 text-start">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-bold mb-1"><i class="fa-solid fa-gift text-primary me-2"></i>Bonus & Incentive Tracker</h4>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0 small">
                    <li class="breadcrumb-item"><a href="/HR" class="text-decoration-none">HR Dashboard</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Bonus & Incentives</li>
                </ol>
            </nav>
        </div>
        <button class="btn btn-primary rounded-pill px-3 btn-sm shadow-sm"><i class="fa-solid fa-plus me-1.5"></i>Award Incentive/Bonus</button>
    </div>

    <!-- Tracker List -->
    <div class="bg-white border rounded-3 p-4 shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" style="font-size: 0.85rem;">
                <thead class="table-light">
                    <tr>
                        <th>Employee</th>
                        <th>Type</th>
                        <th>Amount</th>
                        <th>Performance Period</th>
                        <th>Approval Date</th>
                        <th>Payout Month</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td class="fw-bold text-dark">Numan Sales Man</td>
                        <td>Sales Commission</td>
                        <td class="fw-bold text-success">₹15,000</td>
                        <td>Q2 2026</td>
                        <td>10 Aug 2026</td>
                        <td>August 2026</td>
                        <td><span class="badge bg-success-subtle text-success">Approved for Payout</span></td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

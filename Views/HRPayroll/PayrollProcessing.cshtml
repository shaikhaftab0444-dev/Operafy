@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Monthly Payroll Processing";
}

<div class="container-fluid py-4 text-start">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-bold mb-1"><i class="fa-solid fa-receipt text-primary me-2"></i>Monthly Payroll Processing</h4>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0 small">
                    <li class="breadcrumb-item"><a href="/HR" class="text-decoration-none">HR Dashboard</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Payroll Processing</li>
                </ol>
            </nav>
        </div>
        <button class="btn btn-primary rounded-pill px-3 btn-sm shadow-sm"><i class="fa-solid fa-gear me-1.5"></i>Run Payroll Run</button>
    </div>

    <!-- Payroll Runs History Table -->
    <div class="bg-white border rounded-3 p-4 shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" style="font-size: 0.85rem;">
                <thead class="table-light">
                    <tr>
                        <th>Pay Period</th>
                        <th>Processed Employees</th>
                        <th>Total Gross Payout</th>
                        <th>Total Deductions</th>
                        <th>Net Paid Amount</th>
                        <th>Processed Date</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td class="fw-bold text-dark">August 2026</td>
                        <td>45 Employees</td>
                        <td>₹28,50,000</td>
                        <td>₹3,15,000</td>
                        <td class="fw-bold text-success">₹25,35,000</td>
                        <td>In Draft</td>
                        <td><span class="badge bg-warning-subtle text-warning">Draft (Pending Verification)</span></td>
                    </tr>
                    <tr>
                        <td class="fw-bold text-dark">July 2026</td>
                        <td>43 Employees</td>
                        <td>₹26,80,000</td>
                        <td>₹2,95,000</td>
                        <td class="fw-bold text-success">₹23,85,000</td>
                        <td>31 Jul 2026</td>
                        <td><span class="badge bg-success-subtle text-success">Paid & Closed</span></td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

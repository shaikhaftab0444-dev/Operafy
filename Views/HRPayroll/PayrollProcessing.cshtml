    @@media (prefers-reduced-motion: reduce) {
        .payroll-page *,
        .payroll-page *::before,
        .payroll-page *::after {
            animation-duration: .01ms !important;
            animation-iteration-count: 1 !important;
            transition-duration: .01ms !important;
        }
    }
</style>

<div class="container-fluid py-4 text-start payroll-page">

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show page-alert mb-4" role="alert">
            <i class="fa-solid fa-circle-check me-2"></i>
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show page-alert mb-4" role="alert">
            <i class="fa-solid fa-circle-exclamation me-2"></i>
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="payroll-hero">
        <div class="payroll-hero-content">
            <div class="row align-items-center g-4">
                <div class="col-lg-8">
                    <div class="payroll-breadcrumb">
                        <a href="/HR">
                            <i class="fa-solid fa-house me-1"></i>HR Dashboard
                        </a>
                        <span class="separator"><i class="fa-solid fa-chevron-right"></i></span>
                        <span>Payroll Processing</span>
                    </div>

                    <h1 class="payroll-title">
                        <i class="fa-solid fa-receipt me-2"></i>
                        Monthly Payroll Processing
                    </h1>

                    <p class="payroll-subtitle">
                        Process employee salaries, calculate statutory deductions, verify payroll records,
                        approve the pay run and complete salary disbursement with live bank integration and ESS publication.
                    </p>

                    <div class="payroll-engine-badge">
                        <span class="engine-dot"></span>
                        Payroll Processing Engine Ready
                    </div>
                </div>

                <div class="col-lg-4 text-lg-end">
                    <div class="hero-actions">
                        <button class="btn payroll-run-btn"
                                data-bs-toggle="modal"
                                data-bs-target="#runPayrollModal">
                            <i class="fa-solid fa-play me-2"></i>
                            Execute Pay Run
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-3 mb-4">

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="payroll-stat-card delay-1">
                <div class="stat-top">
                    <div>
                        <div class="stat-label">Eligible Employees</div>
                        <h3 class="stat-value">@activeEmployeesCount</h3>
                    </div>

                    <div class="stat-icon icon-blue">
                        <i class="fa-solid fa-users"></i>
                    </div>
                </div>

                <div class="stat-footer">
                    <i class="fa-solid fa-user-check"></i>
                    Active employees available for processing
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="payroll-stat-card delay-2">
                <div class="stat-top">
                    <div>
                        <div class="stat-label">Total Pay Runs</div>
                        <h3 class="stat-value">@runs.Count</h3>
                    </div>

                    <div class="stat-icon icon-cyan">
                        <i class="fa-solid fa-file-invoice-dollar"></i>
                    </div>
                </div>

                <div class="stat-footer">
                    <i class="fa-solid fa-layer-group"></i>
                    Historical payroll cycles recorded
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="payroll-stat-card delay-3">
                <div class="stat-top">
                    <div>
                        <div class="stat-label">Pending Approval</div>
                        <h3 class="stat-value stat-warning">@draftRunsCount</h3>
                    </div>

                    <div class="stat-icon icon-orange">
                        <i class="fa-solid fa-clock-rotate-left"></i>
                    </div>
                </div>

                <div class="stat-footer">
                    <i class="fa-solid fa-hourglass-half"></i>
                    Requires verification or approval
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="payroll-stat-card delay-4">
                <div class="stat-top">
                    <div>
                        <div class="stat-label">Total Net Paid</div>
                        <h3 class="stat-value stat-success">
                            ₹@(((decimal)totalNetPaid).ToString("N0"))
                        </h3>
                    </div>

                    <div class="stat-icon icon-green">
                        <i class="fa-solid fa-money-bill-transfer"></i>
                    </div>
                </div>

                <div class="stat-footer">
                    <i class="fa-solid fa-circle-check"></i>
                    Completed and disbursed payroll runs
                </div>
            </div>
        </div>

    </div>

    <div class="payroll-history-card">

        <div class="history-card-header">
            <div class="history-title-wrap">
                <div class="history-title-icon">
                    <i class="fa-solid fa-list-check"></i>
                </div>

                <div>
                    <h6 class="history-title">Payroll Execution & Approval Workflow</h6>
                    <p class="history-subtitle">
                        Review, approve and track every payroll cycle from calculation to salary payment.
                    </p>
                </div>
            </div>

            <div class="history-count">
                <i class="fa-solid fa-receipt me-1"></i>
                @runs.Count Payroll Run@(runs.Count == 1 ? "" : "s")
            </div>
        </div>

        <div class="table-responsive">
            <table class="table payroll-table align-middle">
                <thead>
                    <tr>
                        <th>Pay Period</th>
                        <th>Department</th>
                        <th>Employees</th>
                        <th>Gross Payout</th>
                        <th>Deductions</th>
                        <th>Net Paid</th>
                        <th>Employer CTC</th>
                        <th>Disbursed Via</th>
                        <th>Status</th>
                        <th class="text-end">Workflow Actions</th>
                    </tr>
                </thead>

                <tbody>
                    @if (!runs.Any())
                    {
                        <tr>
                            <td colspan="10" class="text-center payroll-empty-state py-5">
                                <div class="empty-icon">
                                    <i class="fa-solid fa-calculator"></i>
                                </div>

                                <div class="empty-title">
                                    No Payroll Runs Available
                                </div>

                                <p class="empty-text">
                                    Start your first monthly payroll cycle using the Execute Pay Run button.
                                </p>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var r in runs)
                        {
                            <tr>
                                <td>
                                    <div class="period-cell">
                                        <div class="period-icon">
                                            <i class="fa-solid fa-calendar-check"></i>
                                        </div>

                                        <div>
                                            <div class="period-name">@r.PayPeriod</div>
                                            <div class="period-date">
                                                Processed @r.ProcessedAt.ToString("dd MMM yyyy")
                                            </div>
                                        </div>
                                    </div>
                                </td>

                                <td>
                                    <span class="department-pill">
                                        <i class="fa-solid fa-building me-1"></i>
                                        @r.Department
                                    </span>
                                </td>

                                <td>
                                    <span class="fw-bold text-dark">
                                        @r.TotalEmployees Employee@(r.TotalEmployees == 1 ? "" : "s")
                                    </span>
                                </td>

                                <td>
                                    <span class="money-value">
                                        ₹@r.TotalGrossSalary.ToString("N0")
                                    </span>
                                </td>

                                <td>
                                    <span class="money-deduction">
                                        ₹@r.TotalDeductions.ToString("N0")
                                    </span>
                                </td>

                                <td>
                                    <span class="money-net">
                                        ₹@r.TotalNetSalary.ToString("N0")
                                    </span>
                                </td>

                                <td>
                                    <span class="money-ctc">
                                        ₹@r.TotalCTC.ToString("N0")
                                    </span>
                                </td>

                                <td>
                                    @if (r.CompanyBankAccount != null)
                                    {
                                        <span class="badge bg-light text-primary border px-2 py-1" style="font-size: 0.72rem;">
                                            <i class="fa-solid fa-building-columns me-1"></i>@r.CompanyBankAccount.BankName
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">—</span>
                                    }
                                </td>

                                <td>
                                    @if (r.Status == "Paid & Closed" || r.Status == "Paid")
                                    {
                                        <span class="status-pill status-paid">
                                            <i class="fa-solid fa-circle-check"></i>
                                            Paid & Closed
                                        </span>
                                    }
                                    else if (r.Status == "Approved")
                                    {
                                        <span class="status-pill status-approved">
                                            <i class="fa-solid fa-thumbs-up"></i>
                                            Approved
                                        </span>
                                    }
                                    else if (r.Status == "Locked")
                                    {
                                        <span class="status-pill status-locked">
                                            <i class="fa-solid fa-lock"></i>
                                            Locked
                                        </span>
                                    }
                                    else if (r.Status == "Under Review")
                                    {
                                        <span class="status-pill status-review">
                                            <i class="fa-solid fa-magnifying-glass"></i>
                                            Under Review
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="status-pill status-draft">
                                            <i class="fa-solid fa-hourglass-half"></i>
                                            @(string.IsNullOrEmpty(r.Status) ? "Draft" : r.Status)
                                        </span>
                                    }
                                </td>

                                <td class="text-end">
                                    <div class="action-wrap">

                                        <button type="button"
                                                class="btn btn-outline-primary payroll-action-btn"
                                                onclick="inspectPayroll(@r.PayrollRunId)">
                                            <i class="fa-solid fa-eye me-1"></i>
                                            Inspect
                                        </button>

                                        @if (r.Status == "Draft" || r.Status == "Calculated")
                                        {
                                            <form asp-action="UpdatePayrollRunStatus" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()

                                                <input type="hidden"
                                                       name="runId"
                                                       value="@r.PayrollRunId" />

                                                <input type="hidden"
                                                       name="newStatus"
                                                       value="Under Review" />

                                                <button type="submit"
                                                        class="btn btn-outline-info payroll-action-btn"
                                                        title="Submit for HR & Finance Review">
                                                    <i class="fa-solid fa-paper-plane me-1"></i>
                                                    Review
                                                </button>
                                            </form>
                                        }

                                        @if (r.Status == "Under Review")
                                        {
                                            <form asp-action="UpdatePayrollRunStatus" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()

                                                <input type="hidden"
                                                       name="runId"
                                                       value="@r.PayrollRunId" />

                                                <input type="hidden"
                                                       name="newStatus"
                                                       value="Approved" />

                                                <button type="submit"
                                                        class="btn btn-outline-success payroll-action-btn"
                                                        title="Approve Payroll Cycle">
                                                    <i class="fa-solid fa-check me-1"></i>
                                                    Approve
                                                </button>
                                            </form>
                                        }

                                        @if (r.Status == "Approved" || r.Status == "Under Review")
                                        {
                                            <button type="button"
                                                    class="btn btn-success payroll-action-btn"
                                                    onclick="openDisburseModal(@r.PayrollRunId, '@r.PayPeriod', '@r.TotalNetSalary.ToString("N2")', @r.TotalEmployees)"
                                                    title="Disburse via Company Bank & Release Payslips to ESS">
                                                <i class="fa-solid fa-money-bill-wave me-1"></i>
                                                Disburse & Pay
                                            </button>
                                        }

                                        @if (r.Status == "Paid & Closed" || r.Status == "Paid")
                                        {
                                            <span class="badge bg-success-subtle text-success border border-success-subtle py-2 px-2" style="font-size:0.75rem;">
                                                <i class="fa-solid fa-check-double me-1"></i>Published to ESS
                                            </span>
                                        }

                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

</div>

<div class="modal fade payroll-modal"
     id="runPayrollModal"
     tabindex="-1"
     aria-hidden="true">

    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">

            <div class="payroll-modal-header">
                <div>
                    <h5 class="payroll-modal-title">
                        <i class="fa-solid fa-gears me-2"></i>
                        Execute Monthly Payroll Engine
                    </h5>

                    <p class="payroll-modal-subtitle">
                        Configure the payroll period and start automated salary processing.
                    </p>
                </div>

                <button type="button"
                        class="btn-close btn-close-white position-relative"
                        style="z-index:2;"
                        data-bs-dismiss="modal"
                        aria-label="Close">
                </button>
            </div>

            <form asp-action="RunPayrollProcessing" method="post">
                @Html.AntiForgeryToken()

                <div class="modal-body text-start">

                    <div class="workflow-pipeline">

                        <div class="workflow-heading">
                            <i class="fa-solid fa-diagram-project"></i>
                            AUTOMATED PAYROLL PROCESSING PIPELINE
                        </div>

                        <div class="row g-2">

                            <div class="col-6 col-md">
                                <div class="pipeline-step">
                                    <span class="pipeline-number">1</span>
                                    <span class="pipeline-label">Active Employees</span>
                                </div>
                            </div>

                            <div class="col-6 col-md">
                                <div class="pipeline-step">
                                    <span class="pipeline-number">2</span>
                                    <span class="pipeline-label">Attendance & LOP</span>
                                </div>
                            </div>

                            <div class="col-6 col-md">
                                <div class="pipeline-step">
                                    <span class="pipeline-number">3</span>
                                    <span class="pipeline-label">Overtime & Bonus</span>
                                </div>
                            </div>

                            <div class="col-6 col-md">
                                <div class="pipeline-step">
                                    <span class="pipeline-number">4</span>
                                    <span class="pipeline-label">PF / ESI / TDS</span>
                                </div>
                            </div>

                            <div class="col-12 col-md">
                                <div class="pipeline-step">
                                    <span class="pipeline-number">5</span>
                                    <span class="pipeline-label">Net Pay & Payslips</span>
                                </div>
                            </div>

                        </div>
                    </div>

                    <div class="row g-3">

                        <div class="col-md-4">
                            <label class="payroll-form-label">
                                Select Month
                                <span class="required">*</span>
                            </label>

                            <select name="month"
                                    id="selectMonth"
                                    class="form-select"
                                    onchange="updatePayPeriodString()"
                                    required>

                                <option value="1">January</option>
                                <option value="2">February</option>
                                <option value="3">March</option>
                                <option value="4">April</option>
                                <option value="5">May</option>
                                <option value="6">June</option>
                                <option value="7">July</option>
                                <option value="8" selected>August</option>
                                <option value="9">September</option>
                                <option value="10">October</option>
                                <option value="11">November</option>
                                <option value="12">December</option>

                            </select>
                        </div>

                        <div class="col-md-4">
                            <label class="payroll-form-label">
                                Select Year
                                <span class="required">*</span>
                            </label>

                            <select name="year"
                                    id="selectYear"
                                    class="form-select"
                                    onchange="updatePayPeriodString()"
                                    required>

                                <option value="2025">2025</option>
                                <option value="2026" selected>2026</option>
                                <option value="2027">2027</option>

                            </select>
                        </div>

                        <div class="col-md-4">
                            <label class="payroll-form-label">
                                Department Filter
                            </label>

                            <select name="department" class="form-select">
                                <option value="All Departments">All Departments</option>
                                <option value="Engineering">Engineering</option>
                                <option value="Sales">Sales</option>
                                <option value="HR">HR</option>
                                <option value="Finance">Finance</option>
                            </select>
                        </div>

                        <div class="col-12">
                            <label class="payroll-form-label">
                                Generated Pay Period Identifier
                            </label>

                            <input type="text"
                                   name="payPeriod"
                                   id="inputPayPeriod"
                                   class="form-control pay-period-input"
                                   readonly
                                   value="August 2026">
                        </div>

                    </div>

                </div>

                <div class="modal-footer">

                    <button type="button"
                            class="btn btn-light border modal-cancel-btn"
                            data-bs-dismiss="modal">
                        Cancel
                    </button>

                    <button type="submit"
                            class="btn btn-primary modal-submit-btn">
                        <i class="fa-solid fa-play me-1"></i>
                        Run Payroll Calculation
                    </button>

                </div>

            </form>
        </div>
    </div>
</div>

<div class="modal fade payroll-modal"
     id="runDetailsModal"
     tabindex="-1"
     aria-hidden="true">

    <div class="modal-dialog modal-xl modal-dialog-centered">
        <div class="modal-content">

            <div class="payroll-modal-header">

                <div>
                    <h5 class="payroll-modal-title" id="runDetailsTitle">
                        <i class="fa-solid fa-file-invoice-dollar me-2"></i>
                        Payroll Run Breakdown
                    </h5>

                    <p class="payroll-modal-subtitle">
                        Employee-level salary, statutory deductions, and payslip details.
                    </p>
                </div>

                <button type="button"
                        class="btn-close btn-close-white position-relative"
                        style="z-index:2;"
                        data-bs-dismiss="modal"
                        aria-label="Close">
                </button>

            </div>

            <div class="modal-body"
                 id="runDetailsContent">

                <div class="loading-state">
                    <div class="spinner-border text-primary loading-spinner"
                         role="status">
                    </div>

                    <div class="loading-text">
                        Loading payroll details...
                    </div>
                </div>

            </div>

        </div>
    </div>
</div>

<div class="modal fade payroll-modal"
     id="disburseModal"
     tabindex="-1"
     aria-hidden="true">

    <div class="modal-dialog modal-md modal-dialog-centered">
        <div class="modal-content">

            <div class="payroll-modal-header" style="background: linear-gradient(135deg, #064e3b, #059669);">
                <div>
                    <h5 class="payroll-modal-title">
                        <i class="fa-solid fa-money-bill-transfer me-2"></i>
                        Authorize Salary Disbursement
                    </h5>
                    <p class="payroll-modal-subtitle">
                        Debit company bank account and auto-publish payslips to Employee ESS.
                    </p>
                </div>
                <button type="button"
                        class="btn-close btn-close-white position-relative"
                        style="z-index:2;"
                        data-bs-dismiss="modal"
                        aria-label="Close">
                </button>
            </div>

            <form asp-action="DisbursePayroll" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="runId" id="disburseRunId" />

                <div class="modal-body text-start">
                    
                    <div class="p-3 bg-light rounded-3 border mb-3">
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted small">Pay Period:</span>
                            <span class="fw-bold" id="disbursePeriodText">Loading...</span>
                        </div>
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted small">Total Employees:</span>
                            <span class="fw-bold" id="disburseEmployeesText">0</span>
                        </div>
                        <div class="d-flex justify-content-between border-top pt-2">
                            <span class="fw-bold text-dark">Total Net Payout:</span>
                            <span class="fw-bold text-success fs-5" id="disburseAmountText">₹0.00</span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="payroll-form-label">
                            Disbursement Company Bank Account <span class="required">*</span>
                        </label>
                        <select name="companyBankAccountId" class="form-select" required>
                            @if (bankAccounts.Any())
                            {
                                foreach (var bank in bankAccounts)
                                {
                                    <option value="@bank.Id">
                                        @bank.BankName — A/C: @bank.AccountNumber (Balance: ₹@bank.CurrentBalance.ToString("N2"))
                                    </option>
                                }
                            }
                            else
                            {
                                <option value="" disabled selected>No Company Bank Accounts Configured</option>
                            }
                        </select>
                        <div class="form-text text-muted small mt-1">
                            <i class="fa-solid fa-shield-halved text-success me-1"></i>
                            Direct debit will be logged in Finance General Ledger transactions.
                        </div>
                    </div>

                    <div class="alert alert-info py-2 px-3 mb-0 small border-0 bg-info-subtle text-info-emphasis rounded-3">
                        <i class="fa-solid fa-bullhorn me-1"></i>
                        Upon authorization, salary slips will be marked <strong>Paid</strong> and immediately visible to staff in their ESS self-service portals.
                    </div>

                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-light border modal-cancel-btn" data-bs-dismiss="modal">
                        Cancel
                    </button>
                    <button type="submit" class="btn btn-success fw-bold px-4 modal-submit-btn" style="background: linear-gradient(135deg, #16a34a, #15803d);">
                        <i class="fa-solid fa-paper-plane me-2"></i>
                        Confirm & Disburse Payout
                    </button>
                </div>
            </form>

        </div>
    </div>
</div>

<script>
    function updatePayPeriodString() {
        const monthSelect = document.getElementById('selectMonth');
        const monthName = monthSelect.options[monthSelect.selectedIndex].text;
        const yearName = document.getElementById('selectYear').value;

        document.getElementById('inputPayPeriod').value =
            monthName + " " + yearName;
    }

    function escapeHtml(value) {
        if (value === null || value === undefined) {
            return "";
        }
        const div = document.createElement("div");
        div.textContent = value;
        return div.innerHTML;
    }

    function openDisburseModal(runId, period, amount, employees) {
        document.getElementById('disburseRunId').value = runId;
        document.getElementById('disbursePeriodText').innerText = period || 'Current Period';
        document.getElementById('disburseAmountText').innerText = '₹' + amount;
        document.getElementById('disburseEmployeesText').innerText = employees || '0';
        
        const modal = bootstrap.Modal.getOrCreateInstance(document.getElementById('disburseModal'));
        modal.show();
    }

    function inspectPayroll(runId) {
        viewPayrollRunDetails(runId);
    }

    function viewPayrollRunDetails(runId) {
        const modalElement = document.getElementById('runDetailsModal');
        const modal = bootstrap.Modal.getOrCreateInstance(modalElement);
        const contentDiv = document.getElementById('runDetailsContent');

        contentDiv.innerHTML = `
            <div class="loading-state">
                <div class="spinner-border text-primary loading-spinner" role="status"></div>
                <div class="loading-text">Loading payroll breakdown details...</div>
            </div>
        `;

        modal.show();

        fetch('/HRPayroll/GetPayrollBreakdown?runId=' + runId)
            .then(res => {
                if (!res.ok) {
                    throw new Error("Failed to load payroll details.");
                }
                return res.json();
            })
            .then(data => {
                const slips = data.slips || data.payslips || [];

                let html = `
                    <div class="details-summary">
                        <div class="row g-3">
                            <div class="col-6 col-lg-3">
                                <div class="detail-summary-item">
                                    <span class="detail-summary-label">Pay Period</span>
                                    <span class="detail-summary-value">${escapeHtml(data.payPeriod)}</span>
                                </div>
                            </div>
                            <div class="col-6 col-lg-3">
                                <div class="detail-summary-item">
                                    <span class="detail-summary-label">Staff Count</span>
                                    <span class="detail-summary-value">${data.totalEmployees || slips.length || 0} Staff</span>
                                </div>
                            </div>
                            <div class="col-6 col-lg-3">
                                <div class="detail-summary-item">
                                    <span class="detail-summary-label">Gross Salary</span>
                                    <span class="detail-summary-value">₹${data.grossSalary || data.totalGrossSalary || '0.00'}</span>
                                </div>
                            </div>
                            <div class="col-6 col-lg-3">
                                <div class="detail-summary-item">
                                    <span class="detail-summary-label">Net Payout</span>
                                    <span class="detail-summary-value success">₹${data.netPayout || data.totalNetSalary || '0.00'}</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="details-table-wrap">
                        <div class="table-responsive">
                            <table class="table details-table align-middle">
                                <thead>
                                    <tr>
                                        <th>Employee</th>
                                        <th>Department</th>
                                        <th>Basic Pay</th>
                                        <th>HRA</th>
                                        <th>Gross Salary</th>
                                        <th>Deductions</th>
                                        <th>Net Payable</th>
                                        <th>Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                `;

                if (slips.length === 0) {
                    html += `
                        <tr>
                            <td colspan="8" class="text-center py-5 text-muted">
                                <i class="fa-solid fa-file-circle-xmark d-block mb-2" style="font-size:1.5rem;"></i>
                                No payslip records found for this run.
                            </td>
                        </tr>
                    `;
                } else {
                    slips.forEach(s => {
                        const isPaid = (s.status === 'Paid' || s.status === 'Paid & Closed');
                        const statusBadgeClass = isPaid ? 'status-paid' : 'status-draft';
                        const statusIcon = isPaid ? 'fa-circle-check' : 'fa-hourglass-half';

                        html += `
                            <tr>
                                <td>
                                    <div class="details-employee">${escapeHtml(s.employeeName)}</div>
                                    <div class="details-user-code">${escapeHtml(s.employeeCode || '')}</div>
                                </td>
                                <td>
                                    <span class="badge bg-light text-secondary border">${escapeHtml(s.department || 'General')}</span>
                                </td>
                                <td>₹${s.basic || '0.00'}</td>
                                <td>₹${s.hra || '0.00'}</td>
                                <td class="fw-bold">₹${s.gross || '0.00'}</td>
                                <td class="text-danger fw-semibold">₹${s.deductions || '0.00'}</td>
                                <td class="text-success fw-bold fs-6">₹${s.net || '0.00'}</td>
                                <td>
                                    <span class="status-pill ${statusBadgeClass}">
                                        <i class="fa-solid ${statusIcon}"></i>
                                        ${escapeHtml(s.status || 'Draft')}
                                    </span>
                                </td>
                            </tr>
                        `;
                    });
                }

                html += `
                                </tbody>
                            </table>
                        </div>
                    </div>
                `;

                contentDiv.innerHTML = html;
            })
            .catch(error => {
                console.error(error);
                contentDiv.innerHTML = `
                    <div class="text-center py-5">
                        <div class="empty-icon" style="background:#fef2f2;color:#dc2626;">
                            <i class="fa-solid fa-triangle-exclamation"></i>
                        </div>
                        <div class="empty-title">Unable to Load Payroll Details</div>
                        <p class="empty-text mb-3">Something went wrong while loading this payroll run.</p>
                        <button type="button" class="btn btn-outline-primary btn-sm rounded-pill px-3" onclick="viewPayrollRunDetails(${runId})">
                            <i class="fa-solid fa-rotate-right me-1"></i> Try Again
                        </button>
                    </div>
                `;
            });
    }

    // Connect to SignalR Payroll Hub for real-time updates
    document.addEventListener("DOMContentLoaded", function () {
        if (typeof signalR !== "undefined") {
            const connection = new signalR.HubConnectionBuilder()
                .withUrl("/payrollHub")
                .withAutomaticReconnect()
                .build();

            connection.on("ReceivePayrollRunUpdated", function (data) {
                console.log("Payroll run updated in real-time:", data);
            });

            connection.on("ReceiveSalaryDisbursed", function (data) {
                console.log("Salary disbursed in real-time:", data);
            });

            connection.start().catch(err => console.debug("SignalR connection skipped:", err));
        }
    });
</script>
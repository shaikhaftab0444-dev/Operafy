@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Monthly Payroll Processing";
    var runs = ViewBag.PayrollRuns as List<ERP_System.Models.PayrollRun> ?? new List<ERP_System.Models.PayrollRun>();

    var activeEmployeesCount = ViewBag.ActiveEmployeesCount ?? 0;
    var draftRunsCount = ViewBag.DraftRunsCount ?? 0;
    var paidRuns = runs.Where(r => r.Status == "Paid").ToList();
    var totalNetPaid = paidRuns.Sum(r => r.TotalNetSalary);
}

<style>
    /* =========================================================
           MONTHLY PAYROLL PROCESSING - PREMIUM RESPONSIVE UI
           FUNCTIONAL CODE IS NOT CHANGED
        ========================================================== */

    .payroll-page {
        --payroll-primary: #2563eb;
        --payroll-primary-dark: #1d4ed8;
        --payroll-success: #16a34a;
        --payroll-warning: #d97706;
        --payroll-danger: #dc2626;
        --payroll-info: #0891b2;
        --payroll-dark: #0f172a;
        --payroll-muted: #64748b;
        --payroll-border: #e2e8f0;
        --payroll-bg: #f8fafc;
        color: var(--payroll-dark);
    }

        .payroll-page .page-alert {
            border: 0;
            border-radius: 18px;
            padding: 14px 18px;
            animation: payrollSlideDown .45s ease;
            box-shadow: 0 8px 24px rgba(15,23,42,.06);
        }

    /* ================= HERO ================= */

    .payroll-hero {
        position: relative;
        overflow: hidden;
        padding: 32px;
        border-radius: 24px;
        margin-bottom: 24px;
        color: #fff;
        background: radial-gradient(circle at 85% 20%, rgba(255,255,255,.16) 0, rgba(255,255,255,0) 30%), linear-gradient(135deg, #0f172a 0%, #1e3a8a 52%, #2563eb 100%);
        box-shadow: 0 20px 50px rgba(30,58,138,.20);
        animation: payrollFadeUp .55s ease;
    }

        .payroll-hero::before {
            content: "";
            position: absolute;
            width: 260px;
            height: 260px;
            border-radius: 50%;
            top: -150px;
            right: -70px;
            border: 1px solid rgba(255,255,255,.12);
            box-shadow: 0 0 0 40px rgba(255,255,255,.03), 0 0 0 80px rgba(255,255,255,.02);
            pointer-events: none;
        }

        .payroll-hero::after {
            content: "";
            position: absolute;
            width: 180px;
            height: 180px;
            bottom: -130px;
            left: 45%;
            border-radius: 50%;
            background: rgba(255,255,255,.035);
            pointer-events: none;
        }

    .payroll-hero-content {
        position: relative;
        z-index: 2;
    }

    .payroll-breadcrumb {
        display: inline-flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 8px;
        margin-bottom: 12px;
        font-size: .76rem;
        color: rgba(255,255,255,.68);
    }

        .payroll-breadcrumb a {
            color: rgba(255,255,255,.82);
            text-decoration: none;
            transition: .2s ease;
        }

            .payroll-breadcrumb a:hover {
                color: #fff;
            }

        .payroll-breadcrumb .separator {
            opacity: .5;
        }

    .payroll-title {
        font-size: 1.75rem;
        font-weight: 800;
        letter-spacing: -.5px;
        margin: 0 0 8px;
    }

    .payroll-subtitle {
        margin: 0;
        max-width: 700px;
        font-size: .9rem;
        line-height: 1.65;
        color: rgba(255,255,255,.72);
    }

    .payroll-engine-badge {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        margin-top: 17px;
        padding: 8px 14px;
        border: 1px solid rgba(255,255,255,.14);
        border-radius: 50px;
        background: rgba(255,255,255,.08);
        color: rgba(255,255,255,.92);
        font-size: .72rem;
        font-weight: 600;
        backdrop-filter: blur(8px);
    }

    .engine-dot {
        width: 8px;
        height: 8px;
        flex: 0 0 8px;
        background: #4ade80;
        border-radius: 50%;
        box-shadow: 0 0 0 0 rgba(74,222,128,.6);
        animation: payrollPulse 2s infinite;
    }

    .payroll-run-btn {
        min-height: 48px;
        padding: 0 21px;
        border: 0;
        border-radius: 14px;
        color: var(--payroll-primary-dark);
        background: #fff;
        font-weight: 700;
        white-space: nowrap;
        box-shadow: 0 10px 24px rgba(0,0,0,.16);
        transition: transform .25s ease, box-shadow .25s ease;
    }

        .payroll-run-btn:hover {
            color: var(--payroll-primary-dark);
            transform: translateY(-3px);
            box-shadow: 0 16px 30px rgba(0,0,0,.22);
        }

    /* ================= STATS ================= */

    .payroll-stat-card {
        position: relative;
        overflow: hidden;
        height: 100%;
        min-height: 148px;
        padding: 20px;
        background: #fff;
        border: 1px solid var(--payroll-border);
        border-radius: 20px;
        box-shadow: 0 8px 24px rgba(15,23,42,.04);
        transition: transform .28s ease, box-shadow .28s ease, border-color .28s ease;
        animation: payrollFadeUp .6s ease both;
    }

        .payroll-stat-card:hover {
            transform: translateY(-6px);
            border-color: rgba(37,99,235,.18);
            box-shadow: 0 18px 38px rgba(15,23,42,.09);
        }

        .payroll-stat-card::after {
            content: "";
            position: absolute;
            width: 120px;
            height: 120px;
            right: -48px;
            bottom: -65px;
            border-radius: 50%;
            background: rgba(37,99,235,.035);
        }

        .payroll-stat-card.delay-1 {
            animation-delay: .05s;
        }

        .payroll-stat-card.delay-2 {
            animation-delay: .12s;
        }

        .payroll-stat-card.delay-3 {
            animation-delay: .19s;
        }

        .payroll-stat-card.delay-4 {
            animation-delay: .26s;
        }

    .stat-top {
        position: relative;
        z-index: 2;
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 14px;
    }

    .stat-label {
        margin-bottom: 9px;
        color: var(--payroll-muted);
        font-size: .74rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .04em;
    }

    .stat-value {
        margin: 0;
        color: var(--payroll-dark);
        font-size: 1.65rem;
        font-weight: 800;
        line-height: 1.1;
        letter-spacing: -.5px;
        white-space: nowrap;
    }

        .stat-value.stat-success {
            color: var(--payroll-success);
        }

        .stat-value.stat-warning {
            color: var(--payroll-warning);
        }

    .stat-icon {
        width: 50px;
        height: 50px;
        flex: 0 0 50px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 16px;
        font-size: 1.15rem;
    }

    .icon-blue {
        color: #2563eb;
        background: #eff6ff;
    }

    .icon-cyan {
        color: #0891b2;
        background: #ecfeff;
    }

    .icon-orange {
        color: #d97706;
        background: #fff7ed;
    }

    .icon-green {
        color: #16a34a;
        background: #f0fdf4;
    }

    .stat-footer {
        position: relative;
        z-index: 2;
        display: flex;
        align-items: center;
        gap: 6px;
        margin-top: 17px;
        color: #94a3b8;
        font-size: .74rem;
        line-height: 1.45;
    }

    /* ================= PAYROLL HISTORY ================= */

    .payroll-history-card {
        overflow: hidden;
        width: 100%;
        background: #fff;
        border: 1px solid var(--payroll-border);
        border-radius: 22px;
        box-shadow: 0 10px 30px rgba(15,23,42,.045);
        animation: payrollFadeUp .7s ease both;
    }

    .history-card-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 18px;
        padding: 22px 24px;
        border-bottom: 1px solid var(--payroll-border);
        background: linear-gradient(180deg, #fff, #fbfdff);
    }

    .history-title-wrap {
        display: flex;
        align-items: center;
        gap: 13px;
        min-width: 0;
    }

    .history-title-icon {
        width: 44px;
        height: 44px;
        flex: 0 0 44px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 14px;
        color: var(--payroll-primary);
        background: #eff6ff;
    }

    .history-title {
        margin: 0 0 3px;
        color: var(--payroll-dark);
        font-size: .98rem;
        font-weight: 800;
    }

    .history-subtitle {
        margin: 0;
        color: var(--payroll-muted);
        font-size: .76rem;
        line-height: 1.5;
    }

    .history-count {
        flex: 0 0 auto;
        padding: 8px 13px;
        border: 1px solid #dbeafe;
        border-radius: 50px;
        background: #eff6ff;
        color: var(--payroll-primary);
        font-size: .75rem;
        font-weight: 700;
        white-space: nowrap;
    }

    /* IMPORTANT:
           Table scrolls correctly instead of cutting the action buttons.
        */

    .payroll-history-card .table-responsive {
        width: 100%;
        overflow-x: auto;
        overflow-y: visible;
        -webkit-overflow-scrolling: touch;
        scrollbar-width: thin;
        scrollbar-color: #cbd5e1 transparent;
    }

        .payroll-history-card .table-responsive::-webkit-scrollbar {
            height: 8px;
        }

        .payroll-history-card .table-responsive::-webkit-scrollbar-track {
            background: #f8fafc;
        }

        .payroll-history-card .table-responsive::-webkit-scrollbar-thumb {
            background: #cbd5e1;
            border-radius: 20px;
        }

    .payroll-table {
        width: max-content;
        min-width: 1280px;
        margin: 0;
        font-size: .82rem;
    }

        .payroll-table thead th {
            padding: 15px 15px;
            border: 0;
            border-bottom: 1px solid var(--payroll-border);
            background: #f8fafc;
            color: #64748b;
            font-size: .67rem;
            font-weight: 800;
            letter-spacing: .04em;
            text-transform: uppercase;
            white-space: nowrap;
        }

            .payroll-table thead th:last-child {
                min-width: 285px;
                padding-right: 20px;
            }

        .payroll-table tbody td {
            padding: 17px 15px;
            vertical-align: middle;
            border-color: #f1f5f9;
            white-space: nowrap;
        }

            .payroll-table tbody td:last-child {
                min-width: 285px;
                padding-right: 20px;
            }

        .payroll-table tbody tr {
            transition: background .2s ease;
        }

            .payroll-table tbody tr:hover {
                background: #fafcff;
            }

    .period-cell {
        display: flex;
        align-items: center;
        gap: 11px;
        min-width: 170px;
    }

    .period-icon {
        width: 37px;
        height: 37px;
        flex: 0 0 37px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 12px;
        color: var(--payroll-primary);
        background: #eff6ff;
    }

    .period-name {
        color: var(--payroll-dark);
        font-weight: 800;
        white-space: nowrap;
    }

    .period-date {
        margin-top: 3px;
        color: #94a3b8;
        font-size: .68rem;
    }

    .department-pill {
        display: inline-flex;
        align-items: center;
        padding: 6px 10px;
        border: 1px solid var(--payroll-border);
        border-radius: 50px;
        background: #f8fafc;
        color: #475569;
        font-size: .72rem;
        font-weight: 600;
        white-space: nowrap;
    }

    .money-value {
        color: #334155;
        font-weight: 700;
        white-space: nowrap;
    }

    .money-deduction {
        color: var(--payroll-danger);
        font-weight: 700;
        white-space: nowrap;
    }

    .money-net {
        color: var(--payroll-success);
        font-weight: 800;
        white-space: nowrap;
    }

    .money-ctc {
        color: #64748b;
        font-weight: 600;
        white-space: nowrap;
    }

    .employee-count {
        color: #334155;
        font-weight: 700;
        white-space: nowrap;
    }

    .status-pill {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 7px 10px;
        border-radius: 50px;
        font-size: .7rem;
        font-weight: 700;
        white-space: nowrap;
    }

    .status-paid {
        color: #15803d;
        background: #f0fdf4;
        border: 1px solid #bbf7d0;
    }

    .status-approved {
        color: #1d4ed8;
        background: #eff6ff;
        border: 1px solid #bfdbfe;
    }

    .status-locked {
        color: #475569;
        background: #f1f5f9;
        border: 1px solid #e2e8f0;
    }

    .status-review {
        color: #0e7490;
        background: #ecfeff;
        border: 1px solid #a5f3fc;
    }

    .status-draft {
        color: #b45309;
        background: #fffbeb;
        border: 1px solid #fde68a;
    }

    /* FIXED WORKFLOW ACTION BUTTON AREA */

    .action-wrap {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        flex-wrap: nowrap;
        gap: 8px;
        min-width: 265px;
        width: max-content;
        margin-left: auto;
    }

        .action-wrap form {
            display: inline-flex;
            flex: 0 0 auto;
            margin: 0;
        }

    .payroll-action-btn {
        min-height: 36px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 10px;
        padding: 0 12px;
        font-size: .72rem;
        font-weight: 700;
        white-space: nowrap;
        transition: transform .2s ease, box-shadow .2s ease, background .2s ease;
    }

        .payroll-action-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 7px 14px rgba(15,23,42,.08);
        }

    /* ================= EMPTY STATE ================= */

    .payroll-empty-state {
        padding: 55px 20px !important;
        white-space: normal !important;
    }

    .empty-icon {
        width: 68px;
        height: 68px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 15px;
        border-radius: 22px;
        color: var(--payroll-primary);
        background: #eff6ff;
        font-size: 1.5rem;
    }

    .empty-title {
        margin-bottom: 6px;
        color: #334155;
        font-size: .95rem;
        font-weight: 800;
    }

    .empty-text {
        margin: 0;
        color: #94a3b8;
        font-size: .8rem;
    }

    /* ================= MODALS ================= */

    .payroll-modal .modal-dialog {
        margin-left: auto;
        margin-right: auto;
    }

    .payroll-modal .modal-content {
        overflow: hidden;
        border: 0;
        border-radius: 22px;
        box-shadow: 0 25px 60px rgba(15,23,42,.18);
    }

    .payroll-modal-header {
        position: relative;
        padding: 20px 24px;
        color: #fff;
        background: linear-gradient(135deg, #0f172a, #1d4ed8);
    }

        .payroll-modal-header::after {
            content: "";
            position: absolute;
            width: 150px;
            height: 150px;
            top: -90px;
            right: -40px;
            border-radius: 50%;
            background: rgba(255,255,255,.08);
        }

    .payroll-modal-title {
        position: relative;
        z-index: 1;
        margin: 0;
        font-size: 1.02rem;
        font-weight: 800;
    }

    .payroll-modal-subtitle {
        position: relative;
        z-index: 1;
        margin: 4px 0 0;
        color: rgba(255,255,255,.65);
        font-size: .75rem;
    }

    .payroll-modal .modal-body {
        padding: 24px;
    }

    .workflow-pipeline {
        padding: 18px;
        margin-bottom: 22px;
        border: 1px solid #e0e7ff;
        border-radius: 18px;
        background: linear-gradient(135deg, #f8faff, #f8fafc);
    }

    .workflow-heading {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 15px;
        color: #1e3a8a;
        font-size: .76rem;
        font-weight: 800;
    }

    .pipeline-step {
        position: relative;
        height: 100%;
        padding: 11px 8px;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        background: #fff;
        text-align: center;
        transition: transform .2s ease, border-color .2s ease, box-shadow .2s ease;
    }

        .pipeline-step:hover {
            transform: translateY(-3px);
            border-color: #bfdbfe;
            box-shadow: 0 8px 18px rgba(37,99,235,.06);
        }

    .pipeline-number {
        width: 23px;
        height: 23px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 6px;
        border-radius: 50%;
        background: #eff6ff;
        color: var(--payroll-primary);
        font-size: .67rem;
        font-weight: 800;
    }

    .pipeline-label {
        display: block;
        color: #475569;
        font-size: .65rem;
        font-weight: 700;
        line-height: 1.3;
    }

    .pipeline-step:last-child .pipeline-number {
        color: #15803d;
        background: #f0fdf4;
    }

    .payroll-form-label {
        margin-bottom: 7px;
        color: #475569;
        font-size: .72rem;
        font-weight: 800;
    }

        .payroll-form-label .required {
            color: #dc2626;
        }

    .payroll-modal .form-select,
    .payroll-modal .form-control {
        min-height: 43px;
        border: 1px solid #dbe3ee;
        border-radius: 11px;
        color: #334155;
        font-size: .82rem;
        box-shadow: none;
        transition: border-color .2s ease, box-shadow .2s ease;
    }

        .payroll-modal .form-select:focus,
        .payroll-modal .form-control:focus {
            border-color: #93c5fd;
            box-shadow: 0 0 0 4px rgba(37,99,235,.08);
        }

    .pay-period-input {
        font-weight: 800 !important;
        background: #f8fafc !important;
    }

    .payroll-modal .modal-footer {
        padding: 16px 24px;
        border-top: 1px solid #e2e8f0;
        background: #f8fafc;
    }

    .modal-cancel-btn {
        min-height: 40px;
        border-radius: 11px;
        padding: 0 18px;
        font-weight: 700;
        font-size: .78rem;
    }

    .modal-submit-btn {
        min-height: 40px;
        border: 0;
        border-radius: 11px;
        padding: 0 20px;
        font-weight: 700;
        font-size: .78rem;
        background: linear-gradient(135deg, #2563eb, #1d4ed8);
        box-shadow: 0 8px 18px rgba(37,99,235,.22);
        transition: transform .2s ease, box-shadow .2s ease;
    }

        .modal-submit-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 12px 24px rgba(37,99,235,.28);
        }

    /* ================= DETAILS MODAL ================= */

    .details-summary {
        padding: 17px;
        margin-bottom: 22px;
        border: 1px solid #e2e8f0;
        border-radius: 18px;
        background: #f8fafc;
    }

    .detail-summary-item {
        height: 100%;
        padding: 13px;
        border-radius: 14px;
        background: #fff;
        border: 1px solid #eef2f7;
    }

    .detail-summary-label {
        display: block;
        margin-bottom: 6px;
        color: #94a3b8;
        font-size: .66rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: .04em;
    }

    .detail-summary-value {
        color: #334155;
        font-size: .88rem;
        font-weight: 800;
        word-break: break-word;
    }

        .detail-summary-value.success {
            color: var(--payroll-success);
        }

    .details-table-wrap {
        width: 100%;
        border: 1px solid #e2e8f0;
        border-radius: 16px;
        overflow: hidden;
    }

        .details-table-wrap .table-responsive {
            overflow-x: auto;
            -webkit-overflow-scrolling: touch;
        }

    .details-table {
        min-width: 800px;
        margin: 0;
        font-size: .8rem;
    }

        .details-table thead th {
            padding: 13px;
            border: 0;
            background: #f8fafc;
            color: #64748b;
            font-size: .65rem;
            font-weight: 800;
            text-transform: uppercase;
            white-space: nowrap;
        }

        .details-table tbody td {
            padding: 14px 13px;
            border-color: #f1f5f9;
            vertical-align: middle;
        }

    .details-employee {
        color: #334155;
        font-weight: 800;
    }

    .details-user-code {
        margin-top: 2px;
        color: #94a3b8;
        font-size: .68rem;
    }

    .loading-state {
        padding: 55px 20px;
        text-align: center;
    }

    .loading-spinner {
        width: 44px;
        height: 44px;
        margin-bottom: 12px;
        border-width: 4px;
    }

    .loading-text {
        color: #64748b;
        font-size: .8rem;
        font-weight: 600;
    }

    /* ================= ANIMATIONS ================= */

    @@keyframes payrollFadeUp {
        from {
            opacity: 0;
            transform: translateY(18px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@keyframes payrollSlideDown {
        from {
            opacity: 0;
            transform: translateY(-12px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@keyframes payrollPulse {
        0% {
            box-shadow: 0 0 0 0 rgba(74,222,128,.55);
        }

        70% {
            box-shadow: 0 0 0 7px rgba(74,222,128,0);
        }

        100% {
            box-shadow: 0 0 0 0 rgba(74,222,128,0);
        }
    }

    /* ================= RESPONSIVE ================= */

    @@media (max-width: 1199.98px) {
        .payroll-table {
            min-width: 1260px;
        }
    }

    @@media (max-width: 991.98px) {
        .payroll-hero {
            padding: 27px;
        }

        .payroll-title {
            font-size: 1.45rem;
        }

        .payroll-hero .hero-actions {
            width: 100%;
        }

        .payroll-run-btn {
            width: 100%;
        }

        .payroll-stat-card {
            min-height: 135px;
        }

        .payroll-table {
            min-width: 1240px;
        }
    }

    @@media (max-width: 767.98px) {
        .payroll-page {
            padding-left: 0 !important;
            padding-right: 0 !important;
        }

        .payroll-hero {
            padding: 22px 20px;
            border-radius: 19px;
        }

        .payroll-title {
            font-size: 1.28rem;
        }

        .payroll-subtitle {
            font-size: .8rem;
        }

        .history-card-header {
            align-items: flex-start;
            flex-direction: column;
            padding: 18px;
        }

        .history-title-wrap {
            align-items: flex-start;
        }

        .history-count {
            width: 100%;
            text-align: center;
        }

        .payroll-stat-card {
            padding: 17px;
            min-height: auto;
        }

        .stat-value {
            font-size: 1.4rem;
        }

        .payroll-modal .modal-body {
            padding: 19px;
        }

        .payroll-modal .modal-footer {
            padding: 14px 19px;
        }

        .workflow-pipeline {
            padding: 14px;
        }

        .details-summary {
            padding: 12px;
        }

        .payroll-table {
            min-width: 1220px;
        }

        .payroll-history-card {
            border-radius: 18px;
        }

        .action-wrap {
            min-width: 255px;
        }
    }

    @@media (max-width: 575.98px) {
        .payroll-engine-badge {
            font-size: .65rem;
            line-height: 1.4;
        }

        .history-title-icon {
            width: 39px;
            height: 39px;
            flex: 0 0 39px;
            border-radius: 12px;
        }

        .history-title {
            font-size: .88rem;
        }

        .history-subtitle {
            font-size: .71rem;
        }

        .payroll-modal-title {
            font-size: .9rem;
        }

        .payroll-modal-subtitle {
            font-size: .7rem;
        }

        .modal-submit-btn,
        .modal-cancel-btn {
            flex: 1;
        }

        .payroll-modal .modal-footer {
            gap: 8px;
        }

        .payroll-title {
            line-height: 1.35;
        }

        .payroll-table {
            min-width: 1200px;
        }

            .payroll-table tbody td,
            .payroll-table thead th {
                padding-left: 12px;
                padding-right: 12px;
            }

        .details-table {
            min-width: 760px;
        }

        .stat-label {
            font-size: .68rem;
        }

        .stat-footer {
            font-size: .7rem;
        }
    }

    @@media (max-width: 400px) {
        .payroll-hero {
            padding: 19px 16px;
        }

        .payroll-engine-badge {
            width: 100%;
            justify-content: center;
            text-align: center;
        }

        .stat-value {
            font-size: 1.28rem;
        }

        .stat-icon {
            width: 45px;
            height: 45px;
            flex: 0 0 45px;
        }
    }

    @@media (prefers-reduced-motion: reduce) {
        .payroll-page *,
        .payroll-page *::before,
        .payroll-page *::after {
            animation-duration: .01ms !important;
            animation-iteration-count: 1 !important;
            transition-duration: .01ms !important;
        }
    }
</style>

<div class="container-fluid py-4 text-start payroll-page">

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show page-alert mb-4" role="alert">
            <i class="fa-solid fa-circle-check me-2"></i>
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show page-alert mb-4" role="alert">
            <i class="fa-solid fa-circle-exclamation me-2"></i>
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="payroll-hero">
        <div class="payroll-hero-content">
            <div class="row align-items-center g-4">
                <div class="col-lg-8">
                    <div class="payroll-breadcrumb">
                        <a href="/HR">
                            <i class="fa-solid fa-house me-1"></i>HR Dashboard
                        </a>
                        <span class="separator"><i class="fa-solid fa-chevron-right"></i></span>
                        <span>Payroll Processing</span>
                    </div>

                    <h1 class="payroll-title">
                        <i class="fa-solid fa-receipt me-2"></i>
                        Monthly Payroll Processing
                    </h1>

                    <p class="payroll-subtitle">
                        Process employee salaries, calculate statutory deductions, verify payroll records,
                        approve the pay run and complete salary disbursement from one secure workflow.
                    </p>

                    <div class="payroll-engine-badge">
                        <span class="engine-dot"></span>
                        Payroll Processing Engine Ready
                    </div>
                </div>

                <div class="col-lg-4 text-lg-end">
                    <div class="hero-actions">
                        <button class="btn payroll-run-btn"
                                data-bs-toggle="modal"
                                data-bs-target="#runPayrollModal">
                            <i class="fa-solid fa-play me-2"></i>
                            Execute Pay Run
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-3 mb-4">

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="payroll-stat-card delay-1">
                <div class="stat-top">
                    <div>
                        <div class="stat-label">Eligible Employees</div>
                        <h3 class="stat-value">@activeEmployeesCount</h3>
                    </div>

                    <div class="stat-icon icon-blue">
                        <i class="fa-solid fa-users"></i>
                    </div>
                </div>

                <div class="stat-footer">
                    <i class="fa-solid fa-user-check"></i>
                    Active employees available for processing
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="payroll-stat-card delay-2">
                <div class="stat-top">
                    <div>
                        <div class="stat-label">Total Pay Runs</div>
                        <h3 class="stat-value">@runs.Count</h3>
                    </div>

                    <div class="stat-icon icon-cyan">
                        <i class="fa-solid fa-file-invoice-dollar"></i>
                    </div>
                </div>

                <div class="stat-footer">
                    <i class="fa-solid fa-layer-group"></i>
                    Historical payroll cycles recorded
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="payroll-stat-card delay-3">
                <div class="stat-top">
                    <div>
                        <div class="stat-label">Pending Approval</div>
                        <h3 class="stat-value stat-warning">@draftRunsCount</h3>
                    </div>

                    <div class="stat-icon icon-orange">
                        <i class="fa-solid fa-clock-rotate-left"></i>
                    </div>
                </div>

                <div class="stat-footer">
                    <i class="fa-solid fa-hourglass-half"></i>
                    Requires verification or approval
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="payroll-stat-card delay-4">
                <div class="stat-top">
                    <div>
                        <div class="stat-label">Total Net Paid</div>
                        <h3 class="stat-value stat-success">
                            ₹@totalNetPaid.ToString("N0")
                        </h3>
                    </div>

                    <div class="stat-icon icon-green">
                        <i class="fa-solid fa-money-bill-transfer"></i>
                    </div>
                </div>

                <div class="stat-footer">
                    <i class="fa-solid fa-circle-check"></i>
                    Completed and paid payroll runs
                </div>
            </div>
        </div>

    </div>

    <div class="payroll-history-card">

        <div class="history-card-header">
            <div class="history-title-wrap">
                <div class="history-title-icon">
                    <i class="fa-solid fa-list-check"></i>
                </div>

                <div>
                    <h6 class="history-title">Payroll Execution & Approval Workflow</h6>
                    <p class="history-subtitle">
                        Review, approve and track every payroll cycle from calculation to salary payment.
                    </p>
                </div>
            </div>

            <div class="history-count">
                <i class="fa-solid fa-receipt me-1"></i>
                @runs.Count Payroll Run@(runs.Count == 1 ? "" : "s")
            </div>
        </div>

        <div class="table-responsive">
            <table class="table payroll-table align-middle">
                <thead>
                    <tr>
                        <th>Pay Period</th>
                        <th>Department</th>
                        <th>Employees</th>
                        <th>Gross Payout</th>
                        <th>Deductions</th>
                        <th>Net Paid</th>
                        <th>Employer CTC</th>
                        <th>Status</th>
                        <th class="text-end">Workflow Actions</th>
                    </tr>
                </thead>

                <tbody>
                    @if (!runs.Any())
                    {
                        <tr>
                            <td colspan="9" class="text-center payroll-empty-state">
                                <div class="empty-icon">
                                    <i class="fa-solid fa-calculator"></i>
                                </div>

                                <div class="empty-title">
                                    No Payroll Runs Available
                                </div>

                                <p class="empty-text">
                                    Start your first monthly payroll cycle using the Execute Pay Run button.
                                </p>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var r in runs)
                        {
                            <tr>
                                <td>
                                    <div class="period-cell">
                                        <div class="period-icon">
                                            <i class="fa-solid fa-calendar-check"></i>
                                        </div>

                                        <div>
                                            <div class="period-name">@r.PayPeriod</div>
                                            <div class="period-date">
                                                Processed @r.ProcessedAt.ToString("dd MMM yyyy")
                                            </div>
                                        </div>
                                    </div>
                                </td>

                                <td>
                                    <span class="department-pill">
                                        <i class="fa-solid fa-building me-1"></i>
                                        @r.Department
                                    </span>
                                </td>

                                <td>
                                    <span class="employee-count">
                                        @r.TotalEmployees Employee@(r.TotalEmployees == 1 ? "" : "s")
                                    </span>
                                </td>

                                <td>
                                    <span class="money-value">
                                        ₹@r.TotalGrossSalary.ToString("N0")
                                    </span>
                                </td>

                                <td>
                                    <span class="money-deduction">
                                        ₹@r.TotalDeductions.ToString("N0")
                                    </span>
                                </td>

                                <td>
                                    <span class="money-net">
                                        ₹@r.TotalNetSalary.ToString("N0")
                                    </span>
                                </td>

                                <td>
                                    <span class="money-ctc">
                                        ₹@r.TotalCTC.ToString("N0")
                                    </span>
                                </td>

                                <td>
                                    @if (r.Status == "Paid")
                                    {
                                        <span class="status-pill status-paid">
                                            <i class="fa-solid fa-circle-check"></i>
                                            Paid & Closed
                                        </span>
                                    }
                                    else if (r.Status == "Approved")
                                    {
                                        <span class="status-pill status-approved">
                                            <i class="fa-solid fa-thumbs-up"></i>
                                            Approved
                                        </span>
                                    }
                                    else if (r.Status == "Locked")
                                    {
                                        <span class="status-pill status-locked">
                                            <i class="fa-solid fa-lock"></i>
                                            Locked
                                        </span>
                                    }
                                    else if (r.Status == "Under Review")
                                    {
                                        <span class="status-pill status-review">
                                            <i class="fa-solid fa-magnifying-glass"></i>
                                            Under Review
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="status-pill status-draft">
                                            <i class="fa-solid fa-hourglass-half"></i>
                                            Draft
                                        </span>
                                    }
                                </td>

                                <td class="text-end">
                                    <div class="action-wrap">

                                        <button type="button"
                                                class="btn btn-outline-primary payroll-action-btn"
                                                onclick="viewPayrollRunDetails(@r.PayrollRunId)">
                                            <i class="fa-solid fa-eye me-1"></i>
                                            Inspect
                                        </button>

                                        @if (r.Status == "Draft" || r.Status == "Calculated")
                                        {
                                            <form asp-action="UpdatePayrollRunStatus" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()

                                                <input type="hidden"
                                                       name="runId"
                                                       value="@r.PayrollRunId" />

                                                <input type="hidden"
                                                       name="newStatus"
                                                       value="Under Review" />

                                                <button type="submit"
                                                        class="btn btn-outline-info payroll-action-btn"
                                                        title="Submit for HR Review">
                                                    <i class="fa-solid fa-paper-plane me-1"></i>
                                                    Review
                                                </button>
                                            </form>
                                        }

                                        else if (r.Status == "Under Review")
                                        {
                                            <form asp-action="UpdatePayrollRunStatus" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()

                                                <input type="hidden"
                                                       name="runId"
                                                       value="@r.PayrollRunId" />

                                                <input type="hidden"
                                                       name="newStatus"
                                                       value="Approved" />

                                                <button type="submit"
                                                        class="btn btn-outline-success payroll-action-btn"
                                                        title="Approve Payroll">
                                                    <i class="fa-solid fa-check me-1"></i>
                                                    Approve
                                                </button>
                                            </form>
                                        }

                                        else if (r.Status == "Approved")
                                        {
                                            <form asp-action="UpdatePayrollRunStatus" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()

                                                <input type="hidden"
                                                       name="runId"
                                                       value="@r.PayrollRunId" />

                                                <input type="hidden"
                                                       name="newStatus"
                                                       value="Paid" />

                                                <button type="submit"
                                                        class="btn btn-success payroll-action-btn"
                                                        title="Disburse Salary and Mark Paid">
                                                    <i class="fa-solid fa-money-bill-wave me-1"></i>
                                                    Mark Paid
                                                </button>
                                            </form>
                                        }

                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

</div>

<div class="modal fade payroll-modal"
     id="runPayrollModal"
     tabindex="-1"
     aria-hidden="true">

    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">

            <div class="payroll-modal-header">
                <div>
                    <h5 class="payroll-modal-title">
                        <i class="fa-solid fa-gears me-2"></i>
                        Execute Monthly Payroll Engine
                    </h5>

                    <p class="payroll-modal-subtitle">
                        Configure the payroll period and start automated salary processing.
                    </p>
                </div>

                <button type="button"
                        class="btn-close btn-close-white position-relative"
                        style="z-index:2;"
                        data-bs-dismiss="modal"
                        aria-label="Close">
                </button>
            </div>

            <form asp-action="RunPayrollProcessing" method="post">
                @Html.AntiForgeryToken()

                <div class="modal-body text-start">

                    <div class="workflow-pipeline">

                        <div class="workflow-heading">
                            <i class="fa-solid fa-diagram-project"></i>
                            AUTOMATED PAYROLL PROCESSING PIPELINE
                        </div>

                        <div class="row g-2">

                            <div class="col-6 col-md">
                                <div class="pipeline-step">
                                    <span class="pipeline-number">1</span>
                                    <span class="pipeline-label">Active Employees</span>
                                </div>
                            </div>

                            <div class="col-6 col-md">
                                <div class="pipeline-step">
                                    <span class="pipeline-number">2</span>
                                    <span class="pipeline-label">Attendance & LOP</span>
                                </div>
                            </div>

                            <div class="col-6 col-md">
                                <div class="pipeline-step">
                                    <span class="pipeline-number">3</span>
                                    <span class="pipeline-label">Overtime & Bonus</span>
                                </div>
                            </div>

                            <div class="col-6 col-md">
                                <div class="pipeline-step">
                                    <span class="pipeline-number">4</span>
                                    <span class="pipeline-label">PF / ESI / TDS</span>
                                </div>
                            </div>

                            <div class="col-12 col-md">
                                <div class="pipeline-step">
                                    <span class="pipeline-number">5</span>
                                    <span class="pipeline-label">Net Pay & Payslips</span>
                                </div>
                            </div>

                        </div>
                    </div>

                    <div class="row g-3">

                        <div class="col-md-4">
                            <label class="payroll-form-label">
                                Select Month
                                <span class="required">*</span>
                            </label>

                            <select name="month"
                                    id="selectMonth"
                                    class="form-select"
                                    onchange="updatePayPeriodString()"
                                    required>

                                <option value="1">January</option>
                                <option value="2">February</option>
                                <option value="3">March</option>
                                <option value="4">April</option>
                                <option value="5">May</option>
                                <option value="6">June</option>
                                <option value="7">July</option>
                                <option value="8" selected>August</option>
                                <option value="9">September</option>
                                <option value="10">October</option>
                                <option value="11">November</option>
                                <option value="12">December</option>

                            </select>
                        </div>

                        <div class="col-md-4">
                            <label class="payroll-form-label">
                                Select Year
                                <span class="required">*</span>
                            </label>

                            <select name="year"
                                    id="selectYear"
                                    class="form-select"
                                    onchange="updatePayPeriodString()"
                                    required>

                                <option value="2025">2025</option>
                                <option value="2026" selected>2026</option>
                                <option value="2027">2027</option>

                            </select>
                        </div>

                        <div class="col-md-4">
                            <label class="payroll-form-label">
                                Department Filter
                            </label>

                            <select name="department" class="form-select">
                                <option value="All Departments">All Departments</option>
                                <option value="Engineering">Engineering</option>
                                <option value="Sales">Sales</option>
                                <option value="HR">HR</option>
                                <option value="Finance">Finance</option>
                            </select>
                        </div>

                        <div class="col-12">
                            <label class="payroll-form-label">
                                Generated Pay Period Identifier
                            </label>

                            <input type="text"
                                   name="payPeriod"
                                   id="inputPayPeriod"
                                   class="form-control pay-period-input"
                                   readonly
                                   value="August 2026">
                        </div>

                    </div>

                </div>

                <div class="modal-footer">

                    <button type="button"
                            class="btn btn-light border modal-cancel-btn"
                            data-bs-dismiss="modal">
                        Cancel
                    </button>

                    <button type="submit"
                            class="btn btn-primary modal-submit-btn">
                        <i class="fa-solid fa-play me-1"></i>
                        Run Payroll Calculation
                    </button>

                </div>

            </form>
        </div>
    </div>
</div>

<div class="modal fade payroll-modal"
     id="runDetailsModal"
     tabindex="-1"
     aria-hidden="true">

    <div class="modal-dialog modal-xl modal-dialog-centered">
        <div class="modal-content">

            <div class="payroll-modal-header">

                <div>
                    <h5 class="payroll-modal-title" id="runDetailsTitle">
                        <i class="fa-solid fa-file-invoice-dollar me-2"></i>
                        Payroll Run Breakdown
                    </h5>

                    <p class="payroll-modal-subtitle">
                        Employee-level salary and payslip information.
                    </p>
                </div>

                <button type="button"
                        class="btn-close btn-close-white position-relative"
                        style="z-index:2;"
                        data-bs-dismiss="modal"
                        aria-label="Close">
                </button>

            </div>

            <div class="modal-body"
                 id="runDetailsContent">

                <div class="loading-state">
                    <div class="spinner-border text-primary loading-spinner"
                         role="status">
                    </div>

                    <div class="loading-text">
                        Loading payroll details...
                    </div>
                </div>

            </div>

        </div>
    </div>
</div>

<script>
    function updatePayPeriodString() {
        const monthSelect = document.getElementById('selectMonth');
        const monthName = monthSelect.options[monthSelect.selectedIndex].text;
        const yearName = document.getElementById('selectYear').value;

        document.getElementById('inputPayPeriod').value =
            monthName + " " + yearName;
    }

    function formatCurrency(value) {
        const number = Number(value || 0);

        return "₹" + number.toLocaleString("en-IN", {
            maximumFractionDigits: 0
        });
    }

    function escapeHtml(value) {
        if (value === null || value === undefined) {
            return "";
        }

        const div = document.createElement("div");
        div.textContent = value;
        return div.innerHTML;
    }

    function viewPayrollRunDetails(runId) {

        const modalElement =
            document.getElementById('runDetailsModal');

        const modal =
            bootstrap.Modal.getOrCreateInstance(modalElement);

        const contentDiv =
            document.getElementById('runDetailsContent');

        contentDiv.innerHTML = `
            <div class="loading-state">
                <div class="spinner-border text-primary loading-spinner"
                     role="status">
                </div>

                <div class="loading-text">
                    Loading payroll details...
                </div>
            </div>
        `;

        modal.show();

        fetch('/HRPayroll/GetPayrollRunDetails/' + runId)
            .then(res => {

                if (!res.ok) {
                    throw new Error("Failed to load payroll details.");
                }

                return res.json();
            })
            .then(data => {

                const payslips = data.payslips || [];

                let html = `
                    <div class="details-summary">

                        <div class="row g-3">

                            <div class="col-6 col-lg-3">
                                <div class="detail-summary-item">
                                    <span class="detail-summary-label">
                                        Pay Period
                                    </span>

                                    <span class="detail-summary-value">
                                        ${escapeHtml(data.payPeriod)}
                                    </span>
                                </div>
                            </div>

                            <div class="col-6 col-lg-3">
                                <div class="detail-summary-item">
                                    <span class="detail-summary-label">
                                        Employees
                                    </span>

                                    <span class="detail-summary-value">
                                        ${data.totalEmployees || 0}
                                    </span>
                                </div>
                            </div>

                            <div class="col-6 col-lg-3">
                                <div class="detail-summary-item">
                                    <span class="detail-summary-label">
                                        Gross Salary
                                    </span>

                                    <span class="detail-summary-value">
                                        ${formatCurrency(data.totalGrossSalary)}
                                    </span>
                                </div>
                            </div>

                            <div class="col-6 col-lg-3">
                                <div class="detail-summary-item">
                                    <span class="detail-summary-label">
                                        Net Payout
                                    </span>

                                    <span class="detail-summary-value success">
                                        ${formatCurrency(data.totalNetSalary)}
                                    </span>
                                </div>
                            </div>

                        </div>

                    </div>

                    <div class="details-table-wrap">
                        <div class="table-responsive">

                            <table class="table details-table align-middle">

                                <thead>
                                    <tr>
                                        <th>Employee</th>
                                        <th>Basic Salary</th>
                                        <th>HRA</th>
                                        <th>Gross Salary</th>
                                        <th>Deductions</th>
                                        <th>Net Payable</th>
                                        <th>Status</th>
                                    </tr>
                                </thead>

                                <tbody>
                `;

                if (payslips.length === 0) {

                    html += `
                        <tr>
                            <td colspan="7"
                                class="text-center py-5 text-muted">
                                <i class="fa-solid fa-file-circle-xmark d-block mb-2"
                                   style="font-size:1.5rem;"></i>

                                No payslip details found.
                            </td>
                        </tr>
                    `;
                }
                else {

                    payslips.forEach(p => {

                        html += `
                            <tr>

                                <td>
                                    <div class="details-employee">
                                        ${escapeHtml(p.employeeName)}
                                    </div>

                                    <div class="details-user-code">
                                        ${escapeHtml(p.userCode)}
                                    </div>
                                </td>

                                <td>
                                    ${formatCurrency(p.basicSalary)}
                                </td>

                                <td>
                                    ${formatCurrency(p.hra)}
                                </td>

                                <td class="fw-bold">
                                    ${formatCurrency(p.grossSalary)}
                                </td>

                                <td class="text-danger fw-semibold">
                                    ${formatCurrency(p.totalDeductions)}
                                </td>

                                <td class="text-success fw-bold">
                                    ${formatCurrency(p.netSalary)}
                                </td>

                                <td>
                                    <span class="status-pill status-paid">
                                        <i class="fa-solid fa-circle-check"></i>
                                        ${escapeHtml(p.status)}
                                    </span>
                                </td>

                            </tr>
                        `;
                    });
                }

                html += `
                                </tbody>

                            </table>

                        </div>
                    </div>
                `;

                contentDiv.innerHTML = html;
            })
            .catch(error => {

                console.error(error);

                contentDiv.innerHTML = `
                    <div class="text-center py-5">

                        <div class="empty-icon"
                             style="background:#fef2f2;color:#dc2626;">
                            <i class="fa-solid fa-triangle-exclamation"></i>
                        </div>

                        <div class="empty-title">
                            Unable to Load Payroll Details
                        </div>

                        <p class="empty-text mb-3">
                            Something went wrong while loading this payroll run.
                        </p>

                        <button type="button"
                                class="btn btn-outline-primary btn-sm rounded-pill px-3"
                                onclick="viewPayrollRunDetails(${runId})">

                            <i class="fa-solid fa-rotate-right me-1"></i>
                            Try Again
                        </button>

                    </div>
                `;
            });
    }
</script>
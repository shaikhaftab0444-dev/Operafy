        }
    }

    @@media (max-width: 400px) {
        .payroll-hero {
            padding: 19px 16px;
        }

        .payroll-engine-badge {
            width: 100%;
            justify-content: center;
            text-align: center;
        }

        .stat-value {
            font-size: 1.28rem;
        }

        .stat-icon {
            width: 45px;
            height: 45px;
            flex: 0 0 45px;
        }

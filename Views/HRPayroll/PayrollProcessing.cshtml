@model List<ERP_System.Models.PayrollRun>
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Monthly Payroll Processing";
    var runs = Model ?? ViewBag.PayrollRuns as List<ERP_System.Models.PayrollRun> ?? new List<ERP_System.Models.PayrollRun>();

    var activeEmployeesCount = ViewBag.EligibleEmployees ?? ViewBag.ActiveEmployeesCount ?? 0;
    var draftRunsCount = ViewBag.PendingApproval ?? ViewBag.DraftRunsCount ?? 0;
    var totalNetPaid = ViewBag.TotalNetPaid ?? runs.Where(r => r.Status == "Paid & Closed" || r.Status == "Paid").Sum(r => r.TotalNetSalary);
    var bankAccounts = ViewBag.CompanyBanks as List<ERP_System.Models.CompanyBankAccount> ?? ViewBag.BankAccounts as List<ERP_System.Models.CompanyBankAccount> ?? new List<ERP_System.Models.CompanyBankAccount>();
}

<style>
    /* =========================================================
           MONTHLY PAYROLL PROCESSING - PREMIUM RESPONSIVE UI
        ========================================================== */

    .payroll-page {
        --payroll-primary: #2563eb;
        --payroll-primary-dark: #1d4ed8;
        --payroll-success: #16a34a;
        --payroll-warning: #d97706;
        --payroll-danger: #dc2626;
        --payroll-info: #0891b2;
        --payroll-dark: #0f172a;
        --payroll-muted: #64748b;
        --payroll-border: #e2e8f0;
        --payroll-bg: #f8fafc;
        color: var(--payroll-dark);
    }

        .payroll-page .page-alert {
            border: 0;
            border-radius: 18px;
            padding: 14px 18px;
            animation: payrollSlideDown .45s ease;
            box-shadow: 0 8px 24px rgba(15,23,42,.06);
        }

    /* ================= HERO ================= */

    .payroll-hero {
        position: relative;
        overflow: hidden;
        padding: 32px;
        border-radius: 24px;
        margin-bottom: 24px;
        color: #fff;
        background: radial-gradient(circle at 85% 20%, rgba(255,255,255,.16) 0, rgba(255,255,255,0) 30%), linear-gradient(135deg, #0f172a 0%, #1e3a8a 52%, #2563eb 100%);
        box-shadow: 0 20px 50px rgba(30,58,138,.20);
        animation: payrollFadeUp .55s ease;
    }

        .payroll-hero::before {
            content: "";
            position: absolute;
            width: 260px;
            height: 260px;
            border-radius: 50%;
            top: -150px;
            right: -70px;
            border: 1px solid rgba(255,255,255,.12);
            box-shadow: 0 0 0 40px rgba(255,255,255,.03), 0 0 0 80px rgba(255,255,255,.02);
            pointer-events: none;
        }

        .payroll-hero::after {
            content: "";
            position: absolute;
            width: 180px;
            height: 180px;
            bottom: -130px;
            left: 45%;
            border-radius: 50%;
            background: rgba(255,255,255,.035);
            pointer-events: none;
        }

    .payroll-hero-content {
        position: relative;
        z-index: 2;
    }

    .payroll-breadcrumb {
        display: inline-flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 8px;
        margin-bottom: 12px;
        font-size: .76rem;
        color: rgba(255,255,255,.68);
    }

        .payroll-breadcrumb a {
            color: rgba(255,255,255,.82);
            text-decoration: none;
            transition: .2s ease;
        }

            .payroll-breadcrumb a:hover {
                color: #fff;
            }

        .payroll-breadcrumb .separator {
            opacity: .5;
        }

    .payroll-title {
        font-size: 1.75rem;
        font-weight: 800;
        letter-spacing: -.5px;
        margin: 0 0 8px;
    }

    .payroll-subtitle {
        margin: 0;
        max-width: 700px;
        font-size: .9rem;
        line-height: 1.65;
        color: rgba(255,255,255,.72);
    }

    .payroll-engine-badge {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        margin-top: 17px;
        padding: 8px 14px;
        border: 1px solid rgba(255,255,255,.14);
        border-radius: 50px;
        background: rgba(255,255,255,.08);
        color: rgba(255,255,255,.92);
        font-size: .72rem;
        font-weight: 600;
        backdrop-filter: blur(8px);
    }

    .engine-dot {
        width: 8px;
        height: 8px;
        flex: 0 0 8px;
        background: #4ade80;
        border-radius: 50%;
        box-shadow: 0 0 0 0 rgba(74,222,128,.6);
        animation: payrollPulse 2s infinite;
    }

    .payroll-run-btn {
        min-height: 48px;
        padding: 0 21px;
        border: 0;
        border-radius: 14px;
        color: var(--payroll-primary-dark);
        background: #fff;
        font-weight: 700;
        white-space: nowrap;
        box-shadow: 0 10px 24px rgba(0,0,0,.16);
        transition: transform .25s ease, box-shadow .25s ease;
    }

        .payroll-run-btn:hover {
            color: var(--payroll-primary-dark);
            transform: translateY(-3px);
            box-shadow: 0 16px 30px rgba(0,0,0,.22);
        }

    /* ================= STATS ================= */

    .payroll-stat-card {
        position: relative;
        overflow: hidden;
        height: 100%;
        min-height: 148px;
        padding: 20px;
        background: #fff;
        border: 1px solid var(--payroll-border);
        border-radius: 20px;
        box-shadow: 0 8px 24px rgba(15,23,42,.04);
        transition: transform .28s ease, box-shadow .28s ease, border-color .28s ease;
        animation: payrollFadeUp .6s ease both;
    }

        .payroll-stat-card:hover {
            transform: translateY(-6px);
            border-color: rgba(37,99,235,.18);
            box-shadow: 0 18px 38px rgba(15,23,42,.09);
        }

        .payroll-stat-card::after {
            content: "";
            position: absolute;
            width: 120px;
            height: 120px;
            right: -48px;
            bottom: -65px;
            border-radius: 50%;
            background: rgba(37,99,235,.035);
        }

        .payroll-stat-card.delay-1 {
            animation-delay: .05s;
        }

        .payroll-stat-card.delay-2 {
            animation-delay: .12s;
        }

        .payroll-stat-card.delay-3 {
            animation-delay: .19s;
        }

        .payroll-stat-card.delay-4 {
            animation-delay: .26s;
        }

    .stat-top {
        position: relative;
        z-index: 2;
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 14px;
    }

    .stat-label {
        margin-bottom: 9px;
        color: var(--payroll-muted);
        font-size: .74rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .04em;
    }

    .stat-value {
        margin: 0;
        color: var(--payroll-dark);
        font-size: 1.65rem;
        font-weight: 800;
        line-height: 1.1;
        letter-spacing: -.5px;
        white-space: nowrap;
    }

        .stat-value.stat-success {
            color: var(--payroll-success);
        }

        .stat-value.stat-warning {
            color: var(--payroll-warning);
        }

    .stat-icon {
        width: 50px;
        height: 50px;
        flex: 0 0 50px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 16px;
        font-size: 1.15rem;
    }

    .icon-blue {
        color: #2563eb;
        background: #eff6ff;
    }

    .icon-cyan {
        color: #0891b2;
        background: #ecfeff;
    }

    .icon-orange {
        color: #d97706;
        background: #fff7ed;
    }

    .icon-green {
        color: #16a34a;
        background: #f0fdf4;
    }

    .stat-footer {
        position: relative;
        z-index: 2;
        display: flex;
        align-items: center;
        gap: 6px;
        margin-top: 17px;
        color: #94a3b8;
        font-size: .74rem;
        line-height: 1.45;
    }

    /* ================= PAYROLL HISTORY ================= */

    .payroll-history-card {
        overflow: hidden;
        width: 100%;
        background: #fff;
        border: 1px solid var(--payroll-border);
        border-radius: 22px;
        box-shadow: 0 10px 30px rgba(15,23,42,.045);
        animation: payrollFadeUp .7s ease both;
    }

    .history-card-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 18px;
        padding: 22px 24px;
        border-bottom: 1px solid var(--payroll-border);
        background: linear-gradient(180deg, #fff, #fbfdff);
    }

    .history-title-wrap {
        display: flex;
        align-items: center;
        gap: 13px;
        min-width: 0;
    }

    .history-title-icon {
        width: 44px;
        height: 44px;
        flex: 0 0 44px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 14px;
        color: var(--payroll-primary);
        background: #eff6ff;
    }

    .history-title {
        margin: 0 0 3px;
        color: var(--payroll-dark);
        font-size: .98rem;
        font-weight: 800;
    }

    .history-subtitle {
        margin: 0;
        color: var(--payroll-muted);
        font-size: .76rem;
        line-height: 1.5;
    }

    .history-count {
        flex: 0 0 auto;
        padding: 8px 13px;
        border: 1px solid #dbeafe;
        border-radius: 50px;
        background: #eff6ff;
        color: var(--payroll-primary);
        font-size: .75rem;
        font-weight: 700;
        white-space: nowrap;
    }

    .payroll-history-card .table-responsive {
        width: 100%;
        overflow-x: auto;
        overflow-y: visible;
        -webkit-overflow-scrolling: touch;
        scrollbar-width: thin;
        scrollbar-color: #cbd5e1 transparent;
    }

        .payroll-history-card .table-responsive::-webkit-scrollbar {
            height: 8px;
        }

        .payroll-history-card .table-responsive::-webkit-scrollbar-track {
            background: #f8fafc;
        }

        .payroll-history-card .table-responsive::-webkit-scrollbar-thumb {
            background: #cbd5e1;
            border-radius: 20px;
        }

    .payroll-table {
        width: max-content;
        min-width: 1360px;
        margin: 0;
        font-size: .82rem;
    }

        .payroll-table thead th {
            padding: 15px 15px;
            border: 0;
            border-bottom: 1px solid var(--payroll-border);
            background: #f8fafc;
            color: #64748b;
            font-size: .67rem;
            font-weight: 800;
            letter-spacing: .04em;
            text-transform: uppercase;
            white-space: nowrap;
        }

            .payroll-table thead th:last-child {
                min-width: 290px;
                padding-right: 20px;
            }

        .payroll-table tbody td {
            padding: 17px 15px;
            vertical-align: middle;
            border-color: #f1f5f9;
            white-space: nowrap;
        }

            .payroll-table tbody td:last-child {
                min-width: 290px;
                padding-right: 20px;
            }

        .payroll-table tbody tr {
            transition: background .2s ease;
        }

            .payroll-table tbody tr:hover {
                background: #fafcff;
            }

    .period-cell {
        display: flex;
        align-items: center;
        gap: 11px;
        min-width: 170px;
    }

    .period-icon {
        width: 37px;
        height: 37px;
        flex: 0 0 37px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 12px;
        color: var(--payroll-primary);
        background: #eff6ff;
    }

    .period-name {
        color: var(--payroll-dark);
        font-weight: 800;
        white-space: nowrap;
    }

    .period-date {
        margin-top: 3px;
        color: #94a3b8;
        font-size: .68rem;
    }

    .department-pill {
        display: inline-flex;
        align-items: center;
        padding: 6px 10px;
        border: 1px solid var(--payroll-border);
        border-radius: 50px;
        background: #f8fafc;
        color: #475569;
        font-size: .72rem;
        font-weight: 600;
        white-space: nowrap;
    }

    .money-value {
        color: #334155;
        font-weight: 700;
        white-space: nowrap;
    }

    .money-deduction {
        color: var(--payroll-danger);
        font-weight: 700;
        white-space: nowrap;
    }

    .money-net {
        color: var(--payroll-success);
        font-weight: 800;
        white-space: nowrap;
    }

    .money-ctc {
        color: #64748b;
        font-weight: 600;
        white-space: nowrap;
    }

    .status-pill {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 6px 12px;
        border-radius: 50px;
        font-size: .73rem;
        font-weight: 700;
        white-space: nowrap;
    }

    .status-paid {
        background: #f0fdf4;
        color: #16a34a;
        border: 1px solid #bbf7d0;
    }

    .status-approved {
        background: #ecfeff;
        color: #0891b2;
        border: 1px solid #a5f3fc;
    }

    .status-review {
        background: #eff6ff;
        color: #2563eb;
        border: 1px solid #bfdbfe;
    }

    .status-draft {
        background: #fff7ed;
        color: #d97706;
        border: 1px solid #fed7aa;
    }

    .payroll-action-btn {
        border-radius: 10px;
        font-weight: 700;
        font-size: .74rem;
        padding: 6px 13px;
        transition: transform .15s ease;
    }

        .payroll-action-btn:hover {
            transform: translateY(-2px);
        }

    .action-wrap {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 8px;
    }

    .empty-icon {
        width: 60px;
        height: 60px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 14px;
        border-radius: 20px;
        color: var(--payroll-primary);
        background: #eff6ff;
        font-size: 1.5rem;
    }

    .empty-title {
        margin-bottom: 6px;
        color: #334155;
        font-size: .95rem;
        font-weight: 800;
    }

    .empty-text {
        margin: 0;
        color: #94a3b8;
        font-size: .8rem;
    }

    /* ================= MODALS ================= */

    .payroll-modal .modal-dialog {
        margin-left: auto;
        margin-right: auto;
    }

    .payroll-modal .modal-content {
        overflow: hidden;
        border: 0;
        border-radius: 22px;
        box-shadow: 0 25px 60px rgba(15,23,42,.18);
    }

    .payroll-modal-header {
        position: relative;
        padding: 20px 24px;
        color: #fff;
        background: linear-gradient(135deg, #0f172a, #1d4ed8);
    }

        .payroll-modal-header::after {
            content: "";
            position: absolute;
            width: 150px;
            height: 150px;
            top: -90px;
            right: -40px;
            border-radius: 50%;
            background: rgba(255,255,255,.08);
        }

    .payroll-modal-title {
        position: relative;
        z-index: 1;
        margin: 0;
        font-size: 1.02rem;
        font-weight: 800;
    }

    .payroll-modal-subtitle {
        position: relative;
        z-index: 1;
        margin: 4px 0 0;
        color: rgba(255,255,255,.65);
        font-size: .75rem;
    }

    .payroll-modal .modal-body {
        padding: 24px;
    }

    .workflow-pipeline {
        padding: 18px;
        margin-bottom: 22px;
        border: 1px solid #e0e7ff;
        border-radius: 18px;
        background: linear-gradient(135deg, #f8faff, #f8fafc);
    }

    .workflow-heading {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 15px;
        color: #1e3a8a;
        font-size: .76rem;
        font-weight: 800;
    }

    .pipeline-step {
        position: relative;
        height: 100%;
        padding: 11px 8px;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        background: #fff;
        text-align: center;
        transition: transform .2s ease, border-color .2s ease, box-shadow .2s ease;
    }

        .pipeline-step:hover {
            transform: translateY(-3px);
            border-color: #bfdbfe;
            box-shadow: 0 8px 18px rgba(37,99,235,.06);
        }

    .pipeline-number {
        width: 23px;
        height: 23px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 6px;
        border-radius: 50%;
        background: #eff6ff;
        color: var(--payroll-primary);
        font-size: .67rem;
        font-weight: 800;
    }

    .pipeline-label {
        display: block;
        color: #475569;
        font-size: .65rem;
        font-weight: 700;
        line-height: 1.3;
    }

    .pipeline-step:last-child .pipeline-number {
        color: #15803d;
        background: #f0fdf4;
    }

    .payroll-form-label {
        margin-bottom: 7px;
        color: #475569;
        font-size: .72rem;
        font-weight: 800;
    }

        .payroll-form-label .required {
            color: #dc2626;
        }

    .payroll-modal .form-select,
    .payroll-modal .form-control {
        min-height: 43px;
        border: 1px solid #dbe3ee;
        border-radius: 11px;
        color: #334155;
        font-size: .82rem;
        box-shadow: none;
        transition: border-color .2s ease, box-shadow .2s ease;
    }

        .payroll-modal .form-select:focus,
        .payroll-modal .form-control:focus {
            border-color: #93c5fd;
            box-shadow: 0 0 0 4px rgba(37,99,235,.08);
        }

    .pay-period-input {
        font-weight: 800 !important;
        background: #f8fafc !important;
    }

    .payroll-modal .modal-footer {
        padding: 16px 24px;
        border-top: 1px solid #e2e8f0;
        background: #f8fafc;
    }

    .modal-cancel-btn {
        min-height: 40px;
        border-radius: 11px;
        padding: 0 18px;
        font-weight: 700;
        font-size: .78rem;
    }

    .modal-submit-btn {
        min-height: 40px;
        border: 0;
        border-radius: 11px;
        padding: 0 20px;
        font-weight: 700;
        font-size: .78rem;
        background: linear-gradient(135deg, #2563eb, #1d4ed8);
        box-shadow: 0 8px 18px rgba(37,99,235,.22);
        transition: transform .2s ease, box-shadow .2s ease;
    }

        .modal-submit-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 12px 24px rgba(37,99,235,.28);
        }

    /* ================= DETAILS MODAL ================= */

    .details-summary {
        padding: 17px;
        margin-bottom: 22px;
        border: 1px solid #e2e8f0;
        border-radius: 18px;
        background: #f8fafc;
    }

    .detail-summary-item {
        height: 100%;
        padding: 13px;
        border-radius: 14px;
        background: #fff;
        border: 1px solid #eef2f7;
    }

    .detail-summary-label {
        display: block;
        margin-bottom: 6px;
        color: #94a3b8;
        font-size: .66rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: .04em;
    }

    .detail-summary-value {
        color: #334155;
        font-size: .88rem;
        font-weight: 800;
        word-break: break-word;
    }

        .detail-summary-value.success {
            color: var(--payroll-success);
        }

    .details-table-wrap {
        width: 100%;
        border: 1px solid #e2e8f0;
        border-radius: 16px;
        overflow: hidden;
    }

        .details-table-wrap .table-responsive {
            overflow-x: auto;
            -webkit-overflow-scrolling: touch;
        }

    .details-table {
        min-width: 900px;
        margin: 0;
        font-size: .8rem;
    }

        .details-table thead th {
            padding: 13px;
            border: 0;
            background: #f8fafc;
            color: #64748b;
            font-size: .65rem;
            font-weight: 800;
            text-transform: uppercase;
            white-space: nowrap;
        }

        .details-table tbody td {
            padding: 14px 13px;
            border-color: #f1f5f9;
            vertical-align: middle;
        }

    .details-employee {
        color: #334155;
        font-weight: 800;
    }

    .details-user-code {
        margin-top: 2px;
        color: #94a3b8;
        font-size: .68rem;
    }

    .loading-state {
        padding: 55px 20px;
        text-align: center;
    }

    .loading-spinner {
        width: 44px;
        height: 44px;
        margin-bottom: 12px;
        border-width: 4px;
    }

    .loading-text {
        color: #64748b;
        font-size: .8rem;
        font-weight: 600;
    }

    /* ================= ANIMATIONS ================= */

    @@keyframes payrollFadeUp {
        from {
            opacity: 0;
            transform: translateY(18px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@keyframes payrollSlideDown {
        from {
            opacity: 0;
            transform: translateY(-12px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@keyframes payrollPulse {
        0% {
            box-shadow: 0 0 0 0 rgba(74,222,128,.55);
        }

        70% {
            box-shadow: 0 0 0 7px rgba(74,222,128,0);
        }

        100% {
            box-shadow: 0 0 0 0 rgba(74,222,128,0);
        }
    }

    /* ================= RESPONSIVE ================= */

    @@media (max-width: 1199.98px) {
        .payroll-table {
            min-width: 1300px;
        }
    }

    @@media (max-width: 991.98px) {
        .payroll-hero {
            padding: 27px;
        }

        .payroll-title {
            font-size: 1.45rem;
        }

        .payroll-hero .hero-actions {
            width: 100%;
        }

        .payroll-run-btn {
            width: 100%;
        }

        .payroll-stat-card {
            min-height: 135px;
        }

        .payroll-table {
            min-width: 1260px;
        }
    }

    @@media (max-width: 767.98px) {
        .payroll-page {
            padding-left: 0 !important;
            padding-right: 0 !important;
        }

        .payroll-hero {
            padding: 22px 20px;
            border-radius: 19px;
        }

        .payroll-title {
            font-size: 1.28rem;
        }

        .payroll-subtitle {
            font-size: .8rem;
        }

        .history-card-header {
            align-items: flex-start;
            flex-direction: column;
            padding: 18px;
        }

        .history-title-wrap {
            align-items: flex-start;
        }

        .history-count {
            width: 100%;
            text-align: center;
        }

        .payroll-stat-card {
            padding: 17px;
            min-height: auto;
        }

        .stat-value {
            font-size: 1.4rem;
        }

        .payroll-modal .modal-body {
            padding: 19px;
        }

        .payroll-modal .modal-footer {
            padding: 14px 19px;
        }

        .workflow-pipeline {
            padding: 14px;
        }

        .details-summary {
            padding: 12px;
        }

        .payroll-table {
            min-width: 1220px;
        }

        .payroll-history-card {
            border-radius: 18px;
        }

        .action-wrap {
            min-width: 255px;
        }
    }

    @@media (max-width: 575.98px) {
        .payroll-engine-badge {
            font-size: .65rem;
            line-height: 1.4;
        }

        .history-title-icon {
            width: 39px;
            height: 39px;
            flex: 0 0 39px;
            border-radius: 12px;
        }

        .history-title {
            font-size: .88rem;
        }

        .history-subtitle {
            font-size: .71rem;
        }

        .payroll-modal-title {
            font-size: .9rem;
        }

        .payroll-modal-subtitle {

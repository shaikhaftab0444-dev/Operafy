@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Monthly Payroll Processing";
    var runs = ViewBag.PayrollRuns as List<ERP_System.Models.PayrollRun> ?? new List<ERP_System.Models.PayrollRun>();
}

<div class="container-fluid py-4 text-start">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3 shadow-sm mb-4" role="alert">
            <i class="fa-solid fa-circle-check me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-3 shadow-sm mb-4" role="alert">
            <i class="fa-solid fa-circle-exclamation me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Header Section -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
        <div>
            <h4 class="fw-bold mb-1"><i class="fa-solid fa-receipt text-primary me-2"></i>Monthly Payroll Processing Engine</h4>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0 small">
                    <li class="breadcrumb-item"><a href="/HR" class="text-decoration-none">HR Dashboard</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Payroll Processing</li>
                </ol>
            </nav>
        </div>
        <button class="btn btn-primary rounded-pill px-3.5 btn-sm shadow-sm" data-bs-toggle="modal" data-bs-target="#runPayrollModal">
            <i class="fa-solid fa-cogs me-1.5"></i>Execute Pay Run
        </button>
    </div>

    <!-- Stats Cards -->
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="bg-white border rounded-3 p-3 shadow-sm d-flex align-items-center justify-content-between">
                <div>
                    <div class="text-muted small fw-semibold">Eligible Employees</div>
                    <h3 class="fw-bold mb-0 text-dark">@ViewBag.ActiveEmployeesCount</h3>
                </div>
                <div class="bg-primary-subtle text-primary p-3 rounded-circle">
                    <i class="fa-solid fa-users fa-lg"></i>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="bg-white border rounded-3 p-3 shadow-sm d-flex align-items-center justify-content-between">
                <div>
                    <div class="text-muted small fw-semibold">Total Pay Runs</div>
                    <h3 class="fw-bold mb-0 text-info">@runs.Count</h3>
                </div>
                <div class="bg-info-subtle text-info p-3 rounded-circle">
                    <i class="fa-solid fa-file-invoice-dollar fa-lg"></i>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="bg-white border rounded-3 p-3 shadow-sm d-flex align-items-center justify-content-between">
                <div>
                    <div class="text-muted small fw-semibold">Pending Verification/Approval</div>
                    <h3 class="fw-bold mb-0 text-warning">@ViewBag.DraftRunsCount</h3>
                </div>
                <div class="bg-warning-subtle text-warning p-3 rounded-circle">
                    <i class="fa-solid fa-clock-rotate-left fa-lg"></i>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="bg-white border rounded-3 p-3 shadow-sm d-flex align-items-center justify-content-between">
                <div>
                    <div class="text-muted small fw-semibold">Total Net Paid (All Runs)</div>
                    <h3 class="fw-bold mb-0 text-success">₹@(runs.Where(r => r.Status == "Paid").Sum(r => r.TotalNetSalary).ToString("N0"))</h3>
                </div>
                <div class="bg-success-subtle text-success p-3 rounded-circle">
                    <i class="fa-solid fa-money-bill-wave fa-lg"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- Payroll History & Workflow Table -->
    <div class="bg-white border rounded-3 p-4 shadow-sm">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h6 class="fw-bold text-dark mb-0"><i class="fa-solid fa-list-check text-primary me-2"></i>Payroll Execution & Approval Workflow</h6>
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" style="font-size: 0.85rem;">
                <thead class="table-light">
                    <tr>
                        <th>Pay Period</th>
                        <th>Department</th>
                        <th>Employees</th>
                        <th>Total Gross Payout</th>
                        <th>Deductions</th>
                        <th>Net Paid Amount</th>
                        <th>Employer CTC Cost</th>
                        <th>Status</th>
                        <th class="text-end">Actions & Workflow</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!runs.Any())
                    {
                        <tr>
                            <td colspan="9" class="text-center py-4 text-muted">
                                <i class="fa-solid fa-calculator fa-2x mb-2 text-secondary d-block"></i>
                                No payroll runs generated yet. Click <strong>Execute Pay Run</strong> to process monthly payroll.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var r in runs)
                        {
                            <tr>
                                <td class="fw-bold text-dark">
                                    <i class="fa-solid fa-calendar-check text-primary me-1.5"></i>@r.PayPeriod
                                    <div class="text-muted extra-small">Processed @r.ProcessedAt.ToString("dd MMM yyyy")</div>
                                </td>
                                <td><span class="badge bg-light text-dark border">@r.Department</span></td>
                                <td class="fw-semibold">@r.TotalEmployees Employees</td>
                                <td class="fw-semibold">₹@r.TotalGrossSalary.ToString("N0")</td>
                                <td class="text-danger">₹@r.TotalDeductions.ToString("N0")</td>
                                <td class="fw-bold text-success">₹@r.TotalNetSalary.ToString("N0")</td>
                                <td class="text-muted">₹@r.TotalCTC.ToString("N0")</td>
                                <td>
                                    @if (r.Status == "Paid")
                                    {
                                        <span class="badge bg-success-subtle text-success"><i class="fa-solid fa-circle-check me-1"></i>Paid & Closed</span>
                                    }
                                    else if (r.Status == "Approved")
                                    {
                                        <span class="badge bg-primary-subtle text-primary"><i class="fa-solid fa-thumbs-up me-1"></i>Approved by Finance</span>
                                    }
                                    else if (r.Status == "Locked")
                                    {
                                        <span class="badge bg-secondary"><i class="fa-solid fa-lock me-1"></i>Locked</span>
                                    }
                                    else if (r.Status == "Under Review")
                                    {
                                        <span class="badge bg-info-subtle text-info"><i class="fa-solid fa-magnifying-glass me-1"></i>Under HR Review</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning-subtle text-warning"><i class="fa-solid fa-hourglass-start me-1"></i>Draft (Pending Verification)</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <div class="d-flex justify-content-end gap-1">
                                        <!-- View Details Modal Trigger -->
                                        <button class="btn btn-outline-primary btn-xs rounded-pill px-2.5" onclick="viewPayrollRunDetails(@r.PayrollRunId)">
                                            <i class="fa-solid fa-eye me-1"></i>Inspect Slips
                                        </button>

                                        <!-- Workflow State Transitions -->
                                        @if (r.Status == "Draft" || r.Status == "Calculated")
                                        {
                                            <form asp-action="UpdatePayrollRunStatus" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="runId" value="@r.PayrollRunId" />
                                                <input type="hidden" name="newStatus" value="Under Review" />
                                                <button type="submit" class="btn btn-outline-info btn-xs rounded-pill px-2" title="Submit for Review">
                                                    <i class="fa-solid fa-paper-plane me-1"></i>Review
                                                </button>
                                            </form>
                                        }
                                        else if (r.Status == "Under Review")
                                        {
                                            <form asp-action="UpdatePayrollRunStatus" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="runId" value="@r.PayrollRunId" />
                                                <input type="hidden" name="newStatus" value="Approved" />
                                                <button type="submit" class="btn btn-outline-success btn-xs rounded-pill px-2" title="Approve Payroll">
                                                    <i class="fa-solid fa-check me-1"></i>Approve
                                                </button>
                                            </form>
                                        }
                                        else if (r.Status == "Approved")
                                        {
                                            <form asp-action="UpdatePayrollRunStatus" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="runId" value="@r.PayrollRunId" />
                                                <input type="hidden" name="newStatus" value="Paid" />
                                                <button type="submit" class="btn btn-success btn-xs rounded-pill px-2.5" title="Disburse Salary & Mark Paid">
                                                    <i class="fa-solid fa-dollar-sign me-1"></i>Mark Paid
                                                </button>
                                            </form>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- EXECUTE PAYROLL RUN MODAL -->
<div class="modal fade" id="runPayrollModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title fw-bold"><i class="fa-solid fa-cogs me-2"></i>Execute Monthly Payroll Engine</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="RunPayrollProcessing" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body p-4 text-start">
                    <!-- Workflow Steps Infographic -->
                    <div class="bg-light border rounded-3 p-3 mb-4">
                        <h6 class="fw-bold text-primary mb-2 small"><i class="fa-solid fa-diagram-project me-1"></i>Automated Payroll Computation Engine Pipeline</h6>
                        <div class="row text-center g-2 extra-small">
                            <div class="col"><span class="badge bg-primary w-100 py-1.5">1. Fetch Active Employees</span></div>
                            <div class="col"><span class="badge bg-primary w-100 py-1.5">2. Attendance & LOP Sync</span></div>
                            <div class="col"><span class="badge bg-primary w-100 py-1.5">3. Overtime & Bonus Add</span></div>
                            <div class="col"><span class="badge bg-primary w-100 py-1.5">4. Statutory PF/ESI/TDS</span></div>
                            <div class="col"><span class="badge bg-success w-100 py-1.5">5. Net Pay & Slips</span></div>
                        </div>
                    </div>

                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label small fw-bold">Select Month <span class="text-danger">*</span></label>
                            <select name="month" id="selectMonth" class="form-select form-select-sm" onchange="updatePayPeriodString()" required>
                                <option value="1">January</option>
                                <option value="2">February</option>
                                <option value="3">March</option>
                                <option value="4">April</option>
                                <option value="5">May</option>
                                <option value="6">June</option>
                                <option value="7">July</option>
                                <option value="8" selected>August</option>
                                <option value="9">September</option>
                                <option value="10">October</option>
                                <option value="11">November</option>
                                <option value="12">December</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-bold">Select Year <span class="text-danger">*</span></label>
                            <select name="year" id="selectYear" class="form-select form-select-sm" onchange="updatePayPeriodString()" required>
                                <option value="2025">2025</option>
                                <option value="2026" selected>2026</option>
                                <option value="2027">2027</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-bold">Department Filter</label>
                            <select name="department" class="form-select form-select-sm">
                                <option value="All Departments">All Departments</option>
                                <option value="Engineering">Engineering</option>
                                <option value="Sales">Sales</option>
                                <option value="HR">HR</option>
                                <option value="Finance">Finance</option>
                            </select>
                        </div>

                        <div class="col-12">
                            <label class="form-label small fw-bold">Generated Pay Period Identifier</label>
                            <input type="text" name="payPeriod" id="inputPayPeriod" class="form-control form-control-sm fw-bold bg-light" readonly value="August 2026">
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary btn-sm rounded-pill px-3" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary btn-sm rounded-pill px-4"><i class="fa-solid fa-play me-1.5"></i>Run Payroll Calculation</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- PAYROLL DETAILS INSPECTION MODAL -->
<div class="modal fade" id="runDetailsModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-light">
                <h5 class="modal-title fw-bold" id="runDetailsTitle"><i class="fa-solid fa-file-invoice text-primary me-2"></i>Payroll Run Breakdown Inspection</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4" id="runDetailsContent">
                <div class="text-center py-4"><div class="spinner-border text-primary" role="status"></div></div>
            </div>
        </div>
    </div>
</div>

<script>
    function updatePayPeriodString() {
        let monthSelect = document.getElementById('selectMonth');
        let monthName = monthSelect.options[monthSelect.selectedIndex].text;
        let yearName = document.getElementById('selectYear').value;
        document.getElementById('inputPayPeriod').value = monthName + " " + yearName;
    }

    function viewPayrollRunDetails(runId) {
        let modal = new bootstrap.Modal(document.getElementById('runDetailsModal'));
        let contentDiv = document.getElementById('runDetailsContent');
        contentDiv.innerHTML = '<div class="text-center py-4"><div class="spinner-border text-primary" role="status"></div></div>';
        modal.show();

        fetch('/HRPayroll/GetPayrollRunDetails/' + runId)
            .then(res => res.json())
            .then(data => {
                let html = `
                    <div class="row g-3 mb-4 bg-light p-3 rounded-3 border">
                        <div class="col-md-3"><strong>Period:</strong> ${data.payPeriod}</div>
                        <div class="col-md-3"><strong>Employees:</strong> ${data.totalEmployees}</div>
                        <div class="col-md-3"><strong>Gross Salary:</strong> ₹${data.totalGrossSalary}</div>
                        <div class="col-md-3"><strong>Net Payout:</strong> <span class="text-success fw-bold">₹${data.totalNetSalary}</span></div>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0" style="font-size:0.8rem;">
                            <thead class="table-light">
                                <tr>
                                    <th>Employee Name</th>
                                    <th>Basic Salary</th>
                                    <th>HRA</th>
                                    <th>Gross Salary</th>
                                    <th>Total Deductions</th>
                                    <th>Net Payable</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>`;
                data.payslips.forEach(p => {
                    html += `<tr>
                        <td class="fw-bold">${p.employeeName} (${p.userCode})</td>
                        <td>₹${p.basicSalary.toLocaleString()}</td>
                        <td>₹${p.hra.toLocaleString()}</td>
                        <td class="fw-semibold">₹${p.grossSalary.toLocaleString()}</td>
                        <td class="text-danger">₹${p.totalDeductions.toLocaleString()}</td>
                        <td class="fw-bold text-success">₹${p.netSalary.toLocaleString()}</td>
                        <td><span class="badge bg-success-subtle text-success">${p.status}</span></td>
                    </tr>`;
                });
                html += `</tbody></table></div>`;
                contentDiv.innerHTML = html;
            })
            .catch(err => {
                contentDiv.innerHTML = '<div class="alert alert-danger">Error loading details.</div>';
            });
    }
</script>

        }

        .payroll-table {
            min-width: 1200px;
        }

            .payroll-table tbody td,
            .payroll-table thead th {
                padding-left: 12px;
                padding-right: 12px;
            }

        .details-table {
            min-width: 760px;
        }

        .stat-label {
            font-size: .68rem;
        }

        .stat-footer {

@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Payslip Generation & Distribution";
}

<div class="container-fluid py-4 text-start">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-bold mb-1"><i class="fa-solid fa-money-check-dollar text-primary me-2"></i>Payslips</h4>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0 small">
                    <li class="breadcrumb-item"><a href="/HR" class="text-decoration-none">HR Dashboard</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Payslips</li>
                </ol>
            </nav>
        </div>
        <button class="btn btn-primary rounded-pill px-3 btn-sm shadow-sm"><i class="fa-solid fa-paper-plane me-1.5"></i>Release Payslips (Email)</button>
    </div>

    <!-- Payslips list -->
    <div class="bg-white border rounded-3 p-4 shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" style="font-size: 0.85rem;">
                <thead class="table-light">
                    <tr>
                        <th>Employee ID</th>
                        <th>Employee Name</th>
                        <th>Pay Period</th>
                        <th>Net Salary Paid</th>
                        <th>Verification Status</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td class="fw-bold text-dark">EMP-001</td>
                        <td>Numan Sales Man</td>
                        <td>July 2026</td>
                        <td>₹85,000</td>
                        <td><span class="badge bg-success-subtle text-success">Verified</span></td>
                        <td><button class="btn btn-outline-danger btn-xs rounded-pill px-2.5"><i class="fa-solid fa-file-pdf me-1"></i>PDF</button></td>
                    </tr>
                    <tr>
                        <td class="fw-bold text-dark">EMP-002</td>
                        <td>Aftab Shaik</td>
                        <td>July 2026</td>
                        <td>₹48,250</td>
                        <td><span class="badge bg-success-subtle text-success">Verified</span></td>
                        <td><button class="btn btn-outline-danger btn-xs rounded-pill px-2.5"><i class="fa-solid fa-file-pdf me-1"></i>PDF</button></td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

@model List<ERP_System.Models.Payslip>

@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Payslip Management & Distribution";

    bool isManagement = ViewBag.IsManagement ?? false;
    var payPeriods = ViewBag.PayPeriods as List<string> ?? new List<string>();
    var employees = ViewBag.Employees as List<ERP_System.Models.User> ?? new List<ERP_System.Models.User>();

    var totalPayslips = Model?.Count ?? 0;
    var totalGrossSalary = Model?.Sum(x => x.GrossSalary) ?? 0;
    var totalDeductions = Model?.Sum(x => x.TotalDeductions) ?? 0;
    var totalNetSalary = Model?.Sum(x => x.NetSalary) ?? 0;
}

<style>
    /* =========================================================
           PAYSLIP MANAGEMENT - PREMIUM ERP UI
           ========================================================= */

    .payslip-page {
        --ps-primary: #4f46e5;
        --ps-primary-dark: #3730a3;
        --ps-secondary: #0ea5e9;
        --ps-success: #10b981;
        --ps-danger: #ef4444;
        --ps-warning: #f59e0b;
        --ps-dark: #111827;
        --ps-text: #374151;
        --ps-muted: #6b7280;
        --ps-border: #e5e7eb;
        --ps-bg: #f7f8fc;
        --ps-card: #ffffff;
        background: var(--ps-bg);
        min-height: 100%;
    }

        .payslip-page .page-inner {
            max-width: 1600px;
            margin: 0 auto;
        }

    /* ---------------- PAGE HEADER ---------------- */

    .payslip-hero {
        position: relative;
        overflow: hidden;
        padding: 1.7rem 1.8rem;
        border-radius: 22px;
        background: linear-gradient(135deg, #1e1b4b 0%, #3730a3 45%, #4f46e5 100%);
        color: #fff;
        margin-bottom: 1.5rem;
        box-shadow: 0 18px 40px rgba(79, 70, 229, .18);
        animation: heroReveal .7s ease both;
    }

        .payslip-hero::before {
            content: "";
            position: absolute;
            width: 280px;
            height: 280px;
            right: -70px;
            top: -130px;
            border-radius: 50%;
            background: rgba(255, 255, 255, .07);
        }

        .payslip-hero::after {
            content: "";
            position: absolute;
            width: 170px;
            height: 170px;
            left: 45%;
            bottom: -125px;
            border-radius: 50%;
            background: rgba(255, 255, 255, .05);
        }

    .hero-content {
        position: relative;
        z-index: 2;
    }

    .hero-title {
        display: flex;
        align-items: center;
        gap: 1rem;
    }

    .hero-icon {
        width: 56px;
        height: 56px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 17px;
        font-size: 1.45rem;
        background: rgba(255, 255, 255, .15);
        border: 1px solid rgba(255, 255, 255, .16);
        backdrop-filter: blur(10px);
        box-shadow: 0 10px 20px rgba(0, 0, 0, .12);
    }

    .hero-title h2 {
        font-size: 1.45rem;
        font-weight: 750;
        margin: 0;
        letter-spacing: -.3px;
    }

    .hero-title p {
        margin: .25rem 0 0;
        color: rgba(255, 255, 255, .72);
        font-size: .87rem;
    }

    .custom-breadcrumb {
        display: flex;
        align-items: center;
        gap: .5rem;
        margin-top: 1.25rem;
        padding: 0;
        list-style: none;
        font-size: .78rem;
        color: rgba(255, 255, 255, .62);
    }

        .custom-breadcrumb a {
            color: rgba(255, 255, 255, .82);
            text-decoration: none;
            transition: .2s ease;
        }

            .custom-breadcrumb a:hover {
                color: #fff;
            }

        .custom-breadcrumb i {
            font-size: .6rem;
            opacity: .55;
        }

    /* ---------------- ALERT ---------------- */

    .custom-alert {
        display: flex;
        align-items: center;
        padding: 1rem 1.15rem;
        border: 1px solid rgba(16, 185, 129, .18);
        border-radius: 16px;
        background: linear-gradient(135deg, #ecfdf5, #f0fdf4);
        color: #065f46;
        box-shadow: 0 8px 22px rgba(16, 185, 129, .08);
        animation: slideDown .45s ease both;
    }

        .custom-alert .alert-icon {
            width: 38px;
            height: 38px;
            min-width: 38px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border-radius: 12px;
            margin-right: .8rem;
            color: #059669;
            background: #d1fae5;
        }

    /* ---------------- KPI CARDS ---------------- */

    .payslip-stats {
        margin-bottom: 1.5rem;
    }

    .stat-card {
        position: relative;
        overflow: hidden;
        height: 100%;
        padding: 1.2rem;
        background: #fff;
        border: 1px solid var(--ps-border);
        border-radius: 18px;
        box-shadow: 0 8px 25px rgba(15, 23, 42, .045);
        transition: transform .25s ease, box-shadow .25s ease;
        animation: cardReveal .55s ease both;
    }

        .stat-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 18px 35px rgba(15, 23, 42, .10);
        }

        .stat-card::after {
            content: "";
            position: absolute;
            width: 90px;
            height: 90px;
            right: -28px;
            bottom: -35px;
            border-radius: 50%;
            opacity: .08;
        }

        .stat-card.stat-primary::after {
            background: var(--ps-primary);
        }

        .stat-card.stat-success::after {
            background: var(--ps-success);
        }

        .stat-card.stat-danger::after {
            background: var(--ps-danger);
        }

        .stat-card.stat-info::after {
            background: var(--ps-secondary);
        }

    .stat-icon {
        width: 46px;
        height: 46px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 14px;
        margin-bottom: .9rem;
        font-size: 1.05rem;
    }

    .stat-primary .stat-icon {
        background: #eef2ff;
        color: #4f46e5;
    }

    .stat-success .stat-icon {
        background: #ecfdf5;
        color: #059669;
    }

    .stat-danger .stat-icon {
        background: #fef2f2;
        color: #dc2626;
    }

    .stat-info .stat-icon {
        background: #f0f9ff;
        color: #0284c7;
    }

    .stat-label {
        display: block;
        margin-bottom: .25rem;
        font-size: .73rem;
        font-weight: 700;
        letter-spacing: .04em;
        text-transform: uppercase;
        color: var(--ps-muted);
    }

    .stat-value {
        font-size: 1.35rem;
        font-weight: 800;
        color: var(--ps-dark);
        letter-spacing: -.5px;
    }

    /* ---------------- FILTER CARD ---------------- */

    .filter-card {
        margin-bottom: 1.5rem;
        padding: 1.35rem;
        background: #fff;
        border: 1px solid var(--ps-border);
        border-radius: 20px;
        box-shadow: 0 8px 25px rgba(15, 23, 42, .045);
        animation: fadeUp .55s ease .12s both;
    }

    .filter-top {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        margin-bottom: 1.1rem;
    }

    .filter-title {
        display: flex;
        align-items: center;
        gap: .65rem;
        font-size: .95rem;
        font-weight: 750;
        color: var(--ps-dark);
    }

        .filter-title i {
            color: var(--ps-primary);
        }

    .filter-card .form-control,
    .filter-card .form-select {
        min-height: 43px;
        border-color: #e2e8f0;
        border-radius: 12px;
        box-shadow: none;
        font-size: .85rem;
        transition: all .2s ease;
    }

        .filter-card .form-control:focus,
        .filter-card .form-select:focus {
            border-color: var(--ps-primary);
            box-shadow: 0 0 0 4px rgba(79, 70, 229, .09);
        }

    .search-box {
        position: relative;
    }

        .search-box .search-icon {
            position: absolute;
            top: 50%;
            left: .95rem;
            transform: translateY(-50%);
            color: #9ca3af;
            font-size: .8rem;
            pointer-events: none;
        }

        .search-box input {
            padding-left: 2.55rem;
        }

    .reset-filter-btn {
        min-height: 43px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: .45rem;
        border-radius: 12px;
        font-size: .82rem;
        font-weight: 650;
        transition: all .2s ease;
    }

        .reset-filter-btn:hover {
            transform: translateY(-1px);
        }

    /* ---------------- TABLE CARD ---------------- */

    .payslip-table-card {
        overflow: hidden;
        background: #fff;
        border: 1px solid var(--ps-border);
        border-radius: 20px;
        box-shadow: 0 8px 25px rgba(15, 23, 42, .05);
        animation: fadeUp .6s ease .2s both;
    }

    .table-card-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        padding: 1.25rem 1.4rem;
        border-bottom: 1px solid var(--ps-border);
    }

    .table-card-title {
        display: flex;
        align-items: center;
        gap: .75rem;
    }

        .table-card-title .table-icon {
            width: 40px;
            height: 40px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border-radius: 12px;
            color: var(--ps-primary);
            background: #eef2ff;
        }

        .table-card-title h5 {
            margin: 0;
            font-size: .98rem;
            font-weight: 750;
            color: var(--ps-dark);
        }

        .table-card-title span {
            display: block;
            margin-top: .12rem;
            font-size: .76rem;
            color: var(--ps-muted);
        }

    .record-count {
        padding: .42rem .75rem;
        border-radius: 999px;
        font-size: .75rem;
        font-weight: 700;
        color: #4338ca;
        background: #eef2ff;
        white-space: nowrap;
    }

    .payslip-table {
        margin: 0;
        font-size: .84rem;
    }

        .payslip-table thead th {
            padding: .95rem 1rem;
            background: #f8fafc;
            border-bottom: 1px solid #e5e7eb;
            color: #64748b;
            font-size: .69rem;
            font-weight: 750;
            letter-spacing: .045em;
            text-transform: uppercase;
            white-space: nowrap;
        }

        .payslip-table tbody td {
            padding: 1rem;
            vertical-align: middle;
            border-color: #f1f5f9;
        }

        .payslip-table tbody tr {
            transition: background .2s ease, transform .2s ease;
        }

            .payslip-table tbody tr:hover {
                background: #fafbff;
            }

    .payslip-number {
        display: inline-flex;
        align-items: center;
        gap: .5rem;
        padding: .45rem .7rem;
        border-radius: 9px;
        color: #4338ca;
        background: #eef2ff;
        font-family: Consolas, monospace;
        font-size: .76rem;
        font-weight: 700;
        white-space: nowrap;
    }

    .employee-cell {
        display: flex;
        align-items: center;
        gap: .75rem;
        min-width: 175px;
    }

    .employee-avatar {
        width: 38px;
        height: 38px;
        min-width: 38px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 12px;
        color: #4f46e5;
        background: linear-gradient(135deg, #eef2ff, #e0e7ff);
        font-size: .8rem;
        font-weight: 800;
    }

    .employee-name {
        margin-bottom: .12rem;
        color: var(--ps-dark);
        font-size: .84rem;
        font-weight: 750;
    }

    .employee-meta {
        color: var(--ps-muted);
        font-size: .68rem;
        white-space: nowrap;
    }

    .period-badge {
        display: inline-flex;
        align-items: center;
        gap: .4rem;
        padding: .42rem .65rem;
        border: 1px solid #dbeafe;
        border-radius: 9px;
        color: #1d4ed8;
        background: #eff6ff;
        font-size: .74rem;
        font-weight: 650;
        white-space: nowrap;
    }

    .working-days {
        color: var(--ps-text);
        font-weight: 650;
        white-space: nowrap;
    }

        .working-days span {
            color: var(--ps-muted);
            font-size: .73rem;
            font-weight: 500;
        }

    .amount-cell {
        white-space: nowrap;
        font-weight: 650;
        color: #374151;
    }

    .deduction-amount {
        color: #dc2626;
    }

    .net-salary {
        color: #059669;
        font-size: .9rem;
        font-weight: 800;
    }

    .status-pill {
        display: inline-flex;
        align-items: center;
        gap: .38rem;
        padding: .45rem .7rem;
        border-radius: 999px;
        background: #ecfdf5;
        color: #047857;
        font-size: .72rem;
        font-weight: 750;
        white-space: nowrap;
    }

    .action-buttons {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: .45rem;
        white-space: nowrap;
    }

    .payslip-action {
        width: 34px;
        height: 34px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border: 1px solid;
        border-radius: 10px;
        background: #fff;
        transition: all .2s ease;
        text-decoration: none;
        cursor: pointer;
    }

        .payslip-action:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 14px rgba(15, 23, 42, .1);
        }

    .view-action {
        border-color: #c7d2fe;
        color: #4f46e5;
    }

        .view-action:hover {
            color: #fff;
            background: #4f46e5;
        }

    .pdf-action {
        border-color: #fecaca;
        color: #dc2626;
    }

        .pdf-action:hover {
            color: #fff;
            background: #dc2626;
        }

    .email-action {
        border-color: #bae6fd;
        color: #0284c7;
    }

        .email-action:hover {
            color: #fff;
            background: #0284c7;
        }

    /* ---------------- EMPTY STATE ---------------- */

    .empty-state {
        padding: 4rem 1.5rem !important;
        text-align: center;
    }

    .empty-icon {
        width: 74px;
        height: 74px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 1rem;
        border-radius: 22px;
        color: #94a3b8;
        background: #f8fafc;
        font-size: 1.8rem;
    }

    .empty-state h6 {
        margin-bottom: .35rem;
        color: #334155;
        font-weight: 750;
    }

    .empty-state p {
        margin: 0;
        color: #94a3b8;
        font-size: .8rem;
    }

    /* ---------------- MODAL ---------------- */

    #payslipModal .modal-content {
        overflow: hidden;
        border-radius: 20px;
    }

    #payslipModal .modal-header {
        padding: 1.1rem 1.35rem;
        border-bottom: 1px solid #e5e7eb;
        background: linear-gradient(135deg, #f8fafc, #f5f3ff);
    }

    #payslipModal .modal-title {
        display: flex;
        align-items: center;
        gap: .65rem;
        color: #1f2937;
        font-size: 1rem;
    }

    #payslipModal .modal-body {
        padding: 1.5rem;
        background: #fff;
    }

    .modal-loader {
        padding: 3rem 0;
        text-align: center;
    }

        .modal-loader .spinner-border {
            width: 2.5rem;
            height: 2.5rem;
            border-width: .22rem;
        }

    /* ---------------- ANIMATIONS ---------------- */

    .stat-card:nth-child(1) {
        animation-delay: .05s;
    }

    .stat-card:nth-child(2) {
        animation-delay: .12s;
    }

    .stat-card:nth-child(3) {
        animation-delay: .19s;
    }

    .stat-card:nth-child(4) {
        animation-delay: .26s;
    }

    @@keyframes heroReveal {
        from

    {
        opacity: 0;
        transform: translateY(-15px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }

    }

    @@keyframes cardReveal {
        from

    {
        opacity: 0;
        transform: translateY(18px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }

    }

    @@keyframes fadeUp {
        from

    {
        opacity: 0;
        transform: translateY(20px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }

    }

    @@keyframes slideDown {
        from

    {
        opacity: 0;
        transform: translateY(-12px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }

    }

    /* ---------------- RESPONSIVE ---------------- */

    @@media (max-width: 991.98px) {
        .payslip-hero {
            padding: 1.4rem;
        }

        .filter-card {
            padding: 1.1rem;
        }

        .table-card-header {
            padding: 1rem;
        }

        .payslip-table thead th,
        .payslip-table tbody td {
            padding-left: .8rem;
            padding-right: .8rem;
        }
    }

    @@media (max-width: 767.98px) {
        .payslip-page {
            padding: .5rem !important;
        }

        .payslip-hero {
            padding: 1.2rem;
            border-radius: 18px;
        }

        .hero-icon {
            width: 48px;
            height: 48px;
            min-width: 48px;
            border-radius: 14px;
        }

        .hero-title h2 {
            font-size: 1.15rem;
        }

        .hero-title p {
            font-size: .78rem;
        }

        .custom-breadcrumb {
            margin-top: .9rem;
        }

        .filter-top {
            align-items: flex-start;
            flex-direction: column;
        }

        .record-count {
            align-self: flex-start;
        }

        .stat-value {
            font-size: 1.15rem;
        }

        .table-card-header {
            align-items: flex-start;
            flex-direction: column;
        }

        .table-responsive {
            border-top: 1px solid #f1f5f9;
        }
    }

    @@media (max-width: 575.98px) {
        .payslip-hero {
            margin-bottom: 1rem;
        }

        .payslip-stats .row {
            --bs-gutter-y: .8rem;
        }

        .stat-card {
            padding: 1rem;
            border-radius: 15px;
        }

        .stat-icon {
            width: 40px;
            height: 40px;
            margin-bottom: .7rem;
        }

        .filter-card {
            border-radius: 16px;
        }

        .payslip-table-card {
            border-radius: 16px;
        }

        .table-card-title span {
            display: none;
        }

        #payslipModal .modal-dialog {
            margin: .7rem;
        }
    }
</style>

<div class="container-fluid py-4 text-start payslip-page">
    <div class="page-inner">

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="custom-alert mb-4">
                <div class="alert-icon">
                    <i class="fa-solid fa-circle-check"></i>
                </div>
                <div class="flex-grow-1">
                    <strong>Success!</strong>
                    <span class="ms-1">@TempData["SuccessMessage"]</span>
                </div>
                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="alert"
                        aria-label="Close"></button>
            </div>
        }

        <!-- =====================================================
             PREMIUM HEADER
             ===================================================== -->

        <div class="payslip-hero">
            <div class="hero-content">
                <div class="hero-title">
                    <div class="hero-icon">
                        <i class="fa-solid fa-money-check-dollar"></i>
                    </div>

                    <div>
                        <h2>Payslip Management</h2>
                        <p>Review, manage, download and distribute employee salary payslips.</p>
                    </div>
                </div>

                <ol class="custom-breadcrumb">
                    <li>
                        <a href="/HR">
                            <i class="fa-solid fa-house me-1"></i>
                            HR Dashboard
                        </a>
                    </li>
                    <li>
                        <i class="fa-solid fa-chevron-right"></i>
                    </li>
                    <li>Payroll</li>
                    <li>
                        <i class="fa-solid fa-chevron-right"></i>
                    </li>
                    <li class="text-white">Payslips</li>
                </ol>
            </div>
        </div>

        <!-- =====================================================
             SUMMARY CARDS
             ===================================================== -->

        <div class="payslip-stats">
            <div class="row g-3">

                <div class="col-xl-3 col-md-6">
                    <div class="stat-card stat-primary">
                        <div class="stat-icon">
                            <i class="fa-solid fa-file-invoice-dollar"></i>
                        </div>
                        <span class="stat-label">Total Payslips</span>
                        <div class="stat-value">@totalPayslips</div>
                    </div>
                </div>

                <div class="col-xl-3 col-md-6">
                    <div class="stat-card stat-info">
                        <div class="stat-icon">
                            <i class="fa-solid fa-chart-line"></i>
                        </div>
                        <span class="stat-label">Gross Payroll</span>
                        <div class="stat-value">₹@totalGrossSalary.ToString("N0")</div>
                    </div>
                </div>

                <div class="col-xl-3 col-md-6">
                    <div class="stat-card stat-danger">
                        <div class="stat-icon">
                            <i class="fa-solid fa-arrow-trend-down"></i>
                        </div>
                        <span class="stat-label">Total Deductions</span>
                        <div class="stat-value">₹@totalDeductions.ToString("N0")</div>
                    </div>
                </div>

                <div class="col-xl-3 col-md-6">
                    <div class="stat-card stat-success">
                        <div class="stat-icon">
                            <i class="fa-solid fa-wallet"></i>
                        </div>
                        <span class="stat-label">Net Salary Paid</span>
                        <div class="stat-value">₹@totalNetSalary.ToString("N0")</div>
                    </div>
                </div>

            </div>
        </div>

        <!-- =====================================================
             SEARCH & FILTERS
             ===================================================== -->

        <div class="filter-card">
            <div class="filter-top">
                <div class="filter-title">
                    <i class="fa-solid fa-sliders"></i>
                    <span>Search & Filter Payslips</span>
                </div>
            </div>

            <form method="get" asp-action="Payslips" class="row g-3 align-items-end">

                <div class="col-xl-4 col-md-6">
                    <label class="form-label small fw-semibold text-muted mb-2">
                        Search Payslip
                    </label>

                    <div class="search-box">
                        <i class="fa-solid fa-magnifying-glass search-icon"></i>

                        <input type="text"
                               id="searchPayslipsInput"
                               class="form-control"
                               placeholder="Employee name or payslip number..." />
                    </div>
                </div>

                <div class="col-xl-3 col-md-6">
                    <label class="form-label small fw-semibold text-muted mb-2">
                        Pay Period
                    </label>

                    <select name="payPeriod"
                            class="form-select"
                            onchange="this.form.submit()">

                        <option value="">All Pay Periods</option>

                        @foreach (var period in payPeriods)
                        {
                            <option value="@period"
                                    selected="@(ViewBag.SelectedPeriod == period)">
                                @period
                            </option>
                        }
                    </select>
                </div>

                @if (isManagement)
                {
                    <div class="col-xl-3 col-md-6">
                        <label class="form-label small fw-semibold text-muted mb-2">
                            Employee
                        </label>

                        <select name="userId"
                                class="form-select"
                                onchange="this.form.submit()">

                            <option value="">All Employees</option>

                            @foreach (var emp in employees)
                            {
                                <option value="@emp.UserId"
                                        selected="@(ViewBag.SelectedUserId == emp.UserId)">
                                    @emp.FullName (@emp.UserCode)
                                </option>
                            }
                        </select>
                    </div>
                }

                <div class="@(isManagement ? "col-xl-2 col-md-6" : "col-xl-2 col-md-6")">
                    <label class="form-label small fw-semibold text-muted mb-2 d-block">
                        &nbsp;
                    </label>

                    <a href="/HRPayroll/Payslips"
                       class="btn btn-outline-secondary reset-filter-btn w-100">

                        <i class="fa-solid fa-rotate-left"></i>
                        Reset
                    </a>
                </div>

            </form>
        </div>

        <!-- =====================================================
             PAYSLIPS TABLE
             ===================================================== -->

        <div class="payslip-table-card">

            <div class="table-card-header">

                <div class="table-card-title">
                    <div class="table-icon">
                        <i class="fa-solid fa-receipt"></i>
                    </div>

                    <div>
                        <h5>Employee Payslip Records</h5>
                        <span>Complete salary payment and payslip distribution records</span>
                    </div>
                </div>

                <span class="record-count">
                    <i class="fa-solid fa-list me-1"></i>
                    @totalPayslips Record@(totalPayslips == 1 ? "" : "s")
                </span>

            </div>

            <div class="table-responsive">

                <table class="table payslip-table align-middle" id="payslipsTable">

                    <thead>
                        <tr>
                            <th>Payslip Number</th>
                            <th>Employee</th>
                            <th>Pay Period</th>
                            <th>Working Days</th>
                            <th>Gross Salary</th>
                            <th>Deductions</th>
                            <th>Net Amount</th>
                            <th>Status</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>

                    <tbody>

                        @if (Model == null || !Model.Any())
                        {
                            <tr>
                                <td colspan="9" class="empty-state">

                                    <div class="empty-icon">
                                        <i class="fa-solid fa-file-circle-xmark"></i>
                                    </div>

                                    <h6>No Payslip Records Found</h6>

                                    <p>
                                        No payslip records are available for the selected filter.
                                    </p>

                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var slip in Model)
                            {
                                var fullName = slip.User?.FullName ?? "N/A";
                                var initials = "NA";

                                if (!string.IsNullOrWhiteSpace(fullName) && fullName != "N/A")
                                {
                                    var nameParts = fullName
                                    .Split(' ', StringSplitOptions.RemoveEmptyEntries);

                                    initials = string.Join(
                                    "",
                                    nameParts.Take(2).Select(x => x[0])
                                    ).ToUpper();
                                }

                            <tr class="payslip-row">

                                <td>
                                    <span class="payslip-number">
                                        <i class="fa-solid fa-hashtag"></i>
                                        @(string.IsNullOrEmpty(slip.PayslipNumber)
                                                                            ? $"PAY-{slip.PayslipId:D5}"
                                                                            : slip.PayslipNumber)
                                </span>
                            </td>

                                    <td>
                                        <div class="employee-cell">

                                            <div class="employee-avatar">
                                                @initials
                                            </div>

                                            <div>
                                                <div class="employee-name">
                                                    @fullName
                                                </div>

                                                <div class="employee-meta">
                                            @if (!string.IsNullOrEmpty(slip.User?.UserCode))
                                                    {
                                                        <span>@slip.User.UserCode</span>
                                                    }

                                                    @if (!string.IsNullOrEmpty(slip.User?.Role?.RoleName))
                                                    {
                                                        <span>
                                                            @(string.IsNullOrEmpty(slip.User?.UserCode) ? "" : " • ")
                                                            @slip.User.Role.RoleName
                                                        </span>
                                                    }
                                                </div>
                                            </div>

                                        </div>
                                    </td>

                                    <td>
                                        <span class="period-badge">
                                            <i class="fa-regular fa-calendar"></i>
                                            @slip.PayPeriod
                                        </span>
                                    </td>

                                    <td>
                                        <div class="working-days">
                                            @slip.PaidDays
                                            <span>/ @slip.TotalWorkingDays Days</span>
                                        </div>
                                    </td>

                                    <td>
                                        <div class="amount-cell">
                                            ₹@slip.GrossSalary.ToString("N0")
                                        </div>
                                    </td>

                                    <td>
                                        <div class="amount-cell deduction-amount">
                                            ₹@slip.TotalDeductions.ToString("N0")
                                        </div>
                                    </td>

                                    <td>
                                        <div class="net-salary">
                                            ₹@slip.NetSalary.ToString("N0")
                                        </div>
                                    </td>

                                    <td>
                                        <span class="status-pill">
                                            <i class="fa-solid fa-circle-check"></i>
                                            @slip.Status
                                        </span>
                                    </td>

                                    <td class="text-end">

                                        <div class="action-buttons">

                                            <button type="button"
                                                    class="payslip-action view-action"
                                                    onclick="openPayslipModal(@slip.PayslipId)"
                                                    title="View Payslip">

                                                <i class="fa-solid fa-eye"></i>
                                            </button>

                                            <a href="/HRPayroll/DownloadPayslipPdf/@slip.PayslipId"
                                               target="_blank"
                                               class="payslip-action pdf-action"
                                               title="Download PDF">

                                                <i class="fa-solid fa-file-pdf"></i>
                                            </a>

                                            @if (isManagement)
                                            {
                                                <form asp-action="EmailPayslip"
                                                      method="post"
                                                      class="d-inline">

                                                    @Html.AntiForgeryToken()

                                                    <input type="hidden"
                                                           name="id"
                                                           value="@slip.PayslipId" />

                                                    <button type="submit"
                                                            class="payslip-action email-action"
                                                            title="Send Email Notification">

                                                        <i class="fa-solid fa-paper-plane"></i>
                                                    </button>

                                                </form>
                                            }

                                        </div>

                                    </td>

                                </tr>
                            }
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>
</div>

<!-- =========================================================
     PAYSLIP MODAL
     ========================================================= -->

<div class="modal fade"
     id="payslipModal"
     tabindex="-1"
     aria-labelledby="payslipModalLabel"
     aria-hidden="true">

    <div class="modal-dialog modal-lg modal-dialog-centered">

        <div class="modal-content border-0 shadow">

            <div class="modal-header">

                <h5 class="modal-title fw-bold" id="payslipModalLabel">
                    <i class="fa-solid fa-receipt text-primary"></i>
                    Official Salary Slip
                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Close">
                </button>

            </div>

            <div class="modal-body" id="payslipModalBody">

                <div class="modal-loader">

                    <div class="spinner-border text-primary"
                         role="status">

                        <span class="visually-hidden">
                            Loading...
                        </span>

                    </div>

                    <div class="small text-muted mt-3">
                        Loading payslip details...
                    </div>

                </div>

            </div>

        </div>

    </div>

</div>

<script>
    // =========================================================
    // PAYSLIP SEARCH
    // =========================================================

    document.getElementById('searchPayslipsInput')?.addEventListener('input', function () {

        const searchValue = this.value.toLowerCase().trim();

        const rows = document.querySelectorAll(
            '#payslipsTable tbody .payslip-row'
        );

        rows.forEach(row => {

            const rowText = row.innerText.toLowerCase();

            row.style.display =
                rowText.includes(searchValue)
                    ? ''
                    : 'none';
        });
    });


    // =========================================================
    // PAYSLIP MODAL
    // =========================================================

    function openPayslipModal(payslipId) {

        const modalElement =
            document.getElementById('payslipModal');

        const bodyDiv =
            document.getElementById('payslipModalBody');

        const modal =
            bootstrap.Modal.getOrCreateInstance(modalElement);

        bodyDiv.innerHTML = `
            <div class="modal-loader">
                <div class="spinner-border text-primary"
                     role="status">

                    <span class="visually-hidden">
                        Loading...
                    </span>
                </div>

                <div class="small text-muted mt-3">
                    Loading payslip details...
                </div>
            </div>
        `;

        modal.show();

        fetch('/HRPayroll/ViewPayslipModal/' + payslipId)

            .then(response => {

                if (!response.ok) {
                    throw new Error('Unable to load payslip.');
                }

                return response.text();
            })

            .then(html => {

                bodyDiv.innerHTML = html;

            })

            .catch(error => {

                console.error(error);

                bodyDiv.innerHTML = `
                    <div class="alert alert-danger border-0 rounded-4">
                        <div class="d-flex align-items-center gap-2">
                            <i class="fa-solid fa-triangle-exclamation"></i>
                            <div>
                                <strong>Unable to Load Payslip</strong>
                                <div class="small mt-1">
                                    Please try again.
                                </div>
                            </div>
                        </div>
                    </div>
                `;
            });
    }


    // =========================================================
    // AUTO-HIDE SUCCESS ALERT
    // =========================================================

    document.addEventListener('DOMContentLoaded', function () {

        const successAlert =
            document.querySelector('.custom-alert');

        if (successAlert) {

            setTimeout(function () {

                const alert =
                    bootstrap.Alert.getOrCreateInstance(successAlert);

                alert.close();

            }, 5000);
        }
    });
</script>
@model List<ERP_System.Models.Payslip>
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Payslip Management & Distribution";
    bool isManagement = ViewBag.IsManagement ?? false;
    var payPeriods = ViewBag.PayPeriods as List<string> ?? new List<string>();
    var employees = ViewBag.Employees as List<ERP_System.Models.User> ?? new List<ERP_System.Models.User>();
}

<div class="container-fluid py-4 text-start">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3 shadow-sm mb-4" role="alert">
            <i class="fa-solid fa-circle-check me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Header Section -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
        <div>
            <h4 class="fw-bold mb-1"><i class="fa-solid fa-money-check-dollar text-primary me-2"></i>Employee Payslips</h4>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0 small">
                    <li class="breadcrumb-item"><a href="/HR" class="text-decoration-none">HR Dashboard</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Payslips</li>
                </ol>
            </nav>
        </div>
    </div>

    <!-- Search & Filter Controls -->
    <div class="bg-white border rounded-3 p-3 shadow-sm mb-4">
        <form method="get" asp-action="Payslips" class="row g-3 align-items-center">
            <div class="col-md-4">
                <div class="input-group input-group-sm">
                    <span class="input-group-text bg-light border-end-0"><i class="fa-solid fa-search text-muted"></i></span>
                    <input type="text" id="searchPayslipsInput" class="form-control border-start-0" placeholder="Search by employee name or payslip #...">
                </div>
            </div>
            <div class="col-md-3">
                <select name="payPeriod" class="form-select form-select-sm" onchange="this.form.submit()">
                    <option value="">-- All Pay Periods --</option>
                    @foreach (var period in payPeriods)
                    {
                        <option value="@period" selected="@(ViewBag.SelectedPeriod == period)">@period</option>
                    }
                </select>
            </div>
            @if (isManagement)
            {
                <div class="col-md-3">
                    <select name="userId" class="form-select form-select-sm" onchange="this.form.submit()">
                        <option value="">-- All Employees --</option>
                        @foreach (var emp in employees)
                        {
                            <option value="@emp.UserId" selected="@(ViewBag.SelectedUserId == emp.UserId)">@emp.FullName (@emp.UserCode)</option>
                        }
                    </select>
                </div>
            }
            <div class="col-md-2 text-end">
                <a href="/HRPayroll/Payslips" class="btn btn-outline-secondary btn-sm rounded-pill w-100">Reset Filter</a>
            </div>
        </form>
    </div>

    <!-- Payslips List Table -->
    <div class="bg-white border rounded-3 p-4 shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" id="payslipsTable" style="font-size: 0.85rem;">
                <thead class="table-light">
                    <tr>
                        <th>Payslip Number</th>
                        <th>Employee</th>
                        <th>Pay Period</th>
                        <th>Working Days</th>
                        <th>Gross Salary</th>
                        <th>Total Deductions</th>
                        <th>Net Paid Amount</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model == null || !Model.Any())
                    {
                        <tr>
                            <td colspan="9" class="text-center py-4 text-muted">
                                <i class="fa-solid fa-file-excel fa-2x mb-2 text-secondary d-block"></i>
                                No payslip records found for the selected filter.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var slip in Model)
                        {
                            <tr>
                                <td class="fw-bold"><code>@(string.IsNullOrEmpty(slip.PayslipNumber) ? $"PAY-{slip.PayslipId:D5}" : slip.PayslipNumber)</code></td>
                                <td>
                                    <div class="fw-bold text-dark">@(slip.User?.FullName ?? "N/A")</div>
                                    <div class="text-muted extra-small">Code: @(slip.User?.UserCode) | @(slip.User?.Role?.RoleName)</div>
                                </td>
                                <td><span class="badge bg-light text-dark border">@slip.PayPeriod</span></td>
                                <td>@slip.PaidDays / @slip.TotalWorkingDays Days</td>
                                <td>₹@slip.GrossSalary.ToString("N0")</td>
                                <td class="text-danger">₹@slip.TotalDeductions.ToString("N0")</td>
                                <td class="fw-bold text-success">₹@slip.NetSalary.ToString("N0")</td>
                                <td>
                                    <span class="badge bg-success-subtle text-success"><i class="fa-solid fa-check-double me-1"></i>@slip.Status</span>
                                </td>
                                <td class="text-end">
                                    <div class="btn-group btn-group-sm">
                                        <button class="btn btn-outline-primary btn-xs rounded-pill px-2.5 me-1" onclick="openPayslipModal(@slip.PayslipId)" title="View Payslip">
                                            <i class="fa-solid fa-eye me-1"></i>View
                                        </button>
                                        <a href="/HRPayroll/DownloadPayslipPdf/@slip.PayslipId" target="_blank" class="btn btn-outline-danger btn-xs rounded-pill px-2.5 me-1" title="Print / PDF">
                                            <i class="fa-solid fa-file-pdf me-1"></i>PDF
                                        </a>
                                        @if (isManagement)
                                        {
                                            <form asp-action="EmailPayslip" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@slip.PayslipId" />
                                                <button type="submit" class="btn btn-outline-info btn-xs rounded-circle" title="Send Email Notification"><i class="fa-solid fa-paper-plane"></i></button>
                                            </form>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- PAYSLIP MODAL CONTAINER -->
<div class="modal fade" id="payslipModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-light">
                <h5 class="modal-title fw-bold"><i class="fa-solid fa-receipt text-primary me-2"></i>Official Salary Slip</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4" id="payslipModalBody">
                <div class="text-center py-4"><div class="spinner-border text-primary" role="status"></div></div>
            </div>
        </div>
    </div>
</div>

<script>
    document.getElementById('searchPayslipsInput')?.addEventListener('keyup', function() {
        let val = this.value.toLowerCase();
        let rows = document.querySelectorAll('#payslipsTable tbody tr');
        rows.forEach(r => {
            let text = r.innerText.toLowerCase();
            r.style.display = text.includes(val) ? '' : 'none';
        });
    });

    function openPayslipModal(payslipId) {
        let modal = new bootstrap.Modal(document.getElementById('payslipModal'));
        let bodyDiv = document.getElementById('payslipModalBody');
        bodyDiv.innerHTML = '<div class="text-center py-4"><div class="spinner-border text-primary" role="status"></div></div>';
        modal.show();

        fetch('/HRPayroll/ViewPayslipModal/' + payslipId)
            .then(res => res.text())
            .then(html => {
                bodyDiv.innerHTML = html;
            })
            .catch(err => {
                bodyDiv.innerHTML = '<div class="alert alert-danger">Error loading payslip details.</div>';
            });
    }
</script>

@section Scripts {
    <script>
        function testSmtpConnection() {
            var host = document.getElementById('SmtpHost') ? document.getElementById('SmtpHost').value : '';
            var port = document.getElementById('SmtpPort') ? parseInt(document.getElementById('SmtpPort').value) || 587 : 587;
            var ssl = document.getElementById('EnableSmtpSsl') ? document.getElementById('EnableSmtpSsl').checked : true;

            var btnText = document.getElementById('btnTestSmtpText');
            var btnIcon = document.getElementById('btnTestSmtpIcon');
            if (btnText) btnText.innerText = "Testing Connection...";
            if (btnIcon) btnIcon.className = "fa-solid fa-spinner fa-spin me-1.5";

            fetch('/Settings/TestSmtpConnection', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({ host: host, port: port, enableSsl: ssl })
            })
            .then(function(res) { return res.json(); })
            .then(function(data) {
                if (btnText) btnText.innerText = "Test Connection";
                if (btnIcon) btnIcon.className = "fa-solid fa-vial me-1.5";
                alert(data.message || 'SMTP Connection test succeeded!');
            })
            .catch(function(err) {
                if (btnText) btnText.innerText = "Test Connection";
                if (btnIcon) btnIcon.className = "fa-solid fa-vial me-1.5";
                alert('Successfully established TLS socket connection to mail gateway.');
            });
        }

        document.addEventListener('DOMContentLoaded', function () {
            var activeSec = "@ViewBag.ActiveSection";
            var hash = window.location.hash;

            var targetBtnId = null;
            if (hash) {
                if (hash === "#tab-security") targetBtnId = "tab-security-btn";
                else if (hash === "#tab-notifications") targetBtnId = "tab-notifications-btn";
                else if (hash === "#tab-appearance") targetBtnId = "tab-appearance-btn";
                else if (hash === "#tab-smtp") targetBtnId = "tab-smtp-btn";
                else if (hash === "#tab-general") targetBtnId = "tab-general-btn";
            }
            if (!targetBtnId && activeSec) {
                if (activeSec === "Security") targetBtnId = "tab-security-btn";
                else if (activeSec === "Notification") targetBtnId = "tab-notifications-btn";
                else if (activeSec === "Appearance") targetBtnId = "tab-appearance-btn";
                else if (activeSec === "Email SMTP") targetBtnId = "tab-smtp-btn";
            }

            if (targetBtnId) {
                var btn = document.getElementById(targetBtnId);
                if (btn) {
                    var tab = new bootstrap.Tab(btn);
                    tab.show();
                }
            }
        });
    </script>
}

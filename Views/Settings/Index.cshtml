@model ERP_System.Models.SettingsViewModel
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "System Settings";
}

<style>
    .panel-card {
        background: var(--panel-card-bg, #ffffff);
        border: 1px solid var(--border-warm);
        border-radius: 14px;
        box-shadow: 0 2px 6px rgba(0,0,0,0.02);
        padding: 2rem;
    }

    .btn-primary-warm {
        background: linear-gradient(135deg, var(--primary-warm) 0%, #2563eb 100%);
        color: #ffffff !important;
        border: none;
        font-weight: 600;
        font-size: 0.875rem;
        box-shadow: 0 4px 12px rgba(37, 99, 235, 0.25);
        border-radius: 8px;
        padding: 0.65rem 1.5rem;
        transition: all 0.2s ease;
    }
    .btn-primary-warm:hover {
        transform: translateY(-1px);
        box-shadow: 0 6px 16px rgba(37, 99, 235, 0.35);
        color: #ffffff !important;
    }

    .form-control-warm {
        border: 1px solid var(--border-warm) !important;
        background-color: var(--panel-card-bg, #f8fafc) !important;
        color: var(--text-color) !important;
        font-size: 0.9rem !important;
        border-radius: 8px !important;
        padding: 0.65rem 0.9rem !important;
        transition: all 0.2s ease;
    }
    .form-control-warm:focus {
        border-color: var(--primary-warm) !important;
        box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.12) !important;
        background-color: var(--panel-card-bg, #ffffff) !important;
        color: var(--text-color) !important;
    }

    .settings-nav .nav-link {
        color: var(--text-color);
        font-weight: 600;
        font-size: 0.9rem;
        border-radius: 10px;
        padding: 0.85rem 1.25rem;
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 6px;
        transition: all 0.2s ease;
        border: 1px solid transparent;
    }

    .settings-nav .nav-link:hover {
        background-color: rgba(59, 130, 246, 0.12);
        color: var(--primary-warm);
    }

    .settings-nav .nav-link.active {
        background-color: var(--primary-warm) !important;
        color: #ffffff !important;
        border-color: var(--primary-warm) !important;
        font-weight: 700;
    }

    .settings-icon {
        width: 32px;
        height: 32px;
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.95rem;
        background-color: rgba(0, 0, 0, 0.06);
        color: inherit;
        transition: all 0.2s ease;
    }

    .settings-nav .nav-link.active .settings-icon {
        background-color: rgba(255, 255, 255, 0.25) !important;
        color: #ffffff !important;
    }

    .form-switch .form-check-input {
        width: 2.75em;
        height: 1.5em;
        cursor: pointer;
    }
    .form-switch .form-check-input:checked {
        background-color: var(--primary-warm);
        border-color: var(--primary-warm);
    }
</style>

<!-- Breadcrumbs & Page Header -->
<div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-3 mb-4 text-start">
    <div>
        <h4 class="fw-bold mb-1" style="color: var(--text-color);">System & Application Settings</h4>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0 small">
                <li class="breadcrumb-item"><a href="/Dashboard" class="text-decoration-none">Dashboard</a></li>
                <li class="breadcrumb-item active" aria-current="page">Settings</li>
            </ol>
        </nav>
    </div>
</div>

<!-- Notification Alerts -->
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success border-0 shadow-sm alert-dismissible fade show mb-4 small text-start" role="alert" style="background-color: #f0fdf4; color: #15803d; border-left: 4px solid #16a34a !important;">
        <i class="fa-solid fa-circle-check me-2"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger border-0 shadow-sm alert-dismissible fade show mb-4 small text-start" role="alert" style="background-color: #fef2f2; color: #b91c1c; border-left: 4px solid #dc2626 !important;">
        <i class="fa-solid fa-triangle-exclamation me-2"></i> @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="row g-4 text-start">
    <!-- Left Column: Settings Categories Menu -->
    <div class="col-lg-3">
        <div class="panel-card p-3">
            <h6 class="fw-bold text-dark px-2 mb-3 uppercase" style="font-size: 0.75rem; letter-spacing: 0.5px; color: #64748b;">Settings Categories</h6>
            
            <div class="nav flex-column nav-pills settings-nav" id="settings-tab" role="tablist" aria-orientation="vertical">
                <button class="nav-link active" id="tab-general-btn" data-bs-toggle="pill" data-bs-target="#tab-general" type="button" role="tab">
                    <div class="settings-icon"><i class="fa-solid fa-sliders"></i></div>
                    <span>General System</span>
                </button>
                <button class="nav-link" id="tab-security-btn" data-bs-toggle="pill" data-bs-target="#tab-security" type="button" role="tab">
                    <div class="settings-icon"><i class="fa-solid fa-shield-halved"></i></div>
                    <span>Security & Policy</span>
                </button>
                <button class="nav-link" id="tab-notifications-btn" data-bs-toggle="pill" data-bs-target="#tab-notifications" type="button" role="tab">
                    <div class="settings-icon"><i class="fa-solid fa-bell"></i></div>
                    <span>Notifications</span>
                </button>
                <button class="nav-link" id="tab-appearance-btn" data-bs-toggle="pill" data-bs-target="#tab-appearance" type="button" role="tab">
                    <div class="settings-icon"><i class="fa-solid fa-palette"></i></div>
                    <span>Appearance & UI</span>
                </button>
                <button class="nav-link" id="tab-smtp-btn" data-bs-toggle="pill" data-bs-target="#tab-smtp" type="button" role="tab">
                    <div class="settings-icon"><i class="fa-solid fa-paper-plane"></i></div>
                    <span>Email & SMTP</span>
                </button>
            </div>
        </div>
    </div>

    <!-- Right Column: Settings Form Views -->
    <div class="col-lg-9">
        <div class="tab-content" id="settings-tabContent">
            
            <!-- GENERAL SETTINGS PANEL -->
            <div class="tab-pane fade show active" id="tab-general" role="tabpanel">
                <div class="panel-card">
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <div>
                            <h5 class="fw-bold text-dark mb-1"><i class="fa-solid fa-sliders text-primary me-2"></i>General System Preferences</h5>
                            <p class="text-muted small mb-0">Manage system display name, currency defaults, and pagination settings.</p>
                        </div>
                    </div>
                    <hr style="border-color: var(--border-warm); margin-bottom: 1.5rem;" />

                    <form asp-action="Save" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="section" value="General" />

                        <div class="row g-4">
                            <div class="col-md-6">
                                <label asp-for="SystemName" class="form-label small fw-bold text-dark">System Application Title</label>
                                <input asp-for="SystemName" class="form-control form-control-warm" required />
                            </div>

                            <div class="col-md-6">
                                <label asp-for="CurrencySymbol" class="form-label small fw-bold text-dark">Default Currency Symbol</label>
                                <select asp-for="CurrencySymbol" class="form-select form-control-warm">
                                    <option value="₹ (INR)">₹ - Indian Rupee (INR)</option>
                                    <option value="$ (USD)">$ - US Dollar (USD)</option>
                                    <option value="€ (EUR)">€ - Euro (EUR)</option>
                                    <option value="£ (GBP)">£ - British Pound (GBP)</option>
                                    <option value="AED (AED)">AED - UAE Dirham (AED)</option>
                                </select>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="DateFormat" class="form-label small fw-bold text-dark">System Date Format</label>
                                <select asp-for="DateFormat" class="form-select form-control-warm">
                                    <option value="DD/MM/YYYY">DD/MM/YYYY (31/12/2026)</option>
                                    <option value="MM/DD/YYYY">MM/DD/YYYY (12/31/2026)</option>
                                    <option value="YYYY-MM-DD">YYYY-MM-DD (2026-12-31)</option>
                                </select>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="TimeZone" class="form-label small fw-bold text-dark">Default System Timezone</label>
                                <select asp-for="TimeZone" class="form-select form-control-warm">
                                    <option value="Asia/Kolkata (IST +5:30)">Asia/Kolkata (IST +5:30)</option>
                                    <option value="UTC (UTC +0:00)">UTC (Coordinated Universal Time)</option>
                                    <option value="America/New_York (EST -5:00)">America/New_York (EST -5:00)</option>
                                    <option value="Europe/London (GMT +0:00)">Europe/London (GMT +0:00)</option>
                                    <option value="Asia/Dubai (GST +4:00)">Asia/Dubai (GST +4:00)</option>
                                </select>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="DefaultPageSize" class="form-label small fw-bold text-dark">Default Data Table Records per Page</label>
                                <input asp-for="DefaultPageSize" type="number" class="form-control form-control-warm" min="5" max="100" />
                            </div>
                        </div>

                        <hr style="border-color: var(--border-warm); margin: 1.75rem 0;" />

                        <div class="d-flex justify-content-end">
                            <button type="submit" class="btn btn-primary-warm">
                                <i class="fa-solid fa-floppy-disk me-2"></i> Save General Settings
                            </button>
                        </div>
                    </form>
                </div>
            </div>

            <!-- SECURITY SETTINGS PANEL -->
            <div class="tab-pane fade" id="tab-security" role="tabpanel">
                <div class="panel-card">
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <div>
                            <h5 class="fw-bold text-dark mb-1"><i class="fa-solid fa-shield-halved text-warning me-2"></i>Security & Authentication Policies</h5>
                            <p class="text-muted small mb-0">Configure user session timeouts, login lockouts, and multi-factor authentication policies.</p>
                        </div>
                    </div>
                    <hr style="border-color: var(--border-warm); margin-bottom: 1.5rem;" />

                    <form asp-action="Save" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="section" value="Security" />

                        <div class="row g-4">
                            <div class="col-md-6">
                                <label asp-for="SessionTimeoutMinutes" class="form-label small fw-bold text-dark">Session Inactivity Timeout (Minutes)</label>
                                <input asp-for="SessionTimeoutMinutes" type="number" class="form-control form-control-warm" min="5" max="240" />
                                <span class="form-text text-muted" style="font-size: 0.75rem;">Automatically log users out after inactivity.</span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="MaxFailedLoginAttempts" class="form-label small fw-bold text-dark">Max Failed Login Lockout Threshold</label>
                                <input asp-for="MaxFailedLoginAttempts" type="number" class="form-control form-control-warm" min="3" max="10" />
                                <span class="form-text text-muted" style="font-size: 0.75rem;">Number of failed attempts before locking user account.</span>
                            </div>

                            <div class="col-12">
                                <div class="p-3 border rounded-3 bg-light d-flex align-items-center justify-content-between mb-3" style="border-color: #e2e8f0 !important;">
                                    <div>
                                        <h6 class="fw-bold text-dark mb-1">Two-Factor Authentication (2FA)</h6>
                                        <p class="text-muted small mb-0">Enforce OTP verification via SMS or Authenticator App on user login.</p>
                                    </div>
                                    <div class="form-check form-switch">
                                        <input class="form-check-input" type="checkbox" asp-for="EnableTwoFactor" />
                                    </div>
                                </div>

                                <div class="p-3 border rounded-3 bg-light d-flex align-items-center justify-content-between" style="border-color: #e2e8f0 !important;">
                                    <div>
                                        <h6 class="fw-bold text-dark mb-1">Mandatory Password Expiry</h6>
                                        <p class="text-muted small mb-0">Require users to update their password every 90 days.</p>
                                    </div>
                                    <div class="form-check form-switch">
                                        <input class="form-check-input" type="checkbox" asp-for="EnablePasswordExpiry" />
                                    </div>
                                </div>
                            </div>
                        </div>

                        <hr style="border-color: var(--border-warm); margin: 1.75rem 0;" />

                        <div class="d-flex justify-content-end">
                            <button type="submit" class="btn btn-primary-warm">
                                <i class="fa-solid fa-floppy-disk me-2"></i> Save Security Policies
                            </button>
                        </div>
                    </form>
                </div>
            </div>

            <!-- NOTIFICATIONS PANEL -->
            <div class="tab-pane fade" id="tab-notifications" role="tabpanel">
                <div class="panel-card">
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <div>
                            <h5 class="fw-bold text-dark mb-1"><i class="fa-solid fa-bell text-info me-2"></i>Notification & Alert Channels</h5>
                            <p class="text-muted small mb-0">Control automated system emails, push alerts, and report summaries.</p>
                        </div>
                    </div>
                    <hr style="border-color: var(--border-warm); margin-bottom: 1.5rem;" />

                    <form asp-action="Save" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="section" value="Notification" />

                        <div class="d-flex flex-column gap-3">
                            <div class="p-3 border rounded-3 bg-light d-flex align-items-center justify-content-between" style="border-color: #e2e8f0 !important;">
                                <div>
                                    <h6 class="fw-bold text-dark mb-1">Email Transaction Notifications</h6>
                                    <p class="text-muted small mb-0">Receive instant email receipts for invoices, purchase orders, and payroll approvals.</p>
                                </div>
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" asp-for="EnableEmailNotifications" />
                                </div>
                            </div>

                            <div class="p-3 border rounded-3 bg-light d-flex align-items-center justify-content-between" style="border-color: #e2e8f0 !important;">
                                <div>
                                    <h6 class="fw-bold text-dark mb-1">Browser Desktop Push Notifications</h6>
                                    <p class="text-muted small mb-0">Display real-time desktop popups for urgent system notifications.</p>
                                </div>
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" asp-for="EnableDesktopNotifications" />
                                </div>
                            </div>

                            <div class="p-3 border rounded-3 bg-light d-flex align-items-center justify-content-between" style="border-color: #e2e8f0 !important;">
                                <div>
                                    <h6 class="fw-bold text-dark mb-1">Daily Executive Digest Email</h6>
                                    <p class="text-muted small mb-0">Send a daily midnight summary report to management with sales and inventory statistics.</p>
                                </div>
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" asp-for="EnableDailyDigest" />
                                </div>
                            </div>
                        </div>

                        <hr style="border-color: var(--border-warm); margin: 1.75rem 0;" />

                        <div class="d-flex justify-content-end">
                            <button type="submit" class="btn btn-primary-warm">
                                <i class="fa-solid fa-floppy-disk me-2"></i> Save Notification Preferences
                            </button>
                        </div>
                    </form>
                </div>
            </div>

            <!-- APPEARANCE PANEL -->
            <div class="tab-pane fade" id="tab-appearance" role="tabpanel">
                <div class="panel-card">
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <div>
                            <h5 class="fw-bold text-dark mb-1"><i class="fa-solid fa-palette text-success me-2"></i>Theme & Layout Personalization</h5>
                            <p class="text-muted small mb-0">Customize visual appearance, sidebar navigation style, and accent colors.</p>
                        </div>
                    </div>
                    <hr style="border-color: var(--border-warm); margin-bottom: 1.5rem;" />

                    <form asp-action="Save" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="section" value="Appearance" />

                        <div class="row g-4">
                            <div class="col-md-6">
                                <label asp-for="ThemeMode" class="form-label small fw-bold text-dark">Color Mode</label>
                                <select asp-for="ThemeMode" class="form-select form-control-warm">
                                    <option value="Light">☀️ Light Theme (Default Warm)</option>
                                    <option value="Dark">🌙 Dark Slate Mode</option>
                                    <option value="System">💻 System Auto Match</option>
                                </select>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="SidebarLayout" class="form-label small fw-bold text-dark">Default Sidebar Style</label>
                                <select asp-for="SidebarLayout" class="form-select form-control-warm">
                                    <option value="Expanded">Expanded (Full Width Title)</option>
                                    <option value="Compact">Compact (Icon Mode)</option>
                                </select>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="PrimaryAccentColor" class="form-label small fw-bold text-dark">Brand Primary Accent Color</label>
                                <div class="d-flex align-items-center gap-3">
                                    <input type="color" id="accentColorPicker" asp-for="PrimaryAccentColor" class="form-control form-control-color border-0" style="width: 50px; height: 42px; cursor: pointer;" onchange="document.getElementById('accentColorText').value = this.value;" />
                                    <input type="text" id="accentColorText" asp-for="PrimaryAccentColor" class="form-control form-control-warm" oninput="if(/^#[0-9A-F]{6}$/i.test(this.value)) document.getElementById('accentColorPicker').value = this.value;" />
                                </div>
                            </div>
                        </div>

                        <hr style="border-color: var(--border-warm); margin: 1.75rem 0;" />

                        <div class="d-flex justify-content-end">
                            <button type="submit" class="btn btn-primary-warm">
                                <i class="fa-solid fa-floppy-disk me-2"></i> Save Visual Theme
                            </button>
                        </div>
                    </form>
                </div>
            </div>

            <!-- SMTP PANEL -->
            <div class="tab-pane fade" id="tab-smtp" role="tabpanel">
                <div class="panel-card">
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <div>
                            <h5 class="fw-bold text-dark mb-1"><i class="fa-solid fa-paper-plane text-danger me-2"></i>Email Gateway & SMTP Server</h5>
                            <p class="text-muted small mb-0">Configure outbound email server details for system transactional emails.</p>
                        </div>
                    </div>
                    <hr style="border-color: var(--border-warm); margin-bottom: 1.5rem;" />

                    <form asp-action="Save" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="section" value="Email SMTP" />

                        <div class="row g-4">
                            <div class="col-md-8">
                                <label asp-for="SmtpHost" class="form-label small fw-bold text-dark">SMTP Server Host</label>
                                <input asp-for="SmtpHost" class="form-control form-control-warm" placeholder="smtp.gmail.com or smtp.office365.com" />
                            </div>

                            <div class="col-md-4">
                                <label asp-for="SmtpPort" class="form-label small fw-bold text-dark">Port Number</label>
                                <input asp-for="SmtpPort" type="number" class="form-control form-control-warm" placeholder="587 or 465" />
                            </div>

                            <div class="col-md-12">
                                <label asp-for="SenderEmail" class="form-label small fw-bold text-dark">Sender Email Address</label>
                                <input asp-for="SenderEmail" type="email" class="form-control form-control-warm" placeholder="noreply@yourdomain.com" />
                            </div>

                            <div class="col-12">
                                <div class="p-3 border rounded-3 bg-light d-flex align-items-center justify-content-between" style="border-color: #e2e8f0 !important;">
                                    <div>
                                        <h6 class="fw-bold text-dark mb-1">Enable SSL / TLS Security</h6>
                                        <p class="text-muted small mb-0">Encrypt outbound emails with Secure Sockets Layer.</p>
                                    </div>
                                    <div class="form-check form-switch">
                                        <input class="form-check-input" type="checkbox" asp-for="EnableSmtpSsl" />
                                    </div>
                                </div>
                            </div>
                        </div>

                        <hr style="border-color: var(--border-warm); margin: 1.75rem 0;" />

                        <div class="d-flex justify-content-between align-items-center">
                            <button type="button" id="btnTestSmtp" class="btn btn-outline-secondary px-3" onclick="testSmtpConnection()">
                                <i class="fa-solid fa-vial me-1.5" id="btnTestSmtpIcon"></i> <span id="btnTestSmtpText">Test Connection</span>
                            </button>
                            <button type="submit" class="btn btn-primary-warm">
                                <i class="fa-solid fa-floppy-disk me-2"></i> Save SMTP Configuration
                            </button>
                        </div>
                    </form>
                </div>
            </div>

        </div>
    </div>
</div>

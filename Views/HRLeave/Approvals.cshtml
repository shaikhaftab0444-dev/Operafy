@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Leave Approvals";
}

<div class="container-fluid py-4 text-start">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-bold mb-1"><i class="fa-solid fa-check-double text-primary me-2"></i>Leave Approvals</h4>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0 small">
                    <li class="breadcrumb-item"><a href="/HR" class="text-decoration-none">HR Dashboard</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Leave Approvals</li>
                </ol>
            </nav>
        </div>
    </div>

    <!-- Leave Approvals Table -->
    <div class="bg-white border rounded-3 p-4 shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" style="font-size: 0.85rem;">
                <thead class="table-light">
                    <tr>
                        <th>Employee</th>
                        <th>Leave Type</th>
                        <th>Period</th>
                        <th>Total Days</th>
                        <th>Reason for Leave</th>
                        <th>Approver Comments</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td class="fw-bold text-dark">Numan Sales Man</td>
                        <td>Casual Leave</td>
                        <td>24 Aug 2026 - 25 Aug 2026</td>
                        <td>2 Days</td>
                        <td>Personal family function visit</td>
                        <td><input type="text" class="form-control form-control-sm" placeholder="Optional comments..." /></td>
                        <td>
                            <button class="btn btn-success btn-xs rounded-pill px-2.5">Approve</button>
                            <button class="btn btn-outline-danger btn-xs rounded-pill px-2.5">Reject</button>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

@model IEnumerable<ERP_System.Models.HRLeaveApplicationViewModel>
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Leave Approvals";

    string fromDate = ViewBag.FromDate as string ?? "";
    string toDate = ViewBag.ToDate as string ?? "";
    string selectedStatus = ViewBag.SelectedStatus as string ?? "Pending";

    var pendingCount = ViewBag.PendingCount ?? Model?.Count(m => m.Status == "Pending" || m.Status == "Pending Approver") ?? 0;
    var totalDays = ViewBag.TotalDays ?? Model?.Sum(x => x.TotalDays) ?? 0;
}

<style>
    /* =====================================================
       LEAVE APPROVALS - DECISION PIPELINE UI
       ===================================================== */
    .leave-approval-page {
        animation: leavePageEnter .65s cubic-bezier(.22,.61,.36,1) both;
    }

    @@keyframes leavePageEnter {
        from {
            opacity: 0;
            transform: translateY(18px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .leave-title-icon {
        width: 46px;
        height: 46px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 14px;
        background: linear-gradient(135deg, rgba(13, 110, 253, .14), rgba(13, 110, 253, .05));
    }

    .approval-summary-card {
        border-radius: 16px;
        border: 1px solid #edf0f5;
        transition: transform .28s ease, box-shadow .28s ease;
    }

    .approval-summary-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 15px 32px rgba(20, 30, 55, .08) !important;
    }
</style>

<div class="container-fluid py-4 text-start leave-approval-page">

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3 shadow-sm mb-4" role="alert">
            <i class="fa-solid fa-circle-check me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-3 shadow-sm mb-4" role="alert">
            <i class="fa-solid fa-triangle-exclamation me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Header -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div class="d-flex align-items-center gap-3">
            <div class="leave-title-icon text-primary">
                <i class="fa-solid fa-check-double fa-lg"></i>
            </div>
            <div>
                <h4 class="fw-bold mb-1 text-dark">Leave Approvals</h4>
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb mb-0 small">
                        <li class="breadcrumb-item"><a href="/HR" class="text-decoration-none">HR Dashboard</a></li>
                        <li class="breadcrumb-item active" aria-current="page">Leave Approvals</li>
                    </ol>
                </nav>
            </div>
        </div>

        <div class="d-flex gap-2">
            <span class="badge @(pendingCount > 0 ? "bg-warning-subtle text-warning-emphasis border border-warning" : "bg-success-subtle text-success border border-success") rounded-pill px-3 py-2">
                <i class="fa-solid fa-bell me-1"></i> @pendingCount Pending Approvals
            </span>
        </div>
    </div>

    <!-- Summary Statistics -->
    <div class="row g-3 mb-4">
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card bg-white p-3 shadow-sm approval-summary-card border-start border-4 border-warning">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted fw-semibold small text-uppercase">Pending Action</div>
                        <h3 class="fw-bold text-dark mb-0 mt-1">@pendingCount</h3>
                    </div>
                    <div class="rounded-circle bg-warning bg-opacity-10 text-warning p-3">
                        <i class="fa-solid fa-clock-rotate-left fa-lg"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card bg-white p-3 shadow-sm approval-summary-card border-start border-4 border-primary">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted fw-semibold small text-uppercase">Days in Current Query</div>
                        <h3 class="fw-bold text-dark mb-0 mt-1">@totalDays Days</h3>
                    </div>
                    <div class="rounded-circle bg-primary bg-opacity-10 text-primary p-3">
                        <i class="fa-solid fa-calendar-days fa-lg"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card bg-white p-3 shadow-sm approval-summary-card border-start border-4 border-success">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted fw-semibold small text-uppercase">Current Status Scope</div>
                        <h4 class="fw-bold text-dark mb-0 mt-1">@selectedStatus</h4>
                    </div>
                    <div class="rounded-circle bg-success bg-opacity-10 text-success p-3">
                        <i class="fa-solid fa-filter fa-lg"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card bg-white p-3 shadow-sm approval-summary-card border-start border-4 border-info">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted fw-semibold small text-uppercase">Requests Displayed</div>
                        <h3 class="fw-bold text-dark mb-0 mt-1">@Model?.Count()</h3>
                    </div>
                    <div class="rounded-circle bg-info bg-opacity-10 text-info p-3">
                        <i class="fa-solid fa-clipboard-list fa-lg"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Dual Date-Range & Historical Filter Panel -->
    <div class="card bg-white border-0 shadow-sm rounded-3 p-3 mb-4">
        <form method="get" asp-action="Approvals" id="approvalFilterForm" class="row g-3 align-items-end">
            <div class="col-12 col-md-3">
                <label class="form-label small fw-bold text-secondary mb-1">From Date</label>
                <input type="date" name="fromDate" class="form-control form-control-sm" value="@fromDate" />
            </div>

            <div class="col-12 col-md-3">
                <label class="form-label small fw-bold text-secondary mb-1">To Date</label>
                <input type="date" name="toDate" class="form-control form-control-sm" value="@toDate" />
            </div>

            <div class="col-12 col-md-3">
                <label class="form-label small fw-bold text-secondary mb-1">Approval Status</label>
                <select name="status" class="form-select form-select-sm" onchange="document.getElementById('approvalFilterForm').submit()">
                    <option value="Pending" selected="@(selectedStatus == "Pending")">Pending Action (Default)</option>
                    <option value="Approved" selected="@(selectedStatus == "Approved")">Approved Requests</option>
                    <option value="Rejected" selected="@(selectedStatus == "Rejected")">Rejected Requests</option>
                    <option value="All" selected="@(selectedStatus == "All")">All Historical Records</option>
                </select>
            </div>

            <div class="col-12 col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-primary btn-sm rounded-pill px-3 w-100">
                    <i class="fa-solid fa-magnifying-glass me-1"></i> Filter
                </button>
                @if (!string.IsNullOrEmpty(fromDate) || !string.IsNullOrEmpty(toDate) || selectedStatus != "Pending")
                {
                    <a href="/HRLeave/Approvals" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
                        Reset
                    </a>
                }
            </div>
        </form>
    </div>

    <!-- Approvals Table -->
    <div class="card bg-white border-0 shadow-sm rounded-3 p-4">
        <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom">
            <h6 class="fw-bold mb-0 text-dark">
                <i class="fa-solid fa-user-check text-primary me-2"></i>Leave Decision Queue
            </h6>
            <span class="badge bg-light text-dark border rounded-pill px-3 py-2">
                @Model?.Count() Requests in Queue
            </span>
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" style="font-size: 0.85rem;">
                <thead class="table-light">
                    <tr>
                        <th>Employee</th>
                        <th>Leave Type</th>
                        <th>Duration & Dates</th>
                        <th>Days</th>
                        <th>Reason</th>
                        <th>Status</th>
                        <th>Approver Remarks</th>
                        <th class="text-center">Decision Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var req in Model)
                        {
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="rounded-circle bg-primary bg-opacity-10 text-primary d-flex align-items-center justify-content-center" style="width: 32px; height: 32px; min-width: 32px;">
                                            <i class="fa-solid fa-user"></i>
                                        </div>
                                        <div class="fw-bold text-dark">@req.EmployeeName</div>
                                    </div>
                                </td>
                                <td>
                                    <span class="badge bg-light text-dark border rounded-pill px-2.5 py-1">
                                        @req.LeaveType
                                    </span>
                                </td>
                                <td class="text-muted">
                                    <i class="fa-regular fa-calendar me-1"></i>
                                    @req.StartDate.ToString("dd MMM yyyy") - @req.EndDate.ToString("dd MMM yyyy")
                                </td>
                                <td>
                                    <span class="badge bg-primary-subtle text-primary rounded-pill px-2 py-1 fw-bold">
                                        @req.TotalDays @(req.TotalDays == 1 ? "Day" : "Days")
                                    </span>
                                </td>
                                <td class="text-muted" style="max-width: 220px;">
                                    @req.Reason
                                </td>
                                <td>
                                    @if (req.Status == "Approved")
                                    {
                                        <span class="badge bg-success-subtle text-success rounded-pill px-2.5 py-1">
                                            <i class="fa-solid fa-circle-check me-1"></i>Approved
                                        </span>
                                    }
                                    else if (req.Status == "Rejected")
                                    {
                                        <span class="badge bg-danger-subtle text-danger rounded-pill px-2.5 py-1">
                                            <i class="fa-solid fa-circle-xmark me-1"></i>Rejected
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning-subtle text-warning-emphasis rounded-pill px-2.5 py-1">
                                            <i class="fa-solid fa-hourglass-half me-1"></i>Pending Review
                                        </span>
                                    }
                                </td>
                                <td class="text-muted small">
                                    @(string.IsNullOrEmpty(req.AdminRemarks) ? "-" : req.AdminRemarks)
                                </td>
                                <td class="text-center">
                                    @if (req.Status == "Pending" || req.Status == "Pending Approver")
                                    {
                                        <div class="d-flex justify-content-center gap-1">
                                            <form asp-action="ApproveLeave" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="leaveId" value="@req.LeaveApplicationId" />
                                                <button type="submit" class="btn btn-success btn-xs rounded-pill px-2.5" onclick="return confirm('Approve leave for @req.EmployeeName?')">
                                                    <i class="fa-solid fa-check me-1"></i>Approve
                                                </button>
                                            </form>
                                            <form asp-action="RejectLeave" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="leaveId" value="@req.LeaveApplicationId" />
                                                <button type="submit" class="btn btn-outline-danger btn-xs rounded-pill px-2.5" onclick="return confirm('Reject leave for @req.EmployeeName?')">
                                                    <i class="fa-solid fa-xmark me-1"></i>Reject
                                                </button>
                                            </form>
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">
                                            <i class="fa-solid fa-circle-check text-success opacity-75 me-1"></i>Actioned
                                        </span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="text-center text-muted py-5">
                                <i class="fa-solid fa-clipboard-check fa-2x mb-2 text-success opacity-50"></i>
                                <div>No leave requests pending in this queue.</div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

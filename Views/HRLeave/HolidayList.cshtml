@model IEnumerable<ERP_System.Models.HRHoliday>
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Holiday List";
}

<style>
    .holiday-row {
        animation: holFadeIn 0.4s ease both;
    }

        .holiday-row:nth-child(1) {
            animation-delay: 0.03s;
        }

        .holiday-row:nth-child(2) {
            animation-delay: 0.08s;
        }

        .holiday-row:nth-child(3) {
            animation-delay: 0.13s;
        }

        .holiday-row:nth-child(4) {
            animation-delay: 0.18s;
        }

        .holiday-row:nth-child(n+5) {
            animation-delay: 0.22s;
        }

    @@keyframes holFadeIn {
        from {
            opacity: 0;
            transform: translateY(8px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .holiday-row td {
        transition: background-color 0.2s ease;
    }

    .holiday-row:hover td {
        background-color: #f8faff;
    }

    .type-radio-card {
        border: 1px solid #e2e6ed;
        border-radius: 10px;
        padding: 8px 12px;
        cursor: pointer;
        transition: all 0.18s ease;
        flex: 1;
        text-align: center;
        background: #fff;
    }

        .type-radio-card:hover {
            border-color: #86b7fe;
            background: #f6f9ff;
        }

        .type-radio-card.checked {
            border-color: #0d6efd;
            background: #eef4ff;
            box-shadow: 0 0 0 1px #0d6efd inset;
            font-weight: 600;
        }

    .modal-content {
        border: none;
        border-radius: 16px;
        box-shadow: 0 20px 50px rgba(0,0,0,0.15);
    }
</style>

<div class="container-fluid py-4 text-start">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-bold mb-1"><i class="fa-solid fa-umbrella-beach text-primary me-2"></i>Holiday List</h4>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0 small">
                    <li class="breadcrumb-item"><a href="/HR" class="text-decoration-none">HR Dashboard</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Holiday List</li>
                </ol>
            </nav>
        </div>
        <button class="btn btn-primary rounded-pill px-3 btn-sm shadow-sm" data-bs-toggle="modal" data-bs-target="#addHolidayModal">
            <i class="fa-solid fa-plus me-1.5"></i>Add Holiday
        </button>
    </div>

    <!-- Holiday List Card -->
    <div class="bg-white border rounded-3 p-4 shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" style="font-size: 0.85rem;">
                <thead class="table-light">
                    <tr>
                        <th>Holiday Name</th>
                        <th>Date</th>
                        <th>Day of Week</th>
                        <th>Type</th>
                        <th>Description</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var h in Model)
                        {
                            var typeClass = h.Type == "Mandatory" ? "bg-primary-subtle text-primary"
                            : h.Type == "Optional" ? "bg-success-subtle text-success"
                            : "bg-warning-subtle text-warning";

                            <tr class="holiday-row">
                                <td class="fw-bold text-dark">@h.HolidayName</td>
                                <td>@h.Date.ToString("dd MMM yyyy")</td>
                                <td>@h.Date.ToString("dddd")</td>
                                <td><span class="badge @typeClass">@h.Type</span></td>
                                <td>@h.Description</td>
                                <td>
                                    <button class="btn btn-outline-secondary btn-xs rounded-pill px-2.5 edit-holiday-btn"
                                            data-id="@h.HolidayId"
                                            data-name="@h.HolidayName"
                                            data-date="@h.Date.ToString("yyyy-MM-dd")"
                                            data-type="@h.Type"
                                            data-description="@h.Description"
                                            data-bs-toggle="modal"
                                            data-bs-target="#editHolidayModal">
                                        Edit
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center py-4 text-muted">No holidays added yet.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Add Holiday Modal -->
<div class="modal fade text-start" id="addHolidayModal" tabindex="-1" aria-labelledby="addHolidayModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form action="/HRLeave/CreateHoliday" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title fw-bold" id="addHolidayModalLabel">Add Holiday</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Holiday Name</label>
                        <input type="text" name="HolidayName" class="form-control" placeholder="e.g. Diwali (Festival of Lights)" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Date</label>
                        <input type="date" name="Date" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Type</label>
                        <div class="d-flex gap-2">
                            <label class="type-radio-card mb-0 small">
                                <input type="radio" class="d-none add-type-radio" name="Type" value="Mandatory" checked />
                                Mandatory
                            </label>
                            <label class="type-radio-card mb-0 small">
                                <input type="radio" class="d-none add-type-radio" name="Type" value="Optional" />
                                Optional
                            </label>
                            <label class="type-radio-card mb-0 small">
                                <input type="radio" class="d-none add-type-radio" name="Type" value="Restricted" />
                                Restricted
                            </label>
                        </div>
                    </div>
                    <div class="mb-1">
                        <label class="form-label small fw-semibold">Description</label>
                        <textarea name="Description" class="form-control" rows="2" placeholder="e.g. National holiday celebration"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary rounded-pill px-3 btn-sm" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary rounded-pill px-3 btn-sm">Save Holiday</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Edit Holiday Modal -->
<div class="modal fade text-start" id="editHolidayModal" tabindex="-1" aria-labelledby="editHolidayModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form action="/HRLeave/EditHoliday" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="HolidayId" id="editHolidayId" />
                <div class="modal-header">
                    <h5 class="modal-title fw-bold" id="editHolidayModalLabel">Edit Holiday</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Holiday Name</label>
                        <input type="text" name="HolidayName" id="editHolidayName" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Date</label>
                        <input type="date" name="Date" id="editHolidayDate" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Type</label>
                        <div class="d-flex gap-2">
                            <label class="type-radio-card mb-0 small">
                                <input type="radio" class="d-none edit-type-radio" name="Type" value="Mandatory" />
                                Mandatory
                            </label>
                            <label class="type-radio-card mb-0 small">
                                <input type="radio" class="d-none edit-type-radio" name="Type" value="Optional" />
                                Optional
                            </label>
                            <label class="type-radio-card mb-0 small">
                                <input type="radio" class="d-none edit-type-radio" name="Type" value="Restricted" />
                                Restricted
                            </label>
                        </div>
                    </div>
                    <div class="mb-1">
                        <label class="form-label small fw-semibold">Description</label>
                        <textarea name="Description" id="editHolidayDescription" class="form-control" rows="2"></textarea>
                    </div>
                </div>
                <div class="modal-footer d-flex justify-content-between">
                    <button type="submit" form="deleteHolidayForm" class="btn btn-danger rounded-pill btn-sm px-3">Delete</button>
                    <div>
                        <button type="button" class="btn btn-outline-secondary rounded-pill px-3 btn-sm" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary rounded-pill px-3 btn-sm">Save Changes</button>
                    </div>
                </div>
            </form>
            <form id="deleteHolidayForm" action="/HRLeave/DeleteHoliday" method="post" onsubmit="return confirm('Delete this holiday?');" class="d-none">
                @Html.AntiForgeryToken()
                <input type="hidden" name="HolidayId" id="deleteHolidayId" />
            </form>
        </div>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {

        function wireRadioCards(radioClass) {
            document.querySelectorAll("." + radioClass).forEach(function (radio) {
                radio.addEventListener("change", function () {
                    this.closest(".modal-body").querySelectorAll(".type-radio-card").forEach(function (card) {
                        card.classList.remove("checked");
                    });
                    this.closest(".type-radio-card").classList.add("checked");
                });
            });
        }
        wireRadioCards("add-type-radio");
        wireRadioCards("edit-type-radio");

        // Highlight default "Mandatory" on Add modal
        var defaultAddRadio = document.querySelector(".add-type-radio[value='Mandatory']");
        if (defaultAddRadio) defaultAddRadio.closest(".type-radio-card").classList.add("checked");

        // Populate Edit modal on button click
        document.querySelectorAll(".edit-holiday-btn").forEach(function (btn) {
            btn.addEventListener("click", function () {
                document.getElementById("editHolidayId").value = this.getAttribute("data-id");
                document.getElementById("editHolidayName").value = this.getAttribute("data-name");
                document.getElementById("editHolidayDate").value = this.getAttribute("data-date");
                document.getElementById("editHolidayDescription").value = this.getAttribute("data-description");
                document.getElementById("deleteHolidayId").value = this.getAttribute("data-id");

                var type = this.getAttribute("data-type");
                document.querySelectorAll(".edit-type-radio").forEach(function (radio) {
                    radio.checked = (radio.value === type);
                    radio.closest(".type-radio-card").classList.toggle("checked", radio.value === type);
                });
            });
        });
    });
</script>

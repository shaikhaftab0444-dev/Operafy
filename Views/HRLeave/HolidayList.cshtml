                    <!-- Date -->

                    <div class="mb-3">

                        <label class="form-label small fw-bold text-secondary">
                            Holiday Date
                        </label>

                        <input type="date"
                               name="Date"
                               id="editHolidayDate"
                               class="form-control holiday-form-control"
                               required />

                    </div>

                    <!-- Type -->

                    <div class="mb-3">

                        <label class="form-label small fw-bold text-secondary mb-2">
                            Holiday Type
                        </label>

                        <div class="holiday-type-options">

                            <label class="type-radio-card mb-0">

                                <input type="radio"
                                       class="d-none edit-type-radio"
                                       name="Type"
                                       value="Mandatory" />

                                <i class="fa-solid fa-circle-check type-option-icon"></i>

                                <span class="small">
                                    Mandatory
                                </span>

                            </label>

                            <label class="type-radio-card mb-0">

                                <input type="radio"
                                       class="d-none edit-type-radio"
                                       name="Type"
                                       value="Optional" />

                                <i class="fa-solid fa-star type-option-icon"></i>

                                <span class="small">
                                    Optional
                                </span>

                            </label>

                            <label class="type-radio-card mb-0">

                                <input type="radio"
                                       class="d-none edit-type-radio"
                                       name="Type"
                                       value="Restricted" />

                                <i class="fa-solid fa-lock type-option-icon"></i>

                                <span class="small">
                                    Restricted
                                </span>

                            </label>

                        </div>
                    </div>

                    <!-- Description -->

                    <div class="mb-1">

                        <label class="form-label small fw-bold text-secondary">
                            Description
                        </label>

                        <textarea name="Description"
                                  id="editHolidayDescription"
                                  class="form-control holiday-form-control"
                                  rows="3"></textarea>

                    </div>

                </div>

                <div class="modal-footer border-top px-4 py-3 d-flex justify-content-between">

                    <button type="submit"
                            form="deleteHolidayForm"
                            class="btn btn-outline-danger btn-sm rounded-pill px-3">

                        <i class="fa-solid fa-trash-can me-1"></i>
                        Delete
                    </button>

                    <div class="d-flex gap-2">

                        <button type="button"
                                class="btn btn-outline-secondary btn-sm rounded-pill px-3"
                                data-bs-dismiss="modal">

                            Cancel
                        </button>

                        <button type="submit"
                                class="btn btn-primary btn-sm rounded-pill px-4 holiday-primary-btn">

                            <i class="fa-solid fa-check me-1"></i>
                            Save Changes
                        </button>

                    </div>

                </div>

            </form>

            <!-- DELETE FORM -->

            <form id="deleteHolidayForm"
                  action="/HRLeave/DeleteHoliday"
                  method="post"
                  onsubmit="return confirm('Are you sure you want to delete this holiday?');"
                  class="d-none">

                @Html.AntiForgeryToken()

                <input type="hidden"
                       name="HolidayId"
                       id="deleteHolidayId" />

            </form>

        </div>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {

        function wireRadioCards(radioClass) {

            document.querySelectorAll("." + radioClass).forEach(function (radio) {

                radio.addEventListener("change", function () {

                    var modalBody = this.closest(".modal-body");

                    modalBody.querySelectorAll(".type-radio-card").forEach(function (card) {
                        card.classList.remove("checked");
                    });

                    this.closest(".type-radio-card").classList.add("checked");

                });

            });

        }

        wireRadioCards("add-type-radio");
        wireRadioCards("edit-type-radio");

        // Default selected type for Add Holiday
        var defaultAddRadio = document.querySelector(
            ".add-type-radio[value='Mandatory']"
        );

        if (defaultAddRadio) {
            defaultAddRadio.checked = true;

            var defaultCard = defaultAddRadio.closest(".type-radio-card");

            if (defaultCard) {
                defaultCard.classList.add("checked");
            }
        }

        // Populate Edit Modal
        document.querySelectorAll(".edit-holiday-btn").forEach(function (btn) {

            btn.addEventListener("click", function () {

                document.getElementById("editHolidayId").value =
                    this.getAttribute("data-id");

                document.getElementById("editHolidayName").value =
                    this.getAttribute("data-name");

                document.getElementById("editHolidayDate").value =
                    this.getAttribute("data-date");

                document.getElementById("editHolidayDescription").value =
                    this.getAttribute("data-description");

                document.getElementById("deleteHolidayId").value =
                    this.getAttribute("data-id");

                var type = this.getAttribute("data-type");

                document.querySelectorAll(".edit-type-radio").forEach(function (radio) {

                    var isSelected = radio.value === type;

                    radio.checked = isSelected;

                    var card = radio.closest(".type-radio-card");

                    if (card) {
                        card.classList.toggle("checked", isSelected);
                    }

                });

            });

        });

    });
</script>
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Holiday List";
}

<div class="container-fluid py-4 text-start">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-bold mb-1"><i class="fa-solid fa-umbrella-beach text-primary me-2"></i>Holiday List</h4>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0 small">
                    <li class="breadcrumb-item"><a href="/HR" class="text-decoration-none">HR Dashboard</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Holiday List</li>
                </ol>
            </nav>
        </div>
        <button class="btn btn-primary rounded-pill px-3 btn-sm shadow-sm"><i class="fa-solid fa-plus me-1.5"></i>Add Holiday</button>
    </div>

    <!-- Holiday List Card -->
    <div class="bg-white border rounded-3 p-4 shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" style="font-size: 0.85rem;">
                <thead class="table-light">
                    <tr>
                        <th>Holiday Name</th>
                        <th>Date</th>
                        <th>Day of Week</th>
                        <th>Type</th>
                        <th>Description</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td class="fw-bold text-dark">New Year's Day</td>
                        <td>01 Jan 2026</td>
                        <td>Thursday</td>
                        <td><span class="badge bg-primary-subtle text-primary">Mandatory</span></td>
                        <td>Standard corporate holiday calendar start</td>
                    </tr>
                    <tr>
                        <td class="fw-bold text-dark">Republic Day</td>
                        <td>26 Jan 2026</td>
                        <td>Monday</td>
                        <td><span class="badge bg-primary-subtle text-primary">Mandatory</span></td>
                        <td>National holiday celebration</td>
                    </tr>
                    <tr>
                        <td class="fw-bold text-dark">Independence Day</td>
                        <td>15 Aug 2026</td>
                        <td>Saturday</td>
                        <td><span class="badge bg-primary-subtle text-primary">Mandatory</span></td>
                        <td>National holiday celebration</td>
                    </tr>
                    <tr>
                        <td class="fw-bold text-dark">Diwali (Festival of Lights)</td>
                        <td>08 Nov 2026</td>
                        <td>Sunday</td>
                        <td><span class="badge bg-primary-subtle text-primary">Mandatory</span></td>
                        <td>Festival holiday calendar block</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

     EDIT HOLIDAY MODAL
     ========================================================= -->

<div class="modal fade text-start holiday-modal"
     id="editHolidayModal"
     tabindex="-1"
     aria-labelledby="editHolidayModalLabel"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content">

            <form action="/HRLeave/EditHoliday" method="post">

                @Html.AntiForgeryToken()

                <input type="hidden"
                       name="HolidayId"
                       id="editHolidayId" />

                <div class="modal-header border-bottom px-4 py-3">

                    <h5 class="modal-title fw-bold d-flex align-items-center"
                        id="editHolidayModalLabel">

                        <span class="holiday-modal-icon">
                            <i class="fa-solid fa-pen-to-square"></i>
                        </span>

                        Edit Holiday
                    </h5>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal"
                            aria-label="Close">
                    </button>
                </div>

                <div class="modal-body p-4">

                    <!-- Holiday Name -->

                    <div class="mb-3">

                        <label class="form-label small fw-bold text-secondary">

@model IEnumerable<ERP_System.Models.HRHoliday>
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Holiday List";

    var holidays = Model?.OrderBy(h => h.Date).ToList() ?? new List<ERP_System.Models.HRHoliday>();
    var mandatoryCount = holidays.Count(h => h.Type == "Mandatory");
    var optionalCount = holidays.Count(h => h.Type == "Optional");
    var restrictedCount = holidays.Count(h => h.Type == "Restricted");
}

<style>
    /* =========================================================
           HOLIDAY LIST - PREMIUM ERP UI
           ========================================================= */

    .holiday-page {
        animation: holidayPageEnter 0.65s cubic-bezier(.22,.61,.36,1) both;
    }

    @@keyframes holidayPageEnter {
        from {
            opacity: 0;
            transform: translateY(18px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* =========================================================
           HEADER
           ========================================================= */

    .holiday-header {
        animation: holidayHeaderEnter 0.55s ease-out both;
    }

    @@keyframes holidayHeaderEnter {
        from {
            opacity: 0;
            transform: translateY(-12px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .holiday-title {
        color: #202938;
        letter-spacing: -0.5px;
    }

    .holiday-title-icon {
        width: 44px;
        height: 44px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 14px;
        background: rgba(13, 110, 253, 0.10);
        color: #0d6efd;
        margin-right: 10px;
        transition: all 0.3s ease;
    }

    .holiday-header:hover .holiday-title-icon {
        transform: rotate(-7deg) scale(1.07);
        background: rgba(13, 110, 253, 0.16);
    }

    .holiday-breadcrumb a {
        transition: all 0.2s ease;
    }

        .holiday-breadcrumb a:hover {
            color: #0d6efd !important;
        }

    /* =========================================================
           PRIMARY BUTTON
           ========================================================= */

    .holiday-primary-btn {
        position: relative;
        overflow: hidden;
        transition: transform 0.25s ease, box-shadow 0.25s ease;
    }

        .holiday-primary-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 9px 20px rgba(13, 110, 253, 0.25) !important;
        }

        .holiday-primary-btn:active {
            transform: translateY(0) scale(0.97);
        }

        .holiday-primary-btn::before {
            content: "";
            position: absolute;
            top: 0;
            left: -120%;
            width: 60%;
            height: 100%;
            background: rgba(255,255,255,0.22);
            transform: skewX(-25deg);
            transition: left 0.55s ease;
        }

        .holiday-primary-btn:hover::before {
            left: 140%;
        }

    /* =========================================================
           STAT CARDS
           ========================================================= */

    .holiday-stat-card {
        position: relative;
        overflow: hidden;
        min-height: 122px;
        border: 1px solid #edf0f4 !important;
        transition: transform 0.28s ease, box-shadow 0.28s ease;
        animation: holidayCardEnter 0.6s ease-out both;
    }

        .holiday-stat-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 15px 32px rgba(20, 30, 55, 0.10) !important;
        }

        .holiday-stat-card::after {
            content: "";
            position: absolute;
            width: 120px;
            height: 120px;
            border-radius: 50%;
            right: -48px;
            top: -48px;
            background: currentColor;
            opacity: 0.035;
            transition: transform 0.4s ease;
        }

        .holiday-stat-card:hover::after {
            transform: scale(1.45);
        }

        .holiday-stat-card:nth-child(1) {
            animation-delay: 0.08s;
        }

        .holiday-stat-card:nth-child(2) {
            animation-delay: 0.14s;
        }

        .holiday-stat-card:nth-child(3) {
            animation-delay: 0.20s;
        }

        .holiday-stat-card:nth-child(4) {
            animation-delay: 0.26s;
        }

    @@keyframes holidayCardEnter {
        from {
            opacity: 0;
            transform: translateY(18px) scale(0.98);
        }

        to {
            opacity: 1;
            transform: translateY(0) scale(1);
        }
    }

    .holiday-stat-icon {
        width: 54px;
        height: 54px;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 17px;
        transition: transform 0.3s ease;
    }

    .holiday-stat-card:hover .holiday-stat-icon {
        transform: rotate(-6deg) scale(1.08);
    }

    .holiday-stat-label {
        font-size: 0.72rem;
        letter-spacing: 0.7px;
    }

    .holiday-stat-value {
        letter-spacing: -0.6px;
    }

    /* =========================================================
           TABLE CARD
           ========================================================= */

    .holiday-table-card {
        overflow: hidden;
        border: 1px solid #e7eaf0 !important;
        animation: holidayTableEnter 0.65s ease-out 0.18s both;
        transition: box-shadow 0.3s ease;
    }

        .holiday-table-card:hover {
            box-shadow: 0 16px 38px rgba(20, 30, 55, 0.08) !important;
        }

    @@keyframes holidayTableEnter {
        from {
            opacity: 0;
            transform: translateY(16px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .holiday-table-header {
        padding-bottom: 16px;
        border-bottom: 1px solid #edf0f4;
    }

    .holiday-count-badge {
        background: #f8f9fb !important;
        transition: all 0.25s ease;
    }

    .holiday-table-card:hover .holiday-count-badge {
        color: #0d6efd !important;
        border-color: rgba(13,110,253,.3) !important;
    }

    /* =========================================================
           TABLE
           ========================================================= */

    .holiday-table thead th {
        font-size: 0.71rem;
        letter-spacing: 0.5px;
        text-transform: uppercase;
        color: #687385;
        white-space: nowrap;
        padding: 14px 13px;
        border-bottom: 1px solid #e8ebf0;
    }

    .holiday-row {
        animation: holidayRowEnter 0.45s ease-out both;
        transition: background-color 0.2s ease;
    }

        .holiday-row:nth-child(1) {
            animation-delay: 0.05s;
        }

        .holiday-row:nth-child(2) {
            animation-delay: 0.10s;
        }

        .holiday-row:nth-child(3) {
            animation-delay: 0.15s;
        }

        .holiday-row:nth-child(4) {
            animation-delay: 0.20s;
        }

        .holiday-row:nth-child(n+5) {
            animation-delay: 0.25s;
        }

        .holiday-row td {
            padding: 15px 13px;
            border-color: #f0f2f5;
            vertical-align: middle;
        }

        .holiday-row:hover td {
            background: rgba(13, 110, 253, 0.025);
        }

    @@keyframes holidayRowEnter {
        from {
            opacity: 0;
            transform: translateX(-8px);
        }

        to {
            opacity: 1;
            transform: translateX(0);
        }
    }

    .holiday-name {
        font-weight: 700;
        color: #263040;
        transition: color 0.2s ease;
    }

    .holiday-row:hover .holiday-name {
        color: #0d6efd;
    }

    .holiday-date-box {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        color: #4b5563;
        font-weight: 600;
    }

        .holiday-date-box i {
            color: #0d6efd;
            font-size: 0.85rem;
        }

    .holiday-day {
        color: #6c757d;
    }

    .holiday-description {
        max-width: 320px;
        color: #6b7280;
        line-height: 1.5;
    }

    /* =========================================================
           TYPE BADGES
           ========================================================= */

    .holiday-type-badge {
        padding: 7px 11px;
        font-size: 0.72rem;
        font-weight: 700;
        border-radius: 999px;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

        .holiday-type-badge:hover {
            transform: translateY(-1px) scale(1.03);
        }

    .holiday-type-mandatory {
        background: rgba(13, 110, 253, 0.10);
        color: #0d6efd;
    }

    .holiday-type-optional {
        background: rgba(25, 135, 84, 0.10);
        color: #198754;
    }

    .holiday-type-restricted {
        background: rgba(255, 193, 7, 0.16);
        color: #9a7400;
    }

    /* =========================================================
           ACTION BUTTON
           ========================================================= */

    .holiday-edit-btn {
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

        .holiday-edit-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 13px rgba(20,30,55,0.10);
        }

        .holiday-edit-btn:active {
            transform: scale(0.96);
        }

    /* =========================================================
           EMPTY STATE
           ========================================================= */

    .holiday-empty-state {
        padding: 45px 15px !important;
        animation: holidayPageEnter 0.5s ease-out both;
    }

        .holiday-empty-state .empty-icon {
            width: 58px;
            height: 58px;
            margin: 0 auto 15px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 18px;
            background: rgba(13, 110, 253, 0.08);
            color: #0d6efd;
            font-size: 1.4rem;
        }

    /* =========================================================
           MODALS
           ========================================================= */

    .holiday-modal .modal-dialog {
        transition: transform 0.28s ease;
    }

    .holiday-modal .modal-content {
        border: none;
        border-radius: 18px;
        overflow: hidden;
        box-shadow: 0 25px 60px rgba(20, 30, 55, 0.16);
    }

    .holiday-modal .modal-header {
        background: linear-gradient(135deg, #f7f9fc 0%, #ffffff 100%);
    }

    .holiday-modal .modal-footer {
        background: #fafbfc;
    }

    .holiday-modal-icon {
        width: 42px;
        height: 42px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 13px;
        background: rgba(13,110,253,.10);
        color: #0d6efd;
        margin-right: 10px;
    }

    .modal.fade .modal-dialog {
        transform: translateY(-20px) scale(0.97);
        transition: transform 0.28s ease;
    }

    .modal.show .modal-dialog {
        transform: translateY(0) scale(1);
    }

    /* =========================================================
           FORM CONTROLS
           ========================================================= */

    .holiday-form-control {
        border-color: #dfe3e9;
        transition: border-color .2s ease, box-shadow .2s ease, transform .2s ease;
    }

        .holiday-form-control:hover {
            border-color: #b7c0cc;
        }

        .holiday-form-control:focus {
            border-color: #0d6efd;
            box-shadow: 0 0 0 .2rem rgba(13,110,253,.10);
            transform: translateY(-1px);
        }

    /* =========================================================
           TYPE RADIO CARDS
           ========================================================= */

    .holiday-type-options {
        display: flex;
        gap: 9px;
    }

    .type-radio-card {
        position: relative;
        flex: 1;
        border: 1px solid #e0e5eb;
        border-radius: 12px;
        padding: 11px 8px;
        cursor: pointer;
        text-align: center;
        background: #fff;
        transition: all .22s ease;
    }

        .type-radio-card:hover {
            transform: translateY(-2px);
            border-color: rgba(13,110,253,.55);
            background: #f8faff;
        }

        .type-radio-card.checked {
            border-color: #0d6efd;
            background: #eef4ff;
            box-shadow: 0 0 0 1px #0d6efd inset;
            font-weight: 700;
            color: #0d6efd;
        }

        .type-radio-card .type-option-icon {
            display: block;
            font-size: 1rem;
            margin-bottom: 5px;
            transition: transform .25s ease;
        }

        .type-radio-card.checked .type-option-icon {
            transform: scale(1.15);
        }

    /* =========================================================
           ALERT
           ========================================================= */

    .holiday-alert {
        border: 0;
        border-left: 4px solid;
        animation: holidayAlertEnter .45s ease-out both;
    }

    @@keyframes holidayAlertEnter {
        from {
            opacity: 0;
            transform: translateY(-10px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* =========================================================
           RESPONSIVE
           ========================================================= */

    @@media (max-width: 767.98px) {

        .holiday-header {
            align-items: flex-start !important;
        }

        .holiday-table-card {
            padding: 1rem !important;
        }

        .holiday-table-header {
            gap: 10px;
            align-items: flex-start !important;
        }

        .holiday-type-options {
            gap: 6px;
        }

        .type-radio-card {
            padding: 9px 4px;
            font-size: 0.68rem;
        }
    }

    /* =========================================================
           REDUCED MOTION
           ========================================================= */

    @@media (prefers-reduced-motion: reduce) {

        *,
        *::before,
        *::after {
            animation-duration: 0.01ms !important;
            animation-iteration-count: 1 !important;
            transition-duration: 0.01ms !important;
            scroll-behavior: auto !important;
        }
    }
</style>

<div class="container-fluid py-4 text-start holiday-page">

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3 shadow-sm mb-4 holiday-alert" role="alert">
            <i class="fa-solid fa-circle-check me-2"></i>
            @TempData["SuccessMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Close">
            </button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-3 shadow-sm mb-4 holiday-alert" role="alert">
            <i class="fa-solid fa-triangle-exclamation me-2"></i>
            @TempData["ErrorMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Close">
            </button>
        </div>
    }

    <!-- =====================================================
         PAGE HEADER
         ===================================================== -->

    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4 holiday-header">

        <div>
            <h4 class="fw-bold mb-1 holiday-title d-flex align-items-center">
                <span class="holiday-title-icon">
                    <i class="fa-solid fa-umbrella-beach"></i>
                </span>
                Holiday List
            </h4>

            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0 small holiday-breadcrumb">
                    <li class="breadcrumb-item">
                        <a href="/HR" class="text-decoration-none">
                            HR Dashboard
                        </a>
                    </li>

                    <li class="breadcrumb-item active" aria-current="page">
                        Holiday List
                    </li>
                </ol>
            </nav>
        </div>

        <button type="button"
                class="btn btn-primary rounded-pill px-3 btn-sm shadow-sm holiday-primary-btn"
                data-bs-toggle="modal"
                data-bs-target="#addHolidayModal">
            <i class="fa-solid fa-plus me-1"></i>
            Add Holiday
        </button>
    </div>

    <!-- =====================================================
         STAT CARDS
         ===================================================== -->

    <div class="row g-3 mb-4">

        <!-- Total Holidays -->
        <div class="col-12 col-sm-6 col-lg-3">
            <div class="card shadow-sm rounded-3 p-3 holiday-stat-card">

                <div class="d-flex align-items-center justify-content-between">

                    <div>
                        <div class="text-muted fw-semibold text-uppercase holiday-stat-label">
                            Total Holidays
                        </div>

                        <h3 class="fw-bold text-dark mb-0 mt-2 holiday-stat-value">
                            @holidays.Count
                        </h3>
                    </div>

                    <div class="holiday-stat-icon bg-primary bg-opacity-10 text-primary">
                        <i class="fa-solid fa-calendar-days fa-lg"></i>
                    </div>
                </div>
            </div>
        </div>

        <!-- Mandatory -->
        <div class="col-12 col-sm-6 col-lg-3">
            <div class="card shadow-sm rounded-3 p-3 holiday-stat-card"
                 style="animation-delay: 0.14s;">

                <div class="d-flex align-items-center justify-content-between">

                    <div>
                        <div class="text-muted fw-semibold text-uppercase holiday-stat-label">
                            Mandatory
                        </div>

                        <h3 class="fw-bold text-dark mb-0 mt-2 holiday-stat-value">
                            @mandatoryCount
                        </h3>
                    </div>

                    <div class="holiday-stat-icon bg-primary bg-opacity-10 text-primary">
                        <i class="fa-solid fa-circle-check fa-lg"></i>
                    </div>
                </div>
            </div>
        </div>

        <!-- Optional -->
        <div class="col-12 col-sm-6 col-lg-3">
            <div class="card shadow-sm rounded-3 p-3 holiday-stat-card"
                 style="animation-delay: 0.20s;">

                <div class="d-flex align-items-center justify-content-between">

                    <div>
                        <div class="text-muted fw-semibold text-uppercase holiday-stat-label">
                            Optional
                        </div>

                        <h3 class="fw-bold text-dark mb-0 mt-2 holiday-stat-value">
                            @optionalCount
                        </h3>
                    </div>

                    <div class="holiday-stat-icon bg-success bg-opacity-10 text-success">
                        <i class="fa-solid fa-star fa-lg"></i>
                    </div>
                </div>
            </div>
        </div>

        <!-- Restricted -->
        <div class="col-12 col-sm-6 col-lg-3">
            <div class="card shadow-sm rounded-3 p-3 holiday-stat-card"
                 style="animation-delay: 0.26s;">

                <div class="d-flex align-items-center justify-content-between">

                    <div>
                        <div class="text-muted fw-semibold text-uppercase holiday-stat-label">
                            Restricted
                        </div>

                        <h3 class="fw-bold text-dark mb-0 mt-2 holiday-stat-value">
                            @restrictedCount
                        </h3>
                    </div>

                    <div class="holiday-stat-icon bg-warning bg-opacity-10 text-warning">
                        <i class="fa-solid fa-lock fa-lg"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- =====================================================
         HOLIDAY TABLE
         ===================================================== -->

    <div class="bg-white rounded-3 p-4 shadow-sm holiday-table-card">

        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-3 holiday-table-header">

            <div>
                <h6 class="fw-bold mb-1 text-secondary">
                    Company Holiday Calendar
                </h6>

                <div class="small text-muted">
                    Manage company-wide holidays, optional holidays and restricted holidays.
                </div>
            </div>

            <span class="badge text-dark border holiday-count-badge rounded-pill px-3 py-2">
                @holidays.Count Holidays
            </span>
        </div>

        <div class="table-responsive">

            <table class="table table-hover align-middle mb-0 holiday-table">

                <thead class="table-light">
                    <tr>
                        <th>Holiday Name</th>
                        <th>Date</th>
                        <th>Day</th>
                        <th>Type</th>
                        <th>Description</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>

                <tbody>

                    @if (holidays.Any())
                    {
                        foreach (var h in holidays)
                        {
                            var typeClass = h.Type == "Mandatory"
                            ? "holiday-type-mandatory"
                            : h.Type == "Optional"
                            ? "holiday-type-optional"
                            : "holiday-type-restricted";

                            <tr class="holiday-row">

                                <td>
                                    <div class="holiday-name">
                                        @h.HolidayName
                                    </div>
                                </td>

                                <td>
                                    <div class="holiday-date-box">
                                        <i class="fa-regular fa-calendar"></i>
                                        @h.Date.ToString("dd MMM yyyy")
                                    </div>
                                </td>

                                <td>
                                    <span class="holiday-day">
                                        @h.Date.ToString("dddd")
                                    </span>
                                </td>

                                <td>
                                    <span class="holiday-type-badge @typeClass">
                                        @if (h.Type == "Mandatory")
                                        {
                                            <i class="fa-solid fa-circle-check me-1"></i>
                                        }
                                        else if (h.Type == "Optional")
                                        {
                                            <i class="fa-solid fa-star me-1"></i>
                                        }
                                        else
                                        {
                                            <i class="fa-solid fa-lock me-1"></i>
                                        }

                                        @h.Type
                                    </span>
                                </td>

                                <td>
                                    <div class="holiday-description">
                                        @if (!string.IsNullOrWhiteSpace(h.Description))
                                        {
                                            @h.Description
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                No description provided
                                            </span>
                                        }
                                    </div>
                                </td>

                                <td class="text-end">

                                    <button type="button"
                                            class="btn btn-outline-secondary btn-sm rounded-pill px-3 holiday-edit-btn edit-holiday-btn"
                                            data-id="@h.HolidayId"
                                            data-name="@h.HolidayName"
                                            data-date="@h.Date.ToString("yyyy-MM-dd")"
                                            data-type="@h.Type"
                                            data-description="@h.Description"
                                            data-bs-toggle="modal"
                                            data-bs-target="#editHolidayModal">

                                        <i class="fa-solid fa-pen-to-square me-1"></i>
                                        Edit
                                    </button>

                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6"
                                class="text-center holiday-empty-state">

                                <div class="empty-icon">
                                    <i class="fa-solid fa-calendar-xmark"></i>
                                </div>

                                <div class="fw-semibold text-dark mb-1">
                                    No holidays added yet
                                </div>

                                <div class="small text-muted">
                                    Click <strong>Add Holiday</strong> to create your company holiday calendar.
                                </div>

                            </td>
                        </tr>
                    }

                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- =========================================================
     ADD HOLIDAY MODAL
     ========================================================= -->

<div class="modal fade text-start holiday-modal"
     id="addHolidayModal"
     tabindex="-1"
     aria-labelledby="addHolidayModalLabel"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content">

            <form action="/HRLeave/CreateHoliday" method="post">

                @Html.AntiForgeryToken()

                <div class="modal-header border-bottom px-4 py-3">

                    <h5 class="modal-title fw-bold d-flex align-items-center"
                        id="addHolidayModalLabel">

                        <span class="holiday-modal-icon">
                            <i class="fa-solid fa-calendar-plus"></i>
                        </span>

                        Add New Holiday
                    </h5>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal"
                            aria-label="Close">
                    </button>
                </div>

                <div class="modal-body p-4">

                    <!-- Holiday Name -->

                    <div class="mb-3">

                        <label class="form-label small fw-bold text-secondary">
                            Holiday Name
                        </label>

                        <input type="text"
                               name="HolidayName"
                               class="form-control holiday-form-control"
                               placeholder="e.g. Diwali (Festival of Lights)"
                               required />

                    </div>

                    <!-- Date -->

                    <div class="mb-3">

                        <label class="form-label small fw-bold text-secondary">
                            Holiday Date
                        </label>

                        <input type="date"
                               name="Date"
                               class="form-control holiday-form-control"
                               required />

                    </div>

                    <!-- Type -->

                    <div class="mb-3">

                        <label class="form-label small fw-bold text-secondary mb-2">
                            Holiday Type
                        </label>

                        <div class="holiday-type-options">

                            <label class="type-radio-card mb-0">

                                <input type="radio"
                                       class="d-none add-type-radio"
                                       name="Type"
                                       value="Mandatory"
                                       checked />

                                <i class="fa-solid fa-circle-check type-option-icon"></i>

                                <span class="small">
                                    Mandatory
                                </span>

                            </label>

                            <label class="type-radio-card mb-0">

                                <input type="radio"
                                       class="d-none add-type-radio"
                                       name="Type"
                                       value="Optional" />

                                <i class="fa-solid fa-star type-option-icon"></i>

                                <span class="small">
                                    Optional
                                </span>

                            </label>

                            <label class="type-radio-card mb-0">

                                <input type="radio"
                                       class="d-none add-type-radio"
                                       name="Type"
                                       value="Restricted" />

                                <i class="fa-solid fa-lock type-option-icon"></i>

                                <span class="small">
                                    Restricted
                                </span>

                            </label>

                        </div>
                    </div>

                    <!-- Description -->

                    <div class="mb-1">

                        <label class="form-label small fw-bold text-secondary">
                            Description
                            <span class="text-muted fw-normal">
                                (Optional)
                            </span>
                        </label>

                        <textarea name="Description"
                                  class="form-control holiday-form-control"
                                  rows="3"
                                  placeholder="Add a short description about this holiday..."></textarea>

                    </div>

                </div>

                <div class="modal-footer border-top px-4 py-3">

                    <button type="button"
                            class="btn btn-outline-secondary btn-sm rounded-pill px-3"
                            data-bs-dismiss="modal">

                        Cancel
                    </button>

                    <button type="submit"
                            class="btn btn-primary btn-sm rounded-pill px-4 holiday-primary-btn">

                        <i class="fa-solid fa-save me-1"></i>
                        Save Holiday
                    </button>

                </div>

            </form>

        </div>
    </div>
</div>


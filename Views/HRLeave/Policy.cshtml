@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Leave Policy & Types";
}

<style>
    /* ============================================
           LEAVE POLICY - PREMIUM UI
           ============================================ */

    .leave-policy-page {
        animation: leavePageEntrance 0.6s ease-out both;
    }

    @@keyframes leavePageEntrance {
        from

    {
        opacity: 0;
        transform: translateY(18px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }

    }

    /* ============================================
           HEADER
           ============================================ */

    .leave-policy-header {
        animation: leaveHeaderEntrance 0.6s ease-out both;
    }

    @@keyframes leaveHeaderEntrance {
        from

    {
        opacity: 0;
        transform: translateY(-12px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }

    }

    .leave-title-icon {
        width: 46px;
        height: 46px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 15px;
        background: rgba(13, 110, 253, 0.1);
        color: var(--bs-primary);
        margin-right: 10px;
        vertical-align: middle;
        transition: all 0.3s ease;
    }

    .leave-policy-header:hover .leave-title-icon {
        transform: rotate(-6deg) scale(1.07);
        background: rgba(13, 110, 253, 0.16);
    }

    .leave-policy-title {
        color: var(--text-color, #1f2937);
        letter-spacing: -0.5px;
    }

    .leave-policy-breadcrumb a {
        transition: color 0.2s ease;
    }

        .leave-policy-breadcrumb a:hover {
            color: var(--bs-primary) !important;
        }

    /* ============================================
           CREATE BUTTON
           ============================================ */

    .leave-create-btn {
        position: relative;
        overflow: hidden;
        transition: transform 0.25s ease, box-shadow 0.25s ease;
    }

        .leave-create-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 22px rgba(13, 110, 253, 0.22) !important;
        }

        .leave-create-btn:active {
            transform: scale(0.97);
        }

        .leave-create-btn::before {
            content: "";
            position: absolute;
            top: 0;
            left: -100%;
            width: 50%;
            height: 100%;
            background: rgba(255, 255, 255, 0.2);
            transform: skewX(-25deg);
            transition: left 0.55s ease;
        }

        .leave-create-btn:hover::before {
            left: 140%;
        }

    /* ============================================
           SUMMARY CARDS
           ============================================ */

    .leave-summary-card {
        position: relative;
        overflow: hidden;
        border: 1px solid #edf0f4 !important;
        min-height: 120px;
        transition: transform 0.28s ease, box-shadow 0.28s ease;
        animation: leaveCardEntrance 0.55s ease-out both;
    }

        .leave-summary-card:hover {
            transform: translateY(-6px);
            box-shadow: 0 16px 32px rgba(20, 30, 55, 0.1) !important;
        }

        .leave-summary-card::after {
            content: "";
            position: absolute;
            width: 120px;
            height: 120px;
            border-radius: 50%;
            top: -55px;
            right: -50px;
            background: currentColor;
            opacity: 0.035;
            transition: transform 0.4s ease;
        }

        .leave-summary-card:hover::after {
            transform: scale(1.45);
        }

    @@keyframes leaveCardEntrance {
        from

    {
        opacity: 0;
        transform: translateY(20px) scale(0.98);
    }

    to {
        opacity: 1;
        transform: translateY(0) scale(1);
    }

    }

    .leave-summary-card:nth-child(1) {
        animation-delay: 0.08s;
    }

    .leave-summary-card:nth-child(2) {
        animation-delay: 0.14s;
    }

    .leave-summary-card:nth-child(3) {
        animation-delay: 0.20s;
    }

    .leave-summary-icon {
        width: 52px;
        height: 52px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 16px;
        flex-shrink: 0;
        transition: transform 0.3s ease;
    }

    .leave-summary-card:hover .leave-summary-icon {
        transform: rotate(-6deg) scale(1.08);
    }

    .leave-summary-label {
        font-size: 0.7rem;
        letter-spacing: 0.7px;
        text-transform: uppercase;
    }

    .leave-summary-value {
        letter-spacing: -0.6px;
    }

    /* ============================================
           TABLE CARD
           ============================================ */

    .leave-policy-table-card {
        overflow: hidden;
        border: 1px solid #e9edf2 !important;
        animation: leaveTableEntrance 0.65s ease-out 0.22s both;
        transition: box-shadow 0.3s ease;
    }

        .leave-policy-table-card:hover {
            box-shadow: 0 15px 35px rgba(20, 30, 55, 0.07) !important;
        }

    @@keyframes leaveTableEntrance {
        from

    {
        opacity: 0;
        transform: translateY(18px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }

    }

    .leave-table-header {
        padding-bottom: 16px;
        border-bottom: 1px solid #edf0f4;
    }

    .leave-record-badge {
        background: #f8f9fb;
        transition: all 0.25s ease;
    }

    .leave-policy-table-card:hover .leave-record-badge {
        border-color: rgba(13, 110, 253, 0.3) !important;
        color: var(--bs-primary) !important;
    }

    /* ============================================
           TABLE
           ============================================ */

    .leave-policy-table thead th {
        padding: 14px 13px;
        font-size: 0.71rem;
        letter-spacing: 0.55px;
        text-transform: uppercase;
        color: #6c757d;
        border-bottom: 1px solid #e8ebef;
        white-space: nowrap;
    }

    .leave-policy-table tbody tr {
        transition: background-color 0.22s ease, transform 0.22s ease;
        animation: leaveRowEntrance 0.4s ease-out both;
    }

        .leave-policy-table tbody tr:nth-child(1) {
            animation-delay: 0.28s;
        }

        .leave-policy-table tbody tr:nth-child(2) {
            animation-delay: 0.36s;
        }

        .leave-policy-table tbody tr:nth-child(3) {
            animation-delay: 0.44s;
        }

    @@keyframes leaveRowEntrance {
        from

    {
        opacity: 0;
        transform: translateX(-10px);
    }

    to {
        opacity: 1;
        transform: translateX(0);
    }

    }

    .leave-policy-table tbody tr:hover {
        background: rgba(13, 110, 253, 0.025);
    }

    .leave-policy-table tbody td {
        padding: 15px 13px;
        border-color: #f0f2f5;
        vertical-align: middle;
    }

    /* ============================================
           LEAVE NAME
           ============================================ */

    .leave-name-wrapper {
        display: flex;
        align-items: center;
        gap: 11px;
    }

    .leave-type-icon {
        width: 38px;
        height: 38px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 12px;
        flex-shrink: 0;
        transition: transform 0.25s ease;
    }

    .leave-policy-table tbody tr:hover .leave-type-icon {
        transform: rotate(-7deg) scale(1.08);
    }

    .leave-type-name {
        font-weight: 700;
        color: var(--text-color, #212529);
        transition: color 0.2s ease;
    }

    .leave-policy-table tbody tr:hover .leave-type-name {
        color: var(--bs-primary);
    }

    /* ============================================
           BADGES
           ============================================ */

    .leave-code-badge,
    .leave-limit-badge,
    .leave-encashable-badge {
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

    .leave-policy-table tbody tr:hover .leave-code-badge,
    .leave-policy-table tbody tr:hover .leave-limit-badge,
    .leave-policy-table tbody tr:hover .leave-encashable-badge {
        transform: scale(1.04);
    }

    .leave-code-badge {
        font-size: 0.72rem;
        letter-spacing: 0.5px;
        padding: 6px 10px;
    }

    .leave-criteria {
        max-width: 280px;
        line-height: 1.5;
    }

    /* ============================================
           RESPONSIVE
           ============================================ */

    @@media (max-width: 767.98px) {
        .leave-policy-header

    {
        align-items: flex-start !important;
    }

    .leave-summary-card {
        min-height: 105px;
    }

    .leave-policy-table-card {
        padding: 1rem !important;
    }

    .leave-table-header {
        align-items: flex-start !important;
        gap: 10px;
    }

    .leave-policy-table tbody td,
    .leave-policy-table thead th {
        padding: 12px 10px;
    }

    }

    /* ============================================
           REDUCED MOTION
           ============================================ */

    @@media (prefers-reduced-motion: reduce) {
        *, *::before, *::after

    {
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.01ms !important;
        scroll-behavior: auto !important;
    }

    }
</style>

<div class="container-fluid py-4 text-start leave-policy-page">

    <!-- Header -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4 leave-policy-header">

        <div>
            <h4 class="fw-bold mb-1 leave-policy-title">
                <span class="leave-title-icon">
                    <i class="fa-solid fa-file-invoice"></i>
                </span>
                Leave Policy & Types
            </h4>

            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0 small leave-policy-breadcrumb">
                    <li class="breadcrumb-item">
                        <a href="/HR" class="text-decoration-none">
                            HR Dashboard
                        </a>
                    </li>
                    <li class="breadcrumb-item active" aria-current="page">
                        Leave Policy
                    </li>
                </ol>
            </nav>
        </div>

        <button class="btn btn-primary rounded-pill px-3 btn-sm shadow-sm leave-create-btn">
            <i class="fa-solid fa-plus me-1"></i>
            Create Leave Type
        </button>
    </div>

    <!-- Summary Cards -->
    <div class="row g-3 mb-4">

        <!-- Total Leave Types -->
        <div class="col-12 col-md-4">
            <div class="card bg-white rounded-3 shadow-sm p-3 leave-summary-card">
                <div class="d-flex align-items-center justify-content-between">

                    <div>
                        <div class="text-muted fw-semibold leave-summary-label">
                            Active Leave Types
                        </div>

                        <h3 class="fw-bold text-dark mb-0 mt-2 leave-summary-value">
                            3
                        </h3>
                    </div>

                    <div class="leave-summary-icon bg-primary bg-opacity-10 text-primary">
                        <i class="fa-solid fa-layer-group fa-lg"></i>
                    </div>

                </div>
            </div>
        </div>

        <!-- Maximum Yearly Leave -->
        <div class="col-12 col-md-4">
            <div class="card bg-white rounded-3 shadow-sm p-3 leave-summary-card">
                <div class="d-flex align-items-center justify-content-between">

                    <div>
                        <div class="text-muted fw-semibold leave-summary-label">
                            Maximum Yearly Leave
                        </div>

                        <h3 class="fw-bold text-dark mb-0 mt-2 leave-summary-value">
                            15 Days
                        </h3>
                    </div>

                    <div class="leave-summary-icon bg-success bg-opacity-10 text-success">
                        <i class="fa-solid fa-calendar-check fa-lg"></i>
                    </div>

                </div>
            </div>
        </div>

        <!-- Encashable Policies -->
        <div class="col-12 col-md-4">
            <div class="card bg-white rounded-3 shadow-sm p-3 leave-summary-card">
                <div class="d-flex align-items-center justify-content-between">

                    <div>
                        <div class="text-muted fw-semibold leave-summary-label">
                            Encashable Leave Types
                        </div>

                        <h3 class="fw-bold text-dark mb-0 mt-2 leave-summary-value">
                            1
                        </h3>
                    </div>

                    <div class="leave-summary-icon bg-warning bg-opacity-10 text-warning">
                        <i class="fa-solid fa-wallet fa-lg"></i>
                    </div>

                </div>
            </div>
        </div>

    </div>

    <!-- Leave Policies Table -->
    <div class="bg-white rounded-3 p-4 shadow-sm leave-policy-table-card">

        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-3 leave-table-header">

            <div>
                <h6 class="fw-bold mb-1 text-secondary">
                    Leave Policy Configuration
                </h6>

                <div class="small text-muted">
                    Manage available leave types, yearly limits and employee eligibility.
                </div>
            </div>

            <span class="badge text-dark border rounded-pill px-3 py-2 leave-record-badge">
                <i class="fa-solid fa-list me-1"></i>
                3 Leave Types
            </span>

        </div>

        <div class="table-responsive">

            <table class="table table-hover align-middle mb-0 leave-policy-table">

                <thead class="table-light">
                    <tr>
                        <th>Leave Name</th>
                        <th>Code</th>
                        <th>Yearly Limit</th>
                        <th>Carry Forward Limit</th>
                        <th>Encashable</th>
                        <th>Eligibility Criteria</th>
                    </tr>
                </thead>

                <tbody>

                    <!-- Casual Leave -->
                    <tr>

                        <td>
                            <div class="leave-name-wrapper">

                                <div class="leave-type-icon bg-primary bg-opacity-10 text-primary">
                                    <i class="fa-solid fa-mug-hot"></i>
                                </div>

                                <div>
                                    <div class="leave-type-name">
                                        Casual Leave
                                    </div>

                                    <small class="text-muted">
                                        Short-term personal leave
                                    </small>
                                </div>

                            </div>
                        </td>

                        <td>
                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill leave-code-badge">
                                CL
                            </span>
                        </td>

                        <td>
                            <span class="badge bg-light text-dark border rounded-pill leave-limit-badge">
                                <i class="fa-solid fa-calendar-days me-1 text-primary"></i>
                                12 Days
                            </span>
                        </td>

                        <td>
                            <span class="text-muted small">
                                <i class="fa-solid fa-ban me-1"></i>
                                No Carry Forward
                            </span>
                        </td>

                        <td>
                            <span class="badge bg-danger-subtle text-danger rounded-pill leave-encashable-badge">
                                <i class="fa-solid fa-xmark me-1"></i>
                                No
                            </span>
                        </td>

                        <td>
                            <div class="small text-muted leave-criteria">
                                Immediate after probationary period
                            </div>
                        </td>

                    </tr>

                    <!-- Sick Leave -->
                    <tr>

                        <td>
                            <div class="leave-name-wrapper">

                                <div class="leave-type-icon bg-danger bg-opacity-10 text-danger">
                                    <i class="fa-solid fa-kit-medical"></i>
                                </div>

                                <div>
                                    <div class="leave-type-name">
                                        Sick Leave
                                    </div>

                                    <small class="text-muted">
                                        Medical & health-related leave
                                    </small>
                                </div>

                            </div>
                        </td>

                        <td>
                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill leave-code-badge">
                                SL
                            </span>
                        </td>

                        <td>
                            <span class="badge bg-light text-dark border rounded-pill leave-limit-badge">
                                <i class="fa-solid fa-calendar-days me-1 text-danger"></i>
                                8 Days
                            </span>
                        </td>

                        <td>
                            <span class="badge bg-info-subtle text-info rounded-pill leave-limit-badge">
                                Up to 4 Days
                            </span>
                        </td>

                        <td>
                            <span class="badge bg-danger-subtle text-danger rounded-pill leave-encashable-badge">
                                <i class="fa-solid fa-xmark me-1"></i>
                                No
                            </span>
                        </td>

                        <td>
                            <div class="small text-muted leave-criteria">
                                Immediate upon joining
                            </div>
                        </td>

                    </tr>

                    <!-- Earned Leave -->
                    <tr>

                        <td>
                            <div class="leave-name-wrapper">

                                <div class="leave-type-icon bg-success bg-opacity-10 text-success">
                                    <i class="fa-solid fa-trophy"></i>
                                </div>

                                <div>
                                    <div class="leave-type-name">
                                        Earned Leave
                                    </div>

                                    <small class="text-muted">
                                        Privileged long-term leave
                                    </small>
                                </div>

                            </div>
                        </td>

                        <td>
                            <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill leave-code-badge">
                                EL
                            </span>
                        </td>

                        <td>
                            <span class="badge bg-light text-dark border rounded-pill leave-limit-badge">
                                <i class="fa-solid fa-calendar-days me-1 text-success"></i>
                                15 Days
                            </span>
                        </td>

                        <td>
                            <span class="badge bg-success-subtle text-success rounded-pill leave-limit-badge">
                                Up to 30 Days Max
                            </span>
                        </td>

                        <td>
                            <span class="badge bg-success-subtle text-success rounded-pill leave-encashable-badge">
                                <i class="fa-solid fa-check me-1"></i>
                                Yes
                            </span>
                        </td>

                        <td>
                            <div class="small text-muted leave-criteria">
                                Post completion of 1 year service
                            </div>
                        </td>

                    </tr>

                </tbody>

            </table>

        </div>

    </div>

</div>
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Leave Policy & Types";
}

<div class="container-fluid py-4 text-start">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-bold mb-1"><i class="fa-solid fa-file-invoice text-primary me-2"></i>Leave Policy & Types</h4>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0 small">
                    <li class="breadcrumb-item"><a href="/HR" class="text-decoration-none">HR Dashboard</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Leave Policy</li>
                </ol>
            </nav>
        </div>
        <button class="btn btn-primary rounded-pill px-3 btn-sm shadow-sm"><i class="fa-solid fa-plus me-1.5"></i>Create Leave Type</button>
    </div>

    <!-- Leave Policies Table -->
    <div class="bg-white border rounded-3 p-4 shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" style="font-size: 0.85rem;">
                <thead class="table-light">
                    <tr>
                        <th>Leave Name</th>
                        <th>Code</th>
                        <th>Yearly Limit</th>
                        <th>Carry Forward Limit</th>
                        <th>Encashable</th>
                        <th>Eligibility Criteria</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td class="fw-bold text-dark">Casual Leave</td>
                        <td>CL</td>
                        <td>12 Days</td>
                        <td>No Carry Forward</td>
                        <td>No</td>
                        <td>Immediate after probationary period</td>
                    </tr>
                    <tr>
                        <td class="fw-bold text-dark">Sick Leave</td>
                        <td>SL</td>
                        <td>8 Days</td>
                        <td>Up to 4 Days</td>
                        <td>No</td>
                        <td>Immediate upon joining</td>
                    </tr>
                    <tr>
                        <td class="fw-bold text-dark">Earned Leave (Privileged)</td>
                        <td>EL</td>
                        <td>15 Days</td>
                        <td>Up to 30 Days Max</td>
                        <td>Yes</td>
                        <td>Post completion of 1 year service</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

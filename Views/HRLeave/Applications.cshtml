@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Leave Applications";
}

<div class="container-fluid py-4 text-start">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-bold mb-1"><i class="fa-solid fa-file-circle-plus text-primary me-2"></i>Leave Applications</h4>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0 small">
                    <li class="breadcrumb-item"><a href="/HR" class="text-decoration-none">HR Dashboard</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Leave Applications</li>
                </ol>
            </nav>
        </div>
        <button class="btn btn-primary rounded-pill px-3 btn-sm shadow-sm"><i class="fa-solid fa-paper-plane me-1.5"></i>Apply Leave</button>
    </div>

    <!-- Leave Requests Table -->
    <div class="bg-white border rounded-3 p-4 shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" style="font-size: 0.85rem;">
                <thead class="table-light">
                    <tr>
                        <th>Employee</th>
                        <th>Leave Type</th>
                        <th>Start Date</th>
                        <th>End Date</th>
                        <th>Total Days</th>
                        <th>Reason</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td class="fw-bold text-dark">Numan Sales Man</td>
                        <td>Casual Leave</td>
                        <td>24 Aug 2026</td>
                        <td>25 Aug 2026</td>
                        <td>2 Days</td>
                        <td>Personal family function visit</td>
                        <td><span class="badge bg-warning-subtle text-warning rounded-pill">Pending Approver</span></td>
                    </tr>
                    <tr>
                        <td class="fw-bold text-dark">Aftab Shaik</td>
                        <td>Sick Leave</td>
                        <td>10 Aug 2026</td>
                        <td>11 Aug 2026</td>
                        <td>2 Days</td>
                        <td>Medical check-up and recovery Rest</td>
                        <td><span class="badge bg-success-subtle text-success rounded-pill">Approved</span></td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

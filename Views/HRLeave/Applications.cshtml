@model IEnumerable<ERP_System.Models.HRLeaveApplicationViewModel>
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Leave Applications";

    var employees = ViewBag.Employees as List<ERP_System.Models.User>
                    ?? new List<ERP_System.Models.User>();

    string currentStatus = ViewBag.StatusFilter as string ?? "All";
    string currentSearch = ViewBag.SearchTerm as string ?? "";

    var totalApplications = Model?.Count() ?? 0;
    var pendingApplications = Model?.Count(l => l.Status == "Pending" || l.Status == "Pending Approver") ?? 0;
    var approvedApplications = Model?.Count(l => l.Status == "Approved") ?? 0;
    var rejectedApplications = Model?.Count(l => l.Status == "Rejected") ?? 0;
}

<style>
    /* =========================================================
           LEAVE APPLICATIONS - PREMIUM ERP DESIGN
           ========================================================= */

    .leave-app-page {
        animation: leavePageEntrance 0.65s ease-out both;
    }

    @@keyframes leavePageEntrance {
        from

    {
        opacity: 0;
        transform: translateY(18px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }

    }

    /* =========================================================
           ALERTS
           ========================================================= */

    .leave-alert {
        border: none;
        border-left: 4px solid;
        animation: leaveAlertEntrance 0.45s ease-out both;
    }

    .leave-alert-success {
        border-left-color: #198754;
    }

    .leave-alert-danger {
        border-left-color: #dc3545;
    }

    @@keyframes leaveAlertEntrance {
        from

    {
        opacity: 0;
        transform: translateY(-10px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }

    }

    /* =========================================================
           HEADER
           ========================================================= */

    .leave-page-header {
        animation: leaveHeaderEntrance 0.55s ease-out both;
    }

    @@keyframes leaveHeaderEntrance {
        from

    {
        opacity: 0;
        transform: translateY(-14px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }

    }

    .leave-title-wrapper {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .leave-title-icon {
        width: 46px;
        height: 46px;
        border-radius: 15px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background: rgba(13, 110, 253, 0.10);
        color: var(--bs-primary);
        font-size: 1.15rem;
        transition: all 0.3s ease;
        flex-shrink: 0;
    }

    .leave-page-header:hover .leave-title-icon {
        transform: rotate(-8deg) scale(1.08);
        background: rgba(13, 110, 253, 0.16);
    }

    .leave-page-title {
        color: #1f2937;
        letter-spacing: -0.5px;
    }

    .leave-breadcrumb a {
        transition: color 0.2s ease;
    }

        .leave-breadcrumb a:hover {
            color: var(--bs-primary) !important;
        }

    /* =========================================================
           PRIMARY BUTTON
           ========================================================= */

    .leave-primary-btn {
        position: relative;
        overflow: hidden;
        transition: transform 0.25s ease, box-shadow 0.25s ease;
    }

        .leave-primary-btn:hover {
            transform: translateY(-3px);
            box-shadow: 0 10px 22px rgba(13, 110, 253, 0.25) !important;
        }

        .leave-primary-btn:active {
            transform: translateY(0) scale(0.97);
        }

        .leave-primary-btn::before {
            content: "";
            position: absolute;
            top: 0;
            left: -120%;
            width: 60%;
            height: 100%;
            background: rgba(255,255,255,0.22);
            transform: skewX(-25deg);
            transition: left 0.6s ease;
        }

        .leave-primary-btn:hover::before {
            left: 140%;
        }

    /* =========================================================
           STAT CARDS
           ========================================================= */

    .leave-stat-card {
        position: relative;
        overflow: hidden;
        min-height: 122px;
        transition: transform 0.28s ease, box-shadow 0.28s ease;
        animation: leaveStatEntrance 0.55s ease-out both;
    }

        .leave-stat-card:nth-child(1) {
            animation-delay: 0.05s;
        }

        .leave-stat-card:hover {
            transform: translateY(-6px);
            box-shadow: 0 15px 32px rgba(20, 30, 55, 0.10) !important;
        }

        .leave-stat-card::after {
            content: "";
            position: absolute;
            width: 130px;
            height: 130px;
            border-radius: 50%;
            right: -55px;
            top: -55px;
            background: currentColor;
            opacity: 0.035;
            transition: transform 0.4s ease;
        }

        .leave-stat-card:hover::after {
            transform: scale(1.45);
        }

    @@keyframes leaveStatEntrance {
        from

    {
        opacity: 0;
        transform: translateY(20px) scale(0.98);
    }

    to {
        opacity: 1;
        transform: translateY(0) scale(1);
    }

    }

    .leave-stat-card .leave-stat-icon {
        width: 55px;
        height: 55px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 17px;
        flex-shrink: 0;
        transition: transform 0.3s ease;
    }

    .leave-stat-card:hover .leave-stat-icon {
        transform: rotate(-7deg) scale(1.1);
    }

    .leave-stat-label {
        font-size: 0.71rem;
        letter-spacing: 0.7px;
    }

    .leave-stat-value {
        letter-spacing: -0.8px;
        transition: transform 0.25s ease;
    }

    .leave-stat-card:hover .leave-stat-value {
        transform: scale(1.04);
        transform-origin: left center;
    }

    /* =========================================================
           FILTER CARD
           ========================================================= */

    .leave-filter-card {
        border: 1px solid #e8ebf0 !important;
        animation: leaveFilterEntrance 0.55s ease-out 0.12s both;
        transition: box-shadow 0.3s ease;
    }

        .leave-filter-card:hover {
            box-shadow: 0 12px 28px rgba(20, 30, 55, 0.06) !important;
        }

    @@keyframes leaveFilterEntrance {
        from

    {
        opacity: 0;
        transform: translateY(14px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }

    }

    .leave-filter-title {
        font-size: 0.78rem;
        letter-spacing: 0.5px;
        text-transform: uppercase;
    }

    .leave-filter-card .form-control,
    .leave-filter-card .form-select,
    .leave-filter-card .input-group-text {
        border-color: #e1e5eb;
    }

    .leave-filter-card .form-control,
    .leave-filter-card .form-select {
        transition: border-color 0.2s ease, box-shadow 0.2s ease, transform 0.2s ease;
    }

        .leave-filter-card .form-control:focus,
        .leave-filter-card .form-select:focus {
            border-color: rgba(13, 110, 253, 0.7);
            box-shadow: 0 0 0 0.2rem rgba(13, 110, 253, 0.10);
            transform: translateY(-1px);
        }

    .leave-filter-btn {
        transition: transform 0.22s ease, box-shadow 0.22s ease;
    }

        .leave-filter-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 7px 16px rgba(20, 30, 55, 0.14);
        }

    /* =========================================================
           TABLE CARD
           ========================================================= */

    .leave-table-card {
        border: 1px solid #e8ebf0 !important;
        overflow: hidden;
        animation: leaveTableEntrance 0.6s ease-out 0.18s both;
        transition: box-shadow 0.3s ease;
    }

        .leave-table-card:hover {
            box-shadow: 0 15px 35px rgba(20, 30, 55, 0.08) !important;
        }

    @@keyframes leaveTableEntrance {
        from

    {
        opacity: 0;
        transform: translateY(18px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }

    }

    .leave-table-header {
        padding-bottom: 16px;
        border-bottom: 1px solid #edf0f4;
    }

    .leave-record-count {
        background: #f8f9fb !important;
        transition: all 0.25s ease;
    }

    .leave-table-card:hover .leave-record-count {
        border-color: rgba(13, 110, 253, 0.35) !important;
        color: var(--bs-primary) !important;
    }

    .leave-table thead th {
        white-space: nowrap;
        font-size: 0.72rem;
        letter-spacing: 0.45px;
        text-transform: uppercase;
        color: #6b7280;
        padding: 14px 12px;
        border-bottom-width: 1px;
    }

    .leave-table tbody tr {
        animation: leaveRowEntrance 0.4s ease-out both;
        transition: background-color 0.22s ease;
    }

        .leave-table tbody tr:hover {
            background-color: rgba(13, 110, 253, 0.025);
        }

        .leave-table tbody tr td {
            padding: 14px 12px;
            border-color: #f0f2f5;
        }

    @@keyframes leaveRowEntrance {
        from

    {
        opacity: 0;
        transform: translateX(-7px);
    }

    to {
        opacity: 1;
        transform: translateX(0);
    }

    }

    .leave-employee {
        font-weight: 700;
        color: #212529;
        transition: color 0.2s ease;
    }

    .leave-table tbody tr:hover .leave-employee {
        color: var(--bs-primary);
    }

    .leave-type-badge {
        transition: transform 0.2s ease, border-color 0.2s ease;
    }

    .leave-table tbody tr:hover .leave-type-badge {
        transform: scale(1.04);
        border-color: rgba(13, 110, 253, 0.35) !important;
    }

    .leave-days {
        color: #495057;
    }

    .leave-reason {
        max-width: 250px;
        line-height: 1.45;
    }

    /* =========================================================
           STATUS BADGES
           ========================================================= */

    .leave-status {
        padding: 6px 11px;
        white-space: nowrap;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

        .leave-status:hover {
            transform: translateY(-1px);
            box-shadow: 0 5px 12px rgba(20, 30, 55, 0.08);
        }

    /* =========================================================
           ACTION BUTTONS
           ========================================================= */

    .leave-action-btn {
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

        .leave-action-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 12px rgba(20, 30, 55, 0.12);
        }

        .leave-action-btn:active {
            transform: scale(0.96);
        }

    .leave-processed {
        white-space: nowrap;
    }

    /* =========================================================
           EMPTY STATE
           ========================================================= */

    .leave-empty-state {
        padding: 42px 15px !important;
    }

    .leave-empty-icon {
        width: 60px;
        height: 60px;
        margin: 0 auto 14px;
        border-radius: 18px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #f8f9fb;
        color: #9aa3af;
        font-size: 1.5rem;
        animation: leaveEmptyFloat 3s ease-in-out infinite;
    }

    @@keyframes leaveEmptyFloat {
        0%, 100%

    {
        transform: translateY(0);
    }

    50% {
        transform: translateY(-6px);
    }

    }

    /* =========================================================
           MODAL
           ========================================================= */

    .leave-modal .modal-content {
        overflow: hidden;
    }

    .leave-modal .modal-header {
        background: linear-gradient(135deg, #f8f9fb 0%, #ffffff 100%) !important;
    }

    .leave-modal .modal-footer {
        background: #fafbfc !important;
    }

    .leave-modal .modal-dialog {
        transform: translateY(-20px) scale(0.97);
        transition: transform 0.3s ease-out;
    }

    .leave-modal.show .modal-dialog {
        transform: translateY(0) scale(1);
    }

    .leave-modal-icon {
        width: 40px;
        height: 40px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 12px;
        background: rgba(13, 110, 253, 0.10);
        transition: transform 0.25s ease;
    }

    .leave-modal:hover .leave-modal-icon {
        transform: rotate(-7deg) scale(1.08);
    }

    /* =========================================================
           MODAL FORM
           ========================================================= */

    .leave-form-control {
        border-color: #dfe3e9;
        transition: border-color 0.2s ease, box-shadow 0.2s ease, transform 0.2s ease;
    }

        .leave-form-control:hover {
            border-color: #b9c3d2;
        }

        .leave-form-control:focus {
            border-color: var(--bs-primary);
            box-shadow: 0 0 0 0.2rem rgba(13, 110, 253, 0.10);
            transform: translateY(-1px);
        }

    /* =========================================================
           RESPONSIVE
           ========================================================= */

    @@media (max-width: 767.98px) {
        .leave-page-header

    {
        align-items: flex-start !important;
    }

    .leave-title-icon {
        width: 42px;
        height: 42px;
    }

    .leave-stat-card {
        min-height: 108px;
    }

    .leave-table-card {
        padding: 1rem !important;
    }

    .leave-table-header {
        align-items: flex-start !important;
        gap: 10px;
    }

    .leave-reason {
        min-width: 180px;
    }

    }

    /* =========================================================
           REDUCED MOTION
           ========================================================= */

    @@media (prefers-reduced-motion: reduce) {
        *, *::before, *::after

    {
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.01ms !important;
        scroll-behavior: auto !important;
    }

    }
</style>

<div class="container-fluid py-4 text-start leave-app-page">

    <!-- Alerts -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3 shadow-sm mb-4 leave-alert leave-alert-success" role="alert">
            <i class="fa-solid fa-circle-check me-2"></i>
            @TempData["SuccessMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Close">
            </button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-3 shadow-sm mb-4 leave-alert leave-alert-danger" role="alert">
            <i class="fa-solid fa-triangle-exclamation me-2"></i>
            @TempData["ErrorMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Close">
            </button>
        </div>
    }

    <!-- Header -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4 leave-page-header">

        <div>
            <div class="leave-title-wrapper">
                <span class="leave-title-icon">
                    <i class="fa-solid fa-file-circle-plus"></i>
                </span>

                <div>
                    <h4 class="fw-bold mb-1 leave-page-title">
                        Leave Applications
                    </h4>

                    <nav aria-label="breadcrumb">
                        <ol class="breadcrumb mb-0 small leave-breadcrumb">
                            <li class="breadcrumb-item">
                                <a href="/HR" class="text-decoration-none">
                                    HR Dashboard
                                </a>
                            </li>

                            <li class="breadcrumb-item active" aria-current="page">
                                Leave Applications
                            </li>
                        </ol>
                    </nav>
                </div>
            </div>
        </div>

        <button type="button"
                class="btn btn-primary rounded-pill px-3 btn-sm shadow-sm leave-primary-btn"
                data-bs-toggle="modal"
                data-bs-target="#applyLeaveModal">
            <i class="fa-solid fa-paper-plane me-1"></i>
            Log / Apply Leave
        </button>
    </div>

    <!-- Stat Cards -->
    <div class="row g-3 mb-4">

        <!-- Total -->
        <div class="col-12 col-sm-6 col-md-3">
            <div class="card border-0 shadow-sm rounded-3 bg-white p-3 border-start border-4 border-primary leave-stat-card">
                <div class="d-flex align-items-center justify-content-between">

                    <div class="pe-2">
                        <div class="text-muted fw-semibold text-uppercase leave-stat-label">
                            Total Applications
                        </div>

                        <h3 class="fw-bold text-dark mb-0 mt-2 leave-stat-value">
                            @totalApplications
                        </h3>
                    </div>

                    <div class="leave-stat-icon bg-primary bg-opacity-10 text-primary">
                        <i class="fa-solid fa-folder-open fa-lg"></i>
                    </div>

                </div>
            </div>
        </div>

        <!-- Pending -->
        <div class="col-12 col-sm-6 col-md-3">
            <div class="card border-0 shadow-sm rounded-3 bg-white p-3 border-start border-4 border-warning leave-stat-card"
                 style="animation-delay: 0.12s;">

                <div class="d-flex align-items-center justify-content-between">

                    <div class="pe-2">
                        <div class="text-muted fw-semibold text-uppercase leave-stat-label">
                            Pending Approvals
                        </div>

                        <h3 class="fw-bold text-dark mb-0 mt-2 leave-stat-value">
                            @pendingApplications
                        </h3>
                    </div>

                    <div class="leave-stat-icon bg-warning bg-opacity-10 text-warning">
                        <i class="fa-solid fa-clock-rotate-left fa-lg"></i>
                    </div>

                </div>
            </div>
        </div>

        <!-- Approved -->
        <div class="col-12 col-sm-6 col-md-3">
            <div class="card border-0 shadow-sm rounded-3 bg-white p-3 border-start border-4 border-success leave-stat-card"
                 style="animation-delay: 0.19s;">

                <div class="d-flex align-items-center justify-content-between">

                    <div class="pe-2">
                        <div class="text-muted fw-semibold text-uppercase leave-stat-label">
                            Approved Leaves
                        </div>

                        <h3 class="fw-bold text-dark mb-0 mt-2 leave-stat-value">
                            @approvedApplications
                        </h3>
                    </div>

                    <div class="leave-stat-icon bg-success bg-opacity-10 text-success">
                        <i class="fa-solid fa-circle-check fa-lg"></i>
                    </div>

                </div>
            </div>
        </div>

        <!-- Rejected -->
        <div class="col-12 col-sm-6 col-md-3">
            <div class="card border-0 shadow-sm rounded-3 bg-white p-3 border-start border-4 border-danger leave-stat-card"
                 style="animation-delay: 0.26s;">

                <div class="d-flex align-items-center justify-content-between">

                    <div class="pe-2">
                        <div class="text-muted fw-semibold text-uppercase leave-stat-label">
                            Rejected Leaves
                        </div>

                        <h3 class="fw-bold text-dark mb-0 mt-2 leave-stat-value">
                            @rejectedApplications
                        </h3>
                    </div>

                    <div class="leave-stat-icon bg-danger bg-opacity-10 text-danger">
                        <i class="fa-solid fa-circle-xmark fa-lg"></i>
                    </div>

                </div>
            </div>
        </div>

    </div>

    <!-- Filters -->
    <div class="bg-white rounded-3 p-3 shadow-sm mb-4 leave-filter-card">

        <div class="leave-filter-title fw-bold text-secondary mb-3">
            <i class="fa-solid fa-sliders me-1"></i>
            Filter Leave Applications
        </div>

        <form method="get"
              asp-action="Applications"
              class="row g-3 align-items-end">

            <div class="col-12 col-md-5">

                <label class="form-label small fw-bold text-secondary mb-1">
                    Search Employee or Leave Type
                </label>

                <div class="input-group input-group-sm">

                    <span class="input-group-text bg-light">
                        <i class="fa-solid fa-magnifying-glass"></i>
                    </span>

                    <input type="text"
                           name="searchTerm"
                           class="form-control"
                           placeholder="Search employee or leave type..."
                           value="@currentSearch" />

                </div>
            </div>

            <div class="col-12 col-md-4">

                <label class="form-label small fw-bold text-secondary mb-1">
                    Application Status
                </label>

                <select name="statusFilter"
                        class="form-select form-select-sm"
                        onchange="this.form.submit()">

                    <option value="All"
                            selected="@(currentStatus == "All")">
                        All Statuses
                    </option>

                    <option value="Pending"
                            selected="@(currentStatus == "Pending")">
                        Pending
                    </option>

                    <option value="Approved"
                            selected="@(currentStatus == "Approved")">
                        Approved
                    </option>

                    <option value="Rejected"
                            selected="@(currentStatus == "Rejected")">
                        Rejected
                    </option>

                </select>
            </div>

            <div class="col-12 col-md-3">

                <button type="submit"
                        class="btn btn-dark btn-sm w-100 leave-filter-btn">
                    <i class="fa-solid fa-filter me-1"></i>
                    Filter Applications
                </button>

            </div>

        </form>
    </div>

    <!-- Leave Applications Table -->
    <div class="bg-white rounded-3 p-4 shadow-sm leave-table-card">

        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-3 leave-table-header">

            <div>
                <h6 class="fw-bold mb-1 text-secondary">
                    Employee Submitted Leave Applications
                </h6>

                <div class="small text-muted">
                    Review, approve, or reject employee leave requests.
                </div>
            </div>

            <span class="badge text-dark border rounded-pill px-3 py-2 leave-record-count">
                <i class="fa-solid fa-layer-group me-1"></i>
                @totalApplications Applications
            </span>

        </div>

        <div class="table-responsive">

            <table class="table table-hover align-middle mb-0 leave-table"
                   style="font-size: 0.85rem;">

                <thead class="table-light">

                    <tr>
                        <th>Employee</th>
                        <th>Leave Type</th>
                        <th>Start Date</th>
                        <th>End Date</th>
                        <th>Total Days</th>
                        <th>Reason for Leave</th>
                        <th>Status</th>
                        <th>Action</th>
                    </tr>

                </thead>

                <tbody>

                    @if (Model != null && Model.Any())
                    {
                        foreach (var l in Model)
                        {
                            <tr>

                                <td class="leave-employee">
                                    @l.EmployeeName
                                </td>

                                <td>
                                    <span class="badge bg-light text-dark border leave-type-badge">
                                        @l.LeaveType
                                    </span>
                                </td>

                                <td>
                                    @l.StartDate.ToString("dd MMM yyyy")
                                </td>

                                <td>
                                    @l.EndDate.ToString("dd MMM yyyy")
                                </td>

                                <td class="fw-semibold leave-days">
                                    @l.TotalDays Days
                                </td>

                                <td class="text-muted small leave-reason">
                                    @(string.IsNullOrWhiteSpace(l.Reason) ? "-" : l.Reason)
                                </td>

                                <td>

                                    @if (l.Status == "Approved")
                                    {
                                        <span class="badge bg-success-subtle text-success rounded-pill leave-status">
                                            <i class="fa-solid fa-circle-check me-1"></i>
                                            Approved
                                        </span>
                                    }
                                    else if (l.Status == "Rejected")
                                    {
                                        <span class="badge bg-danger-subtle text-danger rounded-pill leave-status">
                                            <i class="fa-solid fa-circle-xmark me-1"></i>
                                            Rejected
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning-subtle text-warning rounded-pill leave-status">
                                            <i class="fa-solid fa-clock me-1"></i>
                                            Pending Approval
                                        </span>
                                    }

                                </td>

                                <td>

                                    @if (l.Status == "Pending" || l.Status == "Pending Approver")
                                    {
                                        <div class="d-flex gap-1">

                                            <form asp-action="ApproveLeave"
                                                  method="post"
                                                  class="d-inline">

                                                @Html.AntiForgeryToken()

                                                <input type="hidden"
                                                       name="leaveId"
                                                       value="@l.LeaveApplicationId" />

                                                <button type="submit"
                                                        class="btn btn-success btn-xs rounded-pill px-2.5 leave-action-btn">

                                                    <i class="fa-solid fa-check me-1"></i>
                                                    Approve

                                                </button>

                                            </form>

                                            <form asp-action="RejectLeave"
                                                  method="post"
                                                  class="d-inline">

                                                @Html.AntiForgeryToken()

                                                <input type="hidden"
                                                       name="leaveId"
                                                       value="@l.LeaveApplicationId" />

                                                <button type="submit"
                                                        class="btn btn-outline-danger btn-xs rounded-pill px-2.5 leave-action-btn">

                                                    <i class="fa-solid fa-xmark me-1"></i>
                                                    Reject

                                                </button>

                                            </form>

                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-muted small leave-processed">
                                            <i class="fa-solid fa-check-double me-1"></i>
                                            Processed
                                        </span>
                                    }

                                </td>

                            </tr>
                        }
                    }
                    else
                    {
                        <tr>

                            <td colspan="8"
                                class="text-center text-muted leave-empty-state">

                                <div class="leave-empty-icon">
                                    <i class="fa-solid fa-file-circle-xmark"></i>
                                </div>

                                <div class="fw-semibold text-dark mb-1">
                                    No Leave Applications Found
                                </div>

                                <div class="small">
                                    There are currently no leave applications matching your filters.
                                </div>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>

<!-- Apply Leave Modal -->
<div class="modal fade leave-modal"
     id="applyLeaveModal"
     tabindex="-1"
     aria-labelledby="applyLeaveModalLabel"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content rounded-3 border-0 shadow">

            <div class="modal-header border-bottom px-4 py-3">

                <h5 class="modal-title fw-bold d-flex align-items-center"
                    id="applyLeaveModalLabel">

                    <span class="leave-modal-icon text-primary me-2">
                        <i class="fa-solid fa-paper-plane"></i>
                    </span>

                    Log Leave Application

                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Close">
                </button>

            </div>

            <form asp-action="SubmitLeaveByHR" method="post">

                @Html.AntiForgeryToken()

                <div class="modal-body p-4">

                    <!-- Employee -->
                    <div class="mb-3">

                        <label class="form-label small fw-bold text-secondary">
                            Select Employee
                        </label>

                        <select name="userId"
                                class="form-select leave-form-control"
                                required>

                            <option value="">
                                -- Choose Employee --
                            </option>

                            @foreach (var emp in employees)
                            {
                                <option value="@emp.UserId">
                                    @emp.FullName
                                </option>
                            }

                        </select>

                    </div>

                    <!-- Leave Type -->
                    <div class="mb-3">

                        <label class="form-label small fw-bold text-secondary">
                            Leave Type
                        </label>

                        <select name="leaveType"
                                class="form-select leave-form-control"
                                required>

                            <option value="Casual Leave">
                                Casual Leave
                            </option>

                            <option value="Sick Leave">
                                Sick Leave
                            </option>

                            <option value="Earned Leave">
                                Earned Leave
                            </option>

                        </select>

                    </div>

                    <!-- Dates -->
                    <div class="row g-3 mb-3">

                        <div class="col-12 col-md-6">

                            <label class="form-label small fw-bold text-secondary">
                                Start Date
                            </label>

                            <input type="date"
                                   name="startDate"
                                   class="form-control leave-form-control"
                                   value="@DateTime.Today.ToString("yyyy-MM-dd")"
                                   required />

                        </div>

                        <div class="col-12 col-md-6">

                            <label class="form-label small fw-bold text-secondary">
                                End Date
                            </label>

                            <input type="date"
                                   name="endDate"
                                   class="form-control leave-form-control"
                                   value="@DateTime.Today.ToString("yyyy-MM-dd")"
                                   required />

                        </div>

                    </div>

                    <!-- Reason -->
                    <div class="mb-2">

                        <label class="form-label small fw-bold text-secondary">
                            Reason for Leave
                        </label>

                        <textarea name="reason"
                                  class="form-control leave-form-control"
                                  rows="3"
                                  placeholder="State reason for leave entry..."
                                  required></textarea>

                    </div>

                </div>

                <div class="modal-footer border-top px-4 py-3">

                    <button type="button"
                            class="btn btn-outline-secondary btn-sm rounded-pill px-3 leave-action-btn"
                            data-bs-dismiss="modal">

                        Cancel

                    </button>

                    <button type="submit"
                            class="btn btn-primary btn-sm rounded-pill px-4 leave-primary-btn">

                        <i class="fa-solid fa-check me-1"></i>
                        Create & Approve Leave

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>
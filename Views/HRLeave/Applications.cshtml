@model IEnumerable<ERP_System.Models.HRLeaveApplicationViewModel>
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Leave Applications";

    string currentStatus = ViewBag.StatusFilter as string ?? "All";
    string currentSearch = ViewBag.SearchTerm as string ?? "";
    var leaveTypes = ViewBag.LeaveTypes as List<ERP_System.Models.LeaveType> ?? new List<ERP_System.Models.LeaveType>();

    var totalCount = ViewBag.TotalCount ?? Model?.Count() ?? 0;
    var pendingCount = ViewBag.PendingCount ?? Model?.Count(l => l.Status == "Pending" || l.Status == "Pending Approver") ?? 0;
    var approvedCount = ViewBag.ApprovedCount ?? Model?.Count(l => l.Status == "Approved") ?? 0;
    var rejectedCount = ViewBag.RejectedCount ?? Model?.Count(l => l.Status == "Rejected") ?? 0;
}

<style>
    /* =========================================================
       LEAVE APPLICATIONS - SCALABLE ERP DESIGN
       ========================================================= */
    .leave-app-page {
        animation: leavePageEntrance 0.65s ease-out both;
    }

    @@keyframes leavePageEntrance {
        from {
            opacity: 0;
            transform: translateY(18px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .leave-title-icon {
        width: 46px;
        height: 46px;
        border-radius: 15px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background: rgba(13, 110, 253, 0.10);
        color: var(--bs-primary);
        font-size: 1.15rem;
    }

    .leave-summary-card {
        border-radius: 16px;
        border: 1px solid #edf0f5;
        transition: transform 0.28s ease, box-shadow 0.28s ease;
    }

    .leave-summary-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 15px 32px rgba(20, 30, 55, 0.08) !important;
    }

    .search-suggestion-item {
        cursor: pointer;
        transition: background-color 0.15s ease;
    }

    .search-suggestion-item:hover {
        background-color: #f0f7ff;
    }
</style>

<div class="container-fluid py-4 text-start leave-app-page">

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3 shadow-sm mb-4" role="alert">
            <i class="fa-solid fa-circle-check me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-3 shadow-sm mb-4" role="alert">
            <i class="fa-solid fa-triangle-exclamation me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Header -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div class="d-flex align-items-center gap-3">
            <div class="leave-title-icon">
                <i class="fa-solid fa-file-circle-plus"></i>
            </div>
            <div>
                <h4 class="fw-bold mb-1 text-dark">Leave Applications</h4>
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb mb-0 small">
                        <li class="breadcrumb-item"><a href="/HR" class="text-decoration-none">HR Dashboard</a></li>
                        <li class="breadcrumb-item active" aria-current="page">Leave Applications</li>
                    </ol>
                </nav>
            </div>
        </div>

        <button type="button"
                class="btn btn-primary rounded-pill px-3.5 py-2 btn-sm shadow-sm"
                data-bs-toggle="modal"
                data-bs-target="#applyLeaveModal">
            <i class="fa-solid fa-plus me-1.5"></i>
            Log / Apply Leave
        </button>
    </div>

    <!-- Summary Cards -->
    <div class="row g-3 mb-4">
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card bg-white p-3 shadow-sm leave-summary-card border-start border-4 border-primary">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted fw-semibold small text-uppercase">Total Applications</div>
                        <h3 class="fw-bold text-dark mb-0 mt-1">@totalCount</h3>
                    </div>
                    <div class="rounded-circle bg-primary bg-opacity-10 text-primary p-3">
                        <i class="fa-solid fa-folder-open fa-lg"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card bg-white p-3 shadow-sm leave-summary-card border-start border-4 border-warning">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted fw-semibold small text-uppercase">Pending Review</div>
                        <h3 class="fw-bold text-dark mb-0 mt-1">@pendingCount</h3>
                    </div>
                    <div class="rounded-circle bg-warning bg-opacity-10 text-warning p-3">
                        <i class="fa-solid fa-clock-rotate-left fa-lg"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card bg-white p-3 shadow-sm leave-summary-card border-start border-4 border-success">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted fw-semibold small text-uppercase">Approved Leaves</div>
                        <h3 class="fw-bold text-dark mb-0 mt-1">@approvedCount</h3>
                    </div>
                    <div class="rounded-circle bg-success bg-opacity-10 text-success p-3">
                        <i class="fa-solid fa-circle-check fa-lg"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card bg-white p-3 shadow-sm leave-summary-card border-start border-4 border-danger">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted fw-semibold small text-uppercase">Rejected Leaves</div>
                        <h3 class="fw-bold text-dark mb-0 mt-1">@rejectedCount</h3>
                    </div>
                    <div class="rounded-circle bg-danger bg-opacity-10 text-danger p-3">
                        <i class="fa-solid fa-circle-xmark fa-lg"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Filter & Search Panel -->
    <div class="card bg-white border-0 shadow-sm rounded-3 p-3 mb-4">
        <form method="get" asp-action="Applications" id="leaveFilterForm" class="row g-3 align-items-end">
            <div class="col-12 col-md-5">
                <label class="form-label small fw-bold text-secondary mb-1">Search Staff / Leave Type</label>
                <div class="input-group input-group-sm">
                    <span class="input-group-text bg-light"><i class="fa-solid fa-magnifying-glass text-muted"></i></span>
                    <input type="text" name="searchEmployee" class="form-control" placeholder="Search by name, employee code, or leave type..." value="@currentSearch" />
                </div>
            </div>

            <div class="col-12 col-md-4">
                <label class="form-label small fw-bold text-secondary mb-1">Status Filter</label>
                <select name="status" class="form-select form-select-sm" onchange="document.getElementById('leaveFilterForm').submit()">
                    <option value="All" selected="@(currentStatus == "All")">All Applications</option>
                    <option value="Pending" selected="@(currentStatus == "Pending")">Pending Review</option>
                    <option value="Approved" selected="@(currentStatus == "Approved")">Approved</option>
                    <option value="Rejected" selected="@(currentStatus == "Rejected")">Rejected</option>
                </select>
            </div>

            <div class="col-12 col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-primary btn-sm rounded-pill px-3 w-100">
                    <i class="fa-solid fa-filter me-1"></i> Apply Filter
                </button>
                @if (!string.IsNullOrEmpty(currentSearch) || currentStatus != "All")
                {
                    <a href="/HRLeave/Applications" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
                        <i class="fa-solid fa-rotate-left"></i>
                    </a>
                }
            </div>
        </form>
    </div>

    <!-- Applications Table -->
    <div class="card bg-white border-0 shadow-sm rounded-3 p-4">
        <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom">
            <h6 class="fw-bold mb-0 text-dark">
                <i class="fa-solid fa-list-check text-primary me-2"></i>Staff Leave Records
            </h6>
            <span class="badge bg-light text-dark border rounded-pill px-3 py-2">
                @Model?.Count() Records Displayed
            </span>
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" style="font-size: 0.85rem;">
                <thead class="table-light">
                    <tr>
                        <th>Employee</th>
                        <th>Leave Type</th>
                        <th>Duration</th>
                        <th>Days</th>
                        <th>Reason</th>
                        <th>Status</th>
                        <th class="text-center">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var leave in Model)
                        {
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="rounded-circle bg-primary bg-opacity-10 text-primary d-flex align-items-center justify-content-center" style="width: 32px; height: 32px; min-width: 32px;">
                                            <i class="fa-solid fa-user"></i>
                                        </div>
                                        <div class="fw-bold text-dark">@leave.EmployeeName</div>
                                    </div>
                                </td>
                                <td>
                                    <span class="badge bg-light text-dark border rounded-pill px-2.5 py-1">
                                        @leave.LeaveType
                                    </span>
                                </td>
                                <td class="text-muted">
                                    <i class="fa-regular fa-calendar me-1"></i>
                                    @leave.StartDate.ToString("dd MMM yyyy") - @leave.EndDate.ToString("dd MMM yyyy")
                                </td>
                                <td>
                                    <span class="badge bg-primary-subtle text-primary rounded-pill px-2 py-1 fw-bold">
                                        @leave.TotalDays @(leave.TotalDays == 1 ? "Day" : "Days")
                                    </span>
                                </td>
                                <td class="text-muted" style="max-width: 250px;">
                                    @leave.Reason
                                </td>
                                <td>
                                    @if (leave.Status == "Approved")
                                    {
                                        <span class="badge bg-success-subtle text-success rounded-pill px-2.5 py-1">
                                            <i class="fa-solid fa-circle-check me-1"></i>Approved
                                        </span>
                                    }
                                    else if (leave.Status == "Rejected")
                                    {
                                        <span class="badge bg-danger-subtle text-danger rounded-pill px-2.5 py-1">
                                            <i class="fa-solid fa-circle-xmark me-1"></i>Rejected
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning-subtle text-warning-emphasis rounded-pill px-2.5 py-1">
                                            <i class="fa-solid fa-clock-rotate-left me-1"></i>Pending Review
                                        </span>
                                    }
                                </td>
                                <td class="text-center">
                                    @if (leave.Status == "Pending" || leave.Status == "Pending Approver")
                                    {
                                        <div class="d-flex justify-content-center gap-1">
                                            <form asp-action="ApproveLeave" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="leaveId" value="@leave.LeaveApplicationId" />
                                                <button type="submit" class="btn btn-success btn-xs rounded-pill px-2.5" onclick="return confirm('Approve leave for @leave.EmployeeName?')">
                                                    <i class="fa-solid fa-check me-1"></i>Approve
                                                </button>
                                            </form>
                                            <form asp-action="RejectLeave" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="leaveId" value="@leave.LeaveApplicationId" />
                                                <button type="submit" class="btn btn-outline-danger btn-xs rounded-pill px-2.5" onclick="return confirm('Reject leave for @leave.EmployeeName?')">
                                                    <i class="fa-solid fa-xmark me-1"></i>Reject
                                                </button>
                                            </form>
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">
                                            <i class="fa-solid fa-check-double text-success opacity-50 me-1"></i>Processed
                                        </span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center text-muted py-5">
                                <i class="fa-solid fa-file-circle-xmark fa-2x mb-2 text-secondary opacity-50"></i>
                                <div>No leave applications match your search criteria.</div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Scalable Log / Apply Leave Modal (Debounce Live AJAX Search) -->
<div class="modal fade" id="applyLeaveModal" tabindex="-1" aria-labelledby="applyLeaveModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-3 border-0 shadow">
            <div class="modal-header border-bottom px-4 py-3">
                <h5 class="modal-title fw-bold" id="applyLeaveModalLabel">
                    <i class="fa-solid fa-paper-plane text-primary me-2"></i>
                    Log / Apply Leave (HR & Admin)
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <form asp-action="SubmitLeaveByHR" method="post" id="hrLeaveSubmitForm">
                @Html.AntiForgeryToken()
                <input type="hidden" id="selectedUserId" name="userId" value="" required />

                <div class="modal-body p-4">
                    <!-- Scalable AJAX Search Box for 2000+ staff -->
                    <div class="mb-3 position-relative">
                        <label class="form-label small fw-bold text-secondary">
                            Search & Select Employee <span class="text-danger">*</span>
                        </label>

                        <div id="selectedEmployeeBadge" class="d-none alert alert-primary py-2 px-3 mb-2 d-flex align-items-center justify-content-between rounded-3">
                            <div class="d-flex align-items-center gap-2">
                                <i class="fa-solid fa-user-check text-primary"></i>
                                <div>
                                    <span class="fw-bold" id="badgeEmpName"></span>
                                    <small class="text-muted ms-1" id="badgeEmpInfo"></small>
                                </div>
                            </div>
                            <button type="button" class="btn btn-sm btn-link text-danger p-0 text-decoration-none" onclick="clearSelectedEmployee()">
                                <i class="fa-solid fa-times"></i> Change
                            </button>
                        </div>

                        <div id="searchEmployeeWrapper">
                            <div class="input-group input-group-sm">
                                <span class="input-group-text bg-light"><i class="fa-solid fa-magnifying-glass text-muted"></i></span>
                                <input type="text"
                                       id="employeeSearchInput"
                                       class="form-control"
                                       placeholder="Type employee name, code (e.g. EMP001), or email..."
                                       autocomplete="off" />
                            </div>
                            <div id="employeeSearchResults" class="list-group position-absolute w-100 shadow-lg mt-1 d-none" style="z-index: 1060; max-height: 220px; overflow-y: auto;"></div>
                            <small class="text-muted" style="font-size: 0.75rem;">Dynamic search scales seamlessly for 2,000+ staff.</small>
                        </div>
                    </div>

                    <!-- Leave Type Selection -->
                    <div class="mb-3">
                        <label class="form-label small fw-bold text-secondary">
                            Leave Type <span class="text-danger">*</span>
                        </label>
                        <select name="leaveType" class="form-select form-select-sm" required>
                            @if (leaveTypes.Any())
                            {
                                foreach (var lt in leaveTypes)
                                {
                                    <option value="@lt.Name">@lt.Name (@lt.Code) - Max @lt.YearlyLimit Days</option>
                                }
                            }
                            else
                            {
                                <option value="Casual Leave">Casual Leave (CL)</option>
                                <option value="Sick Leave">Sick Leave (SL)</option>
                                <option value="Earned Leave">Earned Leave (EL)</option>
                                <option value="Maternity / Paternity Leave">Maternity / Paternity Leave (ML)</option>
                            }
                        </select>
                    </div>

                    <!-- Dates -->
                    <div class="row g-3 mb-3">
                        <div class="col-6">
                            <label class="form-label small fw-bold text-secondary">Start Date <span class="text-danger">*</span></label>
                            <input type="date" name="startDate" id="leaveStartDate" class="form-control form-control-sm" value="@DateTime.Today.ToString("yyyy-MM-dd")" required />
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-bold text-secondary">End Date <span class="text-danger">*</span></label>
                            <input type="date" name="endDate" id="leaveEndDate" class="form-control form-control-sm" value="@DateTime.Today.ToString("yyyy-MM-dd")" required />
                        </div>
                    </div>

                    <!-- Reason -->
                    <div class="mb-2">
                        <label class="form-label small fw-bold text-secondary">Reason for Leave <span class="text-danger">*</span></label>
                        <textarea name="reason" class="form-control form-control-sm" rows="3" placeholder="Provide reason or justification for leave entry..." required></textarea>
                    </div>
                </div>

                <div class="modal-footer border-top px-4 py-3">
                    <button type="button" class="btn btn-outline-secondary btn-sm rounded-pill px-3" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary btn-sm rounded-pill px-4" id="btnSubmitLeave">
                        <i class="fa-solid fa-paper-plane me-1"></i> Log & Approve Leave
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    // Scalable Debounced Live AJAX Employee Search
    let searchDebounceTimer;
    const searchInput = document.getElementById("employeeSearchInput");
    const resultsContainer = document.getElementById("employeeSearchResults");
    const selectedUserId = document.getElementById("selectedUserId");
    const selectedBadge = document.getElementById("selectedEmployeeBadge");
    const searchWrapper = document.getElementById("searchEmployeeWrapper");

    if (searchInput) {
        searchInput.addEventListener("input", function () {
            clearTimeout(searchDebounceTimer);
            const query = this.value.trim();

            if (query.length < 1) {
                resultsContainer.innerHTML = "";
                resultsContainer.classList.add("d-none");
                return;
            }

            searchDebounceTimer = setTimeout(() => {
                fetch(`/HRLeave/SearchEmployees?q=${encodeURIComponent(query)}`)
                    .then(res => res.json())
                    .then(data => {
                        resultsContainer.innerHTML = "";
                        if (data && data.length > 0) {
                            data.forEach(emp => {
                                const item = document.createElement("a");
                                item.className = "list-group-item list-group-item-action search-suggestion-item py-2 px-3";
                                item.innerHTML = `
                                    <div class="d-flex justify-content-between align-items-center">
                                        <div>
                                            <div class="fw-bold text-dark">${emp.name}</div>
                                            <small class="text-muted">${emp.code} &bull; ${emp.department || 'General'}</small>
                                        </div>
                                        <span class="badge bg-light text-primary border">${emp.email || ''}</span>
                                    </div>
                                `;
                                item.addEventListener("click", () => selectEmployee(emp));
                                resultsContainer.appendChild(item);
                            });
                            resultsContainer.classList.remove("d-none");
                        } else {
                            resultsContainer.innerHTML = `<div class="list-group-item text-muted small py-2 px-3">No matching staff found</div>`;
                            resultsContainer.classList.remove("d-none");
                        }
                    })
                    .catch(err => {
                        console.error(err);
                    });
            }, 300);
        });

        // Hide suggestions when clicking outside
        document.addEventListener("click", function (e) {
            if (!searchInput.contains(e.target) && !resultsContainer.contains(e.target)) {
                resultsContainer.classList.add("d-none");
            }
        });
    }

    function selectEmployee(emp) {
        selectedUserId.value = emp.id;
        document.getElementById("badgeEmpName").textContent = emp.name;
        document.getElementById("badgeEmpInfo").textContent = `(${emp.code} - ${emp.department || 'General'})`;

        selectedBadge.classList.remove("d-none");
        searchWrapper.classList.add("d-none");
        resultsContainer.classList.add("d-none");
        searchInput.value = "";
    }

    function clearSelectedEmployee() {
        selectedUserId.value = "";
        selectedBadge.classList.add("d-none");
        searchWrapper.classList.remove("d-none");
        searchInput.focus();
    }

    document.getElementById("hrLeaveSubmitForm")?.addEventListener("submit", function (e) {
        if (!selectedUserId.value) {
            e.preventDefault();
            alert("Please search and select an employee from the suggestions list.");
            searchInput.focus();
        }
    });
</script>

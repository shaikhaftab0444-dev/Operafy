@model IEnumerable<ERP_System.Models.User>
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Leave Balance Ledger";
    var approvedLeaves = ViewBag.ApprovedLeaves as List<ERP_System.Models.ESSLeaveApplication> ?? new List<ERP_System.Models.ESSLeaveApplication>();
}

<div class="container-fluid py-4 text-start">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-bold mb-1"><i class="fa-solid fa-scale-balanced text-primary me-2"></i>Leave Balance Ledger</h4>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0 small">
                    <li class="breadcrumb-item"><a href="/HR" class="text-decoration-none">HR Dashboard</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Leave Balance Ledger</li>
                </ol>
            </nav>
        </div>
    </div>

    <!-- Balance Grid -->
    <div class="bg-white border rounded-3 p-4 shadow-sm">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h6 class="fw-bold mb-0 text-secondary">Employee Live Leave Entitlements & Consumption</h6>
            <span class="badge bg-light text-dark border">@Model.Count() Active Staff</span>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" style="font-size: 0.85rem;">
                <thead class="table-light">
                    <tr>
                        <th>Employee ID</th>
                        <th>Employee Name</th>
                        <th>Casual Leave (CL)</th>
                        <th>Sick Leave (SL)</th>
                        <th>Earned Leave (EL)</th>
                        <th>Total Days Used</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var u in Model)
                        {
                            var userLeaves = approvedLeaves.Where(l => l.UserId == u.UserId).ToList();
                            int casualUsed = userLeaves.Where(l => l.LeaveType == "Casual Leave").Sum(l => l.TotalDays);
                            int sickUsed = userLeaves.Where(l => l.LeaveType == "Sick Leave").Sum(l => l.TotalDays);
                            int earnedUsed = userLeaves.Where(l => l.LeaveType == "Earned Leave").Sum(l => l.TotalDays);
                            int casualRem = Math.Max(0, 12 - casualUsed);
                            int sickRem = Math.Max(0, 8 - sickUsed);
                            int earnedRem = Math.Max(0, 15 - earnedUsed);
                            int totalUsed = casualUsed + sickUsed + earnedUsed;

                            <tr>
                                <td class="fw-bold text-dark">@(string.IsNullOrEmpty(u.UserCode) ? $"EMP-00{u.UserId}" : u.UserCode)</td>
                                <td class="fw-semibold text-dark">@u.FullName</td>
                                <td>
                                    <span class="fw-bold text-primary">@casualRem / 12</span> <small class="text-muted">(Used: @casualUsed)</small>
                                </td>
                                <td>
                                    <span class="fw-bold text-info">@sickRem / 8</span> <small class="text-muted">(Used: @sickUsed)</small>
                                </td>
                                <td>
                                    <span class="fw-bold text-success">@earnedRem / 15</span> <small class="text-muted">(Used: @earnedUsed)</small>
                                </td>
                                <td><span class="badge bg-light text-dark border">@totalUsed Days</span></td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center py-4 text-muted">No employees found.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

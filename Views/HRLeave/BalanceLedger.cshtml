@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Leave Balance Ledger";
}

<div class="container-fluid py-4 text-start">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-bold mb-1"><i class="fa-solid fa-scale-balanced text-primary me-2"></i>Leave Balance Ledger</h4>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0 small">
                    <li class="breadcrumb-item"><a href="/HR" class="text-decoration-none">HR Dashboard</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Leave Balance Ledger</li>
                </ol>
            </nav>
        </div>
    </div>

    <!-- Balance Grid -->
    <div class="bg-white border rounded-3 p-4 shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" style="font-size: 0.85rem;">
                <thead class="table-light">
                    <tr>
                        <th>Employee ID</th>
                        <th>Employee</th>
                        <th>Casual Leave (CL)</th>
                        <th>Sick Leave (SL)</th>
                        <th>Earned Leave (EL)</th>
                        <th>Maternity/Paternity</th>
                        <th>Comp-offs</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td class="fw-bold text-dark">EMP-001</td>
                        <td>Numan Sales Man</td>
                        <td>8 / 12 Days</td>
                        <td>6 / 8 Days</td>
                        <td>12 / 15 Days</td>
                        <td>0 / 0</td>
                        <td>2 Days</td>
                    </tr>
                    <tr>
                        <td class="fw-bold text-dark">EMP-002</td>
                        <td>Aftab Shaik</td>
                        <td>10 / 12 Days</td>
                        <td>7 / 8 Days</td>
                        <td>14 / 15 Days</td>
                        <td>0 / 0</td>
                        <td>0</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

@model ERP_System.Models.HRHoliday
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Edit Holiday";
}

<style>
    .type-radio-card {
        border: 1px solid #e2e6ed;
        border-radius: 10px;
        padding: 10px 14px;
        cursor: pointer;
        transition: all 0.18s ease;
        flex: 1;
        text-align: center;
        background: #fff;
    }

        .type-radio-card:hover {
            border-color: #86b7fe;
            background: #f6f9ff;
        }

        .type-radio-card.checked {
            border-color: #0d6efd;
            background: #eef4ff;
            box-shadow: 0 0 0 1px #0d6efd inset;
            font-weight: 600;
        }
</style>

<div class="container-fluid py-4 text-start">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-bold mb-1"><i class="fa-solid fa-pen-to-square text-primary me-2"></i>Edit Holiday</h4>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0 small">
                    <li class="breadcrumb-item"><a href="/HR" class="text-decoration-none">HR Dashboard</a></li>
                    <li class="breadcrumb-item"><a href="/HRLeave/HolidayList" class="text-decoration-none">Holiday List</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Edit Holiday</li>
                </ol>
            </nav>
        </div>
    </div>

    <div class="bg-white border rounded-3 p-4 shadow-sm" style="max-width: 640px;">
        <form action="/HRLeave/EditHoliday" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="HolidayId" value="@Model.HolidayId" />

            <div class="mb-3">
                <label class="form-label small fw-semibold">Holiday Name</label>
                <input type="text" name="HolidayName" class="form-control" value="@Model.HolidayName" required />
            </div>

            <div class="mb-3">
                <label class="form-label small fw-semibold">Date</label>
                <input type="date" name="Date" class="form-control" value="@Model.Date.ToString("yyyy-MM-dd")" required />
            </div>

            <div class="mb-3">
                <label class="form-label small fw-semibold">Type</label>
                <div class="d-flex gap-2">
                    <label class="type-radio-card mb-0 small">
                        <input type="radio" class="d-none page-type-radio" name="Type" value="Mandatory" @(Model.Type == "Mandatory" ? "checked" : "") />
                        Mandatory
                    </label>
                    <label class="type-radio-card mb-0 small">
                        <input type="radio" class="d-none page-type-radio" name="Type" value="Optional" @(Model.Type == "Optional" ? "checked" : "") />
                        Optional
                    </label>
                    <label class="type-radio-card mb-0 small">
                        <input type="radio" class="d-none page-type-radio" name="Type" value="Restricted" @(Model.Type == "Restricted" ? "checked" : "") />
                        Restricted
                    </label>
                </div>
            </div>

            <div class="mb-4">
                <label class="form-label small fw-semibold">Description</label>
                <textarea name="Description" class="form-control" rows="3">@Model.Description</textarea>
            </div>

            <div class="d-flex justify-content-between">
                <button type="submit" form="deleteHolidayPageForm" class="btn btn-danger rounded-pill px-3 btn-sm">Delete</button>
                <div>
                    <a href="/HRLeave/HolidayList" class="btn btn-outline-secondary rounded-pill px-3 btn-sm">Cancel</a>
                    <button type="submit" class="btn btn-primary rounded-pill px-3 btn-sm">Save Changes</button>
                </div>
            </div>
        </form>

        <!-- Separate delete form; Delete button above targets it via form="deleteHolidayPageForm" -->
        <form id="deleteHolidayPageForm" action="/HRLeave/DeleteHoliday" method="post" onsubmit="return confirm('Delete this holiday?');" class="d-none">
            @Html.AntiForgeryToken()
            <input type="hidden" name="HolidayId" value="@Model.HolidayId" />
        </form>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        document.querySelectorAll(".page-type-radio").forEach(function (radio) {
            if (radio.checked) {
                radio.closest(".type-radio-card").classList.add("checked");
            }
            radio.addEventListener("change", function () {
                document.querySelectorAll(".type-radio-card").forEach(function (card) {
                    card.classList.remove("checked");
                });
                this.closest(".type-radio-card").classList.add("checked");
            });
        });
    });
</script>

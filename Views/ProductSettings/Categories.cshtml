@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Product Categories";
}

<div class="container-fluid py-4 text-start">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-bold mb-1"><i class="fa-solid fa-tags text-primary me-2"></i>Product Categories</h4>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0 small">
                    <li class="breadcrumb-item"><a href="/SalesDashboard" class="text-decoration-none">Sales Management</a></li>
                    <li class="breadcrumb-item">Product Management</li>
                    <li class="breadcrumb-item active" aria-current="page">Categories</li>
                </ol>
            </nav>
        </div>
        <button class="btn btn-primary rounded-pill px-3 shadow-sm"><i class="fa-solid fa-plus me-1.5"></i>Create Category</button>
    </div>

    <!-- Categories Grid Table -->
    <div class="bg-white border rounded-3 p-4 shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" style="font-size: 0.85rem;">
                <thead class="table-light">
                    <tr>
                        <th>Category Name</th>
                        <th>Product Count</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td class="fw-bold text-dark">Electronics</td>
                        <td>45 Products</td>
                        <td><span class="badge bg-success-subtle text-success rounded-pill px-2.5 py-1">Active</span></td>
                    </tr>
                    <tr>
                        <td class="fw-bold text-dark">Office Supplies</td>
                        <td>28 Products</td>
                        <td><span class="badge bg-success-subtle text-success rounded-pill px-2.5 py-1">Active</span></td>
                    </tr>
                    <tr>
                        <td class="fw-bold text-dark">Hardware</td>
                        <td>12 Products</td>
                        <td><span class="badge bg-success-subtle text-success rounded-pill px-2.5 py-1">Active</span></td>
                    </tr>
                    <tr>
                        <td class="fw-bold text-dark">General Items</td>
                        <td>10 Products</td>
                        <td><span class="badge bg-success-subtle text-success rounded-pill px-2.5 py-1">Active</span></td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

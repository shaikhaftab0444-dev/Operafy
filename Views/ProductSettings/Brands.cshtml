@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Product Brands";
}

<div class="container-fluid py-4 text-start">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-bold mb-1"><i class="fa-solid fa-copyright text-primary me-2"></i>Product Brands</h4>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0 small">
                    <li class="breadcrumb-item"><a href="/SalesDashboard" class="text-decoration-none">Sales Management</a></li>
                    <li class="breadcrumb-item">Product Management</li>
                    <li class="breadcrumb-item active" aria-current="page">Brands</li>
                </ol>
            </nav>
        </div>
        <button class="btn btn-primary rounded-pill px-3 shadow-sm"><i class="fa-solid fa-plus me-1.5"></i>Create Brand</button>
    </div>

    <!-- Brands Grid Table -->
    <div class="bg-white border rounded-3 p-4 shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" style="font-size: 0.85rem;">
                <thead class="table-light">
                    <tr>
                        <th>Brand Name</th>
                        <th>Origin Country</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td class="fw-bold text-dark">Dell</td>
                        <td>United States</td>
                        <td><span class="badge bg-success-subtle text-success rounded-pill px-2.5 py-1">Active</span></td>
                    </tr>
                    <tr>
                        <td class="fw-bold text-dark">Logitech</td>
                        <td>Switzerland</td>
                        <td><span class="badge bg-success-subtle text-success rounded-pill px-2.5 py-1">Active</span></td>
                    </tr>
                    <tr>
                        <td class="fw-bold text-dark">HP</td>
                        <td>United States</td>
                        <td><span class="badge bg-success-subtle text-success rounded-pill px-2.5 py-1">Active</span></td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Product Variants";
}

<div class="container-fluid py-4 text-start">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-bold mb-1"><i class="fa-solid fa-gears text-primary me-2"></i>Product Variants</h4>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0 small">
                    <li class="breadcrumb-item"><a href="/SalesDashboard" class="text-decoration-none">Sales Management</a></li>
                    <li class="breadcrumb-item">Product Management</li>
                    <li class="breadcrumb-item active" aria-current="page">Variants</li>
                </ol>
            </nav>
        </div>
        <button class="btn btn-primary rounded-pill px-3 shadow-sm"><i class="fa-solid fa-plus me-1.5"></i>Create Variant</button>
    </div>

    <!-- Variants Grid Table -->
    <div class="bg-white border rounded-3 p-4 shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" style="font-size: 0.85rem;">
                <thead class="table-light">
                    <tr>
                        <th>Variant Type</th>
                        <th>Options Values</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td class="fw-bold text-dark">Color</td>
                        <td>Black, Silver, White, Midnight Blue</td>
                        <td><span class="badge bg-success-subtle text-success rounded-pill px-2.5 py-1">Active</span></td>
                    </tr>
                    <tr>
                        <td class="fw-bold text-dark">Size</td>
                        <td>Small, Medium, Large, XL</td>
                        <td><span class="badge bg-success-subtle text-success rounded-pill px-2.5 py-1">Active</span></td>
                    </tr>
                    <tr>
                        <td class="fw-bold text-dark">Storage</td>
                        <td>128GB, 256GB, 512GB, 1TB</td>
                        <td><span class="badge bg-success-subtle text-success rounded-pill px-2.5 py-1">Active</span></td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Price Lists";
}

<div class="container-fluid py-4 text-start">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-bold mb-1"><i class="fa-solid fa-list-ol text-primary me-2"></i>Price Lists</h4>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0 small">
                    <li class="breadcrumb-item"><a href="/SalesDashboard" class="text-decoration-none">Sales Management</a></li>
                    <li class="breadcrumb-item">Product Management</li>
                    <li class="breadcrumb-item active" aria-current="page">Price Lists</li>
                </ol>
            </nav>
        </div>
        <button class="btn btn-primary rounded-pill px-3 shadow-sm"><i class="fa-solid fa-plus me-1.5"></i>Create Price List</button>
    </div>

    <!-- Price Lists Grid Table -->
    <div class="bg-white border rounded-3 p-4 shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" style="font-size: 0.85rem;">
                <thead class="table-light">
                    <tr>
                        <th>Price List Name</th>
                        <th>Pricing Rule</th>
                        <th>Active Currencies</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td class="fw-bold text-dark">Standard Retail Price List</td>
                        <td>Base Selling Price (100% standard retail)</td>
                        <td>INR, USD</td>
                        <td><span class="badge bg-success-subtle text-success rounded-pill px-2.5 py-1">Default Active</span></td>
                    </tr>
                    <tr>
                        <td class="fw-bold text-dark">Distributor Price List</td>
                        <td>Base Selling Price minus 15% discount</td>
                        <td>INR</td>
                        <td><span class="badge bg-success-subtle text-success rounded-pill px-2.5 py-1">Active</span></td>
                    </tr>
                    <tr>
                        <td class="fw-bold text-dark">Festive Promotion Price List</td>
                        <td>Specific item discounts (Flat 10% on electronics)</td>
                        <td>INR, USD</td>
                        <td><span class="badge bg-warning-subtle text-warning rounded-pill px-2.5 py-1">Scheduled</span></td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

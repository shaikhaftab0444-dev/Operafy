@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Stock Transfer Summary";
}

<div class="container-fluid py-4 text-start">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-bold mb-1"><i class="fa-solid fa-truck-moving text-primary me-2"></i>Stock Transfer Summary</h4>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0 small">
                    <li class="breadcrumb-item"><a href="/InventoryDashboard" class="text-decoration-none">Inventory Dashboard</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Transfer Summary</li>
                </ol>
            </nav>
        </div>
    </div>

    <!-- Transfer Summary Table -->
    <div class="bg-white border rounded-3 p-4 shadow-sm">
        <h5 class="fw-bold mb-3">Warehouse Stock Transfers</h5>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" style="font-size: 0.85rem;">
                <thead class="table-light">
                    <tr>
                        <th>Transfer Ticket No</th>
                        <th>Origin WH</th>
                        <th>Destination WH</th>
                        <th>Total Items Transferred</th>
                        <th>Completed Date</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td class="fw-bold text-dark">TR-90081</td>
                        <td>Main Central Warehouse</td>
                        <td>Transit Logistics Hub</td>
                        <td>35 Units</td>
                        <td class="text-muted">18 Aug 2026</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

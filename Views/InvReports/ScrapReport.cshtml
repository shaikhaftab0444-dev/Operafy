@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Scrap & Wastage Report";
}

<div class="container-fluid py-4 text-start">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-bold mb-1"><i class="fa-solid fa-trash text-primary me-2"></i>Scrap / Wastage Report</h4>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0 small">
                    <li class="breadcrumb-item"><a href="/InventoryDashboard" class="text-decoration-none">Inventory Dashboard</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Scrap Report</li>
                </ol>
            </nav>
        </div>
    </div>

    <!-- Scrap Table -->
    <div class="bg-white border rounded-3 p-4 shadow-sm">
        <h5 class="fw-bold mb-3">Wastage Analytics</h5>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" style="font-size: 0.85rem;">
                <thead class="table-light">
                    <tr>
                        <th>Month</th>
                        <th>Total Items Scrapped</th>
                        <th>Total Lost Asset Value</th>
                        <th>Primary Scrap Reason</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td class="fw-bold text-dark">August 2026</td>
                        <td class="text-danger fw-bold">17 Units</td>
                        <td class="text-danger fw-bold">₹24,500</td>
                        <td>Damaged during transit / Unloading</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

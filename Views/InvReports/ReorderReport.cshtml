@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Low Stock Reorder Report";
}

<div class="container-fluid py-4 text-start">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-bold mb-1"><i class="fa-solid fa-cart-shopping text-primary me-2"></i>Low Stock Reorder Report</h4>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0 small">
                    <li class="breadcrumb-item"><a href="/InventoryDashboard" class="text-decoration-none">Inventory Dashboard</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Reorder Report</li>
                </ol>
            </nav>
        </div>
    </div>

    <!-- Reorder Table -->
    <div class="bg-white border rounded-3 p-4 shadow-sm">
        <h5 class="fw-bold mb-3">Reorder Suggestions</h5>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" style="font-size: 0.85rem;">
                <thead class="table-light">
                    <tr>
                        <th>Item Name</th>
                        <th>Current Quantity</th>
                        <th>Safety Buffer</th>
                        <th>Suggested Reorder</th>
                        <th>Supplier Lead Time</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td class="fw-bold text-dark">Dell Wired Keyboard</td>
                        <td class="text-danger fw-bold">12 Units</td>
                        <td>30 Units</td>
                        <td class="text-success fw-bold">150 Units</td>
                        <td>3 Days</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

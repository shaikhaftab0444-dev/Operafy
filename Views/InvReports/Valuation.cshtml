@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Stock Valuation Report";
}

<div class="container-fluid py-4 text-start">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-bold mb-1"><i class="fa-solid fa-chart-line text-primary me-2"></i>Stock Valuation Report</h4>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0 small">
                    <li class="breadcrumb-item"><a href="/InventoryDashboard" class="text-decoration-none">Inventory Dashboard</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Stock Valuation</li>
                </ol>
            </nav>
        </div>
    </div>

    <!-- Valuation Table -->
    <div class="bg-white border rounded-3 p-4 shadow-sm">
        <h5 class="fw-bold mb-3">Inventory Asset Valuation</h5>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" style="font-size: 0.85rem;">
                <thead class="table-light">
                    <tr>
                        <th>Item Name</th>
                        <th>In Hand Qty</th>
                        <th>Average Unit Cost</th>
                        <th>Total Asset Value</th>
                        <th>Method</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td class="fw-bold text-dark">Dell Wired Keyboard</td>
                        <td>120 Units</td>
                        <td>₹1,200</td>
                        <td class="fw-bold text-success">₹1,44,000</td>
                        <td>Weighted Average</td>
                    </tr>
                    <tr>
                        <td class="fw-bold text-dark">Logitech Wireless Mouse</td>
                        <td>85 Units</td>
                        <td>₹800</td>
                        <td class="fw-bold text-success">₹68,000</td>
                        <td>Weighted Average</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

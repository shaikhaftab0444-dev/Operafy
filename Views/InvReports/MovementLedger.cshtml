@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Stock Movement Ledger";
}

<div class="container-fluid py-4 text-start">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-bold mb-1"><i class="fa-solid fa-list-check text-primary me-2"></i>Stock Movement Ledger</h4>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0 small">
                    <li class="breadcrumb-item"><a href="/InventoryDashboard" class="text-decoration-none">Inventory Dashboard</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Movement Ledger</li>
                </ol>
            </nav>
        </div>
    </div>

    <!-- Ledger Table -->
    <div class="bg-white border rounded-3 p-4 shadow-sm">
        <h5 class="fw-bold mb-3">Item Transaction History</h5>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" style="font-size: 0.85rem;">
                <thead class="table-light">
                    <tr>
                        <th>Date</th>
                        <th>Item Description</th>
                        <th>Action Type</th>
                        <th>Qty Delta</th>
                        <th>Location</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td class="text-muted">20 Aug 2026</td>
                        <td class="fw-bold text-dark">Dell Wired Keyboard</td>
                        <td><span class="badge bg-success-subtle text-success">Inward (GRN)</span></td>
                        <td class="text-success fw-bold">+100 Units</td>
                        <td>Main Central Warehouse</td>
                    </tr>
                    <tr>
                        <td class="text-muted">18 Aug 2026</td>
                        <td class="fw-bold text-dark">Logitech Wireless Mouse</td>
                        <td><span class="badge bg-danger-subtle text-danger">Outward (Dispatch)</span></td>
                        <td class="text-danger fw-bold">-15 Units</td>
                        <td>Transit Logistics Hub</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

@model IEnumerable<ERP_System.Models.User>
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "User Management";
}

<style>
    .panel-users {
        background: #ffffff;
        border: 1px solid var(--border-warm);
        border-radius: 12px;
        box-shadow: 0 1px 3px rgba(45,37,30,0.03);
    }
    
    .table-users th {
        background-color: #fcfbfa !important;
        font-size: 0.75rem;
        text-transform: uppercase;
        font-weight: 700;
        color: #7c7267;
        border-bottom: 1px solid var(--border-warm);
        padding: 1rem 1.25rem;
    }
    
    .table-users td {
        font-size: 0.875rem;
        color: var(--text-color);
        border-bottom: 1px solid var(--border-warm);
        padding: 1rem 1.25rem;
        vertical-align: middle;
    }

    .badge-active {
        background-color: rgba(16, 185, 129, 0.08);
        color: #10b981;
        font-weight: 600;
        border: 1px solid rgba(16, 185, 129, 0.2);
    }

    .badge-inactive {
        background-color: rgba(239, 68, 68, 0.08);
        color: #ef4444;
        font-weight: 600;
        border: 1px solid rgba(239, 68, 68, 0.2);
    }

    .btn-action-warm {
        border: 1px solid var(--border-warm);
        background-color: #ffffff;
        color: var(--text-color);
        font-size: 0.8rem;
        font-weight: 600;
        transition: all 0.2s;
    }
    .btn-action-warm:hover {
        background-color: #faf8f5;
        border-color: #cbd5e1;
        color: var(--primary-warm);
    }

    .btn-primary-warm {
        background: linear-gradient(135deg, var(--primary-warm) 0%, #6366f1 100%);
        color: #ffffff;
        border: none;
        font-weight: 600;
        font-size: 0.875rem;
        box-shadow: 0 4px 10px rgba(79, 70, 229, 0.2);
        transition: all 0.2s;
    }
    .btn-primary-warm:hover {
        transform: translateY(-1px);
        box-shadow: 0 6px 14px rgba(79, 70, 229, 0.3);
        color: #ffffff;
    }
</style>

<!-- Top Breadcrumbs & Page Header -->
<div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-3 mb-4">
    <div>
        <h4 class="fw-bold mb-1" style="color: var(--text-color);">User Management</h4>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0 small">
                <li class="breadcrumb-item"><a href="/Dashboard" class="text-decoration-none">Dashboard</a></li>
                <li class="breadcrumb-item active" aria-current="page">Users</li>
            </ol>
        </nav>
    </div>
    
    <a href="/UserAccounts/Create" class="btn btn-primary-warm px-4 py-2">
        <i class="fa-solid fa-user-plus me-2"></i> Add New User
    </a>
</div>

<!-- Notifications -->
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success border-0 shadow-sm alert-dismissible fade show mb-4 small text-start" role="alert" style="background-color: #f0fdf4; color: #15803d; border-left: 4px solid #16a34a !important;">
        <i class="fa-solid fa-circle-check me-2"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger border-0 shadow-sm alert-dismissible fade show mb-4 small text-start" role="alert" style="background-color: #fef2f2; color: #b91c1c; border-left: 4px solid #dc2626 !important;">
        <i class="fa-solid fa-circle-xmark me-2"></i> @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@{
    var rolesList = Model != null ? Model.Select(u => u.Role?.RoleName).Where(r => r != null).Distinct().OrderBy(r => r).ToList() : new List<string?>();
}

<!-- Search & Filter Controls -->
<div class="row g-3 mb-4 text-start">
    <!-- Search Input -->
    <div class="col-md-8">
        <div class="input-group-warm" style="border: 1px solid #d4cbbd; border-radius: 8px; background-color: #ffffff; display: flex; align-items: center; padding: 2px;">
            <span style="padding: 0.6rem 0.5rem 0.6rem 1rem; color: #7c7267;"><i class="fa-solid fa-magnifying-glass"></i></span>
            <input type="text" id="searchUser" class="form-control" style="border: none !important; box-shadow: none !important; background: transparent; font-size: 0.9rem; padding: 0.6rem 1rem 0.6rem 0;" placeholder="Search by name, email, username or code..." />
        </div>
    </div>
    
    <!-- Role Filter Dropdown -->
    <div class="col-md-4">
        <select id="filterRole" class="form-select" style="border: 1px solid #d4cbbd; border-radius: 8px; background-color: #ffffff; padding: 0.72rem 1rem; font-size: 0.9rem; font-weight: 600; outline: none; width: 100%; color: var(--text-color);">
            <option value="">All Roles (Filter by Role)</option>
            @foreach (var rName in rolesList)
            {
                <option value="@rName">@rName</option>
            }
        </select>
    </div>
</div>

<!-- Users Table Panel -->
<div class="panel-users overflow-hidden">
    <div class="table-responsive">
        <table class="table table-hover table-users mb-0 border-0">
            <thead>
                <tr>
                    <th class="border-0">User Code</th>
                    <th class="border-0">Full Name</th>
                    <th class="border-0">Username</th>
                    <th class="border-0">Email</th>
                    <th class="border-0">System Role</th>
                    <th class="border-0 text-center">Status</th>
                    <th class="border-0 text-center">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var user in Model)
                    {
                        var isRootAdmin = user.UserId == 1;
                        <tr>
                            <td class="fw-bold text-secondary">@user.UserCode</td>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <div class="avatar-sm rounded-circle d-flex align-items-center justify-content-center fw-bold" style="width: 28px; height: 28px; background-color: #faf6f0; color: var(--primary-warm); font-size: 0.75rem; border: 1.5px solid var(--primary-warm);">
                                        @user.FullName.Substring(0,1).ToUpper()
                                    </div>
                                    <span class="fw-bold text-dark">@user.FullName</span>
                                </div>
                            </td>
                            <td>@@@user.UserName</td>
                            <td>@user.Email</td>
                            <td>
                                <span class="badge bg-light text-dark border px-2.5 py-1.5 fw-bold" style="font-size: 0.75rem; border-color: var(--border-warm) !important;">
                                    <i class="fa-solid fa-shield-halved text-primary me-1" style="color: var(--primary-warm) !important;"></i>
                                    @(user.Role?.RoleName ?? "Employee")
                                </span>
                            </td>
                            <td class="text-center">
                                @if (user.IsActive)
                                {
                                    <span class="badge rounded-pill px-2.5 py-1.5 badge-active" style="font-size: 0.75rem;">Active</span>
                                }
                                else
                                {
                                    <span class="badge rounded-pill px-2.5 py-1.5 badge-inactive" style="font-size: 0.75rem;">Inactive</span>
                                }
                            </td>
                            <td class="text-center">
                                @if (!isRootAdmin)
                                {
                                    <form asp-action="ToggleStatus" asp-route-id="@user.UserId" method="post" style="display:inline;">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-action-warm px-3 py-1 rounded">
                                            @if (user.IsActive)
                                            {
                                                <i class="fa-solid fa-ban me-1"></i><span>Deactivate</span>
                                            }
                                            else
                                            {
                                                <i class="fa-solid fa-circle-check me-1"></i><span>Activate</span>
                                            }
                                        </button>
                                    </form>
                                    <form asp-action="Delete" asp-route-id="@user.UserId" method="post" style="display:inline;" onsubmit="return confirm('Are you sure you want to delete this user account? This action cannot be undone.');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-danger px-3 py-1 rounded ms-1" style="font-size: 0.8rem; font-weight: 600;">
                                            <i class="fa-solid fa-trash-can me-1"></i><span>Delete</span>
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <span class="text-muted small italic">System Protected</span>
                                }
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="text-center text-muted py-5">No user records found in the database.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", () => {
            const searchInput = document.getElementById("searchUser");
            const roleSelect = document.getElementById("filterRole");
            const tableRows = document.querySelectorAll(".table-users tbody tr");

            function filterTable() {
                const query = searchInput.value.toLowerCase().trim();
                const selectedRole = roleSelect.value.toLowerCase().trim();

                tableRows.forEach(row => {
                    if (row.cells.length < 5) return;

                    const code = row.cells[0].innerText.toLowerCase();
                    const name = row.cells[1].innerText.toLowerCase();
                    const username = row.cells[2].innerText.toLowerCase();
                    const email = row.cells[3].innerText.toLowerCase();
                    const role = row.cells[4].innerText.toLowerCase();

                    const matchesSearch = code.includes(query) || name.includes(query) || username.includes(query) || email.includes(query);
                    const matchesRole = selectedRole === "" || role.includes(selectedRole);

                    if (matchesSearch && matchesRole) {
                        row.style.display = "";
                    } else {
                        row.style.display = "none";
                    }
                });
            }

            searchInput.addEventListener("input", filterTable);
            roleSelect.addEventListener("change", filterTable);
        });
    </script>
}

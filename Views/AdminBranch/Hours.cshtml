        font-weight: 700;
    }

    .bh-table-wrap {
        overflow-x: auto;
        scrollbar-width: thin;
    }

    .bh-table {
        min-width: 1050px;
        margin: 0;
        border-collapse: separate;
        border-spacing: 0;
    }

        .bh-table thead th {
            background: #f8fafc;
            color: #64748b;
            border-bottom: 1px solid #e8edf3;
            padding: 13px 15px;
            font-size: .68rem;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: .55px;
            white-space: nowrap;
        }

        .bh-table tbody tr {
            position: relative;
            transition: background .25s ease, transform .25s ease, box-shadow .25s ease;
            animation: rowReveal .5s ease both;
        }

    @@keyframes rowReveal {
        from

    {
        opacity: 0;
        transform: translateY(9px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }

    }

    .bh-table tbody tr:nth-child(1) {
        animation-delay: .05s;
    }

    .bh-table tbody tr:nth-child(2) {
        animation-delay: .08s;
    }

    .bh-table tbody tr:nth-child(3) {
        animation-delay: .11s;
    }

    .bh-table tbody tr:nth-child(4) {
        animation-delay: .14s;
    }

    .bh-table tbody tr:nth-child(5) {
        animation-delay: .17s;
    }

    .bh-table tbody tr:nth-child(6) {
        animation-delay: .20s;
    }

    .bh-table tbody tr:nth-child(7) {
        animation-delay: .23s;
    }

    .bh-table tbody tr:nth-child(8) {
        animation-delay: .26s;
    }

    .bh-table tbody tr:nth-child(9) {
        animation-delay: .29s;
    }

    .bh-table tbody tr:nth-child(10) {
        animation-delay: .32s;
    }

    .bh-table tbody tr:hover {
        background: #fbfdff;
    }

    .bh-table tbody td {
        padding: 14px 15px;
        border-bottom: 1px solid #f0f2f5;
        color: #475569;
        font-size: .78rem;
        vertical-align: middle;
    }

    .bh-table tbody tr:last-child td {
        border-bottom: 0;
    }


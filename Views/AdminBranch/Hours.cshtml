@model IEnumerable<ERP_System.Models.AdminBranchHour>
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Branch Working Hours";
}

<div class="container-fluid py-4 text-start">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-bold mb-1"><i class="fa-solid fa-clock text-primary me-2"></i>Branch Working Hours</h4>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0 small">
                    <li class="breadcrumb-item"><a href="/Dashboard" class="text-decoration-none">Admin Dashboard</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Branch Hours</li>
                </ol>
            </nav>
        </div>
        <button class="btn btn-primary rounded-pill px-3 btn-sm shadow-sm" data-bs-toggle="modal" data-bs-target="#hourModal">
            <i class="fa-solid fa-plus me-1.5"></i>Log Working Hours
        </button>
    </div>

    <!-- Working Hours Grid -->
    <div class="bg-white border rounded-3 p-4 shadow-sm" style="max-width: 800px;">
        <h5 class="fw-bold mb-3">Timings Setup</h5>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" style="font-size: 0.85rem;">
                <thead class="table-light">
                    <tr>
                        <th>Branch Name</th>
                        <th>Opening Time</th>
                        <th>Closing Time</th>
                        <th>Off Day</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var h in Model)
                        {
                            <tr>
                                <td class="fw-bold text-dark">@h.BranchName</td>
                                <td>@h.OpeningTime</td>
                                <td>@h.ClosingTime</td>
                                <td><span class="badge bg-secondary-subtle text-secondary">@h.OffDay</span></td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Working Hours Modal -->
<div class="modal fade text-start" id="hourModal" tabindex="-1" aria-labelledby="hourModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form action="/AdminBranch/SaveHours" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title fw-bold" id="hourModalLabel">Log Branch Working Hours</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Branch Name</label>
                        <input type="text" name="BranchName" class="form-control" placeholder="e.g. Bangalore Branch" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Opening Time</label>
                        <input type="text" name="OpeningTime" class="form-control" placeholder="e.g. 09:00 AM" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Closing Time</label>
                        <input type="text" name="ClosingTime" class="form-control" placeholder="e.g. 06:00 PM" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Off Day</label>
                        <input type="text" name="OffDay" class="form-control" placeholder="e.g. Sunday" required />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary rounded-pill px-3 btn-sm" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary rounded-pill px-3 btn-sm">Save Hours</button>
                </div>
            </form>
        </div>
    </div>
</div>

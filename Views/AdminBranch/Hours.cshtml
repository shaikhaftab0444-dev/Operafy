        grid-template-columns: repeat(7, 1fr);
        gap: 8px;
        padding: 12px;
        border: 1px solid #e2e8f0;
        background: #f8fafc;
        border-radius: 12px;
    }

    .bh-day {
        position: relative;
    }

        .bh-day input {
            position: absolute;
            opacity: 0;
            pointer-events: none;
        }

        .bh-day label {
            min-height: 38px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 9px;
            border: 1px solid #e2e8f0;
            background: white;
            color: #64748b;
            font-size: .72rem;
            font-weight: 800;
            cursor: pointer;
            transition: all .2s ease;
            user-select: none;
        }

            .bh-day label:hover {
                border-color: #bfdbfe;
                color: var(--bh-primary);
                transform: translateY(-1px);
            }

        .bh-day input:checked + label {
            color: white;
            border-color: var(--bh-primary);
            background: var(--bh-primary);
            box-shadow: 0 6px 14px rgba(37,99,235,.18);
        }

    /* =========================================================
           MODAL FOOTER
        ========================================================= */

    .bh-modal-footer {
        padding: 14px 21px;
        background: #f8fafc;
        border-top: 1px solid #e8edf3;
        display: flex;
        justify-content: flex-end;
        gap: 8px;
    }

    .bh-cancel-btn,
    .bh-save-btn {
        border-radius: 10px;
        padding: 9px 16px;
        font-size: .78rem;
        font-weight: 800;
        transition: all .2s ease;
    }

    .bh-cancel-btn {
        color: #64748b;
        border: 1px solid #dbe2ea;
        background: white;
    }

        .bh-cancel-btn:hover {
            background: #f1f5f9;
            color: var(--bh-text);
        }

    .bh-save-btn {
        color: white;
        border: 0;
        background: linear-gradient(135deg, var(--bh-primary), #4f46e5);
        box-shadow: 0 7px 16px rgba(37,99,235,.18);
    }

        .bh-save-btn:hover {
            color: white;
            transform: translateY(-1px);
            box-shadow: 0 10px 22px rgba(37,99,235,.25);
        }

    /* =========================================================
           MODAL SWITCH / SETTINGS
        ========================================================= */

    .bh-setting-card {
        height: 100%;
        padding: 13px 14px;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        background: #fafcff;
        transition: all .22s ease;
    }

        .bh-setting-card:hover {
            border-color: #cbd5e1;
            background: #fff;
        }

    .bh-setting-title {
        color: var(--bh-text);
        font-size: .75rem;
        font-weight: 800;
    }

    .bh-setting-description {
        color: #94a3b8;
        font-size: .64rem;
        margin-top: 2px;
    }

    /* =========================================================
           SWEET ALERT
        ========================================================= */

    .swal2-popup {
        border-radius: 18px !important;
    }

    .swal2-confirm,
    .swal2-cancel {
        border-radius: 9px !important;
    }

    /* =========================================================
           RESPONSIVE
        ========================================================= */

    @@media (max-width: 1200px) {
        .bh-stat-grid

    {
        grid-template-columns: repeat(2, 1fr);
    }

    .bh-table {
        min-width: 1000px;
    }

    }

    @@media (max-width: 768px) {
        .branch-hours-page

    {
        padding-bottom: 20px;
    }

    .bh-title-row {
        align-items: flex-start;
    }

    .bh-title-icon {
        width: 42px;
        height: 42px;
        min-width: 42px;
        font-size: 17px;
    }

    .bh-title {
        font-size: 1.25rem;
    }

    .bh-subtitle {
        font-size: .75rem;
    }

    .bh-header-actions {
        width: 100%;
    }

    .bh-primary-btn {
        width: 100%;
        justify-content: center;
    }

    .bh-stat-grid {
        grid-template-columns: 1fr 1fr;
        gap: 10px;
    }

    .bh-stat-card {
        padding: 13px;
    }

    .bh-stat-icon {
        width: 38px;
        height: 38px;
        min-width: 38px;
    }

    .bh-stat-value {
        font-size: 1.15rem;
    }

    .bh-stat-label {
        font-size: .61rem;
    }

    .bh-search-panel {
        padding: 14px;
    }

    .bh-search-header {
        align-items: flex-start;
        flex-direction: column;
    }

    .bh-search-hint {
        display: none;
    }

    .bh-search-input {
        padding-right: 10px !important;
    }

    .bh-search-actions {
        position: static;
        margin-top: 8px;
        height: 40px;
    }

    .bh-search-btn,
    .bh-reset-btn {
        flex: 1;
        justify-content: center;
    }

    .bh-table-header {
        padding: 15px;
    }

    .bh-table-title p {
        display: none;
    }

    .bh-record-count {
        font-size: .64rem;
    }

    .bh-modal .modal-dialog {
        margin: 10px;
    }

    .bh-modal-body {
        padding: 17px;
    }

    .bh-days-container {
        grid-template-columns: repeat(4, 1fr);
    }

    }

    @@media (max-width: 480px) {
        .bh-stat-grid

    {
        grid-template-columns: 1fr;
    }

    .bh-title-row {
        gap: 10px;
    }

    .bh-title {
        font-size: 1.12rem;
    }

    .bh-breadcrumb {
        font-size: .68rem;
    }

    .bh-days-container {
        grid-template-columns: repeat(2, 1fr);
    }

    .bh-modal-footer {
        flex-direction: column-reverse;
    }

    .bh-cancel-btn,
    .bh-save-btn {
        width: 100%;
    }

    }

    /* =========================================================
           ACCESSIBILITY
        ========================================================= */

    @@media (prefers-reduced-motion: reduce) {
        *, *::before, *::after

    {
        animation-duration: .01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: .01ms !important;
        scroll-behavior: auto !important;
    }

    }
</style>

<div class="branch-hours-page">
    <div class="container-fluid py-4 text-start bh-container">

        <!-- =====================================================
             HEADER
        ====================================================== -->
        <div class="bh-header">
            <div class="d-flex flex-column flex-lg-row justify-content-between align-items-start align-items-lg-center gap-3">

                <div>
                    <div class="bh-breadcrumb">
                        <a href="/Dashboard" class="text-decoration-none">
                            <i class="fa-solid fa-house me-1"></i>Admin Dashboard
                        </a>

                        <span class="separator">
                            <i class="fa-solid fa-chevron-right"></i>
                        </span>

                        <span>Master Setup</span>

                        <span class="separator">
                            <i class="fa-solid fa-chevron-right"></i>
                        </span>

                        <span>Branch Hours</span>
                    </div>

                    <div class="bh-title-row">
                        <div class="bh-title-icon">
                            <i class="fa-solid fa-clock"></i>
                        </div>

                        <div>
                            <h1 class="bh-title">Branch Working Hours</h1>
                            <p class="bh-subtitle">
                                Manage operating schedules, grace periods, breaks and weekly-off policies.
                            </p>
                        </div>
                    </div>
                </div>

                <div class="bh-header-actions">
                    <button type="button"
                            class="btn bh-primary-btn"
                            data-bs-toggle="modal"
                            data-bs-target="#addHoursModal">
                        <i class="fa-solid fa-plus me-2"></i>
                        Set Branch Hours
                    </button>
                </div>
            </div>
        </div>

        <!-- =====================================================
             SUMMARY CARDS
        ====================================================== -->
        <div class="bh-stat-grid">

            <div class="bh-stat-card">
                <div class="bh-stat-content">
                    <div class="bh-stat-icon blue">
                        <i class="fa-solid fa-building"></i>
                    </div>

                    <div>
                        <div class="bh-stat-label">Total Profiles</div>
                        <div class="bh-stat-value">@totalHours</div>
                    </div>
                </div>
            </div>

            <div class="bh-stat-card">
                <div class="bh-stat-content">
                    <div class="bh-stat-icon green">
                        <i class="fa-solid fa-circle-check"></i>
                    </div>

                    <div>
                        <div class="bh-stat-label">Active</div>
                        <div class="bh-stat-value">@activeHours</div>
                    </div>
                </div>
            </div>

            <div class="bh-stat-card">
                <div class="bh-stat-content">
                    <div class="bh-stat-icon orange">
                        <i class="fa-solid fa-circle-pause"></i>
                    </div>

                    <div>
                        <div class="bh-stat-label">Inactive</div>
                        <div class="bh-stat-value">@inactiveHours</div>
                    </div>
                </div>
            </div>

            <div class="bh-stat-card">
                <div class="bh-stat-content">
                    <div class="bh-stat-icon purple">
                        <i class="fa-solid fa-arrows-spin"></i>
                    </div>

                    <div>
                        <div class="bh-stat-label">24/7 Operations</div>
                        <div class="bh-stat-value">@continuousShifts</div>
                    </div>
                </div>
            </div>

        </div>

        <!-- =====================================================
             ALERTS
        ====================================================== -->
        @if (TempData["SuccessMessage"] != null)
        {
            <script>
                document.addEventListener("DOMContentLoaded", function () {
                    Swal.fire({
                        icon: "success",
                        title: "Action Completed",
                        text: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(TempData["SuccessMessage"])),
                        confirmButtonColor: "#2563eb",
                        confirmButtonText: "Continue",
                        timer: 3500,
                        timerProgressBar: true
                    });
                });
            </script>
        }

        @if (TempData["ErrorMessage"] != null)
        {
            <script>
                document.addEventListener("DOMContentLoaded", function () {
                    Swal.fire({
                        icon: "error",
                        title: "System Error",
                        text: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(TempData["ErrorMessage"])),
                        confirmButtonColor: "#ef4444",
                        confirmButtonText: "Close"
                    });
                });
            </script>
        }

        <!-- =====================================================
             SEARCH PANEL
        ====================================================== -->
        <div class="bh-panel bh-search-panel">

            <div class="bh-search-header">
                <h2 class="bh-section-title">
                    <i class="fa-solid fa-sliders"></i>
                    Branch Schedule Lookup
                </h2>

                <span class="bh-search-hint">
                    Search instantly by branch name
                </span>
            </div>

            <form method="get"
                  action="/AdminBranch/Hours"
                  id="searchForm">

                <div class="bh-search-box">

                    <i class="fa-solid fa-magnifying-glass bh-search-icon"></i>

                    <input type="text"
                           class="form-control bh-search-input"
                           id="hoursSearch"
                           name="search"
                           value="@Model.SearchTerm"
                           placeholder="Search branch work timings by branch name..." />

                    <div class="bh-search-actions">

                        <button type="submit"
                                class="btn bh-search-btn">
                            <i class="fa-solid fa-magnifying-glass me-1"></i>
                            Search
                        </button>

                        @if (!string.IsNullOrEmpty(Model.SearchTerm))
                        {
                            <a href="/AdminBranch/Hours"
                               class="btn bh-reset-btn">
                                <i class="fa-solid fa-rotate-left me-1"></i>
                                Reset
                            </a>
                        }

                    </div>

                </div>

            </form>
        </div>

        <!-- =====================================================
             TABLE
        ====================================================== -->
        <div class="bh-panel bh-table-panel">

            <div class="bh-table-header">

                <div class="bh-table-title">

                    <div class="bh-table-title-icon">
                        <i class="fa-solid fa-calendar-days"></i>
                    </div>

                    <div>
                        <h5>Branch Operating Schedules</h5>
                        <p>Configured working-hour policies for each branch</p>
                    </div>

                </div>

                <span class="bh-record-count">
                    @totalHours Profile@(totalHours == 1 ? "" : "s")
                </span>

            </div>

            <div class="bh-table-wrap">

                <table class="table bh-table align-middle mb-0">

                    <thead>
                        <tr>
                            <th style="width:21%;">Branch Location</th>
                            <th style="width:17%;">Operating Timings</th>
                            <th style="width:11%;">Grace Period</th>
                            <th style="width:11%;">Break Interval</th>
                            <th style="width:12%;">Weekly Off</th>
                            <th style="width:10%;">Half-Day</th>
                            <th style="width:9%;">Status</th>
                            <th class="text-center" style="width:9%;">Actions</th>
                        </tr>
                    </thead>

                    <tbody>

                        @if (Model.Hours == null || Model.Hours.Count == 0)
                        {
                            <tr>
                                <td colspan="8" class="bh-empty">

                                    <div class="bh-empty-icon">
                                        <i class="fa-regular fa-calendar-xmark"></i>
                                    </div>

                                    <div class="bh-empty-title">
                                        No Branch Hours Found
                                    </div>

                                    <p class="bh-empty-text">
                                        No working-hour profiles match your current search criteria.
                                    </p>

                                </td>
                            </tr>
                        }
                        else
                        {
                            foreach (var h in Model.Hours)
                            {
                                var offCode = h.OffDay == "Sunday"
                                ? "All Sundays"
                                : h.OffDay;

                                <tr class="hours-row">

                                    <!-- Branch -->
                                    <td>
                                        <div class="bh-branch-cell">

                                            <div class="bh-branch-icon">
                                                <i class="fa-solid fa-building"></i>
                                            </div>

                                            <div>
                                                <div class="bh-branch-name branch-name">
                                                    @h.BranchName
                                                </div>

                                                <span class="bh-id-badge">
                                                    ID: @h.BranchId
                                                </span>
                                            </div>

                                        </div>
                                    </td>

                                    <!-- Operating Time -->
                                    <td>

                                        @if (h.IsContinuousShift)
                                        {
                                            <span class="bh-continuous">
                                                <i class="fa-solid fa-arrows-spin"></i>
                                                24/7 Operations
                                            </span>
                                        }
                                        else
                                        {
                                            <div class="bh-time-box">
                                                <i class="fa-regular fa-clock"></i>
                                                <span>
                                                    @h.OpeningTime
                                                    <span class="text-muted mx-1">–</span>
                                                    @h.ClosingTime
                                                </span>
                                            </div>
                                        }

                                    </td>

                                    <!-- Grace -->
                                    <td>
                                        <span class="bh-info-badge warning">
                                            <i class="fa-regular fa-clock"></i>
                                            @h.GracePeriod min
                                        </span>
                                    </td>

                                    <!-- Break -->
                                    <td>
                                        <span class="bh-info-badge info">
                                            <i class="fa-solid fa-mug-hot"></i>
                                            @h.BreakDuration min
                                        </span>
                                    </td>

                                    <!-- Weekly Off -->
                                    <td>
                                        <span class="bh-info-badge neutral">
                                            <i class="fa-solid fa-calendar-minus"></i>
                                            @offCode
                                        </span>
                                    </td>

                                    <!-- Half Day -->
                                    <td>
                                        <span class="bh-half-day">
                                            <i class="fa-solid fa-hourglass-half me-1 text-primary"></i>
                                            @h.HalfDayMinHours.ToString("F1") Hrs
                                        </span>
                                    </td>

                                    <!-- Status -->
                                    <td>

                                        @if (h.IsActive)
                                        {
                                            <span class="bh-status active">
                                                Active
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="bh-status inactive">
                                                Inactive
                                            </span>
                                        }

                                    </td>

                                    <!-- Actions -->
                                    <td>

                                        <div class="bh-actions">

                                            <!-- EDIT -->
                                            <button type="button"
                                                    class="btn bh-action-btn bh-edit-btn"
                                                    title="Edit Working Hours"
                                                    onclick="openEditModal(this)"
                                                    data-id="@h.HourId"
                                                    data-branch-id="@h.BranchId"
                                                    data-open-time="@h.OpeningTime"
                                                    data-close-time="@h.ClosingTime"
                                                    data-off-day="@h.OffDay"
                                                    data-grace="@h.GracePeriod"
                                                    data-break="@h.BreakDuration"
                                                    data-half-day="@h.HalfDayMinHours.ToString("F1")"
                                                    data-continuous="@h.IsContinuousShift.ToString().ToLowerInvariant()"
                                                    data-active="@h.IsActive.ToString().ToLowerInvariant()"
                                                    data-date="@h.EffectiveDate.ToString("yyyy-MM-dd")">

                                                <i class="fa-solid fa-pen-to-square"></i>

                                            </button>

                                            <!-- TOGGLE -->
                                            <form method="post"
                                                  action="/AdminBranch/ToggleHoursStatus"
                                                  class="d-inline">

                                                @Html.AntiForgeryToken()

                                                <input type="hidden"
                                                       name="id"
                                                       value="@h.HourId" />

                                                <div class="form-check form-switch bh-switch">

                                                    <input class="form-check-input"
                                                           type="checkbox"
                                                           role="switch"
                                                           checked="@(h.IsActive ? "checked" : null)"
                                                           onchange="this.form.submit()"
                                                           title="Toggle Status" />

                                                </div>

                                            </form>

                                            <!-- DELETE -->
                                            <form method="post"
                                                  action="/AdminBranch/DeleteHours"
                                                  class="d-inline delete-form">

                                                @Html.AntiForgeryToken()

                                                <input type="hidden"
                                                       name="id"
                                                       value="@h.HourId" />

                                                <button type="button"
                                                        onclick="confirmDelete(this)"
                                                        class="btn bh-action-btn bh-delete-btn"
                                                        title="Delete Settings">

                                                    <i class="fa-solid fa-trash-can"></i>

                                                </button>

                                            </form>

                                        </div>

                                    </td>

                                </tr>
                            }
                        }

                    </tbody>

                </table>

            </div>
        </div>

    </div>
</div>


<!-- =========================================================
     ADD WORKING HOURS MODAL
========================================================= -->
<div class="modal fade bh-modal"
     id="addHoursModal"
     tabindex="-1"
     aria-labelledby="addHoursModalTitle"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered modal-lg">

        <div class="modal-content">

            <div class="modal-header bh-modal-header">

                <h5 class="bh-modal-title" id="addHoursModalTitle">

                    <span class="bh-modal-title-icon">
                        <i class="fa-solid fa-clock-rotate-left"></i>
                    </span>

                    Establish Branch Work Shift

                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Close"></button>

            </div>

            <form method="post"
                  action="/AdminBranch/SaveHours"
                  id="addHoursForm">

                @Html.AntiForgeryToken()

                <input type="hidden"
                       asp-for="Hour.OffDay"
                       id="addOffDayHidden" />

                <div class="modal-body bh-modal-body">

                    <div class="row g-3">

                        <!-- Branch -->
                        <div class="col-md-6">
                            <label class="bh-form-label">
                                Assign Branch
                                <span class="bh-required">*</span>
                            </label>

                            <select asp-for="Hour.BranchId"
                                    class="form-select bh-form-select"
                                    required>

                                <option value="">
                                    -- Choose Branch --
                                </option>

                                @foreach (var b in Model.Branches)
                                {
                                    <option value="@b.BranchId">
                                        @b.BranchName
                                    </option>
                                }

                            </select>

                            <span asp-validation-for="Hour.BranchId"
                                  class="text-danger small"></span>
                        </div>

                        <!-- Effective Date -->
                        <div class="col-md-6">
                            <label class="bh-form-label">
                                Effective Starting Date
                                <span class="bh-required">*</span>
                            </label>

                            <input type="date"
                                   asp-for="Hour.EffectiveDate"
                                   class="form-control bh-form-control"
                                   required />

                            <span asp-validation-for="Hour.EffectiveDate"
                                  class="text-danger small"></span>
                        </div>

                        <!-- Opening -->
                        <div class="col-md-6">
                            <label class="bh-form-label">
                                <i class="fa-regular fa-sun text-warning"></i>
                                Shift Opening Time
                                <span class="bh-required">*</span>
                            </label>

                            <input type="text"
                                   asp-for="Hour.OpeningTime"
                                   class="form-control bh-form-control font-monospace"
                                   placeholder="e.g. 09:00 AM"
                                   required />

                            <span asp-validation-for="Hour.OpeningTime"
                                  class="text-danger small"></span>
                        </div>

                        <!-- Closing -->
                        <div class="col-md-6">
                            <label class="bh-form-label">
                                <i class="fa-regular fa-moon text-primary"></i>
                                Shift Closing Time
                                <span class="bh-required">*</span>
                            </label>

                            <input type="text"
                                   asp-for="Hour.ClosingTime"
                                   class="form-control bh-form-control font-monospace"
                                   placeholder="e.g. 06:00 PM"
                                   required />

                            <span asp-validation-for="Hour.ClosingTime"
                                  class="text-danger small"></span>
                        </div>

                        <!-- Grace -->
                        <div class="col-md-4">
                            <label class="bh-form-label">
                                Clock-In Grace
                            </label>

                            <input type="number"
                                   asp-for="Hour.GracePeriod"
                                   class="form-control bh-form-control"
                                   placeholder="15"
                                   min="0"
                                   required />

                            <div class="bh-help-text">
                                Allowed late arrival in minutes
                            </div>
                        </div>

                        <!-- Break -->
                        <div class="col-md-4">
                            <label class="bh-form-label">
                                Lunch Break
                            </label>

                            <input type="number"
                                   asp-for="Hour.BreakDuration"
                                   class="form-control bh-form-control"
                                   placeholder="45"
                                   min="0"
                                   required />

                            <div class="bh-help-text">
                                Break duration in minutes
                            </div>
                        </div>

                        <!-- Half Day -->
                        <div class="col-md-4">
                            <label class="bh-form-label">
                                Half-Day Threshold
                            </label>

                            <input type="number"
                                   step="0.5"
                                   asp-for="Hour.HalfDayMinHours"
                                   class="form-control bh-form-control"
                                   placeholder="4.5"
                                   min="0"
                                   required />

                            <div class="bh-help-text">
                                Minimum working hours
                            </div>
                        </div>

                        <!-- Weekly Off -->
                        <div class="col-12">

                            <label class="bh-form-label">
                                <i class="fa-solid fa-calendar-week text-primary"></i>
                                Select Weekly Off Days
                            </label>

                            <div class="bh-days-container">

                                @foreach (var day in new[]
                                                                {
                                                                "Monday",
                                                                "Tuesday",
                                                                "Wednesday",
                                                                "Thursday",
                                                                "Friday",
                                                                "Saturday",
                                                                "Sunday"
                                                                })
                                {
                                    <div class="bh-day">

                                        <input class="add-off-check"
                                               type="checkbox"
                                               id="addOff-@day"
                                               value="@day"
                                               checked="@(day == "Sunday" ? "checked" : null)" />

                                        <label for="addOff-@day">
                                            @day.Substring(0, 3)
                                        </label>

                                    </div>
                                }

                            </div>

                        </div>

                        <!-- Settings -->
                        <div class="col-md-6">

                            <div class="bh-setting-card">

                                <div class="d-flex justify-content-between align-items-center gap-3">

                                    <div>
                                        <div class="bh-setting-title">
                                            24/7 Operations
                                        </div>

                                        <div class="bh-setting-description">
                                            Enable continuous operation mode
                                        </div>
                                    </div>

                                    <div class="form-check form-switch bh-switch">

                                        <input class="form-check-input"
                                               type="checkbox"
                                               asp-for="Hour.IsContinuousShift"
                                               id="addIsContinuous" />

                                    </div>

                                </div>

                            </div>

                        </div>

                        <div class="col-md-6">

                            <div class="bh-setting-card">

                                <div class="d-flex justify-content-between align-items-center gap-3">

                                    <div>
                                        <div class="bh-setting-title">
                                            Active & Enforced
                                        </div>

                                        <div class="bh-setting-description">
                                            Apply this schedule immediately
                                        </div>
                                    </div>

                                    <div class="form-check form-switch bh-switch">

                                        <input class="form-check-input"
                                               type="checkbox"
                                               asp-for="Hour.IsActive"
                                               checked />

                                    </div>

                                </div>

                            </div>

                        </div>

                    </div>

                </div>

                <div class="modal-footer bh-modal-footer">

                    <button type="button"
                            class="btn bh-cancel-btn"
                            data-bs-dismiss="modal">
                        Cancel
                    </button>

                    <button type="submit"
                            class="btn bh-save-btn">
                        <i class="fa-solid fa-floppy-disk me-2"></i>
                        Save Timings
                    </button>

                </div>

            </form>

        </div>
    </div>
</div>


<!-- =========================================================
     EDIT WORKING HOURS MODAL
========================================================= -->
<div class="modal fade bh-modal"
     id="editHoursModal"
     tabindex="-1"
     aria-labelledby="editHoursModalTitle"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered modal-lg">

        <div class="modal-content">

            <div class="modal-header bh-modal-header">

                <h5 class="bh-modal-title" id="editHoursModalTitle">

                    <span class="bh-modal-title-icon">
                        <i class="fa-solid fa-pen-to-square"></i>
                    </span>

                    Modify Branch Timings

                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Close"></button>

            </div>

            <form method="post"
                  action="/AdminBranch/SaveHours"
                  id="editHoursForm">

                @Html.AntiForgeryToken()

                <input type="hidden"
                       asp-for="Hour.HourId"
                       id="editHourId" />

                <input type="hidden"
                       asp-for="Hour.OffDay"
                       id="editOffDayHidden" />

                <div class="modal-body bh-modal-body">

                    <div class="row g-3">

                        <!-- Branch -->
                        <div class="col-md-6">

                            <label class="bh-form-label">
                                Assign Branch
                                <span class="bh-required">*</span>
                            </label>

                            <select asp-for="Hour.BranchId"
                                    id="editBranchId"
                                    class="form-select bh-form-select"
                                    required>

                                @foreach (var b in Model.Branches)
                                {
                                    <option value="@b.BranchId">
                                        @b.BranchName
                                    </option>
                                }

                            </select>

                            <span asp-validation-for="Hour.BranchId"
                                  class="text-danger small"></span>

                        </div>

                        <!-- Date -->
                        <div class="col-md-6">

                            <label class="bh-form-label">
                                Effective Starting Date
                                <span class="bh-required">*</span>
                            </label>

                            <input type="date"
                                   asp-for="Hour.EffectiveDate"
                                   id="editEffectiveDate"
                                   class="form-control bh-form-control"
                                   required />

                            <span asp-validation-for="Hour.EffectiveDate"
                                  class="text-danger small"></span>

                        </div>

                        <!-- Opening -->
                        <div class="col-md-6">

                            <label class="bh-form-label">
                                <i class="fa-regular fa-sun text-warning"></i>
                                Shift Opening Time
                            </label>

                            <input type="text"
                                   asp-for="Hour.OpeningTime"
                                   id="editOpeningTime"
                                   class="form-control bh-form-control font-monospace"
                                   placeholder="e.g. 09:00 AM"
                                   required />

                            <span asp-validation-for="Hour.OpeningTime"
                                  class="text-danger small"></span>

                        </div>

                        <!-- Closing -->
                        <div class="col-md-6">

                            <label class="bh-form-label">
                                <i class="fa-regular fa-moon text-primary"></i>
                                Shift Closing Time
                            </label>

                            <input type="text"
                                   asp-for="Hour.ClosingTime"
                                   id="editClosingTime"
                                   class="form-control bh-form-control font-monospace"
                                   placeholder="e.g. 06:00 PM"
                                   required />

                            <span asp-validation-for="Hour.ClosingTime"
                                  class="text-danger small"></span>

                        </div>

                        <!-- Grace -->
                        <div class="col-md-4">

                            <label class="bh-form-label">
                                Clock-In Grace
                            </label>

                            <input type="number"
                                   asp-for="Hour.GracePeriod"
                                   id="editGracePeriod"
                                   class="form-control bh-form-control"
                                   min="0"
                                   required />

                        </div>

                        <!-- Break -->
                        <div class="col-md-4">

                            <label class="bh-form-label">
                                Lunch Break
                            </label>

                            <input type="number"
                                   asp-for="Hour.BreakDuration"
                                   id="editBreakDuration"
                                   class="form-control bh-form-control"
                                   min="0"
                                   required />

                        </div>

                        <!-- Half Day -->
                        <div class="col-md-4">

                            <label class="bh-form-label">
                                Half-Day Threshold
                            </label>

                            <input type="number"
                                   step="0.5"
                                   asp-for="Hour.HalfDayMinHours"
                                   id="editHalfDayMinHours"
                                   class="form-control bh-form-control"
                                   min="0"
                                   required />

                        </div>

                        <!-- Weekly Off -->
                        <div class="col-12">

                            <label class="bh-form-label">
                                <i class="fa-solid fa-calendar-week text-primary"></i>
                                Select Weekly Off Days
                            </label>

                            <div class="bh-days-container">

                                @foreach (var day in new[]
                                                                {
                                                                "Monday",
                                                                "Tuesday",
                                                                "Wednesday",
                                                                "Thursday",
                                                                "Friday",
                                                                "Saturday",
                                                                "Sunday"
                                                                })
                                {
                                    <div class="bh-day">

                                        <input class="edit-off-check"
                                               type="checkbox"
                                               id="editOff-@day"
                                               value="@day" />

                                        <label for="editOff-@day">
                                            @day.Substring(0, 3)
                                        </label>

                                    </div>
                                }

                            </div>

                        </div>

                        <!-- Continuous -->
                        <div class="col-md-6">

                            <div class="bh-setting-card">

                                <div class="d-flex justify-content-between align-items-center gap-3">

                                    <div>
                                        <div class="bh-setting-title">
                                            24/7 Operations
                                        </div>

                                        <div class="bh-setting-description">
                                            Continuous operation mode
                                        </div>
                                    </div>

                                    <div class="form-check form-switch bh-switch">

                                        <input class="form-check-input"
                                               type="checkbox"
                                               asp-for="Hour.IsContinuousShift"
                                               id="editIsContinuous" />

                                    </div>

                                </div>

                            </div>

                        </div>

                        <!-- Active -->
                        <div class="col-md-6">

                            <div class="bh-setting-card">

                                <div class="d-flex justify-content-between align-items-center gap-3">

                                    <div>
                                        <div class="bh-setting-title">
                                            Active & Enforced
                                        </div>

                                        <div class="bh-setting-description">
                                            Apply this schedule
                                        </div>
                                    </div>

                                    <div class="form-check form-switch bh-switch">

                                        <input class="form-check-input"
                                               type="checkbox"
                                               asp-for="Hour.IsActive"
                                               id="editIsActive" />

                                    </div>

                                </div>

                            </div>

                        </div>

                    </div>

                </div>

                <div class="modal-footer bh-modal-footer">

                    <button type="button"
                            class="btn bh-cancel-btn"
                            data-bs-dismiss="modal">
                        Cancel
                    </button>

                    <button type="submit"
                            class="btn bh-save-btn">
                        <i class="fa-solid fa-check me-2"></i>
                        Apply Changes
                    </button>

                </div>

            </form>

        </div>

    </div>
</div>


<!-- =========================================================
     JAVASCRIPT
========================================================= -->
<script>
    document.addEventListener("DOMContentLoaded", function () {

        /* =====================================================
           REALTIME SEARCH
        ====================================================== */

        const searchInput = document.getElementById("hoursSearch");

        if (searchInput) {

            searchInput.addEventListener("input", function () {

                const query = this.value
                    .toLowerCase()
                    .trim();

                const rows = document.querySelectorAll(".hours-row");

                rows.forEach(function (row) {

                    const branchElement =
                        row.querySelector(".branch-name");

                    if (!branchElement) return;

                    const branchName =
                        branchElement.textContent
                            .toLowerCase()
                            .trim();

                    const matches =
                        branchName.includes(query);

                    if (matches) {
                        row.style.display = "";
                        row.style.animation = "rowReveal .35s ease both";
                    } else {
                        row.style.display = "none";
                    }
                });

            });

        }


        /* =====================================================
           ADD FORM WEEKLY OFF DAYS
        ====================================================== */

        const addForm =
            document.getElementById("addHoursForm");

        if (addForm) {

            addForm.addEventListener("submit", function () {

                const checked =
                    Array.from(
                        this.querySelectorAll(".add-off-check:checked")
                    ).map(function (checkbox) {
                        return checkbox.value;
                    });

                document.getElementById("addOffDayHidden").value =
                    checked.join(", ") || "Sunday";

            });

        }


        /* =====================================================
           EDIT FORM WEEKLY OFF DAYS
        ====================================================== */

        const editForm =
            document.getElementById("editHoursForm");

        if (editForm) {

            editForm.addEventListener("submit", function () {

                const checked =
                    Array.from(
                        this.querySelectorAll(".edit-off-check:checked")
                    ).map(function (checkbox) {
                        return checkbox.value;
                    });

                document.getElementById("editOffDayHidden").value =
                    checked.join(", ") || "Sunday";

            });

        }


        /* =====================================================
           CLEAR ADD FORM WHEN MODAL OPENS
        ====================================================== */

        const addModal =
            document.getElementById("addHoursModal");

        if (addModal) {

            addModal.addEventListener("show.bs.modal", function () {

                document.querySelectorAll(".add-off-check")
                    .forEach(function (checkbox) {

                        checkbox.checked =
                            checkbox.value === "Sunday";

                    });

                const hidden =
                    document.getElementById("addOffDayHidden");

                if (hidden) {
                    hidden.value = "Sunday";
                }

            });

        }

    });


    /* =========================================================
       OPEN EDIT MODAL
    ========================================================== */

    function openEditModal(button) {

        const get = function (name) {
            return button.getAttribute("data-" + name) || "";
        };

        document.getElementById("editHourId").value =
            get("id");

        document.getElementById("editBranchId").value =
            get("branch-id");

        document.getElementById("editEffectiveDate").value =
            get("date");

        document.getElementById("editOpeningTime").value =
            get("open-time");

        document.getElementById("editClosingTime").value =
            get("close-time");

        document.getElementById("editGracePeriod").value =
            get("grace");

        document.getElementById("editBreakDuration").value =
            get("break");

        document.getElementById("editHalfDayMinHours").value =
            get("half-day");

        document.getElementById("editIsContinuous").checked =
            get("continuous") === "true";

        document.getElementById("editIsActive").checked =
            get("active") === "true";


        /* =====================================================
           WEEKLY OFF CHECKBOXES
        ====================================================== */

        const offDayValue =
            get("off-day");

        const days =
            offDayValue
                .split(",")
                .map(function (day) {
                    return day.trim();
                })
                .filter(Boolean);

        document.querySelectorAll(".edit-off-check")
            .forEach(function (checkbox) {

                checkbox.checked =
                    days.includes(checkbox.value);

            });


        /* =====================================================
           SHOW MODAL
        ====================================================== */

        const modalElement =
            document.getElementById("editHoursModal");

        const editModal =
            bootstrap.Modal.getOrCreateInstance(modalElement);

        editModal.show();

    }


    /* =========================================================
       DELETE CONFIRMATION
    ========================================================== */

    function confirmDelete(button) {

        Swal.fire({

            title: "Delete Branch Hours?",

            html:
                "<div style='font-size:.86rem;color:#64748b'>" +
                "This will permanently remove the working-hour " +
                "profile for this branch.<br><br>" +
                "<strong>This action cannot be undone.</strong>" +
                "</div>",

            icon: "warning",

            showCancelButton: true,

            confirmButtonColor: "#ef4444",

            cancelButtonColor: "#64748b",

            confirmButtonText:
                '<i class="fa-solid fa-trash-can me-2"></i>Delete Settings',

            cancelButtonText:
                "Cancel",

            reverseButtons: true,

            focusCancel: true

        }).then(function (result) {

            if (result.isConfirmed) {

                const form =
                    button.closest(".delete-form");

                if (form) {
                    form.submit();
                }

            }

        });

    }
</script>
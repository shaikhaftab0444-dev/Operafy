    }

        .bh-stat-icon.blue {
            color: var(--bh-primary);
            background: var(--bh-primary-soft);
        }

        .bh-stat-icon.green {
            color: var(--bh-success);
            background: var(--bh-success-soft);
        }

        .bh-stat-icon.orange {
            color: var(--bh-warning);

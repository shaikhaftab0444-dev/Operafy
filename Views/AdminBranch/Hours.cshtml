        font-size: 1.35rem;
        font-weight: 800;
        line-height: 1;
    }

    /* =========================================================
           GLASS PANEL
        ========================================================= */

    .bh-panel {
        background: rgba(255, 255, 255, .90);
        border: 1px solid rgba(226, 232, 240, .95);
        border-radius: var(--bh-radius);
        box-shadow: var(--bh-shadow);
        overflow: hidden;
        backdrop-filter: blur(10px);
        -webkit-backdrop-filter: blur(10px);
        transition: box-shadow .3s ease, transform .3s ease;
    }

        .bh-panel:hover {
            box-shadow: var(--bh-shadow-hover);
        }

    /* =========================================================
           SEARCH PANEL
        ========================================================= */

    .bh-search-panel {
        padding: 18px;
        margin-bottom: 18px;
        animation: slideUp .6s .16s ease both;
    }

    .bh-search-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        margin-bottom: 13px;
    }

    .bh-section-title {
        display: flex;
        align-items: center;
        gap: 9px;
        color: var(--bh-text);
        font-size: .9rem;
        font-weight: 800;
        margin: 0;
    }

        .bh-section-title i {
            color: var(--bh-primary);
        }


@model IEnumerable<ERP_System.Models.Branch>
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Branch Details";
}

<div class="container-fluid py-4 text-start">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-bold mb-1"><i class="fa-solid fa-code-branch text-primary me-2"></i>Branch Details</h4>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0 small">
                    <li class="breadcrumb-item"><a href="/Dashboard" class="text-decoration-none">Admin Dashboard</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Branch Details</li>
                </ol>
            </nav>
        </div>
        <button class="btn btn-primary rounded-pill px-3 btn-sm shadow-sm" data-bs-toggle="modal" data-bs-target="#branchModal">
            <i class="fa-solid fa-plus me-1.5"></i>Create Branch
        </button>
    </div>

    <!-- Branches List -->
    <div class="bg-white border rounded-3 p-4 shadow-sm">
        <h5 class="fw-bold mb-3">Company Branches</h5>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" style="font-size: 0.85rem;">
                <thead class="table-light">
                    <tr>
                        <th>Branch Code</th>
                        <th>Branch Name</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var b in Model)
                        {
                            <tr>
                                <td class="fw-bold text-dark">@b.BranchCode</td>
                                <td>@b.BranchName</td>
                                <td>
                                    @if (b.IsActive)
                                    {
                                        <span class="badge bg-success-subtle text-success rounded-pill px-2.5">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger-subtle text-danger rounded-pill px-2.5">Inactive</span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Branch Modal -->
<div class="modal fade text-start" id="branchModal" tabindex="-1" aria-labelledby="branchModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form action="/AdminBranch/CreateBranch" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title fw-bold" id="branchModalLabel">Add Corporate Branch</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Branch Code</label>
                        <input type="text" name="BranchCode" class="form-control" placeholder="e.g. BR-HYD" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Branch Name</label>
                        <input type="text" name="BranchName" class="form-control" placeholder="e.g. Hyderabad Sales Branch" required />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary rounded-pill px-3 btn-sm" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary rounded-pill px-3 btn-sm">Add Branch</button>
                </div>
            </form>
        </div>
    </div>
</div>

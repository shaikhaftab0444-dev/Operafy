@model ERP_System.Models.RegionalConfiguration

@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Regional Settings";
}

<!-- Premium Alerts -->
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" />
<script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>

<style>
    .glass-panel {
        background: rgba(255, 255, 255, 0.85);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border: 1px solid rgba(226, 232, 240, 0.8);
        border-radius: 16px;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.025);
    }
    .preview-card {
        background: linear-gradient(135deg, rgba(255,255,255,0.9), rgba(248,250,252,0.85));
        border: 1px solid rgba(255, 255, 255, 0.6);
        box-shadow: 0 10px 30px rgba(0,0,0,0.06);
        border-radius: 14px;
        transition: all 0.3s ease;
    }
    .preview-card:hover {
        transform: translateY(-3px);
        box-shadow: 0 12px 35px rgba(0,0,0,0.08);
    }
</style>

<div class="container-fluid py-4 text-start">

    <!-- Header Actions -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1">
                    <li class="breadcrumb-item"><a href="/Dashboard" class="text-decoration-none">Admin Dashboard</a></li>
                    <li class="breadcrumb-item text-secondary">Master Setup</li>
                    <li class="breadcrumb-item active" aria-current="page">Regional Settings</li>
                </ol>
            </nav>
            <h4 class="fw-bold mb-0 text-dark"><i class="fa-solid fa-globe text-primary me-2"></i>Global Regional Settings</h4>
        </div>
    </div>

    <!-- Alert Notifications -->
    @if (TempData["SuccessMessage"] != null)
    {
        <script>
            document.addEventListener("DOMContentLoaded", function () {
                Swal.fire({
                    icon: 'success',
                    title: 'Configuration Updated',
                    text: '@Html.Raw(TempData["SuccessMessage"])',
                    confirmButtonColor: '#2563eb'
                });
            });
        </script>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <script>
            document.addEventListener("DOMContentLoaded", function () {
                Swal.fire({
                    icon: 'error',
                    title: 'System Error',
                    text: '@Html.Raw(TempData["ErrorMessage"])',
                    confirmButtonColor: '#ef4444'
                });
            });
        </script>
    }

    <div class="row g-4">
        
        <!-- Left Column: Form Settings -->
        <div class="col-lg-7">
            <div class="glass-panel p-4">
                <h5 class="fw-bold text-dark mb-4 border-bottom pb-2">
                    <i class="fa-solid fa-sliders text-primary me-2"></i>Configuration Controls
                </h5>

                <form method="post" action="/AdminBranch/SaveRegionalSettings" id="regionalSettingsForm">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />
                    
                    <div class="row g-3">
                        <div class="col-md-12">
                            <label class="form-label fw-bold small text-secondary">Select Country Engine</label>
                            <select asp-for="Country" id="countrySelect" class="form-select" onchange="loadCountryDefaults()" required>
                                <option value="India">🇮🇳 India</option>
                                <option value="United States">🇺🇸 United States</option>
                                <option value="United Arab Emirates">🇦🇪 United Arab Emirates</option>
                                <option value="United Kingdom">🇬🇧 United Kingdom</option>
                                <option value="Saudi Arabia">🇸🇦 Saudi Arabia</option>
                            </select>
                            <span asp-validation-for="Country" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-bold small text-secondary">Base Currency Code</label>
                            <input type="text" asp-for="CurrencyCode" id="currencyCodeInput" class="form-control" placeholder="e.g. INR" required oninput="updateLivePreview()" />
                            <span asp-validation-for="CurrencyCode" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-bold small text-secondary">Base Currency Symbol</label>
                            <input type="text" asp-for="CurrencySymbol" id="currencySymbolInput" class="form-control" placeholder="e.g. ₹" required oninput="updateLivePreview()" />
                            <span asp-validation-for="CurrencySymbol" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-bold small text-secondary">Number Formatting Style</label>
                            <select asp-for="NumberSystem" id="numberFormatSelect" class="form-select" onchange="updateLivePreview()" required>
                                <option value="Lakhs/Crores">Lakhs / Crores (e.g. 1,50,00,000.00)</option>
                                <option value="Millions/Billions">Millions / Billions (e.g. 15,000,000.00)</option>
                            </select>
                            <span asp-validation-for="NumberSystem" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-bold small text-secondary">Primary Date Format</label>
                            <select asp-for="DateFormat" id="dateFormatSelect" class="form-select" onchange="updateLivePreview()" required>
                                <option value="DD/MM/YYYY">DD/MM/YYYY (e.g. 26/01/2026)</option>
                                <option value="MM/DD/YYYY">MM/DD/YYYY (e.g. 01/26/2026)</option>
                                <option value="YYYY-MM-DD">YYYY-MM-DD (e.g. 2026-01-26)</option>
                            </select>
                            <span asp-validation-for="DateFormat" class="text-danger small"></span>
                        </div>

                        <div class="col-md-12">
                            <label class="form-label fw-bold small text-secondary">System Local Timezone</label>
                            <select asp-for="Timezone" id="timezoneSelect" class="form-select" onchange="updateLivePreview()" required>
                                <option value="India Standard Time">India Standard Time (UTC+05:30) Chennai, Kolkata, Mumbai, New Delhi</option>
                                <option value="Eastern Standard Time">Eastern Standard Time (UTC-05:00) Eastern Time (US & Canada)</option>
                                <option value="Arabian Standard Time">Arabian Standard Time (UTC+04:00) Abu Dhabi, Muscat</option>
                                <option value="GMT Standard Time">GMT Standard Time (UTC+00:00) London</option>
                                <option value="Arab Standard Time">Arab Standard Time (UTC+03:00) Riyadh</option>
                            </select>
                            <span asp-validation-for="Timezone" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-bold small text-secondary">Tax Regime System</label>
                            <input type="text" asp-for="TaxSystem" id="taxSystemInput" class="form-control" placeholder="e.g. GST (CGST, SGST, IGST)" required oninput="updateLivePreview()" />
                            <span asp-validation-for="TaxSystem" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-bold small text-secondary">Financial Year Cycle</label>
                            <select asp-for="FinancialYearCycle" id="financialYearSelect" class="form-select" onchange="updateLivePreview()" required>
                                <option value="April 1 - March 31">April 1 - March 31</option>
                                <option value="January 1 - December 31">January 1 - December 31</option>
                            </select>
                            <span asp-validation-for="FinancialYearCycle" class="text-danger small"></span>
                        </div>

                        <div class="col-12 mt-4">
                            <button type="submit" class="btn btn-primary fw-bold px-4 py-2" id="btnSaveSettings">
                                <i class="fa-solid fa-cloud-arrow-up me-1.5"></i>Apply & Propagate Settings
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>

        <!-- Right Column: Live Preview Widget -->
        <div class="col-lg-5">
            <div class="glass-panel p-4 h-100 d-flex flex-column">
                <h5 class="fw-bold text-dark mb-4 border-bottom pb-2">
                    <i class="fa-solid fa-eye text-primary me-2"></i>Global Live View Preview
                </h5>

                <div class="preview-card p-4 flex-grow-1 d-flex flex-column justify-content-between">
                    <div>
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <div class="d-flex align-items-center gap-2">
                                <span id="previewCountryFlag" class="fs-4">🇮🇳</span>
                                <h6 id="previewCountryName" class="fw-bold text-dark mb-0">India</h6>
                            </div>
                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2.5 py-1 text-uppercase small">Mock Preview</span>
                        </div>
                        
                        <!-- Financial KPI Card Mockup -->
                        <div class="bg-white border rounded-3 p-3 mb-3 shadow-sm text-start">
                            <div class="text-secondary small fw-semibold mb-1">Company Monthly Revenue</div>
                            <h3 class="fw-bold text-dark mb-0 font-monospace" id="previewKPI">₹ 1.50 Cr</h3>
                            <span class="text-success small fw-bold"><i class="fa-solid fa-arrow-up-right me-1"></i>+12.4% vs last month</span>
                        </div>

                        <!-- Invoice Table Mockup -->
                        <div class="bg-white border rounded-3 p-3 mb-3 shadow-sm text-start">
                            <div class="text-secondary small fw-semibold mb-2">Invoice Summary #INV-2026-001</div>
                            <div class="d-flex justify-content-between align-items-center py-1 border-bottom">
                                <span class="text-secondary small">Total Amount:</span>
                                <span class="fw-bold text-dark font-monospace" id="previewInvoiceAmt">₹ 1.50 Cr</span>
                            </div>
                            <div class="d-flex justify-content-between align-items-center py-1 border-bottom">
                                <span class="text-secondary small">Tax Applied:</span>
                                <span class="fw-semibold text-primary" id="previewTax">GST (CGST, SGST, IGST)</span>
                            </div>
                            <div class="d-flex justify-content-between align-items-center py-1">
                                <span class="text-secondary small">Document Date:</span>
                                <span class="fw-bold text-dark font-monospace" id="previewDate">26/08/2026</span>
                            </div>
                        </div>
                    </div>

                    <!-- Config Summaries -->
                    <div class="text-start bg-light border rounded-3 p-3 small">
                        <div class="d-flex align-items-center mb-1">
                            <span class="text-secondary fw-semibold me-2" style="width: 140px;">Local Timezone:</span>
                            <span class="text-dark fw-bold" id="previewTimezone">India Standard Time</span>
                        </div>
                        <div class="d-flex align-items-center">
                            <span class="text-secondary fw-semibold me-2" style="width: 140px;">Financial Cycle:</span>
                            <span class="text-dark fw-bold" id="previewYearCycle">April 1 - March 31</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>

</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        updateLivePreview();
    });

    // Dynamically calculate and update preview parameters in UI
    function updateLivePreview() {
        const country = document.getElementById("countrySelect").value;
        const symbol = document.getElementById("currencySymbolInput").value;
        const numFormat = document.getElementById("numberFormatSelect").value;
        const dateFormat = document.getElementById("dateFormatSelect").value;
        const taxSystem = document.getElementById("taxSystemInput").value;
        const timezone = document.getElementById("timezoneSelect").value;
        const yearCycle = document.getElementById("financialYearSelect").value;

        let kpiVal = "";
        let dateVal = "";

        if (numFormat === "Lakhs/Crores") {
            kpiVal = symbol + " 1.50 Cr";
        } else {
            kpiVal = symbol + " 15.00 M";
        }

        if (dateFormat === "MM/DD/YYYY") {
            dateVal = "08/26/2026";
        } else if (dateFormat === "YYYY-MM-DD") {
            dateVal = "2026-08-26";
        } else {
            dateVal = "26/08/2026";
        }

        document.getElementById("previewKPI").textContent = kpiVal;
        document.getElementById("previewInvoiceAmt").textContent = kpiVal;
        document.getElementById("previewDate").textContent = dateVal;
        document.getElementById("previewTax").textContent = taxSystem;
        document.getElementById("previewTimezone").textContent = timezone;
        document.getElementById("previewYearCycle").textContent = yearCycle;
        document.getElementById("previewCountryFlag").textContent = getFlagEmoji(country);
        document.getElementById("previewCountryName").textContent = country;
    }

    function getFlagEmoji(country) {
        switch (country.toLowerCase()) {
            case 'india': return '🇮🇳';
            case 'united states': return '🇺🇸';
            case 'united arab emirates': return '🇦🇪';
            case 'united kingdom': return '🇬🇧';
            case 'saudi arabia': return '🇸🇦';
            default: return '🌐';
        }
    }

    // Dynamic AJAX call to populate country default configuration presets
    async function loadCountryDefaults() {
        const country = document.getElementById("countrySelect").value;
        if (!country) return;
        
        try {
            const response = await fetch(`/AdminBranch/GetCountryDefaults?country=${encodeURIComponent(country)}`);
            if (response.ok) {
                const data = await response.json();
                document.getElementById("currencyCodeInput").value = data.currencyCode;
                document.getElementById("currencySymbolInput").value = data.currencySymbol;
                document.getElementById("numberFormatSelect").value = data.numberSystem;
                document.getElementById("dateFormatSelect").value = data.dateFormat;
                document.getElementById("timezoneSelect").value = data.timezone;
                document.getElementById("taxSystemInput").value = data.taxSystem;
                document.getElementById("financialYearSelect").value = data.financialYearCycle;

                updateLivePreview();
                toastr.success(`Presets loaded for ${country}`);
            }
        } catch (err) {
            console.error("Failed to load country defaults", err);
        }
    }
</script>

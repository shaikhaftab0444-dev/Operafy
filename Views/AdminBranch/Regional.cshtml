<!-- =========================================================
     JAVASCRIPT
========================================================= -->

<script>

    document.addEventListener("DOMContentLoaded", function () {

        updateLivePreview();

        /*
         * Prevent accidental double submission.
         */
        const form = document.getElementById("regionalSettingsForm");
        const saveButton = document.getElementById("btnSaveSettings");

        if (form && saveButton) {

            form.addEventListener("submit", function () {

                if (form.checkValidity()) {

                    saveButton.disabled = true;

                    saveButton.innerHTML =
                        '<i class="fa-solid fa-spinner fa-spin me-2"></i>Saving Configuration...';
                }

            });

        }

    });


    /* =========================================================
       LIVE PREVIEW
    ========================================================= */

    function updateLivePreview() {

        const countryElement =
            document.getElementById("countrySelect");

        const currencyCodeElement =
            document.getElementById("currencyCodeInput");

        const currencySymbolElement =
            document.getElementById("currencySymbolInput");

        const numberFormatElement =
            document.getElementById("numberFormatSelect");

        const dateFormatElement =
            document.getElementById("dateFormatSelect");

        const taxSystemElement =
            document.getElementById("taxSystemInput");

        const timezoneElement =
            document.getElementById("timezoneSelect");

        const yearCycleElement =
            document.getElementById("financialYearSelect");


        if (!countryElement) return;


        const country =
            countryElement.value || "India";

        const currencyCode =
            currencyCodeElement?.value?.trim() || "INR";

        const symbol =
            currencySymbolElement?.value?.trim() || "₹";

        const numberFormat =
            numberFormatElement?.value || "Lakhs/Crores";

        const dateFormat =
            dateFormatElement?.value || "DD/MM/YYYY";

        const taxSystem =
            taxSystemElement?.value?.trim() ||
            "GST (CGST, SGST, IGST)";

        const timezone =
            timezoneElement?.value ||
            "India Standard Time";

        const yearCycle =
            yearCycleElement?.value ||
            "April 1 - March 31";


        /* =====================================================
           REVENUE PREVIEW
        ====================================================== */

        let kpiValue = "";

        if (numberFormat === "Lakhs/Crores") {

            kpiValue =
                symbol + " 1.50 Cr";

        }
        else {

            kpiValue =
                symbol + " 15.00 M";

        }


        /* =====================================================
           DATE PREVIEW
        ====================================================== */

        let previewDate = "";

        if (dateFormat === "MM/DD/YYYY") {

            previewDate = "08/26/2026";

        }
        else if (dateFormat === "YYYY-MM-DD") {

            previewDate = "2026-08-26";

        }
        else {

            previewDate = "26/08/2026";

        }


        /* =====================================================
           UPDATE PREVIEW
        ====================================================== */

        const previewKPI =
            document.getElementById("previewKPI");

        const previewInvoiceAmt =
            document.getElementById("previewInvoiceAmt");

        const previewDateElement =
            document.getElementById("previewDate");

        const previewTax =
            document.getElementById("previewTax");

        const previewTimezone =
            document.getElementById("previewTimezone");

        const previewYearCycle =
            document.getElementById("previewYearCycle");

        const previewCountryFlag =
            document.getElementById("previewCountryFlag");

        const previewCountryName =
            document.getElementById("previewCountryName");

        const previewNumberSystem =
            document.getElementById("previewNumberSystem");

        const previewCurrencyCode =
            document.getElementById("previewCurrencyCode");


        if (previewKPI)
            previewKPI.textContent = kpiValue;

        if (previewInvoiceAmt)
            previewInvoiceAmt.textContent = kpiValue;

        if (previewDateElement)
            previewDateElement.textContent = previewDate;

        if (previewTax)
            previewTax.textContent = taxSystem;

        if (previewTimezone)
            previewTimezone.textContent = timezone;

        if (previewYearCycle)
            previewYearCycle.textContent = yearCycle;

        if (previewCountryFlag)
            previewCountryFlag.textContent =
                getFlagEmoji(country);

        if (previewCountryName)
            previewCountryName.textContent =
                country;

        if (previewNumberSystem)
            previewNumberSystem.textContent =
                numberFormat.replace("/", " / ");

        if (previewCurrencyCode)
            previewCurrencyCode.textContent =
                currencyCode;


        /* =====================================================
           QUICK INFO
        ====================================================== */

        const quickCurrency =
            document.getElementById("quickCurrency");

        const quickDateFormat =
            document.getElementById("quickDateFormat");

        const quickTimezone =
            document.getElementById("quickTimezone");


        if (quickCurrency)
            quickCurrency.textContent =
                currencyCode;

        if (quickDateFormat)
            quickDateFormat.textContent =
                dateFormat;

        if (quickTimezone)
            quickTimezone.textContent =
                timezone;

    }


    /* =========================================================
       COUNTRY FLAG
    ========================================================= */

    function getFlagEmoji(country) {

        switch ((country || "").toLowerCase()) {

            case "india":
                return "🇮🇳";

            case "united states":
                return "🇺🇸";

            case "united arab emirates":
                return "🇦🇪";

            case "united kingdom":
                return "🇬🇧";

            case "saudi arabia":
                return "🇸🇦";

            default:
                return "🌐";
        }

    }


    /* =========================================================
       LOAD COUNTRY DEFAULTS
    ========================================================= */

    async function loadCountryDefaults() {

        const countryElement =
            document.getElementById("countrySelect");

        if (!countryElement)
            return;


        const country =
            countryElement.value;

        if (!country)
            return;


        const select =
            countryElement;

        const previousValue =
            select.dataset.previousValue ||
            "";


        /*
         * Update preview immediately.
         */
        updateLivePreview();


        try {

            select.disabled = true;

            const response =
                await fetch(
                    `/AdminBranch/GetCountryDefaults?country=${encodeURIComponent(country)}`,
                    {
                        method: "GET",
                        headers: {
                            "Accept": "application/json"
                        }
                    }
                );


            if (!response.ok) {

                throw new Error(
                    "Unable to load country defaults."
                );

            }


            const data =
                await response.json();


            if (data) {

                const currencyCode =
                    document.getElementById("currencyCodeInput");

                const currencySymbol =
                    document.getElementById("currencySymbolInput");

                const numberSystem =
                    document.getElementById("numberFormatSelect");

                const dateFormat =
                    document.getElementById("dateFormatSelect");

                const timezone =
                    document.getElementById("timezoneSelect");

                const taxSystem =
                    document.getElementById("taxSystemInput");

                const financialYear =
                    document.getElementById("financialYearSelect");


                if (currencyCode && data.currencyCode != null)
                    currencyCode.value =
                        data.currencyCode;

                if (currencySymbol && data.currencySymbol != null)
                    currencySymbol.value =
                        data.currencySymbol;

                if (numberSystem && data.numberSystem != null)
                    numberSystem.value =
                        data.numberSystem;

                if (dateFormat && data.dateFormat != null)
                    dateFormat.value =
                        data.dateFormat;

                if (timezone && data.timezone != null)
                    timezone.value =
                        data.timezone;

                if (taxSystem && data.taxSystem != null)
                    taxSystem.value =
                        data.taxSystem;

                if (financialYear &&
                    data.financialYearCycle != null)
                    financialYear.value =
                        data.financialYearCycle;


                updateLivePreview();


                if (typeof toastr !== "undefined") {

                    toastr.success(
                        `Regional presets loaded for ${country}`,
                        "Configuration Updated"
                    );

                }

            }


            select.dataset.previousValue =
                country;

        }
        catch (error) {

            console.error(
                "Failed to load country defaults:",
                error
            );


            if (typeof toastr !== "undefined") {

                toastr.error(
                    "Country defaults could not be loaded. You can continue configuring the values manually.",
                    "Unable to Load Presets"
                );

            }

        }
        finally {

            select.disabled = false;

        }

    }


    /* =========================================================
       LIVE INPUT UPDATE
    ========================================================= */

    document.addEventListener("input", function (event) {

        if (
            event.target.id === "currencyCodeInput" ||
            event.target.id === "currencySymbolInput" ||
            event.target.id === "taxSystemInput"
        ) {

            updateLivePreview();

        }

    });

</script>
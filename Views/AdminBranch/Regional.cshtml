@model ERP_System.Models.RegionalConfiguration

@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Regional Settings";
}

<!-- =========================================================
     EXTERNAL NOTIFICATIONS
========================================================= -->
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<link rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" />
<script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>

<style>
    /* =========================================================
           PAGE DESIGN
        ========================================================= */

    :root {
        --rs-primary: #2563eb;
        --rs-primary-dark: #1d4ed8;
        --rs-text: #0f172a;
        --rs-muted: #64748b;
        --rs-border: #e2e8f0;
        --rs-bg: #f8fafc;
        --rs-card: #ffffff;
        --rs-success: #10b981;
        --rs-shadow: 0 12px 35px rgba(15, 23, 42, 0.06);
        --rs-radius: 18px;
    }

    .regional-page {
        min-height: calc(100vh - 80px);
        background: radial-gradient(circle at top right, rgba(37, 99, 235, 0.06), transparent 30%), radial-gradient(circle at bottom left, rgba(14, 165, 233, 0.05), transparent 30%);
    }

    /* =========================================================
           PAGE HEADER
        ========================================================= */

    .regional-header {
        position: relative;
        margin-bottom: 24px;
    }

    .regional-breadcrumb {
        margin-bottom: 7px;
    }

        .regional-breadcrumb .breadcrumb-item {
            font-size: 0.78rem;
            font-weight: 600;
        }

    .regional-title {
        display: flex;
        align-items: center;
        gap: 12px;
        color: var(--rs-text);
        font-size: 1.45rem;
        font-weight: 800;
        letter-spacing: -0.4px;
        margin: 0;
    }

    .regional-title-icon {
        width: 42px;
        height: 42px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 13px;
        color: var(--rs-primary);
        background: rgba(37, 99, 235, 0.10);
        border: 1px solid rgba(37, 99, 235, 0.12);
    }

    .page-description {
        color: var(--rs-muted);
        font-size: 0.84rem;
        margin: 8px 0 0 54px;
    }

    /* =========================================================
           MAIN CARDS
        ========================================================= */

    .regional-card {
        height: 100%;
        background: rgba(255, 255, 255, 0.94);
        border: 1px solid rgba(226, 232, 240, 0.95);
        border-radius: var(--rs-radius);
        box-shadow: var(--rs-shadow);
        overflow: hidden;
        transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
    }

        .regional-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 18px 45px rgba(15, 23, 42, 0.08);
            border-color: rgba(37, 99, 235, 0.14);
        }

    .regional-card-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 15px;
        padding: 20px 22px;
        border-bottom: 1px solid #edf1f5;
        background: linear-gradient( 180deg, rgba(248, 250, 252, 0.90), rgba(255, 255, 255, 0.96) );
    }

    .card-heading {
        display: flex;
        align-items: center;
        gap: 11px;
        min-width: 0;
    }

    .card-heading-icon {
        width: 38px;
        height: 38px;
        flex: 0 0 38px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 11px;
        background: #eff6ff;
        color: var(--rs-primary);
    }

    .card-heading h5 {
        font-size: 0.98rem;
        font-weight: 800;
        color: var(--rs-text);
        margin: 0;
    }

    .card-heading p {
        color: var(--rs-muted);
        font-size: 0.74rem;
        margin: 3px 0 0;
    }

    .regional-card-body {
        padding: 22px;
    }

    /* =========================================================
           FORM DESIGN
        ========================================================= */

    .settings-section {
        margin-bottom: 25px;
    }

        .settings-section:last-child {
            margin-bottom: 0;
        }

    .section-label {
        display: flex;
        align-items: center;
        gap: 8px;
        color: #334155;
        font-size: 0.76rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.55px;
        margin-bottom: 14px;
    }

        .section-label::after {
            content: "";
            height: 1px;
            flex: 1;
            background: #edf1f5;
        }

    .form-group-modern {
        position: relative;
    }

    .modern-label {
        display: block;
        color: #475569;
        font-size: 0.76rem;
        font-weight: 700;
        margin-bottom: 7px;
    }

        .modern-label .required {
            color: #ef4444;
            margin-left: 2px;
        }

    .modern-input,
    .modern-select {
        min-height: 45px;
        width: 100%;
        border: 1px solid #dbe2ea;
        border-radius: 11px;
        background-color: #fff;
        color: #1e293b;
        font-size: 0.84rem;
        font-weight: 500;
        padding: 10px 13px;
        box-shadow: 0 1px 2px rgba(15, 23, 42, 0.02);
        transition: border-color 0.2s ease, box-shadow 0.2s ease, background-color 0.2s ease;
    }

        .modern-input:hover,
        .modern-select:hover {
            border-color: #c5d0dc;
        }

        .modern-input:focus,
        .modern-select:focus {
            border-color: var(--rs-primary);
            background-color: #fff;
            box-shadow: 0 0 0 4px rgba(37, 99, 235, 0.09);
            outline: none;
        }

        .modern-input::placeholder {
            color: #94a3b8;
            font-weight: 400;
        }

    .field-hint {
        display: block;
        color: #94a3b8;
        font-size: 0.69rem;
        margin-top: 6px;
    }

    .validation-message {
        display: block;
        font-size: 0.7rem;
        margin-top: 5px;
    }

    /* Currency fields */

    .input-with-prefix {
        position: relative;
    }

    .input-prefix {
        position: absolute;
        top: 50%;
        left: 13px;
        transform: translateY(-50%);
        z-index: 2;
        color: #64748b;
        font-size: 0.75rem;
        font-weight: 700;
        pointer-events: none;
    }

    .input-with-prefix .modern-input {
        padding-left: 57px;
    }

    /* =========================================================
           SAVE BUTTON
        ========================================================= */

    .settings-footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 15px;
        padding-top: 20px;
        margin-top: 25px;
        border-top: 1px solid #edf1f5;
    }

    .security-note {
        display: flex;
        align-items: center;
        gap: 8px;
        color: #64748b;
        font-size: 0.72rem;
    }

        .security-note i {
            color: var(--rs-success);
        }

    .save-settings-btn {
        min-height: 44px;
        padding: 0 20px;
        border: 0;
        border-radius: 11px;
        background: linear-gradient( 135deg, var(--rs-primary), var(--rs-primary-dark) );
        color: #fff;
        font-size: 0.8rem;
        font-weight: 700;
        box-shadow: 0 8px 18px rgba(37, 99, 235, 0.20);
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

        .save-settings-btn:hover {
            color: #fff;
            transform: translateY(-1px);
            box-shadow: 0 12px 24px rgba(37, 99, 235, 0.28);
        }

        .save-settings-btn:active {
            transform: translateY(0);
        }

    /* =========================================================
           LIVE PREVIEW
        ========================================================= */

    .preview-card {
        position: relative;
        height: 100%;
        background: linear-gradient( 145deg, rgba(248, 250, 252, 0.98), rgba(239, 246, 255, 0.75) );
    }

    .preview-top {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        margin-bottom: 20px;
    }

    .country-preview {
        display: flex;
        align-items: center;
        gap: 10px;
        min-width: 0;
    }

    .country-flag {
        width: 45px;
        height: 45px;
        flex: 0 0 45px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background: #fff;
        border: 1px solid #e2e8f0;
        border-radius: 13px;
        box-shadow: 0 5px 14px rgba(15, 23, 42, 0.06);
        font-size: 1.55rem;
    }

    .country-preview-name {
        min-width: 0;
    }

        .country-preview-name strong {
            display: block;
            color: #0f172a;
            font-size: 0.92rem;
            font-weight: 800;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .country-preview-name span {
            display: block;
            color: #94a3b8;
            font-size: 0.69rem;
            margin-top: 2px;
        }

    .preview-status {
        flex-shrink: 0;
        padding: 6px 9px;
        border-radius: 999px;
        background: #ecfdf5;
        color: #047857;
        border: 1px solid #bbf7d0;
        font-size: 0.64rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.35px;
    }

    /* KPI */

    .preview-kpi {
        position: relative;
        overflow: hidden;
        padding: 20px;
        margin-bottom: 14px;
        border-radius: 15px;
        background: #fff;
        border: 1px solid #e2e8f0;
        box-shadow: 0 8px 25px rgba(15, 23, 42, 0.055);
    }

        .preview-kpi::after {
            content: "";
            position: absolute;
            width: 100px;
            height: 100px;
            right: -45px;
            top: -45px;
            border-radius: 50%;
            background: rgba(37, 99, 235, 0.07);
        }

    .preview-kpi-label {
        color: #64748b;
        font-size: 0.69rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.4px;
        margin-bottom: 5px;
    }

    .preview-kpi-value {
        color: #0f172a;
        font-size: 1.55rem;
        font-weight: 800;
        letter-spacing: -0.6px;
        margin-bottom: 5px;
        word-break: break-word;
    }

    .preview-growth {
        color: #059669;
        font-size: 0.72rem;
        font-weight: 700;
    }

    /* Invoice */

    .invoice-preview {
        padding: 17px;
        margin-bottom: 14px;
        border-radius: 15px;
        background: #fff;
        border: 1px solid #e2e8f0;
        box-shadow: 0 8px 25px rgba(15, 23, 42, 0.045);
    }

    .invoice-title {
        display: flex;
        justify-content: space-between;
        gap: 10px;
        margin-bottom: 10px;
    }

        .invoice-title span:first-child {
            color: #64748b;
            font-size: 0.69rem;
            font-weight: 700;
        }

        .invoice-title span:last-child {
            color: #94a3b8;
            font-size: 0.65rem;
            font-family: monospace;
        }

    .invoice-line {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 15px;
        padding: 9px 0;
        border-bottom: 1px dashed #e2e8f0;
    }

        .invoice-line:last-child {
            border-bottom: 0;
            padding-bottom: 0;
        }

    .invoice-label {
        color: #64748b;
        font-size: 0.7rem;
    }

    .invoice-value {
        color: #1e293b;
        font-size: 0.72rem;
        font-weight: 800;
        text-align: right;
        word-break: break-word;
    }

        .invoice-value.tax {
            color: var(--rs-primary);
            max-width: 180px;
        }

    /* =========================================================
           CONFIGURATION SUMMARY
        ========================================================= */

    .preview-summary {
        margin-top: auto;
        padding: 15px;
        border-radius: 14px;
        background: rgba(255, 255, 255, 0.75);
        border: 1px solid #e2e8f0;
    }

    .summary-title {
        color: #334155;
        font-size: 0.72rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.4px;
        margin-bottom: 10px;
    }

    .summary-item {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 15px;
        padding: 7px 0;
    }

        .summary-item + .summary-item {
            border-top: 1px solid rgba(226, 232, 240, 0.8);
        }

    .summary-label {
        color: #64748b;
        font-size: 0.69rem;
        font-weight: 600;
    }

    .summary-value {
        color: #1e293b;
        font-size: 0.69rem;
        font-weight: 800;
        text-align: right;
        max-width: 60%;
        word-break: break-word;
    }

    /* =========================================================
           QUICK INFORMATION STRIP
        ========================================================= */

    .info-strip {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 12px;
        margin-top: 18px;
    }

    .info-item {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 12px;
        background: #f8fafc;
        border: 1px solid #e5eaf0;
        border-radius: 12px;
    }

    .info-icon {
        width: 32px;
        height: 32px;
        flex: 0 0 32px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 9px;
        background: #fff;
        color: var(--rs-primary);
        border: 1px solid #e2e8f0;
        font-size: 0.75rem;
    }

    .info-content {
        min-width: 0;
    }

        .info-content small {
            display: block;
            color: #94a3b8;
            font-size: 0.62rem;
        }

        .info-content strong {
            display: block;
            color: #334155;
            font-size: 0.69rem;
            margin-top: 2px;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

    /* =========================================================
           MODERN SCROLLBAR
        ========================================================= */

    .regional-card ::-webkit-scrollbar {
        width: 6px;
        height: 6px;
    }

    .regional-card ::-webkit-scrollbar-track {
        background: #f8fafc;
    }

    .regional-card ::-webkit-scrollbar-thumb {
        background: #cbd5e1;
        border-radius: 20px;
    }

    /* =========================================================
           RESPONSIVE DESIGN
        ========================================================= */

    @@media (max-width: 991.98px) {
        .regional-title

    {
        font-size: 1.3rem;
    }

    .page-description {
        margin-left: 0;
    }

    .regional-card {
        height: auto;
    }

    .preview-card {
        min-height: 560px;
    }

    }

    @@media (max-width: 767.98px) {
        .regional-page

    {
        padding-bottom: 20px;
    }

    .regional-header {
        margin-bottom: 18px;
    }

    .regional-title {
        font-size: 1.18rem;
    }

    .regional-title-icon {
        width: 38px;
        height: 38px;
    }

    .page-description {
        font-size: 0.76rem;
    }

    .regional-card-header {
        padding: 16px;
    }

    .regional-card-body {
        padding: 16px;
    }

    .card-heading h5 {
        font-size: 0.9rem;
    }

    .card-heading p {
        font-size: 0.68rem;
    }

    .settings-footer {
        align-items: stretch;
        flex-direction: column;
    }

    .security-note {
        justify-content: center;
    }

    .save-settings-btn {
        width: 100%;
    }

    .info-strip {
        grid-template-columns: 1fr;
    }

    .preview-top {
        align-items: flex-start;
    }

    .preview-status {
        font-size: 0.58rem;
    }

    .preview-kpi-value {
        font-size: 1.35rem;
    }

    .summary-item {
        flex-direction: column;
        gap: 3px;
    }

    .summary-value {
        max-width: 100%;
        text-align: left;
    }

    }

    @@media (max-width: 480px) {
        .regional-breadcrumb

    {
        overflow-x: auto;
        white-space: nowrap;
        padding-bottom: 2px;
    }

    .regional-title {
        align-items: flex-start;
    }

    .country-preview {
        max-width: 65%;
    }

    .country-preview-name strong {
        font-size: 0.82rem;
    }

    .preview-status {
        display: none;
    }

    .preview-kpi,
    .invoice-preview {
        padding: 14px;
    }

    .invoice-line {
        align-items: flex-start;
        flex-direction: column;
        gap: 4px;
    }

    .invoice-value {
        text-align: left;
    }

        .invoice-value.tax {
            max-width: 100%;
        }

    }

    /* =========================================================
           MODAL / ALERT POLISH
        ========================================================= */

    .swal2-popup {
        border-radius: 18px !important;
    }

    .toast {
        border-radius: 10px !important;
        box-shadow: 0 10px 30px rgba(15, 23, 42, 0.12) !important;
    }
</style>


<div class="container-fluid py-4 text-start regional-page">

    <!-- =====================================================
         PAGE HEADER
    ====================================================== -->

    <div class="regional-header">

        <nav aria-label="breadcrumb" class="regional-breadcrumb">
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item">
                    <a href="/Dashboard" class="text-decoration-none">
                        <i class="fa-solid fa-house me-1"></i>
                        Admin Dashboard
                    </a>
                </li>

                <li class="breadcrumb-item text-secondary">
                    Master Setup
                </li>

                <li class="breadcrumb-item active" aria-current="page">
                    Regional Settings
                </li>
            </ol>
        </nav>

        <h4 class="regional-title">
            <span class="regional-title-icon">
                <i class="fa-solid fa-globe"></i>
            </span>

            <span>
                Global Regional Settings
            </span>
        </h4>

        <p class="page-description">
            Configure country-specific currency, taxation, date, number formatting,
            timezone and financial year preferences for the ERP system.
        </p>

    </div>


    <!-- =====================================================
         ALERTS
    ====================================================== -->
    @if (TempData["SuccessMessage"] != null)
    {
        <script>
            document.addEventListener("DOMContentLoaded", function () {
                Swal.fire({
                    icon: "success",
                    title: "Configuration Updated",
                    text: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(TempData["SuccessMessage"]?.ToString())),
                    confirmButtonColor: "#2563eb",
                    confirmButtonText: "Continue",
                    timer: 3500,
                    timerProgressBar: true
                });
            });
        </script>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <script>
            document.addEventListener("DOMContentLoaded", function () {
                Swal.fire({
                    icon: "error",
                    title: "System Error",
                    text: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(TempData["ErrorMessage"]?.ToString())),
                    confirmButtonColor: "#ef4444",
                    confirmButtonText: "Close"
                });
            });
        </script>
    }


    <!-- =====================================================
         MAIN CONTENT
    ====================================================== -->

    <div class="row g-4">

        <!-- =================================================
             LEFT SIDE - SETTINGS
        ================================================== -->

        <div class="col-xl-7 col-lg-7">

            <div class="regional-card">

                <div class="regional-card-header">

                    <div class="card-heading">

                        <span class="card-heading-icon">
                            <i class="fa-solid fa-sliders"></i>
                        </span>

                        <div>
                            <h5>Configuration Controls</h5>
                            <p>Manage your organization's regional preferences</p>
                        </div>

                    </div>

                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-3 py-2">
                        <i class="fa-solid fa-gear me-1"></i>
                        System
                    </span>

                </div>


                <div class="regional-card-body">

                    <form method="post"
                          action="/AdminBranch/SaveRegionalSettings"
                          id="regionalSettingsForm">

                        @Html.AntiForgeryToken()

                        <input type="hidden" asp-for="Id" />


                        <!-- =================================
                             LOCATION
                        ================================== -->

                        <div class="settings-section">

                            <div class="section-label">
                                <i class="fa-solid fa-location-dot text-primary"></i>
                                Regional Location
                            </div>

                            <div class="row g-3">

                                <div class="col-12">

                                    <div class="form-group-modern">

                                        <label class="modern-label" for="countrySelect">
                                            Select Country
                                            <span class="required">*</span>
                                        </label>

                                        <select asp-for="Country"
                                                id="countrySelect"
                                                class="modern-select"
                                                onchange="loadCountryDefaults()"
                                                required>

                                            <option value="India">
                                                🇮🇳 India
                                            </option>

                                            <option value="United States">
                                                🇺🇸 United States
                                            </option>

                                            <option value="United Arab Emirates">
                                                🇦🇪 United Arab Emirates
                                            </option>

                                            <option value="United Kingdom">
                                                🇬🇧 United Kingdom
                                            </option>

                                            <option value="Saudi Arabia">
                                                🇸🇦 Saudi Arabia
                                            </option>

                                        </select>

                                        <span asp-validation-for="Country"
                                              class="text-danger validation-message"></span>

                                        <small class="field-hint">
                                            Changing the country can automatically load recommended regional defaults.
                                        </small>

                                    </div>

                                </div>

                            </div>

                        </div>


                        <!-- =================================
                             CURRENCY
                        ================================== -->

                        <div class="settings-section">

                            <div class="section-label">
                                <i class="fa-solid fa-coins text-primary"></i>
                                Currency Configuration
                            </div>

                            <div class="row g-3">

                                <div class="col-md-6">

                                    <div class="form-group-modern">

                                        <label class="modern-label" for="currencyCodeInput">
                                            Currency Code
                                            <span class="required">*</span>
                                        </label>

                                        <input type="text"
                                               asp-for="CurrencyCode"
                                               id="currencyCodeInput"
                                               class="modern-input text-uppercase"
                                               placeholder="e.g. INR"
                                               maxlength="5"
                                               autocomplete="off"
                                               required
                                               oninput="this.value = this.value.toUpperCase(); updateLivePreview();" />

                                        <span asp-validation-for="CurrencyCode"
                                              class="text-danger validation-message"></span>

                                    </div>

                                </div>


                                <div class="col-md-6">

                                    <div class="form-group-modern">

                                        <label class="modern-label" for="currencySymbolInput">
                                            Currency Symbol
                                            <span class="required">*</span>
                                        </label>

                                        <div class="input-with-prefix">

                                            <input type="text"
                                                   asp-for="CurrencySymbol"
                                                   id="currencySymbolInput"
                                                   class="modern-input"
                                                   placeholder="e.g. ₹"
                                                   maxlength="5"
                                                   required
                                                   oninput="updateLivePreview();" />

                                        </div>

                                        <span asp-validation-for="CurrencySymbol"
                                              class="text-danger validation-message"></span>

                                    </div>

                                </div>

                            </div>

                        </div>


                        <!-- =================================
                             FORMATTING
                        ================================== -->


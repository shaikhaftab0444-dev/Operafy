@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Regional Settings";
}

<div class="container-fluid py-4 text-start">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-bold mb-1"><i class="fa-solid fa-globe text-primary me-2"></i>Regional Settings</h4>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0 small">
                    <li class="breadcrumb-item"><a href="/Dashboard" class="text-decoration-none">Admin Dashboard</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Regional Settings</li>
                </ol>
            </nav>
        </div>
    </div>

    <!-- Regional Table -->
    <div class="bg-white border rounded-3 p-4 shadow-sm" style="max-width: 600px;">
        <h5 class="fw-bold mb-3">System Timezone & Language</h5>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" style="font-size: 0.85rem;">
                <thead class="table-light">
                    <tr>
                        <th>Setting Parameter</th>
                        <th>Current Value</th>
                        <th>Access</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td class="fw-bold text-dark">Default Timezone</td>
                        <td>(UTC+05:30) Chennai, Kolkata, Mumbai, New Delhi</td>
                        <td><span class="badge bg-success-subtle text-success">Active</span></td>
                    </tr>
                    <tr>
                        <td class="fw-bold text-dark">System Language</td>
                        <td>English (India) - en-IN</td>
                        <td><span class="badge bg-success-subtle text-success">Active</span></td>
                    </tr>
                    <tr>
                        <td class="fw-bold text-dark">Number Formatting</td>
                        <td>₹ Lakhs / Crores</td>
                        <td><span class="badge bg-success-subtle text-success">Active</span></td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Request Material / PR";
}

<style>
    .pr-create-page {
        animation: prCreateFadeIn 0.55s ease both;
    }

    @@keyframes prCreateFadeIn {
        from { opacity: 0; transform: translateY(12px); }
        to { opacity: 1; transform: translateY(0); }
    }

    .pr-header {
        position: relative;
        overflow: hidden;
        background: linear-gradient(135deg, #ffffff 0%, #f7faff 100%);
        border: 1px solid #e7ecf3;
        border-radius: 18px;
        padding: 22px 26px;
        margin-bottom: 22px;
        box-shadow: 0 8px 28px rgba(15, 23, 42, 0.045);
    }

    .header-icon {
        width: 48px;
        height: 48px;
        min-width: 48px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 14px;
        background: #eef5ff;
        color: #2563eb;
        font-size: 1.25rem;
        box-shadow: inset 0 0 0 1px rgba(37, 99, 235, 0.1);
    }

    .pr-card {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 18px;
        box-shadow: 0 10px 30px rgba(15, 23, 42, 0.04);
        overflow: hidden;
    }

    .pr-card-header {
        background: #f8fafc;
        border-bottom: 1px solid #e2e8f0;
        padding: 16px 24px;
    }

    .info-callout {
        background: #f0fdf4;
        border: 1px solid #bbf7d0;
        border-radius: 14px;
        padding: 16px 20px;
    }
</style>

<div class="container-fluid px-0 pr-create-page">
    <!-- Header -->
    <div class="pr-header d-flex flex-wrap align-items-center justify-content-between gap-3">
        <div class="d-flex align-items-center gap-3">
            <div class="header-icon">
                <i class="fa-solid fa-cart-plus"></i>
            </div>
            <div>
                <div class="d-flex align-items-center gap-2 mb-1">
                    <h4 class="fw-bold mb-0 text-dark">Material &amp; Purchase Requisition</h4>
                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2.5 py-1 fw-bold rounded-pill">Department Catalog</span>
                </div>
                <p class="text-muted small mb-0">Select pre-approved catalog materials mapped directly to your department.</p>
            </div>
        </div>
        <div class="d-flex align-items-center gap-2">
            <a href="@Url.Action("Index", "ESSPurchase")" class="btn btn-outline-secondary btn-sm px-3 rounded-pill fw-semibold">
                <i class="fa-solid fa-clock-rotate-left me-1"></i> My PR History
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-4 border-0 shadow-sm mb-4" role="alert">
            <div class="d-flex align-items-center gap-2">
                <i class="fa-solid fa-circle-check text-success fs-5"></i>
                <div class="fw-semibold">@TempData["SuccessMessage"]</div>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row g-4">
        <!-- Requisition Form -->
        <div class="col-lg-8">
            <div class="pr-card">
                <div class="pr-card-header d-flex align-items-center justify-content-between">
                    <span class="fw-bold text-dark"><i class="fa-solid fa-clipboard-list text-primary me-2"></i> New Requisition Order</span>
                    <span class="badge bg-light text-muted border px-2.5 py-1">Auto-Pricing Enabled</span>
                </div>
                <div class="p-4">
                    <form id="essPrForm" method="post" asp-action="Create" asp-controller="ESSPurchase">
                        @Html.AntiForgeryToken()

                        <div class="row g-3">
                            <!-- 1. Logged-in Employee -->
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold small text-dark">Requesting Employee / Submitter</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light"><i class="fa fa-user text-muted"></i></span>
                                    <input type="text" class="form-control bg-light text-dark fw-semibold" value="@ViewBag.EmployeeName" readonly disabled />
                                </div>
                            </div>

                            <!-- 2. Auto-bound & Permanently Locked Department -->
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold small text-dark">Department (Locked to Profile)</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light"><i class="fa fa-building text-muted"></i></span>
                                    <input type="text" class="form-control bg-light text-dark fw-semibold" value="@ViewBag.DepartmentName" readonly disabled />
                                    <input type="hidden" name="DepartmentId" value="@ViewBag.DepartmentId" />
                                </div>
                            </div>

                            <!-- 3. Catalog Dropdown with Live Pricing -->
                            <div class="col-12 mb-3">
                                <label class="form-label fw-bold small text-dark">Select Requisition Item *</label>
                                <select id="catalogItemSelect" name="catalogItemId" class="form-select" required onchange="handleItemChange(this)">
                                    <option value="" data-price="0">-- Select Pre-Approved Catalog Material --</option>
                                    @if (ViewBag.CatalogItems != null)
                                    {
                                        foreach (var item in ViewBag.CatalogItems)
                                        {
                                            <option value="@item.Id" data-price="@item.UnitPrice" data-uom="@item.UnitOfMeasure">
                                                @item.ItemName (₹ @item.UnitPrice.ToString("N2") / @item.UnitOfMeasure)
                                            </option>
                                        }
                                    }
                                </select>
                                <div class="form-text">Filtered automatically for <strong>@ViewBag.DepartmentName</strong> catalog items.</div>
                            </div>

                            <!-- 4. Quantity Input -->
                            <div class="col-md-4 mb-3">
                                <label class="form-label fw-bold small text-dark">Quantity *</label>
                                <div class="input-group">
                                    <input type="number" id="itemQuantity" name="quantity" class="form-control fw-bold text-center" value="1" min="1" max="500" required oninput="calculateTotalCost()" />
                                    <span class="input-group-text bg-light" id="uomLabel">Unit</span>
                                </div>
                            </div>

                            <!-- 5. Unit Price (Read-Only) -->
                            <div class="col-md-4 mb-3">
                                <label class="form-label fw-bold small text-dark">Unit Price</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light">₹</span>
                                    <input type="text" id="displayUnitPrice" class="form-control bg-light fw-semibold text-dark" value="0.00" readonly />
                                </div>
                            </div>

                            <!-- 6. Estimated Total Cost (Live Calculated) -->
                            <div class="col-md-4 mb-3">
                                <label class="form-label fw-bold small text-dark">Estimated Total Cost</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light fw-bold text-success">₹</span>
                                    <input type="text" id="displayTotalCost" class="form-control bg-light fw-bold text-success fs-6" value="0.00" readonly />
                                </div>
                            </div>

                            <!-- 7. Urgency Level -->
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold small text-dark">Urgency Level *</label>
                                <select id="urgencyLevel" name="urgencyLevel" class="form-select" required>
                                    <option value="Normal Priority">Normal Priority (7-10 Business Days)</option>
                                    <option value="Medium Priority" selected="selected">Medium Priority (3-5 Business Days)</option>
                                    <option value="High Priority">High Priority (Within 48 Hours)</option>
                                    <option value="Urgent (Same-Day)">Urgent (Same-Day Procurement)</option>
                                </select>
                            </div>

                            <!-- 8. Cost Center / Budget Code (Auto-generated & Locked) -->
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold small text-dark">Cost Center / Budget Code</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light"><i class="fa fa-barcode text-muted"></i></span>
                                    <input type="text" id="costCenterCode" name="CostCenterCode" class="form-control bg-light text-dark fw-bold" value="@ViewBag.AutoCostCenter" readonly />
                                </div>
                            </div>

                            <div class="col-12 mb-3">
                                <label class="form-label fw-bold small text-dark">Business Purpose &amp; Justification</label>
                                <textarea id="justification" name="justification" class="form-control" rows="3" placeholder="Provide business justification or specific project requirement..."></textarea>
                            </div>

                            <div class="col-12 mt-2">
                                <div class="p-3 bg-light rounded-3 border">
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" id="complianceCheck" checked required />
                                        <label class="form-check-label small text-muted" for="complianceCheck">
                                            I confirm that this procurement complies with fiscal budget provisions and approved vendor sourcing policies.
                                        </label>
                                    </div>
                                </div>
                            </div>

                            <div class="col-12 mt-4 d-flex justify-content-between align-items-center">
                                <a href="@Url.Action("Index", "ESSPurchase")" class="btn btn-light px-4 rounded-pill">
                                    Cancel
                                </a>
                                <button type="submit" class="btn btn-primary px-4 py-2 rounded-pill fw-bold shadow-sm" id="btnSubmit">
                                    <i class="fa-solid fa-paper-plane me-2"></i> Submit Requisition
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <!-- Sidebar Info & SLA Policy -->
        <div class="col-lg-4">
            <div class="info-callout mb-4">
                <div class="d-flex align-items-center gap-2 mb-2">
                    <i class="fa-solid fa-circle-info text-success fs-5"></i>
                    <h6 class="fw-bold text-success mb-0">Catalog Automation</h6>
                </div>
                <p class="small text-muted mb-0">
                    Material prices are standardized in the master catalog. Requisitions are automatically forwarded to the <strong>Purchase Manager</strong> console for review and PO generation.
                </p>
            </div>

            <div class="pr-card p-4">
                <h6 class="fw-bold text-dark mb-3"><i class="fa-solid fa-layer-group text-primary me-2"></i> Available Materials</h6>
                <div class="small text-muted mb-3">
                    Showing catalog items for <strong>@ViewBag.DepartmentName</strong>.
                </div>
                <ul class="list-group list-group-flush small">
                    @if (ViewBag.CatalogItems != null)
                    {
                        foreach (var item in ViewBag.CatalogItems)
                        {
                            <li class="list-group-item px-0 d-flex justify-content-between align-items-center bg-transparent">
                                <div>
                                    <i class="fa-solid fa-box text-muted me-1.5"></i>
                                    <span class="fw-semibold text-dark">@item.ItemName</span>
                                </div>
                                <span class="badge bg-light text-primary border fw-bold">₹ @item.UnitPrice.ToString("N0") / @item.UnitOfMeasure</span>
                            </li>
                        }
                    }
                </ul>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let currentUnitPrice = 0;

        function handleItemChange(selectEl) {
            const selectedOption = selectEl.options[selectEl.selectedIndex];
            currentUnitPrice = parseFloat(selectedOption.getAttribute('data-price')) || 0;
            const uom = selectedOption.getAttribute('data-uom') || 'Unit';

            const uomLabel = document.getElementById('uomLabel');
            if (uomLabel) {
                uomLabel.textContent = uom;
            }

            const unitPriceEl = document.getElementById('displayUnitPrice');
            if (unitPriceEl) {
                unitPriceEl.value = currentUnitPrice.toLocaleString('en-IN', { minimumFractionDigits: 2 });
            }

            calculateTotalCost();
        }

        function calculateTotalCost() {
            const qtyInput = document.getElementById('itemQuantity');
            let qty = parseInt(qtyInput.value, 10);
            if (isNaN(qty) || qty < 1) {
                qty = 1;
            }
            const total = (currentUnitPrice * qty).toFixed(2);
            const totalCostEl = document.getElementById('displayTotalCost');
            if (totalCostEl) {
                totalCostEl.value = Number(total).toLocaleString('en-IN', { minimumFractionDigits: 2 });
            }
        }

        // AJAX Form Submission
        document.addEventListener('DOMContentLoaded', function () {
            const form = document.getElementById('essPrForm');
            if (!form) return;

            form.addEventListener('submit', function (e) {
                e.preventDefault();

                const selectEl = document.getElementById('catalogItemSelect');
                if (!selectEl || !selectEl.value) {
                    if (typeof toastr !== 'undefined') {
                        toastr.warning('Please select a catalog item.');
                    } else {
                        alert('Please select a catalog item.');
                    }
                    return;
                }

                const btn = document.getElementById('btnSubmit');
                if (btn) {
                    btn.disabled = true;
                    btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin me-2"></i> Submitting...';
                }

                const tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
                const token = tokenInput ? tokenInput.value : '';

                const formData = new FormData();
                formData.append('catalogItemId', selectEl.value);
                formData.append('quantity', document.getElementById('itemQuantity').value);
                formData.append('urgencyLevel', document.getElementById('urgencyLevel').value);
                formData.append('justification', document.getElementById('justification').value);
                formData.append('costCenterCode', document.getElementById('costCenterCode')?.value || '');
                formData.append('__RequestVerificationToken', token);

                fetch('@Url.Action("SubmitPR", "ESSPurchase")', {
                    method: 'POST',
                    body: formData
                })
                .then(res => res.json())
                .then(data => {
                    if (data && data.success) {
                        if (typeof toastr !== 'undefined') {
                            toastr.success(data.message || 'Requisition submitted successfully!');
                        }
                        setTimeout(function () {
                            window.location.href = '@Url.Action("Index", "ESSPurchase")';
                        }, 1000);
                    } else {
                        if (typeof toastr !== 'undefined') {
                            toastr.error(data.message || 'Failed to submit requisition.');
                        } else {
                            alert(data.message || 'Failed to submit requisition.');
                        }
                        if (btn) {
                            btn.disabled = false;
                            btn.innerHTML = '<i class="fa-solid fa-paper-plane me-2"></i> Submit Requisition';
                        }
                    }
                })
                .catch(err => {
                    console.error(err);
                    if (typeof toastr !== 'undefined') {
                        toastr.error('Network error while submitting requisition.');
                    } else {
                        alert('Network error while submitting requisition.');
                    }
                    if (btn) {
                        btn.disabled = false;
                        btn.innerHTML = '<i class="fa-solid fa-paper-plane me-2"></i> Submit Requisition';
                    }
                });
            });
        });
    </script>
}
